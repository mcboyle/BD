# --- environments (never commit; rebuilt by bootstrap) ---
venv/
.venv/
node_modules/
*.egg-info/

# --- build output ---
frontend/dist/
build/
dist/
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.node-compile-cache/

# --- runtime state (BD_HOME): user data, history, credentials ---
bd_home/
*.db
# pre-migration DB backup (migrations.py: <db> + ".premigration.bak") -- live history, never commit
*.premigration.bak
*.sqlite3
app_config.json
sites_config.json
cookies/
*.cookies.json
# Generated web-push PRIVATE key -- must never be committed.
# This comment used to sit at the END of the line below. gitignore has no inline
# comments, so the pattern was the whole string including this prose and it
# matched NOTHING: `git check-ignore vapid_keys.json` exited 1 and the key showed
# as `??` on the deploy host. The line asserting the protection is exactly why
# nobody checked whether it worked.
vapid_keys.json

# Written by install_service.sh on every deploy.
/tools/deployed_version.txt

# DB maintenance markers the app/tests write to CWD (the repo root) at startup --
# the FTS-optimize and integrity-check timestamps. They are per-run state, not
# source, and dirtied the tree on every service/pytest run this session (tripping
# the stop hook). Ignore so a sandbox run leaves a clean tree.
.fts_optimize_last
.integrity_check_last
.integrity_last_run
# Capture/draft dirs the app + DOM-analyzer write under the repo root when
# capture_store_root is unset (default PROJECT_ROOT). Runtime artifacts, not source.
/captures/
/offline_out/
/offline_captures/
/templates/drafts/
/templates/review_candidates/

# Generated cache the app rewrites on a 1h TTL. community_scrapers.py:135
# resolves it as Path(".") / "community_scrapers_cache", and on the deploy host
# the service's cwd IS the install root IS the work tree -- so it lands here.
# community_scrapers_index.json was TRACKED, which meant `git reset --hard` on
# every deploy reverted it, the app overwrote it within the hour, and the box
# read permanently dirty. Its sibling manifest -- which records what the operator
# actually installed, i.e. real state -- was never tracked: git was carrying the
# cache and dropping the state. Derived, not spotted: see
# tests/test_generated_artifacts_are_not_tracked.py, whose denominator is every
# directory the app mkdirs at a repo-relative path.
/community_scrapers_cache/

# Operator state on the deploy host. Measured there 2026-07-29 as `??` in
# `git status --porcelain` -- untracked AND unignored, which is the worst of both
# states: `git clean -fd` destroys them (secrets.json is the credential store),
# and they make the deployed tree read dirty to anything inspecting git status.
# Ignoring them states the intent and lets test_no_tracked_file_is_gitignored
# catch a future `git add -f`, which would otherwise start committing credentials
# with an ignore rule sitting inert beside it.
# NOTE plugins/: plugins.json is TRACKED (shipped). Only the operator's own
# registry is ignored -- never the directory.
/secrets.json
/secrets_meta.json
/secrets.json.bak
/profiles/
/state/
/live_tests/results/
/plugins/plugins.registry.json
# macro_recorder.py:139 _macro_dir() mkdirs this INSIDE the resolver, so merely
# asking where macros live creates it. On the box $HOME/BulkDownloader IS the
# install root, so it lands in the work tree; it was invisible to `git status`
# only because an empty directory is not reported.
/macros/

# --- capture output: may contain live session material ---
captures/
live_recordings/
screenshots/
# reports/ holds BOTH generated inventories/diagnostics (ignored -- rebuilt by
# tools) AND frozen source-of-truth baselines/manifests the parity gates compare
# against (tracked). Ignore the directory contents, then re-include the
# baselines explicitly -- they were silently dropped from git by the old blanket
# `reports/` rule, which is why the parity gates could not find them.
reports/*
!reports/endpoint_reachability.json
!reports/config_gui_manifest.json
!reports/config_parity_baseline.json
!reports/legacy_parity_baseline.json
*.har
*.wacz

# --- release + session artifacts (distributed as zips, not tracked) ---
*.zip
out/
work/
nextsess/
audit_carry/

# --- local ---
.env
.env.*
!.env.example
.DS_Store
*.log
.claude-env-report.md
audit-venv/
audit_venv/
.claude-env-report.md
.worktrees/

# Ephemeral git worktrees created by isolated subagents. These are working
# copies of THIS repo nested inside it -- never commit them. Distinct from the
# `.worktrees/` entry above, which that pattern does not match.
.claude/worktrees/
