# --- environments (never commit; rebuilt by bootstrap) ---
venv/
.venv/
node_modules/
*.egg-info/

# --- build output ---
frontend/dist/
build/
dist/
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.node-compile-cache/

# --- runtime state (BD_HOME): user data, history, credentials ---
bd_home/
*.db
*.sqlite3
app_config.json
sites_config.json
cookies/
*.cookies.json
vapid_keys.json          # generated web-push PRIVATE key -- must never be committed

# DB maintenance markers the app/tests write to CWD (the repo root) at startup --
# the FTS-optimize and integrity-check timestamps. They are per-run state, not
# source, and dirtied the tree on every service/pytest run this session (tripping
# the stop hook). Ignore so a sandbox run leaves a clean tree.
.fts_optimize_last
.integrity_check_last
.integrity_last_run
# Capture/draft dirs the app + DOM-analyzer write under the repo root when
# capture_store_root is unset (default PROJECT_ROOT). Runtime artifacts, not source.
/captures/
/offline_out/
/offline_captures/
/templates/drafts/
/templates/review_candidates/

# --- capture output: may contain live session material ---
captures/
live_recordings/
screenshots/
# reports/ holds BOTH generated inventories/diagnostics (ignored -- rebuilt by
# tools) AND frozen source-of-truth baselines/manifests the parity gates compare
# against (tracked). Ignore the directory contents, then re-include the
# baselines explicitly -- they were silently dropped from git by the old blanket
# `reports/` rule, which is why the parity gates could not find them.
reports/*
!reports/config_gui_manifest.json
!reports/config_parity_baseline.json
!reports/legacy_parity_baseline.json
*.har
*.wacz

# --- release + session artifacts (distributed as zips, not tracked) ---
*.zip
out/
work/
nextsess/
audit_carry/

# --- local ---
.env
.env.*
!.env.example
.DS_Store
*.log
.claude-env-report.md
audit-venv/
audit_venv/
.claude-env-report.md
.worktrees/
