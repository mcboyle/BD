+"use client";
+
+import React, { memo, useCallback, useEffect, useId, useMemo, useRef, useState } from "react";
+import { Activity, AlertTriangle, ArrowDown, ArrowUp, Maximize2, Minimize2, RefreshCw } from "lucide-react";
+import { ErrorBoundary } from "./ErrorBoundary";
+
+export interface TelemetryPoint {
+  timestamp: string | number;
+  value: number;
+  label?: string;
+  metadata?: Record<string, unknown>;
+}
+
+export interface TelemetrySeries {
+  id: string;
+  name: string;
+  color?: string;
+  points: TelemetryPoint[];
+  unit?: string;
+}
+
+export interface TelemetryChartProps {
+  series?: TelemetrySeries[];
+  dataPoints?: TelemetryPoint[]; // Convenience shorthand for single-series
+  title?: string;
+  subtitle?: string;
+  height?: number;
+  autoRefreshIntervalMs?: number;
+  showAverages?: boolean;
+  showPercentiles?: boolean;
+  unit?: string;
+  className?: string;
+  onRefresh?: () => void;
+}
+
+interface ComputedStats {
+  min: number;
+  max: number;
+  avg: number;
+  p50: number;
+  p95: number;
+  p99: number;
+  latest: number;
+  deltaPct: number;
+}
+
+// Fallback error UI for the chart component
+function TelemetryChartFallback({ error, reset }: { error: Error | null; reset: () => void }) {
+  return (
+    <div
+      data-testid="telemetry-chart-error"
+      className="p-4 rounded-xl bg-zinc-950/90 border border-amber-500/40 font-mono text-xs text-zinc-300 space-y-3"
+    >
+      <div className="flex items-center justify-between border-b border-zinc-800 pb-2">
+        <div className="flex items-center space-x-2 text-amber-400 font-bold">
+          <AlertTriangle className="w-4 h-4" />
+          <span>Telemetry Chart Fault Isolated</span>
+        </div>
+        <button
+          onClick={reset}
+          className="flex items-center space-x-1 px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 rounded text-xs transition border border-zinc-700"
+        >
+          <RefreshCw className="w-3 h-3 text-emerald-400" />
+          <span>Reset Chart</span>
+        </button>
+      </div>
+      <p className="text-zinc-400 text-[11px]">
+        {error?.message || "An unexpected error occurred during telemetry series computation."}
+      </p>
+    </div>
+  );
+}
+
+function TelemetryChartInner({
+  series: rawSeries,
+  dataPoints,
+  title = "Telemetry Stream Throughput",
+  subtitle = "High-frequency metric observation pipeline",
+  height = 220,
+  autoRefreshIntervalMs = 0,
+  showAverages = true,
+  showPercentiles = true,
+  unit = "req/s",
+  className = "",
+  onRefresh,
+}: TelemetryChartProps) {
+  const chartId = useId();
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const [containerWidth, setContainerWidth] = useState<number>(640);
+  const [isExpanded, setIsExpanded] = useState<boolean>(false);
+  const [hasMounted, setHasMounted] = useState<boolean>(false);
+
+  // Hydration Protection (R3): Avoid SSR client/server mismatch for dynamic timestamps
+  useEffect(() => {
+    setHasMounted(true);
+  }, []);
+
+  // R1: Proper event listener and ResizeObserver unmount teardown
+  useEffect(() => {
+    if (!containerRef.current) return;
+    const observer = new ResizeObserver((entries) => {
+      for (const entry of entries) {
+        if (entry.contentRect.width > 0) {
+          setContainerWidth(Math.floor(entry.contentRect.width));
+        }
+      }
+    });
+
+    observer.observe(containerRef.current);
+    return () => {
+      observer.disconnect();
+    };
+  }, []);
+
+  // R1: Periodic refresh interval cleanup
+  useEffect(() => {
+    if (autoRefreshIntervalMs <= 0 || !onRefresh) return;
+    const timer = setInterval(() => {
+      onRefresh();
+    }, autoRefreshIntervalMs);
+
+    return () => {
+      clearInterval(timer);
+    };
+  }, [autoRefreshIntervalMs, onRefresh]);
+
+  // Normalize single-series dataPoints prop into series array
+  const activeSeries: TelemetrySeries[] = useMemo(() => {
+    if (rawSeries && rawSeries.length > 0) return rawSeries;
+    if (dataPoints && dataPoints.length > 0) {
+      return [
+        {
+          id: "primary",
+          name: title,
+          color: "#10b981", // emerald-500
+          points: dataPoints,
+          unit,
+        },
+      ];
+    }
+    return [
+      {
+        id: "empty",
+        name: title,
+        color: "#10b981",
+        points: [],
+        unit,
+      },
+    ];
+  }, [rawSeries, dataPoints, title, unit]);
+
+  // R2: Expensive telemetry statistical calculations wrapped in useMemo
+  const stats: Record<string, ComputedStats> = useMemo(() => {
+    const result: Record<string, ComputedStats> = {};
+
+    for (const s of activeSeries) {
+      const vals = s.points.map((p) => p.value).filter((v) => Number.isFinite(v));
+      if (vals.length === 0) {
+        result[s.id] = {
+          min: 0,
+          max: 0,
+          avg: 0,
+          p50: 0,
+          p95: 0,
+          p99: 0,
+          latest: 0,
+          deltaPct: 0,
+        };
+        continue;
+      }
+
+      let sum = 0;
+      let min = vals[0];
+      let max = vals[0];
+      for (let i = 0; i < vals.length; i++) {
+        const v = vals[i];
+        sum += v;
+        if (v < min) min = v;
+        if (v > max) max = v;
+      }
+      const avg = sum / vals.length;
+
+      // Sorted copy for percentiles
+      const sorted = [...vals].sort((a, b) => a - b);
+      const p50 = sorted[Math.floor(sorted.length * 0.5)];
+      const p95 = sorted[Math.floor(sorted.length * 0.95)];
+      const p99 = sorted[Math.floor(sorted.length * 0.99)];
+      const latest = vals[vals.length - 1];
+      const previous = vals.length > 1 ? vals[vals.length - 2] : latest;
+      const deltaPct = previous !== 0 ? ((latest - previous) / previous) * 100 : 0;
+
+      result[s.id] = {
+        min,
+        max,
+        avg,
+        p50,
+        p95,
+        p99,
+        latest,
+        deltaPct,
+      };
+    }
+
+    return result;
+  }, [activeSeries]);
+
+  // R2: Global coordinate boundaries memoized
+  const { globalMax, globalMin } = useMemo(() => {
+    let max = 1;
+    let min = 0;
+    for (const s of activeSeries) {
+      const stat = stats[s.id];
+      if (stat) {
+        if (stat.max > max) max = stat.max;
+        if (stat.min < min) min = stat.min;
+      }
+    }
+    return { globalMax: max * 1.1, globalMin: Math.min(0, min) };
+  }, [activeSeries, stats]);
+
+  // R2: SVG path generation memoized to avoid geometry recalc on unrelated re-renders
+  const paddingX = 40;
+  const paddingY = 25;
+  const plotWidth = Math.max(100, containerWidth - paddingX * 2);
+  const plotHeight = Math.max(60, (isExpanded ? height * 1.6 : height) - paddingY * 2);
+
+  const seriesPaths = useMemo(() => {
+    return activeSeries.map((s) => {
+      const points = s.points;
+      if (points.length < 2) {
+        return { id: s.id, linePath: "", areaPath: "", points: [] };
+      }
+
+      const rangeY = globalMax - globalMin || 1;
+      const mappedPoints = points.map((p, idx) => {
+        const x = paddingX + (idx / (points.length - 1)) * plotWidth;
+        const normalizedY = (p.value - globalMin) / rangeY;
+        const y = paddingY + plotHeight - normalizedY * plotHeight;
+        return { x, y, value: p.value, timestamp: p.timestamp };
+      });
+
+      const linePath = mappedPoints.reduce(
+        (acc, pt, idx) => `${acc} ${idx === 0 ? "M" : "L"} ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`,
+        ""
+      );
+
+      const baselineY = paddingY + plotHeight;
+      const firstX = mappedPoints[0].x.toFixed(1);
+      const lastX = mappedPoints[mappedPoints.length - 1].x.toFixed(1);
+      const areaPath = `${linePath} L ${lastX} ${baselineY} L ${firstX} ${baselineY} Z`;
+
+      return {
+        id: s.id,
+        linePath,
+        areaPath,
+        points: mappedPoints,
+      };
+    });
+  }, [activeSeries, globalMax, globalMin, plotWidth, plotHeight]);
+
+  const primarySeries = activeSeries[0];
+  const primaryStats = stats[primarySeries?.id] || {
+    min: 0,
+    max: 0,
+    avg: 0,
+    p50: 0,
+    p95: 0,
+    p99: 0,
+    latest: 0,
+    deltaPct: 0,
+  };
+
+  return (
+    <div
+      ref={containerRef}
+      data-testid="telemetry-chart-container"
+      className={`bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 shadow-2xl relative space-y-4 font-mono ${className}`}
+    >
+      {/* Chart Header */}
+      <div className="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-800/80 pb-3">
+        <div className="space-y-1">
+          <div className="flex items-center space-x-2">
+            <Activity className="w-4 h-4 text-emerald-400" />
+            <h3 className="text-sm font-bold text-zinc-100">{title}</h3>
+            <span className="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded font-bold">
+              REALTIME
+            </span>
+          </div>
+          <p className="text-xs text-zinc-400">{subtitle}</p>
+        </div>
+
+        <div className="flex items-center space-x-3">
+          {onRefresh && (
+            <button
+              onClick={onRefresh}
+              aria-label="Refresh telemetry data"
+              className="p-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition border border-zinc-700"
+            >
+              <RefreshCw className="w-3.5 h-3.5" />
+            </button>
+          )}
+          <button
+            onClick={() => setIsExpanded((prev) => !prev)}
+            aria-label={isExpanded ? "Collapse chart" : "Expand chart"}
+            className="p-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition border border-zinc-700"
+          >
+            {isExpanded ? <Minimize2 className="w-3.5 h-3.5" /> : <Maximize2 className="w-3.5 h-3.5" />}
+          </button>
+        </div>
+      </div>
+
+      {/* KPI Headline Badges */}
+      <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
+        <div className="bg-zinc-950/70 border border-zinc-800 p-2.5 rounded-lg">
+          <span className="text-zinc-500 text-[10px] uppercase font-bold block">Current Rate</span>
+          <div className="flex items-baseline space-x-1.5 mt-0.5">
+            <span className="text-lg font-bold text-emerald-400">
+              {primaryStats.latest.toFixed(1)}
+            </span>
+            <span className="text-[10px] text-zinc-400">{unit}</span>
+          </div>
+        </div>
+
+        {showAverages && (
+          <div className="bg-zinc-950/70 border border-zinc-800 p-2.5 rounded-lg">
+            <span className="text-zinc-500 text-[10px] uppercase font-bold block">Mean Avg</span>
+            <div className="flex items-baseline space-x-1.5 mt-0.5">
+              <span className="text-lg font-bold text-zinc-200">
+                {primaryStats.avg.toFixed(1)}
+              </span>
+              <span className="text-[10px] text-zinc-400">{unit}</span>
+            </div>
+          </div>
+        )}
+
+        {showPercentiles && (
+          <div className="bg-zinc-950/70 border border-zinc-800 p-2.5 rounded-lg">
+            <span className="text-zinc-500 text-[10px] uppercase font-bold block">p95 Ceiling</span>
+            <div className="flex items-baseline space-x-1.5 mt-0.5">
+              <span className="text-lg font-bold text-cyan-400">
+                {primaryStats.p95.toFixed(1)}
+              </span>
+              <span className="text-[10px] text-zinc-400">{unit}</span>
+            </div>
+          </div>
+        )}
+
+        <div className="bg-zinc-950/70 border border-zinc-800 p-2.5 rounded-lg">
+          <span className="text-zinc-500 text-[10px] uppercase font-bold block">Recent Drift</span>
+          <div className="flex items-center space-x-1 mt-0.5">
+            {primaryStats.deltaPct >= 0 ? (
+              <ArrowUp className="w-3.5 h-3.5 text-emerald-400" />
+            ) : (
+              <ArrowDown className="w-3.5 h-3.5 text-rose-400" />
+            )}
+            <span
+              className={`text-sm font-bold ${
+                primaryStats.deltaPct >= 0 ? "text-emerald-400" : "text-rose-400"
+              }`}
+            >
+              {Math.abs(primaryStats.deltaPct).toFixed(1)}%
+            </span>
+          </div>
+        </div>
+      </div>
+
+      {/* SVG Sparkline & Chart Canvas */}
+      <div className="relative w-full overflow-hidden bg-zinc-950/90 border border-zinc-800/80 rounded-xl p-2">
+        <svg
+          width="100%"
+          height={isExpanded ? height * 1.6 : height}
+          viewBox={`0 0 ${containerWidth} ${isExpanded ? height * 1.6 : height}`}
+          className="overflow-visible"
+        >
+          <defs>
+            {activeSeries.map((s) => (
+              <linearGradient
+                key={`grad-${s.id}`}
+                id={`grad-${chartId}-${s.id}`}
+                x1="0"
+                y1="0"
+                x2="0"
+                y2="1"
+              >
+                <stop offset="0%" stopColor={s.color || "#10b981"} stopOpacity="0.35" />
+                <stop offset="100%" stopColor={s.color || "#10b981"} stopOpacity="0.0" />
+              </linearGradient>
+            ))}
+          </defs>
+
+          {/* Grid lines */}
+          <line
+            x1={paddingX}
+            y1={paddingY}
+            x2={paddingX + plotWidth}
+            y2={paddingY}
+            stroke="#27272a"
+            strokeDasharray="3 3"
+          />
+          <line
+            x1={paddingX}
+            y1={paddingY + plotHeight / 2}
+            x2={paddingX + plotWidth}
+            y2={paddingY + plotHeight / 2}
+            stroke="#27272a"
+            strokeDasharray="3 3"
+          />
+          <line
+            x1={paddingX}
+            y1={paddingY + plotHeight}
+            x2={paddingX + plotWidth}
+            y2={paddingY + plotHeight}
+            stroke="#3f3f46"
+          />
+
+          {/* Y-Axis scale labels */}
+          <text
+            x={paddingX - 8}
+            y={paddingY + 4}
+            textAnchor="end"
+            fontSize="10"
+            fill="#71717a"
+            fontFamily="monospace"
+          >
+            {globalMax.toFixed(0)}
+          </text>
+          <text
+            x={paddingX - 8}
+            y={paddingY + plotHeight / 2 + 3}
+            textAnchor="end"
+            fontSize="10"
+            fill="#71717a"
+            fontFamily="monospace"
+          >
+            {((globalMax + globalMin) / 2).toFixed(0)}
+          </text>
+          <text
+            x={paddingX - 8}
+            y={paddingY + plotHeight}
+            textAnchor="end"
+            fontSize="10"
+            fill="#71717a"
+            fontFamily="monospace"
+          >
+            {globalMin.toFixed(0)}
+          </text>
+
+          {/* Series Paths */}
+          {seriesPaths.map((sp) => {
+            const seriesConfig = activeSeries.find((s) => s.id === sp.id);
+            const color = seriesConfig?.color || "#10b981";
+            if (!sp.linePath) return null;
+
+            return (
+              <g key={sp.id}>
+                <path d={sp.areaPath} fill={`url(#grad-${chartId}-${sp.id})`} />
+                <path
+                  d={sp.linePath}
+                  fill="none"
+                  stroke={color}
+                  strokeWidth="2"
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                />
+                {sp.points.map((pt, pIdx) => (
+                  <circle
+                    key={pIdx}
+                    cx={pt.x}
+                    cy={pt.y}
+                    r={pIdx === sp.points.length - 1 ? "4" : "2"}
+                    fill={color}
+                    className="transition-all duration-150"
+                  />
+                ))}
+              </g>
+            );
+          })}
+        </svg>
+      </div>
+
+      {/* Footer Status with Hydration Safe Timestamp (R3) */}
+      <div className="flex items-center justify-between text-[11px] text-zinc-500 pt-1">
+        <span>Sample Count: {primarySeries.points.length} points</span>
+        <span suppressHydrationWarning>
+          {hasMounted
+            ? `Telemetry synced: ${new Date().toLocaleTimeString()}`
+            : "Telemetry syncing..."}
+        </span>
+      </div>
+    </div>
+  );
+}
+
+/**
+ * TelemetryChart with ErrorBoundary isolation wrapper
+ */
+export function TelemetryChart(props: TelemetryChartProps) {
+  return (
+    <ErrorBoundary name="TelemetryChart" fallback={TelemetryChartFallback}>
+      <TelemetryChartInner {...props} />
+    </ErrorBoundary>
+  );
+}
+
+export default memo(TelemetryChart);

