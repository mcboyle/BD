+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { createRequire } from "node:module";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const SRC = path.join(ROOT, "src");
+const feRequire = createRequire(path.join(ROOT, "package.json"));
+
+test("R1: useWebSocket hook guarantees explicit teardown and listener nullification", () => {
+  const filePath = path.join(SRC, "hooks", "useWebSocket.ts");
+  assert.ok(fs.existsSync(filePath), "useWebSocket.ts must exist");
+  const code = fs.readFileSync(filePath, "utf8");
+
+  // R1: explicit listener nullification before close
+  assert.ok(code.includes("socket.onopen = null;"), "Must nullify socket.onopen in cleanup");
+  assert.ok(code.includes("socket.onmessage = null;"), "Must nullify socket.onmessage in cleanup");
+  assert.ok(code.includes("socket.onerror = null;"), "Must nullify socket.onerror in cleanup");
+  assert.ok(code.includes("socket.onclose = null;"), "Must nullify socket.onclose in cleanup");
+  assert.ok(code.includes("socket.close();"), "Must close active socket");
+
+  // Timers and mount tracking
+  assert.ok(code.includes("reconnectTimerRef.current"), "Must track reconnectTimerRef");
+  assert.ok(code.includes("heartbeatTimerRef.current"), "Must track heartbeatTimerRef");
+  assert.ok(code.includes("isMountedRef.current = false;"), "Must set isMountedRef false in teardown");
+});
+
+test("R1: useSwarmTelemetry hook implements complete event listener nullification and timer teardown", () => {
+  const filePath = path.join(SRC, "hooks", "useSwarmTelemetry.ts");
+  assert.ok(fs.existsSync(filePath), "useSwarmTelemetry.ts must exist");
+  const code = fs.readFileSync(filePath, "utf8");
+
+  // MEM-07: complete nullification
+  assert.ok(code.includes("ws.onopen = null;"), "Must nullify ws.onopen on unmount");
+  assert.ok(code.includes("ws.onmessage = null;"), "Must nullify ws.onmessage on unmount");
+  assert.ok(code.includes("ws.onerror = null;"), "Must nullify ws.onerror on unmount");
+  assert.ok(code.includes("ws.onclose = null;"), "Must nullify ws.onclose on unmount");
+  assert.ok(code.includes("clearTimeout(reconnectTimer);"), "Must clear reconnectTimer on unmount");
+  assert.ok(code.includes("cancelAnimationFrame(rafIdRef.current);"), "Must cancel animationFrame on unmount");
+});
+
+test("R1: useTelemetryStream avoids React 18 StrictMode duplicate socket leak", () => {
+  const filePath = path.join(SRC, "lib", "useTelemetryStream.ts");
+  assert.ok(fs.existsSync(filePath), "useTelemetryStream.ts must exist");
+  const code = fs.readFileSync(filePath, "utf8");
+
+  // MEM-08: detach all listeners before closing
+  assert.ok(code.includes("socket.onopen = null;"), "Must nullify socket.onopen before close");
+  assert.ok(code.includes("socket.onmessage = null;"), "Must nullify socket.onmessage before close");
+  assert.ok(code.includes("socket.onerror = null;"), "Must nullify socket.onerror before close");
+  assert.ok(code.includes("socket.onclose = null;"), "Must nullify socket.onclose before close");
+});
+
+test("R2: TelemetryChart memoizes statistics, series mapping and SVG path calculations", () => {
+  const filePath = path.join(SRC, "components", "TelemetryChart.tsx");
+  assert.ok(fs.existsSync(filePath), "TelemetryChart.tsx must exist");
+  const code = fs.readFileSync(filePath, "utf8");
+
+  assert.ok(code.includes("useMemo"), "Must import and use useMemo");
+  assert.ok(code.includes("stats: Record<string, ComputedStats> = useMemo("), "Must memoize statistical computations");
+  assert.ok(code.includes("seriesPaths = useMemo("), "Must memoize SVG line and area path calculations");
+  assert.ok(code.includes("observer.disconnect();"), "Must disconnect ResizeObserver on unmount");
+  assert.ok(code.includes("ErrorBoundary"), "Must wrap component in ErrorBoundary");
+  assert.ok(code.includes("suppressHydrationWarning"), "Must protect dynamic timestamps with suppressHydrationWarning");
+});
+
+test("R2: PerformanceTrendsGraph avoids Math.max array spread and memoizes totals", () => {
+  const filePath = path.join(SRC, "components", "dashboard", "PerformanceTrendsGraph.tsx");
+  assert.ok(fs.existsSync(filePath), "PerformanceTrendsGraph.tsx must exist");
+  const code = fs.readFileSync(filePath, "utf8");
+
+  assert.ok(code.includes("useMemo"), "Must import and use useMemo");
+  assert.ok(code.includes("const { totals, maxCount } = useMemo("), "Must memoize totals and maxCount together");
+  assert.ok(!code.includes("Math.max(1, ...buckets.map"), "Must NOT use unbounded array spread in Math.max");
+  assert.ok(code.includes("abortControllerRef"), "Must track AbortController in ref");
+  assert.ok(code.includes("abortControllerRef.current.abort()"), "Must abort in-flight requests on change or unmount");
+});
+
+test("R2 & R3: LiveTelemetryHud memoizes rangeTotals and guards unmounted async state updates", () => {
+  const filePath = path.join(SRC, "components", "dashboard", "LiveTelemetryHud.tsx");
+  assert.ok(fs.existsSync(filePath), "LiveTelemetryHud.tsx must exist");
+  const code = fs.readFileSync(filePath, "utf8");
+
+  assert.ok(code.includes("const rangeTotals = useMemo("), "Must wrap rangeTotals in useMemo");
+  assert.ok(code.includes("isMountedRef"), "Must track isMounted state");
+  assert.ok(code.includes("abortControllerRef"), "Must track AbortController in ref");
+  assert.ok(code.includes("suppressHydrationWarning"), "Must protect updatedAt with suppressHydrationWarning");
+});
+
+test("R1 & R2: SwarmTrackerSidebar memoizes filteredSessions and cleans up copy timeout", () => {
+  const filePath = path.join(SRC, "components", "SwarmTrackerSidebar.tsx");
+  assert.ok(fs.existsSync(filePath), "SwarmTrackerSidebar.tsx must exist");
+  const code = fs.readFileSync(filePath, "utf8");
+
+  assert.ok(code.includes("const { filteredSessions, activeCount, ptyCount } = useMemo("), "Must memoize filteredSessions and counts in single pass");
+  assert.ok(code.includes("copyTimeoutRef"), "Must track copy timeout in ref");
+  assert.ok(code.includes("clearTimeout(copyTimeoutRef.current)"), "Must clear pending copy timeout on unmount and click");
+});
+
+test("ERR-01 & ERR-02: Error boundaries protect real-time streaming components and app viewport", () => {
+  const visualizerCode = fs.readFileSync(path.join(SRC, "components", "LiveSwarmVisualizer.tsx"), "utf8");
+  assert.ok(visualizerCode.includes("<ErrorBoundary name=\"VisualizerCanvas\" fallback={VisualizerCanvasFallback}>"), "Visualizer must wrap FlowCanvas with ErrorBoundary");
+
+  const appShellCode = fs.readFileSync(path.join(SRC, "components", "navigation", "AppShell.tsx"), "utf8");
+  assert.ok(appShellCode.includes("<ErrorBoundary name=\"CockpitMainViewport\">"), "AppShell must wrap main viewport in ErrorBoundary");
+  assert.ok(appShellCode.includes("<ErrorBoundary name=\"SwarmTrackerSidebar\">"), "AppShell must wrap SwarmTrackerSidebar in ErrorBoundary");
+
+  const telemetryPageCode = fs.readFileSync(path.join(SRC, "app", "dashboard", "telemetry", "page.tsx"), "utf8");
+  assert.ok(telemetryPageCode.includes("<ErrorBoundary name=\"LiveTelemetryHud\">"), "Telemetry page must wrap LiveTelemetryHud in ErrorBoundary");
+
+  const trendsPageCode = fs.readFileSync(path.join(SRC, "app", "dashboard", "trends", "page.tsx"), "utf8");
+  assert.ok(trendsPageCode.includes("<ErrorBoundary name=\"PerformanceTrendsGraph\">"), "Trends page must wrap PerformanceTrendsGraph in ErrorBoundary");
+});
+
+test("R2 & R3: TelemetryChart renders cleanly with React SSR and validates data calculations", () => {
+  const ts = feRequire("typescript");
+  const React = feRequire("react");
+  const ReactDOMServer = feRequire("react-dom/server");
+
+  const compileCode = (filePath) =>
+    ts.transpileModule(fs.readFileSync(filePath, "utf8"), {
+      compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        target: ts.ScriptTarget.ES2020,
+        jsx: ts.JsxEmit.React,
+        esModuleInterop: true,
+      },
+    }).outputText;
+
+  const chartCode = compileCode(path.join(SRC, "components", "TelemetryChart.tsx"));
+  const ebCode = compileCode(path.join(SRC, "components", "ErrorBoundary.tsx"));
+
+  const ebModule = { exports: {} };
+  new Function("exports", "require", "module", ebCode)(ebModule.exports, feRequire, ebModule);
+
+  const chartModule = { exports: {} };
+  const mockRequire = (mod) => {
+    if (mod === "./ErrorBoundary") return ebModule.exports;
+    return feRequire(mod);
+  };
+  new Function("exports", "require", "module", chartCode)(chartModule.exports, mockRequire, chartModule);
+
+  const TelemetryChart = chartModule.exports.TelemetryChart || chartModule.exports.default;
+
+  const samplePoints = [
+    { timestamp: "2026-10-15T18:00:00Z", value: 120 },
+    { timestamp: "2026-10-15T18:01:00Z", value: 240 },
+    { timestamp: "2026-10-15T18:02:00Z", value: 180 },
+    { timestamp: "2026-10-15T18:03:00Z", value: 310 },
+  ];
+
+  const html = ReactDOMServer.renderToString(
+    React.createElement(TelemetryChart, {
+      title: "Throughput Matrix",
+      subtitle: "Verified test throughput",
+      dataPoints: samplePoints,
+      unit: "req/s",
+    })
+  );
+
+  assert.ok(html.includes("Throughput Matrix"), "HTML must contain chart title");
+  assert.ok(html.includes("telemetry-chart-container"), "HTML must contain chart container");
+  assert.ok(html.includes("310.0"), "HTML must include computed latest/peak metric");
+  assert.ok(html.includes("Telemetry syncing..."), "HTML must render hydration-safe SSR fallback placeholder");
+});
