+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+
+export type WebSocketConnectionState =
+  | "connecting"
+  | "connected"
+  | "reconnecting"
+  | "disconnected"
+  | "error";
+
+export interface WebSocketMetrics {
+  messagesReceived: number;
+  messagesSent: number;
+  bytesReceived: number;
+  reconnectCount: number;
+  lastConnectedAt: string | null;
+  lastMessageAt: string | null;
+}
+
+export interface UseWebSocketOptions<T = unknown> {
+  url?: string;
+  autoConnect?: boolean;
+  reconnect?: boolean;
+  reconnectAttempts?: number;
+  reconnectIntervalMs?: number;
+  maxReconnectIntervalMs?: number;
+  heartbeatIntervalMs?: number;
+  heartbeatMessage?: string;
+  onMessage?: (data: T) => void;
+  onError?: (event: Event) => void;
+  onOpen?: (event: Event) => void;
+  onClose?: (event: CloseEvent) => void;
+  transform?: (raw: unknown) => T;
+}
+
+export interface UseWebSocketResult<T = unknown> {
+  connectionState: WebSocketConnectionState;
+  isConnected: boolean;
+  lastMessage: T | null;
+  metrics: WebSocketMetrics;
+  sendMessage: (payload: unknown) => boolean;
+  reconnect: () => void;
+  disconnect: () => void;
+}
+
+/**
+ * High-performance, memory-leak-free WebSocket hook with strict teardown guarantees (R1).
+ * Nullifies all event handlers prior to close() to prevent React 18 StrictMode double-fire leaks.
+ * Tracks all timer IDs in refs and clears on unmount.
+ */
+export function useWebSocket<T = unknown>(
+  options: UseWebSocketOptions<T> = {}
+): UseWebSocketResult<T> {
+  const {
+    url,
+    autoConnect = true,
+    reconnect: enableReconnect = true,
+    reconnectAttempts = 10,
+    reconnectIntervalMs = 1000,
+    maxReconnectIntervalMs = 10000,
+    heartbeatIntervalMs = 30000,
+    heartbeatMessage = JSON.stringify({ type: "ping" }),
+    onMessage,
+    onError,
+    onOpen,
+    onClose,
+    transform,
+  } = options;
+
+  const [connectionState, setConnectionState] =
+    useState<WebSocketConnectionState>("disconnected");
+  const [lastMessage, setLastMessage] = useState<T | null>(null);
+  const [metrics, setMetrics] = useState<WebSocketMetrics>({
+    messagesReceived: 0,
+    messagesSent: 0,
+    bytesReceived: 0,
+    reconnectCount: 0,
+    lastConnectedAt: null,
+    lastMessageAt: null,
+  });
+
+  const wsRef = useRef<WebSocket | null>(null);
+  const isMountedRef = useRef<boolean>(true);
+  const reconnectAttemptRef = useRef<number>(0);
+  const reconnectTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const heartbeatTimerRef = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  // Keep latest callbacks in refs to avoid rebuilding connect callbacks on consumer re-render
+  const callbacksRef = useRef({
+    onMessage,
+    onError,
+    onOpen,
+    onClose,
+    transform,
+  });
+  useEffect(() => {
+    callbacksRef.current = {
+      onMessage,
+      onError,
+      onOpen,
+      onClose,
+      transform,
+    };
+  }, [onMessage, onError, onOpen, onClose, transform]);
+
+  // Teardown helper: detaches listeners BEFORE close to prevent React 18 race conditions
+  const cleanupSocket = useCallback(() => {
+    if (heartbeatTimerRef.current) {
+      clearInterval(heartbeatTimerRef.current);
+      heartbeatTimerRef.current = null;
+    }
+    if (reconnectTimerRef.current) {
+      clearTimeout(reconnectTimerRef.current);
+      reconnectTimerRef.current = null;
+    }
+
+    if (wsRef.current) {
+      const socket = wsRef.current;
+      socket.onopen = null;
+      socket.onmessage = null;
+      socket.onerror = null;
+      socket.onclose = null;
+      try {
+        if (
+          socket.readyState === WebSocket.OPEN ||
+          socket.readyState === WebSocket.CONNECTING
+        ) {
+          socket.close();
+        }
+      } catch {
+        // Suppress socket closure errors during unmount/cleanup
+      }
+      wsRef.current = null;
+    }
+  }, []);
+
+  const resolveEndpoint = useCallback((): string => {
+    if (url) return url;
+    if (typeof window === "undefined") return "ws://127.0.0.1:8000/api/swarm/ws";
+    const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
+    const host = window.location.hostname || "127.0.0.1";
+    return `${protocol}//${host}:8000/api/swarm/ws`;
+  }, [url]);
+
+  const connect = useCallback(() => {
+    if (!isMountedRef.current) return;
+    if (typeof window === "undefined") return;
+
+    cleanupSocket();
+
+    try {
+      setConnectionState("connecting");
+      const targetUrl = resolveEndpoint();
+      const ws = new WebSocket(targetUrl);
+      wsRef.current = ws;
+
+      ws.onopen = (evt: Event) => {
+        if (!isMountedRef.current) return;
+        reconnectAttemptRef.current = 0;
+        setConnectionState("connected");
+        setMetrics((prev) => ({
+          ...prev,
+          lastConnectedAt: new Date().toISOString(),
+        }));
+
+        if (heartbeatIntervalMs > 0) {
+          if (heartbeatTimerRef.current) clearInterval(heartbeatTimerRef.current);
+          heartbeatTimerRef.current = setInterval(() => {
+            if (wsRef.current?.readyState === WebSocket.OPEN) {
+              try {
+                wsRef.current.send(heartbeatMessage);
+              } catch {
+                // Heartbeat send failed
+              }
+            }
+          }, heartbeatIntervalMs);
+        }
+
+        callbacksRef.current.onOpen?.(evt);
+      };
+
+      ws.onmessage = (evt: MessageEvent) => {
+        if (!isMountedRef.current) return;
+
+        let parsed: unknown = evt.data;
+        if (typeof evt.data === "string") {
+          try {
+            parsed = JSON.parse(evt.data);
+          } catch {
+            parsed = evt.data;
+          }
+        }
+
+        const transformed = callbacksRef.current.transform
+          ? callbacksRef.current.transform(parsed)
+          : (parsed as T);
+
+        setLastMessage(transformed);
+        setMetrics((prev) => ({
+          ...prev,
+          messagesReceived: prev.messagesReceived + 1,
+          bytesReceived:
+            prev.bytesReceived +
+            (typeof evt.data === "string" ? evt.data.length : 0),
+          lastMessageAt: new Date().toISOString(),
+        }));
+
+        callbacksRef.current.onMessage?.(transformed);
+      };
+
+      ws.onerror = (evt: Event) => {
+        if (!isMountedRef.current) return;
+        setConnectionState("error");
+        callbacksRef.current.onError?.(evt);
+      };
+
+      ws.onclose = (evt: CloseEvent) => {
+        if (!isMountedRef.current) return;
+
+        cleanupSocket();
+        callbacksRef.current.onClose?.(evt);
+
+        if (
+          enableReconnect &&
+          reconnectAttemptRef.current < reconnectAttempts
+        ) {
+          setConnectionState("reconnecting");
+          const attempt = reconnectAttemptRef.current;
+          const delay = Math.min(
+            reconnectIntervalMs * Math.pow(1.5, attempt),
+            maxReconnectIntervalMs
+          );
+          reconnectAttemptRef.current += 1;
+
+          setMetrics((prev) => ({
+            ...prev,
+            reconnectCount: prev.reconnectCount + 1,
+          }));
+
+          reconnectTimerRef.current = setTimeout(() => {
+            if (isMountedRef.current) {
+              connect();
+            }
+          }, delay);
+        } else {
+          setConnectionState("disconnected");
+        }
+      };
+    } catch {
+      if (isMountedRef.current) {
+        setConnectionState("error");
+      }
+    }
+  }, [
+    cleanupSocket,
+    resolveEndpoint,
+    heartbeatIntervalMs,
+    heartbeatMessage,
+    enableReconnect,
+    reconnectAttempts,
+    reconnectIntervalMs,
+    maxReconnectIntervalMs,
+  ]);
+
+  const disconnect = useCallback(() => {
+    reconnectAttemptRef.current = reconnectAttempts; // prevent auto-reconnect
+    cleanupSocket();
+    if (isMountedRef.current) {
+      setConnectionState("disconnected");
+    }
+  }, [cleanupSocket, reconnectAttempts]);
+
+  const reconnect = useCallback(() => {
+    reconnectAttemptRef.current = 0;
+    connect();
+  }, [connect]);
+
+  const sendMessage = useCallback((payload: unknown): boolean => {
+    if (!wsRef.current || wsRef.current.readyState !== WebSocket.OPEN) {
+      return false;
+    }
+    try {
+      const message =
+        typeof payload === "string" ? payload : JSON.stringify(payload);
+      wsRef.current.send(message);
+      setMetrics((prev) => ({
+        ...prev,
+        messagesSent: prev.messagesSent + 1,
+      }));
+      return true;
+    } catch {
+      return false;
+    }
+  }, []);
+
+  useEffect(() => {
+    isMountedRef.current = true;
+    if (autoConnect) {
+      connect();
+    }
+    return () => {
+      isMountedRef.current = false;
+      cleanupSocket();
+    };
+  }, [autoConnect, connect, cleanupSocket]);
+
+  return {
+    connectionState,
+    isConnected: connectionState === "connected",
+    lastMessage,
+    metrics,
+    sendMessage,
+    reconnect,
+    disconnect,
+  };
+}

