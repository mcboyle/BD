{
  "schema": "bd-mutate-spec/1",
  "_comment": "Rows 612 and 632. The first two mutants remove bd-precut main()'s baseline derivation and tracked-denominator wiring; the band deliberately includes all five older row-463 unit tests so their continued PASS is visible beside the main-entry-point catcher. The remaining mutants remove each part of bd-imports' executable --shrink remedy.",
  "subject": "w2-toolchain -- bd-precut main wiring and bd-imports shrink remedy",
  "band": [
    "tests/test_row463_precut_derives_its_baseline.py",
    "tests/test_verify_lane_state_naming.py::test_row464_the_predictor_is_reported_beside_not_inside_the_gate_verdict"
  ],
  "mutants": [
    {
      "label": "M1 bd-precut main no longer derives an absent baseline",
      "file": "toolchain/bin/bd-precut",
