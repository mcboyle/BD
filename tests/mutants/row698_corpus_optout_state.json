      "label": "M1 scan string tokens instead of real comments",
      "file": "toolchain/bin/bdtools_sec.py",
      "old_regex": "(?<=tok.type == )tokenize\\.COMMENT(?=\\n)",
      "new": "tokenize.STRING",
      "direction": "regression",
      "catcher": "tests/test_row698_corpus_guard_execution.py::test_row698_guard_roster_executes_and_reports_four_distinct_states"
    },
    {
      "label": "M2 ignore every parsed marker",
      "file": "toolchain/bin/bdtools_sec.py",
      "old_regex": "(?<=    if )markers(?=:)",
      "new": "()",
      "direction": "regression",
      "catcher": "tests/test_row698_corpus_guard_execution.py::test_row698_guard_roster_executes_and_reports_four_distinct_states"
    },
    {
      "label": "M3 accept a reasonless marker",
      "file": "toolchain/bin/bdtools_sec.py",
      "old_regex": "(?<=        if )all(?=\\(markers\\))",
      "new": "bool",
      "direction": "regression",
      "catcher": "tests/test_row698_corpus_guard_execution.py::test_row698_guard_roster_executes_and_reports_four_distinct_states"
    },
    {
      "label": "M4 accounting folds opted-out tools into guarded",
