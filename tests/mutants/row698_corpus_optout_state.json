{
  "schema": "bd-mutate-spec/1",
  "_comment": "Row 698 opt-out state. Anchors are value-free structural identifiers; marker text and state values occur only outside matched spans.",
  "subject": "reasoned corpus marker is an explicit opted-out state and never guarded",
  "band": [
    "tests/test_row698_corpus_guard_execution.py::test_row698_guard_roster_executes_and_reports_four_distinct_states"
  ],
  "mutants": [
