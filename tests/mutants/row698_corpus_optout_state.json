      "direction": "regression",
      "catcher": "tests/test_row698_corpus_guard_execution.py::test_row698_guard_roster_executes_and_reports_four_distinct_states"
    },
    {
      "label": "M5 lint ignores parsed opt-out reasons",
      "file": "toolchain/bin/bd-tool-lint",
      "old_regex": "(?<=opt_out_reasons = )sec\\.corpus_opt_out_reasons(?=\\(src\\))",
      "new": "(lambda *_args: ())",
      "direction": "regression",
      "catcher": "tests/test_row698_corpus_guard_execution.py::test_row698_guard_roster_executes_and_reports_four_distinct_states"
    }
  ]
