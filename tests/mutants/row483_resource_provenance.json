{
  "schema": "bd-mutate-spec/1",
  "_comment": "Rows 483 and 575. A page-level claim is not proof that a nonzero partial belongs to the media resource now being requested. The battery pins both transport claim sites, resource binding, mismatch refusal before Range, compatible legacy binding, the measured empty rebind branch, and signed-query rotation. Every old_regex resolves exactly once in the subject.",
  "subject": "sequential and parallel resumes are allowed only when their claims prove the current media resource",
  "band": [
    "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes",
    "tests/test_part_staging_collision.py::test_parallel_changed_resource_refuses_before_any_range",
    "tests/test_part_staging_collision.py::test_resource_binding_ignores_rotating_signatures_but_not_a_new_path",
    "tests/test_part_staging_collision.py::test_a_proven_legacy_claim_binds_without_discarding_its_resume",
    "tests/test_part_staging_collision.py::test_an_empty_proven_claim_measures_zero_before_rebinding",
    "tests/test_part_staging_collision.py::test_v2_still_requires_the_proof_field_after_the_resource_format_bump",
    "tests/test_part_staging_collision.py::test_the_same_job_resumes_its_own_part_and_is_not_restarted"
  ],
  "mutants": [
    {
      "label": "M1 resource_url is accepted but never bound to the claim",
      "file": "bulk_downloader/staging_claim.py",
      "old_regex": "return\\s+hashlib\\.sha256\\(canonical\\.encode",
      "new": "return hashlib.sha256(b\"same-resource\").hexdigest()  # disabled ",
      "direction": "regression",
      "catcher": "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes"
    },
    {
      "label": "M2 matching resource identities no longer resume",
      "file": "bulk_downloader/staging_claim.py",
      "old_regex": "(?m)(?<=            if held_resource == resource:\\n)                return\\s+staging$",
      "new": "                raise StagingResourceMismatch(\"matching resource refused\")",
      "direction": "overcorrection",
      "control": "tests/test_part_staging_collision.py::test_resource_binding_ignores_rotating_signatures_but_not_a_new_path",
      "preserves": [
        "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes"
      ]
    },
    {
      "label": "M3 rotating signed query values become different resources",
      "file": "bulk_downloader/staging_claim.py",
      "old_regex": "parsed\\.path",
      "new": "parsed.path + parsed.query",
      "direction": "overcorrection",
      "control": "tests/test_part_staging_collision.py::test_resource_binding_ignores_rotating_signatures_but_not_a_new_path",
      "preserves": [
        "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes"
      ]
    },
    {
      "label": "M4 a measured resource mismatch is rebound over nonzero bytes",
      "file": "bulk_downloader/staging_claim.py",
      "old_regex": "raise\\s+StagingResourceMismatch",
      "new": "return staging\n                RuntimeError",
      "direction": "regression",
      "catcher": "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes"
    },
    {
      "label": "M5 an empty staging path is mistaken for nonzero bytes",
      "file": "bulk_downloader/staging_claim.py",
      "old_regex": "staging\\.stat\\(\\)\\.st_size(?=\\n            except FileNotFoundError)",
      "new": "staging.exists()",
      "direction": "overcorrection",
      "control": "tests/test_part_staging_collision.py::test_an_empty_proven_claim_measures_zero_before_rebinding",
      "preserves": [
        "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes"
      ]
    },
    {
      "label": "M6 the v3 format bump accidentally grandfathers malformed v2 proof records",
      "file": "bulk_downloader/staging_claim.py",
      "old_regex": "version\\s*<\\s*OWNER_PROOF_FORMAT_VERSION",
      "new": "version < OWNER_FORMAT_VERSION",
      "direction": "regression",
      "catcher": "tests/test_part_staging_collision.py::test_v2_still_requires_the_proof_field_after_the_resource_format_bump"
    },
    {
      "label": "M7 parallel transport drops its only resource-bound claim",
      "file": "bulk_downloader/runner_transport.py",
      "old_regex": "(?m)(?<=            tmp_path = )staging_claim\\.claim(?=\\(\\n                final_path, staging_claim\\.job_identity\\(page_url\\),\\n                resource_url=file_url\\)$)",
      "new": "(lambda *args, **kwargs: staging_claim.claim(*args))",
      "direction": "regression",
      "catcher": "tests/test_part_staging_collision.py::test_parallel_changed_resource_refuses_before_any_range"
    },
    {
      "label": "M8 sequential transport drops its resource-bound claim",
      "file": "bulk_downloader/runner_transport.py",
      "old_regex": "(?m)(?<=            tmp_path = )staging_claim\\.claim(?=\\(\\n                final_path, identity, resource_url=file_url\\)$)",
      "new": "(lambda *args, **kwargs: staging_claim.claim(*args))",
      "direction": "regression",
      "catcher": "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes"
    }
  ]
}
