{
  "schema": "bd-mutate-spec/1",
  "_comment": "Rows 483 and 575. A page-level claim is not proof that a nonzero sequential partial belongs to the media resource now being requested. The battery pins resource binding, mismatch refusal before Range, compatible legacy binding, the measured empty rebind branch, and signed-query rotation. Every anchor occurs exactly once in the subject.",
  "subject": "a nonzero sequential resume is allowed only when its claim proves the current media resource",
  "band": [
    "tests/test_part_staging_collision.py::test_changed_resource_is_never_appended_to_the_old_resources_bytes",
    "tests/test_part_staging_collision.py::test_resource_binding_ignores_rotating_signatures_but_not_a_new_path",
    "tests/test_part_staging_collision.py::test_a_proven_legacy_claim_binds_without_discarding_its_resume",
    "tests/test_part_staging_collision.py::test_an_empty_proven_claim_measures_zero_before_rebinding",
    "tests/test_part_staging_collision.py::test_v2_still_requires_the_proof_field_after_the_resource_format_bump",
    "tests/test_part_staging_collision.py::test_the_same_job_resumes_its_own_part_and_is_not_restarted"
  ],
  "mutants": [
