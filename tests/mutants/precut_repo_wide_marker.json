{
  "schema": "bd-mutate-spec/1",
  "_comment": "PM-B row: bd-precut selects repo-wide gates BY MARKER, not by its hand list. Every anchor is a zero-width lookbehind/lookahead pair on a DECISION the patch adds -- the scope predicate, the COULD-NOT-LOOK arm, the UNKNOWN arms, the union wiring, the module-scope walk, the xdist arm -- and the inserted text inverts, disables or drops it; no anchor matches a value. The transform control lives in precut_repo_wide_marker_transform_control.json and MUST escape.",
  "subject": "bd-precut --gate selects every tracked tests/test*.py declaring BD_GATE_SCOPE = \"repo-wide\" beside its hand-listed floor, reports what it could not classify as UNKNOWN by name, and runs the union in one xdist subprocess",
  "band": [
    "tests/test_precut_selects_repo_wide_gates_by_marker.py",
    "tests/test_v3_66_1239_precut_runs_the_underived_gates.py",
    "tests/test_verify_lane_state_naming.py"
  ],
  "mutants": [
    {
      "label": "S1 the repo-wide predicate is inverted: module gates are selected and repo-wide ones are not",
      "file": "toolchain/bin/bd-precut",
      "old_regex": "(?m)(?<=^        elif )(?=scope == _REPO_WIDE_SCOPE:$)",
      "new": "not ",
      "direction": "regression",
      "catcher": "tests/test_precut_selects_repo_wide_gates_by_marker.py::test_a_new_repo_wide_gate_is_selected_and_a_module_gate_is_not"
    },
    {
      "label": "S2 a git that answered is treated as COULD NOT LOOK, so only the floor runs",
      "file": "toolchain/bin/bd-precut",
      "old_regex": "(?m)(?<=^    if )(?=run\\.returncode != 0:\\n        census\\[\\\"error\\\"\\])",
      "new": "not ",
      "direction": "regression",
      "catcher": "tests/test_precut_selects_repo_wide_gates_by_marker.py::test_a_new_repo_wide_gate_is_selected_and_a_module_gate_is_not"
    },
    {
