    "tests/test_v3_66_261_contended_lifecycle_lock.py::test_all_lifecycle_entry_points_acquire_at_depth_exactly_one",
    "tests/test_db_replication.py::test_repeated_start_spawns_exactly_one_sidecar",
    "tests/test_db_replication.py::test_stop_refuses_an_unidentified_legacy_pid_without_signalling",
