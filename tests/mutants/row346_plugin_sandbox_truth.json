      "direction": "regression",
      "catcher": "tests/test_row346_plugin_sandbox_is_truthful.py::test_checker_distinguishes_the_six_leaky_launches_from_the_secure_tree"
    },
    {
      "label": "M5 checker drops the generic exec bridge from its population",
      "file": "toolchain/bin/bd-plugin-sandbox-check",
      "old": "BRIDGES = (\"plugin_node.py\", \"plugin_py_bridge.py\", \"plugin_exec.py\")",
