      "old": "    return jsonify(payload), (200 if payload[\"ok\"] else 503)\n@health_bp.route(\"/api/health/checklist\")",
      "new": "    return jsonify(payload), 200\n@health_bp.route(\"/api/health/checklist\")",
      "direction": "regression",
      "catcher": "tests/test_v3_62_2_guards.py::test_locked_master_password_vault_is_a_named_structured_503"
    },
    {
      "label": "M4 healthy health incorrectly returns 503",
      "file": "bulk_downloader/app_health.py",
      "old": "    return jsonify(payload), (200 if payload[\"ok\"] else 503)\n@health_bp.route(\"/api/health/checklist\")",
