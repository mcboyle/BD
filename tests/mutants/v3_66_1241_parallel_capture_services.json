      "file": "scripts/lib/capture_instance.sh",
      "old": "  if ! bd_capture_port_is_free \"$app_port\" || \\\n     ! bd_capture_port_is_free \"$fixture_port\"; then",
      "new": "  if false; then",
      "direction": "regression",
      "catcher": "tests/test_parallel_capture_services.py::test_an_occupied_port_and_a_same_port_pair_fail_for_distinct_reasons"
    },
    {
      "label": "M4 an explicit app and fixture pair is no longer required to be distinct",
      "file": "scripts/lib/capture_instance.sh",
