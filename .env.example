# BulkDownloader — Claude Code cloud environment variables.
#
# Paste the uncommented lines into the "Environment variables" panel.
#
# THESE ARE VISIBLE TO ANYONE USING THE ENVIRONMENT. Nothing secret goes here:
# no API keys, no site credentials, no cookies, no MOD3_PG_DSN. BD reads real
# credentials from the OS keychain or BD_HOME at runtime, never from here.

# --- runtime state must live OUTSIDE the repo ---------------------------------
# Writing runtime state into the deployed code tree is a bug this project has
# already shipped and fixed once (v3.66.805, plugin quarantine state). Keeping
# BD_HOME on /tmp means a stray write cannot dirty the working tree.
BD_HOME=/tmp/bd_home

# Background keepalive threads are pointless in a short-lived session and make
# pytest hang at teardown.
BD_DISABLE_KEEPALIVE=1

# --- python hygiene -----------------------------------------------------------
# No __pycache__ churn in git status; unbuffered output so a killed run still
# shows what it had reached.
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PIP_DISABLE_PIP_VERSION_CHECK=1

# --- interpreter parity (no variable to set; documented here on purpose) -------
# scripts/cloud-setup.sh builds ./venv on Python 3.12 (command -v python3.12),
# NOT the sandbox default python3 (3.11), so the sandbox interpreter MATCHES the
# box/CI. This is load-bearing: regenerating graph/parity/index artifacts under
# 3.11 silently diverges from the 3.12 box -- AST tools swallow per-file
# SyntaxErrors, so a file 3.11 cannot parse leaves their denominators without a
# word. That caused the v3.66.807 box-only failures. The file carrying the
# 3.12-only f-string was retired at v3.66.824 and no tracked file currently
# parses on 3.12 but not 3.11; the rule stands anyway, because the next
# 3.12-only syntax reopens it silently. With the venv on 3.12 there is no separate
# "3.12 venv" to remember: ./venv/bin/python IS the box interpreter. Run bands,
# parity regen, and the release build with ./venv/bin/python.

# --- node ---------------------------------------------------------------------
# DO NOT SET NODE_ENV=production.
# Verified empirically: `NODE_ENV=production npm ci` omits devDependencies,
# which removes vite, typescript and vitest, and the frontend build then fails
# with an error that does not mention the cause. The sample config in the
# environment dialog suggests NODE_ENV=production — do not copy that line.
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false

# --- playwright browsers (~150 MB) --------------------------------------------
# 1 = SKIP the download. Note the polarity: this is a SKIP flag, not an INSTALL
# flag. It replaces BD_INSTALL_BROWSERS=0, which was dead config -- no code read
# that name, so the panel had been requesting "do not install" in a language
# nothing spoke and the browsers were reinstalled every session.
#
# Skipping is correct wherever the browsers are preinstalled
# (PLAYWRIGHT_BROWSERS_PATH set and populated -- true in the Claude cloud
# container, /opt/pw-browsers). The setup script probes for that pool and
# records an accurate row either way, so an unrunnable suite is never mistaken
# for a passing one. Leave unset on a host that has no preinstalled pool.
BD_SKIP_BROWSERS=1

# --- MOD-1 Arch B (remote_vnc / KasmVNC takeover) -----------------------------
# The setup script provisions the KasmVNC display stack by default (see
# scripts/cloud-setup.sh, the ARCHB group). In this Claude sandbox the KasmVNC
# github .deb was once repo-scope blocked (403) -- but the env report of record
# shows `kasmvnc | OK`, so that rationale is stale; the step now succeeds here.
# Keep the skip if you do not need remote_vnc, not because it cannot install --
# set BD_SKIP_ARCHB=1 to skip it cleanly and use the offline pack (pack_kasm) for
# in-sandbox testing. On stash the setup script installs it normally (leave unset).
BD_SKIP_ARCHB=1

# --- git authorship -----------------------------------------------------------
# DELIBERATELY EMPTY. Do not set GIT_AUTHOR_NAME / GIT_COMMITTER_NAME here.
#
# scripts/cloud-setup.sh sets `Claude <noreply@anthropic.com>` so that
# in-session commits satisfy the verified-commit hook. Environment variables
# OUTRANK `git config`, so setting a name here produces a mismatched identity --
# a human name on the automation's email -- on every commit made in the session.
# Observed on real commits in this repository before it was removed.
#
# Do not "fix" it by adding GIT_AUTHOR_EMAIL either: changing the email away
# from noreply@anthropic.com is what the verified-commit hook actually checks.
