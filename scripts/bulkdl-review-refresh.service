[Unit]
Description=BulkDownloader: refresh review candidates from captures (consensus merge, stage-only)
Documentation=file:/home/mboyle/BulkDownloader/tools/bulk_review_captures.py
After=network.target

[Service]
Type=oneshot
User=mboyle
WorkingDirectory=/home/mboyle/BulkDownloader
Environment=PYTHONPATH=/home/mboyle/BulkDownloader
# Stage-only by design: writes templates/review_candidates/*.candidate.json.
# normalize_draft never emits status="enabled" -- this NEVER enables a template,
# never persists secrets/cookies/tokens, never bypasses a challenge.
ExecStart=/home/mboyle/BulkDownloader/venv/bin/python tools/bulk_review_captures.py --merge-host --write
Nice=10
IOSchedulingClass=idle
# keep it from wedging a box if a capture tree is huge
TimeoutStartSec=900
