#!/usr/bin/env python3
"""bd-fuzz-import -- fuzz import/parse endpoints with malformed + hostile input.

Hammers the app's real parse/validation entrypoints with adversarial payloads
(truncated/oversized JSON, wrong types, deeply nested, huge ints, NaN/Infinity,
unicode, control chars, __proto__/dunder keys, negative/overflow api_versions)
and asserts they FAIL GRACEFULLY -- return a clean (ok=False) or raise a caught
exception, never an uncaught crash / hang / traversal. A payload that crashes
the parser -> BD-IMPORT-CRASH (high). Targets:
  - plugins.api_compatible(manifest_dict)  (version-range validator)
  - plugins._read_manifest_ast(text)       (JS/py manifest text parser)
  - json.loads round-trip on config-shaped input
Read-only (in-memory).

Usage: bd-fuzz-import [--work DIR] [--json] [--selftest]
Exit 1 if any target crashes on a payload; 2 (CANNOT-EVALUATE) if plugins.py
could not be loaded (the named targets were never fuzzed, so "handled
gracefully" would be a verdict over the wrong corpus); else 0.
"""
import argparse
import importlib.util
import json
import os
import sys
import types

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

# Manifest dicts (for api_compatible): each must be handled, never crash.
MANIFEST_PAYLOADS = [
    {}, {"api_version": None}, {"api_version": "two"}, {"api_version": -1},
    {"api_version": 10 ** 100}, {"api_version": [1, 2]}, {"api_version": {"x": 1}},
    {"min_api": "a", "max_api": "b"}, {"min_api": 9, "max_api": 1},
    {"min_api": float("nan")}, {"api_version": True},
    {"api_version": 2, "__proto__": {"polluted": 1}},
    {"api_version": 2 ** 63}, {"api_version": -(2 ** 63)},
]

# Manifest text (for _read_manifest_ast): malformed source.
TEXT_PAYLOADS = [
    "", "   ", "not json at all", "{", "}{", "[1,2,",
    '{"a": ' + "1" * 5000 + "}", "\x00\x01\x02", "PLUGIN = ",
    "PLUGIN = {'api_version': __import__('os')}", "\ufeff{}",
    "PLUGIN = {" + "'k':" * 200 + "1" + "}" * 200,
]

# JSON blobs (config parse robustness)
JSON_PAYLOADS = [
    "{}", "[]", "null", "123", '"str"', "{bad}", '{"a":}', '{"a": NaN}',
    '{"a": Infinity}', '{"nested":' + '[' * 500 + ']' * 500 + "}",
    '{"__proto__": 1}', '{"a": 1e999}', "\ufeff{}",
]


def load_plugins(work):
    p = os.path.join(work, "bulk_downloader", "plugins.py")
    if not os.path.exists(p):
        return None, "plugins.py not found"
    try:
        pkg = types.ModuleType("bulk_downloader")
        pkg.__path__ = [os.path.join(work, "bulk_downloader")]
        sys.modules.setdefault("bulk_downloader", pkg)
        if work not in sys.path:
            sys.path.insert(0, work)
        spec = importlib.util.spec_from_file_location("bulk_downloader.plugins", p)
        mod = importlib.util.module_from_spec(spec)
        sys.modules["bulk_downloader.plugins"] = mod
        spec.loader.exec_module(mod)
        return mod, None
    except Exception as e:
        return None, f"import failed: {e}"


def fuzz(work):
    mod, err = load_plugins(work)
    crashes, tested = [], 0
    # 1. api_compatible must return a (bool, str) tuple, never raise uncaught
    if mod and hasattr(mod, "api_compatible"):
        for pl in MANIFEST_PAYLOADS:
            tested += 1
            try:
                r = mod.api_compatible(pl)
                if not (isinstance(r, tuple) and len(r) == 2 and isinstance(r[0], bool)):
                    crashes.append({"target": "api_compatible", "payload": repr(pl)[:60],
                                    "reason": f"bad return shape: {r!r}"})
            except Exception as e:
                crashes.append({"target": "api_compatible", "payload": repr(pl)[:60],
                                "reason": f"uncaught {type(e).__name__}: {e}"})
    # 2. _read_manifest_ast must return a dict or raise-cleanly (caught here);
    #    an uncaught crash on malformed text is the finding.
    if mod and hasattr(mod, "_read_manifest_ast"):
        for txt in TEXT_PAYLOADS:
            tested += 1
            try:
                mod._read_manifest_ast(txt)
            except Exception as e:
                # a controlled exception is acceptable IF it's not a security
                # class (import execution, recursion blowup surfaced as crash)
                if isinstance(e, (RecursionError, MemoryError)):
                    crashes.append({"target": "_read_manifest_ast",
                                    "payload": txt[:40], "reason": type(e).__name__})
    # 3. json.loads robustness (the parser used across config import)
    for blob in JSON_PAYLOADS:
        tested += 1
        try:
            json.loads(blob)
        except (json.JSONDecodeError, ValueError, RecursionError):
            pass  # expected; malformed input rejected cleanly
        except Exception as e:
            crashes.append({"target": "json.loads", "payload": blob[:40],
                            "reason": f"unexpected {type(e).__name__}: {e}"})
    return {"error": err, "crashes": crashes, "tested": tested,
            "plugins_loaded": mod is not None}


def selftest():
    ok = True
    res = fuzz(sec.DEFAULT_WORK)
    loaded = res["plugins_loaded"]
    print(("PASS" if loaded else "WARN") +
          f"  plugins.py loads ({res['tested']} payloads fuzzed, err={res['error']})")
    no_crash = res["crashes"] == []
    print(("PASS" if no_crash else "FAIL") +
          f"  no target crashes on hostile input ({len(res['crashes'])} crash: "
          f"{[c['target'] for c in res['crashes'][:3]]})")
    ok &= no_crash
    # harness sanity: the crash detector actually fires on a known-bad callable
    def boom(_):
        raise RuntimeError("boom")
    caught = False
    try:
        boom({})
    except Exception:  # why: operation failed; degrade to the default and continue -- correctness unaffected, only completeness
        caught = True
    print(("PASS" if caught else "FAIL") + "  harness sanity: exceptions are observable")
    ok &= caught
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    res = fuzz(a.work)
    if not res["plugins_loaded"] and not res["crashes"]:
        # The named targets (api_compatible, _read_manifest_ast) never ran;
        # only the generic json.loads battery did. A green verdict here would
        # certify a corpus that excludes its subject (CLAUDE.md s0).
        sec.emit({"crashes": res["crashes"], "summary": {
            "tested": res["tested"], "crashes": 0,
            "plugins_loaded": False, "error": res["error"]}}, as_json=a.json)
        print(f"{Y}BD-UNEVALUABLE{RST}: plugins.py not loadable ({res['error']}) -- "
              f"the import/parse targets were never fuzzed.", file=sys.stderr)
        return sec.EXIT_CANNOT_EVALUATE
    if sec.emit({"crashes": res["crashes"], "summary": {
            "tested": res["tested"], "crashes": len(res["crashes"]),
            "plugins_loaded": res["plugins_loaded"]}}, as_json=a.json):
        return 1 if res["crashes"] else 0
    if not res["crashes"]:
        print(f"{G}all {res['tested']} import/parse payloads handled gracefully{RST}")
        return 0
    for c in res["crashes"]:
        print(f"  {R}BD-IMPORT-CRASH{RST} {c['target']}: {c['reason']}  {DIM}{c['payload']}{RST}")
    print(f"{R}{len(res['crashes'])} crash(es) of {res['tested']} payloads{RST}")
    return 1


sys.exit(main())
