#!/usr/bin/env python3
"""bd-contract-rules -- nothing leaves the contract corpus without being declared.

WHY, 2026-08-15 at v3.66.1140. CLAUDE.md is ~48k tokens and grows monotonically:
every cut appends a lesson and nothing is ever removed. Measured, it is 2,349
lines of which 447 are rule-bearing and 1,502 are narrative -- worked examples
that persuade a reader the rule is real. That narrative earns its place ONCE per
reader and is paid on EVERY request, in every session and every subagent.

Reducing it is worth doing and dangerous to do, because the failure is silent: a
deleted RULE looks exactly like a deleted RETELLING in a diff, and nothing in
this repo reads the contract for meaning. bd-freshcheck resolves cited PATHS;
bd-doc-truth resolves file-path claims. Neither can ask whether a sentence still
SAYS what it said -- bd-freshcheck prints that limit itself on every run.

WHAT THIS FREEZES, AND WHY IT IS PARAGRAPHS RATHER THAN RULES. Three predicates
for "which lines are rules" were built and measured before this design, and all
three failed in the same direction:

  * normative markers, line-scoped: 229 units, mostly NARRATIVE FRAGMENTS,
    because hard-wrapped prose puts "never" in the middle of a story. A baseline
    full of narrative fires on exactly the extraction it exists to permit --
    CLAUDE.md section 0's cry-wolf failure, which is a soundness bug and not a
    safe default.
  * the same predicate spelled `MUST|NEVER|...|must|never|...`: blind to
    "Never", the ordinary capitalised sentence opening this contract uses
    constantly. Its own selftest caught it.
  * bold spans: the non-greedy regex paired the CLOSING `**` of one span with
    the OPENING `**` of the next, yielding 321 "spans" beginning with `(` and
    `,`.

The lesson is that a rule is rule-BY-VIRTUE-OF-WHAT-IT-ASSERTS, which its syntax
does not record -- the same finding v3.66.1072 reached when it tried to replace
the BD_GATE_SCOPE marker with a derived predicate and got 3 of 8.

So this does not try. It freezes PARAGRAPHS, which are objective (blank-line
separated, fences kept whole) and are exactly the unit an extraction MOVES. The
question it answers is conservation, not meaning: did any paragraph leave the
corpus without someone saying so? A paragraph moved to the casebook passes. A
paragraph deleted or rewritten must be declared, with the survivor named.

That makes the dedupe pass honest rather than clever: every collapse is a line
in a file a test reads. CLAUDE.md section 1 -- a deferral that lives only in
prose has not been deferred, it has been dropped.

WHITESPACE IS NORMALISED BEFORE ANY COMPARISON, and that is load-bearing rather
than tidy. Section 1 records this being hit three times in one session: a grep
for 'Four frames' returns nothing for a document containing "Four\\nframes", so
the checker concludes UNRECORDED for text sitting in the file. An extraction
pass RE-WRAPS prose by construction.
"""

from __future__ import annotations

import argparse
import hashlib
import pathlib
import re
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent.parent
DEFAULT_BASELINE = REPO / "project-knowledge" / "CONTRACT_RULES.baseline"
SOURCE = "CLAUDE.md"
# The corpus a paragraph may legitimately live in. Extraction MOVES text between
# these, so the check must look across all of them or a move reads as a loss.
CORPUS = ("CLAUDE.md", "project-knowledge/CONTRACT_CASEBOOK.md")

MIN_LEN = 20
EXCERPT = 96

BLIND_SPOTS = (
    "this asserts conservation of TEXT, never of MEANING. A paragraph that "
    "survives verbatim but is INVERTED by the sentence now next to it passes.",
    "a paragraph SPLIT between the two files fails until declared. That is "
    "deliberate -- a split is where a rule most easily goes missing -- but it "
    "means a heavy rewrite produces many declarations, and each one is a claim "
    "a human still has to check.",
    "the baseline is only as good as the moment it was frozen. Regenerating it "
    "to clear a failure ADOPTS the loss as the new truth, which is the shape "
    "bd-mutate hits when a battery starts on a dirty tree.",
    "nothing here checks that a DECLARED removal's stated reason is honest.",
)


def normalise(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def fingerprint(s: str) -> str:
    return hashlib.sha256(normalise(s).lower().encode()).hexdigest()[:12]


def paragraphs(text: str) -> list[str]:
    """Blank-line separated units, with fenced blocks kept whole.

    A fence is never split on its internal blank lines -- a command block is one
    unit or it is nothing.
    """
    out: list[str] = []
    cur: list[str] = []
    fence = False
    for line in text.split("\n"):
        if line.lstrip().startswith("```"):
            fence = not fence
            cur.append(line)
            continue
        if not line.strip() and not fence:
            if cur:
                out.append("\n".join(cur))
                cur = []
        else:
            cur.append(line)
    if cur:
        out.append("\n".join(cur))
    return [p for p in out if len(normalise(p)) >= MIN_LEN]


def load_baseline(path: pathlib.Path):
    active: dict[str, str] = {}
    removed: dict[str, str] = {}
    if not path.is_file():
        return active, removed
    target = active
    for raw in path.read_text(encoding="utf-8").split("\n"):
        line = raw.rstrip()
        if line.startswith("## DECLARED REMOVALS"):
            target = removed
            continue
        if not line or line.startswith("#"):
            continue
        fp, _, rest = line.partition("  ")
        if len(fp) == 12 and re.fullmatch(r"[0-9a-f]{12}", fp):
            target[fp] = rest.strip()
    return active, removed


def corpus_state(root: pathlib.Path):
    """Return (set of paragraph fingerprints, normalised corpus text, files)."""
    fps: set[str] = set()
    parts: list[str] = []
    present: list[str] = []
    for rel in CORPUS:
        p = root / rel
        if not p.is_file():
            continue
        body = p.read_text(encoding="utf-8")
        present.append(rel)
        parts.append(body)
        for para in paragraphs(body):
            fps.add(fingerprint(para))
    return fps, normalise("\n".join(parts)).lower(), present


def cmd_extract(args) -> int:
    root = pathlib.Path(args.root)
    src = root / SOURCE
    if not src.is_file():
        print(f"bd-contract-rules: REFUSED: no {src}", file=sys.stderr)
        return 2
    paras = paragraphs(src.read_text(encoding="utf-8"))
    if not paras:
        print(f"bd-contract-rules: REFUSED: extracted ZERO paragraphs from "
              f"{src} -- an empty baseline certifies everything",
              file=sys.stderr)
        return 2
    out = pathlib.Path(args.baseline)
    rows = []
    seen = set()
    for p in paras:
        fp = fingerprint(p)
        if fp in seen:
            continue
        seen.add(fp)
        rows.append(f"{fp}  {normalise(p)[:EXCERPT]}")
    header = [
        "# CONTRACT_RULES.baseline -- paragraph conservation for the contract corpus.",
        "#",
        f"# Generated by `bd-contract-rules --extract` from {SOURCE}. Each row is a",
        "# normalised, lowercased sha256 prefix of ONE paragraph, plus an excerpt for",
        "# a human. The gate asserts every ACTIVE row is still a paragraph somewhere in",
        f"# the corpus ({', '.join(CORPUS)}), so MOVING a paragraph passes and",
        "# deleting or rewriting one FAILS until it is declared below.",
        "#",
        "# IT MAY ONLY SHRINK BY DECLARATION. Move a row under DECLARED REMOVALS and",
        "# put the reason on the same line -- for a dedupe, name the paragraph that",
        "# survives. DO NOT regenerate this file to clear a failure: regenerating is",
        "# how a lost rule becomes the new baseline, which is the shape bd-mutate hits",
        "# when a battery starts on a dirty tree and adopts the mutant as pristine.",
        "#",
        f"# paragraphs: {len(rows)}",
        "",
    ]
    out.write_text("\n".join(header + rows + ["", "## DECLARED REMOVALS", ""]) + "\n",
                   encoding="utf-8")
    print(f"froze {len(rows)} paragraph(s) from {src.name} -> {out}")
    return 0


def cmd_check(args) -> int:
    root = pathlib.Path(args.root)
    baseline = pathlib.Path(args.baseline)
    active, removed = load_baseline(baseline)
    if not active:
        # A gate with no denominator reports clean, truthfully and uselessly.
        print("bd-contract-rules: REFUSED: baseline is missing or has no active "
              f"rows ({baseline})", file=sys.stderr)
        return 2

    fps, text, present = corpus_state(root)
    if not present:
        print(f"bd-contract-rules: REFUSED: none of {CORPUS} could be read "
              f"under {root}", file=sys.stderr)
        return 2

    missing = []
    for fp, excerpt in active.items():
        if fp in fps:
            continue
        # Second chance: the paragraph may have been re-wrapped or absorbed into
        # a longer one. Containment of its normalised excerpt is enough to call
        # it present -- an extraction pass reflows by construction, and firing
        # on that would be a gate crying wolf.
        probe = normalise(excerpt).lower()
        if probe and probe in text:
            continue
        missing.append((fp, excerpt))

    print(f"corpus    : {', '.join(present)}")
    print(f"baseline  : {len(active)} active, {len(removed)} declared removal(s)")
    print(f"corpus has: {len(fps)} paragraph(s)")
    print(f"missing   : {len(missing)}")
    for fp, excerpt in missing[:args.show]:
        print(f"  LOST {fp}  {excerpt[:110]}")
    if len(missing) > args.show:
        print(f"  ... and {len(missing) - args.show} more")

    print("\n=== WHAT THIS GATE CANNOT SEE ===")
    for i, s in enumerate(BLIND_SPOTS, 1):
        print(f"  {i}. {s}")

    if missing:
        print(f"\nVERDICT: FAIL -- {len(missing)} frozen paragraph(s) left the "
              "corpus undeclared. Restore them, or move their rows under "
              "DECLARED REMOVALS naming what survives.")
        return 1
    print("\nVERDICT: OK -- every frozen paragraph is still in the corpus.")
    return 0


def selftest(_args) -> int:
    import tempfile
    fails = []

    def check(ok, msg):
        print(("  ok   " if ok else "  FAIL ") + msg)
        if not ok:
            fails.append(msg)

    import io
    import contextlib

    def quiet(fn, *a):
        with contextlib.redirect_stdout(io.StringIO()):
            return fn(*a)

    with tempfile.TemporaryDirectory() as td:
        root = pathlib.Path(td)
        (root / "project-knowledge").mkdir()
        contract = root / SOURCE
        casebook = root / "project-knowledge" / "CONTRACT_CASEBOOK.md"
        base = root / "project-knowledge" / "CONTRACT_RULES.baseline"
        ns = argparse.Namespace(root=str(root), baseline=str(base), show=5)

        ORIG = (
            "# Contract\n\n"
            "You MUST band every test touching the changed module, because the\n"
            "blast radius follows the denominator and not the diff.\n\n"
            "Never run the whole tests directory without an explicit timeout.\n\n"
            "```bash\nvenv/bin/python toolchain/bin/bd-band-derive --file x.py\n```\n\n"
            "A long narrative about the time this went wrong on four hosts and\n"
            "cost a whole session of chasing the wrong subject entirely.\n"
        )
        contract.write_text(ORIG)

        check(quiet(cmd_extract, ns) == 0, "extract writes a baseline")
        active, _ = load_baseline(base)
        check(len(active) == 4,
              f"freezes each paragraph once, fences whole (got {len(active)})")
        check(quiet(cmd_check, ns) == 0, "a freshly frozen corpus verifies clean")

        # THE MOVE -- the whole point. Narrative goes to the casebook.
        contract.write_text(ORIG.replace(
            "A long narrative about the time this went wrong on four hosts and\n"
            "cost a whole session of chasing the wrong subject entirely.\n", ""))
        casebook.write_text(
            "# Casebook\n\nA long narrative about the time this went wrong on "
            "four hosts and cost a whole session of chasing the wrong subject "
            "entirely.\n")
        check(quiet(cmd_check, ns) == 0,
              "a paragraph MOVED to the casebook passes -- extraction is not loss")

        # THE RED CASE -- a deletion from the whole corpus.
        casebook.write_text("# Casebook\n\nnothing here now\n")
        check(quiet(cmd_check, ns) == 1,
              "a paragraph deleted from the CORPUS fails the gate")

        # A DECLARED removal passes.
        body = base.read_text().split("\n")
        lost_fp = fingerprint(
            "A long narrative about the time this went wrong on four hosts and "
            "cost a whole session of chasing the wrong subject entirely.")
        kept = [l for l in body if not l.startswith(lost_fp)]
        idx = kept.index("## DECLARED REMOVALS")
        kept.insert(idx + 1, f"{lost_fp}  dropped: retelling, rule survives above")
        base.write_text("\n".join(kept))
        check(quiet(cmd_check, ns) == 0,
              "a DECLARED removal passes, and the declaration is machine-visible")

        # OVER-SENSITIVITY: reflowing must NOT fire. An extraction re-wraps by
        # construction; a gate that fails correct work gets switched off.
        contract.write_text(
            "# Contract\n\n"
            "You MUST band every test touching the changed module,\nbecause\n"
            "the blast radius follows the denominator\nand not the diff.\n\n"
            "Never run the whole tests directory\nwithout an explicit timeout.\n\n"
            "```bash\nvenv/bin/python toolchain/bin/bd-band-derive --file x.py\n```\n")
        check(quiet(cmd_check, ns) == 0,
              "a REFLOWED paragraph still passes -- rewrapping is not deletion")

        # Fails closed rather than certifying everything.
        empty = root / "empty.baseline"
        empty.write_text("# nothing active\n")
        check(quiet(cmd_check, argparse.Namespace(
            root=str(root), baseline=str(empty), show=5)) == 2,
            "an empty baseline REFUSES rather than reporting clean")
        check(quiet(cmd_check, argparse.Namespace(
            root=str(root / "nowhere"), baseline=str(base), show=5)) == 2,
            "an unreadable corpus REFUSES rather than reporting everything lost")

    if fails:
        print(f"\nSELFTEST FAIL: {len(fails)} check(s) failed")
        for f in fails:
            print(f"  - {f}")
        return 1
    print("\nSELFTEST PASS")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--root", default=str(REPO))
    ap.add_argument("--baseline", default=str(DEFAULT_BASELINE))
    ap.add_argument("--show", type=int, default=20)
    ap.add_argument("--extract", action="store_true",
                    help="freeze the baseline -- an explicit operator decision")
    ap.add_argument("--selftest", action="store_true")
    args = ap.parse_args()
    if args.selftest:
        return selftest(args)
    if args.extract:
        return cmd_extract(args)
    return cmd_check(args)


if __name__ == "__main__":
    sys.exit(main())
