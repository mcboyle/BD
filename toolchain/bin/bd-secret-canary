#!/usr/bin/env python3
"""bd-secret-canary -- plant fake secrets and verify the REAL scrubber catches them.

Negative-control test for the actual redaction path: takes bd-secret-fixture's
corpus, embeds each value in JSON/log/URL contexts, runs it through the app's
real scrubber (tools/capture_scrub.scrub_string / scrub_url), and asserts the
FAKE sentinel value does NOT survive. Any survivor -> BD-CANARY-LEAK (the
scrubber missed a secret shape). This is the test that would have failed if the
scrubber regressed. Read-only (in-memory; touches nothing).

Usage: bd-secret-canary [--work DIR] [--mode template] [--json] [--selftest]
Exit 1 if any canary leaks, else 0.
"""
import argparse
import importlib.util
import json
import os
import sys
import types

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

# reuse the fixture generator (extensionless file -> explicit loader; a bare
# spec_from_file_location returns a loaderless spec for no-extension paths)
import importlib.machinery
_fix_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-secret-fixture")
_loader = importlib.machinery.SourceFileLoader("bd_secret_fixture", _fix_path)
_fix_spec = importlib.util.spec_from_loader("bd_secret_fixture", _loader)
_fix = importlib.util.module_from_spec(_fix_spec)
_loader.exec_module(_fix)

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"
SENTINEL = _fix.SENTINEL


def load_scrubber(work):
    p = os.path.join(work, "tools", "capture_scrub.py")
    if not os.path.exists(p):
        return None, "tools/capture_scrub.py not found"
    try:
        spec = importlib.util.spec_from_file_location("capture_scrub", p)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod, None
    except Exception as e:
        return None, f"import failed: {e}"


def run(work, mode):
    scrub, err = load_scrubber(work)
    if not scrub:
        return {"error": err, "leaks": [], "tested": 0}
    corpus = _fix.corpus(3, _fix.ALL_KINDS)
    leaks = []
    tested = 0
    for entry in corpus:
        val, kind = entry["value"], entry["kind"]
        # embed in a few realistic contexts
        contexts = {
            "string": val,
            "json": json.dumps({"field": val, "note": "x"}),
            "log": f"[INFO] processing {val} done",
        }
        if kind == "signed_url":
            contexts["url"] = val
        for ctx_name, text in contexts.items():
            tested += 1
            try:
                if ctx_name == "url":
                    out = scrub.scrub_url(text, mode, 24)
                else:
                    out = scrub.scrub_string(text, mode, 24)
            except Exception as e:
                leaks.append({"kind": kind, "ctx": ctx_name,
                              "reason": f"scrub raised: {e}", "sample": text[:60]})
                continue
            # the FAKE high-entropy body must not survive verbatim
            body = _secret_body(val, kind)
            if body and body in out:
                leaks.append({"kind": kind, "ctx": ctx_name,
                              "reason": "secret body survived scrub",
                              "sample": out[:80]})
    return {"error": None, "leaks": leaks, "tested": tested, "mode": mode}


def _secret_body(val, kind):
    """The high-entropy portion that must be redacted (not the label/scheme)."""
    if kind in ("cookie", "bd_cookie"):
        return val.split("=", 1)[1].split(";", 1)[0]
    if kind in ("generic", "csrf"):
        return val.split("=", 1)[1]
    if kind == "bearer":
        return val.split(" ", 1)[1]
    if kind == "privkey":
        return val.split("\n")[1]
    if kind == "signed_url":
        return None  # url path checked separately; token/sig are the target
    return val


def selftest():
    ok = True
    res = run(sec.DEFAULT_WORK, "template")
    loaded = res["error"] is None
    print(("PASS" if loaded else "FAIL") +
          f"  real capture_scrub loads + runs ({res['tested']} canaries, err={res['error']})")
    ok &= loaded
    if loaded:
        # the scrubber should catch MOST shapes; report survivors as findings
        leak_kinds = {l["kind"] for l in res["leaks"]}
        print(f"  {DIM}canary result: {len(res['leaks'])} leak(s) across "
              f"{res['tested']} tests; leaking kinds: {sorted(leak_kinds) or 'none'}{RST}")
        # harness sanity: a recognized secret shape (fixture JWT) must be
        # scrubbed AND, if it weren't, our body-survival logic would flag it.
        jwt = _fix.gen("jwt", 0)
        scrub, _ = load_scrubber(sec.DEFAULT_WORK)
        out = scrub.scrub_string(f"auth={jwt}", "template", 24)
        caught = SENTINEL not in out or jwt not in out
        print(("PASS" if caught else "FAIL") +
              f"  harness sanity: a known secret shape is scrubbed ({caught})")
        ok &= bool(caught)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--mode", default="template")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    res = run(a.work, a.mode)
    if sec.emit({"leaks": res["leaks"],
                 "summary": {"tested": res["tested"], "leaks": len(res["leaks"]),
                             "error": res["error"]}}, as_json=a.json):
        return 1 if res["leaks"] else 0
    if res["error"]:
        print(f"{R}scrubber not loadable{RST}: {res['error']}")
        return 1
    if not res["leaks"]:
        print(f"{G}all {res['tested']} canaries scrubbed -- no secret survived{RST}")
        return 0
    for l in res["leaks"]:
        print(f"  {R}BD-CANARY-LEAK{RST} {l['kind']}/{l['ctx']}: {l['reason']}  "
              f"{DIM}{l['sample']}{RST}")
    print(f"{R}{len(res['leaks'])} canary leak(s) of {res['tested']} tests{RST}")
    return 1


sys.exit(main())
