#!/usr/bin/env python3
"""bd-surface-census -- enumerate EVERY operator-facing surface and score reachability.

The parity story has been told against denominators that quietly exclude things:
config_surface_inventory scans ~40% of the config surface; enumerate_surfaces walks
url_map so it cannot see 44 cockpit views; the ratchet counts manifest ROWS so 90
global_config keys hide behind one. This tool refuses to have a denominator it did
not derive.

It runs independent PROBE FAMILIES over the tree. Each probe answers one question
("what env vars are read?", "what config files are written?") from source, then the
census scores each item against what the GUI can actually reach. A DISCREPANCY is
any item that is (a) read/used at runtime but absent from the inventory that claims
to track it, or (b) asserted reachable but is not.

WHEN: when you need the true denominator -- before any parity claim, coverage number,
or "is X exposed" answer.

Read-only. Deterministic. ASCII. --json. --selftest.
"""
import argparse
import ast
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

G, R, Y, DIM, BOLD, RST = ("\033[32m", "\033[31m", "\033[33m",
                           "\033[2m", "\033[1m", "\033[0m")
WORK = sec.DEFAULT_WORK

SKIP_DIRS = {".git", "node_modules", "__pycache__", "venv", ".venv", "dist",
             "build", ".mypy_cache", ".pytest_cache", "htmlcov"}


def walk(root, exts, subdirs=None):
    bases = [os.path.join(root, s) for s in subdirs] if subdirs else [root]
    for base in bases:
        if not os.path.isdir(base):
            continue
        for dp, dn, fns in os.walk(base):
            dn[:] = [d for d in dn if d not in SKIP_DIRS]
            for fn in sorted(fns):
                if fn.endswith(exts):
                    yield os.path.join(dp, fn)


def read(p):
    try:
        return open(p, encoding="utf-8", errors="replace").read()
    except OSError:
        return ""


# ---------------------------------------------------------------- probe: env
ENV_PATTERNS = [
    re.compile(r'os\.environ\.get\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'),
    re.compile(r'os\.getenv\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'),
    re.compile(r'os\.environ\[\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'),
    re.compile(r'environ\.get\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'),
    re.compile(r'getenv\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'),
]
ENV_NONPY = [
    re.compile(r'\$\{?([A-Z][A-Z0-9_]{2,})\}?'),          # shell
    re.compile(r'Environment=([A-Z][A-Z0-9_]+)='),         # systemd
    re.compile(r'import\.meta\.env\.([A-Z_][A-Z0-9_]*)'),  # vite
    re.compile(r'process\.env\.([A-Z_][A-Z0-9_]*)'),       # node
]


def probe_env(work):
    """Every env var READ, from every language.

    Three methods unioned, because no single one is complete:
      1. BD_* string LITERALS anywhere in .py -- env vars are frequently read
         through helper indirection (`_num("BD_AUTH_THROTTLE_MAX", "cfg_key", ...)`),
         which no direct-access regex can see. This is the method
         config_surface_inventory uses, and it is why it finds 81.
      2. Direct-access patterns for ANY name -- catches the non-BD_ vars that
         method 1 structurally cannot (DISPLAY, PLAYWRIGHT_BROWSERS_PATH,
         CLOAKBROWSER_BINARY_PATH, APPDATA, DECOMP_KIT).
      3. Non-.py files -- the env tranche gate scans ONLY .py, so BD_* knobs that
         live in install/deploy shell scripts are invisible to it.
    """
    hits = {}

    def add(k, rel):
        if k and k != "BD_":  # bare "BD_" is the prefix literal in app.py, not a var
            hits.setdefault(k, set()).add(rel)

    for p in walk(work, (".py",), ["bulk_downloader", "tools", "tests"]):
        rel = os.path.relpath(p, work)
        src = read(p)
        for k in re.findall(r'["\'](BD_[A-Z0-9_]+)["\']', src):   # method 1
            add(k, rel)
        for pat in ENV_PATTERNS:                                   # method 2
            for k in pat.findall(src):
                add(k, rel)
    for p in walk(work, (".sh", ".service", ".ts", ".tsx", ".js", ".yml", ".yaml",
                         ".toml", ".cfg", ".ini", ".env", ".example"), None):
        rel = os.path.relpath(p, work)
        if rel.startswith(("frontend/dist", "reports", "node_modules")):
            continue
        src = read(p)
        for k in re.findall(r'\b(BD_[A-Z0-9_]+|VITE_[A-Z0-9_]+|NETNS_[A-Z0-9_]+)\b', src):
            add(k, rel)                                            # method 3
        for pat in ENV_NONPY:
            for k in pat.findall(src):
                if k.startswith(("BD_", "VITE_", "NETNS_", "CLOAK", "PLAYWRIGHT")):
                    add(k, rel)
    return {k: sorted(v) for k, v in hits.items()}


# ------------------------------------------------------- probe: config files
FILE_PATTERNS = [
    re.compile(r'["\']([A-Za-z0-9_\-./]+\.(?:json|yaml|yml|toml|ini|cfg|env))["\']'),
]


def probe_config_files(work):
    hits = {}
    for p in walk(work, (".py",), ["bulk_downloader", "tools"]):
        src = read(p)
        for pat in FILE_PATTERNS:
            for f in pat.findall(src):
                if f.startswith(("http", "//")) or "*" in f:
                    continue
                hits.setdefault(os.path.basename(f), set()).add(
                    os.path.relpath(p, work))
    return {k: sorted(v) for k, v in hits.items()}


# ------------------------------------------------------------- probe: flags
def probe_flags(work):
    """argparse option strings + click + raw sys.argv, across tools AND package."""
    out = {}
    for p in walk(work, (".py",), ["tools", "bulk_downloader"]):
        rel = os.path.relpath(p, work)
        src = read(p)
        flags = set(re.findall(r'add_argument\(\s*["\'](--[a-zA-Z0-9\-_]+)["\']', src))
        flags |= set(re.findall(r'@click\.option\(\s*["\'](--[a-zA-Z0-9\-_]+)["\']', src))
        raw = bool(re.search(r'sys\.argv\[', src)) and not flags
        if flags or raw:
            out[rel] = {"flags": sorted(flags), "raw_argv": raw,
                        "has_main": "__main__" in src}
    return out


# ------------------------------------------------------ probe: python modules
def probe_modules(work):
    out = {}
    for p in walk(work, (".py",), ["tools", "bulk_downloader"]):
        rel = os.path.relpath(p, work)
        src = read(p)
        try:
            tree = ast.parse(src)
        except SyntaxError:
            out[rel] = {"parse_error": True}
            continue
        funcs = [n.name for n in tree.body if isinstance(n, (ast.FunctionDef,
                                                            ast.AsyncFunctionDef))]
        out[rel] = {"entrypoint": "__main__" in src,
                    "public_funcs": len([f for f in funcs if not f.startswith("_")])}
    return out


# ------------------------------------------------------------- probe: tests
def probe_tests(work):
    out = {}
    for p in walk(work, (".py",), ["tests"]):
        rel = os.path.relpath(p, work)
        src = read(p)
        out[rel] = {
            "pins_version": bool(re.search(r'__version__\s*==\s*["\']3\.', src)),
            "pins_count": len(re.findall(r'==\s*\d{2,}\b', src)),
        }
    return out


def census(work=WORK):
    return {
        "env": probe_env(work),
        "config_files": probe_config_files(work),
        "flags": probe_flags(work),
        "modules": probe_modules(work),
        "tests": probe_tests(work),
    }


def selftest():
    ok = True
    import tempfile
    with tempfile.TemporaryDirectory() as td:
        d = os.path.join(td, "bulk_downloader")
        os.makedirs(d)
        open(os.path.join(d, "m.py"), "w").write(
            'import os\n'
            'a=os.environ.get("BD_ONE")\n'
            'b=os.getenv("PLAIN_TWO")\n'
            'c=os.environ["BRACKET_THREE"]\n'
            'p=open("settings.json")\n'
            'import argparse\n'
            'ap=argparse.ArgumentParser()\n'
            'ap.add_argument("--flagged")\n')
        e = probe_env(td)
        p1 = {"BD_ONE", "PLAIN_TWO", "BRACKET_THREE"} <= set(e)
        print(("%sPASS%s" if p1 else "%sFAIL%s") % ((G, RST) if p1 else (R, RST)) +
              "  POS: env probe catches .get / getenv / [] AND non-BD_ names")
        ok &= p1

        f = probe_config_files(td)
        p2 = "settings.json" in f
        print(("%sPASS%s" if p2 else "%sFAIL%s") % ((G, RST) if p2 else (R, RST)) +
              "  POS: config-file probe catches settings.json")
        ok &= p2

        fl = probe_flags(td)
        p3 = any("--flagged" in v["flags"] for v in fl.values())
        print(("%sPASS%s" if p3 else "%sFAIL%s") % ((G, RST) if p3 else (R, RST)) +
              "  POS: flag probe catches --flagged")
        ok &= p3

        # NEG: a URL must not be mistaken for a config file
        open(os.path.join(d, "n.py"), "w").write('u="https://x/y.json"\n')
        f2 = probe_config_files(td)
        n1 = "y.json" not in f2
        print(("%sPASS%s" if n1 else "%sFAIL%s") % ((G, RST) if n1 else (R, RST)) +
              "  NEG: a URL ending .json is not a config file")
        ok &= n1

    c1 = census()
    c2 = census()
    a = json.dumps(c1, sort_keys=True)
    b = json.dumps(c2, sort_keys=True)
    det = a == b
    print(("%sPASS%s" if det else "%sFAIL%s") % ((G, RST) if det else (R, RST)) +
          "  deterministic output")
    ok &= det

    # POS: `a == b` is vacuously true on an EMPTY census -- this used to be the
    # only check run against the real WORK, so a broken default (dead sandbox
    # path -> nothing scanned -> {} == {}) still printed SELFTEST PASS. Assert
    # the real tree actually produced a non-empty census in every probe family.
    nonempty = all(len(c1[k]) > 0 for k in
                   ("env", "config_files", "flags", "modules", "tests"))
    print(("%sPASS%s" if nonempty else "%sFAIL%s") % ((G, RST) if nonempty else (R, RST)) +
          "  POS: real WORK (%s) census is non-empty in every probe (%s)"
          % (WORK, {k: len(c1[k]) for k in c1}))
    ok &= nonempty

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(prog="bd-surface-census")
    ap.add_argument("--work", default=WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--out")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    c = census(a.work)
    if a.out:
        json.dump(c, open(a.out, "w"), indent=2, sort_keys=True)
    if a.json:
        print(json.dumps(c, indent=2, sort_keys=True))
    else:
        print("%s== bd-surface-census ==%s" % (BOLD, RST))
        print("  env vars read      : %d" % len(c["env"]))
        print("  config files       : %d" % len(c["config_files"]))
        print("  modules with flags : %d" % len(c["flags"]))
        print("  total flags        : %d"
              % sum(len(v["flags"]) for v in c["flags"].values()))
        print("  python modules     : %d" % len(c["modules"]))
        print("  test files         : %d" % len(c["tests"]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
