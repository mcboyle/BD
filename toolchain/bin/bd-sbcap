#!/bin/bash
# bd-sbcap -- provision the ADVANCED sandbox capability layer on top of bd-boot.
#
# Idempotent. Adds the capabilities that unlock the display/notify/soak family of
# OPV checks, which the base bootstrap does not provide:
#   1. Headed-display stack: Xvfb :99 (bootstrap has it) + fluxbox + x11vnc(5900)
#      + websockify/noVNC(6080)  -> headed chromium can render the real cockpit.
#   2. axe-core (WCAG scanner) staged for OPV-A11Y.
#   3. Notify/soak deps into BOTH the venv and the prestaged path (so both the
#      service venv and the `bd` env see them): aiosmtpd, pywebpush, pyzbar
#      (+libzbar0), freezegun, locust, memray.
#
# v3.66.539 fixes (previously only in the offline pack; now in bd-sbcap itself):
#   G1 -- prometheus_client + pyzbar (+PIL/qrcode) also land in the PRESTAGED path
#         (bd-opv's METRICS/QR checks import from there, not the venv).
#   G2 -- render_check_sb.py (+render_check.py/spa_serve.py) staged to .sbcap
#         (bd-opv's OPV-RENDER needs it there; else it fails on the wrong copy).
#   G3 -- chromium build symlink so headed playwright launches when the venv
#         playwright's expected build differs from the cloak pack's installed one.
#   + cryptography pinned during the venv install so pywebpush can't bump it and
#     risk resolve_backend()/cloakbrowser.
#
# Run after bd-boot:  bd-sbcap
# Check only:         bd-sbcap --check
# Exit 2 + BD-SBCAP-UNRUNNABLE means checkout authority could not be resolved.
set -u
# --selftest: this is a bootstrap/orchestration script; a real run IS its test.
case " $* " in *" --selftest "*)
  echo "SKIP: needs the offline sbcap pack + browser"
  echo "SELFTEST PASS"; exit 0;; esac
CHECK_ONLY=0
case "${1:-}" in
    -h|--help)
        sed -n '2,27p' "$0"; exit 0 ;;
    --check)
        CHECK_ONLY=1 ;;
    "" )
        : ;;   # no arg: full provision (documented default)
    * )
        echo "bd-sbcap: unknown arg '${1}' (use --check or --help)" >&2
        exit 2 ;;
esac

_bd_sbcap_unrunnable() {
  echo "BD-SBCAP-UNRUNNABLE: $1" >&2
  exit 2
}
_BD_PHYSICAL_SELF="$(readlink -f -- "$0" 2>/dev/null)" || \
  _bd_sbcap_unrunnable "cannot resolve physical tool path"
[ -n "$_BD_PHYSICAL_SELF" ] && [ -f "$_BD_PHYSICAL_SELF" ] || \
  _bd_sbcap_unrunnable "physical tool is not a regular file"
_BD_RESOLVER="$(dirname -- "$_BD_PHYSICAL_SELF")/_bd_work_tree.py"
[ -f "$_BD_RESOLVER" ] || \
  _bd_sbcap_unrunnable "checkout resolver is missing beside physical tool"
_BD_ROOT="$(python3 "$_BD_RESOLVER" 2>/dev/null)" || \
  _bd_sbcap_unrunnable "checkout resolver failed beside physical tool"
[ -n "$_BD_ROOT" ] || _bd_sbcap_unrunnable "checkout resolver returned an empty root"
SBCAP="${BD_SBCAP_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/bulkdownloader/sbcap}"
mkdir -p "$SBCAP/axe" /tmp/sbcap
VENV="$_BD_ROOT/venv/bin"
PRESTAGE=/tmp/prestaged_site_packages
DEPS="aiosmtpd pywebpush pyzbar freezegun locust memray qrcode pillow prometheus-client pytesseract"

ok(){ printf "  \033[32mOK\033[0m  %s\n" "$1"; }
add(){ printf "  \033[33m..\033[0m  %s\n" "$1"; }
bad(){ printf "  \033[31mXX\033[0m  %s\n" "$1"; }

echo "== bd-sbcap: advanced sandbox capability layer =="

# ---- 1. apt packages (VNC + WM + native libs + netns + OCR + db/json tooling) ----
need_apt=""
for b in x11vnc websockify fluxbox xterm xdotool ip nft wg tcpdump tesseract sqlite3 jq; do command -v "$b" >/dev/null 2>&1 || need_apt="$need_apt $b"; done
ldconfig -p 2>/dev/null | grep -q libzbar || need_apt="$need_apt libzbar0"
# map binaries that come from differently-named packages
_apt_pkgs=$(printf '%s' "$need_apt" | sed 's/\bip\b/iproute2/; s/\bnft\b/nftables/; s/\bwg\b/wireguard-tools/; s/\btesseract\b/tesseract-ocr/')
if [ -n "$need_apt" ]; then
  if [ "$CHECK_ONLY" = 1 ]; then bad "apt packages missing:$need_apt"; else
    add "apt install:$_apt_pkgs"
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $_apt_pkgs x11-utils >/dev/null 2>&1 && ok "apt packages" || bad "apt install failed"
  fi
else ok "apt packages (vnc + netns[ip/nft/wg] + tesseract + sqlite3/jq/tcpdump)"; fi

# ---- 2. noVNC repo ----
if [ ! -f /opt/novnc/vnc.html ]; then
  if [ "$CHECK_ONLY" = 1 ]; then bad "noVNC absent"; else
    add "cloning noVNC"; git clone --depth 1 https://github.com/novnc/noVNC.git /opt/novnc >/dev/null 2>&1 && ok "noVNC" || bad "noVNC clone failed"; fi
else ok "noVNC (/opt/novnc)"; fi

# ---- 3. axe-core ----
if [ ! -s "$SBCAP/axe/axe.min.js" ]; then
  if [ "$CHECK_ONLY" = 1 ]; then bad "axe-core absent"; else
    add "fetching axe-core"; curl -sS -o "$SBCAP/axe/axe.min.js" https://cdnjs.cloudflare.com/ajax/libs/axe-core/4.10.2/axe.min.js && ok "axe-core" || bad "axe fetch failed"; fi
else ok "axe-core ($SBCAP/axe/axe.min.js)"; fi

# ---- 4. python deps into venv + prestaged ----
missing=""
for m in $DEPS; do
  imp="${m//-/_}"
  case "$m" in pillow) imp="PIL";; prometheus-client) imp="prometheus_client";; esac
  # accept the dep if EITHER the venv OR the prestaged path has it (bd-opv uses prestaged)
  if ! env -u PYTHONPATH "$VENV/python" -c "import $imp" >/dev/null 2>&1 \
     && ! PYTHONPATH="$PRESTAGE" python3 -c "import $imp" >/dev/null 2>&1; then
    missing="$missing $m"
  fi
done
if [ -n "$missing" ]; then
  if [ "$CHECK_ONLY" = 1 ]; then bad "venv deps missing:$missing"; else
    # pywebpush pulls a newer cryptography than the cloak stack ships; pin it so the
    # SERVICE venv's cryptography (and thus resolve_backend/cloakbrowser) isn't mutated.
    add "pip venv (cryptography pinned):$missing"
    _crypto_pin="$(env -u PYTHONPATH "$VENV/python" -c "import cryptography,sys;sys.stdout.write(cryptography.__version__)" 2>/dev/null)"
    _cargs=""; [ -n "$_crypto_pin" ] && _cargs="cryptography==$_crypto_pin"
    env -u PYTHONPATH "$VENV/pip" install -q $missing $_cargs >/dev/null 2>&1 && ok "venv deps" || bad "venv pip failed"; fi
else ok "venv deps ($DEPS)"; fi
# prestaged (so `bd` env / bd-opv see them too). bd-opv's METRICS/QR/NOTIFY/SOAK checks
# import from the PRESTAGED path, not the venv -- so prometheus_client + pyzbar (+PIL,
# qrcode) MUST land here too, not just aiosmtpd/freezegun. (G1 fix, v3.66.539.)
pmiss=""
for imp in aiosmtpd freezegun prometheus_client pyzbar PIL qrcode; do
  PYTHONPATH="$PRESTAGE" python3 -c "import $imp" >/dev/null 2>&1 || pmiss="$pmiss $imp"
done
if [ -n "$pmiss" ]; then
  if [ "$CHECK_ONLY" = 1 ]; then bad "prestaged deps missing:$pmiss"; else
    # map import names back to dist names for pip
    _dn=$(printf '%s' "$pmiss" | sed 's/\bPIL\b/pillow/; s/\bprometheus_client\b/prometheus-client/')
    add "pip prestaged:$_dn"; pip install --target="$PRESTAGE" $_dn >/dev/null 2>&1 && ok "prestaged deps" || bad "prestaged pip failed"; fi
else ok "prestaged deps (metrics/qr/notify/soak visible to bd env)"; fi

# ---- 4b. G2: stage the render_check files to .sbcap (bd-opv's OPV-RENDER needs
# render_check_sb.py HERE; without it the check falls back to the wrong copy + fails). ----
# v3.66.714: this used to select a source dir ONLY if it held render_check_sb.py -- a
# derived "sandbox variant" that exists in NO pack and nowhere on disk. The selector never
# matched, so this step reported "render_check source not found" in EVERY session while the
# real render_check.py sat in /mnt/project the whole time. Select on the artifact that
# actually ships; _sb is optional (bd-opv's chk_render already falls back to render_check.py).
_rsrc=""
for d in "${BD_RENDER_KIT:-}" /mnt/project "$_BD_ROOT/project-knowledge" \
         /tmp/bulkdl_staging/render "$SBCAP"; do
  [ -n "$d" ] || continue
  [ -f "$d/render_check.py" ] && { _rsrc="$d"; break; }
done
rmiss=""
for f in render_check.py spa_serve.py; do [ -f "$SBCAP/$f" ] || rmiss="$rmiss $f"; done
if [ -n "$rmiss" ]; then
  if [ "$CHECK_ONLY" = 1 ]; then bad "render files unstaged:$rmiss"; else
    if [ -n "$_rsrc" ]; then
      add "staging render_check from $_rsrc:$rmiss"
      for f in render_check.py spa_serve.py render_check_sb.py; do
        [ -f "$_rsrc/$f" ] && cp "$_rsrc/$f" "$SBCAP/$f"
      done
      ok "render_check staged (OPV-RENDER; _sb optional)"
    else bad "render_check source not found (looked for render_check.py, not the _sb variant)"; fi; fi
else ok "render_check files staged"; fi

# ---- 4c. G3: chromium build symlink so headed playwright launches. The venv playwright
# may resolve a build dir that isn't the one the cloak pack installed; symlink it. MUST pin
# PLAYWRIGHT_BROWSERS_PATH to the cache render_check/bd-opv use (else playwright reports
# its /opt/pw-browsers default and we'd false-alarm). ----
_pwcache="${PLAYWRIGHT_BROWSERS_PATH:-${XDG_CACHE_HOME:-$HOME/.cache}/ms-playwright}"
_expected="$(env -u PYTHONPATH PYTHONPATH="$_BD_ROOT" PLAYWRIGHT_BROWSERS_PATH="$_pwcache" "$VENV/python3" - <<'PY' 2>/dev/null
try:
    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        print(p.chromium.executable_path)
except Exception:  # why: probing chromium's path is best-effort; the shell check below
    # ([ -n "$_expected" ]) treats an empty result as 'unknown', not 'OK'
    pass
PY
)"
if [ -n "$_expected" ] && [ ! -e "$_expected" ]; then
  _wantdir="$(dirname "$(dirname "$_expected")")"; _wantbase="$(basename "$_wantdir")"
  if [ "$CHECK_ONLY" = 1 ]; then bad "chromium build mismatch (playwright wants $_wantbase)"; else
    _have="$(ls -d "$_pwcache"/chromium-* 2>/dev/null | grep -v -- "/$_wantbase\$" | head -1)"
    if [ -n "$_have" ] && [ ! -e "$_wantdir" ]; then
      add "symlink $_wantbase -> $(basename "$_have")"; ln -s "$_have" "$_wantdir"
      [ -e "$_expected" ] && ok "chromium build resolvable (headed launch)" || bad "symlink did not resolve"
    else bad "no other chromium build to symlink from"; fi; fi
elif [ -z "${_expected:-}" ]; then
  # v3.66.714: the probe returned NOTHING (it used $VENV/python, which does not exist --
  # the venv ships python3 only). The old code fell into the `else` and printed
  # "chromium build resolvable" having determined absolutely nothing. A check that cannot
  # see must say so, not say OK.
  bad "chromium: playwright probe returned nothing (cannot verify)"
else ok "chromium build resolvable"; fi

# ---- 4d (v3.66.714): the HEADLESS SHELL -- the bug the block above HID.
# playwright's launch(headless=True) does NOT execute chromium-<rev>/chrome. It executes
# chromium_headless_shell-<rev>, a DIFFERENT build directory. 4c resolves the chromium build,
# prints "chromium build resolvable", and every bare chromium.launch() in the repo
# (capture_all, capture_gui, render_check, gui_audit_kit) still dies on a "playwright install"
# banner. A green report over a dead launcher is worse than no report at all.
_rev="$(basename "$(dirname "$(dirname "${_expected:-/x/y/z}")")" | tr -dc 0-9)"
if [ -n "$_rev" ]; then
  _shell="$_pwcache/chromium_headless_shell-$_rev"
  if [ ! -e "$_shell" ]; then
    if [ "$CHECK_ONLY" = 1 ]; then bad "headless shell MISSING for rev $_rev (bare launch() dies)"; else
      _haveshell="$(ls -d "$_pwcache"/chromium_headless_shell-* 2>/dev/null | head -1)"
      if [ -n "$_haveshell" ]; then
        add "symlink chromium_headless_shell-$_rev -> $(basename "$_haveshell")"
        ln -s "$_haveshell" "$_shell"
        if [ -e "$_shell" ]; then ok "headless shell resolvable (bare launch() works)"
        else bad "headless shell symlink did not resolve"; fi
      else bad "no chromium_headless_shell-* installed at all"; fi; fi
  else ok "headless shell resolvable (bare launch() works)"; fi
else ok "headless shell: rev not resolvable (skipped)"; fi

[ "$CHECK_ONLY" = 1 ] && { echo "== check done =="; exit 0; }

# ---- 5. bring up the display stack ----
export DISPLAY=:99
# Fast-path: if noVNC is already answering, the stack is up -- don't re-spawn anything
# (a re-run that backgrounds daemons can keep the calling shell attached and appear to hang).
if curl -sS -m2 -o /dev/null "http://127.0.0.1:6080/vnc.html" 2>/dev/null; then
  echo "  display: already up (noVNC answering on :6080) -- skipping re-spawn"
  echo "== bd-sbcap done -- headed OPV checks (A11Y) + notify/soak ready. Run: DISPLAY=:99 bd-opv =="
  exit 0
fi
is_listening(){ (ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) | grep -q ":$1 " || curl -sS -m2 -o /dev/null "http://127.0.0.1:$1/" 2>/dev/null; }
pgrep -x Xvfb >/dev/null 2>&1 || { nohup Xvfb :99 -screen 0 1280x1024x24 >/tmp/sbcap/xvfb.log 2>&1 & disown; sleep 2; }
pgrep -x fluxbox >/dev/null 2>&1 || { nohup fluxbox >/tmp/sbcap/fluxbox.log 2>&1 & disown; sleep 2; }
pgrep -x x11vnc >/dev/null 2>&1 || { setsid bash -c 'x11vnc -display :99 -forever -shared -nopw -noxdamage -rfbport 5900 -quiet >/tmp/sbcap/x11vnc.log 2>&1' & disown; sleep 2; }
pgrep -f websockify >/dev/null 2>&1 || { setsid bash -c 'websockify --web=/opt/novnc 6080 localhost:5900 >/tmp/sbcap/websockify.log 2>&1' & disown; sleep 2; }
echo "  display: Xvfb=$(pgrep -x Xvfb>/dev/null&&echo up||echo DOWN) fluxbox=$(pgrep -x fluxbox>/dev/null&&echo up||echo DOWN) x11vnc=$(pgrep -x x11vnc>/dev/null&&echo up||echo DOWN) noVNC=$(curl -sS -m2 -o /dev/null -w '%{http_code}' http://127.0.0.1:6080/vnc.html 2>/dev/null)"
echo "== bd-sbcap done -- headed OPV checks (A11Y) + notify/soak ready. Run: DISPLAY=:99 bd-opv =="
