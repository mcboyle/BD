#!/usr/bin/env python3
"""bd-innovation-radar -- track future ideas separately from the backlog.

Scans docs + code comments for forward-looking idea markers (FUTURE:, IDEA:,
SOMEDAY:, "would be nice", "phase N+1", TODO(speculative)) and collects them
into a radar list DISTINCT from the active roadmap/backlog -- so speculation
doesn't pollute the committed plan. Groups by source. Read-only.

Usage: bd-innovation-radar [--work DIR] [--docs DIR] [--json] [--selftest]
Exit 0 radar produced / 2 CANNOT-EVALUATE (guarded work root). Informational.
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
IDEA=re.compile(r'(?i)\b(FUTURE|IDEA|SOMEDAY|would be nice|down the road|stretch goal|nice[- ]to[- ]have)\b\s*[:\-]?\s*(.{0,90})')

def scan(work, docs):
    ideas=[]
    files=glob.glob(os.path.join(docs,"*.md"))
    for _p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        files.append(_p)
    for f in files:
        try: txt=open(f,errors="ignore").read()
        # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
        except Exception: continue
        for i,line in enumerate(txt.split(chr(10)),1):
            m=IDEA.search(line)
            if m: ideas.append({"source":os.path.basename(f),"line":i,"marker":m.group(1),"idea":m.group(2).strip()[:80]})
    return ideas

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        open(os.path.join(d,"a.md"),"w").write("- FUTURE: add a graphql API someday\n- normal committed task\n")
        # A well-shaped work root: iter_py(strict=True) refuses a tree with no
        # bulk_downloader/, and it is RIGHT to -- the old fixture was never a
        # tree, so this selftest was scanning nothing on the code side.
        os.makedirs(os.path.join(d,"bulk_downloader"),exist_ok=True)
        open(os.path.join(d,"bulk_downloader","m.py"),"w").write("# FUTURE: someday rewrite this in rust\ndef f():\n    return 1\n")
        i=scan(d,d)
    print(("PASS" if any("graphql" in x["idea"] for x in i) else "FAIL")+"  FUTURE idea captured (%d)"%len(i))
    ok=ok and any("graphql" in x["idea"] for x in i)
    committed=any("normal committed" in x["idea"] for x in i)
    print(("PASS" if not committed else "FAIL")+"  committed task NOT captured as speculation")
    ok=ok and not committed
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--docs",default="/mnt/project")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    ideas=scan(a.work,a.docs)
    if sec.emit({"ideas":ideas,"summary":{"count":len(ideas)}},as_json=a.json): return 0
    print("%d speculative idea(s) on the radar (kept OFF the active backlog):"%len(ideas))
    for x in ideas[:40]: print("  %s%s%s %s:%d  %s"%(DIM,x["marker"],RST,x["source"],x["line"],x["idea"]))
    return 0

if __name__ == "__main__":
    sys.exit(main())
