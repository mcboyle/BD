#!/usr/bin/env python3
"""bd-proof-ledger -- machine-readable release proof record.

Assembles a single JSON proof object for a release from the authoritative
sources: STATE.json (version, zip sha256 + file_count, 7 guard shas,
validation line, parity), plus a timestamp and optional operator note. This is
the canonical structured artifact that bd-evidence-chain hashes and
bd-release-attestation bundles. Read-only.

Usage: bd-proof-ledger [--home DIR] [--note TEXT] [--json] [--selftest]
Exit 0 ledger built (informational record) / 2 CANNOT-EVALUATE (no
STATE-derivable release in the bundle).
"""
import argparse
import hashlib
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def build(home, note):
    st = sec.load_state(home)
    if st is None:
        return {"error": "no STATE.json (version pack not attached?)"}
    zipinfo = st.get("zip", {})
    if not isinstance(zipinfo, dict):
        zipinfo = {"name": str(zipinfo)}
    guards = sec.state_guard_shas(st)
    ledger = {
        "schema": "bd-proof-ledger/1",
        "version": st.get("built_version") or st.get("live_version"),
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "zip": {"name": zipinfo.get("name") or zipinfo.get("file"),
                "sha256": zipinfo.get("sha256"),
                "file_count": zipinfo.get("file_count")},
        "guards": {"count": len(guards),
                   "guards_full_sha256": guards},
        "validation": st.get("validation"),
        "parity": st.get("parity"),
        "deploy_status": st.get("deploy_status"),
        "operator_note": note or None,
    }
    # a self-hash over the canonical content (tamper-evidence seed)
    # Content-addressed means CONTENT: generated_at is volatile and hashing it
    # made self_sha256 change every second -- an attestation of "when", not
    # "what". Exclude volatile fields; the timestamp stays in the ledger,
    # it just does not participate in the fingerprint.
    body = {k: v for k, v in ledger.items()
            if k not in ("self_sha256", "generated_at")}
    ledger["self_sha256"] = hashlib.sha256(
        json.dumps(body, sort_keys=True).encode()).hexdigest()
    return ledger


def selftest():
    ok = True
    led = build("/home/claude", "selftest note")
    has_state = "error" not in led
    print(("PASS" if has_state else "FAIL") +
          f"  STATE-derived ledger built (version={led.get('version')})")
    ok &= has_state
    if has_state:
        g = led["guards"]["count"] == 7
        print(("PASS" if g else "FAIL") + f"  7 guard shas embedded ({led['guards']['count']})")
        ok &= g
        z = bool(led["zip"]["sha256"]) and bool(led["zip"]["file_count"])
        print(("PASS" if z else "FAIL") +
              f"  zip sha+count present ({led['zip']['file_count']} files)")
        ok &= z
        # self-hash is stable + covers content
        led2 = build("/home/claude", "selftest note")
        stable = led["self_sha256"] == led2["self_sha256"]
        print(("PASS" if stable else "FAIL") +
              "  self_sha256 reproducible across builds")
        ok &= stable
        # NEG: a content change MUST change the sha (else the fingerprint is decoration)
        import copy
        mut = copy.deepcopy(led)
        mut.pop("self_sha256", None); mut.pop("generated_at", None)
        mut["note"] = "MUTATED"
        import hashlib as _h, json as _j
        mut_sha = _h.sha256(_j.dumps(mut, sort_keys=True).encode()).hexdigest()
        neg = mut_sha != led["self_sha256"]
        print(("PASS" if neg else "FAIL") + "  NEG: content change changes self_sha256")
        ok &= neg
        a = copy.deepcopy(led); b = copy.deepcopy(led2)
        for x in (a, b):
            x.pop("generated_at", None); x.pop("self_sha256", None)
        print(("PASS" if a == b else "FAIL") + "  ledger deterministic (excl. timestamp)")
        ok &= (a == b)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--home", default="/home/claude")
    ap.add_argument("--note", default=None)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_bundle(a.home)
    led = build(a.home, a.note)
    if "error" in led:
        # the LEDGER could not be derived -- that is CANNOT-EVALUATE,
        # not "findings about the release"
        sys.stderr.write("CANNOT-EVALUATE proof ledger: reason=ABSENT (%s)\n" % led["error"])
        print(f"{R}{led['error']}{RST}")
        return 2
    if not a.json:
        # default to JSON (this tool's whole point is the machine-readable record)
        pass
    json.dump(led, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0


sys.exit(main())
