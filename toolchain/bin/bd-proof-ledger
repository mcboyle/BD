#!/usr/bin/env python3
"""bd-proof-ledger -- machine-readable release proof record.

Assembles a single JSON proof object for a release from the authoritative
sources: STATE.json (version, zip sha256 + file_count, 7 guard shas,
validation line, parity), plus a timestamp and optional operator note. This is
the canonical structured artifact that bd-evidence-chain hashes and
bd-release-attestation bundles. Read-only.

Usage: bd-proof-ledger [--home DIR] [--note TEXT] [--json] [--selftest]
--home defaults to $HOME. Exit 0 ledger built (informational record) / 2
CANNOT-EVALUATE (no STATE-derivable release under --home).

RETIREMENT NOTE (v3.66.854 port): this tool's source of truth is STATE.json
plus a release zip, and BOTH are retired -- git replaced the zip overlay and
project-knowledge/IMPROVEMENT_BACKLOG.md replaced STATE.json (CLAUDE.md s7). The
STATE reader is left INTACT rather than repointed, because IMPROVEMENT_BACKLOG.md is
prose and carries none of the fields this ledger is built from (zip sha256 +
file_count, guards_full_sha256, validation line, parity). On a git checkout the
only honest verdict is therefore CANNOT-EVALUATE, and the tool now says which
retirement caused it instead of reporting an empty bundle. The selftest runs
against a SYNTHETIC STATE fixture so the ledger logic (guard embedding,
self_sha256 stability and content-sensitivity, determinism) stays verified
without a bundle that no longer exists.
"""
import argparse
import hashlib
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def build(home, note):
    st = sec.load_state(home)
    if st is None:
        return {"error": "no STATE.json (version pack not attached?)"}
    zipinfo = st.get("zip", {})
    if not isinstance(zipinfo, dict):
        zipinfo = {"name": str(zipinfo)}
    guards = sec.state_guard_shas(st)
    ledger = {
        "schema": "bd-proof-ledger/1",
        "version": st.get("built_version") or st.get("live_version"),
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "zip": {"name": zipinfo.get("name") or zipinfo.get("file"),
                "sha256": zipinfo.get("sha256"),
                "file_count": zipinfo.get("file_count")},
        "guards": {"count": len(guards),
                   "guards_full_sha256": guards},
        "validation": st.get("validation"),
        "parity": st.get("parity"),
        "deploy_status": st.get("deploy_status"),
        "operator_note": note or None,
    }
    # a self-hash over the canonical content (tamper-evidence seed)
    # Content-addressed means CONTENT: generated_at is volatile and hashing it
    # made self_sha256 change every second -- an attestation of "when", not
    # "what". Exclude volatile fields; the timestamp stays in the ledger,
    # it just does not participate in the fingerprint.
    body = {k: v for k, v in ledger.items()
            if k not in ("self_sha256", "generated_at")}
    ledger["self_sha256"] = hashlib.sha256(
        json.dumps(body, sort_keys=True).encode()).hexdigest()
    return ledger


def _fixture_home(tmp):
    """A synthetic STATE bundle: the ledger logic under test, no zip world.

    The version comes from the SOURCE TREE, so a fixture that silently rotted
    away from the tree would show up as a version mismatch rather than as a
    self-consistent pass. sec.guard_paths() over a nonexistent home returns the
    declared 7-guard fallback -- the same set bd-guardcheck certifies.
    """
    ver = sec.detect_tree_version(sec.DEFAULT_WORK)
    guards = {g: "%064d" % i for i, g in enumerate(sec.guard_paths(os.path.join(tmp, "no-such-bundle")))}
    st = {"built_version": ver,
          "zip": {"name": "synthetic.zip", "sha256": "0" * 64, "file_count": 1234},
          "guards_full_sha256": guards,
          "validation": "13389 pass / 0 fail",
          "parity": "OK",
          "deploy_status": "synthetic"}
    os.makedirs(os.path.join(tmp, "nextsess"), exist_ok=True)
    with open(os.path.join(tmp, "nextsess", "STATE.json"), "w") as fh:
        json.dump(st, fh)
    return tmp, ver


def selftest():
    ok = True
    import tempfile, subprocess
    tmp = tempfile.mkdtemp(prefix="pl_fixture_")
    home, want_ver = _fixture_home(tmp)
    led = build(home, "selftest note")
    has_state = "error" not in led and led.get("version") == want_ver
    print(("PASS" if has_state else "FAIL") +
          f"  STATE-derived ledger built (version={led.get('version')}, want {want_ver})")
    ok &= has_state
    if has_state:
        g = led["guards"]["count"] == 7
        print(("PASS" if g else "FAIL") + f"  7 guard shas embedded ({led['guards']['count']})")
        ok &= g
        z = bool(led["zip"]["sha256"]) and bool(led["zip"]["file_count"])
        print(("PASS" if z else "FAIL") +
              f"  zip sha+count present ({led['zip']['file_count']} files)")
        ok &= z
        # self-hash is stable + covers content
        led2 = build(home, "selftest note")
        stable = led["self_sha256"] == led2["self_sha256"]
        print(("PASS" if stable else "FAIL") +
              "  self_sha256 reproducible across builds")
        ok &= stable
        # NEG: a content change MUST change the sha (else the fingerprint is decoration)
        import copy
        mut = copy.deepcopy(led)
        mut.pop("self_sha256", None); mut.pop("generated_at", None)
        mut["note"] = "MUTATED"
        import hashlib as _h, json as _j
        mut_sha = _h.sha256(_j.dumps(mut, sort_keys=True).encode()).hexdigest()
        neg = mut_sha != led["self_sha256"]
        print(("PASS" if neg else "FAIL") + "  NEG: content change changes self_sha256")
        ok &= neg
        a = copy.deepcopy(led); b = copy.deepcopy(led2)
        for x in (a, b):
            x.pop("generated_at", None); x.pop("self_sha256", None)
        print(("PASS" if a == b else "FAIL") + "  ledger deterministic (excl. timestamp)")
        ok &= (a == b)

    # NEG (verdict seam): a home with no derivable STATE must be
    # CANNOT-EVALUATE(2) from the real CLI -- never 0 over nothing, and never a
    # blanket 1 that reads as "findings about the release".
    empty = os.path.join(tmp, "empty_home")
    os.makedirs(empty, exist_ok=True)
    rc = subprocess.run([sys.executable, os.path.realpath(__file__), "--home", empty],
                        capture_output=True, text=True, timeout=60).returncode
    print(("PASS" if rc == 2 else "FAIL") +
          "  NEG: no STATE under --home -> CANNOT-EVALUATE 2 (got %d)" % rc)
    ok &= (rc == 2)

    import shutil
    shutil.rmtree(tmp, ignore_errors=True)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--home", default=os.path.expanduser("~"))
    ap.add_argument("--note", default=None)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    # Say WHICH retirement produced the refusal. require_bundle's message
    # ("0 file(s)") is true but names the wrong subject on a git checkout:
    # nothing is missing from the bundle, the bundle concept is gone.
    if sec.load_state(a.home) is None:
        sys.stderr.write(
            "CANNOT-EVALUATE proof ledger: reason=%s (no STATE.json under %s. "
            "STATE.json and the release zip are RETIRED -- git replaced the zip "
            "overlay and project-knowledge/IMPROVEMENT_BACKLOG.md replaced the "
            "register. Pass --home at a preserved bundle to read an archived "
            "release.)\n" % (sec.REASON_ABSENT, a.home))
        return sec.EXIT_CANNOT_EVALUATE
    sec.require_bundle(a.home)
    led = build(a.home, a.note)
    if "error" in led:
        # the LEDGER could not be derived -- that is CANNOT-EVALUATE,
        # not "findings about the release"
        sys.stderr.write("CANNOT-EVALUATE proof ledger: reason=ABSENT (%s)\n" % led["error"])
        print(f"{R}{led['error']}{RST}")
        return 2
    if not a.json:
        # default to JSON (this tool's whole point is the machine-readable record)
        pass
    json.dump(led, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0


sys.exit(main())
