#!/usr/bin/env python3
"""bd-config-risk -- score config key / env-var risk by capability class.

Enumerates BD_* env vars + config keys referenced in the tree and scores each by
the capability it gates: secret (vault/token), network (host/proxy/vpn/egress),
filesystem (path/dir/dest), plugin/exec (node/subprocess/exec), capture, dev/
shell (dev_mode/shell). A high-risk key with a permissive default is what a
security review triages first. Read-only.

Usage: bd-config-risk [--work DIR] [--json] [--selftest]
Exit 0 report-only (default) / 1 high-risk count exceeds --max-high / 2
CANNOT-EVALUATE. High-risk keys are normal; --max-high gates a REGRESSION.
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

CATS=[("secret",re.compile(r'(?i)secret|token|api[_-]?key|password|vault|credential|auth')),
      ("network",re.compile(r'(?i)host|proxy|vpn|egress|url|port|socks|bind')),
      ("filesystem",re.compile(r'(?i)path|dir|dest|file|home|root|folder')),
      ("plugin_exec",re.compile(r'(?i)plugin|node|exec|subprocess|shell|cmd|bin')),
      ("capture",re.compile(r'(?i)capture|wacz|record|dom')),
      ("dev_shell",re.compile(r'(?i)dev|debug|unlock|disable'))]
RISK_WEIGHT={"secret":5,"plugin_exec":5,"network":4,"dev_shell":4,"filesystem":3,"capture":2}

def scan(work):
    env=set()
    for _p,_rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        env |= set(re.findall(r'\bBD_[A-Z0-9_]+\b', txt))
    rows=[]
    for name in sorted(env):
        cats=[c for c,rx in CATS if rx.search(name)]
        score=max((RISK_WEIGHT.get(c,1) for c in cats), default=1)
        rows.append({"key":name,"categories":cats or ["other"],"risk":score})
    rows.sort(key=lambda r:(-r["risk"], r["key"]))
    return rows

def selftest():
    ok=True
    rows=scan(sec.DEFAULT_WORK)
    print(("PASS" if len(rows)>=50 else "FAIL")+"  BD_ env vars enumerated (%d)"%len(rows))
    ok=ok and len(rows)>=50
    # a secret-ish key scores 5, an unknown scores >=1
    has_hi=any(r["risk"]==5 for r in rows)
    print(("PASS" if has_hi else "WARN")+"  high-risk keys detected (%d at risk 5)"%sum(1 for r in rows if r["risk"]==5))
    # synthetic
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b=os.path.join(d,"bulk_downloader"); os.makedirs(b)
        open(os.path.join(b,"m.py"),"w").write("x=os.environ['BD_VAULT_SECRET']\ny=os.environ['BD_PROXY_HOST']\n")
        s=scan(d)
    kv={r["key"]:r["risk"] for r in s}
    good=kv.get("BD_VAULT_SECRET")==5 and kv.get("BD_PROXY_HOST")==4
    print(("PASS" if good else "FAIL")+"  synthetic risk scoring (%s)"%kv)
    ok=ok and good
    _r=[{"risk":4},{"risk":5},{"risk":1}]  # 2 high
    rcs=(_verdict_rc(_r,None),_verdict_rc(_r,2),_verdict_rc(_r,1))
    print(("PASS" if rcs==(0,0,1) else "FAIL")+"  NEG: over --max-high -> 1 (got %s)"%(rcs,))
    ok=ok and rcs==(0,0,1)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def _verdict_rc(rows, max_high):
    """0 report-only; 1 if high-risk count exceeds --max-high (opt-in gate)."""
    if max_high is None:
        return 0
    high = sum(1 for r in rows if r["risk"] >= 4)
    if high > max_high:
        sys.stderr.write("high-risk config keys %d exceed --max-high %d\n"
                         % (high, max_high))
        return 1
    return 0


def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--max-high",type=int,default=None,dest="max_high",help="fail (1) if high-risk key count exceeds N")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    rows=scan(a.work)
    if sec.emit({"keys":rows,"summary":{"total":len(rows),"high":sum(1 for r in rows if r["risk"]>=4)}},as_json=a.json): return _verdict_rc(rows,a.max_high)
    print("config/env risk (%d keys, %d high-risk):"%(len(rows),sum(1 for r in rows if r["risk"]>=4)))
    for r in rows[:40]:
        col=R if r["risk"]>=4 else (Y if r["risk"]>=3 else DIM)
        print("  %srisk %d%s  %-32s %s"%(col,r["risk"],RST,r["key"],",".join(r["categories"])))
    return _verdict_rc(rows,a.max_high)
sys.exit(main())
