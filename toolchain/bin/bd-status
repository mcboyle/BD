#!/bin/bash
# bd-status -- one-shot health check of the sandbox env + services.
# Usage: bd-status
# --selftest: this is a bootstrap/orchestration script; a real run IS its test.
case " $* " in *" --selftest "*)
  echo "SKIP: needs a provisioned session (run it directly to see live status)"
  echo "SELFTEST PASS"; exit 0;; esac
. /home/claude/bdenv.sh >/dev/null 2>&1

c_ok=$'\e[32mOK \e[0m'
c_no=$'\e[31m-- \e[0m'
c_dim=$'\e[2m'
c_off=$'\e[0m'

check_path() {
    local label="$1" path="$2"
    if [ -e "$path" ]; then echo "  $c_ok $label $c_dim($path)$c_off"
    else echo "  $c_no $label $c_dim($path missing)$c_off"; fi
}

# Check that at least one of N candidate paths exists. Useful for kits
# whose install layout varies between versions or where multiple
# acceptable evidence-paths exist (e.g. pip-installed packages can
# live in either the venv site-packages or system site-packages).
check_any_path() {
    local label="$1"; shift
    local first="$1"
    for p in "$@"; do
        if [ -e "$p" ]; then
            echo "  $c_ok $label $c_dim($p)$c_off"
            return 0
        fi
    done
    echo "  $c_no $label $c_dim(none of: $first ... missing)$c_off"
}

# Check that `python3 -c "import X"` succeeds. The right signal for
# pip-installed kits (optional, lsp) whose evidence lives in
# site-packages rather than a dedicated directory.
check_import() {
    local label="$1" mod="$2"
    if python3 -c "import $mod" 2>/dev/null; then
        echo "  $c_ok $label $c_dim(import $mod ok)$c_off"
    else
        echo "  $c_no $label $c_dim(import $mod failed)$c_off"
    fi
}

check_proc() {
    local label="$1" pattern="$2"
    local pid
    pid=$(pgrep -f "$pattern" 2>/dev/null | while read p; do
        cmd=$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null)
        case "$cmd" in *"/bin/sh"*|*"bash -"*) ;; *) echo "$p"; break ;; esac
    done | head -1)
    if [ -n "$pid" ]; then echo "  $c_ok $label $c_dim(PID $pid)$c_off"
    else echo "  $c_no $label $c_dim(not running)$c_off"; fi
}

check_port() {
    local label="$1" port="$2"
    local ok=0
    for delay in 0 0.3 0.8; do
        [ "$delay" != "0" ] && sleep $delay
        if python3 -c "import socket,sys; s=socket.socket(); s.settimeout(1.5)
try: s.connect((\"127.0.0.1\",$port))
except Exception: sys.exit(1)
" 2>/dev/null; then ok=1; break; fi
    done
    if [ $ok -eq 1 ]; then echo "  $c_ok $label $c_dim(:$port)$c_off"
    else echo "  $c_no $label $c_dim(:$port closed)$c_off"; fi
}

echo "=== ENV ==="
echo "  DISPLAY=$DISPLAY   BD_HOME=$BD_HOME   BD_DISABLE_KEEPALIVE=$BD_DISABLE_KEEPALIVE"
echo "  PATH head: $(echo $PATH | cut -d: -f1-3)"

echo
echo "=== KITS (file/import checks, 21 total) ==="
# Core kits (always required)
check_path "core (prestaged python)" /tmp/prestaged_site_packages
check_path "venv (stash runtime)"     /home/claude/work/venv/bin/python
check_import "optional (yt-dlp)"      yt_dlp
check_path "media (ffmpeg)"           /tmp/media/tools_bin/ffmpeg
check_path "tools (rg)"               /tmp/tools_bin/rg
check_path "node"                     /home/claude/.local/node/bin/node
check_path "gtk"                      /home/claude/.local/gtk
check_path "chromium (playwright)"    /home/claude/.cache/ms-playwright
check_path "frontend (node_modules)"  /home/claude/work/frontend/node_modules
check_path "vitest (harness)"         /home/claude/work/frontend/node_modules/.bin/vitest
check_path "rsuite"                   /home/claude/rsuite_kit/node_modules/rsuite
check_path "pypy"                     /home/claude/pypy_kit/pypy/bin/pypy3
check_path "bd_home"                  /home/claude/bd_home
check_path "apprise"                  /home/claude/apprise_kit/bin/fake_webhook_server.py
check_path "mocks"                    /home/claude/mocks_kit/bin/mock_plex.py

# Auxiliary kits (added in bd-status v2 — were silently missing before)
# Note: profiling unpacks to /tmp, not /home/claude.
check_any_path "profiling (py-spy)"   /tmp/profiling_kit/tools_bin/py-spy \
                                       /tmp/profiling_kit
check_path "supervisord"              /home/claude/supervisord_kit/conf
check_path "recordings"               /home/claude/recordings_kit
check_path "webproxy (Caddyfile)"     /home/claude/webproxy_kit/conf/Caddyfile
check_path "datastores (psql)"        /home/claude/datastores_kit/tools_bin/psql
check_path "lsp"                      /home/claude/lsp_kit
check_path "precommit"                /home/claude/precommit_kit

echo
echo "=== SERVICES (processes + ports) ==="
check_proc "Xvfb :99"        "Xvfb :99"
check_proc "apprise"         "fake_webhook_server.py"
check_port "  apprise"       8765
check_proc "mock_plex"       "mock_plex.py"
check_port "  plex"          32400
check_proc "mock_jellyfin"   "mock_jellyfin.py"
check_port "  jellyfin"      8096
check_proc "mock_stash"      "mock_stash.py"
check_port "  stash"         9999

echo
echo "=== SOURCE TREE ==="
check_path "BulkDownloader source" /home/claude/work/bulk_downloader
check_path "package_json"          /home/claude/work/frontend/package.json

# v3.66.721: the SERVICE VENV. Its loss is completely silent -- bd-install does
# `rm -rf work/*` before extracting and the zip has NO venv/, so re-running
# bd-boot/bd-install DESTROYS it and nothing restores it. Every tool hardcoding
# venv/bin/python then probes NOTHING (how bd-sbcap reported "chromium build
# resolvable" having verified nothing). Surface it here, every status call.
if [ -x /home/claude/work/venv/bin/python3 ] || [ -x /home/claude/work/venv/bin/python ]; then
  printf "  %-24s %s\n" "service venv" "OK (work/venv)"
else
  printf "  %-24s %s\n" "service venv" "MISSING -- re-running bd-boot/bd-install destroys it. Tools hardcoding venv/bin/python probe NOTHING. FIX: bd-venv"
fi

echo
echo "=== OPTIONAL PACKS (pack_E-H, install-on-demand) ==="
if command -v bd-optpack >/dev/null 2>&1; then
    echo "  $c_dim$(bd-optpack --brief 2>/dev/null)$c_off"
    echo "  $c_dim(bd-optpack list | install <E|F|G|H|all>)$c_off"
else
    echo "  $c_dim(bd-optpack not on PATH -- optional packs E-H not managed)$c_off"
fi

echo
echo "=== DISK ==="
df -h /home/claude /tmp 2>/dev/null | tail -2 | awk '{printf "  %-12s %s used, %s free (%s)\n", $6, $3, $4, $5}'
