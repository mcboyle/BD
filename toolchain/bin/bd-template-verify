#!/usr/bin/env python3
"""Resolve one site template's selectors against a URL or saved HTML page.

The template is a committed corpus id, a reviewed-template PATH, or a reviewed
template id under templates/reviewed/.  Exit: 0 HIT, 1 MISS/MALFORMED,
2 UNKNOWN (the instrument could not measure), 3 the template argument was
REFUSED -- which is a different question from an unmeasurable subject.
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
import sys
from pathlib import Path
from typing import Any, Callable


sys.dont_write_bytecode = True
TOOL = Path(__file__).resolve()
RESOLVER = TOOL.parent / "_bd_work_tree.py"
try:
    resolver_spec = importlib.util.spec_from_file_location(
        "_bd_template_verify_work_tree", RESOLVER
    )
    if resolver_spec is None or resolver_spec.loader is None:
        raise ImportError(f"cannot load {RESOLVER}")
    resolver = importlib.util.module_from_spec(resolver_spec)
    resolver_spec.loader.exec_module(resolver)
    WORK = resolver.resolve_work_tree(__file__)
except (Exception, SystemExit) as exc:
    print(
        f"BD-TEMPLATE-VERIFY-UNKNOWN: checkout authority unavailable: {exc}",
        file=sys.stderr,
    )
    raise SystemExit(2)

venv_python = WORK / "venv" / "bin" / "python"
if (venv_python.is_file() and os.access(venv_python, os.X_OK)
        and Path(sys.prefix).resolve() != (WORK / "venv").resolve()):
    try:
        os.execve(
            str(venv_python),
            [str(venv_python), str(TOOL), *sys.argv[1:]],
            dict(os.environ),
        )
    except OSError as exc:
        print(
            f"BD-TEMPLATE-VERIFY-UNKNOWN: checkout interpreter failed: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(2)

sys.path.insert(0, str(WORK))

# The verifier compiles selectors with Playwright's own parser bundle, so
# an interpreter that cannot import it cannot MEASURE the corpus at all.
_DEPENDENCY = "playwright"
_IMPORT_ERROR: ImportError | None = None
audit_committed_selector_syntax: Callable[[], dict[str, Any]]
parse_selectors: Callable[[list[Any]], list[dict[str, Any]]]
verify_template_source: Callable[..., dict[str, Any]]
try:
    from bulk_downloader.template_selector_verifier import (  # noqa: E402
        audit_committed_selector_syntax,
        parse_selectors,
        verify_template_source,
    )
except ImportError as exc:
    _IMPORT_ERROR = exc


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "template_id",
        nargs="?",
        help="committed template id, or a reviewed template path or id",
    )
    parser.add_argument(
        "subject", nargs="?", help="live http(s) URL or saved UTF-8 HTML"
    )
    parser.add_argument("--json", action="store_true", help="emit full JSON report")
    parser.add_argument(
        "--audit-corpus",
        action="store_true",
        help="compile every committed selector; no browser/network",
    )
    parser.add_argument(
        "--headed", action="store_true", help="show browser for login/navigation"
    )
    parser.add_argument("--wait-for", help="wait for this selector before measuring")
    parser.add_argument(
        "--session",
        help="JSON file carrying the operator's authenticated session -- a "
             "Playwright storage_state() export or a BD cookie file; URL "
             "subjects only (row 670)",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=10.0,
        help="navigation/selector timeout in seconds",
    )
    parser.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    return parser


def _print_human(report: dict[str, Any]) -> None:
    match_count = report.get("match_count")
    matches = "-" if type(match_count) is not int else str(match_count)
    print(
        f"template={report.get('template_id', '<corpus>')} "
        f"verdict={report['verdict']} selectors={report['selector_count']} "
        f"matches={matches}"
    )
    for row in report.get("selectors", []):
        count = "-" if row.get("count") is None else str(row["count"])
        print(f"{row['status']:9} count={count:>3} {row['path']}: {row['selector']}")
        if row.get("error"):
            print(f"          {row['error']}")


_STATE_EXIT = {"PASS": 0, "FAIL": 1, "UNKNOWN": 2}
_CONTROL_CENSUS = "controls=2 unknown=0 missing_subject=1"

# Row 672: the positional named the COMMITTED corpus and nothing else, so an
# operator holding a reviewed template had no way to name it -- the reviewed
# corpus was unreachable from this tool.
_REVIEWED_DIR = WORK / "templates" / "reviewed"
_REVIEWED_SUFFIX = ".template.json"
# A REFUSED ARGUMENT is neither a failed measurement nor an unmeasurable one.
# 0/1/2 already mean PASS/FAIL/UNKNOWN, so folding a refusal into 2 would make
# "this reviewed path is not a template" indistinguishable from "the corpus
# could not be measured" -- the collapsed diagnostic CLAUDE.md A7 names, which
# leads the operator to repair the instrument instead of fixing the argument.
_REFUSED_EXIT = 3


def _names_a_file_argument(name: str) -> bool:
    """Does this positional name a FILE rather than a committed corpus id?

    Committed corpus ids are bare identifiers -- ``video_js``, ``jw_player``,
    ``html5_native`` -- carrying neither a separator nor a suffix, so the two
    namespaces are separable by shape. The decision answers on the SHAPE OF THE
    NAME and deliberately not on whether a file happens to exist: a path that is
    missing must be refused AS A MISSING PATH, never quietly reinterpreted as a
    corpus id that also does not exist.
    """
    return name.endswith(".json") or "/" in name or os.sep in name


def _corpus_carries(name: str) -> bool:
    """Does the committed corpus resolve this id exactly once?

    Read off ``site_templates.TEMPLATES`` rather than off the verifier's own
    resolver, so the collision question is answered against an independent
    denominator (CLAUDE.md A7); the exactly-one rule is the resolver's.
    """
    from bulk_downloader.site_templates import TEMPLATES

    return sum(1 for item in TEMPLATES if item.get("id") == name) == 1


def _reviewed_by_id(name: str) -> Path | None:
    """The reviewed template a bare id selects, or ``None``."""
    candidate = _REVIEWED_DIR / f"{name}{_REVIEWED_SUFFIX}"
    return candidate if candidate.is_file() else None


def _load_reviewed(path: Path) -> tuple[Any, str]:
    """Compose a reviewed template file into the shape the verifier measures.

    Returns ``(template, "")`` or ``(None, refusal)``; exactly one is set.
    """
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return None, (
            f"reviewed template is unreadable: {path}: "
            f"{type(exc).__name__}: {exc}"
        )
    if not isinstance(data, dict) or not isinstance(data.get("selectors"), dict):
        return None, f"reviewed template carries no selectors block: {path}"
    from bulk_downloader.template_assist import template_to_selector_probe

    try:
        probe = template_to_selector_probe(data, str(data.get("host") or path.name))
    except (KeyError, TypeError) as exc:
        return None, (
            f"reviewed template is missing a selector group: {path}: "
            f"{type(exc).__name__}: {exc}"
        )
    return probe, ""


def _resolve_template_argument(name: str) -> tuple[Any, str]:
    """Resolve the positional into a corpus id or a composed reviewed template.

    THE ORDER IS THE FAIL-CLOSED DECISION, and it is written here because the
    silent version of it is worse than the row this closes. A value that NAMES A
    FILE is a reviewed template and may never fall back to the corpus: a
    fallback would verify a DIFFERENT template and report it green. A bare name
    is a COMMITTED CORPUS ID FIRST, exactly as it has always been, so every
    invocation that worked before this row resolves to the same template after
    it; the reviewed directory is consulted only when the corpus does not carry
    the name. A reviewed template whose bare id collides with a corpus id is
    therefore still reachable -- by its PATH, which cannot collide, because a
    corpus id never contains a separator or a suffix.
    """
    if _names_a_file_argument(name):
        path = Path(name)
        if not path.is_file():
            return None, f"reviewed template path is not a file: {path}"
        return _load_reviewed(path)
    if _corpus_carries(name):
        return name, ""
    reviewed = _reviewed_by_id(name)
    if reviewed is not None:
        return _load_reviewed(reviewed)
    return name, ""


def _selftest_verdict(state: str, detail: str) -> int:
    """Emit the ONE machine-readable terminal verdict line and its exit code.

    A consumer reads a VERDICT, never a traceback: an instrument that cannot
    measure is UNKNOWN and must be distinguishable from the subject failing.
    The detail is flattened to a single physical line because the verdict is
    parsed line-wise; an embedded newline would split it in half and hide it.
    """
    stream = sys.stdout if state == "PASS" else sys.stderr
    print(f"SELFTEST {state}: {' '.join(str(detail).split())}", file=stream)
    return _STATE_EXIT[state]


def _dependency_clause() -> str:
    """Name the verifier dependency this interpreter cannot import, or ''."""
    try:
        importlib.import_module(_DEPENDENCY)
    except (Exception, SystemExit) as exc:
        return f"import={_DEPENDENCY} reason={type(exc).__name__}: {exc}"
    return ""


def _selftest_unknown(detail: str, clause: str = "") -> int:
    """The instrument could not measure: keep the diagnostic AND the verdict."""
    print(
        "BD-TEMPLATE-VERIFY-SELFTEST-UNKNOWN: controls=2 unknown=2; "
        f"{detail}",
        file=sys.stderr,
    )
    named = clause or _dependency_clause() or f"reason={detail}"
    return _selftest_verdict("UNKNOWN", f"interpreter={sys.executable} {named}")


def _selftest_body() -> int:
    if venv_python.is_file() and Path(sys.prefix).resolve() != (WORK / "venv").resolve():
        return _selftest_verdict(
            "UNKNOWN",
            f"interpreter={sys.executable} reason=tool did not re-exec the "
            f"checkout interpreter {venv_python}",
        )
    if _IMPORT_ERROR is not None:
        return _selftest_unknown(
            "verifier import unavailable: "
            f"{type(_IMPORT_ERROR).__name__}: {_IMPORT_ERROR}",
            _dependency_clause()
            or f"import=bulk_downloader.template_selector_verifier "
               f"reason={type(_IMPORT_ERROR).__name__}: {_IMPORT_ERROR}",
        )

    controls = parse_selectors(["a[href]", "a[href*='.mp4'"])
    if len(controls) != 2:
        return _selftest_verdict(
            "UNKNOWN",
            f"interpreter={sys.executable} reason=selftest selector denominator "
            f"is not exactly two: {controls}",
        )
    unknown = [item for item in controls if item["status"] == "UNKNOWN"]
    if unknown:
        detail = str(unknown[0].get("error") or "selector measurement unavailable")
        return _selftest_unknown(detail)
    if [item["status"] for item in controls] != ["VALID", "MALFORMED"]:
        return _selftest_verdict(
            "UNKNOWN",
            f"interpreter={sys.executable} reason=controls did not resolve "
            f"VALID/MALFORMED: {controls}",
        )

    missing = verify_template_source(
        {"id": "selftest", "learned": {"download": {"row_selectors": ["a[href]"]}}},
        WORK / "toolchain" / "fixtures" / "bd-template-verify-intentionally-absent.html",
    )
    if (missing["selector_count"] != 1 or missing["verdict"] != "UNKNOWN"
            or missing["ok"] is not False):
        return _selftest_verdict(
            "UNKNOWN",
            f"interpreter={sys.executable} reason=absent-subject control did not "
            f"report UNKNOWN: {missing}",
        )

    # The committed corpus is the SUBJECT; the controls above are the instrument.
    # Reporting them separately is the whole point of this verdict grammar.
    corpus = audit_committed_selector_syntax()
    templates = int(corpus["template_count"])
    selectors = int(corpus["selector_count"])
    census = (f"{_CONTROL_CENSUS} interpreter={sys.executable} "
              f"templates={templates} selectors={selectors}")
    if templates <= 0 or selectors <= 0:
        return _selftest_verdict(
            "UNKNOWN", f"{census} reason=committed corpus denominator is empty"
        )
    if corpus["verdict"] == "UNKNOWN":
        first = next(
            (row for row in corpus["selectors"] if row["status"] == "UNKNOWN"), {}
        )
        return _selftest_verdict(
            "UNKNOWN",
            f"{census} unknown={corpus['unknown_count']} "
            f"{_dependency_clause() or 'reason=' + str(first.get('error') or 'corpus measurement unavailable')}",
        )
    if corpus["verdict"] != "OK":
        broken = [row for row in corpus["selectors"] if row["status"] == "MALFORMED"]
        named = "; ".join(
            f"template={row['template_id']} path={row['path']} "
            f"selector={row['selector']}"
            for row in broken[:5]
        )
        return _selftest_verdict(
            "FAIL", f"{census} malformed={corpus['malformed_count']} {named}"
        )
    return _selftest_verdict("PASS", census)


def _selftest() -> int:
    """No selftest path may raise: a crashing instrument still owes a verdict."""
    try:
        return _selftest_body()
    except (Exception, SystemExit) as exc:
        return _selftest_verdict(
            "UNKNOWN",
            f"interpreter={sys.executable} reason={type(exc).__name__}: {exc}",
        )


def _dependency_unknown() -> int:
    assert _IMPORT_ERROR is not None
    print(
        "BD-TEMPLATE-VERIFY-UNKNOWN: verifier dependency unavailable: "
        f"{type(_IMPORT_ERROR).__name__}: {_IMPORT_ERROR}",
        file=sys.stderr,
    )
    return 2


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    if args.selftest:
        return _selftest()
    if _IMPORT_ERROR is not None:
        return _dependency_unknown()
    if args.audit_corpus:
        report = audit_committed_selector_syntax()
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            _print_human(report)
        if report["verdict"] == "OK":
            return 0
        return 2 if report["verdict"] == "UNKNOWN" else 1
    if not args.template_id or not args.subject:
        _parser().error(
            "template_id and subject are required unless --audit-corpus is used"
        )
    resolved, refusal = _resolve_template_argument(args.template_id)
    if refusal:
        print(f"BD-TEMPLATE-VERIFY-REFUSED: {refusal}", file=sys.stderr)
        return _REFUSED_EXIT
    report = verify_template_source(
        resolved,
        args.subject,
        timeout=args.timeout,
        headless=not args.headed,
        wait_for=args.wait_for,
        session=args.session,
    )
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        _print_human(report)
    if report["verdict"] == "HIT":
        return 0
    return 2 if report["verdict"] == "UNKNOWN" else 1


if __name__ == "__main__":
    raise SystemExit(main())
