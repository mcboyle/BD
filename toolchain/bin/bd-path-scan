#!/usr/bin/env python3
"""bd-path-scan -- static finder for unguarded filesystem sinks (path traversal).

Flags os.path.join / Path-'/' joins with a variable component, open(...,'w'),
shutil.move/copy targets, and archive extract paths that have NO confinement
hint (safe_join / safe_slug / is_relative_to / commonpath / startswith(base) /
realpath-resolve check) within +/-5 lines. Rule BD-PATH-UNGUARDED, severity
medium (high when the window shows externally-derived input). Advisory,
read-only, deterministic.

Usage: bd-path-scan [--work DIR] [--json] [--fail-on-findings] [--selftest]
Exit 0 = scanned a real corpus, clean (or findings without --fail-on-findings);
1 = scanned, findings, with --fail-on-findings; 2 = CANNOT-EVALUATE (the --work
tree is absent, empty, or unreadable -- no verdict is minted over nothing).
Every verdict line states the number of files scanned (the denominator).
"""
import argparse
import os
import re
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

SINKS = [
    ("join", re.compile(r'\bos\.path\.join\s*\(')),
    ("path-div", re.compile(r'\bPath\s*\([^)]*\)\s*/\s*[A-Za-z_]')),
    ("open-write", re.compile(r'\bopen\s*\([^)]*,\s*["\'][wa]b?\+?["\']')),
    ("shutil", re.compile(r'\bshutil\.(?:move|copy2?|copytree|copyfile)\s*\(')),
    ("extract", re.compile(r'\.(?:extractall|extract)\s*\(')),
]
CONFINE = re.compile(
    r'safe_join|safe_slug|is_relative_to|commonpath|startswith\s*\(\s*(?:base|root|str\()'
    r'|\.resolve\(\)|realpath|secure_filename|sanitize')
EXTERNAL = re.compile(
    r'request\.|args\.get|\.form\b|\.json\b|filename|user_|_url\b|url_|host|params')
LITERAL_ONLY = re.compile(r'\(\s*["\'][^"\']*["\']\s*(?:,\s*["\'][^"\']*["\']\s*)*\)')


def scan(work, strict=False):
    """Return (findings, files_scanned). The count IS the denominator: a verdict
    that does not say what it examined is the bug this tool was caught by."""
    findings = []
    scanned = 0
    for path, rel, txt in sec.iter_py(work, strict=strict, label="--work/--tree"):
        scanned += 1
        lines = txt.splitlines()
        for i, line in enumerate(lines, 1):
            for kind, pat in SINKS:
                m = pat.search(line)
                if not m:
                    continue
                # skip pure-literal argument lists (constant paths are not traversal)
                tail = line[m.start():]
                if kind in ("join", "open-write", "shutil") and LITERAL_ONLY.search(tail):
                    continue
                win = "\n".join(lines[max(0, i - 6):i + 5])
                if CONFINE.search(win):
                    continue
                sev = "high" if EXTERNAL.search(win) else "medium"
                findings.append(sec.finding(
                    "bd-path-scan", "BD-PATH-UNGUARDED", sev, rel, i,
                    f"{kind} sink with no confinement hint within +/-5 lines",
                    sink=kind, snippet=line.strip()[:120]))
    findings.sort(key=lambda f: (f["severity"] != "high", f["file"], f["line"]))
    return findings, scanned


def _neg_corpus_guard():
    """NEG: a verdict must never be minted over a corpus that is not there.

    Probes this tool's OWN --tree flag against an absent tree and an empty
    tree. Both must exit 2 (CANNOT-EVALUATE). rc=0 here is the F-1 bug: a
    green verdict whose search set structurally excluded the thing asked
    about. Probed via subprocess so the real argparse/exit path is exercised.
    """
    import subprocess
    import tempfile
    ok = True
    ghost = "/home/claude/GHOST_DIR_DOES_NOT_EXIST"
    rc = subprocess.call([sys.executable, __file__, "--tree", ghost],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    good = rc == sec.EXIT_CANNOT_EVALUATE
    print(("PASS" if good else "FAIL") +
          "  NEG absent-tree: want CANNOT-EVALUATE(2), got rc=%d" % rc)
    ok &= good
    with tempfile.TemporaryDirectory() as d:
        rc = subprocess.call([sys.executable, __file__, "--tree", d],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    good = rc == sec.EXIT_CANNOT_EVALUATE
    print(("PASS" if good else "FAIL") +
          "  NEG empty-tree: want CANNOT-EVALUATE(2), got rc=%d" % rc)
    ok &= good
    return ok


def selftest():
    ok = True
    pad = "# pad\n" * 8                   # push the unguarded one out of the window
    fx = ('import os, shutil\n'
          'from myapp.paths import safe_join\n'
          'def guarded(base, name):\n'
          '    return safe_join(base, name)   # os.path.join(base, name) confined\n'
          + pad +
          'def unguarded(base, name):\n'
          '    p = os.path.join(base, name)\n'
          '    return p\n')
    with tempfile.TemporaryDirectory() as d:
        os.makedirs(os.path.join(d, "bulk_downloader"))
        open(os.path.join(d, "bulk_downloader", "fx.py"), "w").write(fx)
        f, nfx = scan(d)
    got = [(x["rule"], x["line"]) for x in f]
    good = len(f) == 1 and f[0]["rule"] == "BD-PATH-UNGUARDED"
    print(("PASS" if good else "FAIL") + f"  fixture: exactly 1 finding (got {got})")
    ok &= good
    # POS: the fixture corpus is non-empty and the tool says so (denominator).
    print(("PASS" if nfx == 1 else "FAIL") + f"  POS denominator: fixture scanned {nfx} file(s)")
    ok &= (nfx == 1)
    fa, na = scan(sec.DEFAULT_WORK)
    fb, nb = scan(sec.DEFAULT_WORK)
    a = [(x["file"], x["line"]) for x in fa]
    b = [(x["file"], x["line"]) for x in fb]
    det = a == b and na == nb
    print(("PASS" if det else "FAIL") + f"  real-tree determinism ({len(a)} findings x2)")
    ok &= det
    ok &= _neg_corpus_guard()
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--fail-on-findings", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()

    findings, scanned = scan(a.work, strict=True)
    if sec.emit({"findings": findings, "summary": {"total": len(findings),
                 "high": sum(1 for f in findings if f["severity"] == "high"),
                 "files_scanned": scanned}},
                as_json=a.json):
        return sec.EXIT_FINDINGS if (a.fail_on_findings and findings) else sec.EXIT_OK

    if not findings:
        print(f"{G}no unguarded path sinks found{RST} {DIM}(scanned {scanned} files){RST}")
        return sec.EXIT_OK
    for f in findings[:40]:
        sev = (R if f["severity"] == "high" else Y) + f["severity"].upper() + RST
        print(f"  {sev:<14} {f['file']}:{f['line']}  {DIM}{f['extra']['sink']}: "
              f"{f['extra']['snippet']}{RST}")
    hi = sum(1 for f in findings if f["severity"] == "high")
    print(f"{DIM}{len(findings)} finding(s), {hi} high (externally-derived input in window)"
          f" | scanned {scanned} files{RST}")
    return sec.EXIT_FINDINGS if (a.fail_on_findings and findings) else sec.EXIT_OK


sys.exit(main())
