REGISTRATION_TIMEOUT_OWNER_PROGRAM = r'''\
import os
import sys


if len(sys.argv) < 7:
    raise SystemExit(95)
expected_parent = int(sys.argv[1])
close_fds, stdout_path, stderr_path = sys.argv[2:5]
command = sys.argv[5:]
if os.getppid() != expected_parent:
    raise SystemExit(97)
requested_close_fds = []
for fd_text in close_fds.split(","):
    if not fd_text:
        continue
    try:
        fd = int(fd_text)
    except ValueError:
        raise SystemExit(95)
    requested_close_fds.append(fd)
for fd_text in os.listdir("/proc/self/fd"):
    try:
        fd = int(fd_text)
    except ValueError:
        continue
    if fd > 2:
        try:
            os.close(fd)
        except OSError:
            pass
os.setsid()
with open("/proc/self/stat", encoding="ascii") as stream:
    raw = stream.read()
tail = raw.rsplit(") ", 1)[1].split()
receipt = "%d:%d:%d:%d:%s" % (
    os.getpid(), os.getppid(), os.getpgrp(), os.getsid(0), tail[19])
live_fds = []
for fd_text in os.listdir("/proc/self/fd"):
    try:
        fd = int(fd_text)
        os.fstat(fd)
    except (ValueError, OSError):
        continue
    live_fds.append(fd)
ready = ("OWNER-READY v2 receipt=%s fds=%s\n" %
         (receipt, ",".join(map(str, sorted(live_fds))))).encode("ascii")
view = memoryview(ready)
while view:
    written = os.write(1, view)
    if written <= 0:
        raise SystemExit(96)
    view = view[written:]
os.close(1)
stdin_fd = os.open("/dev/null", os.O_RDONLY)
stdout_fd = os.open(stdout_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
stderr_fd = os.open(stderr_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.dup2(stdin_fd, 0)
os.dup2(stdout_fd, 1)
os.dup2(stderr_fd, 2)
for fd in {stdin_fd, stdout_fd, stderr_fd}:
    if fd > 2:
        os.close(fd)
os.execvp(command[0], command)
'''


REGISTRATION_CHANNEL_READER_PROGRAM = r'''\
import binascii
import math
import os
import re
import select
import sys
import time


def close_preserving_primary(fd, label, failures=None):
    """Settle one owned fd without replacing an exception already in flight."""
    primary = sys.exc_info()[1]
    try:
        os.close(fd)
    except (AttributeError, OSError) as exc:
        detail = "%s-%s" % (label, type(exc).__name__)
        if failures is not None:
            failures.append(detail)
        if primary is None:
            if failures is None:
                raise
            return
        try:
            primary.add_note("secondary owned-fd close failure: " + detail)
        except (AttributeError, Exception):
            pass
    except BaseException as exc:
        if primary is None:
            raise
        detail = "%s-%s" % (label, type(exc).__name__)
        try:
            primary.add_note("secondary owned-fd close cancellation: " + detail)
        except (AttributeError, Exception):
            pass


def safe_display(data):
    shown = data[:-1] if data.endswith(b"\n") else data
    return "".join(chr(value) if 32 <= value <= 126 else "\\x%02x" % value
                   for value in shown)


state = "ERROR"
classification = "IO_ERROR"
data = bytearray()
try:
    if len(sys.argv) != 5:
        raise ValueError("argv")
    timeout = float(sys.argv[2])
    mode = sys.argv[3]
    expected_pid = sys.argv[4]
    if mode not in ("ready", "terminal"):
        raise ValueError("mode")
    if not math.isfinite(timeout) or timeout <= 0:
        raise ValueError("timeout")
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK)
    try:
        # The caller's timeout owner is the authority. Finish slightly before
        # it so partial raw evidence can be emitted without extending that
        # owner's absolute budget.
        deadline = time.monotonic() + max(0.0, timeout - 0.15)
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                state = "TIMEOUT"
                break
            readable, _, _ = select.select([fd], [], [], remaining)
            if not readable:
                state = "TIMEOUT"
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                state = "EOF"
                break
            data.extend(chunk)
            if len(data) > 4096:
                state = "TOO-LARGE"
                break
    finally:
        close_preserving_primary(fd, "registration-channel")
except OSError as exc:
    state = "ERROR-%d" % (exc.errno or 0)
except (TypeError, ValueError):
    state = "ERROR-ARG"

raw = bytes(data)
if state == "TIMEOUT":
    classification = "TIMEOUT"
elif state != "EOF":
    classification = "IO_ERROR"
elif mode == "ready":
    expected = ("READY v1 pid=" + expected_pid + "\n").encode("ascii")
    classification = "READY" if raw == expected else "INVALID"
elif raw == b"EXEC-OK v1\n":
    classification = "EXEC_OK"
elif re.fullmatch(rb"EXEC-FAIL v1 errno=[0-9]+\n", raw):
    classification = "EXEC_FAIL"
elif raw in {
        b"ABORTED v1 reason=release-eof\n",
        b"ABORTED v1 reason=release-protocol\n",
        b"ABORTED v1 reason=release-too-large\n",
}:
    classification = "ABORTED"
else:
    classification = "INVALID"
one_ascii_line = bool(raw) and raw.endswith(b"\n") \
    and b"\n" not in raw[:-1] \
    and all(32 <= value <= 126 for value in raw[:-1])
print("S:" + state)
print("H:" + binascii.hexlify(raw).decode("ascii"))
print("D:" + safe_display(raw))
print("A:" + ("1" if one_ascii_line else "0"))
print("C:" + classification)
'''


REGISTRATION_GATE_PROGRAM = r'''\
import os
import sys
import time


def emit(fd, frame):
    data = (frame + "\n").encode("ascii", "strict")
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise OSError("short gate status write")
        view = view[written:]


def abort(reason, status=0):
    emit(3, "ABORTED v1 reason=" + reason)
    raise SystemExit(status)


if len(sys.argv) != 2:
    abort("bad-shim-argv", 95)
shim = sys.argv[1]
emit(1, "READY v1 pid=%d" % os.getpid())
os.close(1)
if os.environ.get("W1_GATE_EXIT_AFTER_READY"):
    time.sleep(float(os.environ.get("W1_GATE_EXIT_AFTER_READY", "0")))
    raise SystemExit(98)
release = bytearray()
while True:
    chunk = os.read(0, 4096)
    if not chunk:
        break
    release.extend(chunk)
    if len(release) > 4096:
        abort("release-too-large", 95)
if bytes(release) != b"GO v1\n":
    if os.environ.get("W1_GATE_WITHHOLD_ABORT"):
        time.sleep(float(os.environ.get("W1_GATE_WITHHOLD_ABORT", "30")))
        raise SystemExit(99)
    abort("release-eof" if not release else "release-protocol", 0)
if os.environ.get("W1_GATE_EXIT_AFTER_GO"):
    raise SystemExit(99)
if os.environ.get("W1_GATE_WITHHOLD_STATUS"):
    time.sleep(float(os.environ.get("W1_GATE_WITHHOLD_STATUS", "30")))
    raise SystemExit(99)
os.close(0)
executable = os.environ.get("W1_GATE_EXECUTABLE", "/bin/bash")
try:
    os.execv(executable, [executable, "-c", shim])
except OSError as exc:
    emit(3, "EXEC-FAIL v1 errno=%d" % (exc.errno or 0))
    raise SystemExit(96)
'''


RUNNER = r"""
set -u
RUNDIR="{rundir}"
mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
W1_RUN_ID={run_id}
export BD_WEDGE_RUN_ID="$W1_RUN_ID"
W1_EXPECTED_PARENT="${{BD_WEDGE_EXPECTED_PARENT:-0}}"
if ! python3 -c {process_guard} capture "$$" \
        "$RUNDIR/runner.receipt" "$W1_RUN_ID" "$RUNDIR" \
        "$W1_EXPECTED_PARENT" > "$RUNDIR/runner-receipt.log" \
        2> "$RUNDIR/runner-receipt.err"; then
    echo 92 > "$RUNDIR/exitcode"
    exit 92
fi
cd "$HOME/BulkDownloader" || {{ echo 90 > "$RUNDIR/exitcode"; exit 90; }}

git rev-parse HEAD > "$RUNDIR/head_before" 2>&1
git status --porcelain | wc -l > "$RUNDIR/dirty_before" 2>&1
cat /proc/loadavg > "$RUNDIR/load_before" 2>&1
date +%s > "$RUNDIR/epoch_start"

# No child or authority descriptor is acquired until every lifecycle function
# and the cancellation/EXIT guards below have been installed.
W1_TERMINAL_RELAY_PID=""
W1_RELAY_READ_FD=""
W1_RELAY_WRITE_FD=""
W1_TERMINAL_READ_FD=""
W1_TERMINAL_PARENT_WRITE_FD=""
W1_TERMINAL_WRITER_PATH=""
PYTEST_GATE_PID=""
W1_COPROC_READ_FD=""
W1_COPROC_WRITE_FD=""
W1_GATE_READ_FD=""
W1_GATE_WRITE_FD=""
PYTEST_PID=""

# W1_GATE_SECONDS bounds the FORWARD gate protocol; W1_CLEANUP_SECONDS bounds
# the SETTLEMENT paths that run after the outcome is already decided. They were
# one constant until v3.66.1230 and that is the v3.66.1222 defect -- one key
# describing two costs. The forward deadline is meant to expire when a gate
# never arrives, so a caller may legitimately drive it to a small value; the
# cleanup deadline must NOT expire on correct work, because expiry there
# downgrades a KNOWN classification (a received SIGINT is exactly 130) to the
# retained-uncertainty code 92. Sharing one constant meant shortening the
# former silently shortened the latter. Bounds: the forward deadline is capped
# at W1_TOTAL_SECONDS - W1_CLEANUP_RESERVE_SECONDS and the cleanup deadline at
# W1_TOTAL_SECONDS, so the reserve (20s) is what governs the cleanup value.
# 15 is DERIVED, not chosen: SIGINT-delivered to runner-exited measured
# 2.4737s median over 24 serial repetitions on test5 (load 1.82, 979-process
# table), and 2.4737 x 6.0 = 14.85 against the same contention factor
# v3.66.1226 measured for this module. It clears the reserve by five seconds
# and the measured cost by six times; that headroom is thin on the ceiling
# side and the changelog says so rather than rounding it away.
# registration_begin_cleanup_deadline is the discriminator: every one of its
# call sites is a settlement path, and every forward phase still reads
# W1_GATE_SECONDS.
#
# W1_OWNER_OBSERVATION_SECONDS is the SAME defect one level down, and
# v3.66.1241 is where it was measured rather than argued. Every owner
# OBSERVATION -- the fd observer, the process observer, the group observer
# and the descendant census owner_collect runs after every owned helper --
# was spawned under `timeout` with WHAT REMAINS of the active forward
# deadline. That is one key describing two costs again: the forward
# deadline answers "how long to wait for a gate that never comes", where
# expiry is the SUBJECT, and the same number was answering "how long may a
# helper take to ANSWER A QUESTION", where expiry is a FALSE VERDICT --
# UNKNOWN, and then a correct run settles into retained uncertainty. The
# trailing census is the worst case because it runs at the END of a phase,
# so its share of the remainder is whatever the phase did not spend, and a
# caller driving the forward deadline to 3s left observers about 1.5s --
# caught live as `timeout --kill-after=0.100000 1.510000 python3 -c ...`.
# THE FLOOR IS DERIVED, NOT CHOSEN. One complete observation spawn --
# coproc python3 timeout-owner, OWNER-READY handshake, timeout(1), the
# python3 group probe and the owner wait -- measured 0.2900s median (max
# 0.3400s, n=30) on an idle-ish test5 at 1098 processes and 0.3000s median
# (max 0.3600s, n=24) under twelve procfs-walking contention generators at
# 1217 processes and load 8.65. Two-sided:
#   floor    3 >= 0.3000 x 6.0 = 1.80   (the 6.0 contention stretch
#            v3.66.1226 measured for this module), and 3 > the 1.51s
#            remainder that demonstrably produced a false UNKNOWN;
#   ceiling  3 <= W1_CLEANUP_RESERVE_SECONDS(20) - W1_CLEANUP_SECONDS(15),
#            so an observation that runs its full floor past the forward
#            boundary still leaves settlement its whole declared budget.
# The LIFECYCLE cap stays absolute: registration_remaining_observation
# _timeout never returns a deadline beyond W1_LIFECYCLE_DEADLINE_US, so a
# short total cap still caps observations. The floor is what a caller
# drives when the observation's expiry really is its subject.
W1_READY_SECONDS=10
W1_GATE_SECONDS=10
W1_CLEANUP_SECONDS=15
W1_REGISTRAR_SECONDS=30
W1_RECONCILE_SECONDS=10
W1_TOTAL_SECONDS=70
W1_CLEANUP_RESERVE_SECONDS=20
W1_OWNER_KILL_GRACE_US=100000
W1_OWNER_CENSUS_RESERVE_US=1000000
W1_OWNER_OBSERVATION_SECONDS=3
W1_CANCEL_STATUS=0
W1_RELEASE_CLOSED=0
W1_STATUS_CLOSED=0
W1_TERMINAL_PARENT_WRITE_CLOSED=0
W1_RECONCILE_ATTEMPTED=0
W1_RECONCILE_STATUS=NOT-ATTEMPTED
W1_RELAY_WAIT_ATTEMPTED=0
W1_RELAY_WAIT_OK=0
W1_RELAY_WAIT_STATUS=NOT-WAITED
W1_CLOCK_STATE=UNINITIALIZED
W1_LAST_NOW_US=""
W1_LIFECYCLE_INITIALIZED=0
W1_IN_SETTLEMENT=0
W1_FINISHING=0
W1_EXIT_GUARD_ACTIVE=0
W1_ACTIVE_OWNER_ROLE=""
W1_ACTIVE_OWNER_PID=""
W1_ACTIVE_OWNER_GROUP_READY=0
W1_ACTIVE_OWNER_RECEIPT="UNKNOWN"
W1_OWNER_SETTLING=0
W1_MEASUREMENT_REFUSAL_COUNT=0
W1_MEASUREMENT_REFUSAL_ROLE=""
declare -A W1_OWNER_RECEIPT_BY_PID=()
declare -A W1_OWNER_FDS_BY_PID=()
W1_GATE_ACQUIRED=0
W1_RELAY_ACQUIRED=0
W1_GATE_SETTLED_OK=0
W1_RELAY_SETTLED_OK=0
W1_GATE_WAIT_ATTEMPTED=0
: > "$RUNDIR/registration-owners.log"

registration_close_release() {{
    if [ "$W1_RELEASE_CLOSED" -eq 0 ] \
            && [[ "$W1_GATE_WRITE_FD" =~ ^[0-9]+$ ]]; then
        eval "exec $W1_GATE_WRITE_FD>&-"
        W1_RELEASE_CLOSED=1
    fi
}}

registration_close_status() {{
    if [ "$W1_STATUS_CLOSED" -eq 0 ]; then
        if [[ "$W1_GATE_READ_FD" =~ ^[0-9]+$ ]]; then
            eval "exec $W1_GATE_READ_FD<&-"
        fi
        if [[ "$W1_TERMINAL_READ_FD" =~ ^[0-9]+$ ]] \
                && [ "$W1_TERMINAL_READ_FD" != "$W1_GATE_READ_FD" ]; then
            eval "exec $W1_TERMINAL_READ_FD<&-"
        fi
        W1_STATUS_CLOSED=1
    fi
}}

registration_close_terminal_parent_writer() {{
    if [ "$W1_TERMINAL_PARENT_WRITE_CLOSED" -eq 0 ] \
            && [[ "$W1_TERMINAL_PARENT_WRITE_FD" =~ ^[0-9]+$ ]]; then
        eval "exec $W1_TERMINAL_PARENT_WRITE_FD>&-"
        W1_TERMINAL_PARENT_WRITE_CLOSED=1
    fi
}}

registration_handover_terminal_reader() {{
    if [[ "${{W1_GATE_READ_FD:-}}" =~ ^[0-9]+$ ]] \
            && [ "$W1_GATE_READ_FD" != "${{W1_TERMINAL_READ_FD:-}}" ]; then
        eval "exec $W1_GATE_READ_FD<&-"
    fi
    W1_GATE_READ_FD="${{W1_TERMINAL_READ_FD:-}}"
}}

registration_measurement_refusal() {{
    local W1_REFUSAL_ROLE="$1" W1_REFUSAL_REASON="$2"
    local W1_REFUSAL_CAPACITY="$3"
    W1_MEASUREMENT_REFUSAL_COUNT=$((W1_MEASUREMENT_REFUSAL_COUNT + 1))
    if [ "$W1_MEASUREMENT_REFUSAL_COUNT" -eq 1 ]; then
        W1_MEASUREMENT_REFUSAL_ROLE="$W1_REFUSAL_ROLE"
        builtin printf \
            'MEASUREMENT-REFUSED reason=%s role=%s capacity=%s\n' \
            "$W1_REFUSAL_REASON" "$W1_REFUSAL_ROLE" \
            "$W1_REFUSAL_CAPACITY" \
            > "$RUNDIR/measurement-refusal"
    fi
}}

registration_owner_fork_preflight() {{
    local W1_NPROC_LIMIT="" W1_NPROC_LABEL="" W1_NPROC_VALUE=""
    local W1_NPROC_CAPEFF="" W1_NPROC_PATH="" W1_NPROC_TOTAL=0
    local W1_NPROC_OWNED=0 W1_NPROC_RUN_QUEUE=""
    local W1_NPROC_LOAD1="" W1_NPROC_LOAD5="" W1_NPROC_LOAD15=""
    local W1_NPROC_LAST_PID=""
    local -a W1_NPROC_OWNED_TASKS=()
    W1_OWNER_FORK_CAPACITY=UNKNOWN

    # Bash exits 254 when a `coproc` fork gets EAGAIN; even `if ! coproc` cannot
    # catch it.  Read the kernel-enforced per-real-uid task ceiling entirely
    # with Bash builtins before crossing that irreversible edge.  On the
    # ordinary fleet limit, the cheap all-host task count is far below the
    # ceiling and no per-task status scan runs.
    ulimit -u > "$RUNDIR/registration-owner-nproc.limit" || return 1
    IFS= read -r W1_NPROC_LIMIT \
        < "$RUNDIR/registration-owner-nproc.limit" || return 1
    case "$W1_NPROC_LIMIT" in
        unlimited)
            W1_OWNER_FORK_CAPACITY=AVAILABLE
            return 0
            ;;
        ''|*[!0-9]*)
            return 1
            ;;
    esac
    # Linux exempts real uid 0 and tasks with CAP_SYS_ADMIN or
    # CAP_SYS_RESOURCE from RLIMIT_NPROC enforcement.
    [ "$UID" -eq 0 ] && {{ W1_OWNER_FORK_CAPACITY=AVAILABLE; return 0; }}
    while IFS=$' \t' read -r W1_NPROC_LABEL W1_NPROC_VALUE _; do
        if [ "$W1_NPROC_LABEL" = CapEff: ]; then
            W1_NPROC_CAPEFF="$W1_NPROC_VALUE"
            break
        fi
    done < /proc/self/status
    if [[ "$W1_NPROC_CAPEFF" =~ ^[0-9A-Fa-f]+$ ]] \
            && [ $((16#$W1_NPROC_CAPEFF \
                & ((1 << 21) | (1 << 24)))) -ne 0 ]; then
        W1_OWNER_FORK_CAPACITY=AVAILABLE
        return 0
    fi
    # The runner itself is one task owned by this real uid.  This lower bound
    # decides the deterministic RLIMIT_NPROC=1 control without walking /proc.
    if [ "$W1_NPROC_LIMIT" -le 1 ]; then
        W1_OWNER_FORK_CAPACITY=EXHAUSTED
        return 1
    fi

    # /proc/loadavg's fourth field is RUNNABLE/TOTAL scheduling entities.
    # TOTAL is an O(1), kernel-produced upper bound on this uid's task count;
    # expanding /proc/[pid]/task/[tid] here made every ordinary owner launch
    # walk the whole host and consumed the runner's own protocol deadlines.
    IFS=' ' read -r W1_NPROC_LOAD1 W1_NPROC_LOAD5 W1_NPROC_LOAD15 \
        W1_NPROC_RUN_QUEUE W1_NPROC_LAST_PID < /proc/loadavg || return 1
    case "$W1_NPROC_RUN_QUEUE" in
        */*) ;;
        *) return 1 ;;
    esac
    W1_NPROC_TOTAL="${{W1_NPROC_RUN_QUEUE#*/}}"
    case "$W1_NPROC_TOTAL" in
        ''|*[!0-9]*) return 1 ;;
    esac
    if [ "$W1_NPROC_TOTAL" -lt "$W1_NPROC_LIMIT" ]; then
        W1_OWNER_FORK_CAPACITY=AVAILABLE
        return 0
    fi

    # The host-wide count crossed the per-user ceiling, so derive the exact
    # effective-uid denominator using Bash's ownership predicate and task-dir
    # globs.  The remote runner is not setuid; if real and effective identity
    # ever differ, capacity is UNKNOWN and refusal is safer than raw exit 254.
    [ "$UID" -eq "$EUID" ] || return 1
    for W1_NPROC_PATH in /proc/[0-9]*; do
        [ -d "$W1_NPROC_PATH" ] && [ -O "$W1_NPROC_PATH" ] || continue
        W1_NPROC_OWNED_TASKS=("$W1_NPROC_PATH"/task/[0-9]*)
        for W1_NPROC_PATH in "${{W1_NPROC_OWNED_TASKS[@]}}"; do
            [ -d "$W1_NPROC_PATH" ] \
                && W1_NPROC_OWNED=$((W1_NPROC_OWNED + 1))
        done
    done
    if [ "$W1_NPROC_OWNED" -lt "$W1_NPROC_LIMIT" ]; then
        W1_OWNER_FORK_CAPACITY=AVAILABLE
        return 0
    fi
    W1_OWNER_FORK_CAPACITY=EXHAUSTED
    return 1
}}

registration_finish() {{
    [ "$BASHPID" = "$$" ] || return 1
    local W1_FINAL_STATUS="$1"
    if [ "$W1_FINAL_STATUS" -eq 94 ] \
            && ! {{ [ "$W1_GATE_ACQUIRED" -eq 1 ] \
                && [ "$W1_RELAY_ACQUIRED" -eq 1 ] \
                && [ "$W1_GATE_SETTLED_OK" -eq 1 ] \
                && [ "$W1_RELAY_SETTLED_OK" -eq 1 ]; }}; then
        echo "SETUP-CLASSIFICATION-DOWNGRADE requested=94 actual=92 gate_acquired=$W1_GATE_ACQUIRED gate_settled=$W1_GATE_SETTLED_OK relay_acquired=$W1_RELAY_ACQUIRED relay_settled=$W1_RELAY_SETTLED_OK primary_cancel=${{W1_CANCEL_STATUS:-0}}" \
            >> "$RUNDIR/jobid.err"
        W1_FINAL_STATUS=92
    fi
    if [ "${{W1_RELAY_WAIT_ATTEMPTED:-0}}" -eq 0 ] \
            && [[ "${{W1_TERMINAL_RELAY_PID:-}}" =~ ^[0-9]+$ ]]; then
        echo "TERMINAL-RELAY disposition=UNWAITED pid=$W1_TERMINAL_RELAY_PID" \
            >> "$RUNDIR/jobid.err"
    fi
    registration_close_release
    registration_close_terminal_parent_writer
    registration_close_status
    # Status 95 is a REFUSAL TO MEASURE, not another settlement verdict.  The
    # host has just refused the runner's own fork, so calling date/cat/git here
    # would require more forks and can replace this classification with Bash's
    # raw 254 (the deterministic RLIMIT_NPROC reproduction).  Preserve the
    # durable refusal and exit code using builtins only.  Closing every
    # authority descriptor above prevents the unreleased workload from
    # crossing the gate; no claim that the owners settled is made.
    if [ "$W1_FINAL_STATUS" -eq 95 ]; then
        builtin printf '%s\n' "$W1_FINAL_STATUS" > "$RUNDIR/exitcode"
        W1_FINISHING=1
        trap - EXIT
        exit "$W1_FINAL_STATUS"
    fi
    date +%s > "$RUNDIR/epoch_end"
    cat /proc/loadavg > "$RUNDIR/load_after" 2>&1
    git rev-parse HEAD > "$RUNDIR/head_after" 2>&1
    echo "$W1_FINAL_STATUS" > "$RUNDIR/exitcode"
    W1_FINISHING=1
    trap - EXIT
    exit "$W1_FINAL_STATUS"
}}

registration_on_cancel() {{
    if [ "$W1_CANCEL_STATUS" -eq 0 ]; then
        W1_CANCEL_STATUS="$1"
    fi
    registration_close_release
    registration_close_terminal_parent_writer
}}
trap 'registration_on_cancel 130' INT
trap 'registration_on_cancel 143' TERM
trap 'registration_on_cancel 129' HUP

registration_authority_fd_observation() {{
    local W1_FD_ROLE="$1" W1_FD_PID="$2" W1_FD_EXPECTED="$3"
    local W1_FD_OUT="$RUNDIR/registration-$W1_FD_ROLE-fd-observer.out"
    local W1_FD_ERR="$RUNDIR/registration-$W1_FD_ROLE-fd-observer.err"
    local -a W1_FD_ROWS=()
    registration_owner_run --observation \
        "$W1_FD_ROLE-fd-observer" "$W1_FD_OUT" \
        "$W1_FD_ERR" python3 -c {registration_probe} fds \
        "$W1_FD_PID" "$W1_FD_EXPECTED" || return 1
    [ "$W1_OWNER_STATUS" -eq 0 ] || return 1
    mapfile -t W1_FD_ROWS < "$W1_FD_OUT"
    [ "${{#W1_FD_ROWS[@]}}" -eq 1 ] \
        && [[ "${{W1_FD_ROWS[0]}}" == "FDS|$W1_FD_PID|"* ]] || return 1
    echo "AUTHORITY-FDS role=$W1_FD_ROLE ${{W1_FD_ROWS[0]}}" \
        >> "$RUNDIR/registration-authority-fds.log"
}}

registration_process_observation() {{
    local W1_OBSERVER_OUT="$RUNDIR/registration-process-observer.out"
    local W1_OBSERVER_ERR="$RUNDIR/registration-process-observer.err"
    local W1_OBSERVER_ROWS=()
    W1_PROCESS_OBSERVATION=UNKNOWN
    registration_owner_run --observation process-observer "$W1_OBSERVER_OUT" \
        "$W1_OBSERVER_ERR" bash -c 'python3 "$@"' _ \
        -c {registration_probe} process "$PYTEST_PID" \
        "/proc/$PYTEST_PID/stat" || return 1
    [ "$W1_OWNER_STATUS" -eq 0 ] || return 1
    mapfile -t W1_OBSERVER_ROWS < "$W1_OBSERVER_OUT"
    [ "${{#W1_OBSERVER_ROWS[@]}}" -eq 1 ] || return 1
    W1_PROCESS_OBSERVATION="${{W1_OBSERVER_ROWS[0]}}"
    registration_cancel_checkpoint "after-process-observer-owner"
    return 0
}}

registration_group_observation() {{
    [[ "${{PYTEST_PGID:-}}" =~ ^[0-9]+$ ]] || return 1
    local W1_OBSERVER_OUT="$RUNDIR/registration-group-observer.out"
    local W1_OBSERVER_ERR="$RUNDIR/registration-group-observer.err"
    local W1_OBSERVER_ROWS=()
    W1_GROUP_OBSERVATION=UNKNOWN
    registration_owner_run --observation group-observer "$W1_OBSERVER_OUT" \
        "$W1_OBSERVER_ERR" bash -c 'python3 "$@"' _ \
        -c {registration_probe} group "$PYTEST_PGID" /proc || return 1
    [ "$W1_OWNER_STATUS" -eq 0 ] || return 1
    mapfile -t W1_OBSERVER_ROWS < "$W1_OBSERVER_OUT"
    [ "${{#W1_OBSERVER_ROWS[@]}}" -eq 1 ] || return 1
    W1_GROUP_OBSERVATION="${{W1_OBSERVER_ROWS[0]}}"
    registration_cancel_checkpoint "after-group-observer-owner"
    return 0
}}

registration_monotonic_sample() {{
    local W1_UPTIME W1_UNUSED W1_UPTIME_SECONDS W1_UPTIME_FRACTION
    IFS=' ' read -r W1_UPTIME W1_UNUSED < /proc/uptime || return 1
    [[ "$W1_UPTIME" =~ ^[0-9]+\.[0-9]+$ ]] || return 1
    W1_UPTIME_SECONDS="${{W1_UPTIME%.*}}"
    W1_UPTIME_FRACTION="${{W1_UPTIME#*.}}000000"
    W1_UPTIME_FRACTION="${{W1_UPTIME_FRACTION:0:6}}"
    W1_CLOCK_SAMPLE_US=$((10#$W1_UPTIME_SECONDS * 1000000 \
        + 10#$W1_UPTIME_FRACTION))
}}

registration_now_us() {{
    if ! registration_monotonic_sample; then
        W1_CLOCK_STATE=UNKNOWN
        return 1
    fi
    if [ -n "$W1_LAST_NOW_US" ] \
            && [ "$W1_CLOCK_SAMPLE_US" -lt "$W1_LAST_NOW_US" ]; then
        W1_CLOCK_STATE=ROLLBACK
        return 1
    fi
    W1_LAST_NOW_US="$W1_CLOCK_SAMPLE_US"
    W1_NOW_US="$W1_CLOCK_SAMPLE_US"
    W1_CLOCK_STATE=OK
}}

registration_initialize_lifecycle_deadline() {{
    if ! registration_now_us; then
        return 1
    fi
    W1_LIFECYCLE_STARTED_US="$W1_NOW_US"
    W1_LIFECYCLE_DEADLINE_US=$((W1_LIFECYCLE_STARTED_US \
        + W1_TOTAL_SECONDS * 1000000))
    W1_FORWARD_DEADLINE_US=$((W1_LIFECYCLE_DEADLINE_US \
        - W1_CLEANUP_RESERVE_SECONDS * 1000000))
    if [ "$W1_FORWARD_DEADLINE_US" -lt "$W1_LIFECYCLE_STARTED_US" ]; then
        W1_FORWARD_DEADLINE_US="$W1_LIFECYCLE_STARTED_US"
    fi
    W1_ACTIVE_DEADLINE_US="$W1_FORWARD_DEADLINE_US"
    W1_LIFECYCLE_INITIALIZED=1
}}

registration_cap_deadline() {{
    local W1_CAP_SECONDS="$1" W1_LIMIT_US="$2" W1_PHASE_DEADLINE_US
    [ "$W1_LIFECYCLE_INITIALIZED" -eq 1 ] || return 1
    registration_now_us || return 1
    W1_PHASE_DEADLINE_US=$((W1_NOW_US + W1_CAP_SECONDS * 1000000))
    if [ "$W1_PHASE_DEADLINE_US" -lt "$W1_LIMIT_US" ]; then
        W1_ACTIVE_DEADLINE_US="$W1_PHASE_DEADLINE_US"
    else
        W1_ACTIVE_DEADLINE_US="$W1_LIMIT_US"
    fi
    [ "$W1_ACTIVE_DEADLINE_US" -gt "$W1_NOW_US" ]
}}

registration_begin_gate_deadline() {{
    registration_cap_deadline "$1" "$W1_FORWARD_DEADLINE_US"
}}

registration_begin_cleanup_deadline() {{
    registration_cap_deadline "$1" "$W1_LIFECYCLE_DEADLINE_US"
}}

registration_remaining_timeout() {{
    local W1_REMAINING_US
    registration_now_us || return 1
    W1_REMAINING_US=$((W1_ACTIVE_DEADLINE_US - W1_NOW_US))
    [ "$W1_REMAINING_US" -gt 0 ] || return 1
    printf -v W1_READ_TIMEOUT '%d.%06d' \
        $((W1_REMAINING_US / 1000000)) $((W1_REMAINING_US % 1000000))
}}

registration_remaining_owner_timeout() {{
    local W1_ADDITIONAL_RESERVE_US="${{1:-0}}"
    local W1_REMAINING_US W1_OWNER_US
    [[ "$W1_OWNER_KILL_GRACE_US" =~ ^[0-9]+$ ]] \
        && [ "$W1_OWNER_KILL_GRACE_US" -gt 0 ] || return 1
    [[ "$W1_ADDITIONAL_RESERVE_US" =~ ^[0-9]+$ ]] || return 1
    registration_now_us || return 1
    W1_REMAINING_US=$((W1_ACTIVE_DEADLINE_US - W1_NOW_US))
    [ "$W1_REMAINING_US" -gt $((W1_OWNER_KILL_GRACE_US \
        + W1_ADDITIONAL_RESERVE_US)) ] || return 1
    W1_OWNER_US=$((W1_REMAINING_US - W1_OWNER_KILL_GRACE_US \
        - W1_ADDITIONAL_RESERVE_US))
    printf -v W1_OWNER_TIMEOUT '%d.%06d' \
        $((W1_OWNER_US / 1000000)) $((W1_OWNER_US % 1000000))
    printf -v W1_OWNER_KILL_AFTER '%d.%06d' \
        $((W1_OWNER_KILL_GRACE_US / 1000000)) \
        $((W1_OWNER_KILL_GRACE_US % 1000000))
}}

registration_remaining_observation_timeout() {{
    # An OBSERVATION is a question, not a wait. Its bound must not be
    # whatever the forward phase happened to leave behind.
    local W1_OBSERVATION_RESERVE_US="${{1:-0}}"
    local W1_OBSERVATION_FLOOR_US W1_OBSERVATION_LIMIT_US W1_OBSERVATION_US
    [[ "$W1_OWNER_OBSERVATION_SECONDS" =~ ^[0-9]+$ ]] || return 1
    [[ "$W1_OWNER_KILL_GRACE_US" =~ ^[0-9]+$ ]] || return 1
    [ "$W1_OWNER_KILL_GRACE_US" -gt 0 ] || return 1
    [[ "$W1_OBSERVATION_RESERVE_US" =~ ^[0-9]+$ ]] || return 1
    [ "$W1_LIFECYCLE_INITIALIZED" -eq 1 ] || return 1
    registration_now_us || return 1
    W1_OBSERVATION_FLOOR_US=$((W1_OWNER_OBSERVATION_SECONDS * 1000000))
    W1_OBSERVATION_US=$((W1_ACTIVE_DEADLINE_US - W1_NOW_US \
        - W1_OWNER_KILL_GRACE_US - W1_OBSERVATION_RESERVE_US))
    if [ "$W1_OBSERVATION_US" -lt "$W1_OBSERVATION_FLOOR_US" ]; then
        W1_OBSERVATION_US="$W1_OBSERVATION_FLOOR_US"
    fi
    W1_OBSERVATION_LIMIT_US=$((W1_LIFECYCLE_DEADLINE_US - W1_NOW_US \
        - W1_OWNER_KILL_GRACE_US))
    if [ "$W1_OBSERVATION_US" -gt "$W1_OBSERVATION_LIMIT_US" ]; then
        W1_OBSERVATION_US="$W1_OBSERVATION_LIMIT_US"
    fi
    [ "$W1_OBSERVATION_US" -gt 0 ] || return 1
    printf -v W1_OWNER_TIMEOUT '%d.%06d' \
        $((W1_OBSERVATION_US / 1000000)) $((W1_OBSERVATION_US % 1000000))
    printf -v W1_OWNER_KILL_AFTER '%d.%06d' \
        $((W1_OWNER_KILL_GRACE_US / 1000000)) \
        $((W1_OWNER_KILL_GRACE_US % 1000000))
}}

registration_process_receipt() {{
    local W1_RECEIPT_PID="$1" W1_RECEIPT_ROW W1_RECEIPT_HEAD W1_RECEIPT_TAIL
    local -a W1_RECEIPT_FIELDS=()
    W1_PROCESS_RECEIPT="UNKNOWN"
    W1_PROCESS_STATE="UNKNOWN"
    [[ "$W1_RECEIPT_PID" =~ ^[0-9]+$ ]] || return 1
    if ! IFS= read -r W1_RECEIPT_ROW \
            2>/dev/null < "/proc/$W1_RECEIPT_PID/stat"; then
        [ ! -e "/proc/$W1_RECEIPT_PID" ] && W1_PROCESS_RECEIPT=ABSENT
        return 1
    fi
    [[ "$W1_RECEIPT_ROW" == *") "* ]] || return 1
    W1_RECEIPT_HEAD="${{W1_RECEIPT_ROW%% (*}}"
    W1_RECEIPT_TAIL="${{W1_RECEIPT_ROW##*) }}"
    read -r -a W1_RECEIPT_FIELDS <<< "$W1_RECEIPT_TAIL"
    [ "$W1_RECEIPT_HEAD" = "$W1_RECEIPT_PID" ] \
        && [ "${{#W1_RECEIPT_FIELDS[@]}}" -gt 19 ] || return 1
    W1_PROCESS_STATE="${{W1_RECEIPT_FIELDS[0]}}"
    W1_PROCESS_RECEIPT="$W1_RECEIPT_PID:${{W1_RECEIPT_FIELDS[1]}}:${{W1_RECEIPT_FIELDS[2]}}:${{W1_RECEIPT_FIELDS[3]}}:${{W1_RECEIPT_FIELDS[19]}}"
}}

registration_receipt_same_process() {{
    local W1_SAME_SAVED="$1" W1_SAME_CURRENT="$2"
    local -a W1_SAME_OLD=() W1_SAME_NEW=()
    IFS=: read -r -a W1_SAME_OLD <<< "$W1_SAME_SAVED"
    IFS=: read -r -a W1_SAME_NEW <<< "$W1_SAME_CURRENT"
    [ "${{#W1_SAME_OLD[@]}}" -eq 5 ] \
        && [ "${{#W1_SAME_NEW[@]}}" -eq 5 ] \
        && [ "${{W1_SAME_OLD[0]}}" = "${{W1_SAME_NEW[0]}}" ] \
        && [ "${{W1_SAME_OLD[1]}}" = "${{W1_SAME_NEW[1]}}" ] \
        && [ "${{W1_SAME_OLD[4]}}" = "${{W1_SAME_NEW[4]}}" ]
}}

registration_process_receipt_matches() {{
    local W1_MATCH_PID="$1" W1_MATCH_EXPECTED="$2"
    W1_OWNER_CURRENT_RECEIPT="UNKNOWN"
    if ! registration_process_receipt "$W1_MATCH_PID"; then
        W1_OWNER_CURRENT_RECEIPT="$W1_PROCESS_RECEIPT"
        return 1
    fi
    W1_OWNER_CURRENT_RECEIPT="$W1_PROCESS_RECEIPT"
    [ "$W1_PROCESS_RECEIPT" = "$W1_MATCH_EXPECTED" ] \
        && [[ "$W1_PROCESS_STATE" != Z && "$W1_PROCESS_STATE" != X ]]
}}

registration_child_group_is_leader() {{
    local W1_RECEIPT_PID="$1"
    local -a W1_RECEIPT_FIELDS=()
    W1_CHILD_GROUP_READY=0
    W1_CHILD_RECEIPT="UNKNOWN"
    registration_process_receipt "$W1_RECEIPT_PID" || return 1
    IFS=: read -r -a W1_RECEIPT_FIELDS <<< "$W1_PROCESS_RECEIPT"
    [ "${{W1_RECEIPT_FIELDS[2]}}" = "$W1_RECEIPT_PID" ] \
        && [[ "$W1_PROCESS_STATE" != Z && "$W1_PROCESS_STATE" != X ]] \
        || return 1
    W1_CHILD_GROUP_READY=1
    W1_CHILD_RECEIPT="$W1_PROCESS_RECEIPT"
}}

registration_owner_record() {{
    local W1_RECORD_ROLE="$1" W1_RECORD_OWNER_PID="$2"
    local W1_RECORD_WAITED_PID="$3" W1_RECORD_STATUS="$4"
    local W1_RECORD_WAIT_OK="$5" W1_RECORD_DESCENDANTS="$6"
    local W1_RECORD_STOP="${{7:-NONE}}"
    local W1_RECORD_GROUP_READY="${{8:-UNKNOWN}}"
    local W1_RECORD_RECEIPT="${{W1_OWNER_RECEIPT_BY_PID[$W1_RECORD_OWNER_PID]:-UNKNOWN}}"
    local W1_RECORD_FDS="${{W1_OWNER_FDS_BY_PID[$W1_RECORD_OWNER_PID]:-UNKNOWN}}"
    echo "OWNER role=$W1_RECORD_ROLE owner_pid=${{W1_RECORD_OWNER_PID:-MISSING}} waited_pid=${{W1_RECORD_WAITED_PID:-MISSING}} status=${{W1_RECORD_STATUS:-UNKNOWN}} wait_ok=$W1_RECORD_WAIT_OK descendants=$W1_RECORD_DESCENDANTS stop=$W1_RECORD_STOP group_ready=$W1_RECORD_GROUP_READY receipt=$W1_RECORD_RECEIPT current=${{W1_OWNER_CURRENT_RECEIPT:-NOT-APPLICABLE}} fds=$W1_RECORD_FDS term_at_us=${{W1_OWNER_TERM_AT_US:-NOT-APPLICABLE}} term_rc=${{W1_OWNER_TERM_RC:-NOT-APPLICABLE}} grace_us=${{W1_OWNER_GRACE_US:-NOT-APPLICABLE}} kill_at_us=${{W1_OWNER_KILL_AT_US:-NOT-APPLICABLE}} kill_rc=${{W1_OWNER_KILL_RC:-NOT-APPLICABLE}} primary_cancel=${{W1_CANCEL_STATUS:-0}}" \
        >> "$RUNDIR/registration-owners.log"
}}

registration_owner_term_grace() {{
    local W1_GRACE_START_US W1_GRACE_END_US W1_GRACE_TARGET_US
    registration_now_us || return 1
    W1_GRACE_START_US="$W1_NOW_US"
    W1_GRACE_TARGET_US=$((W1_GRACE_START_US + W1_OWNER_KILL_GRACE_US))
    W1_GRACE_END_US="$W1_GRACE_START_US"
    while [ "$W1_GRACE_END_US" -lt "$W1_GRACE_TARGET_US" ]; do
        registration_now_us || return 1
        W1_GRACE_END_US="$W1_NOW_US"
    done
    W1_GRACE_END_US="$W1_NOW_US"
    W1_OWNER_GRACE_US=$((W1_GRACE_END_US - W1_GRACE_START_US))
    [ "$W1_OWNER_GRACE_US" -ge "$W1_OWNER_KILL_GRACE_US" ]
}}

registration_owner_stop() {{
    local W1_STOP_PID="$1" W1_STOP_GROUP_READY="$2" W1_STOP_TARGET
    local W1_STOP_KIND=CHILD
    local W1_STOP_EXPECTED="${{W1_OWNER_RECEIPT_BY_PID[$W1_STOP_PID]:-UNKNOWN}}"
    [[ "$W1_STOP_PID" =~ ^[0-9]+$ ]] || return 1
    W1_OWNER_TERM_AT_US=UNKNOWN
    W1_OWNER_TERM_RC=NOT-SENT
    W1_OWNER_GRACE_US=UNKNOWN
    W1_OWNER_KILL_AT_US=UNKNOWN
    W1_OWNER_KILL_RC=NOT-SENT
    if ! registration_process_receipt_matches \
            "$W1_STOP_PID" "$W1_STOP_EXPECTED"; then
        W1_OWNER_STOP_DISPOSITION=PROCESS-RESTORATION-UNKNOWN
        return 1
    fi
    if [ "$W1_STOP_GROUP_READY" -eq 1 ]; then
        W1_STOP_TARGET="-$W1_STOP_PID"
        W1_STOP_KIND=GROUP
    else
        W1_STOP_TARGET="$W1_STOP_PID"
    fi
    registration_now_us && W1_OWNER_TERM_AT_US="$W1_NOW_US"
    builtin kill -TERM -- "$W1_STOP_TARGET" 2>/dev/null
    W1_OWNER_TERM_RC=$?
    if [ "$W1_OWNER_TERM_RC" -ne 0 ]; then
        W1_OWNER_STOP_DISPOSITION=PROCESS-RESTORATION-UNKNOWN
        return 1
    fi
    if ! registration_owner_term_grace; then
        case "$W1_CLOCK_STATE" in
            ROLLBACK|UNKNOWN)
                W1_OWNER_GRACE_US="UNAVAILABLE-$W1_CLOCK_STATE"
                ;;
            *)
                W1_OWNER_STOP_DISPOSITION=PROCESS-RESTORATION-UNKNOWN
                return 1
                ;;
        esac
    fi
    registration_now_us && W1_OWNER_KILL_AT_US="$W1_NOW_US"
    if registration_process_receipt_matches \
            "$W1_STOP_PID" "$W1_STOP_EXPECTED"; then
        builtin kill -KILL -- "$W1_STOP_TARGET" 2>/dev/null
        W1_OWNER_KILL_RC=$?
        if [ "$W1_OWNER_KILL_RC" -ne 0 ]; then
            W1_OWNER_STOP_DISPOSITION=PROCESS-RESTORATION-UNKNOWN
            return 1
        fi
        W1_OWNER_STOP_DISPOSITION="TERM-GRACE-KILL-$W1_STOP_KIND"
    elif [ "$W1_OWNER_CURRENT_RECEIPT" = ABSENT ]; then
        W1_OWNER_KILL_RC=SKIPPED-ABSENT
        W1_OWNER_STOP_DISPOSITION="TERM-GRACE-EXITED-$W1_STOP_KIND"
    else
        W1_OWNER_STOP_DISPOSITION=PROCESS-RESTORATION-UNKNOWN
        return 1
    fi
}}

registration_promote_spawn_group_receipt() {{
    local W1_PROMOTE_PID="$W1_SPAWN_PID"
    local W1_PROMOTE_LAUNCH="${{W1_OWNER_RECEIPT_BY_PID[$W1_PROMOTE_PID]:-UNKNOWN}}"
    local W1_PROMOTE_CLAIM=""
    local -a W1_PROMOTE_FIELDS=()
    if registration_process_receipt "$W1_PROMOTE_PID"; then
        if [ "$W1_PROMOTE_LAUNCH" != UNKNOWN ]; then
            registration_receipt_same_process \
                "$W1_PROMOTE_LAUNCH" "$W1_PROCESS_RECEIPT" || return 1
        fi
        IFS=: read -r -a W1_PROMOTE_FIELDS <<< "$W1_PROCESS_RECEIPT"
        if [ "${{W1_PROMOTE_FIELDS[1]}}" = "$W1_SPAWN_PARENT_PID" ] \
                && [ "${{W1_PROMOTE_FIELDS[2]}}" = "$W1_PROMOTE_PID" ] \
                && [ "${{W1_PROMOTE_FIELDS[3]}}" = "$W1_PROMOTE_PID" ] \
                && [[ "$W1_PROCESS_STATE" != Z && "$W1_PROCESS_STATE" != X ]]; then
            W1_OWNER_RECEIPT_BY_PID[$W1_PROMOTE_PID]="$W1_PROCESS_RECEIPT"
            W1_ACTIVE_OWNER_RECEIPT="$W1_PROCESS_RECEIPT"
            W1_ACTIVE_OWNER_GROUP_READY=1
            return 0
        fi
        [[ "$W1_PROCESS_STATE" == Z || "$W1_PROCESS_STATE" == X ]] \
            || return 1
    elif [ "$W1_PROCESS_RECEIPT" != ABSENT ]; then
        return 1
    fi

    # The trusted wrapper writes this receipt after setsid and before exec.  A
    # short command may become a zombie (or be reaped) before the parent can
    # reread /proc.  Bind that durable claim back to the pre-setsid launch
    # identity; never turn a missing or mismatched launch receipt into group
    # authority.
    [ "$W1_PROMOTE_LAUNCH" != UNKNOWN ] || return 1
    W1_PROMOTE_CLAIM="${{W1_SPAWN_READY_LINE#OWNER-READY v2 receipt=}}"
    W1_PROMOTE_CLAIM="${{W1_PROMOTE_CLAIM% fds=0,1,2}}"
    [ "$W1_SPAWN_READY_LINE" = \
        "OWNER-READY v2 receipt=$W1_PROMOTE_CLAIM fds=0,1,2" ] \
        || return 1
    [[ "$W1_PROMOTE_CLAIM" =~ ^[0-9]+(:[0-9]+){{4}}$ ]] || return 1
    registration_receipt_same_process \
        "$W1_PROMOTE_LAUNCH" "$W1_PROMOTE_CLAIM" || return 1
    IFS=: read -r -a W1_PROMOTE_FIELDS <<< "$W1_PROMOTE_CLAIM"
    [ "${{W1_PROMOTE_FIELDS[0]}}" = "$W1_PROMOTE_PID" ] \
        && [ "${{W1_PROMOTE_FIELDS[1]}}" = "$W1_SPAWN_PARENT_PID" ] \
        && [ "${{W1_PROMOTE_FIELDS[2]}}" = "$W1_PROMOTE_PID" ] \
        && [ "${{W1_PROMOTE_FIELDS[3]}}" = "$W1_PROMOTE_PID" ] \
        || return 1
    W1_OWNER_RECEIPT_BY_PID[$W1_PROMOTE_PID]="$W1_PROMOTE_CLAIM"
    W1_ACTIVE_OWNER_RECEIPT="$W1_PROMOTE_CLAIM"
    W1_ACTIVE_OWNER_GROUP_READY=1
}}

registration_owner_spawn() {{
    local W1_SPAWN_OBSERVATION=0
    while [ "${{1:-}}" = --observation ]; do
        W1_SPAWN_OBSERVATION=1
        shift
    done
    local W1_SPAWN_ROLE="$1" W1_SPAWN_OUT="$2" W1_SPAWN_ERR="$3"
    shift 3
    local W1_SPAWN_READY_LINE="" W1_SPAWN_EXTRA="" W1_SPAWN_EOF_RC
    local W1_SPAWN_SETTLEMENT_RESERVE="$W1_OWNER_CENSUS_RESERVE_US"
    W1_SPAWN_PID=""
    W1_SPAWN_READY_FD=""
    W1_SPAWN_INPUT_FD=""
    W1_SPAWN_RECEIPT="UNKNOWN"
    W1_SPAWN_FDS="UNKNOWN"
    W1_OWNER_STOP_DISPOSITION=SPAWN-FAILED
    W1_OWNER_CURRENT_RECEIPT=NOT-APPLICABLE
    W1_OWNER_TERM_AT_US=NOT-APPLICABLE
    W1_OWNER_TERM_RC=NOT-APPLICABLE
    W1_OWNER_GRACE_US=NOT-APPLICABLE
    W1_OWNER_KILL_AT_US=NOT-APPLICABLE
    W1_OWNER_KILL_RC=NOT-APPLICABLE
    [[ "$W1_SPAWN_ROLE" == *-census ]] \
        && W1_SPAWN_SETTLEMENT_RESERVE=0
    registration_cancel_checkpoint "before-$W1_SPAWN_ROLE-owner" || return 1
    if [ "$W1_SPAWN_OBSERVATION" -eq 1 ]; then
        registration_remaining_observation_timeout \
            "$W1_SPAWN_SETTLEMENT_RESERVE" || return 1
    else
        registration_remaining_owner_timeout \
            "$W1_SPAWN_SETTLEMENT_RESERVE" || return 1
    fi
    W1_SPAWN_TIMEOUT="$W1_OWNER_TIMEOUT"
    W1_SPAWN_KILL_AFTER="$W1_OWNER_KILL_AFTER"
    W1_SPAWN_PARENT_PID="$BASHPID"
    W1_SPAWN_CLOSE_FDS="${{W1_GATE_READ_FD:-}},${{W1_GATE_WRITE_FD:-}},${{W1_TERMINAL_READ_FD:-}},${{W1_TERMINAL_PARENT_WRITE_FD:-}}"
    unset W1_AUX_OWNER W1_AUX_OWNER_PID 2>/dev/null || :
    if ! registration_owner_fork_preflight; then
        registration_measurement_refusal "$W1_SPAWN_ROLE" \
            OWNER-SPAWN-FAILED "$W1_OWNER_FORK_CAPACITY"
        if [ -z "${{W1_JOB_ID:-}}" ]; then
            registration_owner_record "$W1_SPAWN_ROLE" MISSING MISSING \
                UNKNOWN 0 UNKNOWN SPAWN-FAILED 0
            registration_finish 95
        fi
        return 1
    fi
    if ! coproc W1_AUX_OWNER {{
            exec python3 -c {registration_timeout_owner} \
                "$W1_SPAWN_PARENT_PID" "$W1_SPAWN_CLOSE_FDS" \
                "$W1_SPAWN_OUT" "$W1_SPAWN_ERR" \
                timeout --kill-after="$W1_SPAWN_KILL_AFTER" \
                "$W1_SPAWN_TIMEOUT" "$@"
        }}; then
        registration_measurement_refusal \
            "$W1_SPAWN_ROLE" OWNER-SPAWN-FAILED RACE
        # Before registration there is no workload or durable job to
        # reconcile.  Refuse immediately: attempting the ordinary UNKNOWN
        # settlement would need the same owner fork that the host just denied.
        # The exact missing owner stays in the normal owner ledger, so this is
        # a proved fork-refusal precondition rather than a magic status.
        if [ -z "${{W1_JOB_ID:-}}" ]; then
            registration_owner_record "$W1_SPAWN_ROLE" MISSING MISSING \
                UNKNOWN 0 UNKNOWN SPAWN-FAILED 0
            registration_finish 95
        fi
        return 1
    fi
    W1_SPAWN_PID=${{W1_AUX_OWNER_PID:-}}
    W1_SPAWN_READY_FD=${{W1_AUX_OWNER[0]:-}}
    W1_SPAWN_INPUT_FD=${{W1_AUX_OWNER[1]:-}}
    if [[ "$W1_SPAWN_INPUT_FD" =~ ^[0-9]+$ ]]; then
        eval "exec $W1_SPAWN_INPUT_FD>&-"
    fi
    W1_ACTIVE_OWNER_ROLE="$W1_SPAWN_ROLE"
    W1_ACTIVE_OWNER_PID="$W1_SPAWN_PID"
    W1_ACTIVE_OWNER_GROUP_READY=0
    W1_ACTIVE_OWNER_RECEIPT=UNKNOWN
    if registration_process_receipt "$W1_SPAWN_PID"; then
        local -a W1_SPAWN_LAUNCH_FIELDS=()
        IFS=: read -r -a W1_SPAWN_LAUNCH_FIELDS <<< "$W1_PROCESS_RECEIPT"
        if [ "${{W1_SPAWN_LAUNCH_FIELDS[1]}}" = "$W1_SPAWN_PARENT_PID" ]; then
            W1_SPAWN_RECEIPT="$W1_PROCESS_RECEIPT"
            W1_OWNER_RECEIPT_BY_PID[$W1_SPAWN_PID]="$W1_SPAWN_RECEIPT"
            W1_OWNER_FDS_BY_PID[$W1_SPAWN_PID]=UNKNOWN
            W1_ACTIVE_OWNER_RECEIPT="$W1_SPAWN_RECEIPT"
        fi
    fi
    if ! IFS= read -r -t "$W1_SPAWN_TIMEOUT" W1_SPAWN_READY_LINE \
            <&"$W1_SPAWN_READY_FD"; then
        eval "exec $W1_SPAWN_READY_FD<&-"
        registration_promote_spawn_group_receipt || :
        registration_owner_stop "$W1_SPAWN_PID" \
            "$W1_ACTIVE_OWNER_GROUP_READY"
        return 1
    fi
    registration_promote_spawn_group_receipt || :
    IFS= read -r -t "$W1_SPAWN_TIMEOUT" W1_SPAWN_EXTRA \
        <&"$W1_SPAWN_READY_FD"
    W1_SPAWN_EOF_RC=$?
    eval "exec $W1_SPAWN_READY_FD<&-"
    if [ "$W1_SPAWN_READY_LINE" != \
            "OWNER-READY v2 receipt=${{W1_OWNER_RECEIPT_BY_PID[$W1_SPAWN_PID]:-UNKNOWN}} fds=0,1,2" ] \
            || [ "$W1_SPAWN_EOF_RC" -ne 1 ]; then
        registration_owner_stop "$W1_SPAWN_PID" \
            "$W1_ACTIVE_OWNER_GROUP_READY"
        return 1
    fi
    W1_SPAWN_FDS=0,1,2
    W1_OWNER_FDS_BY_PID[$W1_SPAWN_PID]="$W1_SPAWN_FDS"
    return 0
}}

registration_owned_group_census() {{
    local W1_CENSUS_ROLE="$1" W1_CENSUS_PGID="$2"
    local W1_CENSUS_OUT="$RUNDIR/registration-$W1_CENSUS_ROLE-census.out"
    local W1_CENSUS_ERR="$RUNDIR/registration-$W1_CENSUS_ROLE-census.err"
    local -a W1_CENSUS_ROWS=()
    W1_OWNED_GROUP_STATUS=UNKNOWN
    [[ "$W1_CENSUS_PGID" =~ ^[0-9]+$ ]] || return 1
    if ! registration_owner_run --no-census --observation \
            "$W1_CENSUS_ROLE-census" "$W1_CENSUS_OUT" "$W1_CENSUS_ERR" \
            python3 -c {registration_probe} group \
            "$W1_CENSUS_PGID" /proc; then
        return 1
    fi
    [ "$W1_OWNER_STATUS" -eq 0 ] || return 1
    mapfile -t W1_CENSUS_ROWS < "$W1_CENSUS_OUT"
    [ "${{#W1_CENSUS_ROWS[@]}}" -eq 1 ] || return 1
    case "${{W1_CENSUS_ROWS[0]}}" in
        ABSENT|UNKNOWN|PRESENT\|*)
            W1_OWNED_GROUP_STATUS="${{W1_CENSUS_ROWS[0]%%|*}}"
            ;;
        *)
            return 1
            ;;
    esac
}}

registration_owner_collect() {{
    local W1_COLLECT_ROLE="$1" W1_COLLECT_PID="$2"
    local W1_COLLECT_GROUP_READY="$3"
    local W1_COLLECT_INITIAL_STOP="${{4:-NONE}}"
    local W1_COLLECT_CENSUS_POLICY="${{5:-REQUIRED}}"
    local W1_COLLECT_WAIT_ERR="$RUNDIR/registration-owner-$W1_COLLECT_ROLE.wait.err"
    local W1_COLLECT_SECOND_PID="" W1_COLLECT_SECOND_STATUS
    local W1_COLLECT_WAITED_PID="" W1_COLLECT_STATUS=UNKNOWN
    local W1_COLLECT_WAIT_OK=0 W1_COLLECT_DESCENDANTS=UNKNOWN
    local W1_COLLECT_STOP_DISPOSITION="$W1_COLLECT_INITIAL_STOP"
    local W1_COLLECT_CURRENT_RECEIPT=NOT-APPLICABLE
    local W1_COLLECT_TERM_AT_US=NOT-APPLICABLE
    local W1_COLLECT_TERM_RC=NOT-APPLICABLE
    local W1_COLLECT_GRACE_US=NOT-APPLICABLE
    local W1_COLLECT_KILL_AT_US=NOT-APPLICABLE
    local W1_COLLECT_KILL_RC=NOT-APPLICABLE
    W1_OWNER_WAITED_PID=""
    W1_OWNER_STATUS=UNKNOWN
    W1_OWNER_WAIT_OK=0
    W1_OWNER_DESCENDANTS=UNKNOWN
    W1_OWNER_STOP_DISPOSITION="$W1_COLLECT_INITIAL_STOP"
    : > "$W1_COLLECT_WAIT_ERR"
    wait -p W1_OWNER_WAITED_PID "$W1_COLLECT_PID" \
        2> "$W1_COLLECT_WAIT_ERR"
    W1_OWNER_STATUS=$?
    if [ "${{W1_OWNER_WAITED_PID:-}}" != "$W1_COLLECT_PID" ]; then
        registration_owner_stop "$W1_COLLECT_PID" "$W1_COLLECT_GROUP_READY"
        wait -p W1_COLLECT_SECOND_PID "$W1_COLLECT_PID" \
            2>> "$W1_COLLECT_WAIT_ERR"
        W1_COLLECT_SECOND_STATUS=$?
        if [ "${{W1_COLLECT_SECOND_PID:-}}" = "$W1_COLLECT_PID" ]; then
            W1_OWNER_WAITED_PID="$W1_COLLECT_SECOND_PID"
            W1_OWNER_STATUS="$W1_COLLECT_SECOND_STATUS"
        fi
    fi
    if [ "${{W1_OWNER_WAITED_PID:-}}" = "$W1_COLLECT_PID" ]; then
        W1_OWNER_WAIT_OK=1
    fi
    W1_COLLECT_WAITED_PID="${{W1_OWNER_WAITED_PID:-}}"
    W1_COLLECT_STATUS="$W1_OWNER_STATUS"
    W1_COLLECT_WAIT_OK="$W1_OWNER_WAIT_OK"
    W1_COLLECT_STOP_DISPOSITION="$W1_OWNER_STOP_DISPOSITION"
    W1_COLLECT_CURRENT_RECEIPT="${{W1_OWNER_CURRENT_RECEIPT:-NOT-APPLICABLE}}"
    W1_COLLECT_TERM_AT_US="${{W1_OWNER_TERM_AT_US:-NOT-APPLICABLE}}"
    W1_COLLECT_TERM_RC="${{W1_OWNER_TERM_RC:-NOT-APPLICABLE}}"
    W1_COLLECT_GRACE_US="${{W1_OWNER_GRACE_US:-NOT-APPLICABLE}}"
    W1_COLLECT_KILL_AT_US="${{W1_OWNER_KILL_AT_US:-NOT-APPLICABLE}}"
    W1_COLLECT_KILL_RC="${{W1_OWNER_KILL_RC:-NOT-APPLICABLE}}"
    W1_OWNER_SETTLING=$((W1_OWNER_SETTLING + 1))
    if [ "$W1_COLLECT_CENSUS_POLICY" = NOT-APPLICABLE ]; then
        W1_COLLECT_DESCENDANTS=NOT-APPLICABLE
    elif [ "$W1_COLLECT_GROUP_READY" -eq 1 ] \
            && registration_owned_group_census \
                "$W1_COLLECT_ROLE" "$W1_COLLECT_PID"; then
        W1_COLLECT_DESCENDANTS="$W1_OWNED_GROUP_STATUS"
    else
        W1_COLLECT_DESCENDANTS=UNKNOWN
    fi
    W1_OWNER_CURRENT_RECEIPT="$W1_COLLECT_CURRENT_RECEIPT"
    W1_OWNER_TERM_AT_US="$W1_COLLECT_TERM_AT_US"
    W1_OWNER_TERM_RC="$W1_COLLECT_TERM_RC"
    W1_OWNER_GRACE_US="$W1_COLLECT_GRACE_US"
    W1_OWNER_KILL_AT_US="$W1_COLLECT_KILL_AT_US"
    W1_OWNER_KILL_RC="$W1_COLLECT_KILL_RC"
    registration_owner_record "$W1_COLLECT_ROLE" "$W1_COLLECT_PID" \
        "${{W1_COLLECT_WAITED_PID:-MISSING}}" "$W1_COLLECT_STATUS" \
        "$W1_COLLECT_WAIT_OK" "$W1_COLLECT_DESCENDANTS" \
        "$W1_COLLECT_STOP_DISPOSITION" "$W1_COLLECT_GROUP_READY"
    W1_OWNER_WAITED_PID="$W1_COLLECT_WAITED_PID"
    W1_OWNER_STATUS="$W1_COLLECT_STATUS"
    W1_OWNER_WAIT_OK="$W1_COLLECT_WAIT_OK"
    W1_OWNER_DESCENDANTS="$W1_COLLECT_DESCENDANTS"
    W1_OWNER_STOP_DISPOSITION="$W1_COLLECT_STOP_DISPOSITION"
    W1_OWNER_SETTLING=$((W1_OWNER_SETTLING - 1))
    W1_ACTIVE_OWNER_ROLE=""
    W1_ACTIVE_OWNER_PID=""
    W1_ACTIVE_OWNER_GROUP_READY=0
    W1_ACTIVE_OWNER_RECEIPT="UNKNOWN"
    unset 'W1_OWNER_RECEIPT_BY_PID[$W1_COLLECT_PID]' \
        'W1_OWNER_FDS_BY_PID[$W1_COLLECT_PID]' 2>/dev/null || :
    [ "$W1_OWNER_WAIT_OK" -eq 1 ] \
        && {{ [ "$W1_COLLECT_CENSUS_POLICY" = NOT-APPLICABLE ] \
            || [ "$W1_OWNER_DESCENDANTS" = ABSENT ]; }}
}}

registration_owner_run() {{
    local W1_RUN_CENSUS_POLICY=REQUIRED
    local -a W1_RUN_SPAWN_FLAGS=()
    while :; do
        case "${{1:-}}" in
            --no-census)
                W1_RUN_CENSUS_POLICY=NOT-APPLICABLE
                shift
                ;;
            --observation)
                W1_RUN_SPAWN_FLAGS+=(--observation)
                shift
                ;;
            *)
                break
                ;;
        esac
    done
    local W1_RUN_ROLE="$1" W1_RUN_OUT="$2" W1_RUN_ERR="$3"
    shift 3
    if ! registration_owner_spawn "${{W1_RUN_SPAWN_FLAGS[@]}}" \
            "$W1_RUN_ROLE" "$W1_RUN_OUT" \
            "$W1_RUN_ERR" "$@"; then
        local W1_RUN_PID="${{W1_SPAWN_PID:-MISSING}}"
        if [[ "$W1_RUN_PID" =~ ^[0-9]+$ ]]; then
            registration_owner_collect "$W1_RUN_ROLE" "$W1_RUN_PID" \
                "${{W1_ACTIVE_OWNER_GROUP_READY:-0}}" \
                "${{W1_OWNER_STOP_DISPOSITION:-SPAWN-FAILED}}" \
                "$W1_RUN_CENSUS_POLICY" || :
        else
            registration_owner_record "$W1_RUN_ROLE" MISSING MISSING \
                UNKNOWN 0 UNKNOWN SPAWN-FAILED 0
        fi
        W1_SPAWN_PID="$W1_RUN_PID"
        return 1
    fi
    local W1_RUN_PID="$W1_SPAWN_PID" W1_RUN_COLLECT_RC
    registration_owner_collect "$W1_RUN_ROLE" "$W1_RUN_PID" 1 NONE \
        "$W1_RUN_CENSUS_POLICY"
    W1_RUN_COLLECT_RC=$?
    W1_SPAWN_PID="$W1_RUN_PID"
    W1_OWNER_CANCEL_AFTER="$W1_CANCEL_STATUS"
    return "$W1_RUN_COLLECT_RC"
}}

registration_checked_child_wait() {{
    local W1_CHILD_ROLE="$1" W1_CHILD_PID="$2" W1_CHILD_EXPECTED="$3"
    local W1_TIMER_OUT="$RUNDIR/registration-$W1_CHILD_ROLE-deadline.out"
    local W1_TIMER_ERR="$RUNDIR/registration-$W1_CHILD_ROLE-deadline.err"
    local W1_CHILD_WAIT_ERR="$RUNDIR/registration-$W1_CHILD_ROLE-wait.err"
    local W1_TIMER_PID W1_RACE_WAITED_PID="" W1_RACE_STATUS
    local W1_TIMER_STOP=NONE W1_TIMER_DESCENDANTS=UNKNOWN
    local W1_CHILD_GROUP_READY=0 W1_CHILD_STOP=NONE
    W1_CHILD_WAITED_PID=""
    W1_CHILD_WAIT_STATUS=UNKNOWN
    W1_CHILD_WAIT_OK=0
    W1_CHILD_GROUP_STATUS=UNKNOWN
    [ "$W1_CHILD_ROLE" = gate ] \
        && W1_CHILD_WAIT_ERR="$RUNDIR/registration-wait.err"
    [ "$W1_CHILD_ROLE" = terminal-relay ] \
        && W1_CHILD_WAIT_ERR="$RUNDIR/registration-relay-wait.err"
    case "$W1_CHILD_ROLE" in
        gate)
            W1_CHILD_GROUP_READY="${{W1_GATE_GROUP_READY_AT_ACQUIRE:-0}}"
            ;;
        terminal-relay)
            W1_CHILD_GROUP_READY="${{W1_RELAY_GROUP_READY_AT_ACQUIRE:-0}}"
            ;;
    esac
    if ! [[ "$W1_CHILD_PID" =~ ^[0-9]+$ ]]; then
        registration_owner_record "$W1_CHILD_ROLE" MISSING MISSING \
            UNKNOWN 0 UNKNOWN PID-MISSING 0
        return 1
    fi
    registration_cancel_checkpoint "before-$W1_CHILD_ROLE-wait"
    if ! registration_owner_spawn "$W1_CHILD_ROLE-deadline" \
            "$W1_TIMER_OUT" "$W1_TIMER_ERR" \
            python3 -c 'import time; time.sleep(86400)'; then
        W1_TIMER_PID="${{W1_SPAWN_PID:-MISSING}}"
        if [[ "$W1_TIMER_PID" =~ ^[0-9]+$ ]]; then
            registration_owner_collect "$W1_CHILD_ROLE-deadline" \
                "$W1_TIMER_PID" "${{W1_ACTIVE_OWNER_GROUP_READY:-0}}" \
                "${{W1_OWNER_STOP_DISPOSITION:-SPAWN-FAILED}}" || :
        fi
        registration_owner_record "$W1_CHILD_ROLE" "$W1_CHILD_PID" \
            MISSING UNKNOWN 0 UNKNOWN DEADLINE-SPAWN-FAILED \
            "$W1_CHILD_GROUP_READY"
        return 1
    fi
    W1_TIMER_PID="$W1_SPAWN_PID"
    : > "$W1_CHILD_WAIT_ERR"
    wait -n -p W1_RACE_WAITED_PID "$W1_CHILD_PID" "$W1_TIMER_PID" \
        2> "$W1_CHILD_WAIT_ERR"
    W1_RACE_STATUS=$?
    W1_OWNER_SETTLING=$((W1_OWNER_SETTLING + 1))
    if [ "${{W1_RACE_WAITED_PID:-}}" = "$W1_CHILD_PID" ]; then
        W1_CHILD_WAITED_PID="$W1_RACE_WAITED_PID"
        W1_CHILD_WAIT_STATUS="$W1_RACE_STATUS"
        registration_owner_stop "$W1_TIMER_PID" 1
        W1_TIMER_STOP="$W1_OWNER_STOP_DISPOSITION"
        registration_owner_collect "$W1_CHILD_ROLE-deadline" \
            "$W1_TIMER_PID" 1 "$W1_TIMER_STOP" || :
    elif [ "${{W1_RACE_WAITED_PID:-}}" = "$W1_TIMER_PID" ]; then
        if registration_owned_group_census \
                "$W1_CHILD_ROLE-deadline" "$W1_TIMER_PID"; then
            W1_TIMER_DESCENDANTS="$W1_OWNED_GROUP_STATUS"
        fi
        registration_owner_record "$W1_CHILD_ROLE-deadline" \
            "$W1_TIMER_PID" "$W1_TIMER_PID" "$W1_RACE_STATUS" 1 \
            "$W1_TIMER_DESCENDANTS" DEADLINE-EXPIRED 1
        W1_ACTIVE_OWNER_ROLE=""
        W1_ACTIVE_OWNER_PID=""
        W1_ACTIVE_OWNER_GROUP_READY=0
        W1_CHILD_STOP=RETAINED-LIVE
    else
        registration_owner_stop "$W1_TIMER_PID" 1
        W1_TIMER_STOP="$W1_OWNER_STOP_DISPOSITION"
        registration_owner_collect "$W1_CHILD_ROLE-deadline" \
            "$W1_TIMER_PID" 1 "$W1_TIMER_STOP" || :
    fi
    if [ "${{W1_CHILD_WAITED_PID:-}}" = "$W1_CHILD_PID" ]; then
        if [ "$W1_CHILD_GROUP_READY" -eq 1 ] \
                && registration_owned_group_census \
                    "$W1_CHILD_ROLE" "$W1_CHILD_PID"; then
            W1_CHILD_GROUP_STATUS="$W1_OWNED_GROUP_STATUS"
        fi
        if {{ [ "$W1_CHILD_EXPECTED" = ANY ] \
                || [ "$W1_CHILD_WAIT_STATUS" -eq "$W1_CHILD_EXPECTED" ]; }} \
                && [ "$W1_CHILD_GROUP_STATUS" = ABSENT ]; then
            W1_CHILD_WAIT_OK=1
        fi
    fi
    registration_owner_record "$W1_CHILD_ROLE" "$W1_CHILD_PID" \
        "${{W1_CHILD_WAITED_PID:-MISSING}}" "$W1_CHILD_WAIT_STATUS" \
        "$W1_CHILD_WAIT_OK" "$W1_CHILD_GROUP_STATUS" "$W1_CHILD_STOP" \
        "$W1_CHILD_GROUP_READY"
    case "$W1_CHILD_ROLE" in
        gate)
            W1_GATE_WAIT_STATUS="$W1_CHILD_WAIT_STATUS"
            W1_GATE_GROUP_STATUS="$W1_CHILD_GROUP_STATUS"
            W1_GATE_SETTLED_OK="$W1_CHILD_WAIT_OK"
            ;;
        terminal-relay)
            W1_RELAY_WAIT_STATUS="$W1_CHILD_WAIT_STATUS"
            W1_RELAY_GROUP_STATUS="$W1_CHILD_GROUP_STATUS"
            W1_RELAY_WAITED_PID="$W1_CHILD_WAITED_PID"
            W1_RELAY_WAIT_OK="$W1_CHILD_WAIT_OK"
            W1_RELAY_WAIT_ATTEMPTED=1
            W1_RELAY_SETTLED_OK="$W1_CHILD_WAIT_OK"
            ;;
    esac
    W1_OWNER_SETTLING=$((W1_OWNER_SETTLING - 1))
    [ "$W1_CHILD_WAIT_OK" -eq 1 ]
}}

registration_read_channel() {{
    local W1_CHANNEL_FD="$1" W1_CHANNEL_MODE="$2"
    local W1_CHANNEL_EXPECTED_PID="${{3:-0}}" W1_CHANNEL_RC
    local W1_CHANNEL_ROLE="$W1_CHANNEL_MODE-reader"
    local W1_CHANNEL_OUTPUT="$RUNDIR/registration-$W1_CHANNEL_ROLE.out"
    local W1_CHANNEL_ERROR="$RUNDIR/registration-$W1_CHANNEL_ROLE.err"
    local W1_CHANNEL_INNER_TIMEOUT
    local W1_CHANNEL_ROWS=()
    W1_FRAME=""
    W1_FRAME_HEX=""
    W1_FRAME_BYTE_LINE=0
    W1_FRAME_CLASS=IO_ERROR
    W1_CHANNEL_STATE=TIMEOUT
    if ! [[ "$W1_CHANNEL_FD" =~ ^[0-9]+$ ]] \
            || ! registration_remaining_owner_timeout \
                "$W1_OWNER_CENSUS_RESERVE_US"; then
        W1_FRAME_RC=142
        return 1
    fi
    W1_CHANNEL_INNER_TIMEOUT="$W1_OWNER_TIMEOUT"
    if ! registration_owner_run "$W1_CHANNEL_ROLE" "$W1_CHANNEL_OUTPUT" \
            "$W1_CHANNEL_ERROR" python3 -c {registration_channel_reader} \
            "/proc/$$/fd/$W1_CHANNEL_FD" "$W1_CHANNEL_INNER_TIMEOUT" \
            "$W1_CHANNEL_MODE" "$W1_CHANNEL_EXPECTED_PID"; then
        W1_FRAME_RC=142
        return 1
    fi
    W1_CHANNEL_RC="$W1_OWNER_STATUS"
    if [ "$W1_CHANNEL_RC" -ne 0 ]; then
        W1_FRAME_RC=142
        return 1
    fi
    mapfile -t W1_CHANNEL_ROWS < "$W1_CHANNEL_OUTPUT"
    if [ "${{#W1_CHANNEL_ROWS[@]}}" -ne 5 ] \
            || [[ "${{W1_CHANNEL_ROWS[0]}}" != S:* ]] \
            || [[ "${{W1_CHANNEL_ROWS[1]}}" != H:* ]] \
            || [[ "${{W1_CHANNEL_ROWS[2]}}" != D:* ]] \
            || [[ "${{W1_CHANNEL_ROWS[3]}}" != A:* ]] \
            || [[ "${{W1_CHANNEL_ROWS[4]}}" != C:* ]]; then
        W1_CHANNEL_STATE=ERROR-READER
        W1_FRAME_RC=1
        return 1
    fi
    W1_CHANNEL_STATE="${{W1_CHANNEL_ROWS[0]#S:}}"
    W1_FRAME_HEX="${{W1_CHANNEL_ROWS[1]#H:}}"
    W1_FRAME="${{W1_CHANNEL_ROWS[2]#D:}}"
    W1_FRAME_BYTE_LINE="${{W1_CHANNEL_ROWS[3]#A:}}"
    W1_FRAME_CLASS="${{W1_CHANNEL_ROWS[4]#C:}}"
    case "$W1_FRAME_CLASS" in
        READY|EXEC_OK|EXEC_FAIL|ABORTED)
            W1_FRAME_RC=0
            return 0
            ;;
        TIMEOUT)
            W1_FRAME_RC=142
            ;;
        *)
            W1_FRAME_RC=1
            ;;
    esac
    if [ "$W1_CHANNEL_STATE" = EOF ] \
            && [ "$W1_FRAME_CLASS" != INVALID ]; then
        W1_FRAME_RC=0
        return 0
    fi
    return 1
}}

registration_read_until_deadline() {{
    registration_read_channel "$W1_GATE_READ_FD" terminal 0
}}

registration_read_frame() {{
    registration_begin_gate_deadline "${{1:-$W1_GATE_SECONDS}}" || :
    registration_read_channel "$W1_GATE_READ_FD" ready "$PYTEST_GATE_PID"
}}

registration_read_terminal() {{
    registration_read_channel "$W1_GATE_READ_FD" terminal 0
    W1_TERMINAL_FRAME="$W1_FRAME"
    W1_TERMINAL_CLASS="$W1_FRAME_CLASS"
    W1_TERMINAL_FRAME_RC="$W1_FRAME_RC"
    W1_TERMINAL_EOF=0
    [ "$W1_CHANNEL_STATE" = EOF ] && W1_TERMINAL_EOF=1
    W1_TRAILING_FRAME_COUNT=0
    [ "$W1_FRAME_BYTE_LINE" -eq 1 ] || W1_TRAILING_FRAME_COUNT=1
    W1_FRAME="$W1_TERMINAL_FRAME"
    W1_FRAME_RC="$W1_TERMINAL_FRAME_RC"
    W1_TERMINAL_RELAY_OK=0
    if [ "$W1_TERMINAL_EOF" -eq 1 ] \
            && registration_checked_terminal_relay_wait; then
        W1_TERMINAL_RELAY_OK=1
    fi
    registration_cancel_checkpoint "after-terminal-owner-settlement"
}}

registration_checked_terminal_relay_wait() {{
    local W1_RELAY_CHECK_RC
    if [ "$W1_RELAY_WAIT_ATTEMPTED" -ne 0 ]; then
        [ "$W1_RELAY_WAIT_OK" -eq 1 ]
        return
    fi
    registration_checked_child_wait terminal-relay \
        "$W1_TERMINAL_RELAY_PID" 0
    W1_RELAY_CHECK_RC=$?
    [ "$W1_RELAY_CHECK_RC" -eq 0 ] && W1_TERMINAL_RELAY_OK=1
    registration_cancel_checkpoint "after-terminal-relay-wait"
    return "$W1_RELAY_CHECK_RC"
}}

registration_checked_gate_wait() {{
    local W1_EXPECTED_STATUS="$1"
    if [ "$W1_GATE_WAIT_ATTEMPTED" -ne 0 ]; then
        [ "$W1_GATE_SETTLED_OK" -eq 1 ] \
            && {{ [ "$W1_EXPECTED_STATUS" = ANY ] \
                || [ "$W1_GATE_WAIT_STATUS" -eq "$W1_EXPECTED_STATUS" ]; }}
        return
    fi
    W1_GATE_WAIT_ATTEMPTED=1
    registration_checked_child_wait gate "$PYTEST_GATE_PID" \
        "$W1_EXPECTED_STATUS"
    local W1_GATE_CHECK_RC=$?
    registration_cancel_checkpoint "after-gate-wait"
    return "$W1_GATE_CHECK_RC"
}}

registration_observation_matches_original() {{
    W1_PROCESS_OBSERVATION=UNKNOWN
    registration_process_observation 2>/dev/null || :
    W1_CURRENT_OBSERVATION="$W1_PROCESS_OBSERVATION"
    [[ "$W1_CURRENT_OBSERVATION" == OBSERVED\|*\|* ]] || return 1
    W1_CURRENT_PAYLOAD="${{W1_CURRENT_OBSERVATION#OBSERVED|}}"
    W1_CURRENT_RECEIPT="${{W1_CURRENT_PAYLOAD%|*}}"
    W1_CURRENT_STATE="${{W1_CURRENT_PAYLOAD##*|}}"
    [ "$W1_CURRENT_RECEIPT" = "$PYTEST_ORIGINAL_RECEIPT" ] \
        && [[ "$W1_CURRENT_STATE" != Z && "$W1_CURRENT_STATE" != X ]]
}}

registration_settle_abort() {{
    local W1_SETTLED_STATUS="$1"
    local W1_FALLBACK_STATUS="$2"
    local W1_ABORT_CONTEXT="$3"
    W1_IN_SETTLEMENT=1
    registration_begin_cleanup_deadline "$W1_CLEANUP_SECONDS" || :
    registration_close_release
    registration_read_terminal
    W1_ABORT_FRAME="$W1_FRAME"
    W1_ABORT_CLASS="$W1_FRAME_CLASS"
    W1_ABORT_FRAME_RC="$W1_FRAME_RC"
    W1_ABORT_PROTOCOL=0
    W1_ABORT_WAIT=0
    if [ "$W1_ABORT_FRAME_RC" -eq 0 ] \
            && [ "$W1_ABORT_CLASS" = ABORTED ] \
            && [ "$W1_TERMINAL_EOF" -eq 1 ] \
            && [ "$W1_TERMINAL_RELAY_OK" -eq 1 ] \
            && [ "$W1_TRAILING_FRAME_COUNT" -eq 0 ]; then
        W1_ABORT_PROTOCOL=1
        if registration_checked_gate_wait 0; then
            W1_ABORT_WAIT=1
        fi
    elif [ "$W1_TERMINAL_EOF" -eq 1 ] \
            && [ "$W1_TERMINAL_RELAY_OK" -eq 1 ] \
            && registration_checked_gate_wait ANY; then
        W1_ABORT_WAIT=1
    fi
    echo "REGISTER-GATE-ABORT context=$W1_ABORT_CONTEXT release_writes=${{W1_RELEASE_WRITE_COUNT:-0}} frame_rc=$W1_ABORT_FRAME_RC frame=$W1_ABORT_FRAME frame_hex=$W1_FRAME_HEX eof=$W1_TERMINAL_EOF relay_wait=${{W1_RELAY_WAIT_STATUS:-UNKNOWN}} wait=${{W1_GATE_WAIT_STATUS:-UNKNOWN}} group=${{W1_GATE_GROUP_STATUS:-UNKNOWN}} clock=$W1_CLOCK_STATE pid=$PYTEST_GATE_PID receipt=${{PYTEST_ORIGINAL_RECEIPT:-UNAVAILABLE}}" \
        >> "$RUNDIR/jobid.err"
    echo "ABORT context=$W1_ABORT_CONTEXT frame_rc=$W1_ABORT_FRAME_RC frame=$W1_ABORT_FRAME frame_hex=$W1_FRAME_HEX eof=$W1_TERMINAL_EOF relay_wait=${{W1_RELAY_WAIT_STATUS:-UNKNOWN}} wait=${{W1_GATE_WAIT_STATUS:-UNKNOWN}} group=${{W1_GATE_GROUP_STATUS:-UNKNOWN}} clock=$W1_CLOCK_STATE" \
        >> "$RUNDIR/registration-gate.protocol"
    if [ "$W1_CANCEL_STATUS" -ne 0 ]; then
        W1_IN_SETTLEMENT=0
        registration_settle_cancel "abort-$W1_ABORT_CONTEXT"
    fi
    if [ "$W1_ABORT_WAIT" -ne 1 ] \
            && [ "$W1_CLOCK_STATE" = ROLLBACK ]; then
        # A broken clock cannot authorize another timer owner.  The acquired
        # child receipts still authorize immediate bounded teardown: TERM,
        # identity recheck, KILL without an invented grace interval, and an
        # exact child wait.  Settlement remains UNKNOWN unless its ordinary
        # census proved ABSENT, so this cleanup cannot upgrade status 92.
        if [ "${{W1_RELAY_ACQUIRED:-0}}" -eq 1 ] \
                && [ "${{W1_RELAY_SETTLED_OK:-0}}" -ne 1 ]; then
            W1_ACTIVE_OWNER_ROLE=clock-rollback-relay
            W1_ACTIVE_OWNER_PID="$W1_TERMINAL_RELAY_PID"
            W1_ACTIVE_OWNER_GROUP_READY="${{W1_RELAY_GROUP_READY_AT_ACQUIRE:-0}}"
            registration_owner_stop "$W1_ACTIVE_OWNER_PID" \
                "$W1_ACTIVE_OWNER_GROUP_READY" || :
            registration_owner_collect clock-rollback-relay \
                "$W1_ACTIVE_OWNER_PID" "$W1_ACTIVE_OWNER_GROUP_READY" \
                "${{W1_OWNER_STOP_DISPOSITION:-CLOCK-ROLLBACK-STOP}}" || :
        fi
        if [ "${{W1_GATE_ACQUIRED:-0}}" -eq 1 ] \
                && [ "${{W1_GATE_SETTLED_OK:-0}}" -ne 1 ]; then
            W1_ACTIVE_OWNER_ROLE=clock-rollback-gate
            W1_ACTIVE_OWNER_PID="$PYTEST_GATE_PID"
            W1_ACTIVE_OWNER_GROUP_READY="${{W1_GATE_GROUP_READY_AT_ACQUIRE:-0}}"
            registration_owner_stop "$W1_ACTIVE_OWNER_PID" \
                "$W1_ACTIVE_OWNER_GROUP_READY" || :
            registration_owner_collect clock-rollback-gate \
                "$W1_ACTIVE_OWNER_PID" "$W1_ACTIVE_OWNER_GROUP_READY" \
                "${{W1_OWNER_STOP_DISPOSITION:-CLOCK-ROLLBACK-STOP}}" || :
        fi
        echo "CLOCK-FAILURE-CLEANUP state=$W1_CLOCK_STATE gate=$PYTEST_GATE_PID relay=$W1_TERMINAL_RELAY_PID" \
            >> "$RUNDIR/jobid.err"
    fi
    if {{ [ "$W1_ABORT_PROTOCOL" -eq 1 ] \
            || [ "$W1_SETTLED_STATUS" -eq 94 ]; }} \
            && [ "$W1_ABORT_WAIT" -eq 1 ]; then
        registration_finish "$W1_SETTLED_STATUS"
    fi
    registration_finish "$W1_FALLBACK_STATUS"
}}

registration_copy_raw_jobid() {{
    if [ -f "$RUNDIR/jobid.raw" ]; then
        cp "$RUNDIR/jobid.raw" "$RUNDIR/jobid"
    else
        : > "$RUNDIR/jobid"
    fi
}}

registration_raw_id_is_exact() {{
    W1_JOB_ID=""
    local W1_ID_LINES=()
    mapfile -t W1_ID_LINES < "$RUNDIR/jobid.raw"
    if [ "${{#W1_ID_LINES[@]}}" -eq 1 ] \
            && [[ "${{W1_ID_LINES[0]}}" =~ ^[A-Za-z0-9._-]+-[0-9]+$ ]]; then
        W1_JOB_ID="${{W1_ID_LINES[0]}}"
        return 0
    fi
    return 1
}}

registration_reconcile_known_id() {{
    [ -n "${{W1_JOB_ID:-}}" ] || return 0
    if [ "$W1_RECONCILE_ATTEMPTED" -ne 0 ]; then
        return 0
    fi
    W1_RECONCILE_ATTEMPTED=1
    registration_begin_cleanup_deadline "$W1_RECONCILE_SECONDS" || {{
        W1_RECONCILE_STATUS=DEADLINE-UNAVAILABLE
        return 1
    }}
    registration_cancel_checkpoint "pre-reconciliation"
    if ! registration_owner_run reconciliation \
            "$RUNDIR/registration-reconcile.out" \
            "$RUNDIR/registration-reconcile.err" \
            python3 "$HOME/BulkDownloader/toolchain/bin/bd-jobs" \
            reap --id "$W1_JOB_ID"; then
        W1_RECONCILE_STATUS=OWNER-UNKNOWN
        registration_cancel_checkpoint "post-reconciliation"
        return 1
    fi
    W1_RECONCILE_STATUS="$W1_OWNER_STATUS"
    registration_cancel_checkpoint "post-reconciliation"
    return 0
}}

registration_fail_registered() {{
    local W1_REGISTERED_CONTEXT="$1"
    local W1_REGISTERED_PRIMARY="${{2:-93}}"
    local W1_REGISTERED_GATE_SETTLED=0
    W1_IN_SETTLEMENT=1
    if [ "$W1_CANCEL_STATUS" -ne 0 ]; then
        W1_REGISTERED_PRIMARY="$W1_CANCEL_STATUS"
    fi
    registration_close_release
    registration_close_terminal_parent_writer
    if [ "$W1_STATUS_CLOSED" -eq 0 ] \
            && [[ "$W1_GATE_READ_FD" =~ ^[0-9]+$ ]] \
            && [ "${{W1_TERMINAL_EOF:-0}}" -ne 1 ]; then
        registration_begin_cleanup_deadline "$W1_CLEANUP_SECONDS" || :
        registration_read_terminal || :
    fi
    registration_reconcile_known_id || :
    registration_begin_cleanup_deadline "$W1_CLEANUP_SECONDS" || :
    if [ "${{W1_TERMINAL_EOF:-0}}" -eq 1 ] \
            && [ "${{W1_TERMINAL_RELAY_OK:-0}}" -eq 1 ] \
            && registration_checked_gate_wait ANY; then
        W1_REGISTERED_GATE_SETTLED=1
    fi
    if [ "$W1_CANCEL_STATUS" -ne 0 ]; then
        W1_REGISTERED_PRIMARY="$W1_CANCEL_STATUS"
    fi
    echo "REGISTERED-FAILURE context=$W1_REGISTERED_CONTEXT primary=$W1_REGISTERED_PRIMARY primary_cancel=${{W1_CANCEL_STATUS:-0}} release_writes=${{W1_RELEASE_WRITE_COUNT:-0}} id=${{W1_JOB_ID:-UNAVAILABLE}} reconcile=$W1_RECONCILE_STATUS gate_settled=$W1_REGISTERED_GATE_SETTLED relay_wait=${{W1_RELAY_WAIT_STATUS:-UNKNOWN}} clock=$W1_CLOCK_STATE receipt=${{PYTEST_ORIGINAL_RECEIPT:-UNAVAILABLE}}" \
        >> "$RUNDIR/jobid.err"
    if [[ "$W1_REGISTERED_PRIMARY" =~ ^(129|130|143)$ ]] \
            && [[ "$W1_RECONCILE_STATUS" =~ ^[0-9]+$ ]] \
            && [ "$W1_RECONCILE_STATUS" -eq 0 ] \
            && [ "$W1_REGISTERED_GATE_SETTLED" -eq 1 ]; then
        registration_finish "$W1_REGISTERED_PRIMARY"
    fi
    registration_finish 93
}}

registration_settle_cancel() {{
    local W1_CANCEL_CONTEXT="$1"
    local W1_CANCEL_WAIT=0
    W1_IN_SETTLEMENT=1
    if [ -z "${{W1_JOB_ID:-}}" ] && [ -f "$RUNDIR/jobid.raw" ]; then
        if registration_raw_id_is_exact; then
            printf '%s\n' "$W1_JOB_ID" > "$RUNDIR/jobid"
        elif [ -s "$RUNDIR/jobid.raw" ]; then
            registration_copy_raw_jobid
        fi
    fi
    registration_begin_cleanup_deadline "$W1_CLEANUP_SECONDS" || :
    registration_close_release
    registration_close_terminal_parent_writer
    registration_handover_terminal_reader
    if [ "${{W1_TERMINAL_EOF:-0}}" -ne 1 ]; then
        registration_read_terminal || :
    fi
    if [ "$W1_RELAY_ACQUIRED" -eq 1 ] \
            && [ "$W1_RELAY_WAIT_ATTEMPTED" -eq 0 ]; then
        registration_checked_terminal_relay_wait || :
    fi
    if [ "$W1_TERMINAL_EOF" -eq 1 ] \
            && [ "$W1_TERMINAL_RELAY_OK" -eq 1 ] \
            && registration_checked_gate_wait ANY; then
        W1_CANCEL_WAIT=1
    fi
    echo "REGISTER-CANCELLED status=$W1_CANCEL_STATUS primary_cancel=$W1_CANCEL_STATUS context=$W1_CANCEL_CONTEXT frame=$W1_FRAME frame_hex=$W1_FRAME_HEX eof=$W1_TERMINAL_EOF wait=${{W1_GATE_WAIT_STATUS:-UNKNOWN}} group=${{W1_GATE_GROUP_STATUS:-UNKNOWN}} clock=$W1_CLOCK_STATE id=${{W1_JOB_ID:-UNAVAILABLE}} receipt=${{PYTEST_ORIGINAL_RECEIPT:-UNAVAILABLE}}" \
        >> "$RUNDIR/jobid.err"
    if [ -n "${{W1_JOB_ID:-}}" ]; then
        registration_fail_registered "cancel-$W1_CANCEL_CONTEXT" \
            "$W1_CANCEL_STATUS"
    fi
    if [ "$W1_CANCEL_WAIT" -eq 1 ]; then
        registration_finish "$W1_CANCEL_STATUS"
    fi
    registration_finish 92
}}

registration_cancel_checkpoint() {{
    [ "$BASHPID" = "$$" ] || return 1
    [ "$W1_CANCEL_STATUS" -eq 0 ] && return 0
    [ "$W1_IN_SETTLEMENT" -eq 1 ] && return 0
    [ "$W1_OWNER_SETTLING" -gt 0 ] && return 0
    registration_settle_cancel "$1"
}}

registration_settle_setup() {{
    local W1_SETUP_CONTEXT="$1" W1_SETUP_GATE_ACCEPTED=0
    local W1_SETUP_RELAY_ACCEPTED=0
    W1_IN_SETTLEMENT=1
    registration_begin_cleanup_deadline "$W1_CLEANUP_SECONDS" || :
    registration_close_release
    registration_close_terminal_parent_writer
    registration_handover_terminal_reader
    if [[ "$W1_GATE_READ_FD" =~ ^[0-9]+$ ]]; then
        registration_read_terminal || :
    else
        registration_close_status
    fi
    if [ "$W1_RELAY_WAIT_ATTEMPTED" -eq 0 ]; then
        registration_checked_terminal_relay_wait || :
    fi
    registration_checked_gate_wait ANY || :
    registration_close_status
    [ "$W1_RELAY_ACQUIRED" -eq 1 ] \
        && [ "$W1_RELAY_SETTLED_OK" -eq 1 ] \
        && W1_SETUP_RELAY_ACCEPTED=1
    [ "$W1_GATE_ACQUIRED" -eq 1 ] \
        && [ "$W1_GATE_SETTLED_OK" -eq 1 ] \
        && W1_SETUP_GATE_ACCEPTED=1
    echo "SETUP-OWNER role=gate accepted=$W1_SETUP_GATE_ACCEPTED pid=${{PYTEST_GATE_PID:-MISSING}} wait=${{W1_GATE_WAIT_STATUS:-UNKNOWN}} descendants=${{W1_GATE_GROUP_STATUS:-UNKNOWN}} context=$W1_SETUP_CONTEXT" \
        >> "$RUNDIR/jobid.err"
    echo "SETUP-OWNER role=relay accepted=$W1_SETUP_RELAY_ACCEPTED pid=${{W1_TERMINAL_RELAY_PID:-MISSING}} wait=${{W1_RELAY_WAIT_STATUS:-UNKNOWN}} descendants=${{W1_RELAY_GROUP_STATUS:-UNKNOWN}} context=$W1_SETUP_CONTEXT" \
        >> "$RUNDIR/jobid.err"
    if [ "$W1_CANCEL_STATUS" -ne 0 ]; then
        W1_IN_SETTLEMENT=0
        registration_settle_cancel "setup-$W1_SETUP_CONTEXT"
    fi
    if [ "$W1_SETUP_GATE_ACCEPTED" -eq 1 ] \
            && [ "$W1_SETUP_RELAY_ACCEPTED" -eq 1 ]; then
        registration_finish 94
    fi
    registration_finish 92
}}

registration_on_exit() {{
    local W1_EXIT_PRIMARY="$1" W1_EXIT_RESTORED=1
    [ "${{W1_FINISHING:-0}}" -eq 0 ] || return 0
    [ "${{W1_EXIT_GUARD_ACTIVE:-0}}" -eq 0 ] || return 0
    W1_EXIT_GUARD_ACTIVE=1
    W1_FINISHING=1
    trap - EXIT INT TERM HUP
    W1_IN_SETTLEMENT=1
    registration_close_release
    registration_close_terminal_parent_writer
    if [ "${{W1_LIFECYCLE_INITIALIZED:-0}}" -eq 1 ]; then
        registration_begin_cleanup_deadline "$W1_CLEANUP_SECONDS" || :
        if [[ "${{W1_ACTIVE_OWNER_PID:-}}" =~ ^[0-9]+$ ]]; then
            W1_SPAWN_PID="$W1_ACTIVE_OWNER_PID"
            W1_SPAWN_PARENT_PID="$$"
            registration_promote_spawn_group_receipt || :
            registration_owner_stop "$W1_ACTIVE_OWNER_PID" \
                "${{W1_ACTIVE_OWNER_GROUP_READY:-0}}" || W1_EXIT_RESTORED=0
            registration_owner_collect \
                "${{W1_ACTIVE_OWNER_ROLE:-exit-active-owner}}" \
                "$W1_ACTIVE_OWNER_PID" \
                "${{W1_ACTIVE_OWNER_GROUP_READY:-0}}" \
                "${{W1_OWNER_STOP_DISPOSITION:-EXIT-STOP}}" \
                || W1_EXIT_RESTORED=0
        fi
        if [ "${{W1_RELAY_ACQUIRED:-0}}" -eq 1 ] \
                && [ "${{W1_RELAY_SETTLED_OK:-0}}" -ne 1 ]; then
            registration_checked_terminal_relay_wait || W1_EXIT_RESTORED=0
        fi
        if [ "${{W1_GATE_ACQUIRED:-0}}" -eq 1 ] \
                && [ "${{W1_GATE_SETTLED_OK:-0}}" -ne 1 ]; then
            registration_checked_gate_wait ANY || W1_EXIT_RESTORED=0
        fi
    else
        W1_EXIT_RESTORED=0
    fi
    registration_close_status
    echo "EXIT-GUARD primary=$W1_EXIT_PRIMARY restored=$W1_EXIT_RESTORED active_role=${{W1_ACTIVE_OWNER_ROLE:-NONE}} active_pid=${{W1_ACTIVE_OWNER_PID:-NONE}} gate_acquired=${{W1_GATE_ACQUIRED:-0}} gate_settled=${{W1_GATE_SETTLED_OK:-0}} relay_acquired=${{W1_RELAY_ACQUIRED:-0}} relay_settled=${{W1_RELAY_SETTLED_OK:-0}} primary_cancel=${{W1_CANCEL_STATUS:-0}}" \
        >> "$RUNDIR/jobid.err"
    if [ ! -s "$RUNDIR/exitcode" ]; then
        echo 92 > "$RUNDIR/exitcode"
    fi
}}
trap 'registration_on_exit $?' EXIT

if ! registration_initialize_lifecycle_deadline; then
    echo "REGISTER-GATE-SETUP-FAILED phase=clock clock=$W1_CLOCK_STATE" \
        > "$RUNDIR/jobid.err"
    registration_finish 92
fi

# `set -m` is load-bearing: backgrounded work must not inherit SIGINT ignored.
# The guards above are installed before this first acquisition.
W1_GATE_GROUP_READY_AT_ACQUIRE=0
W1_RELAY_GROUP_READY_AT_ACQUIRE=0
W1_GATE_RECEIPT_AT_ACQUIRE=UNKNOWN
W1_RELAY_RECEIPT_AT_ACQUIRE=UNKNOWN
set -m
coproc W1_TERMINAL_RELAY {{
    exec python3 -c {registration_terminal_relay} "$$"
}}
W1_TERMINAL_RELAY_PID=${{W1_TERMINAL_RELAY_PID:-}}
W1_RELAY_READ_FD=${{W1_TERMINAL_RELAY[0]:-}}
W1_RELAY_WRITE_FD=${{W1_TERMINAL_RELAY[1]:-}}
if [[ "$W1_RELAY_READ_FD" =~ ^[0-9]+$ ]]; then
    exec {{W1_TERMINAL_READ_FD}}<&"$W1_RELAY_READ_FD" \
        || W1_TERMINAL_READ_FD=""
    eval "exec $W1_RELAY_READ_FD<&-"
fi
if [[ "$W1_RELAY_WRITE_FD" =~ ^[0-9]+$ ]]; then
    exec {{W1_TERMINAL_PARENT_WRITE_FD}}>&"$W1_RELAY_WRITE_FD" \
        || W1_TERMINAL_PARENT_WRITE_FD=""
    eval "exec $W1_RELAY_WRITE_FD>&-"
fi
if [[ "$W1_TERMINAL_RELAY_PID" =~ ^[0-9]+$ ]]; then
    W1_RELAY_ACQUIRED=1
    if registration_child_group_is_leader "$W1_TERMINAL_RELAY_PID"; then
        W1_RELAY_GROUP_READY_AT_ACQUIRE="$W1_CHILD_GROUP_READY"
        W1_RELAY_RECEIPT_AT_ACQUIRE="$W1_CHILD_RECEIPT"
    fi
fi
set +m
registration_cancel_checkpoint "after-relay-acquire"

W1_TERMINAL_WRITER_PATH="/proc/$$/fd/$W1_TERMINAL_PARENT_WRITE_FD"
set -m
coproc W1_REGISTRATION_GATE {{
    exec python3 -c {registration_bootstrap} \
        "$W1_TERMINAL_WRITER_PATH" {registration_gate} {workload_shim}
}} 2> "$RUNDIR/registration-gate.err"
PYTEST_GATE_PID=${{W1_REGISTRATION_GATE_PID:-}}
W1_COPROC_READ_FD=${{W1_REGISTRATION_GATE[0]:-}}
W1_COPROC_WRITE_FD=${{W1_REGISTRATION_GATE[1]:-}}
if [[ "$W1_COPROC_READ_FD" =~ ^[0-9]+$ ]]; then
    exec {{W1_GATE_READ_FD}}<&"$W1_COPROC_READ_FD" || W1_GATE_READ_FD=""
    eval "exec $W1_COPROC_READ_FD<&-"
fi
if [[ "$W1_COPROC_WRITE_FD" =~ ^[0-9]+$ ]]; then
    exec {{W1_GATE_WRITE_FD}}>&"$W1_COPROC_WRITE_FD" || W1_GATE_WRITE_FD=""
    eval "exec $W1_COPROC_WRITE_FD>&-"
fi
PYTEST_PID=$PYTEST_GATE_PID
if [[ "$PYTEST_GATE_PID" =~ ^[0-9]+$ ]]; then
    W1_GATE_ACQUIRED=1
    if registration_child_group_is_leader "$PYTEST_GATE_PID"; then
        W1_GATE_GROUP_READY_AT_ACQUIRE="$W1_CHILD_GROUP_READY"
        W1_GATE_RECEIPT_AT_ACQUIRE="$W1_CHILD_RECEIPT"
    fi
fi
set +m
registration_cancel_checkpoint "after-gate-acquire"

W1_GATE_GROUP_READY_AT_ACQUIRE=0
W1_RELAY_GROUP_READY_AT_ACQUIRE=0
if registration_child_group_is_leader "$PYTEST_GATE_PID" \
        && registration_receipt_same_process \
            "$W1_GATE_RECEIPT_AT_ACQUIRE" "$W1_CHILD_RECEIPT"; then
    W1_GATE_GROUP_READY_AT_ACQUIRE="$W1_CHILD_GROUP_READY"
    W1_OWNER_RECEIPT_BY_PID[$PYTEST_GATE_PID]="$W1_GATE_RECEIPT_AT_ACQUIRE"
    W1_OWNER_FDS_BY_PID[$PYTEST_GATE_PID]=UNKNOWN
fi
if registration_child_group_is_leader "$W1_TERMINAL_RELAY_PID" \
        && registration_receipt_same_process \
            "$W1_RELAY_RECEIPT_AT_ACQUIRE" "$W1_CHILD_RECEIPT"; then
    W1_RELAY_GROUP_READY_AT_ACQUIRE="$W1_CHILD_GROUP_READY"
    W1_OWNER_RECEIPT_BY_PID[$W1_TERMINAL_RELAY_PID]="$W1_RELAY_RECEIPT_AT_ACQUIRE"
    W1_OWNER_FDS_BY_PID[$W1_TERMINAL_RELAY_PID]=UNKNOWN
fi

if [[ ! "$PYTEST_GATE_PID" =~ ^[0-9]+$ \
        || ! "$W1_TERMINAL_RELAY_PID" =~ ^[0-9]+$ ]]; then
    echo "REGISTER-GATE-SETUP-FAILED phase=coproc" > "$RUNDIR/jobid.err"
    registration_settle_setup "coproc-pid"
fi
W1_PYTEST_PID_TEMP="$RUNDIR/pytest.pid.tmp.$BASHPID"
if ! builtin printf '%s\n' "$PYTEST_PID" > "$W1_PYTEST_PID_TEMP" \
        || ! mv "$W1_PYTEST_PID_TEMP" "$RUNDIR/pytest.pid"; then
    command rm -f -- "$W1_PYTEST_PID_TEMP"
    echo "REGISTER-GATE-SETUP-FAILED phase=pytest-pid-publish" \
        > "$RUNDIR/jobid.err"
    registration_settle_setup "pytest-pid-publish"
fi
PYTEST_ORIGINAL_RECEIPT=""
PYTEST_PGID="$PYTEST_GATE_PID"
if [[ ! "$W1_GATE_READ_FD" =~ ^[0-9]+$ \
        || ! "$W1_GATE_WRITE_FD" =~ ^[0-9]+$ \
        || ! "$W1_TERMINAL_READ_FD" =~ ^[0-9]+$ \
        || ! "$W1_TERMINAL_PARENT_WRITE_FD" =~ ^[0-9]+$ ]]; then
    echo "REGISTER-GATE-SETUP-FAILED phase=coproc-partial pid=$PYTEST_GATE_PID read=${{W1_GATE_READ_FD:-MISSING}} write=${{W1_GATE_WRITE_FD:-MISSING}} terminal_read=${{W1_TERMINAL_READ_FD:-MISSING}} terminal_parent_write=${{W1_TERMINAL_PARENT_WRITE_FD:-MISSING}}" \
        > "$RUNDIR/jobid.err"
    PYTEST_ORIGINAL_RECEIPT=""
    registration_settle_setup "coproc-fd"
fi
registration_cancel_checkpoint "owner-setup"

# READY is admission, not decoration: one exact frame and one live direct-child
# group-leader receipt precede register. Later protocol is read through EOF under
# one monotonic deadline; no scheduler-sized "quiet" sleep grants authority.
registration_read_frame "$W1_READY_SECONDS"
W1_READY_FRAME="$W1_FRAME"
W1_READY_FRAME_HEX="$W1_FRAME_HEX"
W1_READY_CHANNEL_STATE="$W1_CHANNEL_STATE"
W1_READY_BYTE_LINE="$W1_FRAME_BYTE_LINE"
registration_close_terminal_parent_writer
registration_cancel_checkpoint "ready-read"
W1_READY_OK=0
if [ "$W1_READY_CHANNEL_STATE" = EOF ] \
        && [ "$W1_FRAME_CLASS" = READY ]; then
    W1_READY_OK=1
fi
registration_handover_terminal_reader
if [ "$W1_READY_OK" -eq 0 ]; then
    echo "REGISTER-GATE-SETUP-FAILED phase=ready state=$W1_READY_CHANNEL_STATE frame=$W1_READY_FRAME frame_hex=$W1_READY_FRAME_HEX clock=$W1_CLOCK_STATE" \
        > "$RUNDIR/jobid.err"
    registration_settle_abort 94 92 "ready-refused"
fi
echo "READY state=$W1_READY_CHANNEL_STATE frame=$W1_READY_FRAME frame_hex=$W1_READY_FRAME_HEX" \
    > "$RUNDIR/registration-gate.protocol"
if ! registration_authority_fd_observation gate "$PYTEST_GATE_PID" "0,2,3" \
        || ! registration_authority_fd_observation relay \
            "$W1_TERMINAL_RELAY_PID" "0,1,2"; then
    echo "REGISTER-GATE-SETUP-FAILED phase=authority-fds" \
        >> "$RUNDIR/jobid.err"
    registration_settle_abort 92 92 "authority-fds-unknown"
fi
registration_cancel_checkpoint "authority-fds"

registration_begin_gate_deadline "$W1_GATE_SECONDS" || :
W1_PROCESS_OBSERVATION=UNKNOWN
registration_process_observation 2>/dev/null || :
PYTEST_INITIAL_OBSERVATION="$W1_PROCESS_OBSERVATION"
registration_cancel_checkpoint "initial-observation"
PYTEST_ORIGINAL_RECEIPT=""
PYTEST_SIGNAL_RECEIPT=""
PYTEST_INITIAL_GROUP=UNKNOWN
W1_INITIAL_DECISION="initial-observation-unavailable"
if [[ "$PYTEST_INITIAL_OBSERVATION" == OBSERVED\|*\|* ]]; then
    W1_INITIAL_PAYLOAD="${{PYTEST_INITIAL_OBSERVATION#OBSERVED|}}"
    W1_INITIAL_RECEIPT="${{W1_INITIAL_PAYLOAD%|*}}"
    W1_INITIAL_STATE="${{W1_INITIAL_PAYLOAD##*|}}"
    IFS=: read -r W1_INITIAL_PID W1_INITIAL_PPID W1_INITIAL_PGID \
        W1_INITIAL_START W1_INITIAL_EXTRA <<< "$W1_INITIAL_RECEIPT"
    if [ "$W1_INITIAL_PID" = "$PYTEST_PID" ] \
            && [ "$W1_INITIAL_PPID" = "$$" ] \
            && [ "$W1_INITIAL_PGID" = "$PYTEST_PID" ] \
            && [ "$W1_INITIAL_PGID" != "$$" ] \
            && [[ "$W1_INITIAL_STATE" != Z && "$W1_INITIAL_STATE" != X ]] \
            && [[ "$W1_INITIAL_START" =~ ^[0-9]+$ ]] \
            && [ -z "$W1_INITIAL_EXTRA" ]; then
        PYTEST_ORIGINAL_RECEIPT="$W1_INITIAL_RECEIPT"
        PYTEST_PGID="$W1_INITIAL_PGID"
        W1_INITIAL_DECISION="trusted-direct-child-gate"
    elif [ "$W1_INITIAL_PPID" != "$$" ]; then
        W1_INITIAL_DECISION="initial-not-direct-child"
    elif [ "$W1_INITIAL_PGID" != "$PYTEST_PID" ]; then
        W1_INITIAL_DECISION="initial-not-group-leader"
    else
        W1_INITIAL_DECISION="initial-receipt-refused"
    fi
fi
if [ -n "$PYTEST_ORIGINAL_RECEIPT" ]; then
    W1_GROUP_OBSERVATION=UNKNOWN
    registration_group_observation 2>/dev/null || :
    PYTEST_INITIAL_GROUP="$W1_GROUP_OBSERVATION"
    registration_cancel_checkpoint "initial-group-observation"
    if [[ "$PYTEST_INITIAL_GROUP" != "PRESENT|$PYTEST_ORIGINAL_RECEIPT:"? ]]; then
        PYTEST_ORIGINAL_RECEIPT=""
        W1_INITIAL_DECISION="initial-group-not-sole"
    fi
fi
if [ -n "$PYTEST_ORIGINAL_RECEIPT" ]; then
    if registration_process_receipt "$PYTEST_PID"; then
        IFS=: read -r W1_SIGNAL_PID W1_SIGNAL_PPID W1_SIGNAL_PGID \
            W1_SIGNAL_SID W1_SIGNAL_START W1_SIGNAL_EXTRA \
            <<< "$W1_PROCESS_RECEIPT"
        if [ "$W1_SIGNAL_PID:$W1_SIGNAL_PPID:$W1_SIGNAL_PGID:$W1_SIGNAL_START" \
                = "$W1_INITIAL_PID:$W1_INITIAL_PPID:$W1_INITIAL_PGID:$W1_INITIAL_START" ] \
                && [[ "$W1_SIGNAL_SID" =~ ^[0-9]+$ ]] \
                && [ -z "$W1_SIGNAL_EXTRA" ] \
                && [[ "$W1_PROCESS_STATE" != Z && "$W1_PROCESS_STATE" != X ]]; then
            PYTEST_SIGNAL_RECEIPT="$W1_PROCESS_RECEIPT"
        else
            PYTEST_ORIGINAL_RECEIPT=""
            W1_INITIAL_DECISION="initial-full-receipt-mismatch"
        fi
    else
        PYTEST_ORIGINAL_RECEIPT=""
        W1_INITIAL_DECISION="initial-full-receipt-unavailable"
    fi
fi
if [ -z "$PYTEST_ORIGINAL_RECEIPT" ]; then
    echo "REGISTER-GATE-SETUP-FAILED phase=receipt decision=$W1_INITIAL_DECISION observed=$PYTEST_INITIAL_OBSERVATION group=$PYTEST_INITIAL_GROUP" \
        > "$RUNDIR/jobid.err"
    registration_settle_abort 92 92 "$W1_INITIAL_DECISION"
fi
printf '%s\n' "$PYTEST_SIGNAL_RECEIPT" > "$RUNDIR/gate.receipt.tmp"
mv "$RUNDIR/gate.receipt.tmp" "$RUNDIR/gate.receipt"

if ! registration_observation_matches_original; then
    echo "REGISTER-GATE-SETUP-FAILED phase=pre-register receipt=$PYTEST_ORIGINAL_RECEIPT current=${{W1_CURRENT_OBSERVATION:-UNKNOWN}}" \
        > "$RUNDIR/jobid.err"
    registration_settle_abort 92 92 "pre-register-identity-refused"
fi
registration_cancel_checkpoint "pre-register-observation"

# Both anonymous gate endpoints are closed in the registrar child. In
# particular it cannot retain release authority if this runner is cancelled.
registration_begin_gate_deadline "$W1_REGISTRAR_SECONDS" || \
    registration_settle_abort 92 92 "registrar-deadline-unavailable"
registration_cancel_checkpoint "pre-registrar-spawn"
W1_REGISTRAR_OWNER_OK=0
if registration_owner_run registrar "$RUNDIR/jobid.raw" \
        "$RUNDIR/jobid.err" \
        python3 "$HOME/BulkDownloader/toolchain/bin/bd-jobs" register \
        --pid "$PYTEST_PID" --purpose {purpose} --origin {origin} --cmd {cmdq}; then
    W1_REGISTRAR_OWNER_OK=1
fi
W1_REGISTRAR_PID="${{W1_SPAWN_PID:-MISSING}}"
W1_REGISTRAR_WAITED_PID="${{W1_OWNER_WAITED_PID:-MISSING}}"
W1_REGISTRAR_STATUS="${{W1_OWNER_STATUS:-UNKNOWN}}"
registration_cancel_checkpoint "registrar-output"

if [ "$W1_REGISTRAR_OWNER_OK" -ne 1 ] \
        || [ "${{W1_REGISTRAR_WAITED_PID:-}}" != "$W1_REGISTRAR_PID" ] \
        || [ "$W1_REGISTRAR_STATUS" -eq 124 ] \
        || [ "$W1_REGISTRAR_STATUS" -eq 137 ]; then
    registration_copy_raw_jobid
    echo "REGISTER-DISPOSITION-UNKNOWN registrar_status=$W1_REGISTRAR_STATUS waited=${{W1_REGISTRAR_WAITED_PID:-NONE}} receipt=$PYTEST_ORIGINAL_RECEIPT" \
        >> "$RUNDIR/jobid.err"
    registration_settle_abort 92 92 "registrar-disposition-unknown"
fi

if [ "$W1_REGISTRAR_STATUS" -ne 0 ]; then
    if [ -s "$RUNDIR/jobid.raw" ]; then
        registration_copy_raw_jobid
        if registration_raw_id_is_exact; then
            printf '%s\n' "$W1_JOB_ID" > "$RUNDIR/jobid"
        fi
        registration_fail_registered "registrar-nonzero-with-output"
    fi
    echo "REGISTER-FAILED" > "$RUNDIR/jobid"
    registration_settle_abort 91 92 "registrar-refused"
fi

if ! registration_raw_id_is_exact; then
    registration_copy_raw_jobid
    echo "REGISTER-HANDOFF-FAILED decision=invalid-job-id receipt=$PYTEST_ORIGINAL_RECEIPT" \
        >> "$RUNDIR/jobid.err"
    registration_fail_registered "invalid-job-id"
fi
printf '%s\n' "$W1_JOB_ID" > "$RUNDIR/jobid"
registration_cancel_checkpoint "registered-id"

if ! registration_begin_gate_deadline "$W1_GATE_SECONDS"; then
    echo "REGISTER-HANDOFF-FAILED decision=handoff-deadline-unavailable id=$W1_JOB_ID receipt=$PYTEST_ORIGINAL_RECEIPT clock=$W1_CLOCK_STATE" \
        >> "$RUNDIR/jobid.err"
    registration_fail_registered "handoff-deadline-unavailable"
fi
if ! registration_observation_matches_original; then
    echo "REGISTER-HANDOFF-FAILED decision=pre-go-identity-refused id=$W1_JOB_ID receipt=$PYTEST_ORIGINAL_RECEIPT current=${{W1_CURRENT_OBSERVATION:-UNKNOWN}}" \
        >> "$RUNDIR/jobid.err"
    registration_fail_registered "pre-go-identity-refused"
fi
registration_cancel_checkpoint "pre-go-observation"

W1_GATE_RELEASE_TOKEN="GO v1"
W1_RELEASE_WRITE_COUNT=1
W1_RELEASE_SIGPIPE=0
registration_cancel_checkpoint "pre-release"
# A real pipe peer can disappear after the last identity observation and before
# this builtin write.  Bash's default SIGPIPE action would terminate the runner
# before it can interpret the terminal channel or reconcile the registered id.
# Use a caught (not ignored) disposition only for this syscall: caught signals
# reset to default across exec, so the eventual workload does not inherit a
# changed SIGPIPE contract.  The write result remains diagnostic; the distinct
# terminal channel is delivery authority.
trap 'W1_RELEASE_SIGPIPE=1' PIPE
printf '%s\n' "$W1_GATE_RELEASE_TOKEN" >&"$W1_GATE_WRITE_FD"
W1_RELEASE_WRITE_STATUS=$?
trap - PIPE
registration_close_release
registration_cancel_checkpoint "post-release-write"
registration_read_terminal
W1_HANDOFF_FRAME="$W1_FRAME"
W1_HANDOFF_FRAME_RC="$W1_FRAME_RC"
W1_HANDOFF_FRAME_HEX="$W1_FRAME_HEX"
echo "REGISTER-HANDOFF write_status=$W1_RELEASE_WRITE_STATUS writes=$W1_RELEASE_WRITE_COUNT sigpipe=$W1_RELEASE_SIGPIPE frame_rc=$W1_HANDOFF_FRAME_RC frame=$W1_HANDOFF_FRAME frame_hex=$W1_HANDOFF_FRAME_HEX eof=$W1_TERMINAL_EOF clock=$W1_CLOCK_STATE id=$W1_JOB_ID receipt=$PYTEST_ORIGINAL_RECEIPT" \
    >> "$RUNDIR/jobid.err"
echo "HANDOFF write_status=$W1_RELEASE_WRITE_STATUS writes=$W1_RELEASE_WRITE_COUNT sigpipe=$W1_RELEASE_SIGPIPE frame_rc=$W1_HANDOFF_FRAME_RC frame=$W1_HANDOFF_FRAME frame_hex=$W1_HANDOFF_FRAME_HEX eof=$W1_TERMINAL_EOF clock=$W1_CLOCK_STATE" \
    >> "$RUNDIR/registration-gate.protocol"
registration_cancel_checkpoint "terminal-read"

case "$W1_TERMINAL_CLASS" in
    EXEC_OK)
        if [ "$W1_HANDOFF_FRAME_RC" -ne 0 ] \
                || [ "$W1_FRAME_BYTE_LINE" -ne 1 ] \
                || [ "$W1_TERMINAL_EOF" -ne 1 ] \
                || [ "$W1_TERMINAL_RELAY_OK" -ne 1 ] \
                || [ "$W1_TRAILING_FRAME_COUNT" -ne 0 ]; then
            registration_close_status
            registration_fail_registered "invalid-exec-ok"
        fi
        registration_close_status
        W1_WORKLOAD_WAITED_PID=""
        : > "$RUNDIR/registration-workload-wait.err"
        registration_cancel_checkpoint "before-workload-wait"
        W1_ACTIVE_OWNER_ROLE=workload
        W1_ACTIVE_OWNER_PID="$PYTEST_GATE_PID"
        W1_ACTIVE_OWNER_GROUP_READY=0
        wait -p W1_WORKLOAD_WAITED_PID "$PYTEST_GATE_PID" \
            2> "$RUNDIR/registration-workload-wait.err"
        rc=$?
        W1_ACTIVE_OWNER_ROLE=""
        W1_ACTIVE_OWNER_PID=""
        W1_GATE_WAIT_ATTEMPTED=1
        W1_GATE_WAIT_STATUS="$rc"
        W1_GATE_GROUP_STATUS=NOT-APPLICABLE
        W1_GATE_SETTLED_OK=0
        if [ "$W1_WORKLOAD_WAITED_PID" = "$PYTEST_GATE_PID" ] \
                && [ ! -s "$RUNDIR/registration-workload-wait.err" ]; then
            W1_GATE_SETTLED_OK=1
        fi
        registration_owner_record workload "$PYTEST_GATE_PID" \
            "${{W1_WORKLOAD_WAITED_PID:-MISSING}}" "$rc" \
            "$W1_GATE_SETTLED_OK" NOT-APPLICABLE NONE \
            "$W1_GATE_GROUP_READY_AT_ACQUIRE"
        registration_cancel_checkpoint "workload-wait"
        if [ "$W1_WORKLOAD_WAITED_PID" != "$PYTEST_GATE_PID" ] \
                || [ -s "$RUNDIR/registration-workload-wait.err" ]; then
            registration_fail_registered "workload-wait-failed"
        fi
        date +%s > "$RUNDIR/epoch_end"
        cat /proc/loadavg > "$RUNDIR/load_after" 2>&1
        git rev-parse HEAD > "$RUNDIR/head_after" 2>&1
        echo "$rc" > "$RUNDIR/exitcode"
        W1_FINISHING=1
        trap - EXIT
        ;;
    EXEC_FAIL)
        if [ "$W1_HANDOFF_FRAME_RC" -ne 0 ] \
                || [ "$W1_FRAME_BYTE_LINE" -ne 1 ] \
                || [ "$W1_TERMINAL_EOF" -ne 1 ] \
                || [ "$W1_TERMINAL_RELAY_OK" -ne 1 ] \
                || [ "$W1_TRAILING_FRAME_COUNT" -ne 0 ]; then
            registration_close_status
            registration_fail_registered "invalid-exec-fail"
        fi
        registration_close_status
        registration_fail_registered "exec-fail"
        ;;
    ABORTED)
        if [ "$W1_HANDOFF_FRAME_RC" -ne 0 ] \
                || [ "$W1_FRAME_BYTE_LINE" -ne 1 ] \
                || [ "$W1_TERMINAL_EOF" -ne 1 ] \
                || [ "$W1_TERMINAL_RELAY_OK" -ne 1 ] \
                || [ "$W1_TRAILING_FRAME_COUNT" -ne 0 ]; then
            registration_close_status
            registration_fail_registered "invalid-aborted"
        fi
        registration_close_status
        registration_fail_registered "aborted-after-register"
        ;;
    *)
        # EOF, timeout, malformed status, and a withheld record do not prove
        # delivery. The registered id remains the reconciliation handle.
        registration_close_status
        registration_fail_registered "terminal-invalid-or-timeout"
        ;;
esac
"""


def registration_workload_shim(rundir: str, cmd: str) -> str:
    """Post-exec acknowledgment followed by the exact existing command."""
    return (
        "builtin printf 'EXEC-OK v1\\n' >&3\n"
        "exec 3>&-\n"
        "exec > %s 2>&1\n"
        "exec %s\n" % (shlex.quote("%s/pytest.log" % rundir), cmd)
    )


def launch(addr: str, rundir: str, cmd: str, purpose: str, origin: str) -> dict:
    run_id = secrets.token_hex(16)
    workload_shim = registration_workload_shim(rundir, cmd)
    body = RUNNER.format(rundir=shlex.quote(rundir), cmd=cmd,
                         run_id=shlex.quote(run_id),
                         purpose=shlex.quote(purpose), origin=shlex.quote(origin),
                         cmdq=shlex.quote(cmd),
                         registration_probe=shlex.quote(
                             REGISTRATION_PROBE_PROGRAM),
                         registration_gate=shlex.quote(
                             REGISTRATION_GATE_PROGRAM),
                         registration_bootstrap=shlex.quote(
                             REGISTRATION_GATE_BOOTSTRAP_PROGRAM),
                         registration_terminal_relay=shlex.quote(
                             REGISTRATION_TERMINAL_RELAY_PROGRAM),
                         registration_timeout_owner=shlex.quote(
                             REGISTRATION_TIMEOUT_OWNER_PROGRAM),
                         registration_channel_reader=shlex.quote(
                             REGISTRATION_CHANNEL_READER_PROGRAM),
                         process_guard=shlex.quote(PROCESS_GUARD_PROGRAM),
                         workload_shim=shlex.quote(workload_shim))
    script = (
        "install -d -m 700 %s && cat > %s/runner.sh <<'BDWEDGEEOF'\n%s\nBDWEDGEEOF\n"
        "BD_WEDGE_EXPECTED_PARENT=1 BD_WEDGE_RUN_ID=%s "
        # env --default-signal: see tests/test_v3_66_1209_*. setsid and
        # nohup do not reset dispositions, and this runner is a subject
        # this tool later expects to cancel. Measured SigIgn=0x1001007
        # SigCgt=0 before this reset.
        "setsid nohup env --default-signal=INT,QUIT bash %s/runner.sh >/dev/null 2>&1 < /dev/null &\n"
        "echo LAUNCHED=$! RUN_ID=%s\n" % (
            shlex.quote(rundir), shlex.quote(rundir), body,
            shlex.quote(run_id), shlex.quote(rundir), shlex.quote(run_id))
    )
    r = ssh(addr, script, timeout=90)
    return {"rc": r.returncode, "out": r.stdout.strip(),
            "err": r.stderr.strip(), "run_id": run_id,
            "runner_receipt": "%s/runner.receipt" % rundir}


PROBE = r"""
RUNDIR="{rundir}"
RECEIPT_RESULT="$(python3 -c {process_guard} probe \
    "$RUNDIR/runner.receipt" 2>/dev/null)"
RECEIPT_RC=$?
RECEIPT_STATE="${{RECEIPT_RESULT%% *}}"
RECEIPT_TOKEN="${{RECEIPT_RESULT#*receipt=}}"
RECEIPT_TOKEN="${{RECEIPT_TOKEN%% *}}"
RUNNER_PID="${{RECEIPT_TOKEN%%:*}}"
[[ "$RUNNER_PID" =~ ^[0-9]+$ ]] || RUNNER_PID=0
GATE_RECEIPT="$(cat "$RUNDIR/gate.receipt" 2>/dev/null || echo UNKNOWN)"
[[ "$GATE_RECEIPT" =~ ^[0-9]+(:[0-9]+){{4}}$ ]] || GATE_RECEIPT=UNKNOWN
if [ -e "$RUNDIR/exitcode" ]; then
    EC="$(cat "$RUNDIR/exitcode" 2>/dev/null)"
    [[ "$EC" =~ ^[0-9]+$ ]] || EC=INVALID
else
    EC=NONE
fi
SZ="$(stat -c %s "$RUNDIR/pytest.log" 2>/dev/null || echo -1)"
MT="$(stat -c %Y "$RUNDIR/pytest.log" 2>/dev/null || echo -1)"
P="$RUNNER_PID"
if [ "$GATE_RECEIPT" != UNKNOWN ]; then
    GATE_RESULT="$(python3 -c {process_guard} token "$GATE_RECEIPT" 2>/dev/null)"
    GATE_RC=$?
    GATE_STATE="${{GATE_RESULT%% *}}"
    P="${{GATE_RECEIPT%%:*}}"
    case "$GATE_STATE:$GATE_RC" in
        TOKEN-MATCH:0) A=alive ;;
        TOKEN-ABSENT:0) A=dead ;;
        *) A=unknown ;;
    esac
else
    case "$RECEIPT_STATE:$RECEIPT_RC" in
        RECEIPT-MATCH:0) A=alive ;;
        RECEIPT-ABSENT:0) A=dead ;;
        *) A=unknown ;;
    esac
fi
echo "pid=$P runner_receipt=$RECEIPT_TOKEN gate_receipt=$GATE_RECEIPT receipt_state=$RECEIPT_STATE exit=$EC size=$SZ mtime=$MT alive=$A epoch=$(date +%s)"
"""


def probe(addr: str, rundir: str) -> dict:
    r = ssh(addr, PROBE.format(
        rundir=shlex.quote(rundir),
        process_guard=shlex.quote(PROCESS_GUARD_PROGRAM)), timeout=60)
    if r.returncode != 0:
        return {"ok": False, "err": r.stderr.strip() or "rc=%d" % r.returncode}
    out = {"ok": True}
    for tok in r.stdout.strip().split():
        if "=" in tok:
            k, v = tok.split("=", 1)
            out[k] = v
    return out


# ---------------------------------------------------------------------------
# forensics -- everything below runs BEFORE anything is killed
# ---------------------------------------------------------------------------
FORENSICS = r"""
PID="{pid}"; OUT="{out}"; RUNDIR="{rundir}"
mkdir -p "$OUT"
date -u +%Y-%m-%dT%H:%M:%SZ            > "$OUT/00_when.txt" 2>&1
uptime                                  > "$OUT/01_uptime.txt" 2>&1
cat /proc/loadavg                       > "$OUT/02_loadavg.txt" 2>&1
free -g                                 > "$OUT/03_free.txt" 2>&1
ps -eo pid,ppid,pgid,stat,etimes,rss,nlwp,comm,args --forest \
                                        > "$OUT/04_ps_forest.txt" 2>&1
ps -eo pid,ppid,stat,comm,args | awk '$3 ~ /Z/' \
                                        > "$OUT/05_zombies.txt" 2>&1
ps -eo pid,ppid,stat,comm | awk -v p="$PID" '$2==p' \
                                        > "$OUT/06_direct_children.txt" 2>&1
ps -eo pid,ppid,stat,comm | awk -v p="$PID" '$2==p && $3 ~ /Z/' | wc -l \
                                        > "$OUT/07_zombie_children_count.txt" 2>&1

cat /proc/$PID/status                   > "$OUT/10_master_status.txt" 2>&1
cat /proc/$PID/wchan                    > "$OUT/11_master_wchan.txt" 2>&1; echo >> "$OUT/11_master_wchan.txt"
# sudo: /proc/<pid>/syscall needs CAP_SYS_ADMIN even for your OWN process.
# Measured in this tool's selftest, which recorded "Operation not permitted"
# where the syscall number was supposed to be -- a file present and unreadable
# looks exactly like a file present and empty to anything reading the bundle.
sudo cat /proc/$PID/syscall             > "$OUT/12_master_syscall.txt" 2>&1
ls -l /proc/$PID/fd                     > "$OUT/13_master_fd.txt" 2>&1
ls /proc/$PID/fd 2>/dev/null | wc -l    > "$OUT/14_master_fd_count.txt" 2>&1
sudo cat /proc/$PID/stack               > "$OUT/15_master_kstack.txt" 2>&1
for t in /proc/$PID/task/*; do
  echo "== $t"; cat $t/comm 2>/dev/null; sudo cat $t/stack 2>/dev/null;
  echo "wchan: $(cat $t/wchan 2>/dev/null)"; echo;
done                                    > "$OUT/16_master_threads.txt" 2>&1

sudo ~/.local/bin/py-spy dump --pid "$PID" --nonblocking \
                                        > "$OUT/20_pyspy_master.txt" 2>&1
sudo ~/.local/bin/py-spy dump --pid "$PID" \
                                        > "$OUT/21_pyspy_master_blocking.txt" 2>&1
# --locals is the one that answers WHY rather than WHERE. xdist's loop_once
# spins while `self._active_nodes` is non-empty, so the length of that set and
# the scheduler's state are the whole question, and a plain dump shows neither.
sudo ~/.local/bin/py-spy dump --pid "$PID" --locals \
                                        > "$OUT/23_pyspy_master_locals.txt" 2>&1

for c in $(ps -eo pid,ppid,stat | awk -v p="$PID" '$2==p && $3 !~ /Z/ {{print $1}}'); do
  echo "=== child $c ==="
  ps -o pid,ppid,stat,etimes,comm,args -p $c 2>&1
  echo "wchan: $(cat /proc/$c/wchan 2>/dev/null)"
  sudo ~/.local/bin/py-spy dump --pid $c --nonblocking 2>&1 | head -30
  echo
done                                    > "$OUT/22_pyspy_children.txt" 2>&1

ls -la /tmp/bd-runctx/                  > "$OUT/30_runctx_all.txt" 2>&1
ls -la "/tmp/bd-runctx/$PID/"           > "$OUT/31_runctx_master.txt" 2>&1
# THE CONTENTS, not only the listing. Until 2026-08-14 this block recorded that
# the chain files EXIST and never what was in them -- so a wedge investigation
# could see "7 chains" and not which files any worker had been handed. A record
# that something exists is not a record of what it says.
for _c in "/tmp/bd-runctx/$PID/"*.chain; do
  [ -e "$_c" ] || continue
  echo "--- $_c ---"
  cat "$_c"
  echo
done                                    > "$OUT/33_runctx_chains.txt" 2>&1
cat "/tmp/bd-runctx/$PID/assignment.json" 2>/dev/null \
                                        > "$OUT/34_assignment.json" 2>&1
ls "/tmp/bd-runctx/$PID/" 2>/dev/null | grep -c '\.chain$' \
                                        > "$OUT/32_chain_count.txt" 2>&1
sudo dmesg -T 2>/dev/null | tail -200   > "$OUT/40_dmesg.txt" 2>&1
tail -200 "$RUNDIR/pytest.log"          > "$OUT/50_log_tail.txt" 2>&1
grep -a -n "node down\|Not properly terminated\|INTERNALERROR\|worker.*crashed" \
     "$RUNDIR/pytest.log" | tail -40    > "$OUT/51_log_nodedown.txt" 2>&1
stat -c '%s %Y' "$RUNDIR/pytest.log"    > "$OUT/52_log_stat.txt" 2>&1
echo done
"""


def forensics(addr: str, pid: str, rundir: str, out: str) -> dict:
    r = ssh(addr, FORENSICS.format(pid=pid, out=shlex.quote(out),
                                   rundir=shlex.quote(rundir)), timeout=600)
    return {"rc": r.returncode, "err": r.stderr.strip()[:600]}


def fetch(addr: str, remote: str, local: pathlib.Path) -> bool:
    local.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["rsync", "-a", "%s:%s/" % (addr, remote), str(local) + "/"],
                       capture_output=True, text=True, timeout=600)
    return r.returncode == 0


# ---------------------------------------------------------------------------
# one sample, end to end
# ---------------------------------------------------------------------------
RUNNER_REGISTRATION_OUTCOMES = {
    "91": ("REGISTRATION_REFUSED", "registry transaction definitely refused"),
    "92": ("REGISTRATION_UNKNOWN", "registry or owner settlement is unknown"),
    "93": ("REGISTERED_FAILURE", "registered workload handoff failed and reconciled"),
    "94": ("REGISTRATION_SETUP_FAILURE", "registration setup owners settled unsuccessfully"),
    "95": ("MEASUREMENT_REFUSED", "runner could not spawn its measurement owner"),
}


def record_runner_exit(row: dict, raw_status: str, rundir: str) -> None:
    """Classify registration lifecycle statuses before COMPLETED can default."""
    row["pytest_exit"] = raw_status
    outcome = RUNNER_REGISTRATION_OUTCOMES.get(raw_status)
    if outcome is None:
        return
    state, why = outcome
    artifacts = {
        "jobid": "%s/jobid" % rundir,
        "error": "%s/jobid.err" % rundir,
        "owners": "%s/registration-owners.log" % rundir,
        "runner_receipt": "%s/runner.receipt" % rundir,
        "gate_receipt": "%s/gate.receipt" % rundir,
        "authority_fds": "%s/registration-authority-fds.log" % rundir,
    }
    if raw_status == "95":
        artifacts["measurement_refusal"] = "%s/measurement-refusal" % rundir
    row.update({
        "state": state,
        "why": why,
        "registration_artifacts": artifacts,
    })


def run_one(label: str, addr: str, arm, idx: int, cfg) -> dict:
    name, extra, is_section5, arm_env, note = arm
    runid = "%s-%s-%03d-%s" % (label, name, idx,
                               datetime.datetime.now().strftime("%H%M%S"))
    rundir = "%s/%s" % (REMOTE_ROOT, runid)

    nproc = ssh(addr, "nproc", timeout=45)
    workers = nproc.stdout.strip() if nproc.returncode == 0 else ""
    # A FINDING IS ABOUT A COMMIT -- SAY WHICH ONE. Phase 1 did not record it in
    # the row; the runner wrote head_before into the run directory, but run
    # directories are pruned, so the commit for an old sample was recoverable
    # only from the fact that nobody had deployed. That is an argument, not a
    # record.
    head = ssh(addr, "cd ~/BulkDownloader && git rev-parse --short HEAD && "
                     "git status --porcelain | wc -l", timeout=45)
    head_sha, head_dirty = "UNKNOWN", "UNKNOWN"
    if head.returncode == 0:
        parts = head.stdout.split()
        if len(parts) >= 2:
            head_sha, head_dirty = parts[0], parts[1]
    if not workers.isdigit():
        return {"runid": runid, "host": label, "arm": name, "state": "REFUSED",
                "why": "could not read nproc from the target: %r" % nproc.stderr[:200],
                "when": now()}

    tokens = [t.replace("{workers}", workers) for t in SECTION5] + extra
    # The arm env goes in FRONT of `env -u BD_INSTALL_DIR ...`, so it is
    # exported into pytest and inherited by every xdist worker. Setting it
    # in the ssh shell instead would not survive `setsid nohup bash`.
    prefix = ["env"] + ["%s=%s" % (k, v) for k, v in sorted(arm_env.items())] \
        if arm_env else []
    tokens = prefix + tokens
    cmd = " ".join(shlex.quote(t) if " " in t else t for t in tokens)

    row = {"runid": runid, "host": label, "addr": addr, "arm": name, "idx": idx,
           "when_start": now(), "workers": int(workers),
           "workers_source": "the TARGET's own nproc, read at launch",
           "cmd": cmd, "arm_note": note, "arm_env": dict(arm_env),
           "commit": head_sha, "dirty_paths": head_dirty,
           # The `is_section5` arms are the sanctioned form PLUS two OBSERVABILITY
           # flags and nothing else: `-v` (section 5 specifies -q, which guards
           # xdist's report_line away at dsession.py:78) and `-u` (buffered stdout
           # strands the final ~4KB of every wedge, measured 15/15). Neither
           # changes what is executed, the distribution, the worker count or the
           # timeout -- but the older claim said "unmodified", and that word was
           # false the moment -v landed at @1125. Rows written before this fix
           # carry the false string; they are not rewritten, and this note is how
           # a later reader learns which claim to distrust.
           "section5": ("CLAUDE.md section 5's sanctioned whole-suite form, plus "
                        "-v and -u for observability only (see SECTION5's comment); "
                        "the executed selection, distribution, -n and --timeout are "
                        "unchanged, so these counts ARE whole-suite results"
                        if is_section5 else
                        "NOT the sanctioned whole-suite form -- a marker was added, "
                        "so this row's counts must never be read as a whole-suite "
                        "result"),
           "rundir": rundir}

    lr = launch(addr, rundir, cmd, "row102-wedge-hunt-%s" % name, "test5:bd-wedge-hunt")
    # These identities are predicted before the remote fork.  Preserve them
    # before interpreting the transport response: ssh can lose its reply after
    # the child starts, and that schedule still owns a cleanup obligation.
    runner_receipt_path = lr["runner_receipt"]
    row["runner_receipt"] = runner_receipt_path
    row["run_nonce"] = lr["run_id"]
    if lr["rc"] != 0 or "LAUNCHED=" not in lr["out"]:
        settlement = settle_ambiguous_launch(
            addr, runner_receipt_path, lr["run_id"])
        row.update({
            "state": "UNKNOWN",
            "why": "launch result ambiguous: %s / %s" %
                    (lr["out"][:200], lr["err"][:300]),
            "reap": settlement["verdict"],
            "launch_settlement": settlement,
            "when_end": now(),
        })
        return row

    say("%s %s: launched (%s)" % (label, name, runid))

    last_size, last_change, stall_seen, wedge_conf = -1, time.time(), None, 0
    started = time.time()
    forensic_tags = []
    # Bound BEFORE the loop: if STOP is already set when this sample launches,
    # the body never runs and the abandonment handler below still needs a pid
    # to reap. An unbound name there would raise inside the one path whose job
    # is cleaning up.
    p: dict = {}

    while not STOP.is_set():
        time.sleep(cfg.poll)
        p = probe(addr, rundir)
        if not p.get("ok"):
            row.setdefault("probe_errors", []).append(p.get("err", "?")[:200])
            if len(row["probe_errors"]) > cfg.max_probe_errors:
                # TRY, AND RECORD THE OUTCOME. A host that stopped answering
                # probes will usually refuse the reap too -- but "we could not
                # reach it" and "we never tried" are different facts, and only
                # the first one tells a later reader where to go looking.
                row.update({"state": "UNKNOWN",
                            "why": "the target stopped answering probes",
                            "reap": reap(addr, runner_receipt_path,
                                         "probe blackout"),
                            "when_end": now()})
                return row
            continue

        if p.get("exit") == "INVALID":
            row.update({
                "state": "REGISTRATION_UNKNOWN",
                "why": "runner completion record was empty or malformed",
                "outer_reap": reap(
                    addr, runner_receipt_path,
                    "malformed runner completion record"),
            })
            break

        if p.get("exit", "NONE") != "NONE":
            record_runner_exit(row, p["exit"], rundir)
            if p["exit"] in RUNNER_REGISTRATION_OUTCOMES:
                row["outer_reap"] = reap(
                    addr, runner_receipt_path,
                    "registration outcome %s" % p["exit"])
                if row["outer_reap"] != "REAP-OK":
                    row["inner_registration_state"] = row["state"]
                    row["state"] = (
                        "REGISTRATION_RETAINED"
                        if row["outer_reap"] == "REAP-SURVIVED"
                        else "REGISTRATION_UNKNOWN")
                    row["why"] = (
                        "registration outcome %s had unproved outer process "
                        "restoration: %s" %
                        (p["exit"], row["outer_reap"]))
            break

        size = int(p.get("size", -1))
        if size != last_size:
            last_size, last_change = size, time.time()
            stall_seen = None
        quiet = time.time() - last_change

        if quiet >= cfg.stall and p.get("alive") == "alive":
            if stall_seen is None:
                stall_seen = time.time()
                tag = "stall1"
                say("%s %s: NO LOG GROWTH for %ds -- forensics (%s)"
                    % (label, name, int(quiet), tag))
                fout = "%s/forensics-%s" % (rundir, tag)
                forensics(addr, p.get("pid", "0"), rundir, fout)
                forensic_tags.append(tag)
                row["stall_first_seen_after_s"] = int(quiet)
            elif time.time() - stall_seen >= cfg.confirm:
                wedge_conf += 1
                tag = "wedge-confirm%d" % wedge_conf
                say("%s %s: STILL silent %ds later -- WEDGE CONFIRMED (%s)"
                    % (label, name, int(time.time() - stall_seen), tag))
                fout = "%s/forensics-%s" % (rundir, tag)
                forensics(addr, p.get("pid", "0"), rundir, fout)
                forensic_tags.append(tag)
                row.update({"state": "WEDGED", "wedged": True,
                            "quiet_seconds_at_kill": int(quiet),
                            "master_pid": p.get("pid")})
                # SIGINT FIRST, AND THE REASON IS EVIDENCE, NOT POLITENESS.
                # The master's stdout is a FILE, so it is block-buffered; a
                # SIGKILL discards whatever has not been flushed. The first
                # wedge this tool caught lost the line after "F" that way, and
                # its absence from the log was nearly read as a fact about
                # xdist. SIGINT makes pytest unwind, print its summary and
                # flush; only then is SIGKILL used, and the log is re-fetched
                # afterwards so the flushed tail is captured.
                pid = p.get("pid", "0")
                gate_receipt = p.get("gate_receipt", "UNKNOWN")
                try:
                    interrupt_command = signal_receipt_cmd(gate_receipt, "INT")
                except ValueError:
                    row["interrupt"] = "SIGNAL-UNKNOWN-NORECEIPT"
                else:
                    interrupted = ssh(addr, interrupt_command, timeout=60)
                    row["interrupt"] = (
                        (interrupted.stdout or "").strip()
                        or "SIGNAL-UNKNOWN-TRANSPORT")
                time.sleep(cfg.sigint_grace)
                fout2 = "%s/forensics-after-sigint" % rundir
                forensics(addr, pid, rundir, fout2)
                forensic_tags.append("after-sigint")
                row["reap"] = reap(addr, runner_receipt_path,
                                   "wedge confirmed")
                break

        if time.time() - started > cfg.cap:
            row.update({"state": "CAPPED", "why": "exceeded the %ds whole-run cap"
                        % cfg.cap, "master_pid": p.get("pid")})
            fout = "%s/forensics-capped" % rundir
            forensics(addr, p.get("pid", "0"), rundir, fout)
            forensic_tags.append("capped")
            # Was a pid-only kill while the wedge branch four lines above killed
            # the GROUP -- same job, two spellings, and this one left up to 48
            # workers behind. Backlog 146.
            row["reap"] = reap(addr, runner_receipt_path, "whole-run cap")
            break

    # THE LOOP HAS FOUR EXITS AND ONLY ONE OF THEM IS A FINISHED RUN. A `break`
    # after a real pytest exit is a completion; the wedge and cap branches have
    # already set a state; falling out of `while not STOP.is_set()` is an
    # ABANDONMENT -- and it used to land on `setdefault("state", "COMPLETED")`,
    # so a sample nobody waited for was recorded as a completed NON-WEDGE. That
    # is a false negative in the denominator the whole hunt turns on. It never
    # fired during the 2026-08-14 run (measured: 686 of 686 COMPLETED rows carry
    # a real pytest_exit, because the interrupt killed the daemon threads before
    # any of them could write), which makes it latent rather than historical.
    if "state" not in row and "pytest_exit" not in row:
        row.update({"state": "ABANDONED",
                    "why": "the hunt stopped while this sample was in flight",
                    "master_pid": p.get("pid"),
                    "reap": reap(addr, runner_receipt_path, "hunt stopped")})
    row["when_end"] = now()
    row["forensics"] = forensic_tags
    row.setdefault("state", "COMPLETED")
    row.setdefault("wedged", row["state"] == "WEDGED")

    tail = ssh(addr, "R=%s; tail -25 $R/pytest.log; echo '---SUMMARY---'; "
                     "grep -a -E '^[0-9]+ (passed|failed)|passed|failed|error' "
                     "$R/pytest.log | tail -3; echo '---NODEDOWN---'; "
                     "grep -a -c 'node down' $R/pytest.log; echo '---WALL---'; "
                     "echo $(( $(cat $R/epoch_end 2>/dev/null || date +%%s) - "
                     "$(cat $R/epoch_start 2>/dev/null || echo 0) ))"
               % shlex.quote(rundir), timeout=90)
    if tail.returncode == 0:
        parts = tail.stdout.split("---SUMMARY---")
        row["log_tail"] = parts[0].strip()[-1800:]
        if len(parts) > 1:
            rest = parts[1].split("---NODEDOWN---")
            row["summary_lines"] = rest[0].strip()[-600:]
            if len(rest) > 1:
                nd = rest[1].split("---WALL---")
                row["node_down_count"] = nd[0].strip()
                if len(nd) > 1:
                    row["wall_seconds"] = nd[1].strip()

    if forensic_tags:
        local = pathlib.Path(cfg.outdir) / "forensics" / runid
        for tag in forensic_tags:
            fetch(addr, "%s/forensics-%s" % (rundir, tag), local / tag)
        fetch(addr, rundir, local / "rundir")
        row["forensics_local"] = str(local)

    logdst = pathlib.Path(cfg.outdir) / "logs" / ("%s.log" % runid)
    # Create the parent HERE, not only in main(): rsync onto a missing directory
    # fails silently from the row's point of view and records log_local=None,
    # which reads as "no log" rather than "the log was not fetched". Caught by
    # this tool's own selftest, which ran with a different --outdir.
    logdst.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["rsync", "-a", "%s:%s/pytest.log" % (addr, rundir), str(logdst)],
                   capture_output=True, text=True, timeout=600)
    row["log_local"] = str(logdst) if logdst.exists() else None

    ssh(addr, "ls -1dt %s/*/ 2>/dev/null | tail -n +%d | xargs -r rm -rf"
              % (REMOTE_ROOT, cfg.keep_remote + 1), timeout=90)
    return row


def host_loop(label: str, addr: str, offset: int, cfg) -> None:
    idx = 0
    arms = ARMS_BY_HOST[label]
    while not STOP.is_set():
        arm = arms[idx % len(arms)]
        try:
            row = run_one(label, addr, arm, idx, cfg)
        except Exception as exc:                  # noqa: BLE001
            row = {"host": label, "arm": arm[0], "idx": idx, "state": "DRIVER-ERROR",
                   "why": repr(exc), "when": now()}
        with ROW_LOCK:
            with open(pathlib.Path(cfg.outdir) / "rows.jsonl", "a",
                      encoding="utf-8") as fh:
                fh.write(json.dumps(row) + "\n")
        say("%s %s #%d -> %s%s" % (label, arm[0], idx, row.get("state"),
                                   "  *** WEDGE ***" if row.get("wedged") else ""))
        idx += 1
        if cfg.max_per_host and idx >= cfg.max_per_host:
            say("%s: reached --max-per-host %d" % (label, cfg.max_per_host))
            return


def sweep_test_roots(addr: str) -> subprocess.CompletedProcess:
    """Bound abandoned/forensics roots before this harness adds another."""
    return ssh(
        addr,
        'cd "$HOME/BulkDownloader" && '
        'venv/bin/python toolchain/bin/bd-gc --apply --older-than 1440 '
        '--only classified',
        timeout=300,
    )


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="bd-wedge-hunt", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--outdir", default=str(pathlib.Path.home() / "bd-wedge-2026-08-14"))
    p.add_argument("--poll", type=int, default=30, help="seconds between probes")
    p.add_argument("--stall", type=int, default=300,
                   help="no log growth for this long triggers forensics. 300 is "
                        "above --timeout=240, so no single slow test explains it.")
    p.add_argument("--confirm", type=int, default=420,
                   help="a stall still silent this much later is a WEDGE")
    p.add_argument("--cap", type=int, default=7200, help="whole-run cap, seconds")
    p.add_argument("--sigint-grace", type=int, default=90, dest="sigint_grace",
                   help="seconds between SIGINT and SIGKILL, so the master can "
                        "flush its block-buffered stdout before it is destroyed")
    p.add_argument("--max-per-host", type=int, default=0, dest="max_per_host")
    p.add_argument("--max-probe-errors", type=int, default=20, dest="max_probe_errors")
    p.add_argument("--keep-remote", type=int, default=6, dest="keep_remote")
    p.add_argument("--hours", type=float, default=0,
                   help="stop launching new samples after this many hours")
    cfg = p.parse_args(argv)

    out = pathlib.Path(cfg.outdir)
    (out / "forensics").mkdir(parents=True, exist_ok=True)
    (out / "logs").mkdir(parents=True, exist_ok=True)
    say("bd-wedge-hunt starting. %s"
        % "  ".join("%s:%s" % (h, [a[0] for a in ARMS_BY_HOST[h]])
                    for h, _ in HOSTS))
    say("rows -> %s" % (out / "rows.jsonl"))

    for label, addr in HOSTS:
        swept = sweep_test_roots(addr)
        if swept.returncode:
            say("%s: test-root sweep UNKNOWN/failed rc=%d; continuing without "
                "treating cleanup as complete" % (label, swept.returncode))

    threads = []
    for i, (label, addr) in enumerate(HOSTS):
        t = threading.Thread(target=host_loop, args=(label, addr, i, cfg),
                             name=label, daemon=True)
        t.start()
        threads.append(t)
        time.sleep(5)

    deadline = time.time() + cfg.hours * 3600 if cfg.hours else None
    try:
        while any(t.is_alive() for t in threads):
            time.sleep(10)
            if deadline and time.time() > deadline:
                # SAY WHAT IT DOES. This read "letting in-flight samples
                # finish", which the monitor loop's own `while not STOP.is_set()`
                # makes impossible: every in-flight sample drops out on the next
                # tick. The message described an intention and the code did the
                # opposite, which is how backlog 146 acquired a wrong diagnosis.
                say("--hours reached; in-flight samples will be ABANDONED and "
                    "reaped on the next tick")
                STOP.set()
                break
        for t in threads:
            t.join(timeout=cfg.cap + 600)
    except KeyboardInterrupt:
        # JOIN, DO NOT JUST RETURN. These threads are daemon=True, so returning
        # here lets the interpreter kill them at exit -- taking with them both
        # the reap of the remote run AND the unwritten row describing it. That
        # is the whole of backlog 146's five orphaned masters, and it is also
        # why rows.jsonl held ZERO abandoned rows after a 19h interrupted hunt:
        # they were never mis-recorded, they were never recorded.
        say("interrupted -- setting STOP and waiting for each in-flight sample "
            "to reap its remote run and record what happened")
        STOP.set()
        for t in threads:
            t.join(timeout=cfg.poll + 120)
        alive = [t.name for t in threads if t.is_alive()]
        if alive:
            say("WARNING: %d host thread(s) did not finish reaping: %s -- check "
                "for orphaned masters by hand" % (len(alive), ", ".join(alive)))
    say("bd-wedge-hunt done")
    return 0


if __name__ == "__main__":
    sys.exit(main())
