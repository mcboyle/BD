if len(sys.argv) != 4:
    raise SystemExit(95)
terminal_path, gate_program, workload_shim = sys.argv[1:]
terminal_fd = os.open(terminal_path, os.O_WRONLY)
os.set_inheritable(terminal_fd, True)
if terminal_fd != 3:
    os.dup2(terminal_fd, 3, inheritable=True)
    os.close(terminal_fd)
