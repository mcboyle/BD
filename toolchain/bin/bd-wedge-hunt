REGISTRATION_TERMINAL_RELAY_PROGRAM = r'''\
import os
import select
import sys


if len(sys.argv) != 2:
    raise SystemExit(95)
expected_parent = int(sys.argv[1])
while True:
    if os.getppid() != expected_parent:
        raise SystemExit(97)
    readable, _, _ = select.select([0], [], [], 0.05)
    if not readable:
        continue
    chunk = os.read(0, 65536)
    if not chunk:
        raise SystemExit(0)
    view = memoryview(chunk)
    while view:
        written = os.write(1, view)
        if written <= 0:
