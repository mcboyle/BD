#!/usr/bin/env python3
"""bd-crx-check -- validate the Chromium extension pack (Batch B EXT-4).

Static safety audit of the MV3 extension manifest(s) in the tree: confirms
manifest_version 3, enumerates permissions + host_permissions and flags the
broad ones (<all_urls>, tabs, scripting, cookies, webRequest, debugger),
verifies referenced files (service_worker, popup, options, content scripts,
icons) exist, and reports a permission-risk summary. Read-only. No unpacking of
untrusted .crx -- it audits the shipped source extension dir.

Usage: bd-crx-check [--work DIR] [--ext-dir extension] [--json] [--selftest]
Exit 0 if manifest valid + no missing files, else 1.
"""
import argparse
import glob
import json
import os
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

BROAD_PERMS = {"<all_urls>", "tabs", "scripting", "cookies", "webRequest",
               "webRequestBlocking", "debugger", "management", "proxy",
               "nativeMessaging", "declarativeNetRequest"}


def _referenced_files(man):
    refs = set()
    if "background" in man and isinstance(man["background"], dict):
        sw = man["background"].get("service_worker")
        if sw:
            refs.add(sw)
    act = man.get("action", {})
    if isinstance(act, dict):
        if act.get("default_popup"):
            refs.add(act["default_popup"])
        for _sz, ic in (act.get("default_icon", {}) or {}).items():
            refs.add(ic)
    if man.get("options_page"):
        refs.add(man["options_page"])
    for cs in man.get("content_scripts", []) or []:
        for j in cs.get("js", []) or []:
            refs.add(j)
        for c in cs.get("css", []) or []:
            refs.add(c)
    for _sz, ic in (man.get("icons", {}) or {}).items():
        refs.add(ic)
    return sorted(refs)


def audit(work, ext_dir):
    manpath = os.path.join(work, ext_dir, "manifest.json")
    out = {"manifest": manpath, "found": os.path.exists(manpath),
           "mv3": None, "permissions": [], "host_permissions": [],
           "broad": [], "missing_files": [], "referenced": [], "error": None}
    if not out["found"]:
        # try any manifest under the tree with manifest_version 3
        for c in glob.glob(os.path.join(work, "**", "manifest.json"), recursive=True):
            if "node_modules" in c:
                continue
            try:
                m = json.load(open(c))
            except Exception:  # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
                continue
            if m.get("manifest_version") == 3 and (m.get("permissions") or m.get("action")):
                manpath = c
                out["manifest"] = c
                out["found"] = True
                break
    if not out["found"]:
        out["error"] = "no MV3 manifest.json found"
        return out
    try:
        man = json.load(open(out["manifest"]))
    except Exception as e:
        out["error"] = f"manifest not JSON: {e}"
        return out
    out["mv3"] = man.get("manifest_version") == 3
    out["permissions"] = list(man.get("permissions", []) or [])
    out["host_permissions"] = list(man.get("host_permissions", []) or [])
    allp = set(out["permissions"]) | set(out["host_permissions"])
    out["broad"] = sorted(allp & BROAD_PERMS)
    out["referenced"] = _referenced_files(man)
    base = os.path.dirname(out["manifest"])
    out["missing_files"] = [f for f in out["referenced"]
                            if not os.path.exists(os.path.join(base, f))]
    return out


def selftest():
    ok = True
    with tempfile.TemporaryDirectory() as d:
        ext = os.path.join(d, "extension")
        os.makedirs(ext)
        man = {"manifest_version": 3, "name": "T", "version": "1.0",
               "permissions": ["storage", "tabs", "scripting"],
               "host_permissions": ["<all_urls>"],
               "background": {"service_worker": "bg.js"},
               "action": {"default_popup": "popup.html"}}
        json.dump(man, open(os.path.join(ext, "manifest.json"), "w"))
        open(os.path.join(ext, "bg.js"), "w").write("//")   # popup.html missing
        res = audit(d, "extension")
    good = (res["mv3"] and set(res["broad"]) == {"<all_urls>", "tabs", "scripting"}
            and res["missing_files"] == ["popup.html"])
    print(("PASS" if good else "FAIL") +
          f"  fixture: mv3, broad perms detected, popup.html missing "
          f"(broad={res['broad']}, missing={res['missing_files']})")
    ok &= good
    real = audit(sec.DEFAULT_WORK, "extension")
    rgood = real["found"] and real["mv3"]
    print(("PASS" if rgood else "FAIL") +
          f"  real extension: mv3={real['mv3']}, {len(real['permissions'])} perms, "
          f"broad={real['broad']}, missing={len(real['missing_files'])}")
    ok &= bool(rgood)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--ext-dir", default="extension")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    res = audit(a.work, a.ext_dir)
    valid = res["found"] and res["mv3"] and not res["missing_files"]
    if sec.emit(res, as_json=a.json):
        return 0 if valid else 1
    if not res["found"]:
        print(f"{R}no MV3 manifest{RST}: {res['error']}")
        return 1
    mv = (G + "MV3" + RST) if res["mv3"] else (R + "NOT MV3" + RST)
    print(f"extension manifest: {mv}  {DIM}{res['manifest']}{RST}")
    print(f"  permissions: {', '.join(res['permissions']) or '(none)'}")
    print(f"  host_permissions: {', '.join(res['host_permissions']) or '(none)'}")
    if res["broad"]:
        print(f"  {Y}broad permissions:{RST} {', '.join(res['broad'])}")
    if res["missing_files"]:
        print(f"  {R}missing referenced files:{RST} {', '.join(res['missing_files'])}")
    else:
        print(f"  {G}all {len(res['referenced'])} referenced files present{RST}")
    return 0 if valid else 1


sys.exit(main())
