#!/usr/bin/env bash
# bd-reindex -- regenerate ALL generated indices under the SERVICE VENV.
#
# WHY: bd-cut regenerates ROUTE_INDEX.json + reports/gui_parity_inventory.json under
# the `bd` prestaged env, where /api/scrape_listing does NOT register -> the shipped
# indices drop that route (and mis-set operator_facing) -> on-stash FAIL of
# test_route_index_in_sync + test_v3_66_302_gui_parity_reconcile (this bit us in
# 602/603). Run this after bd-cut's bump and BEFORE build_release, then run
# build_release + verify_release under the venv too.
#
# Usage: bd-reindex [WORKDIR|--work DIR|--tree DIR] (default: this checkout)
#   env: BD_VENV_PY (default <work>/venv/bin/python; REFUSES if it cannot
#        import the project deps -- see @878)
set -u
# default to the canonical work tree, NOT the caller's cwd: invoked from
# outside the checkout every tools/ path missed and all regens ERR'd (first-ever
# execution, v3.66.688 review). --work/--tree accepted per suite convention.
# --selftest: this is a bootstrap/orchestration script; a real run IS its test.
case " $* " in *" --selftest "*)
  echo "SKIP: needs a full source tree to reindex"
  echo "SELFTEST PASS"; exit 0;; esac
_bd_explicit=""
_bd_has_explicit=0
if [ "${1:-}" = "--work" ] || [ "${1:-}" = "--tree" ]; then
    _bd_explicit="${2:?--work needs a dir}"
    _bd_has_explicit=1
elif [ -n "${1:-}" ]; then
    _bd_explicit="$1"
    _bd_has_explicit=1
fi
_bd_tool_file="$(readlink -f "${BASH_SOURCE[0]}")" || exit 2
_bd_tool_dir="$(CDPATH= cd -- "$(dirname -- "$_bd_tool_file")" && pwd -P)" || exit 2
[ -f "$_bd_tool_dir/_bd_work_tree.py" ] || {
  echo "BD-WORK-TREE-UNRUNNABLE: resolver missing beside physical tool" >&2; exit 2;
}
if [ "$_bd_has_explicit" -eq 1 ]; then
  WORK="$(python3 "$_bd_tool_dir/_bd_work_tree.py" --work "$_bd_explicit")" || exit 2
else
  WORK="$(python3 "$_bd_tool_dir/_bd_work_tree.py")" || exit 2
fi
# @878 -- REFUSE an interpreter that cannot import the deps.
# This defaulted to a venv under the retired sandbox work root and fell through
# to bare `python3` when that was absent -- which on a git checkout is ALWAYS,
# and which
# CLAUDE.md section 5 records as 3.11 WITHOUT the project dependencies.
# bd-reindex then regenerated PIN_INDEX, ROUTE_INDEX, gui_parity_inventory,
# FUNCTION_INDEX and the dependency graph under it: the exact artifacts
# test_pin_index_in_sync and friends check. An interpreter that cannot import
# the deps cannot regenerate an artifact, and writing one anyway is worse than
# writing none.
VENV_PY="${BD_VENV_PY:-$WORK/venv/bin/python}"
if ! [ -x "$VENV_PY" ] || ! "$VENV_PY" -c "import pytest" >/dev/null 2>&1; then
  echo "BD-REINDEX UNEVALUABLE: $VENV_PY cannot import the project deps." >&2
  echo "  Regenerating an artifact under it would write a gate's subject from" >&2
  echo "  an interpreter that cannot run the gate. Set BD_VENV_PY to the venv." >&2
  exit 2
fi
cd "$WORK" || { echo "no such dir: $WORK"; exit 1; }
echo "bd-reindex: $VENV_PY  (PYTHONPATH=$WORK)"
for t in build_pin_index.py build_route_index.py "gui_parity_inventory.py --root ." build_function_index.py dependency_graph.py; do
  env -u PYTHONPATH PYTHONPATH="$WORK"     "$VENV_PY" tools/$t >/tmp/bd-reindex.log 2>&1 \
      && echo "  OK  tools/$t" || { echo "  ERR tools/$t"; tail -3 /tmp/bd-reindex.log; }
done
"$VENV_PY" - <<'PY'
import json
try:
    rs=[r for r in json.load(open("ROUTE_INDEX.json"))["routes"]
        if r.get("endpoint")=="scrape_listing.api_scrape_listing"]
    v = rs[0].get("operator_facing") if rs else "MISSING"
    print(f"  sanity: scrape_listing operator_facing = {v}  ({'OK' if v is True else 'CHECK'})")
except Exception as e:
    print("  sanity check failed:", e)
PY
