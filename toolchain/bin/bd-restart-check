#!/usr/bin/env python3
"""bd-restart-check -- did the container restart WITHOUT the session hook running?

THE QUESTION THIS EXISTS FOR. `.claude/hooks/session-start.sh` repairs a
rolled-back checkout and reconverges the environment, but it only ever runs on a
SessionStart event (startup|resume|clear|compact). Whether a mid-session
CONTAINER RESTART generates one of those is unknown -- the hook's comments and
its tests both assume it does, and neither establishes it. If it does not, a
rollback sits unrepaired for the rest of the session and every source read after
it is against a stale tree, which is the failure that started this whole line of
work.

WHY THE OBVIOUS INSTRUMENT CANNOT ANSWER IT. A hook that logs its own runs
cannot record the runs it did not make: if SessionStart never fires, nothing
writes anything, and absence of a log entry is indistinguishable from a hook
that was never installed. That is CLAUDE.md section 0 -- a check whose
denominator structurally excludes its subject.

WHY BOOT_ID DOES. /proc/sys/kernel/random/boot_id is regenerated by the kernel
on every boot, so it is a durable, positive marker of "the machine underneath
you changed". The hook records it each time it runs. Comparing the CURRENT value
against that record turns the unobservable negative into an observable positive.

AND WHY THIS IS A TOOL RATHER THAN A HOOK-TIME CHECK. A mismatch measured AT
hook time is ambiguous: "restart fired SessionStart" and "restart fired nothing,
then a new session started later" produce the identical reading, because in both
cases the hook is running now and the last record predates the restart. The
reading is only unambiguous MID-SESSION -- if boot_id differs while no new
session has begun, then the hook demonstrably did not run for that restart. So
the comparison has to be available on demand, which is this.

    exit 0  no restart since the hook last ran
    exit 1  RESTARTED and the hook has not run since -- if you have not started
            a new session, SessionStart does not fire on a container restart
    exit 2  UNEVALUABLE -- no record, or no boot_id on this kernel. Unknown is a
            third state and it is not a softer 0.

Usage: bd-restart-check [--state PATH] [--json] [--selftest]
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import sys

BOOT_ID = pathlib.Path("/proc/sys/kernel/random/boot_id")
EXIT_OK, EXIT_RESTARTED, EXIT_UNEVALUABLE = 0, 1, 2


def default_state() -> pathlib.Path:
    """Where the hook records what it saw.

    Under $HOME rather than in the repo: it must not appear in `git status`
    (the rollback predicate reads that) and must not be a gitignored artifact
    a `git clean -x` would sweep. Overridable so the tests never touch a real
    home directory.
    """
    return pathlib.Path(os.environ.get("HOME", "/root")) / ".bd_boot_state"


def current_boot_id() -> str | None:
    try:
        v = BOOT_ID.read_text().strip()
    except OSError:
        return None
    return v or None


def recorded(state: pathlib.Path) -> dict | None:
    try:
        lines = state.read_text().splitlines()
    except OSError:
        return None
    if not lines or not lines[0].strip():
        return None
    return {
        "boot_id": lines[0].strip(),
        "when": lines[1].strip() if len(lines) > 1 else "unknown",
        "source": lines[2].strip() if len(lines) > 2 else "unknown",
        # @969. Lines 3-4 are the boot the hook REPLACED, written only when it
        # differed. Positional and appended rather than a new format, so an
        # older 3-line record still parses -- a reader that raised on the short
        # form would fail every session started before this landed.
        "prev_boot_id": lines[3].strip() if len(lines) > 3 else "",
        "prev_when": lines[4].strip() if len(lines) > 4 else "",
    }


def classify(cur: str | None, rec: dict | None) -> dict:
    """Pure, so the three states can be driven without a kernel or a filesystem.

    Every guard in this repo that could only fire in a tree state nobody can
    construct has escaped its mutation battery. Keeping the verdict in a pure
    function is what makes the UNEVALUABLE branches testable at all.
    """
    if cur is None:
        return {"status": "unevaluable", "exit": EXIT_UNEVALUABLE,
                "detail": "no %s on this kernel -- cannot identify the boot"
                          % BOOT_ID}
    if rec is None:
        return {"status": "unevaluable", "exit": EXIT_UNEVALUABLE,
                "detail": "no record from the session hook. It has not run "
                          "since this state file was last cleared, so there is "
                          "nothing to compare against -- which is UNKNOWN, not "
                          "'no restart'."}
    if rec["boot_id"] == cur:
        detail = ("boot unchanged since the hook last ran (%s, source=%s)"
                  % (rec["when"], rec["source"]))
        # @969, item 17. A transition the hook already carried forward is NOT a
        # live unrepaired restart -- the hook ran, so the repair path fired.
        # Reporting it as EXIT_RESTARTED would overload an exit code whose
        # documented meaning is "and the hook has NOT run since", and would send
        # a reader to re-provision an environment that already reconverged. It
        # belongs in the detail, where it answers the question item 17 was
        # actually asking.
        prev = rec.get("prev_boot_id") or ""
        if prev:
            detail += ("; a RESTART was observed and already re-recorded: the "
                       "previous boot %s (last seen %s) is gone and the hook "
                       "fired after it, so SessionStart DOES follow a container "
                       "restart and the repair path ran"
                       % (prev, rec.get("prev_when") or "unknown"))
        return {"status": "ok", "exit": EXIT_OK, "detail": detail}
    return {"status": "restarted", "exit": EXIT_RESTARTED,
            "detail": "the container REBOOTED since the hook last ran (%s, "
                      "source=%s) and the hook has NOT run since. If you have "
                      "not started a new session, a mid-session container "
                      "restart does not fire SessionStart -- so a rolled-back "
                      "checkout is UNREPAIRED and every source read is suspect. "
                      "Re-run: bash scripts/cloud-setup.sh" % (rec["when"],
                                                               rec["source"])}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--state")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    state = pathlib.Path(a.state) if a.state else default_state()
    v = classify(current_boot_id(), recorded(state))
    if a.json:
        print(json.dumps({**v, "state_file": str(state)}))
    else:
        tag = {"ok": "OK", "restarted": "RESTARTED",
               "unevaluable": "UNEVALUABLE"}[v["status"]]
        print("%-12s %s" % (tag, v["detail"]))
    return v["exit"]


def selftest() -> int:
    """Drives all three states through the pure classifier."""
    cases = [
        ("no boot_id -> unevaluable", classify(None, {"boot_id": "x", "when": "w", "source": "s"}), EXIT_UNEVALUABLE),
        ("no record -> unevaluable", classify("abc", None), EXIT_UNEVALUABLE),
        ("same boot -> ok", classify("abc", {"boot_id": "abc", "when": "w", "source": "s"}), EXIT_OK),
        ("different boot -> restarted", classify("abc", {"boot_id": "zzz", "when": "w", "source": "s"}), EXIT_RESTARTED),
        # @969. The fourth state: a restart the hook already carried forward.
        # Exit stays OK -- the hook ran -- but it must SAY so, or the field is
        # written and never surfaced. The substring is checked because an exit
        # code alone cannot distinguish this from an ordinary unchanged boot,
        # which is the whole point of recording it.
        ("restart re-recorded -> ok AND said so",
         classify("abc", {"boot_id": "abc", "when": "w", "source": "resume",
                          "prev_boot_id": "zzz", "prev_when": "w0"}),
         EXIT_OK, "RESTART was observed", None),
        # The forbidden string is the transition CLAIM, not the word "restart".
        # A first draft forbade the bare word and failed two CORRECT cases whose
        # details legitimately say "restart" -- the unevaluable branch explaining
        # that UNKNOWN is "not 'no restart'", and the restarted branch itself.
        # A predicate ranging over cases it does not mean is section 0's shape,
        # and it appeared here inside the check written to prevent it.
        ("no transition -> ok and makes NO transition claim",
         classify("abc", {"boot_id": "abc", "when": "w", "source": "s"}),
         EXIT_OK, None, "RESTART was observed"),
    ]
    bad = 0
    for case in cases:
        name, got, want = case[0], case[1], case[2]
        need = case[3] if len(case) > 3 else None
        forbid = case[4] if len(case) > 4 else None
        ok = got["exit"] == want
        if ok and need is not None:
            ok = need in got["detail"]
        if ok and forbid is not None:
            ok = forbid not in got["detail"]
        bad += 0 if ok else 1
        print("%s  %s (got exit %d, want %d)" % ("PASS" if ok else "FAIL", name,
                                                 got["exit"], want))
    print("SELFTEST PASS" if not bad else "SELFTEST FAIL")
    return 0 if not bad else 1


if __name__ == "__main__":
    sys.exit(main())
