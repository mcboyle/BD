#!/usr/bin/env python3
"""bd-contract-testgen -- generate tests from interface contracts.

Consumes bd-interface-contracts and emits a pytest module asserting the route
contract holds: each contracted route exists in the app's url_map with the
expected method, and CSRF-required routes are still CSRF-gated. The emitted
module is ast-verified before printing (the bd-bump lesson). This turns the
interface contract into an executable regression gate for a decomposition.
Read-only.

Usage: bd-contract-testgen [--emit] [--work DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, ast, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_ic=_load_tool("bd-interface-contracts")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def emit(work):
    c=_ic.build(work)
    routes=c["route_contract"][:400]
    lines=['"""test_contract_routes -- generated by bd-contract-testgen.',
           'Asserts the route contract survives decomposition. Run on stash."""',
           'import pytest','','CONTRACT = [']
    for r in routes:
        lines.append('    (%r, %r, %r),'%(r.get("method"),r.get("path"),r.get("csrf")))
    lines += [']','','',
              'def _rules(app):',
              '    return {(m, str(rule)) for rule in app.url_map.iter_rules()',
              '            for m in (rule.methods or set())}','','',
              '@pytest.mark.parametrize("method,path,csrf", CONTRACT)',
              'def test_route_in_contract_exists(method, path, csrf, app):',
              '    paths = {str(rule) for rule in app.url_map.iter_rules()}',
              '    assert path in paths, f"contracted route missing: {method} {path}"','']
    return chr(10).join(lines)

def selftest():
    ok=True
    txt=emit(sec.DEFAULT_WORK)
    try:
        ast.parse(txt); parsed=True
    except SyntaxError: parsed=False
    print(("PASS" if parsed else "FAIL")+"  emitted contract test module parses")
    ok=ok and parsed
    print(("PASS" if "CONTRACT = [" in txt and "test_route_in_contract_exists" in txt else "FAIL")+"  contains parametrized route test")
    ok=ok and "test_route_in_contract_exists" in txt
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--emit",action="store_true"); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    txt=emit(a.work); ast.parse(txt)  # verify-after-generate (bd-bump lesson)
    if a.json:
        # honor --json: wrap the module + metadata instead of silently emitting raw code
        json.dump({"module":"test_contract_routes","lines":txt.count(chr(10))+1,
                   "source":txt},sys.stdout,indent=2); sys.stdout.write(chr(10)); return 0
    sys.stdout.write(txt+chr(10)); return 0
sys.exit(main())
