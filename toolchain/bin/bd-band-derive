#!/usr/bin/env python3
"""bd-band-derive -- one diff-derived band engine (Plan D / INV-2).

Unifies the three overlapping derivers (bd-touched / bd-suites / bd-blast) into one
engine over the two AUTHORITATIVE signals. The band a cut must run is derived from
the diff -- never remembered.

Signals (unioned, per changed file):
  1. FILENAME-STEM GLOB -- tests/**/*<stem>*.py   (bd-blast's proven signal:
     detect.py -> the 18 test_*detect*.py suites)
  2. THE CURATED MAP -- TOUCHED_FILE_TO_TEST.md rows whose SURFACE CELL names the
     file, contributing suites that do NOT share the filename
     (detect.py -> test_extraction_core). bd-blast misses these: the map stores BARE
     names and bd-blast only extracts `tests/...py` paths.
  3. COUNT-COUPLING -- declared coupling: a test that exercises a module WITHOUT
     importing it or sharing its name, by pinning a COUNT (bit@702).
  4. MODULE-CONSUMER -- every test that IMPORTS or NAMES the changed module,
     whatever the test is called. Signals 1-3 are a filename glob, a hand-written
     map, and a declared count -- none of them is "who actually consumes this
     module", so a consumer under an unrelated name was INVISIBLE. That gap caused
     the 712 STASH RED and forced a by-hand `grep -rl <module> tests/` on every cut
     since. Now mechanized. (Witness: ffmpeg_bin.py is consumed by
     test_v3_66_720_oidc_and_ffmpeg.py, which signal 1 cannot see.)

Only suites that EXIST on disk are ever emitted (never invent a band).

HISTORY (why the matching is cell-scoped): an earlier build tested `token in relpath`
-- a substring test -- so one map row whose surface cell contained a token common to
every path matched EVERYTHING, and the tool returned a near-CONSTANT band regardless
of input. A wrong band is worse than none: the cut bands the wrong suites and goes
GREEN on a regression. The selftest now asserts (a) superset-equivalence with
bd-blast and (b) distinct files -> distinct bands.

  bd-band-derive                    # DIFF: work tree vs source zip
  bd-band-derive --file  <path>     # one file's full radius   (was bd-blast)
  bd-band-derive --files a.py b.py  # explicit changed set     (was bd-suites)
  bd-band-derive --emit             # print only the `bd-band ...` line
  bd-band-derive --json / --selftest
"""
import argparse
import fnmatch
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import zipfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # @807 (R1): the ONE guard-set derivation

# @807 (R1): DERIVED from STATE, not re-typed. sec.guard_basenames falls back
# to the 7 literals loudly (sec.guard_source() says which) rather than emptying
# the set -- an empty guard set is a gate that cannot fire.
GUARD_BASES = set(sec.guard_basenames())

# v3.66.796: directory names the SOURCE ZIP never tracks. diff_tree's work-tree
# scan prunes these so `added = wt - zip` is not flooded with vendor/build noise.
# DERIVED, not guessed: on a pristine tree, pruning exactly these yields wt ==
# the zip's tracked set (2608 == 2608, 0 added / 0 deleted). CRITICAL: `dist` is
# NOT here -- frontend/dist IS shipped in the release; the node_modules/*/dist
# noise dies with the node_modules prune, so a name-level `dist` prune would
# instead turn 35 tracked frontend/dist files into phantom DELETIONS.
DIFF_TREE_PRUNE = {"node_modules", "venv", ".venv", ".git", "__pycache__",
                   ".pytest_cache", ".mypy_cache", ".ruff_cache", ".cache",
                   "build", "coverage", ".tox", "htmlcov", ".idea", ".vscode",
                   ".nyc_output"}

# ---------------------------------------------------------------------------
# SIGNAL 3 -- COUNT-COUPLING (bit@702).
#
# Some suites pin a DERIVED COUNT of a source construct rather than importing it:
#
#   tests/test_settings_center_slice5.py   _EDITABLE_COUNT == 208
#   tests/test_settings_center_wiring.py   unique_fields   == 235
#
# Both numbers are the size of app_kernel.CFG_FIELDS as seen THROUGH the
# settings-center schema. Adding one field to CFG_FIELDS changes them -- but the
# coupling is a COUNT, not an import edge and not a filename stem, so signals 1
# and 2 are STRUCTURALLY BLIND to it. At 702 a one-line CFG_FIELDS addition
# therefore produced a complete-looking band that missed both suites, and the cut
# went RED on stash.
#
# A count dependency cannot be inferred from the import graph, so it is DECLARED.
# Each rule carries its provenance, like a footgun. Over-banding is the safe
# direction: a rule may add suites that turn out unaffected; it must never miss
# one that is.
# SIGNAL 3 is really DECLARED COUPLING: a test that exercises a module WITHOUT
# NAMING IT. The stem-glob cannot see it and the import graph cannot see it, so it
# must be declared. Two shapes have now bitten:
#   * COUNT-coupling (bit@702): a test pins a DERIVED COUNT of the module's contents.
#   * SEAM-coupling  (bit@703): a test patches a module's internal seam (shutil.which,
#     a module-level constant) under a DIFFERENT test-file name entirely --
#     test_v3_43_63_library_extractors exercises hls_downloader; test_v3_43_60_
#     coverage_gaps patches integrity._FFPROBE. A refactor that MOVES the seam breaks
#     them, and the deriver never bands them.
COUNT_COUPLED = [
    {
        "id": "CC-EDITABLE-SET",
        "when_any": ["bulk_downloader/app_kernel.py",          # CFG_FIELDS lives here
                     "bulk_downloader/site_editor.py",         # _FIELD_TYPES / schema
                     "bulk_downloader/app_settings_center.py"],  # the schema counter
        "band": ["tests/test_settings_center_slice5.py",       # _EDITABLE_COUNT pin
                 "tests/test_settings_center_wiring.py",       # unique_fields pin
                 "tests/test_v3_66_323_phase4_gap_a1_a2.py",   # >= floor
                 "tests/test_v3_66_324_phase4_gap_a3_a4_a5.py"],  # >= floor
        "why": "these suites pin a DERIVED COUNT of CFG_FIELDS (the editable set); "
               "a field add/remove moves the count with no import-edge or filename "
               "signal to follow (bit@702)",
    },
    {
        "id": "SC-FFMPEG-RESOLUTION",
        "when_any": ["bulk_downloader/hls_downloader.py",
                     "bulk_downloader/integrity.py",
                     "bulk_downloader/ffmpeg_bin.py"],
        "band": ["tests/test_v3_43_63_library_extractors.py",   # patches shutil.which
                 "tests/test_v3_43_60_coverage_gaps.py"],       # patches integrity._FFPROBE
        "why": "these suites exercise hls_downloader / integrity by PATCHING an internal "
               "resolution seam, under test-file names that mention NEITHER module -- no "
               "stem-glob and no import edge points at them, so a refactor that moves the "
               "seam breaks them silently (bit@703)",
    },
]


def count_coupled(rel):
    """Suites whose PINNED COUNTS this file can move. Declared, not inferred --
    see COUNT_COUPLED."""
    out = []
    for rule in COUNT_COUPLED:
        if any(rel == w or os.path.basename(rel) == os.path.basename(w)
               for w in rule["when_any"]):
            out.extend(rule["band"])
    return out


