#
# project-knowledge/ used to carry a byte-identical second copy of most of
# toolchain/bin, and tests/test_pk_mirrors_do_not_drift.py compared the pairs
# by sha256. That gate imported nothing, its stem matched no source file and
# it was in no curated map, so signals 1-4 were ALL structurally blind to it
# -- which is why three mirrors sat drifted across v3.66.847-849 with the
# gate red on main the whole time. Signal 8 existed to reach it.
#
# The 234 mirrors are gone (@943), so there is no pair left to compare and no
# gate left to reach. tests/test_pk_mirrors_stay_retired.py replaces the drift
# gate with the stronger property -- that no such duplicate exists at all --
# and it is an ordinary tests/ file that signal 4 can see unaided.
#
# Kept as a comment rather than deleted outright: a future reader who
# wonders why the signal numbering skips 8 should find the answer here
# rather than reconstruct it from the changelog.


# ---------------------------------------------------------------------------
# SIGNAL 5 -- FE-MUTATING-GATE (declared coupling, bit@789).
#
# Wiring or rewiring a MUTATING frontend call site (apiPost/apiPut/apiPatch/
# apiDelete, or a raw fetch with method: POST/PUT/PATCH/DELETE) moves derived
# artifacts that live OUTSIDE the route/reachability families:
#   * tools/BODY_CONTRACT_CALLS.json  (729's in-sync arm judges the OLD frontend
#     if not regenerated)
#   * reports/gui_parity_inventory.json (302 compares shipped vs a LIVE regen --
#     the one gate whose denominator can see the drift)
#   * the wave2 backlog ledger
#   * ROUTE_INDEX spa_wired
# At 789 the first stash capture failed 302 + 729 exactly because the band held
# only the route/reachability families. route_index_in_sync even PASSED
# self-consistently in-sandbox (regenerated from the same stale inventory) --
# the denominator lesson again. This rule is DECLARED, like signal 3: no import
# edge and no filename stem points from a .tsx call site at these gates.
# Over-banding is the safe direction.
FE_MUTATION_GATES = {
    "id": "FE-MUTATING-CALLSITE",
    "band": ["tests/test_v3_66_302_gui_parity_reconcile.py",
             "tests/test_v3_66_729_body_contract_fixtures.py",
             "tests/test_wave2_backlog.py",
             "tests/test_route_index_in_sync.py"],
    "why": "an added/removed/rewritten FE mutating call site moves "
           "BODY_CONTRACT_CALLS + gui_parity_inventory + wave2 + spa_wired; "
           "only these gates' denominators can see it (bit@789)",
}


# helper call: apiPost("/api/x", ...) / apiPost<T>(...) / apiPost(someVar, ...)
# <[^()]*> (not <[^>]*>) so a nested generic apiPost<Foo<Bar>>( still matches.
FE_MUT_CALL_RE = re.compile(
    r"\bapi(Post|Put|Patch|Delete)\s*(?:<[^()]*>)?\s*\(\s*"
    r"(?:([`'\"])((?:[^`'\"\\]|\\.)*?)\2|([A-Za-z_$][\w$.]*))")
FE_RAW_METHOD_RE = re.compile(r"method\s*:\s*['\"](POST|PUT|PATCH|DELETE)['\"]")


def fe_mut_signature(text):
    """The MUTATING CALL-SITE SIGNATURE of one FE source text: the multiset of
    (helper, url) call sites plus the multiset of raw fetch methods -- what
    729's BODY_CONTRACT_CALLS and 302's parity inventory actually judge. Two
    texts with equal signatures cannot have added, removed, or re-pointed a
    mutating call site. A non-literal first arg is kept as <expr:name> so a
    variable-url site still counts."""
    sites = []
    for m in FE_MUT_CALL_RE.finditer(text):
        url = m.group(3) if m.group(2) else "<expr:%s>" % (m.group(4) or "?")
        sites.append((m.group(1), url))
    return (tuple(sorted(sites)), tuple(sorted(FE_RAW_METHOD_RE.findall(text))))


def fe_gate_hits(work, changed, zsrc=None):
    """Changed frontend/src .ts/.tsx files whose mutating signature DIFFERS from
    the baseline zip; without baseline text (--file/--files), any changed FE
    file that CONTAINS a mutating site (over-band, the safe direction)."""
    hits = []
    for rel in changed:
        if not (rel.startswith("frontend/src/") and rel.endswith((".ts", ".tsx"))):
            continue
        wt = os.path.join(work, rel)
        try:
            new = open(wt, errors="replace").read() if os.path.isfile(wt) else ""
        except OSError:
            new = ""
        if zsrc is not None and rel in zsrc:
            if fe_mut_signature(new) != fe_mut_signature(zsrc[rel]):
                hits.append(rel)
        else:
            s = fe_mut_signature(new)
            if s[0] or s[1]:
                hits.append(rel)
    return hits


def fe_consumers(work, rel):
    """SIGNAL 4b -- FE-CONSUMER: tests that name the changed FE file by its
    exact basename ("Vpn.tsx"). Extension-anchored with a leading word-boundary
    guard (so MyVpn.tsx does not match Vpn.tsx), which is why the prose
    false-positive that keeps signal 4 .py-only cannot occur here."""
    if not rel.endswith((".ts", ".tsx")):
        return []
    base = os.path.basename(rel)
    pat = re.compile(r"(?<![A-Za-z0-9_])%s\b" % re.escape(base))
    hits = []
    tdir = os.path.join(work, "tests")
    if not os.path.isdir(tdir):
        return []
    for dp, dn, fns in os.walk(tdir):
        dn[:] = [d for d in dn if d != "__pycache__"]
        for fn in fns:
            if not fn.endswith(".py"):
                continue
            p = os.path.join(dp, fn)
            try:
                with open(p, "r", errors="replace") as f:
                    if pat.search(f.read()):
                        hits.append(os.path.relpath(p, work))
            except OSError:
                continue
    return sorted(hits)


def sha(b):
    return hashlib.sha256(b).hexdigest()


def _ver(n):
    m = re.search(r"v?(\d+)[._](\d+)[._](\d+)", os.path.basename(n))
    return tuple(map(int, m.groups())) if m else (0, 0, 0)


def auto_zip():
    c = []
    for pat in ("/mnt/user-data/uploads/BulkDownloader_v*.zip",):
        c += glob.glob(pat)
    c = [z for z in c if "overlay" not in os.path.basename(z).lower()]
    return max(c, key=_ver) if c else None


def find_map(work):
    """Locate the curated TOUCHED_FILE_TO_TEST map.

    @860: project-knowledge/ was NOT in this list, and `git log --follow` shows
    the map has lived there and ONLY there since it was created. So signal 2 --
    the curated map, one of the four this tool unions -- loaded zero rows on
    every checkout, silently, since inception. Every band CLAUDE.md section 4
    orders derived through this tool was narrower than designed.

    The silence was the real defect: a missing map returned None and the caller
    carried on. A signal that can vanish without saying so is the section 0
    shape, so main() now prints when the map is absent.
    """
    for c in (os.path.join(work, "project-knowledge", "TOUCHED_FILE_TO_TEST.md"),
              os.path.join(work, "TOUCHED_FILE_TO_TEST.md"),
              os.path.join(work, "docs", "TOUCHED_FILE_TO_TEST.md"),
              os.path.join(work, "kb", "TOUCHED_FILE_TO_TEST.md")):
        if os.path.isfile(c):
            return c
    return None


def map_rows(path):
    """[(surface_cell, [bare test names])] from the curated md table."""
    rows = []
    if not path or not os.path.isfile(path):
        return rows
    for ln in open(path, errors="ignore"):
        if ln.count("|") < 2 or "---" in ln or "Touched surface" in ln:
            continue
        cells = [c.strip() for c in ln.strip().strip("|").split("|")]
        if len(cells) < 2:
            continue
        names = re.findall(r"test_[\w]+", cells[1])
        if cells[0] and names:
            rows.append((cells[0], names))
    return rows


FLOOR = ["tests/test_contracts.py"]

# v3.66.1176: every source that can change the assembled TEMPLATES identity
# owes the frozen snapshot check. This is intentionally an exact producer set;
# a filename-stem or import grep cannot see data re-exported through __init__.
TEMPLATE_IDENTITY_PRODUCERS = {
    "bulk_downloader/templates.py",
    "bulk_downloader/site_templates/__init__.py",
    "bulk_downloader/site_templates/accessors.py",
    "bulk_downloader/site_templates/_data_cms.py",
    "bulk_downloader/site_templates/_data_heuristics.py",
    "bulk_downloader/site_templates/_data_mainstream.py",
    "bulk_downloader/site_templates/_data_players.py",
    "bulk_downloader/site_templates/_data_studios_a.py",
    "bulk_downloader/site_templates/_data_studios_b.py",
    "bulk_downloader/site_templates/_data_tubes.py",
}


def module_consumers(work, rel):
    """SIGNAL 4 -- MODULE-CONSUMER (the one signals 1-3 all miss).

    Every test that IMPORTS or NAMES the changed module, regardless of its filename.
    Signals 1-3 are: a filename-stem glob, a curated map, and a declared count. NONE of
    them is "who actually consumes this module" -- so a test that exercises module X
    under a name that does not contain X's stem, is not in the map, and pins no count is
    INVISIBLE to the band. That gap caused the 712 STASH RED, and every cut afterwards
    ran `grep -rl <module> tests/` BY HAND to cover it. This mechanizes that grep.

    Proof it is not redundant: bulk_downloader/ffmpeg_bin.py is consumed by
    tests/test_v3_66_720_oidc_and_ffmpeg.py -- whose stem contains neither "ffmpeg_bin"
    nor anything signal 1 would glob.

    Word-boundary matched, so `dedup` does not drag in `dedupe_key`. Python modules only
    (a stem is only a module name for .py); a .tsx stem would false-positive on prose.
    """
    base = os.path.basename(rel)
    if rel.endswith(".py"):
        stem = re.sub(r"\.\w+$", "", base)
        if not stem or stem in ("__init__", "conftest", "setup"):
            return []
        pat = re.compile(r"\b%s\b" % re.escape(stem))
    else:
        # NON-PYTHON: match the FULL BASENAME, extension included.
        #
        # The docstring above is right that a bare STEM is only a module name
        # for .py, and that a .tsx stem would false-positive on prose. But
        # bailing entirely made this signal blind to every shell script and doc
        # in the tree, and those are named VERBATIM by the tests that read them:
        # "capture.sh", "CLAUDE.md", "install_service.sh". The full basename
        # carries the extension, so it is distinctive in a way the stem is not
        # -- "capture" matches prose everywhere, "capture.sh" does not.
        #
        # MEASURED 2026-08-03 on capture.sh, which is why this exists: the
        # tool returned 73 suites and `grep -rl "capture\.sh" tests/*.py`
        # returned 39, and the two sets were COMPLEMENTARY -- the tool missed
        # 26 that the grep found, including test_deploy_script.py and
        # test_install_service_waits_for_serving.py. For a .py file the tool is
        # a strict superset of the grep (25 vs 17 on tools/live_seed.py); for a
        # .sh file it was not, and CLAUDE.md section 4 now sends every cut here
        # first. A band that is a superset for one file class and a subset for
        # another is worse than one that is honestly narrow, because the caller
        # cannot know which they got.
        # DISTINCTIVENESS, not "has an extension". The first draft of this
        # branch required a dot -- which excluded the 469 tracked extensionless
        # python-shebang bd-* scripts under toolchain/ and project-knowledge/,
        # i.e. the exact population CLAUDE.md section 1 warns a `*.py` glob
        # cannot see. Caught by running this tool on ITSELF: bd-band-derive is
        # extensionless, and banded 1 suite. The fix reproducing the defect it
        # fixes is section 0's own rule, and this is an instance of it.
        #
        # What actually makes a basename safe to grep for is that it cannot be
        # ordinary prose. A dot does it ("capture.sh"), and so does a hyphen or
        # underscore ("bd-band-derive", "install_service"). A bare single word
        # is rejected, which is what the original .py-only bail was protecting.
        if not base or not any(ch in base for ch in ".-_"):
            return []
        pat = re.compile(re.escape(base))
    hits = []
    tdir = os.path.join(work, "tests")
    if not os.path.isdir(tdir):
        return []
    for dp, dn, fns in os.walk(tdir):
        dn[:] = [d for d in dn if d != "__pycache__"]
        for fn in fns:
            if not fn.endswith(".py"):
                continue
            p = os.path.join(dp, fn)
            try:
                with open(p, "r", errors="replace") as f:
                    if pat.search(f.read()):
                        hits.append(os.path.relpath(p, work))
            except OSError:
                continue
    return sorted(hits)


# SIGNAL 6 -- ENV-TRANCHE (bit@802).
#
# tools/config_surface_inventory.py does a BARE TOKEN scan for BD_[A-Z0-9_]+
# across each .py file -- code, string literal, comment or DOCSTRING alike. So a
# changed file that merely MENTIONS a BD_-prefixed token moves the operator-
# tunable config surface and trips the env-tranche / config-parity gates.
#
# @802 cost a stash RED exactly here: the MOD-3 cut named the BD_-prefixed form
# in the prose explaining why it was NOT using it, that mention registered as an
# open env var, and seven gates went red -- none of them banded, because the
# author reasoned "no BD_ variable was added" instead of deriving it. The band
# must not require anyone to hold that footgun in their head.
#
# DERIVED, not asserted: the BD_ token set of the changed file is compared
# against the SAME file in the zip. Only a DELTA bands, so files that have
# always carried BD_ tokens do not band this cluster on every unrelated edit.
_ENV_TRANCHE_SUITES = (
    "tests/test_v3_66_319_env_tranche_4_3d.py",
    "tests/test_v3_66_305_config_danger.py",
    "tests/test_v3_66_702_jd_supported_hosts_field.py",
    "tests/test_v3_66_711_automation_gui.py",
    "tests/test_v3_66_713_unscanned_surfaces.py",
    "tests/test_v3_66_716_decoys_and_shadow.py",
    "tests/test_v3_66_720_oidc_and_ffmpeg.py",
)
_BD_TOKEN_RE = re.compile(r"\bBD_[A-Z0-9_]+")


def env_tranche_suites(work, rel, zsha_src=None):
    """SIGNAL 6: band the env-tranche/config-parity cluster when a changed .py's
    BD_-token set differs from the zip's copy. Returns existing suites only."""
    if not rel.endswith(".py"):
        return set()
    wt = os.path.join(work, rel)
    if not os.path.isfile(wt):
        return set()
    try:
        new = set(_BD_TOKEN_RE.findall(
            open(wt, encoding="utf-8", errors="replace").read()))
    except OSError:
        return set()
    old = set()
    if zsha_src and rel in (zsha_src or {}):
        old = set(_BD_TOKEN_RE.findall(zsha_src[rel]))
    elif zsha_src is not None:
        old = set()          # ADDED file: every token it carries is new
    if new == old:
        return set()
    return {c for c in _ENV_TRANCHE_SUITES
            if os.path.isfile(os.path.join(work, c))}


def tests_for_file(work, rel, rows, zsha_src=None):
    """The band for ONE changed file: stem-glob UNION curated-map UNION count-coupling
    UNION module-consumer. Existing suites only."""
    base = os.path.basename(rel)
    stem = re.sub(r"\.\w+$", "", base)
    hits = set()
    if rel in TEMPLATE_IDENTITY_PRODUCERS:
        hits.add("tests/test_templates_list_identity.py")
    if stem:
        for tp in glob.glob(os.path.join(work, "tests", "**", "*%s*.py" % stem),
                            recursive=True):
            hits.add(os.path.relpath(tp, work))
    for surface, names in rows:
        if not (base in surface or (stem and stem in surface)):
            continue          # CELL-scoped: never a substring test against the path
        for n in names:
            cand = os.path.join("tests", n if n.endswith(".py") else n + ".py")
            if os.path.isfile(os.path.join(work, cand)):
                hits.add(cand)
    # SIGNAL 3: declared count-coupling (invisible to the graph -- bit@702).
    for cand in count_coupled(rel):
        if os.path.isfile(os.path.join(work, cand)):
            hits.add(cand)
    # SIGNAL 4: module-consumer -- tests that import or name the module (712 RED).
    for cand in module_consumers(work, rel):
        hits.add(cand)
    # SIGNAL 4b: FE-consumer -- tests that name the .tsx/.ts file (789: the FE
    # side of a cut contributed a near-empty band; its consumers were invisible).
    for cand in fe_consumers(work, rel):
        hits.add(cand)
    # SIGNAL 6: env-tranche -- a BD_ token delta anywhere in the file (incl. a
    # docstring) moves the config surface and owes the parity gates (802 RED).
    for cand in env_tranche_suites(work, rel, zsha_src):
        hits.add(cand)
    return sorted(h for h in hits if os.path.isfile(os.path.join(work, h)))


def deleted_config_literals(work, zsha_src=None):
    """v3.66.718: when a cut DELETES a config KEY from global_config.py, the consumers
    are the tests that NAME that literal -- which are invisible to a file-name band. A
    test that does cfg.get("auto_refresh") without importing the inventory (285) slips
    through, and the deletion goes RED on stash. Diff the schema's string literals; for
    any that vanished, band every test that mentions the literal.
    """
    gc = "bulk_downloader/global_config.py"
    wt = os.path.join(work, gc)
    if not (zsha_src and os.path.isfile(wt) and gc in zsha_src):
        return set()
    lit = re.compile(r'"([a-z][a-z0-9_.]{2,})"')
    old_keys = set(lit.findall(zsha_src[gc]))
    new_keys = set(lit.findall(open(wt, encoding="utf-8", errors="replace").read()))
    gone = old_keys - new_keys
    if not gone:
        return set()
    hits = set()
    tdir = os.path.join(work, "tests")
    for tp in glob.glob(os.path.join(tdir, "**", "*.py"), recursive=True):
        try:
            body = open(tp, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        if any(('"%s"' % k in body or "'%s'" % k in body) for k in gone):
            hits.add(os.path.relpath(tp, work))
    return hits


def derive(work, changed, rows, zsha_src=None):
    band = set()
    for c in changed:
        band.update(tests_for_file(work, c, rows, zsha_src))
    # v3.66.718: deleted-config-key literals -> the tests that NAME them.
    band |= deleted_config_literals(work, zsha_src)
    # v3.66.789: an FE mutating call-site delta -> the FE-derived gates whose
    # denominators can actually see it (302/729/wave2/route_index).
    if fe_gate_hits(work, changed, zsha_src):
        band |= {g for g in FE_MUTATION_GATES["band"]
                 if os.path.isfile(os.path.join(work, g))}
    # SIGNAL 7 (@807): whatever regen_flags() is about to DEMAND, band the
    # suites that ENFORCE it. Before this, the flags were display-only and never
    # met the band -- the tool named the duty and omitted the check, and four
    # consecutive cuts (800/801/803/804) closed the gap by hand.
    band |= regen_suites(work, changed,
                         fe_mut=fe_gate_hits(work, changed, zsha_src))
    # the CONTRACT FLOOR rides on every derived band (see FLOOR)
    _floor_here = [f for f in FLOOR
                   if os.path.isfile(os.path.join(work, f))]
    _floor_gone = [f for f in FLOOR if f not in _floor_here]
    if _floor_gone:
        # @937: dropping the contract floor is a NARROWER band than the
        # caller was promised, and it used to happen without a word. The
        # existence check stays -- naming a suite that is not there would
        # emit a command that cannot run -- but the omission is now said.
        # stderr, because stdout is the line `--emit` exists to produce.
        print("bd-band-derive: contract floor absent under %s, omitted "
              "from the band: %s" % (work, ", ".join(_floor_gone)),
              file=sys.stderr)
    band |= set(_floor_here)
    # @897 -- filtered HERE, at the single return, not in emit_band(): the JSON
    # payload publishes `band` raw and only band_cmd goes through emit_band, so
    # filtering there would leave two denominators that disagree -- the exact
    # shape this filter exists to remove.
    return sorted(b for b in band if is_suite(b))


def rev_deps(work, rel):
    p = os.path.join(work, "DEPENDENCY_GRAPH.json")
    if not os.path.isfile(p):
        return []
    try:
        d = json.load(open(p))
        base = os.path.basename(rel)
        out = []
        for k, v in (d.get("blueprints", d) if isinstance(d, dict) else {}).items():
            if isinstance(v, dict) and (
                    base in [os.path.basename(x) for x in v.get("providers", [])]
                    or os.path.basename(v.get("module", "")) == base):
                out.append(k)
        return sorted(set(out))[:12]
    except Exception:  # why: input unavailable/unreadable; return empty so the caller uses its fallback, not a wrong value
        return []


# SIGNAL 7 -- REGEN-OBLIGATION (bit@800/801/803/804).
#
# regen_flags() names an obligation ("re-freeze the import baseline", "regen
# FUNCTION_INDEX") and, until @807, the suites that ENFORCE those obligations
# were never unioned into the band: the flags were computed in report() purely
# for DISPLAY and never met derive(). The tool named the duty and left out the
# check, so the operator had to hold it in their head -- which is the same
# reasoning that produced the @802 stash RED (exposure ASSERTED rather than
# derived). It was hand-worked-around on four consecutive cuts: 800, 801, 803,
# 804.
#
# The mapping lives HERE, adjacent to the flags it enforces, so a new obligation
# cannot be added without its gate being an obvious omission. DERIVED, not
# mirrored: a gate is banded only when its own trigger fires, and only if the
# file exists on disk (the FLOOR precedent), so a docs-only cut does not drag
# the regen cluster along -- the NEG the selftest pins.
#
# NOT a blanket add: test_dependency_graph_in_sync already reaches the band via
# tests_for_file for a bulk_downloader/*.py change. It is listed anyway because
# this map is the STATEMENT of the obligation; union with an already-present
# suite is a no-op, whereas omitting it here would make the map a lie.
REGEN_ENFORCING_SUITES = {
    "FUNCTION_INDEX/DEPENDENCY_GRAPH": (
        "tests/test_function_index_in_sync.py",
        "tests/test_dependency_graph_in_sync.py",
    ),
    "import edges": (
        "tests/test_import_graph_no_new_edges.py",
    ),
    "PIN_INDEX (version bump)": (
        "tests/test_pin_index_in_sync.py",
    ),
    # @899: naming an obligation without banding the suite that ENFORCES it is
    # the trap the @889 comment above describes -- it converts a per-cut chore
    # into a per-cut surprise on the box. The flag and its enforcing suite land
    # together or neither lands.
}


def regen_suites(work, changed, fe_mut=None):
    """SIGNAL 7: the suites that ENFORCE whatever regen_flags() just demanded.

    Returns only suites that exist in the work tree, so a tree without a gate
    file yields fewer suites rather than a band entry that cannot run.
    """
    out = set()
    for name, _advice in regen_flags(changed, fe_mut=fe_mut, work=work):
        for suite in REGEN_ENFORCING_SUITES.get(name, ()):
            if os.path.isfile(os.path.join(work, suite)):
                out.add(suite)
    return out


# has_pk_mirror() retired @943 with SIGNAL 8: there is no project-knowledge
# twin left to owe. See the SIGNAL 8 note above.


def regen_flags(changed, fe_mut=None, work=None):
    flags = []
    # v3.66.789: a mutating FE call-site delta carries THREE regen obligations
    # beyond the band; skipping any of them is exactly the 789 first-capture RED.
    if fe_mut:
        flags.append(("FE-MUTATING (302/729/wave2)",
                      "regen ORDER: tools/gui_parity_inventory.py THEN "
                      "tools/build_route_index.py (it consumes the inventory); "
                      "python3 tools/body_contract.py --regen (needs node) for the "
                      "new/moved call site; a no-body apiPost(url,{}) action POST "
                      "is a judgeability-neutral UNKNOWN -> bump UNKNOWN_BASELINE "
                      "+1 WITH attribution (files: %s)" % ", ".join(
                          os.path.basename(f) for f in fe_mut[:3])))
    if any(c.endswith(".py") and c.startswith("bulk_downloader/") for c in changed):
        flags.append(("FUNCTION_INDEX/DEPENDENCY_GRAPH",
                      "bd-regen  (line-shift / new edge may drift the derived docs)"))
    # v3.66.889: TESTS/ TOO. The import-graph gate widened to cover tests/ in
    # that cut, and this flag keyed on bulk_downloader/ only -- so a tests/-only
    # change would have produced NO flag and NOT banded the gate's own suite,
    # leaving the author owing a baseline re-freeze nobody told them about and
    # failing on the box rather than in the sandbox. CLAUDE.md section 4 records
    # that shape costing five releases with test_source_windows_do_not_shift red
    # on main. The gate and this flag widen in the SAME cut, deliberately: one
    # without the other converts a per-cut chore into a per-cut trap.
    if any(c.endswith(".py") and (c.startswith("bulk_downloader/")
                                  or c.startswith("tests/")) for c in changed):
        flags.append(("import edges",
                      "bd-imports (new internal edge -> re-freeze baseline SAME cut)"))
    if any(("app_" in os.path.basename(c)) or c.endswith("app.py") or "/routes" in c
           for c in changed):
        flags.append(("ROUTE_INDEX/ENDPOINT_CATALOG/route_map",
                      "route add? gui_parity BEFORE ROUTE_INDEX + re-freeze route_map_baseline"))
    # v3.66.721: WIRING A CONTROL IS A ROUTE CHANGE. ROUTE_INDEX records a spa_wired flag
    # per (method, path), so adding or removing a FRONTEND CALL flips the index even though
    # url_map is untouched. The backend rule above (app_*/app.py//routes) does NOT catch a
    # frontend/src change, which is exactly how 714 shipped a stale ROUTE_INDEX and went RED
    # on stash ("only-in-parity = [the 4 killswitch routes]"). Any frontend source change is
    # a candidate spa_wiring change -- and the regen ORDER matters: gui_parity FIRST, because
    # bd-cut regenerates the parity inventory and a ROUTE_INDEX built before it goes stale.
    if any(c.startswith("frontend/src/") for c in changed):
        flags.append(("ROUTE_INDEX (spa_wired)",
                      "frontend change -> a control may have been wired/unwired: "
                      "tools/gui_parity_inventory.py THEN tools/build_route_index.py, "
                      "and band tests/test_route_index_in_sync.py "
                      "(test_spa_wired_join_is_faithful lives INSIDE that file)"))
    if any(os.path.basename(c) in GUARD_BASES for c in changed):
        flags.append(("GUARD-SHA",
                      "a release-guard file changed -> declare a new SHA (bd-guard-declare) or revert"))
    # @807: the version bump is a regen obligation like any other -- bumping
    # __version__ obliges build_pin_index, and test_pin_index_in_sync is what
    # enforces it. There was no flag for it at all, so the gate had no trigger
    # to hang off and a bump banded 2 suites.
    if any(c.replace("\\", "/").endswith("bulk_downloader/__init__.py")
           for c in changed):
        flags.append(("PIN_INDEX (version bump)",
                      "__version__ moved -> python3 tools/build_pin_index.py, and "
                      "grep -rnE '__version__ *== *\"3\\.66\\.' tests/ (the pin list "
                      "does not stay at one entry)"))
    if any(re.search(r"BD_[A-Z0-9_]+", c) for c in changed):
        pass
    return flags


def is_suite(rel):
    """Would the runner COLLECT this file? Anything else must not be banded.

    @897 -- two emitters put non-suites in the band and neither ranged over
    suites: tests_for_file() globs tests/**/*<stem>*.py so a changed file under
    tests/ always matches ITSELF, and module_consumers() os.walks tests/ keeping
    every `.py`. Measured, one --file run each: conftest.py, capture_lanes.py,
    _env.py and a fixtures/.../sample.py all reached the band.

    THE HAZARD IS EXECUTION, NOT NOISE: run_tests_core.py:694 is
    `spec.loader.exec_module(mod)`, so a requested path is EXECUTED. A derived
    band could execute a test FIXTURE.

    The predicate is run_tests_core.py:1360's own -- TESTS_DIR.glob("test_*.py")
    -- deliberately COPIED rather than invented, so the derive and the runner
    cannot disagree about what a suite is. Measured over `git ls-files tests/`:
    1224 of 1239 tracked .py match; all 15 filtered are genuine non-suites
    (conftest, _env, _phase_scripts/*, capture_lanes, shell_source, two fixture
    sample.py). No real suite is lost.

    NOT the extension-allowlist shape forbidden for sec.should_scan: that one
    must read CONTENT because a secret can live in any file type. This is a
    collection question, and filename is how the runner itself answers it.
    """
    return fnmatch.fnmatch(os.path.basename(rel), "test_*.py")


def emit_band(band):
    """Format an already-derived band as the bd-band command line.

    A FORMATTER, NOT A SECOND DERIVATION (@937). This used to union FLOOR in
    again, probed against a hardcoded sandbox home -- a path that exists on no
    machine this repository runs on, so the union matched nothing and the
    expression was dead. It was harmless only by luck: derive() already unions
    the same FLOOR against the real `work` (see the CONTRACT FLOOR line), so
    the floor reached every band from there. Measured on the pristine tool --
    23 suites with the floor present, and 22 with the floor absent once
    derive()'s union alone was neutralised, which is what proves derive() was
    the supplier and this was the spare.

    A DUPLICATE DENOMINATOR IS THE DEFECT, not the wrong literal inside it.
    Two places computing band membership can disagree, and the one nobody
    reads is the one that rots -- exactly what @897 argued when it put the
    is_suite filter at derive()'s single return rather than here, because the
    JSON payload publishes `band` raw while only band_cmd passes through this
    function. Deriving in one place and formatting in the other keeps those
    two outputs describing the same set.
    """
    full = sorted(set(band))
    return ("bd-band " + " ".join(full)) if full else \
        "bd-band  (no mapped suite -- band this cut's own new tests + test_contracts)"


def report(work, changed, rows, label, deps=None, as_json=False, emit_only=False, zsha_src=None):
    band = derive(work, changed, rows, zsha_src)
    flags = regen_flags(changed, fe_mut=fe_gate_hits(work, changed, zsha_src),
                        work=work)
    if emit_only:
        print(emit_band(band))
        return 0
    if as_json:
        print(json.dumps({"mode": label, "changed": changed, "band": band,
                          "band_cmd": emit_band(band),
                          "regen_flags": [f[0] for f in flags],
                          "dependents": deps or []}, indent=1))
        return 0
    print("== bd-band-derive :: %s" % label)
    # WHAT COUNTS AS SOURCE HERE IS THE SUBJECT OF CLAUDE.md SECTION 0'S OPENING
    # EXAMPLE, and this line has now been wrong twice. It first counted only
    # .py, so a real frontend cut printed "changed source (0)"; .ts/.tsx were
    # added; and it STILL printed "changed source (0)" for a doc or shell cut
    # while emitting a real band underneath -- measured on CLAUDE.md, which
    # bands 66 suites. A summary line that reports zero over a non-empty
    # subject is the exact shape the section names, in the tool the section
    # cites. Count every changed TRACKED file and name the classes, so the
    # number can never disagree with the band beneath it.
    _SRC_EXT = (".py", ".tsx", ".ts", ".sh", ".md", ".json", ".yml", ".yaml",
                ".toml", ".cfg", ".ini", ".txt", ".html", ".css")
    src = [c for c in changed if c.endswith(_SRC_EXT)]
    other = [c for c in changed if not c.endswith(_SRC_EXT)]
    print("  changed source (%d): %s" % (len(src), ", ".join(src[:6]) + (" ..." if len(src) > 6 else "")))
    if other:
        # Never silently drop from the count: an extensionless tracked file is
        # still a change (toolchain/bin holds 469 python-shebang scripts with
        # no suffix -- CLAUDE.md section 1).
        print("  changed, unclassified (%d): %s" % (len(other), ", ".join(other[:6])))
    print("  band (%d):" % len(band))
    for b in band[:24]:
        print("    %s" % b)
    if len(band) > 24:
        print("    ... +%d more" % (len(band) - 24))
    print("  %s" % emit_band(band)[:160])
    if deps:
        print("  dependents: %s" % ", ".join(deps))
    if flags:
        print("  regen / gates:")
        for n, act in flags:
            print("    %-36s %s" % (n, act))
    print("  floor, not ceiling -- on-stash full suite + verify_release are binding.")
    return 0


def runtime_artifact_filter(work, added):
    """Which of `added` are RUNTIME ARTIFACTS by the tree's OWN release rules?

    Returns (excluded_set, reason). reason is None on success; on ANY failure
    the set is EMPTY and reason says why -- the caller then bands everything
    (fail-OPEN: an unfiltered band over-covers; a filter that guessed would
    under-cover). DERIVED, not mirrored: the canonical predicate is
    dev_suite.release_lint._manifest_excluded() IN THE TREE UNDER DIFF --
    DIRS + SUFFIXES + NAMES + PATHS, including entries that postdate any copy
    of the rules this tool could bake in (.premigration.bak, video_hashes.db).
    Subprocess (not in-process import) so the tool never executes app code in
    its own interpreter and a broken tree cannot take the band engine down.
    cwd is NEUTRAL: importing the app package in `work` could itself write the
    cwd-relative artifacts this filter exists to exclude.
    """
    if not added:
        return set(), None
    import tempfile
    prog = (
        "import sys, json\n"
        "sys.path.insert(0, sys.argv[1])\n"
        "from bulk_downloader.dev_suite.release_lint import _manifest_excluded\n"
        "paths = json.load(sys.stdin)\n"
        "json.dump([p for p in paths if _manifest_excluded(p)], sys.stdout)\n")
    try:
        r = subprocess.run(
            [sys.executable, "-c", prog, os.path.abspath(work)],
            input=json.dumps(sorted(added)), capture_output=True,
            text=True, timeout=60, cwd=tempfile.gettempdir())
    except (subprocess.TimeoutExpired, OSError) as e:
        return set(), "predicate subprocess failed: %s" % e
    if r.returncode != 0:
        tail = (r.stderr or "").strip().splitlines()
        return set(), ("predicate import/eval failed (rc=%d): %s"
                       % (r.returncode, tail[-1] if tail else "no stderr"))
    try:
        return set(json.loads(r.stdout)), None
    except ValueError as e:
        return set(), "predicate output unparsable: %s" % e


def diff_tree(work, zpath):
    zsha = {}
    zsrc = {}  # v3.66.718: old TEXT of files we diff literals in (global_config.py)
    with zipfile.ZipFile(zpath) as zf:
        for n in zf.namelist():
            if n.endswith("/"):
                continue
            # v3.66.762: key on the FULL zip relpath. These entries are already
            # relative to the tree root (e.g. "bulk_downloader/foo.py"), matching
            # the work-tree's os.path.relpath keys. The old split("/",1)[-1]
            # stripped the top segment, turning every subdir file into a basename
            # that never intersected the full-relpath work-tree set -> the tool
            # was blind to ~97% of the shipping tree and reported "changed (0)".
            rel = n
            raw = zf.read(n)
            zsha[rel] = sha(raw)
            # v3.66.789: also keep frontend/src text so a mutating call-site
            # DELTA is judged against the baseline, not just "file changed".
            if rel == "bulk_downloader/global_config.py" or (
                    rel.startswith("frontend/src/")
                    and rel.endswith((".ts", ".tsx"))):
                zsrc[rel] = raw.decode("utf-8", "replace")
    # v3.66.796: os.walk (not glob("**/*")) so the wt denominator SEES DOTFILES.
    # glob skips names starting with "." -> tracked .gitignore / .npmrc /
    # .pre-commit-config.yaml were absent from wt, and once added/deleted are
    # unioned below they would read as phantom DELETIONS on every run (the
    # denominator excluding the thing being asked about, in reverse). Pruning
    # DIFF_TREE_PRUNE at the directory level also means we never descend
    # node_modules/venv -> faster than the old glob AND, on a pristine tree,
    # wt == the zip's tracked set exactly (verified 2608==2608, 0 add / 0 del).
    wt = {}
    for dp, dn, fns in os.walk(work):
        dn[:] = [d for d in dn if d not in DIFF_TREE_PRUNE]
        for fn in fns:
            p = os.path.join(dp, fn)
            if not os.path.isfile(p):
                continue  # skip broken symlinks / sockets
            try:
                wt[os.path.relpath(p, work)] = sha(open(p, "rb").read())
            except OSError:
                continue
    # INTERSECTION-ONLY was the bug: `set(zsha) & set(wt)` drops every file that
    # exists on only one side. An all-additions cut (MOD-7 790-793) or a deletion
    # (overlay-never-deletes sibling) fell entirely outside `&` -> floor-only band.
    # Union the three disjoint sets. tests_for_file handles each: a NEW test suite
    # bands itself (stem-glob), a NEW source module bands its consumers, a DELETED
    # module bands its SURVIVING consumers (which will now fail) -- and it never
    # opens the changed path itself, so a vanished file is safe input. regen_flags
    # keys off the same list, so a new bulk_downloader/*.py or route file now
    # correctly raises its FUNCTION_INDEX / ROUTE_INDEX / import-edge obligations.
    zk, wk = set(zsha), set(wt)
    modified = [k for k in (zk & wk) if zsha[k] != wt[k]]
    added = list(wk - zk)
    deleted = list(zk - wk)
    # v3.66.79x: the (correct) added arm also surfaces RUNTIME ARTIFACTS --
    # downloader_history.db, logs/*.log, state/, app_config.json, ... appear in
    # wt after ANY in-sandbox run and were banding ~40 unrelated suites. Filter
    # ONLY the added arm through the tree's own release-manifest exclusion
    # predicate (modified/deleted are zip-tracked; the release gate keeps
    # excluded files OUT of the zip, so they cannot appear there). Fail-OPEN:
    # if the predicate cannot be imported the arm ships UNFILTERED and the
    # reason is printed -- notices go to STDERR because bd-cut json.loads()
    # this tool's stdout on the --json path.
    noise, why = runtime_artifact_filter(work, added)
    if why is not None:
        print("diff_tree: manifest-exclusion filter UNAVAILABLE (%s) -- "
              "added arm unfiltered (%d files)" % (why, len(added)),
              file=sys.stderr)
    elif noise:
        added = [a for a in added if a not in noise]
        print("diff_tree: %d runtime artifact(s) excluded from the added arm "
              "per the tree's _manifest_excluded(): %s"
              % (len(noise), ", ".join(sorted(noise)[:8])
                 + (" ..." if len(noise) > 8 else "")), file=sys.stderr)
    changed = sorted(set(modified) | set(added) | set(deleted))
    return changed, zsrc


def selftest():
    """Controls that WOULD HAVE CAUGHT the constant-band bug this tool shipped with."""
    ok = True
    work = sec.DEFAULT_WORK
    if not os.path.isdir(os.path.join(work, "tests")):
        print("SKIP  no work tree"); print("SELFTEST PASS"); return 0
    rows = map_rows(find_map(work))
    d = set(tests_for_file(work, "bulk_downloader/detect.py", rows))
    r = set(tests_for_file(work, "bulk_downloader/runner.py", rows))

    # FROZEN REFERENCE (702). This control USED to shell out to bd-blast -- but
    # bd-blast became a thin SHIM over THIS tool at C-C1, so the check silently
    # turned CIRCULAR: it was comparing the tool to itself and passing trivially.
    # A control that cannot fail is not a control. The reference below is the band
    # the TRUE pre-shim bd-blast produced for detect.py, frozen here, so a
    # regression in the engine still has something independent to fail against.
    # (bd-equiv, with the real original binary, is the full-corpus version of this.)
    REF_DETECT = ['test_deep_detect_json_recursion', 'test_deep_detect_numeric_robustness', 'test_deep_detect_redos', 'test_deep_detect_surface_lock', 'test_et1_fp_detect', 'test_rec01_02_deep_detect_probe_ssrf', 'test_v3_66_0_auto_detect', 'test_v3_66_146_detection_safety', 'test_v3_66_1_deep_detect_helpers', 'test_v3_66_2_deep_detect_parsers', 'test_v3_66_3_deep_detect_orchestrator', 'test_v3_66_46_botdefense_detect', 'test_v3_66_4_deep_detect_live', 'test_v3_66_5_deep_detect_wiring', 'test_v3_66_650_drm_detect', 'test_v3_66_6_runner_deep_detect', 'test_v3_66_7_deep_detect_smoke', 'test_v3_66_9_deep_detect_audit_fixes']
    ref = {"tests/%s.py" % n for n in REF_DETECT}
    ref = {x for x in ref if os.path.isfile(os.path.join(work, x))}
    ref -= set(FLOOR)
    missing = ref - d
    print(("PASS" if not missing else "FAIL") +
          "  EQUIV: superset of the FROZEN pre-shim bd-blast band on detect.py "
          "(ref=%d ours=%d missing=%d)" % (len(ref), len(d), len(missing)))
    ok = ok and not missing

    print(("PASS" if d != r else "FAIL") +
          "  NEG: distinct files -> distinct bands (detect=%d runner=%d)" % (len(d), len(r)))
    ok = ok and d != r
    print(("PASS" if any("detect" in x for x in d) else "FAIL") +
          "  POS: detect.py band contains detect suites")
    ok = ok and any("detect" in x for x in d)
    z = tests_for_file(work, "bulk_downloader/zzz_no_such_module.py", rows)
    print(("PASS" if z == [] else "FAIL") + "  NEG: unknown file -> empty band (never invent)")
    ok = ok and z == []
    f = regen_flags(["bulk_downloader/extraction_core.py"])
    print(("PASS" if any("GUARD" in x[0] for x in f) else "FAIL") +
          "  guard-file change raises GUARD-SHA")
    ok = ok and any("GUARD" in x[0] for x in f)

    # --- REGRESSION CONTROL: the 702 stash RED, replayed. -------------------
    # A CFG_FIELDS edit (app_kernel.py) moved two DERIVED COUNT pins. The band
    # this tool emitted did not include them, so the cut went RED on stash. If
    # signal 3 ever regresses, this control fails HERE instead of on stash.
    ak = set(tests_for_file(work, "bulk_downloader/app_kernel.py", rows))
    need = {"tests/test_settings_center_slice5.py",
            "tests/test_settings_center_wiring.py"}
    have = {n for n in need if os.path.isfile(os.path.join(work, n))}
    miss = have - ak
    print(("PASS" if not miss else "FAIL") +
          "  COUNT-COUPLING: app_kernel.py bands the editable-set count pins "
          "(the 702 stash RED; missing=%d)" % len(miss))
    ok = ok and not miss

    # NEG control: count-coupling must be SCOPED -- an unrelated module must NOT
    # drag the settings-center suites in (a rule that fires on everything is the
    # constant-band bug wearing a new hat).
    dd = set(tests_for_file(work, "bulk_downloader/detect.py", rows))
    leaked = have & dd
    print(("PASS" if not leaked else "FAIL") +
          "  NEG: count-coupling does not leak to unrelated files (detect.py)")
    ok = ok and not leaked

    # --- REGRESSION CONTROL: diff_tree must see SUBDIRECTORY files. -----------
    # The tool shipped subdirectory-blind: zip names were keyed on
    # n.split("/",1)[-1], stripping the top path segment, so a zip entry
    # "bulk_downloader/foo.py" became "foo.py" and never matched the work-tree's
    # full-relpath key -> every subdir file (~97% of the tree) was excluded and
    # the tool reported "changed source (0)". This control builds a synthetic
    # tree+zip where BOTH a root file and a subdir file differ, and asserts BOTH
    # land in `changed`. There was NO diff_tree control before -- the selftest's
    # own denominator excluded the buggy function.
    import tempfile, zipfile as _zf
    dt_ok = True
    with tempfile.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "wt", "bulk_downloader", "deep_detect"))
        # work tree: content "A"
        for rp in ("rootfile.md", "bulk_downloader/foo.py",
                   "bulk_downloader/deep_detect/orch.py"):
            fp = os.path.join(td, "wt", rp)
            os.makedirs(os.path.dirname(fp), exist_ok=True)
            open(fp, "w").write("A")
        # zip: same paths, content "B" (so all three DIFFER)
        zp = os.path.join(td, "src.zip")
        with _zf.ZipFile(zp, "w") as z:
            for rp in ("rootfile.md", "bulk_downloader/foo.py",
                       "bulk_downloader/deep_detect/orch.py"):
                z.writestr(rp, "B")
        changed, _ = diff_tree(os.path.join(td, "wt"), zp)
        need = {"rootfile.md", "bulk_downloader/foo.py",
                "bulk_downloader/deep_detect/orch.py"}
        dt_ok = need.issubset(set(changed))
        print(("PASS" if dt_ok else "FAIL") +
              "  DIFF-TREE-SUBDIR: diff_tree sees subdir files, not just root "
              "(need=%d got=%d)" % (len(need), len(need & set(changed))))
    ok = ok and dt_ok

    # --- REGRESSION CONTROL: diff_tree must see ADDED + DELETED files. ---------
    # diff_tree was INTERSECTION-ONLY (`set(zsha) & set(wt)`), so a file ADDED by
    # the cut (wt, not zip) or DELETED by the cut (zip, not wt) was invisible.
    # Every all-additions cut (MOD-7 790-793) showed a floor-only DIFF band and
    # the new suites had to be banded by hand -- same shape as "overlay never
    # deletes". This control builds a tree with a NEW tracked file, a DELETED
    # tracked file, an unchanged tracked DOTFILE (glob("**/*") skips dotfiles, so
    # pre-fix they read as zip-only -> phantom delete once union lands; the
    # os.walk scan must SEE them), and vendor NOISE (node_modules -- must be
    # pruned, never banded). Fails HERE, not on stash, if any of the four regress.
    ad_ok = True
    with tempfile.TemporaryDirectory() as td:
        wtd = os.path.join(td, "wt")
        os.makedirs(os.path.join(wtd, "tests"))
        os.makedirs(os.path.join(wtd, "bulk_downloader"))
        os.makedirs(os.path.join(wtd, "frontend", "node_modules", "pkg"))
        open(os.path.join(wtd, "bulk_downloader", "keep.py"), "w").write("X")
        open(os.path.join(wtd, "tests", "test_synthetic_new.py"), "w").write("new")
        open(os.path.join(wtd, ".gitignore"), "w").write("dot")
        open(os.path.join(wtd, "frontend", "node_modules", "pkg", "j.js"), "w").write("noise")
        zp2 = os.path.join(td, "src2.zip")
        with _zf.ZipFile(zp2, "w") as z:
            z.writestr("bulk_downloader/keep.py", "X")     # unchanged (intersection)
            z.writestr("bulk_downloader/gone.py", "old")   # DELETED (zip only)
            z.writestr(".gitignore", "dot")                # unchanged tracked dotfile
        changed2, _ = diff_tree(wtd, zp2)
        cs = set(changed2)
        want_added = "tests/test_synthetic_new.py" in cs
        want_deleted = "bulk_downloader/gone.py" in cs
        no_dot_phantom = ".gitignore" not in cs   # scan saw the dotfile -> unchanged
        no_vendor = not any("node_modules" in c for c in cs)
        ad_ok = want_added and want_deleted and no_dot_phantom and no_vendor
        print(("PASS" if ad_ok else "FAIL") +
              "  DIFF-TREE-ADD-DEL: added=%s deleted=%s no-dot-phantom=%s "
              "no-vendor=%s" % (want_added, want_deleted, no_dot_phantom, no_vendor))
    ok = ok and ad_ok

    # --- CONTROL: the added arm must NOT band RUNTIME ARTIFACTS. ---------------
    # After any in-sandbox test run the work tree grows downloader_history.db,
    # logs/, state/heartbeat.json, app_config.json, ... -- real wt-only files, so
    # the (correct) added arm surfaces them as ~40 suites of band noise. The
    # release already defines "runtime artifact" canonically:
    # dev_suite.release_lint._manifest_excluded() (DIRS+SUFFIXES+NAMES+PATHS).
    # diff_tree must DERIVE the filter from THE TREE UNDER DIFF (subprocess
    # import), never mirror the rule sets here -- a mirror drifts silently
    # (.premigration.bak and video_hashes.db postdate the PK copy of the rules).
    # This control builds a wt whose embedded predicate differs from the real
    # app's (excludes "SYNTH_ART.bin"), proving the filter is derived, not baked.
    raf_ok = True
    with tempfile.TemporaryDirectory() as td:
        wtd = os.path.join(td, "wt")
        pkg = os.path.join(wtd, "bulk_downloader", "dev_suite")
        os.makedirs(pkg)
        os.makedirs(os.path.join(wtd, "tests"))
        os.makedirs(os.path.join(wtd, "state"))
        fake = ("def _manifest_excluded(rel):\n"
                "    rel = rel.replace('\\\\\\\\', '/')\n"
                "    parts = rel.split('/')\n"
                "    return ('state' in parts\n"
                "            or parts[-1] in ('downloader_history.db',"
                " 'SYNTH_ART.bin'))\n")
        pkg_files = {
            "bulk_downloader/__init__.py": "",
            "bulk_downloader/dev_suite/__init__.py": "",
            "bulk_downloader/dev_suite/release_lint.py": fake,
        }
        for rp, txt in pkg_files.items():
            open(os.path.join(wtd, rp), "w").write(txt)
        # runtime artifacts (wt-only) + one REAL addition that must survive:
        open(os.path.join(wtd, "downloader_history.db"), "w").write("db")
        open(os.path.join(wtd, "state", "heartbeat.json"), "w").write("{}")
        open(os.path.join(wtd, "SYNTH_ART.bin"), "w").write("x")
        open(os.path.join(wtd, "tests", "test_real_new.py"), "w").write("new")
        zp3 = os.path.join(td, "src3.zip")
        with _zf.ZipFile(zp3, "w") as z:
            for rp, txt in pkg_files.items():
                z.writestr(rp, txt)          # tracked + unchanged
        changed3, _ = diff_tree(wtd, zp3)
        c3 = set(changed3)
        kept_real = "tests/test_real_new.py" in c3
        no_db = "downloader_history.db" not in c3
        no_state = "state/heartbeat.json" not in c3
        no_synth = "SYNTH_ART.bin" not in c3   # only the TREE's predicate knows this
        raf_ok = kept_real and no_db and no_state and no_synth
        print(("PASS" if raf_ok else "FAIL") +
              "  RUNTIME-ARTIFACT-FILTER: added arm derives exclusions from the"
              " tree's own _manifest_excluded (real-add=%s db=%s state=%s"
              " tree-specific=%s)" % (kept_real, not no_db and "LEAK" or "ok",
                                      not no_state and "LEAK" or "ok",
                                      not no_synth and "LEAK" or "ok"))
    ok = ok and raf_ok

    # --- NEG CONTROL: filter unavailable must FAIL OPEN (over-band, visibly). --
    # A tree with no dev_suite (or a broken import) cannot verify -- the filter
    # must then keep EVERY added file in the band and say so on stderr, never
    # silently drop. Dropping on an empty probe is the gate-that-cannot-see
    # reporting clean.
    fo_ok = True
    with tempfile.TemporaryDirectory() as td:
        wtd = os.path.join(td, "wt")
        os.makedirs(os.path.join(wtd, "tests"))
        open(os.path.join(wtd, "downloader_history.db"), "w").write("db")
        open(os.path.join(wtd, "tests", "test_real_new.py"), "w").write("new")
        zp4 = os.path.join(td, "src4.zip")
        with _zf.ZipFile(zp4, "w") as z:
            z.writestr("tests/__init__.py", "")
        changed4, _ = diff_tree(wtd, zp4)
        c4 = set(changed4)
        fo_ok = ("downloader_history.db" in c4
                 and "tests/test_real_new.py" in c4)
        print(("PASS" if fo_ok else "FAIL") +
              "  RUNTIME-ARTIFACT-FAIL-OPEN: no importable predicate ->"
              " added arm UNFILTERED (db-kept=%s)"
              % ("downloader_history.db" in c4))
    ok = ok and fo_ok

    # --- REGRESSION CONTROLS: the 789 stash RED, replayed. -------------------
    # Cut 4b wired a mutating FE call site; the band held only the route/
    # reachability families and the first stash capture failed 302 + 729. These
    # controls fail HERE instead of on stash if signal 5 / 4b ever regress.
    GATES = {g for g in FE_MUTATION_GATES["band"]
             if os.path.isfile(os.path.join(work, g))}

    # POS (no-baseline over-band): a changed FE file CONTAINING a mutating call
    # site must band the FE-derived gates.
    mut_fe = "frontend/src/components/DiscoRunPanel.tsx"
    if os.path.isfile(os.path.join(work, mut_fe)):
        b = set(derive(work, [mut_fe], rows))
        miss = GATES - b
        print(("PASS" if GATES and not miss else "FAIL") +
              "  FE-GATES-POS: mutating FE file bands 302/729/wave2/route_index "
              "(the 789 stash RED; gates=%d missing=%d)" % (len(GATES), len(miss)))
        ok = ok and GATES and not miss
    else:
        print("SKIP  FE-GATES-POS: fixture file absent")

    # NEG (scoped, not constant-band): an FE file with NO mutating site must NOT
    # drag the gates in. Fixture chosen at runtime so an app-code change cannot
    # falsely fail the control.
    neg_fe = None
    mre = re.compile(r"\bapi(Post|Put|Patch|Delete)\b|method\s*:\s*['\"]"
                     r"(POST|PUT|PATCH|DELETE)")
    for cand in sorted(glob.glob(os.path.join(
            work, "frontend", "src", "components", "*.tsx")))[:200]:
        try:
            if not mre.search(open(cand, errors="replace").read()):
                neg_fe = os.path.relpath(cand, work)
                break
        except OSError:
            continue
    if neg_fe:
        b = set(derive(work, [neg_fe], rows))
        leaked = GATES & b
        print(("PASS" if not leaked else "FAIL") +
              "  FE-GATES-NEG: non-mutating FE file (%s) does not band the gates"
              % os.path.basename(neg_fe))
        ok = ok and not leaked
    else:
        print("SKIP  FE-GATES-NEG: no mutation-free .tsx found")

    # BASELINE-AWARE NEG: identical baseline text -> equal signature -> a
    # non-mutating FE edit (comments, styling) must NOT fire the gates.
    if os.path.isfile(os.path.join(work, mut_fe)):
        cur = open(os.path.join(work, mut_fe), errors="replace").read()
        hits = fe_gate_hits(work, [mut_fe], {mut_fe: cur})
        print(("PASS" if not hits else "FAIL") +
              "  FE-GATES-BASELINE: equal mutating signature -> no gate trigger")
        ok = ok and not hits
        # SIGNATURE unit (synthetic -- an app-file quirk must not move this
        # control): add-site, same-count URL-repoint, and generic/variable-arg
        # forms all move the signature; a comment-only edit does not.
        s_base = 'apiPost("/api/a", {})\napiPost("/api/b", {})'
        sig_ok = (
            fe_mut_signature(s_base) is not None
            and fe_mut_signature(s_base) != fe_mut_signature(
                s_base + '\napiPut("/api/c", x)')                 # add-site
            and fe_mut_signature(s_base) != fe_mut_signature(
                'apiPost("/api/a2", {})\napiPost("/api/b", {})')  # repoint, same count
            and fe_mut_signature(s_base) == fe_mut_signature(
                s_base + "\n// a comment\n")                      # inert edit
            and fe_mut_signature('apiPost<T>("/api/g", {})')[0]   # generic form seen
            and fe_mut_signature('apiDelete(urlVar)')[0]          # variable-arg seen
            and fe_mut_signature(cur) != fe_mut_signature(
                cur + '\napiPost("/api/x", {})\n'))               # and on the real file
        print(("PASS" if sig_ok else "FAIL") +
              "  FE-SIGNATURE: add-site / URL-repoint / generic / variable-arg "
              "all move it; a comment does not")
        ok = ok and sig_ok

    # FE-CONSUMER (signal 4b): Vpn.tsx is named by the 769 wired test; the FE
    # side of a cut must contribute its consumers, not a near-empty band.
    vpn = "frontend/src/routes/Vpn.tsx"
    t769 = "tests/test_v3_66_769_vpn_leak_test_wired.py"
    if os.path.isfile(os.path.join(work, vpn)) and os.path.isfile(os.path.join(work, t769)):
        b = set(tests_for_file(work, vpn, rows))
        print(("PASS" if t769 in b else "FAIL") +
              "  FE-CONSUMER: Vpn.tsx bands its named consumer (769)")
        ok = ok and t769 in b
    else:
        print("SKIP  FE-CONSUMER: fixtures absent")

    # ENV-TRANCHE (signal 6, @802): a BD_ token appearing ONLY in a docstring
    # still moves the operator config surface, because the inventory scan is a
    # bare token scan. POS + NEG in one control: a token delta must band the
    # cluster, and an unchanged token set must NOT (or every edit to a file
    # that has always carried BD_ tokens drags 7 suites along).
    import tempfile as _tf
    with _tf.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "tests"), exist_ok=True)
        os.makedirs(os.path.join(td, "bulk_downloader"), exist_ok=True)
        for c in _ENV_TRANCHE_SUITES:
            open(os.path.join(td, c), "w").write("# stub\n")
        rel = "bulk_downloader/probe_mod.py"
        # the token is in a DOCSTRING only -- no os.environ read anywhere
        open(os.path.join(td, rel), "w").write(
            '"""doc mentions BD_SELFTEST_TOKEN and nothing reads it."""\nX = 1\n')
        added = env_tranche_suites(td, rel, {})               # file not in zip
        pos = env_tranche_suites(td, rel, {rel: "X = 1\n"})   # token is NEW
        neg = env_tranche_suites(
            td, rel, {rel: '"""doc mentions BD_SELFTEST_TOKEN."""\nX = 0\n'})
        et_ok = (len(pos) == len(_ENV_TRANCHE_SUITES)
                 and len(added) == len(_ENV_TRANCHE_SUITES)
                 and neg == set())
        print(("PASS" if et_ok else "FAIL") +
              "  ENV-TRANCHE: docstring-only BD_ token delta bands the %d-suite "
              "cluster (added=%d new=%d); unchanged token set does not (%d)"
              % (len(_ENV_TRANCHE_SUITES), len(added), len(pos), len(neg)))
        ok = ok and et_ok

    # @807 SIGNAL 7: a regen obligation must band the gate that ENFORCES it.
    # POS: a bulk_downloader/*.py change carries FUNCTION_INDEX + import-edge
    # gates; a version bump carries the pin-index gate. NEG: a docs-only change
    # carries none -- the cheap way to pass POS is to band the cluster always,
    # which would make every cut drag it along.
    _w = sec.DEFAULT_WORK
    # Assert on the BAND, not on regen_suites() -- testing the mapping function
    # would pass even with the union removed from derive(), which is a control
    # rigorous about the wrong subject (proven: reverting the union left a
    # mapping-only control green).
    _rows = map_rows(find_map(_w))
    _p1 = set(derive(_w, ["bulk_downloader/db.py"], _rows))
    _p2 = set(derive(_w, ["bulk_downloader/__init__.py"], _rows))
    _n1 = set(derive(_w, ["README.md"], _rows)) - set(FLOOR)
    _s7 = ("tests/test_function_index_in_sync.py" in _p1
           and "tests/test_import_graph_no_new_edges.py" in _p1
           and "tests/test_pin_index_in_sync.py" in _p2
           and "tests/test_function_index_in_sync.py" not in _n1
           and "tests/test_pin_index_in_sync.py" not in _n1)
    print(("PASS" if _s7 else "FAIL")
          + "  SIGNAL 7 regen-obligation: py-change bands index/import gates, "
            "bump bands pin gate, docs-only bands none (%d/%d/%d)"
          % (len(_p1), len(_p2), len(_n1)))
    ok = ok and _s7

    # @807 R1: the guard set is DERIVED, not re-typed. NEG pins that an absent
    # STATE falls back to 7 rather than emptying (an empty guard set is a gate
    # that cannot fire) and that the fallback SAYS SO.
    _r1 = (len(GUARD_BASES) >= 7
           and len(sec.guard_paths("/nonexistent-home")) == 7
           and "fallback" in sec.guard_source("/nonexistent-home").lower())
    print(("PASS" if _r1 else "FAIL")
          + "  R1 guard set derived from STATE, loud 7-literal fallback (%d bases, src=%s)"
          % (len(GUARD_BASES), sec.guard_source()))
    ok = ok and _r1

    # @848 NON-PY CONSUMER: the module-consumer signal used to `return []` for
    # anything not ending in .py, so every shell script and doc in the tree got
    # only the stem glob. MEASURED before the fix: capture.sh banded 73 suites
    # while `grep -rl "capture\.sh" tests/*.py` found 39, and the sets were
    # COMPLEMENTARY -- the tool missed 26 the grep found. For .py the tool is a
    # strict superset of the grep; for .sh it was not, which is worse than being
    # honestly narrow because the caller cannot tell which they got.
    #
    # POSITIVE: a .sh file bands a consumer that names it verbatim.
    # NEGATIVE (the reason the old bail existed): the match is on the FULL
    # BASENAME, so a bare stem cannot drag in prose -- "capture" alone must not
    # be what produced the hit.
    _np_pos = _np_neg = False
    try:
        _cap = module_consumers(sec.DEFAULT_WORK, "capture.sh")
        _np_pos = len(_cap) >= 20
        _bogus = module_consumers(sec.DEFAULT_WORK, "zzz_no_such_file.sh")
        _np_neg = not _bogus
    except Exception as _e:                       # never let the control pass by erroring
        print("FAIL  NON-PY CONSUMER: control raised %s" % _e)
    _np = _np_pos and _np_neg
    print(("PASS" if _np else "FAIL")
          + "  NON-PY CONSUMER: capture.sh bands its verbatim consumers (%d), "
            "an absent basename bands none (%s)"
          % (len(_cap) if _np_pos else -1, "ok" if _np_neg else "LEAKED"))
    ok = ok and _np

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(prog="bd-band-derive")
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--file")
    ap.add_argument("--files", nargs="+")
    ap.add_argument("--emit", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    # @807: REFUSE over a tree that is not there. Surfaced when the R1 sec import
    # pulled this tool into the lint's corpus-guard population (denominator
    # 104 -> 106) and it came back UNGUARDED -- a pre-existing hole, newly
    # visible. Measured: --work /nonexistent exited 0 with band=[] and advised
    # "bd-band tests/test_contracts.py". The band engine decides how much suite a
    # cut is tested against, so an empty band over a wrong path is an
    # under-tested cut wearing a green face. min_files=1 over *.py; the tests/
    # pattern is deliberately not required, since --file mode is legitimate on a
    # tree mid-extraction.
    sec.require_corpus(a.work, min_files=1, label="--work", patterns=("*.py",))
    # @860: SAY when the curated map is missing. It was absent on every
    # checkout (find_map did not look in project-knowledge/) and contributed
    # zero rows in SILENCE -- one of the four signals this tool unions, gone
    # without a word. A signal that can vanish quietly is worse than one that
    # is missing loudly, because the narrower band still looks authoritative.
    _mp = find_map(a.work)
    rows = map_rows(_mp)
    if not a.json and not a.emit:
        if not _mp:
            print("  NOTE curated map not found under %s -- signal 2 of 4 is "
                  "contributing nothing; this band is narrower than designed."
                  % a.work, file=sys.stderr)
        elif not rows:
            print("  NOTE curated map %s parsed to ZERO rows." % _mp,
                  file=sys.stderr)
    if a.file:
        return report(a.work, [a.file], rows, "FILE %s" % a.file,
                      deps=rev_deps(a.work, a.file), as_json=a.json, emit_only=a.emit)
    if a.files:
        return report(a.work, a.files, rows, "FILES (%d)" % len(a.files),
                      as_json=a.json, emit_only=a.emit)
    z = auto_zip()
    if not z:
        print("no baseline zip found -- pass --file/--files")
        return 2
    _changed, _zsrc = diff_tree(a.work, z)
    return report(a.work, _changed, rows,
                  "DIFF vs %s" % os.path.basename(z), as_json=a.json,
                  emit_only=a.emit, zsha_src=_zsrc)


if __name__ == "__main__":
    sys.exit(main())
