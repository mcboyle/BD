#!/usr/bin/env python3
"""bd-bandcheck -- validate a proposed band target list BEFORE running it, so you
don't trip the band footguns:
  * passing the whole tests/ dir or a known-hang file -> perf_lab hang / >200s timeout
  * passing a test-FUNCTION name as a path (test_spa_wired_join_is_faithful) ->
    run_tests falls back to a broad run -> timeout -> band ABORT
  * co-banding files that leak env (test_phases_195_199 leaks BD_INSTALL_DIR) ->
    the other file fails for no visible reason

Usage:
  bd-bandcheck tests/test_foo.py tests/test_bar.py ...
  bd-bandcheck --tree DIR tests/...
Exit 0 if all targets are safe, 1 for measured unsafe findings, or 2 when a
target cannot be measured and no measured unsafe finding exists.
"""
import argparse, os, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

# known-hang / never-band-directly (from KNOWN_FLAKES.md + memory)
HANG = {
    "test_perf_lab.py": "hangs the whole run; on-stash only",
    # REMOVED @849: "test_v3_66_146_nav_guard.py". CLAUDE.md section 5 refutes it
    # by name -- NO FILE OF THAT NAME EXISTS, in any variant (`git ls-files |
    # grep nav_guard` is empty), and both real 146 files
    # (test_v3_66_146_runtime_gate.py, test_v3_66_146_detection_safety.py) pass
    # in under a second. A blocklist entry for a phantom cannot fire, so it cost
    # nothing directly -- but this tool is now WIRED INTO bd-band, so every
    # entry here refuses a real band, and an entry the contract has retracted is
    # a gate firing on a claim nobody can reproduce. The second hanger remains
    # UNIDENTIFIED; do not re-add a name until someone measures one.
}
# test FUNCTIONS people mistake for files -> the real file to band instead
NOT_A_FILE = {
    "test_spa_wired_join_is_faithful": "tests/test_route_index_in_sync.py  (it's a FUNCTION at ~line 86, not a file)",
}
# pairs that must NOT co-band (env leak between them in a single-boot band)
LEAK_PAIRS = [
    ({"test_phases_195_199.py"}, {"test_cut8_schedules.py"},
     "test_phases_195_199 leaks BD_INSTALL_DIR in single-boot bands"),
]

def selftest():
    """DELEGATE: wraps bd-band. Asserts the target file is present in the tool's own
    bin dir -- if not, FAIL (a wrapper that cannot find what it wraps is broken;
    a selftest that cannot verify must not report success)."""
    import os as _o
    here = _o.path.dirname(_o.path.realpath(__file__))
    found = _o.path.isfile(_o.path.join(here, "bd-band"))
    print(("PASS" if found else "FAIL") + "  delegation target present: bd-band")
    print("SELFTEST PASS" if found else "SELFTEST FAIL")
    return 0 if found else 1


def check(targets, tree):
    """(rc, lines) for a proposed band. Factored out of main() @849 so bd-band
    can REFUSE an unsafe band instead of discovering it 200 seconds later.

    Pure: prints nothing, touches nothing. rc is 1 if any target is measured
    unsafe, else 2 if any target is unmeasurable. An EMPTY target list is rc 2
    -- "all targets safe" over zero targets is the CLAUDE.md section 0 shape,
    and this function is now a gate."""
    lines = []
    if not targets:
        return 2, ["  NO TARGETS -- a band over nothing is not a safe band."]
    unsafe = False
    unmeasurable = False
    names = set()
    for t in targets:
        base = os.path.basename(t.rstrip("/"))
        # whole-dir
        if t.rstrip("/").endswith("tests") or t.rstrip("/") in ("tests", "."):
            lines.append(f"  UNSAFE  '{t}' -- the whole tests/ dir HANGS at test_perf_lab.py. Band targeted files."); unsafe = True; continue
        # function-not-file
        stem = base[:-3] if base.endswith(".py") else base
        if stem in NOT_A_FILE:
            lines.append(f"  NOT A FILE  '{t}' is a test FUNCTION -> a broad run -> timeout -> ABORT.")
            lines.append(f"              band instead: {NOT_A_FILE[stem]}"); unsafe = True; continue
        # known hang
        if base in HANG:
            lines.append(f"  UNSAFE  {base} -- {HANG[base]}."); unsafe = True; continue
        # exists?
        path = t if os.path.isabs(t) else os.path.join(tree, t)
        if not os.path.exists(path):
            # maybe they gave a bare name
            alt = os.path.join(tree, "tests", base)
            if os.path.exists(alt):
                lines.append(f"  ok      {base}  (resolved to tests/{base})")
                names.add(base); continue
            # @876: `names.add(base)` runs even here. This branch used to
            # `continue` straight past it, so the leak-pair detector below ran
            # over an INCOMPLETE set -- a bare invocation of the
            # test_phases_195_199 + test_cut8_schedules pair printed two MISSING
            # lines and NO leak warning. Same exit code, different diagnosis:
            # the operator fixes the paths and then bands the pair that leaks
            # BD_INSTALL_DIR. A leak pair is a hazard about what you are ABOUT
            # TO BAND, not about what happened to resolve.
            lines.append(f"  MISSING '{t}' -- no such file under {tree}. Typo? (a non-file path triggers a broad run)."); unmeasurable = True
            names.add(base); continue
        lines.append(f"  ok      {os.path.relpath(path, tree)}")
        names.add(base)
    # leak-pair co-band check
    for setA, setB, why in LEAK_PAIRS:
        if names & setA and names & setB:
            lines.append(f"  LEAK CO-BAND  {sorted(names & setA)} + {sorted(names & setB)} -- {why}. Split into two bands."); unsafe = True
    return (1 if unsafe else 2 if unmeasurable else 0), lines


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser()
    ap.add_argument("targets", nargs="+")
    # @876: was "/home/claude/work", a zip-era path absent from any git
    # checkout, so a BARE invocation reported every target MISSING. It failed
    # CLOSED (exit 1), not clean -- but the DIAGNOSIS was wrong, and the
    # diagnosis is the product: the operator is told "Typo?" about a path that
    # is fine. sec.DEFAULT_WORK walks up to the repo root, which is what
    # bd-band:100 already used.
    ap.add_argument("--tree","--work", default=sec.DEFAULT_WORK)
    a = ap.parse_args()
    rc, lines = check(a.targets, a.tree)
    for l in lines:
        print(l)
    if rc == 0:
        summary = "all targets safe to band."
    elif rc == 2:
        summary = "=> one or more targets could not be measured; fix the MISSING paths before banding."
    else:
        summary = "=> fix the flagged targets before banding (else timeout/ABORT/false-fail)."
    print("\n" + summary)
    return rc

if __name__ == "__main__":
    sys.exit(main())
