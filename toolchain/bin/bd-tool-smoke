#!/usr/bin/env python3
"""bd-tool-smoke -- does the tool actually RUN? The check nothing else makes.

WHEN: before packaging a bdsuite; after adopting a helper into several tools; any time
a tool is edited. Run it in bd-precut alongside bd-tool-lint.

THE HOLE THIS FILLS (found @726, by reconciling a parallel session):
bd-guardcheck -- a RELEASE-GATING guard tool -- shipped with a `_bd_pick_newest()` helper
that calls re.findall() while the module never imported `re`. It NameError'd on every real
invocation. It shipped anyway, because EVERY existing check passed it:

    bd-tool-lint --gate --no-runtime   PASS  "toolchain clean"
    bd-tool-lint --gate  (FULL runtime) PASS  "toolchain clean"   <- runs --selftest
    bd-guardcheck --selftest            SELFTEST PASS
    bd-guardcheck --help                clean (argparse short-circuits first)
    bd-guardcheck   (real run)          NameError, exit 1         <- ONLY this

The runtime lint's denominator is "what the SELFTEST exercises", not "does the tool WORK".
bd-guardcheck's selftest delegates to a bd-coretest fault-injection harness that drives a
DIFFERENT code path than the entry point, so the broken line was never reached. A gate
whose denominator excludes the thing being asked about reports clean -- truthfully, and
uselessly. Same shape, one level up.

WHY STATIC, NOT "just run every tool":
Running all ~240 tools with no args (a) takes ~9 minutes, (b) MUTATES THE WORK TREE --
several tools write into reports/ and blew bd-preflight byte-identity when I tried it --
and (c) MISATTRIBUTES: bd-ready CALLS bd-guardcheck, so it relayed the crash in its own
output and looked broken when it was fine. A static undefined-name pass has none of those
problems and catches the exact class: it flags `re` used-but-never-imported without
executing a single line.

    bd-tool-smoke                  # scan every bd-* tool in bin/
    bd-tool-smoke --bin DIR
    bd-tool-smoke --gate           # exit 3 if any tool would crash
    bd-tool-smoke --run            # ALSO really invoke each tool (slow; see --run notes)
    bd-tool-smoke --json / --selftest

--run is OPT-IN and honest about its hazards: it snapshots the work tree, invokes each
tool, RESTORES anything the tools mutated, and attributes a traceback to the file in its
DEEPEST frame (so a caller is not blamed for its callee). Use it via bd-job; it is slow.

Exit: 0 clean | 2 the tool broke | 3 a tool would crash (with --gate).
"""
import argparse
import hashlib
import json
import os
import re
import signal
import subprocess
import sys

G, R, Y, C, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[36m", "\033[2m", "\033[0m"

# @854: resolved, not hardcoded. This tool IS in the bin it scans, and
# sec.DEFAULT_WORK walks up to the checkout, so both follow a relocation.
BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, BIN)
import bdtools_sec as sec  # noqa: E402
WORK = os.environ.get("BD_WORK", sec.DEFAULT_WORK)

# pyflakes messages that mean "this WILL raise at runtime", vs merely untidy.
#
# CAUTION, learned the hard way: an earlier version matched the bare substring
# "local variable", intending "referenced before assignment". But pyflakes also emits
# "local variable 'x' is assigned to but never used" -- an UNUSED VARIABLE, which is
# untidy and harmless. That flagged a dozen healthy tools as WOULD CRASH. A check that
# cries wolf is as useless as one that sleeps: match only what actually raises.
_FATAL = (
    "undefined name",                        # NameError -- the bd-guardcheck bug
    "referenced before assignment",          # UnboundLocalError
    "may be undefined, or defined from star imports",
)


def _python_tools(bindir):
    out = []
    for f in sorted(os.listdir(bindir)):
        p = os.path.join(bindir, f)
        if not os.path.isfile(p) or not f.startswith("bd"):
            continue
        try:
            with open(p, "rb") as fh:
                if b"python" not in fh.readline():
                    continue          # shell tools: pyflakes cannot read them
        except OSError:
            continue
        out.append(p)
    return out


def _flake(path):
    """Fatal pyflakes findings for one tool. Returns [] when clean.

    THE BLIND-GATE BUG (found @728b): pyflakes was NOT INSTALLED. `subprocess.run`
    still SUCCEEDS -- it runs python, which prints "No module named pyflakes" to
    stderr and exits nonzero -- so the `except` never fired, the fatal-string scan
    found nothing in that message, and this returned [] == CLEAN. The gate that
    exists to stop a broken tool from shipping reported "no tool would crash"
    because its analyzer was absent. That is exactly how bd-guardcheck shipped
    BROKEN at 726, and this function is why nothing caught it.

    An analyzer that cannot run is UNKNOWN, never clean. Unknown fails the gate.
    """
    try:
        r = subprocess.run([sys.executable, "-m", "pyflakes", path],
                           capture_output=True, text=True, timeout=60)
    except Exception as e:
        return [("unknown", "pyflakes could not run: %s" % e)]
    combined = r.stdout + r.stderr
    # The analyzer itself is missing/broken -> we verified NOTHING. Say so.
    if ("No module named pyflakes" in combined
            or "No module named" in combined and "pyflakes" in combined):
        return [("unknown", "pyflakes is NOT INSTALLED -- this gate verified "
                            "NOTHING (pip install pyflakes). Refusing to report "
                            "clean over an absent analyzer.")]
    hits = []
    for ln in combined.splitlines():
        low = ln.lower()
        if any(f in low for f in _FATAL):
            # strip the path prefix for readability
            hits.append(("fatal", ln.split(":", 1)[-1].strip() if ":" in ln else ln))
    return hits


def _tree_hashes(root):
    h = {}
    for dp, dn, fns in os.walk(root):
        dn[:] = [d for d in dn if d not in ("__pycache__", "node_modules", "venv",
                                            ".venv", ".git", "dist")]
        for fn in fns:
            p = os.path.join(dp, fn)
            try:
                h[p] = hashlib.sha256(open(p, "rb").read()).hexdigest()
            except OSError:
                continue
    return h


def _attribute(traceback_text, tools):
    """Which FILE actually raised? The DEEPEST frame wins.

    bd-ready CALLS bd-guardcheck; when guardcheck crashed, ready relayed the traceback and
    a naive grep blamed ready. Blame the file in the last `File "..."` line, not the tool
    whose stdout carried it.
    """
    frames = re.findall(r'File "([^"]+)"', traceback_text)
    if not frames:
        return None
    return frames[-1]


def cmd_scan(a):
    tools = _python_tools(a.bin)
    bad = {}
    for p in tools:
        hits = _flake(p)
        if hits:
            bad[os.path.basename(p)] = hits

    runtime_bad = {}
    slow = {}
    if a.run:
        # REAL-INVOCATION SMOKE. The static pass cannot see everything (a bad path, a
        # missing binary, an argparse bug). Actually running each tool CAN -- but a naive
        # `for t in bin/*; do $t; done` is WORSE than useless, and every one of these
        # hazards bit for real before being handled here:
        #
        #  1. ORPHANED GRANDCHILDREN. subprocess timeout kills the direct child, NOT its
        #     children. bd-tool-lint spawns ~240 subprocesses; killed at the timeout, its
        #     orphans KEPT RUNNING and KEPT WRITING -- racing (and beating) the restore.
        #     Fix: start_new_session + killpg the whole group.
        #  2. TIMEOUT IS NOT A CRASH. bd-tool-lint legitimately takes ~10 MINUTES. Calling
        #     a slow tool "CRASHED" is a lie. It is a THIRD state: DID NOT COMPLETE =
        #     unknown, reported separately, never silently folded into pass or fail.
        #  3. SELF-RECURSION. bd-tool-smoke invoking bd-tool-smoke invokes every tool again.
        #  4. IT MUTATES THE WORK TREE. Tools write into reports/. Snapshot -> run ->
        #     restore -> and then VERIFY the restore, because a restore that silently
        #     failed is exactly the shape this whole tool exists to kill.
        #
        #  CONCURRENCY WARNING: the restore is a blind overwrite of the snapshot. If the
        #  work tree is changed by ANYTHING ELSE while this runs, those changes are LOST.
        #  Do not run --run concurrently with a cut, an extract, or a deploy.
        me = os.path.abspath(__file__)
        me_name = os.path.basename(me)
        # exclude self by BASENAME too: a COPY of this tool in the scanned bin is still
        # self, and invoking it would recurse over every tool again.
        runnable = [p for p in tools
                    if os.path.abspath(p) != me and os.path.basename(p) != me_name]
        print(f"{DIM}--run: invoking {len(runnable)} tools (self excluded). Work tree is "
              f"snapshotted and restored. Do NOT change the tree while this runs.{RST}")
        snap = {}
        if os.path.isdir(WORK):
            for p in _tree_hashes(WORK):
                try:
                    snap[p] = open(p, "rb").read()
                except OSError:
                    pass
        for p in runnable:
            b = os.path.basename(p)
            try:
                proc = subprocess.Popen([p], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        stdin=subprocess.DEVNULL, text=True, cwd="/tmp",
                                        start_new_session=True)
            except Exception as e:
                runtime_bad.setdefault(b, []).append("could not launch: %s" % e)
                continue
            try:
                out = proc.communicate(timeout=a.timeout)[0] or ""
            except subprocess.TimeoutExpired:
                # kill the whole GROUP -- otherwise the tool's children outlive it and
                # keep writing into the work tree after we have "restored" it.
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except OSError:
                    pass
                proc.wait()
                slow[b] = "did not complete in %ds" % a.timeout
                continue
            m = re.search(r"^(NameError|ImportError|SyntaxError|IndentationError|"
                          r"UnboundLocalError):.*$", out, re.M)
            if not m:
                continue
            culprit = _attribute(out, runnable)
            if culprit and os.path.basename(culprit) != b:
                continue          # a CALLEE raised; reported under its own name, not ours
            runtime_bad.setdefault(b, []).append(m.group(0).strip())

        # RESTORE, then VERIFY the restore. A restore that silently failed would leave the
        # tree corrupt while this tool reported success -- the exact shape it exists to kill.
        restored, created = [], []
        for p, blob in snap.items():
            try:
                if open(p, "rb").read() != blob:
                    open(p, "wb").write(blob)
                    restored.append(p)
            except OSError:
                continue
        if os.path.isdir(WORK):
            for p in _tree_hashes(WORK):
                if p not in snap:
                    try:
                        os.remove(p)
                        created.append(p)
                    except OSError:
                        pass
        residual = []
        for p, blob in snap.items():
            try:
                if open(p, "rb").read() != blob:
                    residual.append(p)
            except OSError:
                residual.append(p)
        if restored or created:
            print(f"{DIM}--run touched the tree; restored {len(restored)} modified, "
                  f"removed {len(created)} created.{RST}")
        if residual:
            print(f"{R}RESTORE INCOMPLETE -- {len(residual)} file(s) still differ. The work "
                  f"tree is DIRTY:{RST}")
            for p in residual[:8]:
                print(f"    ~ {os.path.relpath(p, WORK)}")
            print(f"{R}  -> re-extract the source zip and run bd-preflight. Do NOT cut.{RST}")
        else:
            print(f"{G}work tree restored clean{RST} {DIM}(verified byte-for-byte){RST}")

    if a.json:
        print(json.dumps({
            "tools_scanned": len(tools),
            "would_crash": {k: [m for _, m in v] for k, v in bad.items()},
            "runtime_crash": runtime_bad,
            "did_not_complete": slow,
            "note": "did_not_complete is NOT a failure -- several tools legitimately take "
                    "minutes (bd-tool-lint ~10min). It is UNKNOWN: the run could not verify "
                    "them, and it says so rather than calling them clean.",
        }, indent=2))
        return 3 if ((bad or runtime_bad) and a.gate) else 0

    print(f"{C}bd-tool-smoke{RST} -- {len(tools)} python tools scanned "
          f"{DIM}(static undefined-name pass; no execution){RST}\n")
    if not bad and not runtime_bad:
        print(f"{G}CLEAN{RST} -- no tool would crash on invocation.")
    for t, hits in sorted(bad.items()):
        print(f"  {R}WOULD CRASH{RST} {t}")
        for _, msg in hits:
            print(f"      {msg}")
    for t, hits in sorted(runtime_bad.items()):
        print(f"  {R}CRASHED (--run){RST} {t}")
        for msg in hits:
            print(f"      {msg.strip()}")
    if slow:
        print(f"\n{Y}DID NOT COMPLETE{RST} in {a.timeout}s ({len(slow)}) -- "
              f"{DIM}UNKNOWN, not a failure. Several tools legitimately take minutes "
              f"(bd-tool-lint ~10min).{RST}")
        print(f"  {DIM}{' '.join(sorted(slow))}{RST}")
    if bad or runtime_bad:
        print(f"\n{Y}Nothing else in the toolchain sees these.{RST} --selftest passes "
              f"(it drives a different code\npath), --help short-circuits, and both "
              f"bd-tool-lint modes report 'toolchain clean'.")
    if (bad or runtime_bad) and a.gate:
        return 3
    return 0


def _selftest():
    import tempfile
    fails = []
    td = tempfile.mkdtemp(prefix="bdsmoke_")
    b = os.path.join(td, "bin")
    os.makedirs(b)
    # POS: the REAL bug -- a helper calling re.findall with no `import re`
    broken = os.path.join(b, "bd-broken")
    open(broken, "w").write(
        "#!/usr/bin/env python3\nimport os\n"
        "def pick(p):\n    return re.findall(r'\\\\d+', p)\n"
        "print(pick('x1'))\n")
    # NEG: the same file, correctly importing re -- must NOT be flagged
    okp = os.path.join(b, "bd-ok")
    open(okp, "w").write(
        "#!/usr/bin/env python3\nimport os, re\n"
        "def pick(p):\n    return re.findall(r'\\\\d+', p)\n"
        "print(pick('x1'))\n")
    # NEG: merely UNTIDY tools must NOT be called crashes. Covers BOTH shapes -- an unused
    # import AND an unused local variable. The second one matters: an earlier build matched
    # the substring "local variable", which pyflakes also uses for "assigned to but never
    # used", and it flagged a dozen healthy tools as WOULD CRASH.
    tidy = os.path.join(b, "bd-untidy")
    open(tidy, "w").write("#!/usr/bin/env python3\nimport os, json\n"
                          "def f():\n    unused = 1\n    return 2\nprint(f())\n")
    # POS: a REAL UnboundLocalError must still be caught
    unbound = os.path.join(b, "bd-unbound")
    open(unbound, "w").write("#!/usr/bin/env python3\n"
                             "def f():\n    print(x)\n    x = 1\nf()\n")
    for p in (broken, okp, tidy, unbound):
        os.chmod(p, 0o755)

    if not _flake(broken):
        fails.append("missed the undefined-name crash (the bd-guardcheck bug)")
    if _flake(okp):
        fails.append("false positive on a correctly-importing tool")
    if _flake(tidy):
        fails.append("an unused import/variable was reported as a CRASH (untidy != broken)")
    if not _flake(unbound):
        fails.append("missed a real UnboundLocalError (referenced before assignment)")

    # NEG (attribution): a callee's traceback must NOT be blamed on the caller.
    tb = ('Traceback (most recent call last):\n'
          '  File "/home/claude/bin/bd-ready", line 10, in <module>\n'
          '  File "/home/claude/bin/bd-guardcheck", line 28, in _k\n'
          "NameError: name 're' is not defined\n")
    who = _attribute(tb, [])
    if not who or os.path.basename(who) != "bd-guardcheck":
        fails.append("attribution blamed the CALLER (bd-ready) instead of the callee "
                     "(bd-guardcheck) -- got %s" % who)

    # NEG (--run SAFETY): the restore path must actually restore. A smoke test that
    # corrupts the work tree is worse than no smoke test -- running every tool raw DID
    # blow bd-preflight byte-identity (reports/*.json) before this was added.
    global WORK
    _saved_work = WORK
    fake_work = os.path.join(td, "work")
    os.makedirs(os.path.join(fake_work, "reports"))
    victim = os.path.join(fake_work, "reports", "out.json")
    open(victim, "w").write("ORIGINAL")
    WORK = fake_work
    mutator = os.path.join(b, "bd-mutator")
    open(mutator, "w").write(
        "#!/usr/bin/env python3\n"
        "open(%r, 'w').write('CLOBBERED')\n" % victim)
    os.chmod(mutator, 0o755)
    ns = argparse.Namespace(bin=b, gate=False, run=True, json=True, timeout=10)
    import io
    import contextlib
    _buf = io.StringIO()
    with contextlib.redirect_stdout(_buf):
        cmd_scan(ns)
    if open(victim).read() != "ORIGINAL":
        fails.append("--run did NOT restore a work-tree file a tool clobbered "
                     "(got %r) -- the smoke test would corrupt the tree"
                     % open(victim).read())
    WORK = _saved_work

    import shutil
    shutil.rmtree(td, ignore_errors=True)
    if fails:
        for f in fails:
            print("  - " + f)
        print("SELFTEST FAIL")
        return 2
    print(f"{DIM}(catches the real bug; no false positive on correct or merely-untidy "
          f"tools; attributes to the callee){RST}")
    print("SELFTEST PASS")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="bd-tool-smoke")
    ap.add_argument("--bin", default=BIN)
    ap.add_argument("--gate", action="store_true",
                    help="exit 3 if any tool would crash (for bd-precut)")
    ap.add_argument("--run", action="store_true",
                    help="ALSO really invoke each tool (slow, ~10min; snapshots + RESTORES "
                         "the work tree; run it under bd-job)")
    ap.add_argument("--timeout", type=int, default=20,
                    help="per-tool timeout for --run (default 20s; a hang is a finding)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return _selftest()
    return cmd_scan(a)


if __name__ == "__main__":
    sys.exit(main())
