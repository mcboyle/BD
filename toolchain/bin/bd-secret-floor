#!/usr/bin/env python3
"""bd-secret-floor -- prove the canonical redactor is the ONLY redaction path.

Finds output sinks (logging.*, open(...,'w') to logs/exports/reports, report/
markdown writers) whose nearby content carries secret-material identifiers
(token/secret/api_key/password/cookie/authorization) in a module that never
imports/calls the canonical redactor -> BD-REDACT-FLOOR-GAP. Separately flags
ad-hoc re.sub redaction of secret patterns not delegating to canonical ->
BD-REDACT-ADHOC. Advisory, read-only, deterministic.

Usage: bd-secret-floor [--work DIR] [--canonical mod:sym | sym] [--json]
       bd-secret-floor --selftest
Exit 0 always (advisory); --json emits the Finding list.
"""
import argparse
import os
import re
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

LOG_SINK = re.compile(r'\b(?:logging|log|logger)\.(?:info|warning|error|debug|critical|exception)\s*\(')
WRITE_SINK = re.compile(r'\bopen\s*\([^)]*(?:log|export|report|\.md|\.csv|\.txt)[^)]*,\s*["\'][wa]')
ADHOC = re.compile(r're\.sub\s*\([^)]*(?i:secret|token|api[_-]?key|password|cookie|bearer|authorization)')
CANON_NAME = re.compile(r'\b(redact|scrub|sanitize)\w*\b')
IMPORT_LINE = re.compile(r'^\s*(?:from\s+[\w.]+\s+import\s+.*|import\s+[\w.]+.*)$', re.M)


def detect_canonical(work):
    """Most-imported redact/scrub/sanitize symbol across the tree."""
    counts = {}
    for _p, _rel, txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        for line in IMPORT_LINE.findall(txt):
            for sym in CANON_NAME.findall(line):
                counts[sym] = counts.get(sym, 0) + 1
    if not counts:
        return None
    return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[0][0]


def scan(work, canonical=None):
    canon = canonical or detect_canonical(work)
    canon_sym = canon.split(":")[-1] if canon else None
    canon_re = re.compile(r'\b' + re.escape(canon_sym) + r'\b') if canon_sym else None
    findings = []
    for _p, rel, txt in sec.iter_py(work):
        lines = txt.splitlines()
        uses_canonical = bool(canon_re.search(txt)) if canon_re else False
        has_adhoc = bool(ADHOC.search(txt))  # ADHOC covers the module; no GAP too
        for i, line in enumerate(lines, 1):
            if ADHOC.search(line) and not (canon_re and canon_re.search(line)):
                findings.append(sec.finding(
                    "bd-secret-floor", "BD-REDACT-ADHOC", "medium", rel, i,
                    "ad-hoc re.sub secret redaction not delegating to canonical"
                    + (f" '{canon_sym}'" if canon_sym else ""),
                    snippet=line.strip()[:120]))
                continue
            if uses_canonical or has_adhoc:
                continue  # canonical path, or already reported as ADHOC
            if LOG_SINK.search(line) or WRITE_SINK.search(line):
                win = "\n".join(lines[max(0, i - 4):i + 3])
                if sec.SECRET_WORD_RE.search(win):
                    findings.append(sec.finding(
                        "bd-secret-floor", "BD-REDACT-FLOOR-GAP", "high", rel, i,
                        "secret-material near output sink; module never uses canonical redactor"
                        + (f" '{canon_sym}'" if canon_sym else ""),
                        snippet=line.strip()[:120]))
    findings.sort(key=lambda f: (f["rule"], f["file"], f["line"]))
    return canon_sym, findings


def selftest():
    ok = True
    clean = ('from bulk_downloader.redact import scrub\n'
             'import logging\n'
             'def emit(api_key):\n'
             '    logging.info("key=%s", scrub(api_key))\n')
    gap = ('import logging\n'
           'def emit(api_key):\n'
           '    logging.info(f"key={api_key}")\n')
    adhoc = ('import re, logging\n'
             'def emit(msg):\n'
             '    clean = re.sub(r"api_key=\\S+", "api_key=***", msg)\n'
             '    logging.info(clean)\n')
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bulk_downloader")
        os.makedirs(b)
        for name, body in (("m_clean.py", clean), ("m_gap.py", gap), ("m_adhoc.py", adhoc)):
            open(os.path.join(b, name), "w").write(body)
        canon, f = scan(d, canonical="scrub")
    rules = sorted((x["rule"], os.path.basename(x["file"])) for x in f)
    want = [("BD-REDACT-ADHOC", "m_adhoc.py"), ("BD-REDACT-FLOOR-GAP", "m_gap.py")]
    good = rules == want
    print(("PASS" if good else "FAIL") + f"  fixture: exactly gap+adhoc (got {rules})")
    ok &= good
    t0 = time.time()
    canon, a = scan(sec.DEFAULT_WORK)
    dt = time.time() - t0
    _c, b2 = scan(sec.DEFAULT_WORK)
    det = [(x["file"], x["line"]) for x in a] == [(x["file"], x["line"]) for x in b2]
    print(("PASS" if det else "FAIL") + f"  real-tree determinism ({len(a)} findings x2)")
    ok &= det
    fast = dt < 30
    print(("PASS" if fast else "FAIL") + f"  real-tree run < 30s ({dt:.1f}s, canonical={canon})")
    ok &= fast
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--canonical", default=None,
                    help="module:symbol or bare symbol (default: auto-detect)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()

    canon, findings = scan(a.work, a.canonical)
    gaps = [f for f in findings if f["rule"] == "BD-REDACT-FLOOR-GAP"]
    adhoc = [f for f in findings if f["rule"] == "BD-REDACT-ADHOC"]
    if sec.emit({"canonical": canon, "findings": findings,
                 "summary": {"gaps": len(gaps), "adhoc": len(adhoc)}},
                as_json=a.json):
        return 0

    print(f"canonical redactor: {G}{canon or '(none detected)'}{RST}")
    if not findings:
        print(f"{G}all secret-bearing sinks are on the canonical redaction path{RST}")
        return 0
    for f in findings[:40]:
        tag = (R + "GAP  " + RST) if f["rule"].endswith("GAP") else (Y + "ADHOC" + RST)
        print(f"  {tag} {f['file']}:{f['line']}  {DIM}{f['extra']['snippet']}{RST}")
    print(f"{DIM}{len(gaps)} floor gap(s), {len(adhoc)} ad-hoc redactor(s){RST}")
    return 0


sys.exit(main())
