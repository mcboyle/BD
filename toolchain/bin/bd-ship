#!/usr/bin/env python3
"""bd-ship -- one-command session close: the mirror of bd-boot (which chains the
open). Chains the mechanical close steps, halting on the first failure:

    bd-precut   (advisory prediction; never gates)
    bd-cut      (tsc -> vitest -> vite -> bump+regen -> build_release -> band -> verify)
    bd-handoff  (repin STATE from the built zip -> self-check -> bd-pack lint+zip)

bd-cut emits the zip into --out; bd-ship derives that path and feeds it to
bd-handoff so you don't transcribe it. A failed cut stops the chain (no handoff
on a NO-CUT). bd-ship NEVER deploys -- handoff only repins + packs.

PREREQUISITE: you must have authored the pack PROSE first (STATE.json narrative +
KB_HANDOFF_v3_66_<n>.md) in --pack-dir -- bd-handoff/bd-pack fix the byte-facts and
lint, but they do not write your narrative. Use --no-handoff to stop after the cut
if the prose isn't ready yet.

Usage:
    bd python3 bd-ship --version 3.66.365 --changelog "..." \
        --baseline /mnt/user-data/uploads/BulkDownloader_v3_66_364.zip \
        [--pack-dir /home/claude/work_pack] [--out /home/claude/out] \
        [--suites tests/a.py tests/b.py] [--rm-runtime-db] [--no-handoff]
Exit 0 = cut + (handoff) all green; 1 = a step failed.
"""
import argparse
import os
import re
import subprocess
import sys
from shutil import which

G, R, Y, RST = "\033[32m", "\033[31m", "\033[33m", "\033[0m"


def have(tool):
    p = which(tool)
    if not p:
        print(f"{R}FAIL{RST} {tool} not on PATH (run setup.sh / bd-install)")
    return p


def section(msg):
    print(f"\n{G}================ bd-ship: {msg} ================{RST}")


def selftest():
    """DELEGATE: wraps bd-cut. FAIL if the target is not present in the bin dir."""
    import os as _o
    here=_o.path.dirname(_o.path.realpath(__file__))
    found=_o.path.isfile(_o.path.join(here,"bd-cut"))
    print(("PASS" if found else "FAIL")+"  delegation target present: bd-cut")
    print("SELFTEST PASS" if found else "SELFTEST FAIL"); return 0 if found else 1


def main(argv=None):
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser(prog="bd-ship")
    ap.add_argument("--version", required=True)
    ap.add_argument("--changelog", required=True)
    ap.add_argument("--baseline", help="live release zip (for precut + approved-frontend)")
    ap.add_argument("--pack-dir", default="/home/claude/work_pack")
    ap.add_argument("--out", default="/home/claude/out")
    ap.add_argument("--suites", nargs="*", help="extra band suites (passed to bd-cut)")
    ap.add_argument("--rm-runtime-db", action="store_true")
    ap.add_argument("--no-handoff", action="store_true",
                    help="stop after the cut (prose not ready)")
    a = ap.parse_args(argv)

    bd_cut = have("bd-cut")
    bd_handoff = None if a.no_handoff else have("bd-handoff")
    if not bd_cut or (not a.no_handoff and not bd_handoff):
        return 1
    bd_precut = which("bd-precut")  # optional/advisory

    # --- precut (advisory) ---
    if bd_precut and a.baseline:
        section("bd-precut (advisory)")
        subprocess.run([sys.executable, bd_precut, "--baseline", a.baseline], timeout=150)

    # --- cut ---
    section(f"bd-cut -> v{a.version}")
    cut_cmd = [sys.executable, bd_cut, "--version", a.version,
               "--changelog", a.changelog, "--out", a.out]
    if a.baseline:
        cut_cmd += ["--baseline", a.baseline]
    if a.suites:
        cut_cmd += ["--suites", *a.suites]
    if a.rm_runtime_db:
        cut_cmd.append("--rm-runtime-db")
    if subprocess.run(cut_cmd, timeout=150).returncode != 0:
        print(f"{R}FAIL{RST} bd-cut did not complete -- NO ship (handoff skipped)")
        return 1

    # --- derive the built zip path ---
    tag = a.version.replace(".", "_")
    zpath = os.path.join(a.out, f"BulkDownloader_v{tag}.zip")
    if not os.path.exists(zpath):
        cands = [f for f in os.listdir(a.out)
                 if re.match(r"BulkDownloader_v.*\.zip$", f) and "overlay" not in f]
        if not cands:
            print(f"{R}FAIL{RST} no built zip in {a.out} to hand off")
            return 1
        zpath = os.path.join(a.out, sorted(cands)[-1])
        print(f"  {Y}note{RST} derived built zip: {os.path.basename(zpath)}")

    if a.no_handoff:
        print(f"\n{G}bd-ship: cut complete{RST} -> {zpath}\n"
              f"{Y}--no-handoff{RST}: author the pack prose, then run "
              f"bd-handoff --version {a.version} --zip {zpath}")
        return 0

    # --- handoff (repin + self-check + pack) ---
    section("bd-handoff (repin STATE + bd-pack lint+zip)")
    ho = subprocess.run([sys.executable, bd_handoff, "--version", a.version,
                         "--zip", zpath, "--pack-dir", a.pack_dir], timeout=150)
    if ho.returncode != 0:
        print(f"{R}FAIL{RST} bd-handoff failed -- STATE/pack not finalized")
        return 1

    print(f"\n{G}bd-ship: PASS{RST} -- v{a.version} cut, verified, STATE repinned, "
          f"version.zip packed. Deploy is a separate human gate.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
