#!/usr/bin/env python3
"""bd-ship -- one-command session close: the mirror of bd-boot (which chains the
open). Chains the mechanical close steps, halting on the first failure:

    bd-precut   (advisory prediction; never gates)
    bd-cut      (tsc -> vitest -> vite -> bump+regen -> build_release -> band -> verify)
    bd-handoff  (repin STATE from the built zip -> self-check -> bd-pack lint+zip)

bd-cut emits the zip into --out; bd-ship derives that path and feeds it to
bd-handoff so you don't transcribe it. A failed cut stops the chain (no handoff
on a NO-CUT). bd-ship NEVER deploys -- handoff only repins + packs.

PREREQUISITE: you must have authored the pack PROSE first (the STATE narrative +
KB_HANDOFF_v3_66_<n>.md) in --pack-dir -- bd-handoff/bd-pack fix the byte-facts and
lint, but they do not write your narrative. Use --no-handoff to stop after the cut
if the prose isn't ready yet.

v3.66.855: the chained tools are resolved from PATH *or* from bd-ship's own bin
dir (nothing is on PATH in a git checkout, which made this tool unrunnable), and
--out defaults to <checkout>/out to match bd-cut. --pack-dir has NO default --
the sandbox's work_pack is retired and the pack dir is a per-machine location,
so it must be named whenever a handoff is requested.

Usage:
    bd-ship --version 3.66.365 --changelog "..." \
        [--baseline /path/to/BulkDownloader_v3_66_364.zip] \
        [--pack-dir DIR] [--out DIR] \
        [--suites tests/a.py tests/b.py] [--rm-runtime-db] [--no-handoff]
Exit 0 = cut + (handoff) all green; 1 = a step failed; 2 = CANNOT-EVALUATE
(a chained tool or the pack dir is absent, so nothing was attempted).
"""
import argparse
import os
import re
import subprocess
import sys
from shutil import which

# After the whole import block: above `import sys` this would leave sys
# undefined here and --help would die with NameError (the v3.66.851 trap).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

G, R, Y, RST = "\033[32m", "\033[31m", "\033[33m", "\033[0m"

BIN = os.path.dirname(os.path.realpath(__file__))


def have(tool):
    """Resolve a chained bd-* tool: PATH first, then THIS tool's own bin dir.

    v3.66.855: PATH-only was a sandbox assumption (setup.sh / bd-install put the
    suite on PATH there). In a git checkout nothing is on PATH, so every one of
    these lookups missed and bd-ship could not run at all -- it printed "not on
    PATH" and returned 1 while the tool it wanted sat next to it on disk. Same
    fix as bd-cut's regen_order: resolve from a known location, not from PATH.
    """
    p = which(tool)
    if not p:
        sibling = os.path.join(BIN, tool)
        if os.path.isfile(sibling):
            return sibling
    if not p:
        print(f"{R}FAIL{RST} {tool} not on PATH and not beside bd-ship in {BIN}")
    return p


def section(msg):
    print(f"\n{G}================ bd-ship: {msg} ================{RST}")


def selftest():
    """DELEGATE: wraps bd-cut. FAIL if the target is not present in the bin dir."""
    import os as _o
    here=_o.path.dirname(_o.path.realpath(__file__))
    found=_o.path.isfile(_o.path.join(here,"bd-cut"))
    print(("PASS" if found else "FAIL")+"  delegation target present: bd-cut")
    print("SELFTEST PASS" if found else "SELFTEST FAIL"); return 0 if found else 1


def main(argv=None):
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser(prog="bd-ship")
    ap.add_argument("--version", required=True)
    ap.add_argument("--changelog", required=True)
    ap.add_argument("--baseline", help="live release zip (for precut + approved-frontend)")
    # v3.66.855 port: both defaults were retired-sandbox literals.
    # --out now matches bd-cut's own default, <checkout>/out (gitignored), so the
    # zip path bd-ship derives is the one bd-cut actually wrote.
    # --pack-dir has NO default on purpose. The old /home/claude/work_pack is
    # gone and there is no in-checkout equivalent: the pack dir holds operator
    # PROSE (the STATE narrative + KB_HANDOFF) which is a per-machine location,
    # not a repo path. Guessing one would silently hand bd-handoff an empty
    # directory. Absent + handoff requested is refused below, loudly.
    ap.add_argument("--pack-dir", default=None,
                    help="dir holding the authored pack prose (required unless "
                         "--no-handoff; no default -- it is per-machine)")
    ap.add_argument("--out", default=os.path.join(sec.DEFAULT_WORK, "out"))
    ap.add_argument("--suites", nargs="*", help="extra band suites (passed to bd-cut)")
    ap.add_argument("--rm-runtime-db", action="store_true")
    ap.add_argument("--no-handoff", action="store_true",
                    help="stop after the cut (prose not ready)")
    a = ap.parse_args(argv)

    bd_cut = have("bd-cut")
    bd_handoff = None if a.no_handoff else have("bd-handoff")
    if not bd_cut or (not a.no_handoff and not bd_handoff):
        return 1

    # Refuse BEFORE the ~minutes-long cut, not after it: discovering the pack dir
    # is missing at the handoff step wastes the whole build. Exit 2 = nothing was
    # attempted, which is a different thing from "the cut failed" (1).
    if not a.no_handoff and not a.pack_dir:
        sys.stderr.write(
            "CANNOT-EVALUATE --pack-dir: reason=ABSENT (handoff needs a pack dir "
            "holding the authored prose)\n"
            "  There is no default: the old /home/claude/work_pack is retired and a\n"
            "  repo path would be a guess. Pass --pack-dir DIR, or --no-handoff to\n"
            "  stop after the cut.\n")
        return sec.EXIT_CANNOT_EVALUATE
    if not a.no_handoff and not os.path.isdir(a.pack_dir):
        sys.stderr.write("CANNOT-EVALUATE --pack-dir %s: reason=ABSENT (no such "
                         "directory)\n" % a.pack_dir)
        return sec.EXIT_CANNOT_EVALUATE
    bd_precut = which("bd-precut")  # optional/advisory

    # --- precut (advisory) ---
    if bd_precut and a.baseline:
        section("bd-precut (advisory)")
        subprocess.run([sys.executable, bd_precut, "--baseline", a.baseline], timeout=150)

    # --- cut ---
    section(f"bd-cut -> v{a.version}")
    cut_cmd = [sys.executable, bd_cut, "--version", a.version,
               "--changelog", a.changelog, "--out", a.out]
    if a.baseline:
        cut_cmd += ["--baseline", a.baseline]
    if a.suites:
        cut_cmd += ["--suites", *a.suites]
    if a.rm_runtime_db:
        cut_cmd.append("--rm-runtime-db")
    if subprocess.run(cut_cmd, timeout=150).returncode != 0:
        print(f"{R}FAIL{RST} bd-cut did not complete -- NO ship (handoff skipped)")
        return 1

    # --- derive the built zip path ---
    tag = a.version.replace(".", "_")
    zpath = os.path.join(a.out, f"BulkDownloader_v{tag}.zip")
    if not os.path.exists(zpath):
        cands = [f for f in os.listdir(a.out)
                 if re.match(r"BulkDownloader_v.*\.zip$", f) and "overlay" not in f]
        if not cands:
            print(f"{R}FAIL{RST} no built zip in {a.out} to hand off")
            return 1
        zpath = os.path.join(a.out, sorted(cands)[-1])
        print(f"  {Y}note{RST} derived built zip: {os.path.basename(zpath)}")

    if a.no_handoff:
        print(f"\n{G}bd-ship: cut complete{RST} -> {zpath}\n"
              f"{Y}--no-handoff{RST}: author the pack prose, then run "
              f"bd-handoff --version {a.version} --zip {zpath}")
        return 0

    # --- handoff (repin + self-check + pack) ---
    section("bd-handoff (repin STATE + bd-pack lint+zip)")
    ho = subprocess.run([sys.executable, bd_handoff, "--version", a.version,
                         "--zip", zpath, "--pack-dir", a.pack_dir], timeout=150)
    if ho.returncode != 0:
        print(f"{R}FAIL{RST} bd-handoff failed -- STATE/pack not finalized")
        return 1

    print(f"\n{G}bd-ship: PASS{RST} -- v{a.version} cut, verified, STATE repinned, "
          f"version.zip packed. Deploy is a separate human gate.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
