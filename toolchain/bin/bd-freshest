#!/usr/bin/env python3
"""bd-freshest -- point every scoping/validation pass at the NEWEST authoritative
doc, and flag stale artifacts before they mislead you.

Immunizes two @682 failure shapes:
  * scope-from-oldest-catalog-not-newest-state -- the first scope was built from
    the @601 catalogs while BD_CONSOLIDATED_STATE_679 / VALIDATION_REPORT_679
    already held the truth. bd-freshest surfaces the newest of those FIRST.
  * the bd-state-spooking stray zip -- a leftover BulkDownloader_v3_66_<old>.zip
    makes bd-state emit 4 scary FAILs vs STATE's current version. bd-freshest
    lists stray zips whose version != STATE.built_version so you expect it.

Usage:
  bd-freshest [dir]                 # default: /home/claude/nextsess
  bd-freshest --state <STATE.json>  # override STATE (for built_version)

Exit 0 always (advisory).
"""
import argparse, glob, json, os, re, sys

VER = re.compile(r"v?3[._]66[._](\d+)")
# doc families that matter for scoping, newest-wins
FAMILIES = {
    "CONSOLIDATED_STATE": "consolidated state (START SCOPING HERE)",
    "VALIDATION_REPORT":  "validation report (built-status truth)",
    "PHASED_EXECUTION":   "phased execution plan",
    "EPIC_SCOPING":       "epic scoping plan",
    "KB_HANDOFF":         "session handoff",
    "KB_JUDGMENT":        "durable judgment layer",
}
CATALOGS = ("FEATURES_MAXIMALIST", "BD_FEATURE_IDEAS", "COMPATIBILITY_AND_INTEROP_ROADMAP",
            "IDEAS_", "FEATURE_EXECUTION_PLAN", "CONSOLIDATED_EXECUTION_PLAN", "PROGRAM_")

def ver_of(name):
    m = VER.search(name)
    return int(m.group(1)) if m else -1

def built_version(state_path):
    try:
        d = json.load(open(state_path))
        m = VER.search(str(d.get("built_version", "")))
        return int(m.group(1)) if m else None
    except Exception:  # why: input unavailable/unreadable; return empty so the caller uses its fallback, not a wrong value
        return None

def newest(files):
    if not files:
        return None
    return max(files, key=lambda f: (ver_of(os.path.basename(f)), os.path.getmtime(f)))

def selftest():
    # ver_of() pulls the cut number from a filename; must reject one without.
    a = ver_of("BulkDownloader_v3_66_728.zip")
    b = ver_of("random_file.zip")
    # -1 is the intended SORT sentinel (version-less files sort BELOW any real
    # cut in max(key=(ver_of, mtime))); the contract is "a real version outranks
    # a version-less name", not "returns None".
    ok = (a == 728 and b < a and b == -1)
    print(("PASS" if a == 728 else "FAIL") + "  extracts 728 from a real name (%s)" % a)
    print(("PASS" if b < a else "FAIL") + "  NEG: no-version name sorts below a real cut (%r < %r)" % (b, a))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description="Locate newest authoritative docs + flag stale artifacts.")
    ap.add_argument("dir", nargs="?", default="/home/claude/nextsess")
    ap.add_argument("--state", default=None)
    ap.add_argument("--selftest", action="store_true",
                   help="real fault-injection selftest")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    d = a.dir.rstrip("/")
    state_path = a.state or os.path.join(d, "STATE.json")
    bv = built_version(state_path)
    allmd = glob.glob(os.path.join(d, "*.md")) + glob.glob(os.path.join(d, "*.json")) + glob.glob(os.path.join(d, "*.xlsx"))

    print(f"dir: {d}    STATE.built_version: {('3.66.'+str(bv)) if bv else 'unknown'}\n")
    print("NEWEST AUTHORITATIVE DOC PER FAMILY --")
    for prefix, desc in FAMILIES.items():
        fam = [f for f in allmd if os.path.basename(f).startswith(prefix) or prefix in os.path.basename(f)]
        n = newest(fam)
        if n:
            v = ver_of(os.path.basename(n))
            lag = f"  [LAGS built by {bv - v}]" if (bv and 0 <= v < bv) else ""
            print(f"  {desc:<34} {os.path.basename(n)}{lag}")
        else:
            print(f"  {desc:<34} (none found)")

    # stale planning catalogs
    stale = []
    for f in allmd:
        b = os.path.basename(f)
        if any(b.startswith(c) for c in CATALOGS):
            v = ver_of(b)
            banner = ""
            try:
                if "SUPERSEDED" in open(f, errors="ignore").read(400):
                    banner = " [SUPERSEDED banner present]"
            except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
                pass
            stale.append((b, v, banner))
    if stale:
        print("\nPLANNING CATALOGS (verify SUPERSEDED before treating as an open backlog) --")
        for b, v, banner in sorted(stale):
            lag = f"  [v{v}, lags built by {bv - v}]" if (bv and 0 <= v < bv) else ""
            print(f"  {b}{lag}{banner}")

    # stray zips that will spook bd-state
    zips = glob.glob(os.path.join(d, "*.zip")) + glob.glob(os.path.join(os.path.dirname(d) or ".", "*.zip"))
    stray = []
    for z in sorted(set(zips)):
        b = os.path.basename(z)
        if not b.startswith("BulkDownloader_"):
            continue
        v = ver_of(b)
        if bv and v != bv:
            stray.append((b, v))
    if stray:
        print("\nSTRAY SOURCE ZIPS (bd-state auto-compares these -> version-mismatch FAILs; pass --zip explicitly) --")
        for b, v in stray:
            print(f"  {b}  [v{v} != built {bv}]")

    print("\ntip: start any scoping pass from the CONSOLIDATED_STATE / VALIDATION_REPORT above, not the catalogs.")
    return 0

if __name__ == "__main__":
    sys.exit(main())
