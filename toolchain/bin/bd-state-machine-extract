#!/usr/bin/env python3
"""bd-state-machine-extract -- infer state machines from code + tests.

Scans a subsystem's modules for a status vocabulary (string literals assigned to
status/state fields) and the observed transitions (status set to A in a context
that also references B, or explicit 'A -> B' comments / set_status calls in
sequence). Emits the inferred states + candidate transitions for the download/
capture/scheduler/plugin-lifecycle workflows -- the model bd-state-machine-test
checks against. Heuristic, read-only.

Usage: bd-state-machine-extract [--subsystem runner] [--work DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
STATUS_ASSIGN=re.compile(r'(?:status|state)\s*[=:]\s*["\']([a-z_]+)["\']')
SET_STATUS=re.compile(r'set_status\(\s*["\']([a-z_]+)["\']')
ARROW=re.compile(r'["\']?([a-z_]+)["\']?\s*->\s*["\']?([a-z_]+)["\']?')

def extract(work, subsystem):
    states=set(); transitions=set()
    for _p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        if subsystem not in rel: continue
        for m in STATUS_ASSIGN.finditer(txt): states.add(m.group(1))
        for m in SET_STATUS.finditer(txt): states.add(m.group(1))
        for m in ARROW.finditer(txt):
            a,b=m.group(1),m.group(2)
            if a in states or b in states or (len(a)>2 and len(b)>2):
                transitions.add((a,b))
    # keep transitions whose both ends are known states
    trans=[list(t) for t in transitions if t[0] in states and t[1] in states]
    return {"subsystem":subsystem,"states":sorted(states),"transitions":sorted(map(tuple,trans))}

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b=os.path.join(d,"bulk_downloader"); os.makedirs(b)
        open(os.path.join(b,"runner.py"),"w").write(
            'def f():\n    status = "pending"\n    set_status("running")\n'
            '    # pending -> running -> done\n    status = "done"\n')
        r=extract(d,"runner")
    print(("PASS" if "pending" in r["states"] and "running" in r["states"] and "done" in r["states"] else "FAIL")+"  states extracted (%s)"%r["states"])
    ok=ok and {"pending","running","done"}<=set(r["states"])
    trans=set(map(tuple,r["transitions"]))
    print(("PASS" if ("pending","running") in trans else "FAIL")+"  arrow transition extracted (%s)"%r["transitions"])
    ok=ok and ("pending","running") in trans
    real=extract(sec.DEFAULT_WORK,"runner")
    print(("PASS" if len(real["states"])>0 else "WARN")+"  real runner: %d states, %d transitions"%(len(real["states"]),len(real["transitions"])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--subsystem",default="runner"); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    r=extract(a.work,a.subsystem)
    if sec.emit(r,as_json=a.json): return 0
    print("%s state machine: %d states, %d transitions"%(a.subsystem,len(r["states"]),len(r["transitions"])))
    print("  states: %s"%", ".join(r["states"]))
    for t in r["transitions"][:30]: print("  %s%s -> %s%s"%(DIM,t[0],t[1],RST))
    return 0
if __name__ == "__main__":
    sys.exit(main())
