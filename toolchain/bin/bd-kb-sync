#!/usr/bin/env python3
"""bd-kb-sync -- keep static project knowledge in sync via a sha256 manifest.

THE PROBLEM. The static project-knowledge set (the files pasted into the Claude
project) is an always-on CACHE of durable docs. They evolve mid-session (ADVANCED_
PROJECT_KNOWLEDGE, GLOSSARY, ARCHITECTURE_MAP, the reference cards, ...). Nothing
forces the pasted static copy to be refreshed, so it silently goes stale -- the exact
stale-cache-of-a-derived-fact failure this project hates.

THE MODEL.
  * STATIC_KB_MANIFEST.json records the sha256 of every static file = the baseline
    that SHOULD be in static right now.
  * The CURRENT working static set is diffed against that manifest.
  * On drift, --stage builds a paste-ready BulkDownloader_project_files_v<ver>.zip +
    PROJECT_KNOWLEDGE_UPDATE.md (what changed + how to re-paste) and reseeds the manifest.
  * The volatile pack carries that zip + the new manifest, so the NEXT session already
    has the latest durable docs even before Matt re-pastes static. Static is a snapshot
    Matt refreshes when convenient; the pack is the live edge; the manifest is the truth.

ENFORCEMENT. The release gates call `--check`; on drift they print an
unmissable "STATIC KB UPDATE REQUIRED" banner, and the release builder
carries the update zip. bd-boot calls `--verify` on the pasted static set (integrity)
and compares it to the pack's manifest (freshness), so a stale or botched paste is
caught at bootstrap and the pack's newer copies win.

MODES.
  --seed   <root>                 (re)generate the manifest from <root> (a known-good set)
  --check  <root>                 diff <root> vs the manifest; exit 1 on ANY drift
  --stage  <root> --out <dir>     build the paste-ready update zip + flag + reseed manifest
  --verify <root>                 integrity: <root> matches the manifest EXACTLY (exit 1 if not)
  --diff   <root> <other_manifest> compare a dir's live shas to another manifest (freshness)

<root> = the static-KB working directory. In the git checkout that is
`project-knowledge/`, which carries its own STATIC_KB_MANIFEST.json.
--manifest overrides the default <root>/STATIC_KB_MANIFEST.json. The manifest
never tracks itself or the update flag.

EMPTY DENOMINATOR (v3.66.855). check/verify/diff/pin now REFUSE with exit 2 when
BOTH the scanned root and the manifest hold zero tracked files. Measured before
the fix: an empty dir plus a zero-file manifest returned `IN-SYNC` (check, 0),
`INTEGRITY OK` (verify, 0) and `CURRENT` (diff, 0) -- three green verdicts over
nothing at all, and `pin` anchored that nothing as canon. A gate that cannot see
its subject reports OK, truthfully and uselessly (CLAUDE.md s0). The guard fires
ONLY when both sides are empty: a populated root with an empty manifest, or an
emptied root with a populated manifest, are real findings and still report drift.

THE EXTERNAL PIN'S HOME (v3.66.855). STATE.json was the sandbox session-state
file; it is RETIRED, and no STATE.json is tracked in this repo. _default_state()
no longer probes /home/claude or /mnt/user-data/uploads (neither exists) and no
longer reaches into a BulkDL_next_session_v*.zip (the zip channel is retired --
CLAUDE.md s7). Only $BD_STATE is consulted, so `verify` without --state and
without $BD_STATE fails closed with CANON UNKNOWN -- which is the honest answer,
not a regression. This is unchanged behaviour on this machine: the retired
probes could never match here.

Stdlib-only; safe to run anywhere (no network, no BD imports).
"""
import argparse
import datetime
import hashlib
import json
import os
import sys
import zipfile
# `re` and `tempfile` went unused at v3.66.855 when _default_state() stopped
# reaching into the retired BulkDL_next_session_v*.zip channel. selftest imports
# tempfile locally where it needs it.

G, R, Y, B, RST = "\033[32m", "\033[31m", "\033[33m", "\033[1m", "\033[0m"
MANIFEST_NAME = "STATIC_KB_MANIFEST.json"
FLAG_NAME = "PROJECT_KNOWLEDGE_UPDATE.md"
# files that are control/output artifacts, never part of the tracked content set:
UNTRACKED = {MANIFEST_NAME, FLAG_NAME}
# directories that hold generated bytecode rather than content. `__pycache__`
# does NOT start with a dot, so the dot-prefix prune in scan() never reached it:
# measured at v3.66.943, `bd-kb-sync check project-knowledge` listed
# `__pycache__/bd-cutcpython-312.pyc` as ADDED, which means the checker could not
# report IN-SYNC on any machine that had ever run the tools -- and a `pin` taken
# there would have written bytecode into the attestation. Pruned by DIRECTORY
# rather than by `.pyc` suffix so a cache dir cannot contribute anything at all.
PRUNE_DIRS = {"__pycache__"}
SCHEMA = "static-kb-manifest/v2"


def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def scan(root):
    """sha256 + size of every content file under root (flat; recurses subdirs too).

    "content" and not "tracked": this walks the FILESYSTEM and never asks git, so
    an untracked file under root is scanned like any other. The docstring said
    "tracked" until v3.66.944 and that word is what hid the bytecode entry -- a
    reader checked the claim against git and saw agreement, because git was never
    consulted. tests/test_v3_66_944_* enumerates `git ls-files` precisely so the
    two denominators are compared rather than assumed equal.
    """
    out = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames
                       if not d.startswith(".") and d not in PRUNE_DIRS]
        for fn in filenames:
            if fn.startswith(".") or fn in UNTRACKED:
                continue
            full = os.path.join(dirpath, fn)
            rel = os.path.relpath(full, root)
            out[rel] = {"sha256": sha256_file(full), "bytes": os.path.getsize(full)}
    return out


def load_manifest(path):
    with open(path) as f:
        return json.load(f)


def _tree_version(root, _fallback="v0.0.0"):
    """`v<__version__>` of the checkout `root` sits in, else the old literal.

    @947. Walks up from the manifest root looking for bulk_downloader/__init__.py
    and reads the pin with a regex rather than importing: this tool is stdlib-only
    and safe to run anywhere, and importing the package would execute
    `_envfile.load_envfile()` at module scope -- seeding the caller's environment
    as a side effect of asking a question about a version string.

    Returns the literal fallback outside a checkout, which keeps every existing
    caller and the selftest's synthetic trees behaving exactly as before.
    """
    import re as _re
    d = os.path.abspath(root)
    for _ in range(6):
        cand = os.path.join(d, "bulk_downloader", "__init__.py")
        if os.path.isfile(cand):
            try:
                with open(cand, encoding="utf-8", errors="replace") as f:
                    m = _re.search(r'^__version__\s*=\s*"([^"]+)"', f.read(), _re.M)
                if m:
                    return "v" + m.group(1)
            except OSError:
                return _fallback
            return _fallback
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    return _fallback


def write_manifest(path, files, version_context):
    files = dict(sorted(files.items()))
    generated = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

    # @947: ATTEST OVER CONTENT, NOT BYTES. A wall-clock stamp made an unchanged
    # tree produce a different FILE on every run, so this artifact could not be
    # placed in bd-regen-order at all -- CI runs the chain and then
    # `git status --porcelain`, which would have failed every pull request.
    # CLAUDE.md section 0 records that exact defect ("two sessions nearly
    # reconciled a diff that did not exist") and calls over-sensitivity a
    # soundness bug rather than a safe default.
    #
    # The field is PRESERVED rather than removed, because bd-boot reads it from
    # two manifests to decide which is FRESHER. It now records when the CONTENT
    # last changed, which is the question that comparison is actually asking; a
    # reseed over identical content used to make a stale KB look newer than a
    # fresh one. Deleting the field would break that comparison outright and
    # freezing it would break the other direction, so both are tested.
    try:
        previous = load_manifest(path)
    except Exception:
        previous = None
    if previous and previous.get("files") == files:
        generated = previous.get("generated") or generated

    doc = {
        "schema": SCHEMA,
        "generated": generated,
        "version_context": version_context,
        "file_count": len(files),
        "files": files,
    }
    with open(path, "w") as f:
        json.dump(doc, f, indent=1)
    return doc


def diff(current, recorded):
    cur, rec = set(current), set(recorded)
    added = sorted(cur - rec)
    removed = sorted(rec - cur)
    changed = sorted(k for k in (cur & rec) if current[k]["sha256"] != recorded[k]["sha256"])
    return added, removed, changed


def empty_denominator(current, recorded):
    """s0 guard: True when there is NOTHING to compare on EITHER side.

    'root matches its manifest' is trivially true when both hold zero files, so
    the green verdict is about nothing. Returns True only when BOTH are empty --
    an over-sensitive guard that refused real data would be an equal soundness
    bug, and 'root emptied' / 'manifest empty but root populated' are genuine
    findings the drift report must keep making.
    """
    return not current and not recorded


_EMPTY_MSG = ("both the scanned root and the manifest track ZERO files -- there "
              "is nothing to compare, so 'in sync' would be a verdict about "
              "nothing. Point --manifest/<root> at the real static-KB set "
              "(project-knowledge/ in this checkout), or --seed it first.")


def _report(added, removed, changed):
    for tag, col, items in (("ADDED", G, added), ("REMOVED", R, removed), ("CHANGED", Y, changed)):
        for it in items:
            print(f"  {col}{tag:8s}{RST} {it}")
    return added or removed or changed


def cmd_seed(root, manifest_path, version_context):
    files = scan(root)
    write_manifest(manifest_path, files, version_context)
    print(f"{G}SEEDED{RST} {manifest_path} -- {len(files)} files tracked (version {version_context}).")
    return 0


def cmd_check(root, manifest_path, state_path=None):
    if not os.path.exists(manifest_path):
        print(f"{Y}NO MANIFEST{RST} at {manifest_path} -- run --seed first.")
        return 2
    rec = load_manifest(manifest_path)["files"]
    cur = scan(root)
    if empty_denominator(cur, rec):
        print(f"{R}CANNOT-EVALUATE{RST} -- {_EMPTY_MSG}")
        return 2
    added, removed, changed = diff(cur, rec)
    if _report(added, removed, changed):
        print(f"{Y}DRIFT{RST} -- static KB differs from the manifest "
              f"({len(added)} added / {len(removed)} removed / {len(changed)} changed). "
              f"Run --stage to produce the paste-ready update.")
        return 1
    # root == manifest is NECESSARY but NOT SUFFICIENT for "the paste is fresh":
    # `--stage` reseeds the manifest IN PLACE, so root-vs-manifest is self-referential
    # and goes green even when the operator's PASTED set is behind. The only anchor a
    # reseed cannot move is the external pin -- consult it. (KBSYNC-STAGE @756.)
    verdict, detail = _pin_verdict(manifest_path, state_path or _default_state())
    if verdict == "match":
        print(f"{G}IN-SYNC{RST} -- root matches the manifest AND the external pin ({detail}).")
        return 0
    if verdict == "mismatch":
        have, want = detail
        print(f"{Y}RE-PASTE OWED{RST} -- root matches its manifest, but the manifest sha "
              f"{have} != the pinned canon {want}. The manifest has moved past the pasted set.")
        print(f"  Re-paste the latest project_files zip, then: bd-kb-sync pin {root} --state <STATE.json>")
        return 1
    # 'unknown': no pin discoverable -> freshness vs the paste is UNVERIFIABLE. Do NOT
    # claim it (that reassuring falsehood is the whole bug); say so and exit 0 so bare
    # `check` stays a drift gate, hermetic and back-compatible.
    print(f"{G}LOCAL-MATCH{RST} -- root matches its manifest, but freshness vs the PASTED "
          f"set is UNVERIFIED (no external pin found).")
    print(f"  Prove freshness with: bd-kb-sync check {root} --state <STATE.json>")
    return 0


def _kit_overlay_shas(version_zip):
    """sha256 of every kit/<script> inside a version.zip's kit/ overlay.

    Returns {basename: sha256}. The kit/ overlay is the AUTHORITATIVE source
    for these scripts (it wins over the static paste at boot), so a static
    file that matches kit/ is CURRENT even if it differs from a lagging
    manifest. Empty dict if the zip has no kit/ or can't be read.
    """
    out = {}
    try:
        with zipfile.ZipFile(version_zip) as z:
            for name in z.namelist():
                # top-level kit/ entries only: 'kit/bd-foo', not 'kit/' or nested
                if name.startswith("kit/") and name.count("/") == 1 and not name.endswith("/"):
                    h = hashlib.sha256()
                    h.update(z.read(name))
                    out[os.path.basename(name)] = h.hexdigest()
    except (OSError, zipfile.BadZipFile):
        pass
    return out


# --- v3.66.738: THE EXTERNAL PIN -------------------------------------------
# STATIC_KB_MANIFEST.json ships INSIDE the bundle it certifies and never hashes
# itself, so `verify` could only ever answer "does this bundle agree with
# itself?" DEMONSTRATED: a 2-file bundle containing the literal text "TOTALLY
# BOGUS PK CONTENT", seeded with its own manifest, returned INTEGRITY OK exit 0.
# Self-consistency is not canon. The pin therefore lives OUTSIDE the PK, in
# STATE.json, and records the sha256 of the MANIFEST FILE ITSELF. A verify that
# cannot find a pin does NOT pass: unknown is a third state, and it FAILS.
STATE_PIN_KEY = "static_kb_manifest_pin"


def _default_state():
    """Where the external canon pin lives when --state is not given.

    v3.66.855 -- PORTED. This used to probe `/home/claude/STATE.json` and then
    reach into the newest `BulkDL_next_session_v*.zip` under `/home/claude` or
    `/mnt/user-data/uploads`. All three are RETIRED: the sandbox home, the
    uploads mount, and the session-zip channel that carried STATE.json (git
    replaced it -- CLAUDE.md s7; the register is now
    project-knowledge/IMPROVEMENT_BACKLOG.md). None of those paths exists on this
    machine, so every one of those probes already returned nothing -- dropping
    them changes no verdict here, it only stops the code claiming to look
    somewhere real.

    No STATE.json is tracked in this repo, so there is no in-checkout default to
    substitute and inventing one would be worse than having none. $BD_STATE is
    the single explicit rung; without it (and without --state) the answer is
    "no pin found", which `_check_external_pin` turns into CANON UNKNOWN and
    `_pin_verdict` into 'unknown'. Returning None is a refusal, never a clean
    verdict.
    """
    cand = os.environ.get("BD_STATE")
    return cand if (cand and os.path.exists(cand)) else None


def _manifest_sha(manifest_path):
    with open(manifest_path, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()


def _content_sha(manifest_path):
    """sha256 over WHAT the manifest tracks, not the bytes it happens to be.

    KBSYNC-CONTENT-PIN (807): write_manifest stamps 'generated' (wall clock)
    inside the sha'd body, so the byte-sha of two seeds of an UNCHANGED tree
    differs -- a pin over the file bytes attests WHEN, not WHAT (the rev-806
    bd-release-attestation defect, sitting in the canon gate). The attestation
    subject is the sorted files dict, canonically serialized; 'generated' and
    'version_context' stay IN the file as metadata, OUTSIDE the attestation.
    Returns None if the manifest is unreadable/malformed -- the caller must
    treat None as cannot-verify, never as match.
    """
    try:
        with open(manifest_path, "r", encoding="utf-8") as fh:
            doc = json.load(fh)
        files = doc.get("files")
        if not isinstance(files, dict):
            return None
        blob = json.dumps(files, sort_keys=True, separators=(",", ":"))
        return hashlib.sha256(blob.encode("utf-8")).hexdigest()
    except Exception:  # why: unreadable manifest -> None -> caller fails closed
        return None


def _load_state(state_path):
    try:
        with open(state_path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:  # why: STATE.json is missing or malformed. None is reported by the
        # caller as "unreadable -- cannot verify canon" and FAILS; it is never
        # silently treated as "no pin needed".
        return None


def _check_external_pin(manifest_path, state_path):
    """(ok, message). ok=False means FAIL -- including 'I could not check'."""
    if not state_path:
        return False, ("NO STATE.json found -- cannot tell whether this PK is CANON "
                       "or merely self-consistent. Unknown is a third state and it "
                       "fails. Point --state at the version pack's STATE.json.")
    state = _load_state(state_path)
    if state is None:
        return False, "STATE.json at %s is unreadable -- cannot verify canon." % state_path
    pin = (state.get(STATE_PIN_KEY) or {})
    want = pin.get("sha256")
    if not want:
        return False, ("STATE.json has no %s -- the PK is UNPINNED, so 'matches its own "
                       "manifest' is the only thing verify could ever prove. Run: "
                       "bd-kb-sync pin <root> --state <STATE.json>" % STATE_PIN_KEY)
    want_content = pin.get("content_sha256")
    if want_content:
        have = _content_sha(manifest_path)
        if have is None:
            return False, ("manifest at %s is unreadable/malformed -- cannot derive "
                           "its content sha; cannot verify canon." % manifest_path)
        if have != want_content:
            return False, ("MANIFEST IS NOT CANON: content sha %s but STATE pins %s. "
                           "This bundle may be internally consistent and still be the "
                           "WRONG bundle." % (have[:12], str(want_content)[:12]))
        return True, "manifest content matches the external pin (%s)" % have[:12]
    # LEGACY byte-pin (pre-807): compare file bytes, and SAY SO -- a silent
    # fallback is how mirrors drift. Byte-pins false-alarm on any re-derivation
    # ('generated' timestamp); re-pin to upgrade.
    have = _manifest_sha(manifest_path)
    if have != want:
        return False, ("MANIFEST IS NOT CANON (byte-pin, legacy): it is %s but STATE "
                       "pins %s. NB a byte-pin also fails on a mere re-seed of "
                       "identical content ('generated' timestamp) -- if content is "
                       "known-identical, re-pin to upgrade to a content pin."
                       % (have[:12], str(want)[:12]))
    return True, ("manifest matches the external pin (%s) [byte-pin, legacy -- "
                  "re-pin to upgrade to a content pin]" % have[:12])


def _pin_verdict(manifest_path, state_path):
    """Three-state freshness verdict for check/stage (NOT verify, which is strict).

    Returns (state, detail) where state is:
      'match'    -- an external pin exists and equals the manifest sha
      'mismatch' -- an external pin exists and DIFFERS (manifest moved past the paste)
      'unknown'  -- no state / no pin found; freshness vs the paste is unverifiable

    verify collapses 'unknown' and 'mismatch' into FAIL on purpose (unknown is a third
    state that must fail the CANON gate). check/stage keep them distinct: only a real
    'mismatch' is a re-paste; 'unknown' is a caveat, not a failure. (KBSYNC-STAGE @756.)
    """
    if not (state_path and os.path.exists(state_path)):
        return "unknown", None
    state = _load_state(state_path)
    if not isinstance(state, dict):
        return "unknown", None
    pin = state.get(STATE_PIN_KEY) or {}
    want_content = pin.get("content_sha256")
    if want_content:
        have = _content_sha(manifest_path)
        if have is None:
            return "unknown", None  # unreadable manifest: cannot verify, never match
        if have == want_content:
            return "match", have[:12]
        return "mismatch", (have[:12], str(want_content)[:12])
    want = pin.get("sha256")
    if not want:
        return "unknown", None
    have = _manifest_sha(manifest_path)
    if have == want:
        return "match", have[:12]
    return "mismatch", (have[:12], str(want)[:12])


def cmd_pin(root, manifest_path, state_path, version_context):
    """Record the manifest's OWN sha256 in STATE.json -- outside the PK."""
    if not os.path.exists(manifest_path):
        print("%sNO MANIFEST%s at %s -- seed first." % (Y, RST, manifest_path))
        return 2
    if not state_path:
        print("%sNO STATE.json%s -- pass --state <path>." % (R, RST))
        return 2
    state = _load_state(state_path)
    if state is None:
        print("%sSTATE.json unreadable%s at %s." % (R, RST, state_path))
        return 2
    sha = _manifest_sha(manifest_path)
    csha = _content_sha(manifest_path)
    if csha is None:
        print("%sFAIL%s manifest at %s is unreadable/malformed -- refusing to pin "
              "a content sha it does not have." % (R, RST, manifest_path))
        return 2
    rec = load_manifest(manifest_path)
    if not (rec.get("files") or {}):
        print("%sCANNOT-EVALUATE%s -- refusing to pin a manifest that tracks ZERO "
              "files. A canon anchor over an empty set certifies nothing, and every "
              "later verify against it would report INTEGRITY OK over nothing "
              "(CLAUDE.md s0). Seed the manifest from the real static-KB set first."
              % (R, RST))
        return 2
    oldpin = state.get(STATE_PIN_KEY) or {}
    old = oldpin.get("content_sha256") or oldpin.get("sha256")
    state[STATE_PIN_KEY] = {
        "content_sha256": csha,
        "sha256": sha,
        "files": len(rec.get("files") or {}),
        "version": version_context,
        "note": ("content_sha256 = sha256 over the manifest's sorted files dict "
                 "(canonical json) -- WHAT is tracked, stable across re-seeds; "
                 "sha256 = the manifest file's bytes (includes the 'generated' "
                 "timestamp) -- the exact artifact handed over. Both held OUTSIDE "
                 "the PK: the manifest cannot certify itself; 'is this bundle "
                 "CANON' is a different question from 'is it self-consistent'. "
                 "(KBSYNC-CONTENT-PIN @807.)"),
    }
    with open(state_path, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=1)
    print("%sPINNED%s %s content=%s bytes=%s (%d files, %s) -> %s"
          % (G, RST, STATE_PIN_KEY, csha[:12], sha[:12],
             len(rec.get("files") or {}), version_context, state_path))
    if old and old not in (csha, sha):
        print("  %swas%s %s -- the canon PK changed." % (Y, RST, old[:12]))
    print("  NOTE: the gates read STATE from the version ZIP. Repack it, or the pin "
          "lands where nothing reads it.")
    return 0


def cmd_verify(root, manifest_path, kit_overlay=None, state_path=None):
    """Strict integrity: the pasted set must EXACTLY match the manifest.

    With kit_overlay (a version.zip path), a tracked kit/ script that is
    CHANGED-vs-manifest but MATCHES the authoritative kit/ overlay is
    reclassified as an expected overlay-lag (informational, non-failing) --
    the manifest is simply behind the hot-patch channel. A kit script that
    matches NEITHER the manifest NOR kit/ is still a genuine INTEGRITY FAIL,
    so real corruption/truncation is not masked.
    """
    # THE EXTERNAL PIN, CHECKED FIRST. Everything below only ever proves the
    # bundle agrees with ITSELF; this is the only step that asks whether it is
    # the RIGHT bundle. A failure here is fatal -- including "cannot check".
    pin_ok, pin_msg = _check_external_pin(manifest_path, state_path) \
        if os.path.exists(manifest_path) else (True, "")
    if not pin_ok:
        print("%sCANON UNKNOWN%s -- %s" % (R, RST, pin_msg))
        return 1
    if pin_msg:
        print("  canon pin: %s" % pin_msg)
    if not os.path.exists(manifest_path):
        print(f"{Y}NO MANIFEST{RST} at {manifest_path}.")
        return 2
    rec = load_manifest(manifest_path)["files"]
    cur = scan(root)
    if empty_denominator(cur, rec):
        print(f"{R}CANNOT-EVALUATE{RST} -- {_EMPTY_MSG}")
        return 2
    added, removed, changed = diff(cur, rec)

    overlay_lag = []
    if kit_overlay:
        kit = _kit_overlay_shas(kit_overlay)
        if kit:
            still_changed = []
            for k in changed:
                b = os.path.basename(k)
                # CHANGED but the pasted content equals the authoritative kit/ copy
                if b in kit and cur.get(k, {}).get("sha256") == kit[b]:
                    overlay_lag.append(k)
                else:
                    still_changed.append(k)
            changed = still_changed

    if added or removed or changed:
        _report(added, removed, changed)
        print(f"{R}INTEGRITY FAIL{RST} -- {root} does not match its manifest "
              f"(stale paste, partial paste, or local edit).")
        if overlay_lag:
            print(f"{Y}note{RST}: {len(overlay_lag)} kit script(s) match the kit/ overlay "
                  f"(manifest lag, not corruption): {', '.join(os.path.basename(k) for k in overlay_lag)}")
        return 1
    if overlay_lag:
        print(f"{G}INTEGRITY OK{RST} (kit-aware) -- {root} matches its manifest, "
              f"except {len(overlay_lag)} kit script(s) that match the authoritative "
              f"kit/ overlay (expected manifest lag, not corruption):")
        for k in overlay_lag:
            print(f"  {Y}OVERLAY-LAG{RST} {os.path.basename(k)}")
        return 0
    print(f"{G}INTEGRITY OK{RST} -- {root} matches its manifest exactly.")
    return 0


def cmd_diff(root, other_manifest):
    """Freshness: compare a dir's live shas to ANOTHER manifest (e.g. the pack's)."""
    rec = load_manifest(other_manifest)["files"]
    cur = scan(root)
    if empty_denominator(cur, rec):
        print(f"{R}CANNOT-EVALUATE{RST} -- {_EMPTY_MSG}")
        return 2
    added, removed, changed = diff(cur, rec)
    stale = removed or changed  # the dir is MISSING newer files / has older content
    if added or removed or changed:
        _report(added, removed, changed)
        if stale:
            print(f"{Y}STALE{RST} -- {root} is behind {os.path.basename(other_manifest)} "
                  f"({len(changed)} older / {len(removed)} missing). The pack's copies are newer.")
            return 1
    print(f"{G}CURRENT{RST} -- {root} is not behind {os.path.basename(other_manifest)}.")
    return 0


def cmd_stage(root, manifest_path, out_dir, version_context, state_path=None,
              pin_after=False):
    os.makedirs(out_dir, exist_ok=True)
    prior = load_manifest(manifest_path)["files"] if os.path.exists(manifest_path) else {}
    current = scan(root)
    added, removed, changed = diff(current, prior)
    drifted = bool(added or removed or changed)

    # KBSYNC-STAGE-PIN (748 shape): if the external pin matches the manifest AS IT
    # STANDS NOW, the caller just pinned -- and the reseed below is about to move
    # the manifest past that fresh pin. That must never happen silently: at 748 a
    # pin-then-stage close shipped a STATE whose pin referenced an INTERMEDIATE
    # manifest, matching neither the pasted set nor the staged zip.
    _sp = state_path or _default_state()
    pre_sha = _manifest_sha(manifest_path) if os.path.exists(manifest_path) else None
    _st = _load_state(_sp) if _sp else None
    _pinned = ((_st or {}).get(STATE_PIN_KEY) or {}).get("sha256")
    pin_was_current = bool(pre_sha and _pinned and pre_sha == _pinned)

    # reseed the manifest to the NEW state (so it becomes the baseline) inside root
    write_manifest(manifest_path, current, version_context)

    # build the paste-ready zip = the full static set (now incl. the fresh manifest)
    zip_name = f"BulkDownloader_project_files_{version_context.replace('.', '_')}.zip"
    zip_path = os.path.join(out_dir, zip_name)
    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for fn in sorted(filenames):
                if fn.startswith(".") or fn == FLAG_NAME:
                    continue
                full = os.path.join(dirpath, fn)
                arc = os.path.relpath(full, root)
                # why: v3.66.805 -- a freshly-mounted /mnt/project carries pre-1980
                # mtimes (measured: 345 of 365 files at 1979-12-31), and
                # ZipInfo.from_file raises "ZIP does not support timestamps before
                # 1980", so z.write() CRASHED and left a 22-byte truncated zip. The
                # crash was total: no session that edits PK could stage an update.
                # Write a NORMALIZED timestamp instead -- 1980-01-01, matching the
                # release zip's fixed-timestamp convention. mtime is not part of the
                # manifest (it hashes CONTENT), so normalizing loses nothing and makes
                # the staged zip byte-reproducible for the same content.
                zi = zipfile.ZipInfo(arc, date_time=(1980, 1, 1, 0, 0, 0))
                zi.compress_type = zipfile.ZIP_DEFLATED
                zi.external_attr = (os.stat(full).st_mode & 0xFFFF) << 16
                with open(full, "rb") as fh:
                    z.writestr(zi, fh.read())

    # Freshness is NOT drift-vs-prior alone. A prior --stage reseed makes current==prior
    # (zero drift) while the operator's PASTED set is still behind, so the naive verdict
    # goes green falsely. The external pin is the only anchor the reseed cannot move: if
    # the (now reseeded) manifest no longer matches the pin, a re-paste is owed regardless
    # of local drift. stage does NOT advance the pin -- the pin only moves when the operator
    # re-pastes and runs `bd-kb-sync pin`, so verify/check stay RED until the paste lands.
    # (KBSYNC-STAGE @756.)
    verdict, detail = _pin_verdict(manifest_path, state_path or _default_state())
    pin_mismatch = (verdict == "mismatch")
    pin_note = (f"manifest sha {detail[0]} != pinned canon {detail[1]}"
                if pin_mismatch else "")
    repaste_owed = drifted or pin_mismatch

    # write the update flag (the re-paste instruction) into out_dir
    flag_path = os.path.join(out_dir, FLAG_NAME)
    with open(flag_path, "w") as f:
        f.write(_flag_text(version_context, zip_name, added, removed, changed, drifted,
                           repaste_owed=repaste_owed, pin_note=pin_note))

    tag = f"{Y}RE-PASTE OWED{RST}" if repaste_owed else f"{G}IN-SYNC{RST}"
    print(f"{tag}: {zip_path} ({len(current)} files) + {flag_path}; manifest reseeded.")
    if drifted:
        _report(added, removed, changed)
    if pin_was_current and drifted and not pin_after:
        print(f"  {Y}PIN-BEHIND{RST}: the external pin matched the manifest as it was "
              "CURRENT before this stage -- reseeding has now moved the manifest past "
              "your fresh pin. STATE ships a pin matching neither the pasted set nor "
              "this staged zip until you re-paste and re-pin (the 748 incident).")
    if repaste_owed:
        if pin_mismatch and not drifted:
            print(f"  {Y}pin{RST}: {pin_note} -- manifest moved past the pinned paste (zero local drift).")
        print(f"{B}STATIC KB UPDATE REQUIRED{RST} -- re-paste static from {zip_name} when convenient.")
        if not pin_after:
            print("  then re-pin canon: bd-kb-sync pin %s --state %s --version %s"
                  % (root, _sp or "<STATE.json>", version_context))
    if pin_after:
        # EXPLICIT operator assertion: "I will paste THIS staged zip". Advance the
        # pin to the reseeded manifest sha atomically with the stage, via the same
        # cmd_pin path (single writer). Without --state and with no default STATE
        # discoverable this FAILS -- a pin written nowhere readable is the
        # written-to-one-channel bug this flag exists to close.
        if not _sp:
            print(f"  {R}FAIL{RST} --pin needs a STATE.json (--state) and none was "
                  "found -- staged, but NOT pinned.")
            return 1
        rc = cmd_pin(root, manifest_path, _sp, version_context)
        if rc != 0:
            print(f"  {R}FAIL{RST} --pin: cmd_pin rc={rc} -- staged, but NOT pinned.")
            return rc
        print("  --pin: pin now asserts THIS staged zip is (about to be) the pasted "
              "canon -- paste it, or verify goes RED honestly.")
    return 0


def _flag_text(ver, zip_name, added, removed, changed, drifted,
               repaste_owed=None, pin_note=""):
    # repaste_owed defaults to drifted, but the caller may force it True when the
    # (reseeded) manifest has moved past the external pin even though local drift is
    # zero -- the exact case the old "not drifted -> in sync" text reported falsely.
    if repaste_owed is None:
        repaste_owed = drifted
    L = [f"# PROJECT KNOWLEDGE UPDATE -- {ver}", ""]
    if not repaste_owed:
        L += ["Static KB is in sync with the manifest AND the external pin. "
              "No re-paste needed.", ""]
        return "\n".join(L)
    L += [f"**Static project knowledge is behind the canon. Re-paste it.**", ""]
    if pin_note:
        L += [f"> pin check: {pin_note}", ""]
    L += [f"1. In the Claude project, delete all project files.",
          f"2. Paste the contents of `{zip_name}` (the full updated static set, manifest included).",
          f"3. Then re-pin canon: `bd-kb-sync pin <root> --state STATE.json`.", ""]
    if drifted:
        L += ["## What changed", ""]
        for tag, items in (("Added", added), ("Removed", removed), ("Changed", changed)):
            for it in items:
                L.append(f"- {tag}: `{it}`")
        L += ["", "Until you re-paste, the pack carries these newer copies, so no session loses them."]
    else:
        L += ["(No local drift vs the manifest -- but the manifest has moved past the",
              " pinned paste, so a re-paste is still owed. This is precisely the case a",
              " naive root-vs-manifest check reports 'in sync' falsely.)"]
    return "\n".join(L) + "\n"


def selftest():
    """Stage/pin coordination controls on a SYNTHETIC root -- the old SKIP claimed
    the whole tool 'needs the static-PK bundle', which is false for these paths:
    a test that could exist but claims it cannot is the gate that cannot see.
    verify/kit-overlay paths genuinely do need the real bundle and stay untested
    here (honest absence)."""
    import subprocess as _sp, tempfile as _tf
    ok = True

    def _run(*args):
        return _sp.run([sys.executable, os.path.realpath(__file__), *args],
                       capture_output=True, text=True, timeout=120)

    with _tf.TemporaryDirectory() as td:
        root = os.path.join(td, "kb"); os.makedirs(root)
        open(os.path.join(root, "DOC_A.md"), "w").write("alpha\n")
        state = os.path.join(td, "STATE.json")
        json.dump({"live_version": "x"}, open(state, "w"))
        out = os.path.join(td, "out")
        _run("seed", root, "--version", "v1")
        _run("pin", root, "--state", state, "--version", "v1")
        pin0 = json.load(open(state))[STATE_PIN_KEY]["sha256"]

        # POS (748 shape): pin current -> stage must WARN + leave the pin alone
        # + name the owed re-pin command.
        open(os.path.join(root, "DOC_A.md"), "w").write("alpha v2\n")
        r = _run("stage", root, "--out", out, "--version", "v2", "--state", state)
        pin1 = json.load(open(state))[STATE_PIN_KEY]["sha256"]
        c1 = (pin0 == pin1 and "PIN-BEHIND" in r.stdout
              and "bd-kb-sync pin" in r.stdout)
        print(("PASS" if c1 else "FAIL") +
              "  STAGE-PIN-BEHIND: fresh pin -> warned, pin untouched, re-pin "
              "command named")
        ok = ok and c1

        # POS: --pin advances the pin to the RESEEDED manifest sha, atomically.
        open(os.path.join(root, "DOC_A.md"), "w").write("alpha v3\n")
        r = _run("stage", root, "--out", out, "--version", "v3",
                 "--state", state, "--pin")
        pin2 = json.load(open(state))[STATE_PIN_KEY]["sha256"]
        want = _manifest_sha(os.path.join(root, MANIFEST_NAME))
        c2 = r.returncode == 0 and pin2 == want and "PIN-BEHIND" not in r.stdout
        print(("PASS" if c2 else "FAIL") +
              "  STAGE-PIN-ATOMIC: --pin pins the reseeded manifest (no stale "
              "warning when the pin moves WITH the stage)")
        ok = ok and c2

        # NEG: pin already BEHIND (not current) -> the PIN-BEHIND warning must
        # NOT fire (a warning that fires on everything is noise, not a warning).
        st = json.load(open(state)); st[STATE_PIN_KEY]["sha256"] = "0" * 64
        json.dump(st, open(state, "w"))
        open(os.path.join(root, "DOC_A.md"), "w").write("alpha v4\n")
        r = _run("stage", root, "--out", out, "--version", "v4", "--state", state)
        c3 = "PIN-BEHIND" not in r.stdout and "RE-PASTE OWED" in r.stdout
        print(("PASS" if c3 else "FAIL") +
              "  STAGE-PIN-NEG: stale pin -> no false PIN-BEHIND; re-paste still owed")
        ok = ok and c3

        # NEG: --pin with no readable STATE must FAIL LOUD, not stage-and-shrug.
        r = _run("stage", root, "--out", out, "--version", "v5",
                 "--state", os.path.join(td, "nope.json"), "--pin")
        c4 = r.returncode != 0
        print(("PASS" if c4 else "FAIL") +
              "  STAGE-PIN-NOSTATE: --pin without a readable STATE fails (rc=%d)"
              % r.returncode)
        ok = ok and c4

    # KBSYNC-CONTENT-PIN (807 shape, measured live): write_manifest embeds a
    # wall-clock 'generated' inside the sha'd body, so two seeds of an UNCHANGED
    # tree produce two different manifest byte-shas -- the pin attests WHEN, not
    # WHAT (the rev-806 bd-release-attestation defect, in the canon gate).
    # POS: seed -> pin -> reseed (>=1s later, no content change) -> the pin
    # verdict for the reseeded manifest must still be 'match'.
    with _tf.TemporaryDirectory() as td:
        import time as _time
        root = os.path.join(td, "kb"); os.makedirs(root)
        open(os.path.join(root, "DOC_A.md"), "w").write("alpha\n")
        state = os.path.join(td, "STATE.json")
        json.dump({"live_version": "x"}, open(state, "w"))
        _run("seed", root, "--version", "v1")
        _run("pin", root, "--state", state, "--version", "v1")
        _time.sleep(1.1)  # force a different 'generated' (timespec=seconds)
        _run("seed", root, "--version", "v1")  # identical content, later clock
        verdict, _detail = _pin_verdict(os.path.join(root, MANIFEST_NAME), state)
        c5 = (verdict == "match")
        print(("PASS" if c5 else "FAIL") +
              "  CONTENT-PIN-DETERMINISM: reseed of unchanged content still "
              "matches the pin (verdict=%s)" % verdict)
        ok = ok and c5

        # NEG: real content drift must STILL mismatch under the content pin --
        # a pin that matches everything is a gate that cannot fire.
        open(os.path.join(root, "DOC_A.md"), "w").write("alpha CHANGED\n")
        _run("seed", root, "--version", "v1")
        verdict2, _d2 = _pin_verdict(os.path.join(root, MANIFEST_NAME), state)
        c6 = (verdict2 == "mismatch")
        print(("PASS" if c6 else "FAIL") +
              "  CONTENT-PIN-BITES: changed content mismatches (verdict=%s)"
              % verdict2)
        ok = ok and c6

    # EMPTY-DENOMINATOR (855). BOTH directions, because the fix for "reports OK
    # while blind" that simply refuses everything is an equal soundness bug.
    c7 = empty_denominator({}, {}) is True
    print(("PASS" if c7 else "FAIL") +
          "  EMPTY-DENOM-UNIT: nothing on either side -> refuse")
    ok = ok and c7
    c8 = (empty_denominator({"a": 1}, {}) is False
          and empty_denominator({}, {"a": 1}) is False
          and empty_denominator({"a": 1}, {"a": 1}) is False)
    print(("PASS" if c8 else "FAIL") +
          "  EMPTY-DENOM-NOT-OVERSENSITIVE: either side populated -> still a "
          "real verdict (emptied root / empty manifest are FINDINGS, not refusals)")
    ok = ok and c8

    with _tf.TemporaryDirectory() as td:
        # NEG end-to-end: empty root + zero-file manifest. Measured before the
        # fix: check=0 IN-SYNC, verify=0 INTEGRITY OK, diff=0 CURRENT -- three
        # green verdicts over nothing. All three must now be 2.
        root = os.path.join(td, "kb"); os.makedirs(root)
        mpath = os.path.join(root, MANIFEST_NAME)
        write_manifest(mpath, {}, "vE")
        state = os.path.join(td, "STATE.json")
        json.dump({"live_version": "x"}, open(state, "w"))
        rcs = {m: _run(m, root, *extra).returncode
               for m, extra in (("check", ("--state", state)),
                                ("verify", ("--state", state)),
                                ("pin", ("--state", state, "--version", "vE")))}
        rcs["diff"] = _run("diff", root, mpath).returncode
        # verify is 1, not 2, and that is CORRECT: it consults the external pin
        # FIRST and this STATE carries none, so CANON UNKNOWN (1) preempts the
        # empty-denominator refusal. Both are refusals; neither is green, which
        # is the property under test. Asserting 2 here would have been asserting
        # the wrong thing about the right behaviour.
        c9 = (rcs["check"] == 2 and rcs["diff"] == 2 and rcs["pin"] == 2
              and rcs["verify"] == 1)
        print(("PASS" if c9 else "FAIL") +
              "  EMPTY-DENOM-E2E: empty root+manifest -> check/diff/pin exit 2, "
              "verify exits 1 (CANON UNKNOWN preempts); none is 0 (got %s)" % rcs)
        ok = ok and c9

        # ...and the verify guard itself IS reachable: give it a LEGACY byte-pin
        # that matches, so the pin check passes and the empty guard is the thing
        # that decides. Without this control the guard could be dead code in
        # verify and the row above would never notice.
        json.dump({STATE_PIN_KEY: {"sha256": _manifest_sha(mpath)}},
                  open(state, "w"))
        rv = _run("verify", root, "--state", state)
        c9b = rv.returncode == 2 and "CANNOT-EVALUATE" in rv.stdout
        print(("PASS" if c9b else "FAIL") +
              "  EMPTY-DENOM-VERIFY: pin satisfied, empty set -> verify exits 2 "
              "instead of INTEGRITY OK (rc=%d)" % rv.returncode)
        ok = ok and c9b

        # POS end-to-end: one real file -> the drift verdict must come back, not
        # a refusal. Without this the guard could pass by refusing everything.
        open(os.path.join(root, "DOC_A.md"), "w").write("alpha\n")
        r10 = _run("check", root, "--state", state)
        c10 = r10.returncode == 1 and "ADDED" in r10.stdout
        print(("PASS" if c10 else "FAIL") +
              "  EMPTY-DENOM-POS: one real file -> genuine DRIFT verdict (rc=%d), "
              "not a refusal" % r10.returncode)
        ok = ok and c10

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser(description="static-KB sync via sha manifest")
    ap.add_argument("mode", choices=["seed", "check", "verify", "stage", "diff", "pin"])
    ap.add_argument("root", help="static-KB working directory")
    ap.add_argument("other", nargs="?", help="for --diff: the other manifest to compare against")
    ap.add_argument("--manifest", help="override manifest path (default <root>/STATIC_KB_MANIFEST.json)")
    ap.add_argument("--out", help="for --stage: output dir for the update zip + flag")
    ap.add_argument("--kit-overlay", help="for verify: a version.zip whose kit/ overlay is "
                    "authoritative for kit scripts; a CHANGED kit script that matches kit/ is "
                    "treated as expected manifest-lag, not an integrity failure")
    # @947: default DERIVED from the tree rather than a literal, so the
    # bd-regen-order chain entry needs no version threaded through it and
    # cannot go stale against the bump. Explicit --version still wins.
    ap.add_argument("--version", default=None, help="version context to stamp")
    ap.add_argument("--state", help="STATE.json holding the external manifest pin")
    ap.add_argument("--pin", action="store_true",
                    help="for --stage: ALSO advance the external pin to the reseeded "
                         "manifest (asserts you will paste THIS staged zip)")
    a = ap.parse_args()

    root = os.path.abspath(a.root)
    if not os.path.isdir(root):
        print(f"{R}NO SUCH DIR{RST} {root}"); return 2
    manifest_path = a.manifest or os.path.join(root, MANIFEST_NAME)
    if a.version is None:
        a.version = _tree_version(root)

    if a.mode == "seed":
        return cmd_seed(root, manifest_path, a.version)
    if a.mode == "check":
        state_path = os.path.abspath(a.state) if a.state else None
        return cmd_check(root, manifest_path, state_path)
    if a.mode == "pin":
        state_path = os.path.abspath(a.state) if a.state else _default_state()
        return cmd_pin(root, manifest_path, state_path, a.version)
    if a.mode == "verify":
        kit_overlay = os.path.abspath(a.kit_overlay) if a.kit_overlay else None
        state_path = os.path.abspath(a.state) if a.state else _default_state()
        return cmd_verify(root, manifest_path, kit_overlay, state_path)
    if a.mode == "diff":
        if not a.other:
            print(f"{R}--diff needs the other manifest path{RST}"); return 2
        return cmd_diff(root, os.path.abspath(a.other))
    if a.mode == "stage":
        if not a.out:
            print(f"{R}--stage needs --out{RST}"); return 2
        state_path = os.path.abspath(a.state) if a.state else None
        return cmd_stage(root, manifest_path, os.path.abspath(a.out), a.version, state_path,
                         pin_after=a.pin)


if __name__ == "__main__":
    sys.exit(main())
