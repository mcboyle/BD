#!/usr/bin/env python3
"""Stamp the reviewed release at landing; reuse bd-bump and the full regen chain.

A private Git receipt recognizes only the exact pending stamp. Failed writes keep
an applying receipt and their evidence for the integrator; they are never retried
as a new release automatically. No commit, fetch, reset or cleanup is implicit.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

PATHS = (
    "bulk_downloader/__init__.py",
    "tests/test_settings_center_slice4.py",
    "CHANGELOG.md",
    "PIN_INDEX.json",
    "project-knowledge/STATIC_KB_MANIFEST.json",
)
VERSION = re.compile(r'^__version__ = "(3\.66\.(\d+))"$', re.M)
HEADER = re.compile(r'^#{1,3} v?3\.66\.\d+[^\n]*$', re.M)


class Refused(Exception):
    def __init__(self, reason, detail=""):
        super().__init__(reason)
        self.reason, self.detail = reason, detail


def digest(data):
    return hashlib.sha256(data).hexdigest()


def run(work, argv, *, allowed=(0,)):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", PYTHONDONTWRITEBYTECODE="1")
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "BD_INSTALL_DIR"):
        env.pop(key, None)
    cp = subprocess.run(argv, cwd=work, env=env, capture_output=True)
    if cp.returncode not in allowed:
        raise Refused("COMMAND-FAILED", " ".join(map(str, argv)) + "\n" +
                      cp.stdout.decode(errors="replace") + cp.stderr.decode(errors="replace"))
    return cp


def git(work, *args):
    return run(work, ["git", *args]).stdout


def version(data):
    match = VERSION.search(data)
    if not match:
        raise Refused("INVALID-VERSION")
    return match.group(1), int(match.group(2))


def state(work):
    return {
        "status": git(work, "status", "--porcelain=v1", "-z", "--untracked-files=all").decode(),
        "index": digest(git(work, "ls-files", "--stage", "-z")),
        "files": {name: digest((work / name).read_bytes()) if (work / name).is_file() else None
                  for name in PATHS},
    }


def receipt_path(work):
    path = Path(git(work, "rev-parse", "--git-path", "bd-land-trio.json").decode().strip())
    return path if path.is_absolute() else work / path


def inspect(work, args, body):
    head = git(work, "rev-parse", "HEAD").decode().strip()
    main = git(work, "rev-parse", "origin/main^{commit}").decode().strip()
    base_cp = run(work, ["git", "rev-parse", "--verify", args.base + "^{commit}"], allowed=(0, 128))
    if base_cp.returncode:
        raise Refused("BASE-NOT-ANCESTOR", args.base)
    base = base_cp.stdout.decode().strip()
    context = dict(head=head, main=main, base=base, title=args.title, body=body)
    current = state(work)
    path = receipt_path(work)
    if path.exists():
        try:
            receipt = json.loads(path.read_text())
        except (ValueError, OSError) as exc:
            raise Refused("INVALID-RECEIPT", str(exc)) from exc
        if not isinstance(receipt, dict):
            raise Refused("INVALID-RECEIPT", "receipt must be an object")
        if receipt.get("status") != "complete":
            raise Refused("INCOMPLETE-STAMP", str(path))
        if not isinstance(receipt.get("context"), dict) or not isinstance(receipt.get("snapshot"), dict):
            raise Refused("INVALID-RECEIPT", "complete receipt lacks context or snapshot")
        # A clean later commit is a new landing; a pending stamp is bound to its
        # original HEAD/main and cannot survive a concurrent landing unnoticed.
        if current["status"]:
            if receipt.get("context", {}).get("main") != main or receipt.get("context", {}).get("head") != head:
                raise Refused("STALE-STAMP", "HEAD or origin/main moved")
            if receipt.get("context") == context and receipt.get("snapshot") == current:
                return receipt, True
    dirty = current["status"]
    if dirty:
        raise Refused("DIRTY-TREE")
    ancestor = run(work, ["git", "merge-base", "--is-ancestor", base, head], allowed=(0, 1))
    if ancestor.returncode:
        raise Refused("BASE-NOT-ANCESTOR", args.base)
    old, tree_patch = version((work / PATHS[0]).read_text())
    _, main_patch = version(git(work, "show", main + ":" + PATHS[0]).decode())
    if tree_patch > main_patch + 1:
        raise Refused("TRIO-AHEAD")
    changelog = (work / "CHANGELOG.md").read_text()
    headers = list(HEADER.finditer(changelog))
    if not headers:
        raise Refused("INVALID-CHANGELOG", "missing release header")
    top = changelog[headers[0].start():headers[1].start() if len(headers) > 1 else len(changelog)]
    if not (top + args.title + body).isascii():
        raise Refused("NON-ASCII-CHANGELOG")
    if not args.title.strip() or "\n" in args.title or "\r" in args.title or HEADER.search(body):
        raise Refused("INVALID-CHANGELOG", "title must be one line; body cannot introduce a release")
    pins = json.loads((work / "PIN_INDEX.json").read_text())["pins"]
    pin_files = {pin["file"] for pin in pins if pin["form"] == "version"}
    if pin_files != {PATHS[1]}:
        raise Refused("UNEXPECTED-PIN-PATHS", repr(sorted(pin_files)))
    return dict(status="applying", context=context, old=old,
                new="3.66." + str(max(tree_patch, main_patch) + 1)), False


def save_receipt(path, receipt):
    temporary = path.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(receipt, sort_keys=True, indent=2) + "\n")
    temporary.replace(path)


def show(receipt, stamped):
    versions = receipt["old"] + "->" + receipt["new"]
    if stamped:
        print(f'TRIO-STAMPED {versions} files={len(PATHS)} tree={receipt["tree"]}')
        print(f"trio: {versions} (bd-land-trio)")
    else:
        print(f"TRIO-PLAN {versions} files={len(PATHS)}")


def apply(work, args, body, receipt):
    path = receipt_path(work)
    save_receipt(path, receipt)
    run(work, [sys.executable, str(work / "toolchain/bin/bd-bump"), receipt["new"],
               "--work", str(work), "--title", args.title, "--write"])
    changelog = work / "CHANGELOG.md"
    text = changelog.read_text()
    inserted = f'## v{receipt["new"]} - {args.title}\n\n(TODO changelog body)\n\n'
    if text.count(inserted) != 1:
        raise Refused("BUMP-OUTPUT-MISMATCH")
    replacement = f'## v{receipt["new"]} - {args.title}\n\n{body.rstrip()}\n\n'
    changelog.write_text(text.replace(inserted, replacement, 1))
    run(work, [sys.executable, str(work / "toolchain/bin/bd-regen-order"), "--work", str(work)])
    changed = set(git(work, "diff", "--name-only", "-z", "HEAD").decode().rstrip("\0").split("\0"))
    untracked = git(work, "ls-files", "--others", "--exclude-standard", "-z")
    if changed != set(PATHS) or untracked:
        raise Refused("UNEXPECTED-STAMP-PATHS", repr(sorted(changed)) + " untracked=" + repr(untracked))
    # A generator does not have authority to move the reviewed refs.
    if git(work, "rev-parse", "HEAD").decode().strip() != receipt["context"]["head"] or git(work, "rev-parse", "origin/main").decode().strip() != receipt["context"]["main"]:
        raise Refused("STALE-STAMP", "HEAD or origin/main moved during generation")
    git(work, "add", "--", *PATHS)
    receipt.update(status="complete", tree=git(work, "write-tree").decode().strip(), snapshot=state(work))
    save_receipt(path, receipt)
    return receipt


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--work", type=Path, required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument("--body", type=Path)
    parser.add_argument("--base", default="origin/main")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--write", action="store_true")
    args = parser.parse_args()
    try:
        work = args.work.resolve(strict=True)
        body = args.body.read_text() if args.body else args.title + "\n"
        receipt, replay = inspect(work, args, body)
        if args.write and not replay:
            # Serialize this tool's writers; recheck after acquiring the lock.
            with receipt_path(work).with_suffix(".lock").open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                receipt, replay = inspect(work, args, body)
                if not replay:
                    receipt = apply(work, args, body, receipt)
        show(receipt, args.write)
        return 0
    except Refused as exc:
        print("TRIO-REFUSED " + exc.reason, file=sys.stderr)
        if exc.detail:
            print(exc.detail, file=sys.stderr)
        return 3
    except (OSError, ValueError, KeyError) as exc:
        print("TRIO-REFUSED INVALID-INPUT", file=sys.stderr)
        print(str(exc), file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
