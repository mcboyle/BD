#!/usr/bin/env python3
"""bd-jobs -- make work started on another host discoverable and killable.

THE INCIDENT, v3.66.1035. A rotation sampler was launched over ssh from .164
against .85. Its local task was killed; the SSH-launched pytest was not. It ran
for EIGHTY-EIGHT MINUTES, spawning fresh rounds, and its .pyc writes then broke
a deploy at step 9 -- which had already stopped the unit, so test4 sat with its
service down. Nothing recorded that the work existed, so nothing could find it:
the only reason it was found at all is that a deploy failed twice and someone
went looking.

Three failures, one cause -- work with no record:

  1. A killed task does not reap what it started on another host.
  2. `ps | grep pytest` cannot tell MY orphan from YOUR deliberate run, so a
     reaper built on it either over-kills or asks every time.
  3. Nothing knows a job exists until it hurts something.

So the registry is the point and the reaper is a consequence. A job records
itself ON THE HOST WHERE IT RUNS, because that is the host that can see it and
the host someone will be standing on when they look.

WHY ONE TOOL AND NOT THREE. Three verbs sharing one registry format do not
need three files -- three files sharing a format drift. (The first draft of this
paragraph justified it by the `_TOOL_BUDGET` ratchet being full at 238; that
budget was retired and item 33 closed in this same cut, so the reason it gave
was stale before it shipped. The design reason stands on its own.)

PID REUSE IS GUARDED, and this matters more than it sounds for something that
kills processes on three hosts with passwordless root available. A PID alone is
not an identity: the kernel recycles them, and a stale registry entry pointing
at a recycled PID would have this tool kill an innocent process with full
confidence. Every entry records the process START TIME from /proc/<pid>/stat
field 22 -- monotonic since boot, and unique per (pid, boot) -- and reap
REFUSES any entry whose start time no longer matches.
"""
import argparse
import collections
import errno
import fcntl
import json
import os
import pathlib
import re
import select
import shlex
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time

# ONE HOST-WIDE REGISTRY, AND IT IS A CONSTANT. An environment-selected
# registry was tried at v3.66.1207 and REJECTED by design audit: `bd-fleet`
# counts `/tmp/bd-jobs/*.json` and `bd-gc` protects that exact literal, a
# delegated target imports its own module and would not receive the caller's
# selection, and `bd-jobs list` on the host would then report a different
# registry from the one a job registered in -- work that is live and
# operationally invisible, which is this tool's whole subject. Tests isolate by
# running a private COPY of this file with its own baked-in path, so isolation
# follows the executable rather than an ambient value operators can inherit,
# lose, or set differently.
JOBS_DIR = pathlib.Path("/tmp/bd-jobs")


# ── process identity ─────────────────────────────────────────────────────────

def proc_starttime(pid):
    """Field 22 of /proc/<pid>/stat, or None if the process is gone.

    Parsed from the LAST ')' rather than by splitting on spaces: field 2 is the
    executable name in parentheses and may itself contain spaces or brackets, so
    a naive split shifts every later field. That would silently compare the
    wrong number and make the reuse guard useless while looking correct.
    """
    try:
        raw = pathlib.Path("/proc", str(pid), "stat").read_text()
    except (OSError, ValueError):
        return None
    try:
        after = raw[raw.rindex(")") + 1:].split()
        return int(after[19])          # field 22 == index 19 after comm
    except (ValueError, IndexError):
        return None


def proc_cmdline(pid):
    try:
        raw = pathlib.Path("/proc", str(pid), "cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace").strip()


def alive(entry):
    """True only if the SAME process is still there -- not merely the same pid."""
    st = proc_starttime(entry["pid"])
    return st is not None and st == entry.get("starttime")


# ── the registry ─────────────────────────────────────────────────────────────

STALLED_AFTER_S = 300


def progress(entry, stalled_after=STALLED_AFTER_S):
    """Is this job DOING anything? A DIFFERENT QUESTION FROM alive() (backlog 3).

    alive() compares /proc start times, so it answers "is the process still
    there". That is the right predicate for the orphan problem this tool was
    built for and the wrong one for a long run.

    MEASURED on test6 2026-08-13 at f154aef, full suite at -n 48: a pytest
    master sat at `[ 99%%]` for 462 seconds after `[gw37] node down: Not
    properly terminated`, holding one defunct child it never reaped, with a
    1-minute load average of 0.06. alive() said LIVE for every second of it,
    truthfully and uselessly. Two of three samples at that worker count ended
    the same way.

    Returns (state, seconds_since_last_write).

      PROGRESSING  the log was written within `stalled_after`
      STALLED      it was not -- a REPORT, never a verdict (see below)
      UNKNOWN      no log recorded, or the recorded path no longer resolves

    UNKNOWN IS NOT A SOFT PROGRESSING. An entry written before this feature, or
    a job whose log was removed, cannot be judged; saying so is section 0's
    whole subject, and collapsing it into PROGRESSING would make a deleted log
    read as a healthy job.

    THE MTIME, NOT A PERCENTAGE. Section 10 bans estimated progress and asks for
    the countable instead -- "the last stage the log actually recorded, and the
    wall-clock since the last line was written". A percentage is a prediction. A
    file's mtime is a fact, and it needs no cooperation from the job.

    STALLED MUST NOT GATE ANYTHING. A job that legitimately computes in silence
    reads as STALLED, so `list` reports it and still exits 0. An over-sensitive
    gate gets switched off, which section 0 calls a soundness bug rather than a
    safe default. `stalled_after` is a parameter for the same reason.
    """
    log = entry.get("log")
    if not log:
        return ("UNKNOWN", None)
    try:
        age = time.time() - os.path.getmtime(log)
    except (OSError, ValueError, UnicodeError):
        return ("UNKNOWN", None)
    age = max(age, 0.0)                      # clock skew is not progress
    return (("STALLED" if age > stalled_after else "PROGRESSING"), age)


def open_job_log(purpose, *, _txn=None):
    """Create the log a launched job writes to; return (path, fd).

    CREATING A PATH IS A PROMISE TO REMOVE IT (section 0): forget() deletes the
    log with its entry, which is why `list` prints the path -- copy it out
    before reaping anything you want to keep.
    """
    safe = re.sub(r"[^A-Za-z0-9._-]", "-", purpose or "job")[:32]
    txn, owned = _writer_txn(_txn)
    component = None
    fd = None
    result = None
    primary = None
    synthetic_detached = False
    try:
        component, fd = txn.create_exclusive("%s-" % safe, ".log")
        receipt = txn.root_receipt("after log creation")
        if receipt.state != _OBS_PRESENT:
            synthetic_detached = True
            raise RegistryRootDetached(
                receipt, txn.root_identity, "after log creation",
                components=[component], effect_happened=True)
        result = (str(txn.display_path(component)), fd)
    except BaseException as exc:
        primary = exc

    # The child fd has not been handed to the caller until this function
    # actually returns.  Settle it on every non-return path, including a
    # receipt cancellation and an owned-transaction close failure.  A
    # cancellation raised by close is the first real failure when the only
    # earlier fact is a synthesized detached-root refusal, so preserve that
    # exact object and attach the refusal as retained evidence.
    if fd is not None and primary is not None:
        if synthetic_detached:
            detached = primary
            close_failure = _settle_assigned_child_fd(
                fd, context="created log", component=component)
            if close_failure is None:
                primary = detached
            elif isinstance(close_failure, Exception):
                _note_secondary_failure(
                    detached, "created log descriptor close is UNKNOWN",
                    close_failure)
                primary = detached
            else:
                _note_secondary_failure(
                    close_failure,
                    "created log root receipt is detached/UNKNOWN", detached)
                primary = close_failure
        else:
            primary = _settle_assigned_child_fd(
                fd, primary=primary, context="created log",
                component=component)

    primary, _events = _settle_registry_owner(
        txn, unlock=False, close=owned, primary=primary,
        context="log creation")

    if result is not None and primary is not None:
        # Closing an owned transaction can still prevent the pending return.
        # The caller therefore never received this descriptor and cannot own
        # its cleanup.
        primary = _settle_assigned_child_fd(
            fd, primary=primary, context="created log", component=component)
        result = None
    if primary is not None:
        raise primary
    return result


# THE STAGED ENTRY MUST NOT BE NAMED `*.json`, and this is not cosmetic:
# `pathlib.Path.glob("*.json")` matches DOTFILES -- measured in this
# environment, `.hidden-tmp.json` and `real.json` both come back -- and
# `load_all()` globs exactly that pattern. A temp called `.<id>.json` would
# therefore be READ AS A REGISTRY ENTRY while it is still half-written, which
# is the precise defect the staging is here to prevent. The suffix is the
# guard, so it is named once and used once.
_ENTRY_TEMP_PREFIX = ".bd-jobs-entry-"
_ENTRY_TEMP_SUFFIX = ".tmp"
_REGISTRY_LOCK_TIMEOUT_S = 10.0
_REGISTRY_LOCK_POLL_S = 0.05


class RegistrationError(RuntimeError):
    """No record was published, and the caller must act as if none exists.

    Raised rather than returned because there is exactly one safe response and
    no caller may skip it: a job whose record could not be published must not
    be allowed to run. A status code can be ignored by accident; this cannot.
    """

    def __init__(self, message, cleanup_complete=True, retained_paths=None):
        self.cleanup_complete = bool(cleanup_complete)
        self.retained_paths = list(retained_paths or [])
        super().__init__(message)


class RegistryLockTimeout(RegistrationError):
    """The registry exists, but another publisher retained its lock."""


_OBS_ABSENT = "ABSENT"
_OBS_PRESENT = "PRESENT"
_OBS_UNKNOWN = "UNKNOWN"

_NameReceipt = collections.namedtuple(
    "_NameReceipt", "state component identity operation error")
_EntryReceipt = collections.namedtuple(
    "_EntryReceipt",
    "state component identity raw_bytes entry operation error")
_RootReceipt = collections.namedtuple(
    "_RootReceipt", "state identity operation error")


class _LoadedEntry(dict):
    """Public-compatible mapping carrying non-serialized registry evidence."""


class RegistryRootDetached(RegistrationError):
    """The pinned registry inode is no longer the configured root leaf."""

    def __init__(self, receipt, root_identity, operation, components=(),
                 effect_happened=False):
        self.receipt = receipt
        self.root_identity = root_identity
        self.operation = operation
        self.components = tuple(components)
        retained = [str(JOBS_DIR / name) for name in self.components]
        component_text = (
            "; known pinned-root components: %s"
            % ", ".join(self.components)) if self.components else ""
        super().__init__(
            "ROOT_DETACHED/UNKNOWN during %s: configured registry root %s no "
            "longer proves attachment to pinned identity %r (%s); pinned-root "
            "components are RETAINED and no authority is granted%s"
            % (operation, JOBS_DIR, root_identity,
               receipt.error or receipt.operation, component_text),
            cleanup_complete=not effect_happened,
            retained_paths=retained)


def _validate_registry_stat(observed, *, display_path=None,
                            require_write=True):
    display_path = pathlib.Path(display_path or JOBS_DIR)
    if not stat.S_ISDIR(observed.st_mode):
        raise RegistrationError(
            "refusing registry %s: existing path is not a real directory"
            % display_path)
    if observed.st_uid != os.geteuid():
        raise RegistrationError(
            "refusing registry %s: owned by uid %d, expected effective uid %d"
            % (display_path, observed.st_uid, os.geteuid()))
    if observed.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise RegistrationError(
            "refusing registry %s: directory is group- or other-writable"
            % display_path)
    required = stat.S_IRUSR | stat.S_IXUSR
    if require_write:
        required |= stat.S_IWUSR
    if observed.st_mode & required != required:
        need = "owner read/write/search" if require_write else "owner read/search"
        raise RegistrationError(
            "refusing registry %s: directory lacks %s permissions"
            % (display_path, need))


def _registry_capability_reason():
    """Return why this runtime cannot implement the Linux registry contract."""
    for name in ("O_DIRECTORY", "O_NOFOLLOW", "O_CLOEXEC"):
        if not hasattr(os, name):
            return "host lacks os.%s" % name
    dir_fd_names = {function.__name__ for function in os.supports_dir_fd}
    for name in ("open", "stat", "mkdir", "rename", "unlink", "link"):
        if name not in dir_fd_names:
            return "host lacks directory-fd support for os.%s" % name
    follow_names = {
        function.__name__ for function in os.supports_follow_symlinks}
    if "stat" not in follow_names:
        return "host cannot stat a component without following symlinks"
    if "link" not in follow_names:
        return "host cannot link a component without following symlinks"
    fd_names = {function.__name__ for function in os.supports_fd}
    if "scandir" not in fd_names:
        return "host cannot enumerate an opened registry descriptor"
    for name in ("flock", "LOCK_EX", "LOCK_NB", "LOCK_UN"):
        if not hasattr(fcntl, name):
            return "host lacks fcntl.%s" % name
    return None


class _RegistryTxn:
    """One pinned parent/root descriptor pair and every registry operation."""

    def __init__(self, display_root, *, require_write, create):
        self.display_root = pathlib.Path(display_root)
        self.parent_display = self.display_root.parent
        self.leaf = self.display_root.name
        self.require_write = bool(require_write)
        self.create = bool(create)
        self.parent_fd = None
        self.dir_fd = None
        self.root_identity = None
        self.locked = False
        self.unlock_unknown = False
        if (not self.display_root.is_absolute() or not self.leaf
                or self.leaf in (".", "..")
                or os.sep in self.leaf
                or (os.altsep is not None and os.altsep in self.leaf)):
            raise RegistrationError(
                "refusing non-absolute or multicomponent registry root %r"
                % str(display_root))
        self._validate_component(self.leaf)

    @staticmethod
    def _validate_component(name):
        if type(name) is not str:
            raise RegistrationError(
                "refusing registry component of type %s"
                % type(name).__name__)
        if (not name or name in (".", "..") or os.sep in name
                or (os.altsep is not None and os.altsep in name)
                or "\0" in name):
            raise RegistrationError(
                "refusing non-single registry component %r" % name)
        try:
            os.fsencode(name)
        except (ValueError, UnicodeError) as exc:
            raise RegistrationError(
                "refusing unencodable registry component %r: %s"
                % (name, exc)) from exc
        return name

    @classmethod
    def _validate_fragment(cls, value):
        return cls._validate_component(value)

    def _require_open(self):
        if self.dir_fd is None or self.parent_fd is None:
            raise RegistrationError("registry transaction is not open")

    def _close_one(self, name, primary):
        fd = getattr(self, name)
        if fd is None:
            return primary
        setattr(self, name, None)
        try:
            os.close(fd)
        except BaseException as exc:
            if primary is None:
                return exc
            _note_secondary_failure(
                primary, "registry %s close is UNKNOWN" % name, exc)
        return primary

    def open(self):
        reason = _registry_capability_reason()
        if reason is not None:
            raise RegistrationError(
                "refusing registry transaction before effects: %s" % reason)
        if self.parent_fd is not None or self.dir_fd is not None:
            raise RegistrationError("registry transaction is already open")
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
        primary = None
        try:
            self.parent_fd = os.open(str(self.parent_display), flags)
            if self.create:
                try:
                    os.mkdir(self.leaf, 0o700, dir_fd=self.parent_fd)
                except FileExistsError:
                    pass
            try:
                self.dir_fd = os.open(
                    self.leaf, flags, dir_fd=self.parent_fd)
            except FileNotFoundError:
                if self.create:
                    raise
                close_error = self._close_one("parent_fd", None)
                if close_error is not None:
                    raise RegistrationError(
                        "registry root is absent but parent close is UNKNOWN: %s"
                        % close_error) from close_error
                return False
            except OSError as open_exc:
                # This lstat-style receipt is diagnostic only: it can explain
                # why opening the authority was refused, but it can never
                # authorize an operation.  A symlink and an owner-inaccessible
                # directory therefore retain the explicit policy sentences
                # callers use, while a race or unrelated open failure keeps
                # the original errno.
                try:
                    diagnostic = os.stat(
                        self.leaf, dir_fd=self.parent_fd,
                        follow_symlinks=False)
                    _validate_registry_stat(
                        diagnostic, display_path=self.display_root,
                        require_write=self.require_write)
                except RegistrationError:
                    raise
                except OSError:
                    pass
                raise open_exc
            observed = os.fstat(self.dir_fd)
            _validate_registry_stat(
                observed, display_path=self.display_root,
                require_write=self.require_write)
            self.root_identity = (
                observed.st_dev, observed.st_ino, stat.S_IFMT(observed.st_mode))
            self.require_attached("after registry open")
            return True
        except BaseException as exc:
            primary = exc
            primary = self._close_one("dir_fd", primary)
            primary = self._close_one("parent_fd", primary)
            self.root_identity = None
            if isinstance(primary, (RegistrationError, KeyboardInterrupt,
                                    SystemExit)):
                raise primary
            if not isinstance(primary, Exception):
                raise primary
            raise RegistrationError(
                "could not open registry transaction at %s: %s"
                % (self.display_root, _exception_text(primary))) from primary

    def lock(self):
        self._require_open()
        if self.locked or self.unlock_unknown:
            raise RegistrationError("registry transaction is already locked")
        deadline = time.monotonic() + max(0.0, _REGISTRY_LOCK_TIMEOUT_S)
        while True:
            try:
                fcntl.flock(self.dir_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError as exc:
                if exc.errno not in (errno.EACCES, errno.EAGAIN):
                    raise
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise RegistryLockTimeout(
                        "registry lock remained held for %.1fs at %s"
                        % (_REGISTRY_LOCK_TIMEOUT_S, self.display_root)) from exc
                time.sleep(min(_REGISTRY_LOCK_POLL_S, remaining))
        self.locked = True
        self.require_attached("after registry lock")

    def unlock(self, primary=None):
        if not self.locked:
            if primary is not None:
                raise primary
            return
        self.locked = False
        self.unlock_unknown = True
        try:
            fcntl.flock(self.dir_fd, fcntl.LOCK_UN)
        except BaseException as exc:
            if primary is not None:
                _note_secondary_failure(
                    primary, "registry lock release is UNKNOWN", exc)
                raise primary
            raise
        self.unlock_unknown = False
        if primary is not None:
            raise primary

    def close(self, primary=None):
        first = primary
        if self.locked:
            try:
                self.unlock(primary=first)
            except BaseException as exc:
                first = exc
        first = self._close_one("dir_fd", first)
        if self.dir_fd is None:
            self.unlock_unknown = False
        first = self._close_one("parent_fd", first)
        if first is not None:
            raise first

    def root_receipt(self, operation):
        if self.dir_fd is None or self.parent_fd is None:
            return _RootReceipt(
                _OBS_UNKNOWN, self.root_identity, operation,
                "registry transaction is not open")
        try:
            descriptor = os.fstat(self.dir_fd)
            _validate_registry_stat(
                descriptor, display_path=self.display_root,
                require_write=self.require_write)
            descriptor_identity = (
                descriptor.st_dev, descriptor.st_ino,
                stat.S_IFMT(descriptor.st_mode))
            attached = os.stat(
                self.leaf, dir_fd=self.parent_fd, follow_symlinks=False)
            _validate_registry_stat(
                attached, display_path=self.display_root,
                require_write=self.require_write)
            attached_identity = (
                attached.st_dev, attached.st_ino, stat.S_IFMT(attached.st_mode))
        except BaseException as exc:
            if not isinstance(exc, Exception):
                raise
            return _RootReceipt(
                _OBS_UNKNOWN, self.root_identity, operation,
                _exception_text(exc))
        if (descriptor_identity != self.root_identity
                or attached_identity != self.root_identity):
            return _RootReceipt(
                _OBS_UNKNOWN, self.root_identity, operation,
                "descriptor identity %r and attached identity %r do not both "
                "equal pinned identity %r"
                % (descriptor_identity, attached_identity, self.root_identity))
        return _RootReceipt(
            _OBS_PRESENT, self.root_identity, operation, None)

    def require_attached(self, operation):
        receipt = self.root_receipt(operation)
        if receipt.state != _OBS_PRESENT:
            raise RegistryRootDetached(receipt, self.root_identity, operation)
        return receipt

    def display_path(self, component):
        component = self._validate_component(component)
        return self.display_root / component

    def component_from_display(self, path):
        try:
            text = os.fspath(path)
        except TypeError as exc:
            raise RegistrationError(
                "refusing non-path registry display value %r" % (path,)) from exc
        if type(text) is not str:
            raise RegistrationError("registry display path is not text")
        if "\0" in text:
            raise RegistrationError("registry display path contains NUL")
        try:
            os.fsencode(text)
        except (ValueError, UnicodeError) as exc:
            raise RegistrationError(
                "registry display path is unencodable: %s" % exc) from exc
        prefix = str(self.display_root) + os.sep
        if not text.startswith(prefix):
            raise RegistrationError(
                "%s is not a direct child of %s"
                % (text, self.display_root))
        component = text[len(prefix):]
        self._validate_component(component)
        if text != str(self.display_root / component):
            raise RegistrationError(
                "%s is not one lexical direct child of %s"
                % (text, self.display_root))
        return component

    def observe_name(self, component):
        component = self._validate_component(component)
        self._require_open()
        try:
            observed = os.stat(
                component, dir_fd=self.dir_fd, follow_symlinks=False)
        except FileNotFoundError:
            return _NameReceipt(
                _OBS_ABSENT, component, None, "stat", None)
        except BaseException as exc:
            if not isinstance(exc, Exception):
                raise
            return _NameReceipt(
                _OBS_UNKNOWN, component, None, "stat", _exception_text(exc))
        identity = (
            "present", observed.st_dev, observed.st_ino,
            stat.S_IFMT(observed.st_mode))
        return _NameReceipt(
            _OBS_PRESENT, component, identity, "stat", None)

    def read_entry(self, component):
        component = self._validate_component(component)
        self._require_open()
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
        try:
            fd = os.open(component, flags, dir_fd=self.dir_fd)
        except FileNotFoundError:
            return _EntryReceipt(
                _OBS_ABSENT, component, None, None, None, "open", None)
        except BaseException as exc:
            if not isinstance(exc, Exception):
                raise
            return _EntryReceipt(
                _OBS_UNKNOWN, component, None, None, None, "open",
                _exception_text(exc))
        identity = None
        raw = None
        error = None
        primary = None
        try:
            observed = os.fstat(fd)
            identity = (
                "present", observed.st_dev, observed.st_ino,
                stat.S_IFMT(observed.st_mode))
            if not stat.S_ISREG(observed.st_mode):
                error = ("not a regular file -- a registry entry is never a "
                         "symlink, directory or device")
            else:
                chunks = []
                while True:
                    chunk = os.read(fd, 131072)
                    if not chunk:
                        break
                    chunks.append(chunk)
                raw = b"".join(chunks)
        except BaseException as exc:
            primary = exc
        close_error = None
        try:
            os.close(fd)
        except BaseException as exc:
            close_error = exc
        if primary is not None:
            if close_error is not None:
                _note_secondary_failure(
                    primary, "entry descriptor close is UNKNOWN", close_error)
            if not isinstance(primary, Exception):
                raise primary
            return _EntryReceipt(
                _OBS_UNKNOWN, component, identity, raw, None, "read",
                _exception_text(primary))
        if close_error is not None:
            if not isinstance(close_error, Exception):
                raise close_error
            return _EntryReceipt(
                _OBS_UNKNOWN, component, identity, raw, None, "close",
                _exception_text(close_error))
        if error is not None:
            return _EntryReceipt(
                _OBS_UNKNOWN, component, identity, raw, None, "fstat", error)
        try:
            text = raw.decode("utf-8", "strict")
            entry = json.loads(
                text, object_pairs_hook=_object_without_duplicates)
        except (UnicodeError, ValueError) as exc:
            return _EntryReceipt(
                _OBS_UNKNOWN, component, identity, raw, None, "parse",
                "not usable JSON: %s" % exc)
        reason = _entry_schema_reason(entry, filename=component)
        if reason is not None:
            return _EntryReceipt(
                _OBS_UNKNOWN, component, identity, raw, None, "schema", reason)
        return _EntryReceipt(
            _OBS_PRESENT, component, identity, raw, entry, "read", None)

    def create_exclusive(self, prefix, suffix):
        prefix = self._validate_fragment(prefix)
        suffix = self._validate_fragment(suffix)
        self._require_open()
        flags = (os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
                 | os.O_CLOEXEC)
        for _ in range(64):
            component = "%s%s%s" % (prefix, os.urandom(16).hex(), suffix)
            self._validate_component(component)
            self.require_attached("before create exclusive")
            try:
                fd = os.open(component, flags, 0o600, dir_fd=self.dir_fd)
            except FileExistsError:
                continue
            return component, fd
        raise RegistrationError(
            "could not acquire an exclusive registry component after 64 "
            "collisions")

    def rename_name(self, source, destination):
        source = self._validate_component(source)
        destination = self._validate_component(destination)
        self._require_open()
        self.require_attached("before rename")
        return os.rename(
            source, destination, src_dir_fd=self.dir_fd,
            dst_dir_fd=self.dir_fd)

    def link_name(self, source, destination):
        source = self._validate_component(source)
        destination = self._validate_component(destination)
        self._require_open()
        self.require_attached("before link")
        return os.link(
            source, destination, src_dir_fd=self.dir_fd,
            dst_dir_fd=self.dir_fd, follow_symlinks=False)

    def unlink_name(self, component):
        component = self._validate_component(component)
        self._require_open()
        self.require_attached("before unlink")
        return os.unlink(component, dir_fd=self.dir_fd)

    def fsync(self):
        self._require_open()
        self.require_attached("before directory fsync")
        return os.fsync(self.dir_fd)

    def json_components(self):
        self._require_open()
        with os.scandir(self.dir_fd) as iterator:
            components = []
            for item in iterator:
                name = item.name
                if name.endswith(".json"):
                    components.append(self._validate_component(name))
        return sorted(components, key=os.fsencode)


def _writer_txn(supplied=None):
    if supplied is not None:
        if (not isinstance(supplied, _RegistryTxn)
                or supplied.display_root != pathlib.Path(JOBS_DIR)
                or supplied.dir_fd is None or supplied.parent_fd is None
                or not supplied.require_write):
            raise RegistrationError(
                "supplied registry transaction is not the open writable "
                "configured root")
        return supplied, False
    txn = _RegistryTxn(JOBS_DIR, require_write=True, create=True)
    txn.open()
    return txn, True


def _settle_registry_owner(txn, *, unlock, close, primary=None, context):
    """Attempt every owner finalizer and preserve the first BaseException.

    Returning instead of raising inside either finalizer is deliberate: a
    cancellation from ``LOCK_UN`` must not jump over descriptor close, and a
    later close fault must be a note on the exact initiating object rather
    than its replacement.  ``events`` lets totalizing callers report ordinary
    uncertainty without weakening cancellation identity.
    """
    first = primary
    events = []

    def remember(stage, exc):
        nonlocal first
        events.append((stage, exc))
        if first is None:
            first = exc
        elif exc is not first:
            _note_secondary_failure(
                first, "%s %s is UNKNOWN" % (context, stage), exc)

    if unlock and txn.locked:
        try:
            txn.unlock()
        except BaseException as exc:
            remember("registry unlock", exc)
    if close:
        try:
            txn.close()
        except BaseException as exc:
            remember("registry close", exc)
    return first, events


def _settle_assigned_child_fd(fd, *, primary=None, context, component):
    """Close one acquired child fd once, retaining the exact first failure."""
    first = primary
    try:
        os.close(fd)
    except BaseException as exc:
        if first is None:
            first = exc
        elif exc is not first:
            _note_secondary_failure(
                first, "%s descriptor close is UNKNOWN" % context, exc)
    if first is not None:
        _note_fact(first,
            "%s component %s is RETAINED/UNKNOWN"
            % (context, component))
    return first


def _disk_entry(entry):
    return {key: value for key, value in entry.items() if key != "_path"}


def _loaded_entry(txn, receipt):
    if receipt.state != _OBS_PRESENT:
        raise RegistrationError(
            "cannot load non-present registry receipt for %s"
            % receipt.component)
    loaded = _LoadedEntry(receipt.entry)
    loaded["_path"] = str(txn.display_path(receipt.component))
    loaded._registry_root_identity = txn.root_identity
    loaded._registry_component = receipt.component
    loaded._registry_raw_bytes = receipt.raw_bytes
    return loaded


def _prepare_registry():
    """Create and validate the configured registry without path-form effects."""
    txn = _RegistryTxn(JOBS_DIR, require_write=True, create=True)
    primary = None
    try:
        txn.open()
    except BaseException as exc:
        primary = exc
    settled, _events = _settle_registry_owner(
        txn, unlock=False, close=True, primary=primary,
        context="registry preparation")
    if primary is not None:
        raise settled
    if settled is not None:
        if not isinstance(settled, Exception):
            raise settled
        raise RegistrationError(
            "registry preparation close is UNKNOWN: %s"
            % _exception_text(settled)) from settled


class _PublicationResult:
    """Private publication fact; public register() still returns an entry."""

    def __init__(self, entry, attempted, disposition, final_component=None,
                 final_receipt=None, root_identity=None):
        self.entry = entry
        self.attempted = attempted
        self.disposition = disposition
        self.final_component = final_component
        self.final_receipt = final_receipt
        self.root_identity = root_identity


class PublishedNotDurable(RuntimeError):
    """A COMPLETE, VALID FINAL EXISTS and could neither be proven durable nor
    provably withdrawn.

    DELIBERATELY NOT a RegistrationError, and this is the whole point of having
    two classes. The two say opposite things about the disk -- "there is no
    record" versus "there is a record and I cannot account for it" -- and the
    only reason the old code deleted a live entry's log while reporting
    "nothing was registered" is that one branch handled both. A caller that
    catches RegistrationError must not silently catch this.

    Carries the exact path so the caller can NAME it instead of describing it,
    and the log so nothing deletes a file the retained entry still refers to.
    """

    def __init__(self, final, log, detail, entry_id=None):
        self.final = pathlib.Path(final)
        self.log = log
        self.detail = detail
        self.entry_id = entry_id or self.final.name[:-len(".json")]
        super().__init__("RETAINED %s; durability/cleanup UNKNOWN (%s)"
                         % (self.final, detail))


class PublishedCloseUnknown(RuntimeError):
    """A durable publication succeeded, but releasing its registry lock did not.

    The entry and id are structured attributes because callers must continue
    from the fact on disk, not classify this like a pre-publication failure and
    destroy the evidence that record owns.
    """

    def __init__(self, entry, final, detail, disposition="created",
                 attempted=None):
        self.entry = entry
        self.final = pathlib.Path(final)
        self.entry_id = entry["id"]
        self.detail = detail
        self.disposition = disposition
        self.attempted = attempted
        self.entry["_path"] = str(self.final)
        super().__init__(
            "record %s is durable at %s, but registry lock close is UNKNOWN "
            "(%s)" % (self.entry_id, self.final, _exception_text(detail)))


class PublishedLockUnknown(RuntimeError):
    """The final is durable, but the publication flock may still be held."""

    def __init__(self, result, final, detail):
        self.result = result
        self.entry = result.entry
        self.entry_id = result.entry["id"]
        self.final = pathlib.Path(final)
        self.detail = detail
        super().__init__(
            "record %s is durable at %s, but registry LOCK RELEASE is UNKNOWN "
            "(%s); work was not released"
            % (self.entry_id, self.final, _exception_text(detail)))


def _unlink_verified(txn, component):
    """Remove one pinned-root component and prove its resulting observation."""
    component = txn._validate_component(component)
    display = str(txn.display_path(component))

    def grant_absence(note, operation):
        root = txn.root_receipt(operation)
        if root.state != _OBS_PRESENT:
            return False, (
                "ROOT_DETACHED/UNKNOWN while proving absence of %s; pinned "
                "identity %r and component disposition are RETAINED (%s)"
                % (display, txn.root_identity, root.error))
        return True, note

    try:
        txn.unlink_name(component)
    except FileNotFoundError:
        return grant_absence(
            "%s was already absent" % display,
            "after absent unlink result")
    except Exception as exc:
        observed = txn.observe_name(component)
        if observed.state == _OBS_UNKNOWN:
            return False, (
                "UNKNOWN: unlink of %s raised (%s), and observing its result "
                "also failed (%s)" % (display, _exception_text(exc),
                                       observed.error))
        if observed.state == _OBS_PRESENT:
            return False, "COULD NOT remove %s: %s" % (display, exc)
        return grant_absence(
            "removed %s" % display,
            "after raised unlink with absent component")
    observed = txn.observe_name(component)
    root = txn.root_receipt("after unlink")
    if root.state != _OBS_PRESENT:
        return False, (
            "ROOT_DETACHED/UNKNOWN after unlink of %s; pinned identity %r "
            "and component are RETAINED as uncertain evidence (%s)"
            % (display, txn.root_identity, root.error))
    if observed.state == _OBS_UNKNOWN:
        return False, (
            "UNKNOWN: unlink of %s returned, but observing its result failed "
            "(%s)" % (display, observed.error))
    if observed.state == _OBS_PRESENT:
        return False, "%s still exists after unlink" % display
    return True, "removed %s" % display


def _publish_entry(txn, entry):
    """Stage, make durable, RE-VERIFY IDENTITY, then publish atomically.

    An entry is a kill instruction. The single `write_text` this replaces made
    the visible name appear before its bytes were on the device, so a reader --
    `load_all()`, and therefore `reap` -- could see a truncated entry, or one
    whose `starttime` never landed. `load_all()` swallows the torn read, which
    turns a job WITH a record into a job with NO record while everything looks
    consistent; and a null start time makes the final malformed and every
    reader UNKNOWN, so a torn write becomes retained, unusable evidence.

    The identity re-check between fsync and replace is the second half. The
    start time was sampled before the bytes were written; if the process died
    in between and the kernel handed its pid to a stranger, publishing would
    arm this tool to kill that stranger. Nothing is published in that case.

    TWO FAILURE MODES, NEVER ONE (the v3.66.1207 audit). `os.replace` is the
    instant a name becomes visible, so a failure before it and a failure after
    it are opposite facts. Before: nothing exists, the temp is removed, and
    RegistrationError says so. After: a COMPLETE VALID ENTRY IS ON DISK, and
    reporting "nothing was registered" -- which is what the first version of
    this transaction did -- made the caller delete the log of a live record.
    """
    reason = _entry_schema_reason(entry)
    if reason is not None:
        raise RegistrationError(
            "refusing to stage a malformed registry record: %s" % reason)
    final_component = "%s.json" % entry["id"]
    final = txn.display_path(final_component)
    try:
        txn.lock()
    except BaseException as exc:
        if txn.locked:
            txn.unlock(primary=exc)
        if isinstance(exc, RegistrationError):
            raise
        if not isinstance(exc, Exception):
            raise
        raise RegistrationError(
            "could not acquire the registry lock before publication: %s"
            % _exception_text(exc)
        ) from exc
    try:
        preserved, displaced_prior, receipt = _decide_collision(
            txn, final_component, entry)
        if preserved is not None:
            result = _PublicationResult(
                preserved, entry, "preserved", final_component, receipt,
                txn.root_identity)
        else:
            published, receipt = _stage_and_replace_under_lock(
                txn, final_component, entry,
                displaced_prior=displaced_prior)
            result = _PublicationResult(
                published, entry, "created", final_component, receipt,
                txn.root_identity)
    except BaseException as primary:
        # Preserve the existing failure contract: an unlock failure while a
        # publication operation is already failing remains that operation's
        # failure path. Only a completed publication has an entry to retain.
        try:
            txn.unlock()
        except BaseException as secondary:
            _note_secondary_failure(
                primary, "registry lock release is UNKNOWN", secondary)
        raise
    try:
        txn.unlock()
    except Exception as exc:
        raise PublishedLockUnknown(result, final, exc) from exc
    except BaseException as primary:
        _note_fact(primary,
            "publication completed for entry %s, but registry lock release "
            "is UNKNOWN; the durable entry and its evidence are retained"
            % result.entry["id"])
        setattr(primary, "bd_published_result", result)
        raise
    return result


def _type_name(value):
    """Return a diagnostic type name without trusting a custom metaclass."""
    try:
        return type.__getattribute__(type(value), "__name__")
    except BaseException:
        return "value"


def _exception_atom(value):
    """Render hostile exception text without creating a new primary."""
    try:
        return str(value)
    except BaseException as render_failure:
        return "<%s text unavailable: %s>" % (
            _type_name(value), _type_name(render_failure))


def _note_secondary_failure(primary, context, secondary):
    """Attach cleanup uncertainty without mutating the causal exception."""
    note = "%s (%s)" % (context, _exception_atom(secondary))
    _note_fact(primary, note)


def _note_fact(primary, note):
    """Attach one diagnostic fact even when an exception overrides add_note."""
    try:
        primary.add_note(note)
    except BaseException:
        # Exception subclasses can override add_note(), and cleanup must never
        # let that hostile reporting hook replace the operation being reported.
        try:
            retained = list(getattr(primary, "_bd_secondary_notes", []))
            retained.append(note)
            primary._bd_secondary_notes = retained
        except BaseException:
            pass


def _metadata_atoms(owner, attribute):
    """Snapshot and render one note collection without trusting its hooks."""
    try:
        values = getattr(owner, attribute, None)
    except BaseException as exc:
        return ["<%s unavailable: %s>" % (attribute, _type_name(exc))]
    if values is None:
        return []
    try:
        iterator = iter(values)
    except BaseException as exc:
        return ["<%s iteration unavailable: %s>"
                % (attribute, _type_name(exc))]
    atoms = []
    while True:
        try:
            value = next(iterator)
        except StopIteration:
            break
        except BaseException as exc:
            atoms.append("<%s iteration unavailable: %s>"
                         % (attribute, _type_name(exc)))
            break
        atoms.append(_exception_atom(value))
    return atoms


def _metadata_value(owner, attribute):
    """Snapshot one exception-chain link and return any diagnostic marker."""
    try:
        return getattr(owner, attribute, None), None
    except BaseException as exc:
        return None, "<%s unavailable: %s>" % (attribute, _type_name(exc))


def _exception_text(exc):
    """Render an exception plus attached cleanup facts without changing it."""
    parts = []
    seen = set()
    current = exc
    while current is not None and id(current) not in seen:
        seen.add(id(current))
        parts.append(_exception_atom(current))
        parts.extend(_metadata_atoms(current, "__notes__"))
        parts.extend(_metadata_atoms(current, "_bd_secondary_notes"))
        cause, cause_marker = _metadata_value(current, "__cause__")
        context, context_marker = _metadata_value(current, "__context__")
        if cause_marker is not None:
            parts.append(cause_marker)
        if context_marker is not None:
            parts.append(context_marker)
        current = cause if cause is not None else context
    return "; ".join(part for part in parts if part != "")


def _decide_collision(txn, final_component, entry):
    """What to do about a record that is already at this id. Returns the entry
    to PRESERVE, or None to publish.

    PID AND STARTTIME ARE THE ONLY AUTHORITY, because they are the only fields
    the kernel backs. Same pid and same start time is the same process, so the
    record already on disk is the one another reader may already be acting on:
    it is returned unchanged rather than rewritten. A different start time is a
    record of a process that provably no longer exists, so it is stale and
    replaceable. Bytes that cannot be read decide nothing, so they are kept and
    the publication is refused -- overwriting them would destroy the only
    evidence of what went wrong.

    Nothing else may be consulted here. `request_id` in particular is evidence
    for an operator reconciling a transport failure, NOT a second identity.
    """
    final = txn.display_path(final_component)
    receipt = txn.read_entry(final_component)
    if receipt.state == _OBS_ABSENT:
        return None, False, receipt
    if receipt.state == _OBS_UNKNOWN:
        raise RegistrationError(
            "a prior registry file at %s cannot be read (%s), so nothing can "
            "decide whether it describes this job. It is RETAINED unchanged "
            "and nothing was published; move it aside by hand."
            % (final, receipt.error))
    prior = receipt.entry
    if (prior.get("pid") == entry["pid"]
            and prior.get("starttime") == entry["starttime"]):
        txn.require_attached("before preserved publication result")
        return _loaded_entry(txn, receipt), True, receipt
    _inherit_displaced_owned_state(prior, entry)
    return None, True, receipt


def _inherit_displaced_owned_state(prior, replacement):
    """Transfer cleanup authority from a stale record into its replacement.

    The new final atomically replaces the old one, so after that instant no
    record names the old record's log or adopted scripts unless they travel in
    the replacement. Only paths this tool can prove it owned are transferred.
    """
    inherited = list(replacement.get("owned_paths") or [])

    def add(path):
        if path and _log_is_a_direct_child_of_the_registry(path) \
                and str(path) not in inherited:
            inherited.append(str(path))

    for path in prior.get("owned_paths") or []:
        add(path)
    prior_log = prior.get("log")
    log_owned = prior.get("log_owned")
    if log_owned is None:
        log_owned = _log_is_a_direct_child_of_the_registry(prior_log)
    if log_owned:
        add(prior_log)
    if inherited:
        replacement["owned_paths"] = inherited


def _stage_and_replace_under_lock(txn, final_component, entry,
                                  displaced_prior=False):
    """The atomic half, and the ONLY place a name appears in the registry.

    Called from `_publish_entry` and nowhere else, always with the registry
    lock held -- which is why it is spelled that way in its name rather than
    left to a comment. `test_register_is_the_sole_bd_jobs_json_registry_writer`
    pins that surface: every call that creates or renames a file under
    `JOBS_DIR` lives in this function, `_publish_entry`, or `open_job_log`.
    """
    final = txn.display_path(final_component)
    try:
        tmp_component, fd = txn.create_exclusive(
            _ENTRY_TEMP_PREFIX, _ENTRY_TEMP_SUFFIX)
    except OSError as exc:
        raise RegistrationError(
            "could not acquire a staged entry for %s: %s"
            % (final_component, exc)
        ) from exc
    tmp = txn.display_path(tmp_component)
    published = False
    fh = None
    fd_state = "raw"
    close_unknown = None
    try:
        fh = os.fdopen(fd, "w", encoding="utf-8")
        fd_state = "file"
        fh.write(json.dumps(_disk_entry(entry), indent=2))
        fh.flush()
        os.fsync(fh.fileno())
        # Mark the authority spent BEFORE close. If close raises, retrying it
        # or unlinking its inode would recreate authority the error destroyed.
        fd_state = "close-attempted"
        try:
            fh.close()
        except BaseException as exc:
            close_unknown = exc
            raise
        fd_state = "closed"
        now = proc_starttime(entry["pid"])
        if now != entry["starttime"]:
            raise RegistrationError(
                "pid %s stopped being the process that was measured while its "
                "entry was being written (start time %r -> %r), so publishing "
                "would arm reap against whatever holds that pid now. Nothing "
                "was published." % (entry["pid"], entry["starttime"], now))
        txn.rename_name(tmp_component, final_component)
        published = True
        txn.require_attached("after publication rename")
        txn.fsync()
        txn.require_attached("after publication directory fsync")
        final_receipt = txn.read_entry(final_component)
        if final_receipt.state != _OBS_PRESENT:
            raise RegistrationError(
                "published final %s could not be re-read from its pinned root "
                "(%s)" % (final, final_receipt.error or final_receipt.state))
        txn.require_attached("before created publication result")
    except BaseException as exc:
        if not published:
            # ONE DISPOSITION FUNNEL. Every pre-replace primary arrives here
            # with the stage's monotonic fd state; no inner branch unlinks and
            # no failed cleanup can be retried by an outer handler.
            if fd_state == "raw":
                fd_state = "raw-close-attempted"
                try:
                    os.close(fd)
                except BaseException as secondary:
                    close_unknown = secondary
                    _note_secondary_failure(
                        exc, "raw stage fd close is UNKNOWN", secondary)
                else:
                    fd_state = "closed"
            elif fd_state == "file":
                fd_state = "file-close-attempted"
                try:
                    fh.close()
                except BaseException as secondary:
                    close_unknown = secondary
                    _note_secondary_failure(
                        exc, "staged file close is UNKNOWN", secondary)
                else:
                    fd_state = "closed"

            if close_unknown is not None:
                removed, note = False, (
                    "stage descriptor close is UNKNOWN (%s), so RETAINED %s "
                    "without retrying close or unlinking a possibly-open inode"
                    % (close_unknown, tmp))
            else:
                try:
                    removed, note = _unlink_verified(txn, tmp_component)
                except BaseException as secondary:
                    removed = False
                    note = (
                        "staged entry cleanup disposition is UNKNOWN for %s: %s"
                        % (tmp, _exception_text(secondary)))
                    _note_secondary_failure(
                        exc, "staged entry cleanup helper also failed", secondary)

            if isinstance(exc, RegistrationError):
                if not removed:
                    exc.cleanup_complete = False
                    exc.retained_paths = [str(tmp)]
                    _note_fact(exc, note)
                raise
            if isinstance(exc, (KeyboardInterrupt, SystemExit)):
                if not removed:
                    _note_secondary_failure(
                        exc, "staged entry cleanup is incomplete at %s" % tmp,
                        RegistrationError(note))
                raise
            raise RegistrationError(
                "could not publish %s: %s -- no final was written; %s"
                % (final.name, exc, note), cleanup_complete=removed,
                retained_paths=[] if removed else [str(tmp)]) from exc
        if displaced_prior:
            # The replacement now contains the displaced record's cleanup
            # authority. Withdrawing it would leave no final naming either
            # record's owned artifacts, so retention is the only recoverable
            # post-replace outcome.
            retained_text = ", ".join(
                str(path) for path in (
                    entry.get("log"), *list(entry.get("owned_paths") or []))
                if path) or "none"
            raise PublishedNotDurable(
                final, entry.get("log"),
                "%s; the replacement displaced a validated stale record and "
                "is RETAINED because it is now the sole cleanup authority; "
                "KEPT %s" % (exc, retained_text)) from exc
        raise _withdraw_or_retain(
            txn, final_component, entry, exc) from exc
    return _loaded_entry(txn, final_receipt), final_receipt


def _withdraw_or_retain(txn, final_component, entry, cause):
    """A publication that is already visible: withdraw it, or KEEP AND NAME it.

    Returns the exception the caller must raise -- never raises one itself, so
    the decision and the reporting stay in one readable place.

    THE DIRECTORY IS PROBED FIRST, and that order is the correction. Removing a
    valid record is itself an act that must be durable; if this directory
    cannot be fsynced at all -- which is exactly the condition that brought us
    here -- then an unlink is an operation whose result nobody can trust, and
    destroying a live record on the strength of it is the same class of mistake
    as publishing one that was never written. So: prove durability works, THEN
    withdraw, THEN prove the withdrawal. Any step that cannot be proven leaves
    the valid final exactly where it is, named for the operator.
    """
    final = txn.display_path(final_component)
    cause_text = _exception_text(cause)
    retained_paths = [entry.get("log"), *list(entry.get("owned_paths") or [])]
    retained_text = ", ".join(str(p) for p in retained_paths if p) or "none"
    try:
        txn.fsync()
        txn.require_attached("after withdrawal durability probe")
    except Exception as probe:
        return PublishedNotDurable(
            final, entry.get("log"),
            "%s; the registry directory could not be made durable on a second "
            "attempt either (%s), so the entry was NOT withdrawn -- removing a "
            "valid record through an operation that cannot be proven is not a "
            "rollback; KEPT %s" % (cause_text, probe, retained_text))
    try:
        removed, note = _unlink_verified(txn, final_component)
    except Exception as cleanup_exc:
        return PublishedNotDurable(
            final, entry.get("log"),
            "%s; withdrawal helper raised unexpectedly (%s), so the entry and "
            "every path it names are RETAINED; KEPT %s"
            % (cause_text, cleanup_exc, retained_text))
    if not removed:
        return PublishedNotDurable(final, entry.get("log"),
                                   "%s; %s; KEPT %s"
                                   % (cause_text, note, retained_text))
    try:
        txn.fsync()
        txn.require_attached("after durable withdrawal fsync")
    except Exception as after:
        return PublishedNotDurable(
            final, entry.get("log"),
            "%s; the entry was unlinked but that removal could not be made "
            "durable (%s), so it may come back; KEPT %s"
            % (cause_text, after, retained_text))
    return RegistrationError(
        "could not make %s durable (%s); the entry was withdrawn again and "
        "verified absent, so nothing is published"
        % (final_component, cause_text))


def _request_id_reason(request_id):
    if not isinstance(request_id, str):
        return "is not a string"
    if re.fullmatch(r"[A-Za-z0-9._-]{1,128}", request_id) is None:
        return "must match [A-Za-z0-9._-]{1,128}"
    return None


def _attempt_token_reason(attempt_token):
    if not isinstance(attempt_token, str) \
            or re.fullmatch(r"[0-9a-f]{32}", attempt_token) is None:
        return "must be one lowercase 128-bit hexadecimal token"
    return None


def register(pid, purpose, cmd, origin=None, log=None, log_owned=False,
             owned_paths=None, request_id=None, attempt_token=None,
             _return_publication=False, _txn=None):
    """Publish ONE complete entry, or publish nothing and say why.

    The pid is validated SEMANTICALLY, not merely syntactically: a number that
    no live process answers to cannot be given a start time, and an entry with
    no start time is one this tool refuses to kill and refuses to forget. Such
    an entry is not a weaker record -- it is litter that no verb can clear.

    `log_owned` says WHO CREATED THE LOG, and only the launcher passes True. A
    `log` field is otherwise a path somebody handed us -- `bd-sweep-run` and
    `bd-wedge-hunt` register a pid whose log is their own run directory's
    evidence -- and `forget()` must not delete an operator's evidence just
    because an entry mentioned it.
    """
    if request_id is not None:
        reason = _request_id_reason(request_id)
        if reason is not None:
            raise RegistrationError("refusing request id %r: %s"
                                    % (request_id, reason))
    if attempt_token is not None:
        reason = _attempt_token_reason(attempt_token)
        if reason is not None:
            raise RegistrationError("refusing attempt token: %s" % reason)
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        raise RegistrationError("not a pid: %r" % (pid,))
    if pid <= 0:
        raise RegistrationError(
            "refusing to register pid %d: 0 and negatives name process GROUPS "
            "to kill(2), not a process" % pid)
    starttime = proc_starttime(pid)
    if starttime is None:
        raise RegistrationError(
            "pid %d has no readable /proc start time, so no later reader could "
            "ever prove it is still the same process. Readers grade such an "
            "entry UNKNOWN and KEEP it for manual adjudication, so writing one "
            "creates unusable evidence instead of a record" % pid)
    entry = {
        "id": "%s-%d" % (socket.gethostname(), pid),
        "pid": pid,
        "starttime": starttime,
        "purpose": purpose,
        "cmd": cmd,
        "host": socket.gethostname(),
        "origin": origin or socket.gethostname(),
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        # None for a job launched without one, and progress() reports UNKNOWN
        # for it rather than guessing.
        "log": log,
    }
    if log:
        # Recorded only when there IS a log, so an entry without one keeps the
        # exact operator schema it has always had.
        entry["log_owned"] = bool(log_owned)
    if owned_paths:
        # Auxiliary files THIS transaction created on this host -- today, a
        # script copied in for a delegated job. Recorded so `forget()` can
        # reclaim them, and normalized again at removal time: a recorded path
        # is a claim, not a capability.
        entry["owned_paths"] = [str(p) for p in owned_paths]
    if request_id:
        # EVIDENCE, NOT IDENTITY. It exists so an operator can reconcile a
        # transport failure -- "did this launch actually land?" -- against the
        # target's registry. `_decide_collision` never reads it.
        entry["request_id"] = request_id
    if attempt_token:
        entry["attempt_token"] = attempt_token
    run_marker = os.environ.get("BD_JOBS_RUN_MARKER")
    if run_marker:
        entry["run_marker"] = run_marker
    txn, owned = _writer_txn(_txn)
    try:
        publication = _publish_entry(txn, entry)
    except BaseException as primary:
        if owned:
            txn.close(primary=primary)
        raise
    if owned:
        try:
            txn.close()
        except Exception as exc:
            raise PublishedCloseUnknown(
                publication.entry,
                JOBS_DIR / publication.final_component, exc,
                disposition=publication.disposition,
                attempted=entry) from exc
        except BaseException as primary:
            _note_fact(primary,
                "publication completed for entry %s, but registry transaction "
                "close is UNKNOWN; the durable entry and evidence are retained"
                % publication.entry["id"])
            setattr(primary, "bd_published_result", publication)
            raise
    return publication if _return_publication else publication.entry


class _RegistrySnapshot(list):
    """The valid entries -- and, separately, what could not be read.

    A LIST, so every existing caller keeps working unchanged. The extra
    attribute is the whole correction: `except (OSError, ValueError): continue`
    threw away the fact that a file existed at all, so a torn entry became a job
    with no record and every verb reported success over the gap. UNKNOWN is a
    failing third state (CLAUDE.md A2), and it cannot be reported by a reader
    that has already forgotten the question.
    """

    def __init__(self, entries=(), malformed=()):
        super().__init__(entries)
        self.malformed = list(malformed)


def _object_without_duplicates(pairs):
    """json's default keeps the LAST duplicate key silently. Two readers of the
    same bytes must not disagree about which pid an entry names."""
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise ValueError("duplicate key %r" % key)
        seen[key] = value
    return seen


def _filesystem_path_reason(value):
    """Why a string cannot safely be handed to this host's filesystem APIs."""
    if "\0" in value:
        return "contains NUL and is not a usable filesystem path"
    try:
        os.fsencode(value)
    except (ValueError, UnicodeError) as exc:
        return "cannot be encoded as a filesystem path: %s" % exc
    return None


def _entry_schema_reason(entry, filename=None):
    """Return why registry content is unsafe, without touching the filesystem."""
    if not isinstance(entry, dict):
        return "not a JSON object: %s" % type(entry).__name__
    pid = entry.get("pid")
    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
        return "pid is not a process id: %r" % (pid,)
    ident, host = entry.get("id"), entry.get("host")
    if not isinstance(ident, str) or not ident:
        return "id is missing or not a string"
    if not isinstance(host, str) or not host:
        return "host is missing or not a string"
    if ident != "%s-%d" % (host, pid):
        return ("id %r disagrees with its own host/pid (%s/%d)"
                % (ident, host, pid))
    if filename is not None and filename != "%s.json" % ident:
        return "filename disagrees with the id it contains (%r)" % ident
    starttime = entry.get("starttime")
    if isinstance(starttime, bool) or not isinstance(starttime, int) \
            or starttime <= 0:
        return "starttime is not a positive process identity: %r" % (starttime,)
    for key in ("purpose", "cmd", "origin", "started_at"):
        if key not in entry or not isinstance(entry[key], str):
            return "%s is missing or not a string" % key
    log = entry.get("log")
    if log is not None and not isinstance(log, str):
        return "log is neither a path nor absent: %r" % (log,)
    if log is not None:
        reason = _filesystem_path_reason(log)
        if reason is not None:
            return "log is not a usable filesystem path: %s" % reason
    if "log_owned" in entry and not isinstance(entry["log_owned"], bool):
        return "log_owned is not a boolean: %r" % (entry["log_owned"],)
    owned_paths = entry.get("owned_paths")
    if owned_paths is not None and not isinstance(owned_paths, list):
        return "owned_paths is not a list of non-empty paths: %r" % owned_paths
    for value in owned_paths or []:
        if not isinstance(value, str) or not value:
            return "owned_paths is not a list of non-empty paths: %r" % owned_paths
        reason = _filesystem_path_reason(value)
        if reason is not None:
            return ("owned_paths entry %r is not a usable filesystem path: %s"
                    % (value, reason))
    if "request_id" in entry:
        reason = _request_id_reason(entry["request_id"])
        if reason is not None:
            return "request_id %s: %r" % (reason, entry["request_id"])
    if "attempt_token" in entry:
        reason = _attempt_token_reason(entry["attempt_token"])
        if reason is not None:
            return "attempt_token %s" % reason
    if "run_marker" in entry and (
            not isinstance(entry["run_marker"], str) or not entry["run_marker"]):
        return "run_marker is not a non-empty string: %r" % entry["run_marker"]
    return None


def _load_all_txn(txn):
    """Read every final from one already-open pinned registry root."""
    entries, malformed = [], []
    before = txn.root_receipt("before registry enumeration")
    if before.state != _OBS_PRESENT:
        return _RegistrySnapshot(
            malformed=[(txn.display_root,
                        "ROOT_DETACHED/UNKNOWN before enumeration: %s"
                        % before.error)])
    try:
        components = txn.json_components()
    except Exception as exc:
        return _RegistrySnapshot(
            malformed=[(txn.display_root,
                        "registry root cannot be listed: %s"
                        % _exception_text(exc))])
    after_enumeration = txn.root_receipt("after registry enumeration")
    if after_enumeration.state != _OBS_PRESENT:
        return _RegistrySnapshot(
            malformed=[(txn.display_root,
                        "ROOT_DETACHED/UNKNOWN after enumeration: %s"
                        % after_enumeration.error)])
    for component in components:
        receipt = txn.read_entry(component)
        display = txn.display_path(component)
        if receipt.state != _OBS_PRESENT:
            malformed.append((display, receipt.error or receipt.state))
            continue
        entries.append(_loaded_entry(txn, receipt))
    after_reads = txn.root_receipt("after registry entry reads")
    if after_reads.state != _OBS_PRESENT:
        return _RegistrySnapshot(
            malformed=[(txn.display_root,
                        "ROOT_DETACHED/UNKNOWN after entry reads: %s"
                        % after_reads.error)])
    return _RegistrySnapshot(entries, malformed)


def load_all():
    """Every valid entry from one pinned root, plus every malformed sibling."""
    txn = _RegistryTxn(JOBS_DIR, require_write=False, create=False)
    try:
        opened = txn.open()
    except Exception as exc:
        return _RegistrySnapshot(
            malformed=[(JOBS_DIR, "registry root cannot be inspected: %s"
                         % _exception_text(exc))])
    if not opened:
        return _RegistrySnapshot()
    try:
        rows = _load_all_txn(txn)
    except BaseException as primary:
        txn.close(primary=primary)
        raise
    try:
        txn.close()
    except Exception as exc:
        rows.malformed.append(
            (JOBS_DIR, "registry root close is UNKNOWN: %s"
             % _exception_text(exc)))
    return rows


def _name_malformed(rows, kept_note):
    """Name every unreadable final on stderr and grade the read.

    Returns the exit status the verb must carry: UNKNOWN is not a pass, and it
    is not the verb's ordinary failure either -- `reap` still returns 1 when it
    REFUSED a live entry, and a caller must be able to tell the two apart.
    """
    for path, reason in rows.malformed:
        print("UNREADABLE %s: %s" % (path, reason), file=sys.stderr)
    if rows.malformed:
        print(kept_note, file=sys.stderr)
        return _EXIT_REGISTRY_UNKNOWN
    return 0


def _log_is_a_direct_child_of_the_registry(log):
    """Whether a display string is lexically one direct registry child."""
    if not log:
        return False
    try:
        txn = _RegistryTxn(JOBS_DIR, require_write=False, create=False)
        txn.component_from_display(log)
    except (RegistrationError, OSError, ValueError, UnicodeError):
        return False
    return True


def _component_identity(txn, component):
    """The component occupant measured inside one pinned registry root."""
    receipt = txn.observe_name(component)
    if receipt.state == _OBS_ABSENT:
        return ("absent",)
    if receipt.state == _OBS_UNKNOWN:
        return ("unreadable", receipt.operation, receipt.error)
    return receipt.identity


def _unlink_owned_identity(txn, component, observed):
    """Remove only the same pinned-root component occupant observed earlier.

    Returns (removed, note, directory_changed). The compare/quarantine/restore
    behavior is unchanged; every operation uses the transaction descriptor.
    """
    component = txn._validate_component(component)
    display = str(txn.display_path(component))
    try:
        current = _component_identity(txn, component)
    except Exception as exc:
        return False, (
            "UNKNOWN: could not observe %s before cleanup (%s); RETAINED"
            % (display, _exception_text(exc))), False
    except BaseException as primary:
        _note_fact(primary,
            "cleanup of %s was interrupted before identity observation"
            % display)
        raise
    if current == ("absent",):
        root = txn.root_receipt("before absent owned-component grant")
        if root.state != _OBS_PRESENT:
            return False, (
                "ROOT_DETACHED/UNKNOWN while proving %s absent; pinned "
                "identity %r and component disposition are RETAINED (%s)"
                % (display, txn.root_identity, root.error)), False
        return True, "%s was already absent" % display, False
    if observed[0] == "unreadable":
        return False, (
            "KEPT %s: its identity could not be measured before entry "
            "withdrawal (%s)" % (display, observed[-1])), False
    if observed == ("absent",) or current != observed:
        return False, (
            "KEPT %s: the component occupant changed after the entry was read"
            % display), False

    try:
        quarantine_component, fd = txn.create_exclusive(
            ".bd-jobs-cleanup-", ".tmp")
    except Exception as exc:
        return False, (
            "COULD NOT prepare identity-bound cleanup for %s: %s"
            % (display, _exception_text(exc))), False
    except BaseException as primary:
        _note_fact(primary,
            "cleanup of %s was interrupted while acquiring quarantine; "
            "quarantine identity is UNKNOWN" % display)
        raise
    quarantine = str(txn.display_path(quarantine_component))
    directory_changed = True
    try:
        created_root = txn.root_receipt("after cleanup quarantine creation")
    except BaseException as exc:
        created_root = None
        receipt_primary = exc
    else:
        receipt_primary = None
    close_result = _settle_assigned_child_fd(
        fd, primary=receipt_primary, context="cleanup quarantine",
        component=quarantine_component)
    if receipt_primary is not None:
        _note_fact(receipt_primary,
            "cleanup source %s and quarantine %s are RETAINED/UNKNOWN"
            % (display, quarantine))
        raise close_result
    if close_result is not None and isinstance(close_result, Exception):
        return False, (
            "COULD NOT close cleanup quarantine for %s: %s; KEPT %s because "
            "its descriptor state is UNKNOWN"
            % (display, close_result, quarantine)), directory_changed
    if close_result is not None:
        _note_fact(close_result,
            "cleanup quarantine close was interrupted; source %s and "
            "quarantine %s are RETAINED/UNKNOWN" % (display, quarantine))
        raise close_result
    if created_root.state != _OBS_PRESENT:
        return False, (
            "ROOT_DETACHED/UNKNOWN after acquiring quarantine %s for %s; "
            "pinned identity %r and both components are RETAINED"
            % (quarantine, display, txn.root_identity)), directory_changed

    try:
        empty_quarantine = _component_identity(txn, quarantine_component)
    except Exception as exc:
        return False, (
            "UNKNOWN: could not prove empty quarantine %s identity before "
            "replacing source %s (%s); both are RETAINED"
            % (quarantine, display, _exception_text(exc))), directory_changed
    except BaseException as primary:
        _note_fact(primary,
            "empty quarantine identity observation was interrupted; source "
            "%s and quarantine %s are RETAINED/UNKNOWN"
            % (display, quarantine))
        raise
    if (len(empty_quarantine) != 4 or empty_quarantine[0] != "present"
            or empty_quarantine[3] != stat.S_IFREG):
        return False, (
            "UNKNOWN: empty quarantine %s identity is not a proved regular "
            "file before replacing source %s (%r); both are RETAINED"
            % (quarantine, display, empty_quarantine)), directory_changed

    try:
        txn.rename_name(component, quarantine_component)
    except Exception as exc:
        try:
            source_after = _component_identity(txn, component)
            quarantine_after = _component_identity(txn, quarantine_component)
        except Exception as observed_exc:
            return False, (
                "COULD NOT prove quarantine of %s for removal: %s; observing "
                "source and quarantine %s also failed (%s); both are "
                "RETAINED/UNKNOWN"
                % (display, _exception_text(exc), quarantine,
                   _exception_text(observed_exc))), directory_changed
        except BaseException as primary:
            _note_fact(primary,
                "rename failed for source %s and observing quarantine %s was "
                "interrupted; both are RETAINED/UNKNOWN"
                % (display, quarantine))
            raise
        if quarantine_after == empty_quarantine:
            try:
                discarded, discard_note = _unlink_verified(
                    txn, quarantine_component)
            except Exception as cleanup_exc:
                discarded = False
                discard_note = (
                    "cleanup helper failed for %s (%s); RETAINED/UNKNOWN"
                    % (quarantine, _exception_text(cleanup_exc)))
            except BaseException as primary:
                _note_fact(primary,
                    "rename failed for source %s; empty quarantine %s cleanup "
                    "was interrupted and its disposition is UNKNOWN"
                    % (display, quarantine))
                raise
            if discarded and source_after == ("absent",):
                return True, (
                    "%s was already absent after rename failed (%s); %s"
                    % (display, _exception_text(exc), discard_note)
                ), directory_changed
            return False, (
                "COULD NOT quarantine %s for removal: %s; source state %r; %s"
                % (display, _exception_text(exc), source_after, discard_note)
            ), directory_changed
        return False, (
            "COULD NOT prove quarantine of %s for removal: %s; source state "
            "%r and changed quarantine %s are RETAINED/UNKNOWN"
            % (display, _exception_text(exc), source_after, quarantine)
        ), directory_changed
    except BaseException as primary:
        _note_fact(primary,
            "identity-bound rename was interrupted; source %s and quarantine "
            "%s are RETAINED/UNKNOWN" % (display, quarantine))
        raise

    after_rename = txn.root_receipt("after identity-bound quarantine rename")
    if after_rename.state != _OBS_PRESENT:
        return False, (
            "ROOT_DETACHED/UNKNOWN after moving %s to quarantine %s; pinned "
            "identity %r and both components are RETAINED"
            % (display, quarantine, txn.root_identity)), directory_changed

    captured = _component_identity(txn, quarantine_component)
    if captured != observed:
        try:
            txn.link_name(quarantine_component, component)
        except FileExistsError:
            restore_note = (
                "%s already has another occupant; changed bytes retained at %s"
                % (display, quarantine))
        except (OSError, NotImplementedError) as exc:
            restore_note = (
                "changed bytes retained at %s because %s could not be restored: %s"
                % (quarantine, display, exc))
        except Exception as exc:
            restore_note = (
                "changed bytes retained at %s because restore helper for %s "
                "is UNKNOWN: %s"
                % (quarantine, display, _exception_text(exc)))
        except BaseException as primary:
            _note_fact(primary,
                "replacement restore was interrupted; source %s and "
                "quarantine %s are RETAINED/UNKNOWN" % (display, quarantine))
            raise
        else:
            after_link = txn.root_receipt("after replacement restore link")
            if after_link.state != _OBS_PRESENT:
                return False, (
                    "ROOT_DETACHED/UNKNOWN after restoring %s from %s; both "
                    "components are RETAINED" % (display, quarantine)
                ), directory_changed
            try:
                discarded, discard_note = _unlink_verified(
                    txn, quarantine_component)
            except Exception as exc:
                restore_note = (
                    "restored the changed component occupant at %s, but "
                    "quarantine %s cleanup is UNKNOWN: %s"
                    % (display, quarantine, _exception_text(exc)))
            except BaseException as primary:
                _note_fact(primary,
                    "restored source %s but quarantine cleanup at %s was "
                    "interrupted" % (display, quarantine))
                raise
            else:
                restore_note = (
                    "restored the changed component occupant at %s; %s"
                    % (display, discard_note))
        return False, "KEPT %s: %s" % (display, restore_note), directory_changed

    try:
        removed, quarantine_note = _unlink_verified(txn, quarantine_component)
    except Exception as exc:
        return False, (
            "UNKNOWN: captured source %s remains at quarantine %s because "
            "cleanup helper failed (%s)"
            % (display, quarantine, _exception_text(exc))), directory_changed
    except BaseException as primary:
        _note_fact(primary,
            "captured source %s cleanup was interrupted at quarantine %s"
            % (display, quarantine))
        raise
    if removed:
        note = "removed %s through identity-bound quarantine %s" % (
            display, quarantine)
    else:
        note = "UNKNOWN: COULD NOT remove %s: %s" % (
            display, quarantine_note)
    return removed, note, directory_changed


def _cleanup_attempt_identity(path, observed, *, _txn=None, _component=None):
    """Target-side attempt cleanup with the same compare/quarantine contract."""
    try:
        txn, owned = _writer_txn(_txn)
    except Exception as exc:
        return False, (
            "UNKNOWN: could not open pinned registry cleanup for %s (%s); "
            "the captured path is RETAINED" % (path, _exception_text(exc)))
    locked_here = False
    primary = None
    removed = False
    note = "KEPT %s: cleanup did not acquire component authority" % path
    try:
        try:
            component = (_component if _component is not None
                         else txn.component_from_display(path))
        except Exception as exc:
            component = None
            note = "KEPT %s: %s" % (path, _exception_text(exc))
        if component is not None:
            if not txn.locked:
                # Record intent before flock: an after-effect exception still
                # requires the owner to close its descriptor.
                locked_here = True
                txn.lock()
            try:
                removed, note, changed = _unlink_owned_identity(
                    txn, component, observed)
            except Exception as exc:
                removed, changed = False, False
                note = (
                    "UNKNOWN: cleanup helper raised for %s (%s); the captured "
                    "path is RETAINED" % (path, _exception_text(exc)))
            if changed:
                removal_before_durability = removed
                try:
                    txn.fsync()
                    txn.require_attached("after attempt cleanup fsync")
                except Exception as exc:
                    removed = False
                    note = (
                        "%s; cleanup durability for %s is UNKNOWN (%s); "
                        "removal state was %r"
                        % (note, path, _exception_text(exc),
                           removal_before_durability))
            if not removed and "identity" not in note.lower():
                note = "%s; captured identity did not authorize deletion" % note
    except BaseException as exc:
        primary = exc
    finally:
        settled, events = _settle_registry_owner(
            txn, unlock=locked_here, close=owned, primary=primary,
            context="attempt cleanup")
        if primary is not None:
            primary = settled
        elif settled is not None:
            removed = False
            if isinstance(settled, Exception):
                for stage, exc in events:
                    note = "%s; %s is UNKNOWN (%s)" % (
                        note, stage, _exception_text(exc))
            else:
                _note_fact(settled,
                    "attempt cleanup outcome before cancellation: %s" % note)
                primary = settled
    if primary is not None:
        raise primary
    return removed, note


def _forget_or_retain(entry):
    """Keep ``forget`` failures inside its structured cleanup contract."""
    try:
        return forget(entry)
    except Exception as exc:
        final = pathlib.Path(entry.get("_path")
                             or (JOBS_DIR / ("%s.json" % entry["id"])))
        owned = list(entry.get("owned_paths") or [])
        log = entry.get("log")
        kept = [str(final), *[str(path) for path in owned]]
        if log:
            kept.append(str(log))
        return {
            # The helper may have completed any prefix of its cleanup before
            # raising.  Do not fabricate either removal or retention facts.
            "entry_removed": None,
            "entry_absent_durable": None,
            "log_removed": None,
            "cleanup_complete": False,
            "owned_removed": [None for _ in owned],
            "notes": [
                "cleanup helper raised unexpectedly (%s); disposition UNKNOWN: %s"
                % (_exception_text(exc), ", ".join(kept))],
        }


def forget(entry):
    """Remove one exact final and its owned artifacts on one pinned root."""
    owned_paths = list(entry.get("owned_paths") or [])
    log = entry.get("log")
    final_hint = entry.get("_path") or str(
        JOBS_DIR / ("%s.json" % entry.get("id", "<unknown>")))

    def retained(note, entry_removed=False):
        return {
            "entry_removed": entry_removed,
            "entry_absent_durable": False,
            "log_removed": False if log else None,
            "cleanup_complete": False,
            "owned_removed": [False for _ in owned_paths],
            "notes": [note],
        }

    try:
        txn, owned_txn = _writer_txn()
    except Exception as exc:
        return retained(
            "COULD NOT open pinned registry before removing %s: %s"
            % (final_hint, _exception_text(exc)))

    outcome = None
    primary = None
    try:
        txn.lock()

        snapshot_root = getattr(entry, "_registry_root_identity", None)
        if snapshot_root is not None and snapshot_root != txn.root_identity:
            outcome = retained(
                "ROOT MISMATCH: loaded entry came from pinned identity %r, "
                "current configured root is %r; RETAINED %s and every artifact "
                "without probing a replacement-root component"
                % (snapshot_root, txn.root_identity, final_hint))

        final_component = None
        if outcome is None:
            snapshot_component = getattr(entry, "_registry_component", None)
            try:
                if snapshot_component is not None:
                    final_component = txn._validate_component(snapshot_component)
                elif entry.get("_path") is not None:
                    final_component = txn.component_from_display(entry["_path"])
                else:
                    final_component = txn._validate_component(
                        "%s.json" % entry["id"])
            except (KeyError, RegistrationError, TypeError) as exc:
                outcome = retained(
                    "COULD NOT bind final %s to one registry component (%s); "
                    "it and every named artifact are RETAINED"
                    % (final_hint, _exception_text(exc)))

        expected = _disk_entry(entry)
        if outcome is None:
            schema_reason = _entry_schema_reason(
                expected, filename=final_component)
            if schema_reason is not None:
                outcome = retained(
                    "COULD NOT authorize removal of %s: supplied entry is "
                    "malformed (%s); everything is RETAINED"
                    % (txn.display_path(final_component), schema_reason))

        receipt = None
        owned_snapshots = []
        log_component = None
        log_snapshot = None
        eligible_log = False
        removed = False
        note = ""
        if outcome is None:
            final_display = str(txn.display_path(final_component))
            receipt = txn.read_entry(final_component)
            if receipt.state == _OBS_ABSENT:
                outcome = retained(
                    "%s was already absent; this call has no cleanup authority "
                    "and did not probe any artifact identity" % final_display)
                for path in owned_paths:
                    outcome["notes"].append(
                        "KEPT %s: only a matching present final can grant "
                        "cleanup authority" % path)
                if log:
                    outcome["notes"].append(
                        "KEPT %s: only a matching present final can grant "
                        "cleanup authority" % log)
            elif receipt.state == _OBS_UNKNOWN:
                outcome = retained(
                    "COULD NOT remove %s: its current bytes are unreadable "
                    "(%s), so they cannot be proven to be this entry"
                    % (final_display, receipt.error))
            elif receipt.entry != expected:
                outcome = retained(
                    "COULD NOT remove %s: the record changed since it was read, "
                    "so the current entry and artifacts are RETAINED"
                    % final_display)
            else:
                for path in owned_paths:
                    try:
                        component = txn.component_from_display(path)
                    except RegistrationError:
                        owned_snapshots.append((path, None, None))
                    else:
                        owned_snapshots.append(
                            (path, component,
                             _component_identity(txn, component)))
                log_owned = entry.get("log_owned")
                if log_owned is None:
                    log_owned = _log_is_a_direct_child_of_the_registry(log)
                if log and log_owned:
                    try:
                        log_component = txn.component_from_display(log)
                    except RegistrationError:
                        log_component = None
                    else:
                        eligible_log = True
                        log_snapshot = _component_identity(txn, log_component)
                removed, note = _unlink_verified(txn, final_component)

        if outcome is None:
            durable = False
            notes = [note]
            if removed:
                try:
                    txn.fsync()
                    txn.require_attached("after final withdrawal fsync")
                    durable = True
                except BaseException as exc:
                    durability_note = (
                        "COULD NOT make the absence of %s durable: %s; every "
                        "artifact it named is KEPT because the entry may return "
                        "after a crash"
                        % (txn.display_path(final_component),
                           _exception_text(exc)))
                    notes.append(durability_note)
                    if not isinstance(exc, Exception):
                        _note_fact(exc, durability_note)
                        raise
            outcome = {
                "entry_removed": removed,
                "entry_absent_durable": durable,
                "log_removed": None,
                "cleanup_complete": removed and durable,
                "owned_removed": [],
                "notes": notes,
            }

            if not removed or not durable:
                for path in owned_paths:
                    outcome["owned_removed"].append(False)
                    outcome["notes"].append(
                        "KEPT %s: the entry still names it or may return" % path)
                if log:
                    outcome["log_removed"] = False
                    outcome["notes"].append(
                        "KEPT %s: the entry still names it or may return" % log)
            else:
                directory_changed = False
                for path, component, observed in owned_snapshots:
                    if component is None:
                        outcome["owned_removed"].append(None)
                        outcome["notes"].append(
                            "KEPT %s: an entry may NAME any path, but this tool "
                            "removes only one lexical child of %s"
                            % (path, JOBS_DIR))
                        continue
                    try:
                        extra_removed, extra_note, changed = (
                            _unlink_owned_identity(txn, component, observed))
                    except Exception as exc:
                        extra_removed, changed = False, False
                        extra_note = (
                            "UNKNOWN: owned-path cleanup helper raised for %s "
                            "(%s); the captured component is RETAINED"
                            % (path, _exception_text(exc)))
                    directory_changed = directory_changed or changed
                    outcome["owned_removed"].append(extra_removed)
                    outcome["cleanup_complete"] = (
                        outcome["cleanup_complete"] and extra_removed)
                    outcome["notes"].append(extra_note)

                if log:
                    if eligible_log:
                        try:
                            log_removed, log_note, changed = (
                                _unlink_owned_identity(
                                    txn, log_component, log_snapshot))
                        except Exception as exc:
                            log_removed, changed = False, False
                            log_note = (
                                "UNKNOWN: owned-log cleanup helper raised for "
                                "%s (%s); the captured log is RETAINED"
                                % (log, _exception_text(exc)))
                        directory_changed = directory_changed or changed
                    else:
                        log_removed, log_note = False, (
                            "KEPT %s: this tool did not create it or it is not "
                            "one lexical registry child, so it is the caller's "
                            "evidence" % log)
                    outcome["log_removed"] = log_removed
                    if eligible_log:
                        outcome["cleanup_complete"] = (
                            outcome["cleanup_complete"] and log_removed)
                    outcome["notes"].append(log_note)

                if directory_changed:
                    try:
                        txn.fsync()
                        txn.require_attached(
                            "after owned-artifact cleanup fsync")
                    except Exception as exc:
                        outcome["cleanup_complete"] = False
                        outcome["notes"].append(
                            "COULD NOT make owned-artifact cleanup durable: %s"
                            % _exception_text(exc))
    except Exception as exc:
        if outcome is None:
            unknown_notes = [
                "cleanup helper raised unexpectedly (%s); disposition "
                "UNKNOWN: %s" % (_exception_text(exc), final_hint)]
            for path in owned_paths:
                unknown_notes.append(
                    "KEPT %s: cleanup disposition is UNKNOWN" % path)
            if log:
                unknown_notes.append(
                    "KEPT %s: cleanup disposition is UNKNOWN" % log)
            outcome = {
                "entry_removed": None,
                "entry_absent_durable": None,
                "log_removed": None,
                "cleanup_complete": False,
                "owned_removed": [None for _ in owned_paths],
                "notes": unknown_notes,
            }
        else:
            outcome["cleanup_complete"] = False
            outcome["notes"].append(
                "cleanup helper raised after partial outcome (%s); remaining "
                "disposition UNKNOWN" % _exception_text(exc))
    except BaseException as exc:
        primary = exc
    finally:
        settled, events = _settle_registry_owner(
            txn, unlock=True, close=owned_txn, primary=primary,
            context="forget cleanup")
        if primary is not None:
            primary = settled
        elif settled is not None:
            if isinstance(settled, Exception) and outcome is not None:
                outcome["cleanup_complete"] = False
                for stage, failure in events:
                    label = ("REGISTRY LOCK RELEASE"
                             if stage == "registry unlock"
                             else "REGISTRY CLOSE")
                    outcome["notes"].append(
                        "%s UNKNOWN: %s"
                        % (label, _exception_text(failure)))
            else:
                if outcome is not None:
                    _note_fact(settled,
                        "forget cleanup outcome before cancellation: %s"
                        % "; ".join(outcome.get("notes", [])))
                primary = settled
    if primary is not None:
        raise primary
    return outcome
# ── verbs ────────────────────────────────────────────────────────────────────

def cmd_list(args):
    rows = load_all()
    live = [e for e in rows if alive(e)]
    dead = [e for e in rows if not alive(e)]
    for e in live:
        # LIVE IS NOT WORKING. The state beside it answers the question an
        # operator is actually asking, and it reports the countable -- seconds
        # since the last write -- never an estimated percentage (section 10).
        state, age = progress(e)
        note = ("%s, no log recorded" % state if age is None
                else "%s, last write %ds ago" % (state, int(age)))
        print("LIVE  %-28s pid=%-7s %s  [%s]  (%s, from %s)"
              % (e["id"], e["pid"], e["purpose"], note, e["started_at"],
                 e["origin"]))
        if e.get("request_id"):
            print("      request-id: %s" % e["request_id"])
        if e.get("log"):
            print("      log: %s" % e["log"])
    for e in dead:
        print("DEAD  %-28s pid=%-7s %s  -- finished, entry is stale"
              % (e["id"], e["pid"], e["purpose"]))
        if e.get("request_id"):
            print("      request-id: %s" % e["request_id"])
    print("%d live, %d stale on %s" % (len(live), len(dead), socket.gethostname()))
    if rows.malformed:
        # ON STDOUT, beside the count it qualifies: a reader that takes the
        # summary line and never sees stderr would otherwise read a partial
        # answer as a complete one.
        print("UNKNOWN: %d of %d registry file(s) unreadable"
              % (len(rows.malformed), len(rows) + len(rows.malformed)))
    return _name_malformed(
        rows, "KEPT for operator adjudication -- these files are the only "
              "evidence of what went wrong, so no verb removes them")


def cmd_orphans(args):
    """pytest processes with NO registry entry -- the shape that caused this.

    Reported, never killed: an unregistered run is far more likely to be the
    operator's than an agent's, and a tool that guesses about which processes
    belong to whom should guess in the direction of leaving them alone.
    """
    rows = load_all()
    # PID ALONE IS NOT AN IDENTITY. A stale record for a recycled pid does not
    # register the live process that now holds that number.
    known = {(e["pid"], e["starttime"]) for e in rows}
    found = []
    ps_argv = ["ps", "-eo", "pid=,comm=,args="]

    def process_table_unknown(kind, detail):
        _name_malformed(
            rows, "UNKNOWN: the registry is also incomplete while the process "
                  "table could not be measured")
        suffix = ": %s" % detail if detail else ""
        print("UNKNOWN: process table %s%s" % (kind, suffix), file=sys.stderr)
        return _EXIT_REGISTRY_UNKNOWN

    try:
        measured = subprocess.run(
            ps_argv, capture_output=True, text=True,
            timeout=_ORPHAN_PS_TIMEOUT_S)
    except subprocess.TimeoutExpired as exc:
        return process_table_unknown(
            "timeout", "no result after %.1fs" % exc.timeout)
    except OSError as exc:
        return process_table_unknown(
            "oserror", "%s: %s" % (type(exc).__name__, exc))
    if measured.returncode != 0:
        return process_table_unknown(
            "nonzero", "exit %d" % measured.returncode)
    ps = measured.stdout
    for line in ps.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        pid, comm, argv = parts
        if not comm.startswith("python") or "-m pytest" not in argv:
            continue
        current_starttime = proc_starttime(int(pid))
        if current_starttime is None:
            continue
        if (int(pid), current_starttime) in known:
            continue
        found.append((pid, argv))
    for pid, argv in found:
        print("ORPHAN pid=%-7s %s" % (pid, argv[:110]))
    # THE COUNT SENTENCE IS A COMPATIBILITY SURFACE, byte for byte:
    # `bd-cut-preflight:612` regexes the number out of it and grades the host on
    # it. It is printed unchanged even when the registry could not be fully
    # read -- the qualification goes to stderr and to the exit code, so the
    # preflight keeps parsing and stops calling a partial answer a pass.
    print("%d unregistered pytest process(es) on %s"
          % (len(found), socket.gethostname()))
    unknown = _name_malformed(
        rows, "UNKNOWN: the registered-pid denominator is incomplete, so a "
              "process listed above may in fact be registered")
    if unknown:
        return unknown
    return 1 if found else 0


def _report_incomplete_forget(entry, outcome):
    """Return True and report when forget() could not finish owned cleanup."""
    if outcome.get("cleanup_complete"):
        return False
    print("REFUSED %s: cleanup is incomplete and retained state remains -- %s"
          % (entry["id"], "; ".join(outcome.get("notes") or ["no detail"])),
          file=sys.stderr)
    return True


def _reap_proc_identity(pid):
    """Return an exact procfs identity used only by identity-bound reaping.

    ``proc_starttime`` remains the registry's compatibility reader.  Reaping a
    group additionally needs the process-group id from the SAME stat record;
    reading it separately would recreate the check/use gap this helper closes.
    """
    try:
        raw = pathlib.Path("/proc", str(pid), "stat").read_text()
    except (FileNotFoundError, ProcessLookupError):
        return ("ABSENT", None, None)
    except (OSError, ValueError) as exc:
        return ("UNKNOWN", None, "%s: %s" % (type(exc).__name__, exc))
    try:
        after = raw[raw.rindex(")") + 1:].split()
        identity = {
            "pid": int(pid),
            "state": after[0],        # field 3
            "pgid": int(after[2]),    # field 5
            "starttime": int(after[19]),  # field 22
        }
    except (ValueError, IndexError) as exc:
        return ("UNKNOWN", None, "malformed stat: %s" % exc)
    return ("PRESENT", identity, None)


def _reap_group_census(pgid):
    """Measure every current member of ``pgid`` or return named UNKNOWN.

    The population is every numeric procfs row, not descendants guessed from
    the registered leader.  A double-forked member remains in its process group
    after reparenting and the old numeric ``killpg`` reached it; silently
    shrinking that denominator would recreate the orphan defect from row 88.
    """
    try:
        proc_rows = sorted(
            (item for item in pathlib.Path("/proc").iterdir()
             if item.name.isdigit()),
            key=lambda item: int(item.name))
    except OSError as exc:
        return (None, "procfs census unavailable: %s: %s"
                % (type(exc).__name__, exc))

    members = []
    measured = 0
    for item in proc_rows:
        state, identity, detail = _reap_proc_identity(int(item.name))
        if state == "ABSENT":
            # Normal process-table churn: this row cannot be a current member.
            continue
        if state != "PRESENT":
            return (None, "procfs census incomplete at pid %s: %s"
                    % (item.name, detail or state))
        measured += 1
        if identity["pgid"] == pgid:
            members.append(identity)
    if measured == 0:
        return (None, "procfs census measured zero process identities")
    if not members:
        return (None, "procfs census measured zero members of group %s" % pgid)
    return (members, None)


def _finish_reap_handles(result, handles):
    """Close each acquired pidfd once; unavailable settlement is a refusal."""
    close_failures = []
    for pid, fd in reversed(handles):
        try:
            os.close(fd)
        except OSError as exc:
            close_failures.append(
                "pidfd close for pid %s is UNKNOWN: %s: %s"
                % (pid, type(exc).__name__, exc))
    if close_failures:
        detail = "; ".join(result.get("notes", []) + close_failures)
        return {"state": "REFUSED", "notes": [detail]}
    return result


def _identity_bound_reap(entry):
    """Signal one registry entry only through pidfds held since verification.

    For a group leader every member in the complete procfs census receives its
    own handle.  Numeric PID/PGID values are used only to SELECT candidates;
    the final signal always goes through the handle that was revalidated after
    acquisition.  A replacement can therefore be observed, but never killed.
    """
    pid = entry["pid"]
    handles = []
    try:
        root_fd = os.pidfd_open(pid, 0)
    except ProcessLookupError:
        return {"state": "STALE", "notes": ["registered identity is gone"]}
    except (AttributeError, OSError) as exc:
        return {
            "state": "REFUSED",
            "notes": ["pidfd acquisition is UNKNOWN for pid %s: %s: %s"
                      % (pid, type(exc).__name__, exc)],
        }
    handles.append((pid, root_fd))

    current_starttime = proc_starttime(pid)
    if current_starttime is None:
        state, current, detail = _reap_proc_identity(pid)
        if state == "ABSENT":
            return _finish_reap_handles({
                "state": "STALE",
                "notes": ["registered identity exited after pidfd acquisition"],
            }, handles)
        if state != "PRESENT":
            return _finish_reap_handles({
                "state": "REFUSED",
                "notes": ["start-time revalidation is UNKNOWN for pid %s: %s"
                          % (pid, detail or state)],
            }, handles)
        # A second complete read can settle transient procfs churn; only that
        # measured value, never the legacy reader's ambiguous None, proceeds.
        current_starttime = current["starttime"]
    if current_starttime != entry["starttime"]:
        return _finish_reap_handles({
            "state": "STALE",
            "notes": ["pid %s start time changed from %r to %r"
                      % (pid, entry["starttime"], current_starttime)],
        }, handles)

    try:
        pgid = os.getpgid(pid)
    except OSError as exc:
        return _finish_reap_handles({
            "state": "REFUSED",
            "notes": ["process-group identity is UNKNOWN for pid %s: %s: %s"
                      % (pid, type(exc).__name__, exc)],
        }, handles)

    targets = [(pid, root_fd)]
    if pgid == pid:
        members, census_error = _reap_group_census(pgid)
        if census_error:
            return _finish_reap_handles({
                "state": "REFUSED", "notes": [census_error],
            }, handles)
        root_rows = [row for row in members if row["pid"] == pid]
        if (len(root_rows) != 1
                or root_rows[0]["starttime"] != entry["starttime"]):
            return _finish_reap_handles({
                "state": "STALE",
                "notes": ["group leader changed during its procfs census"],
            }, handles)

        for saved in members:
            member_pid = saved["pid"]
            if member_pid == pid:
                continue
            try:
                fd = os.pidfd_open(member_pid, 0)
            except ProcessLookupError:
                continue
            except (AttributeError, OSError) as exc:
                return _finish_reap_handles({
                    "state": "REFUSED",
                    "notes": ["pidfd acquisition is UNKNOWN for group member "
                              "%s: %s: %s"
                              % (member_pid, type(exc).__name__, exc)],
                }, handles)
            handles.append((member_pid, fd))
            state, current, detail = _reap_proc_identity(member_pid)
            if state in ("ABSENT", "PRESENT") and (
                    state == "ABSENT"
                    or current["starttime"] != saved["starttime"]
                    or current["pgid"] != pgid):
                # The handle pins the old member, which has already exited.
                # Never redirect its signal to the new procfs pathname owner.
                continue
            if state != "PRESENT":
                return _finish_reap_handles({
                    "state": "REFUSED",
                    "notes": ["group member %s revalidation is UNKNOWN: %s"
                              % (member_pid, detail or state)],
                }, handles)
            targets.append((member_pid, fd))

        # No numeric lookups occur after this final root revalidation. If the
        # leader exits now, its pidfd signal gets ESRCH; every other handle
        # still names only the exact group member acquired above.
        state, current, detail = _reap_proc_identity(pid)
        if state == "ABSENT" or (state == "PRESENT" and
                                 current["starttime"] != entry["starttime"]):
            return _finish_reap_handles({
                "state": "STALE",
                "notes": ["group leader exited during identity acquisition"],
            }, handles)
        if state != "PRESENT" or current["pgid"] != pgid:
            return _finish_reap_handles({
                "state": "REFUSED",
                "notes": ["group leader final identity is UNKNOWN: %s"
                          % (detail or state)],
            }, handles)

    failures = []
    for target_pid, fd in targets:
        try:
            signal.pidfd_send_signal(fd, signal.SIGKILL)
        except ProcessLookupError:
            # The handle, unlike the PID, proves exactly this target exited.
            continue
        except (AttributeError, OSError) as exc:
            failures.append(
                "pidfd signal for pid %s is UNKNOWN: %s: %s"
                % (target_pid, type(exc).__name__, exc))

    if failures:
        result = {"state": "REFUSED", "notes": failures}
    elif pgid == pid:
        result = {
            "state": "REAPED",
            "scope": "identity-bound process group %s (%d member(s))"
                     % (pgid, len(targets)),
            "notes": [],
        }
    else:
        result = {
            "state": "REAPED",
            "scope": ("identity-bound pid ONLY -- pid %s does not lead its "
                      "group (pgid %s), so any CHILDREN it started may still "
                      "be running; check with `bd-jobs orphans`" % (pid, pgid)),
            "notes": [],
        }
    return _finish_reap_handles(result, handles)


def cmd_reap(args):
    reaped = refused = 0
    rows = load_all()
    # EVERY VALID ENTRY IS STILL ACTED ON. A `raise`-on-malformed reader would
    # be louder and far worse: one torn file on a host would disarm the reaper
    # for every real orphan on it, which is the remedy this tool exists to be.
    for e in rows:
        if args.id and e["id"] != args.id:
            continue

        # THREE OUTCOMES, and collapsing any two of them is a bug. The first
        # version asked `alive(e)` and forgot everything that was not -- which
        # made the refusal below UNREACHABLE, so an entry we could not identify
        # was silently DROPPED while its process kept running. That converts a
        # tracked job into exactly the untracked orphan this tool exists to
        # prevent, and it reported success doing it.
        result = _identity_bound_reap(e)

        if result["state"] == "STALE":
            # The registered process is gone and either nothing or something
            # ELSE holds its pid. Forget the record, never touch the stranger.
            outcome = _forget_or_retain(e)
            if _report_incomplete_forget(e, outcome):
                refused += 1
            else:
                print("stale %s: pid %s belongs to another process now -- entry "
                      "dropped, nothing killed" % (e["id"], e["pid"]),
                      file=sys.stderr)
            continue

        if result["state"] != "REAPED":
            print("REFUSED %s: %s" %
                  (e["id"], "; ".join(result.get("notes") or
                                       ["identity-bound signal unavailable"])),
                  file=sys.stderr)
            refused += 1
            continue
        reaped += 1
        print("reaped %s (%s) -- %s"
              % (e["id"], result["scope"], e["purpose"]))
        outcome = _forget_or_retain(e)
        if _report_incomplete_forget(e, outcome):
            refused += 1
    print("%d reaped, %d refused on %s" % (reaped, refused, socket.gethostname()))
    unknown = _name_malformed(
        rows, "KEPT for operator adjudication -- a file reap cannot read is a "
              "job it cannot account for, and deleting it would hide that")
    # UNKNOWN OUTRANKS THE REFUSAL COUNT, and the refusals are still printed
    # above: 1 says "I read everything and refused something", which is a
    # different and weaker claim than "I could not read part of the registry".
    return unknown or (1 if refused else 0)


# ── the release gate ─────────────────────────────────────────────────────────
#
# LAUNCH-THEN-REGISTER IS THE INCIDENT IN MINIATURE. The local path used to
# Popen the user's command and register it afterwards, so any failure between
# the two left work running with no record -- exactly the orphan this tool
# exists to prevent, manufactured by the tool itself. The remote path already
# gets this right by proving registration is possible before launching.
#
# Locally the order cannot simply be swapped: the pid IS the thing to register,
# and it does not exist until the child does. So what is launched is not the
# user's command but THIS TOOL, in a hidden internal mode: a wrapper that
# starts normally, blocks reading one byte from an inherited descriptor, and
# only then `exec`s the user's argv. `exec` keeps the pid, the start time and
# the process group, so the process that was registered while it could do
# nothing is the very process that runs the work. If the launcher closes its
# end without releasing, the wrapper reads EOF and exits without running any
# user work at all.
#
# NOT preexec_fn, MEASURED: blocking there DEADLOCKS `subprocess.Popen`. The
# parent waits for the child's exec-status handshake before `Popen` returns,
# and the child waits for a release the parent cannot send until it does. The
# first attempt at this gate hung exactly there (`red/green-1040-full.log`).
# A wrapper that has already exec'd has completed that handshake, so the parent
# is free.
#
# AND THE WRAPPER REPORTS READY, which the first wrapper did not (v3.66.1207
# audit). `Popen` returning proves an interpreter was exec'd -- nothing more.
# Python startup, importing this file, or argv dispatch can all fail AFTER that
# and before the gate is ever reached, and the parent would then publish an
# entry and return 0 for a process holding nothing. Reproduced by the auditor
# by pointing the wrapper at /dev/null, a valid EMPTY program: rc 0, a printed
# job id, and a child that had already exited. So there are TWO descriptors: the
# wrapper writes one READY byte on its own channel once it is genuinely waiting,
# and the parent registers nothing until it has read exactly that byte, under a
# bound.

_RELEASE_BYTE = b"G"
_READY_BYTE = b"R"
_READY_TIMEOUT_S = 30.0          # generous: this waits only for interpreter start
_EXEC_HANDOFF_TIMEOUT_S = 5.0    # wait for gate-to-shell handoff, never workload exit
_EXEC_FAILURE_HOLD_S = 5.25
_EXEC_ATTEMPT_BYTE = b"E"
_EXEC_REGISTERED_CHILD_BYTE = b"C"
_EXEC_FAILURE_PREFIX = b"F"
_EXEC_FAILURE_FRAME_MAX_BYTES = 256
_EXEC_STATUS_MAX_BYTES = 4096
_EXEC_PROVED_NOT_DELIVERED = "EXEC_PROVED_NOT_DELIVERED"
_EXEC_DELIVERED = "EXEC_DELIVERED"
_EXEC_UNKNOWN = "EXEC_UNKNOWN"
_TERMINATE_TIMEOUT_S = 10.0      # cleanup must return even if waitpid never does
_REMOTE_CONNECT_TIMEOUT_OPTION = "ConnectTimeout=15"
_SCP_TRANSFER_TIMEOUT_S = 60.0

# ONE TOTAL BUDGET for a whole bd-jobs remote operation, not one per stage.
#
# Every synchronous remote stage already passes ConnectTimeout=15, so "the host
# never answered" is bounded today. What was NOT bounded is a session that
# CONNECTS and then goes silent -- backlog row 217: "an established SSH session
# can wedge the caller indefinitely". Five stages with their own 60s timeouts
# would be a 300s worst case nobody declared; a single monotonic deadline is a
# number an operator can reason about, and adding a sixth stage later cannot
# quietly extend it.
_REMOTE_TOTAL_DEADLINE_S = 180.0

# Held back from the total so the LAST stage can still reap what it started. A
# deadline that leaves nothing for settlement produces exactly the orphan it was
# added to prevent.
_REMOTE_SETTLEMENT_RESERVE_S = 20.0
_ORPHAN_PS_TIMEOUT_S = 10.0
_EXIT_GATE_ABANDONED = 75        # the wrapper's exit when it is never released
_EXIT_REGISTRATION_FAILED = 3    # nothing was published; refusals stay 2
_EXIT_PUBLISHED_NOT_DURABLE = 5  # a record EXISTS and could not be accounted for
_GATE_FLAG = "--internal-gate-exec"

# EVERY DISTINCT STATE GETS ITS OWN CODE. CLAUDE.md A5: when several refusals
# share an exit code, the distinctive one cannot be asserted and mutants escape
# through the overlap -- this tool has four recorded escapes of exactly that
# shape. 2 means the launcher refused and nothing ran; 3 means a launch was
# undone and nothing was published; 5 means a record EXISTS but could not be
# accounted for; and the two below are the two different UNKNOWNs.
_EXIT_REGISTRY_UNKNOWN = 4       # part of the registry could not be read
_EXIT_REMOTE_UNKNOWN = 6         # the transport failed with no target answer
_EXIT_CLOSE_UNKNOWN = 7          # durable/released, but launcher fd state unknown
_EXIT_RELEASE_PROVED_NOT_DELIVERED = 8
_EXIT_RELEASE_UNKNOWN = 9
_EXIT_EXEC_FAILED = 10
_EXIT_EXEC_HANDOFF_UNKNOWN = 11

_RELEASE_PRE = "RELEASE_PRE"
_RELEASE_IN_FLIGHT = "RELEASE_IN_FLIGHT"
_RELEASE_PROVED_NOT_DELIVERED = "RELEASE_PROVED_NOT_DELIVERED"
_RELEASE_UNKNOWN = "RELEASE_UNKNOWN"
_RELEASE_DELIVERED = "RELEASE_DELIVERED"
_READY_PROVED_NOT_DELIVERED = "READY_PROVED_NOT_DELIVERED"
_READY_UNKNOWN = "READY_UNKNOWN"
_READY_DELIVERED = "READY_DELIVERED"


def _write_release_byte_raw(fd):
    """Attempt exactly one nonblocking release byte and classify delivery."""
    try:
        count = os.write(fd, _RELEASE_BYTE)
    except OSError as exc:
        if exc.errno in (errno.EPIPE, errno.EAGAIN, errno.EBADF, errno.EINTR):
            return _RELEASE_PROVED_NOT_DELIVERED, exc
        return _RELEASE_UNKNOWN, exc
    if count == 1:
        return _RELEASE_DELIVERED, None
    return (_RELEASE_UNKNOWN,
            RuntimeError("unclassified one-byte release write return %r" % count))


def _write_ready_byte_raw(fd):
    """Attempt exactly one READY byte with the same receipt discipline."""
    try:
        count = os.write(fd, _READY_BYTE)
    except OSError as exc:
        if exc.errno in (errno.EPIPE, errno.EAGAIN, errno.EBADF, errno.EINTR):
            return _READY_PROVED_NOT_DELIVERED, exc
        return _READY_UNKNOWN, exc
    if count == 1:
        return _READY_DELIVERED, None
    return (_READY_UNKNOWN,
            RuntimeError("unclassified one-byte ready write return %r" % count))


def _encode_exec_failure(stage, exc):
    frame = (_EXEC_FAILURE_PREFIX + json.dumps({
        "errno": getattr(exc, "errno", None),
        "kind": "EXEC_FAILED",
        "stage": stage,
    }, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n")
    if len(frame) > _EXEC_FAILURE_FRAME_MAX_BYTES:
        raise ValueError("exec failure frame exceeds its atomic bound")
    return frame


def _write_exec_failure_frame(fd, frame):
    return os.write(fd, frame)


def _write_exec_attempt_raw(fd):
    """Attempt the one-byte exec receipt without hiding delivery ambiguity."""
    try:
        count = os.write(fd, _EXEC_ATTEMPT_BYTE)
    except OSError as exc:
        if exc.errno in (errno.EPIPE, errno.EAGAIN, errno.EBADF, errno.EINTR):
            return _EXEC_PROVED_NOT_DELIVERED, exc
        return _EXEC_UNKNOWN, exc
    if count == 1:
        return _EXEC_DELIVERED, None
    return (_EXEC_UNKNOWN,
            RuntimeError("unclassified one-byte exec write return %r" % count))


def _write_registered_child_outcome_raw(fd):
    """Report the one registered, pre-exec child outcome to the parent."""
    try:
        count = os.write(fd, _EXEC_REGISTERED_CHILD_BYTE)
    except OSError as exc:
        if exc.errno in (errno.EPIPE, errno.EAGAIN, errno.EBADF, errno.EINTR):
            return _EXEC_PROVED_NOT_DELIVERED, exc
        return _EXEC_UNKNOWN, exc
    if count == 1:
        return _EXEC_DELIVERED, None
    return (_EXEC_UNKNOWN,
            RuntimeError("unclassified registered-child write return %r"
                         % count))


def _hold_exec_status_unknown(exec_fd, primary=None):
    """Prevent an observed failed handoff from closing into the success grammar.

    Exact ``E`` followed by EOF means exec succeeded.  Once Python observes
    any uncertainty after ``E``, this sole writer therefore remains open past
    the parent's deadline.  Interruptions cannot shorten that proof window;
    the first cancellation is returned as a diagnostic after the bounded hold
    so the gate can still terminate with its protocol status 75.
    """
    first_cancel = (primary if primary is not None
                    and not isinstance(primary, Exception) else None)
    ordinary = primary if isinstance(primary, Exception) else None
    deadline = time.monotonic() + _EXEC_FAILURE_HOLD_S
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            time.sleep(remaining)
        except BaseException as exc:
            if not isinstance(exc, Exception):
                if first_cancel is None:
                    first_cancel = exc
                elif exc is not first_cancel:
                    _note_secondary_failure(
                        first_cancel,
                        "secondary cancellation while holding exec status "
                        "UNKNOWN", exc)
            elif ordinary is None:
                ordinary = exc
    try:
        os.close(exec_fd)
    except BaseException as exc:
        if not isinstance(exc, Exception):
            if first_cancel is None:
                first_cancel = exc
            elif exc is not first_cancel:
                _note_secondary_failure(
                    first_cancel,
                    "secondary cancellation while closing exec status", exc)
        elif ordinary is None:
            ordinary = exc
    return first_cancel if first_cancel is not None else ordinary


def _gate_main(argv):
    """The wrapper: `bd-jobs --internal-gate-exec RELEASE_FD READY_FD -- <argv>`.

    Internal and undocumented in --help on purpose: it is one half of `run`,
    not a verb an operator invokes. It runs in the registered pid, and the only
    thing it does before the release is wait.

    ORDER IS THE CONTRACT HERE. Everything that could still fail happens BEFORE
    the ready byte -- argv parsing, descriptor parsing -- so READY means "this
    process is now doing nothing but waiting for you", which is the one fact
    the parent needs before it writes a record that says the job exists.
    """
    if len(argv) < 4:
        print("REFUSED: %s takes three descriptors and a command" % _GATE_FLAG,
              file=sys.stderr)
        return 2
    try:
        read_fd = int(argv[0])
        ready_fd = int(argv[1])
        exec_fd = int(argv[2])
    except ValueError:
        print("REFUSED: %r are not descriptors" % (argv[:3],), file=sys.stderr)
        return 2
    user_argv = list(argv[3:])
    if user_argv and user_argv[0] == "--":
        user_argv = user_argv[1:]
    if not user_argv:
        print("REFUSED: %s was given no command" % _GATE_FLAG, file=sys.stderr)
        return 2
    try:
        os.set_inheritable(exec_fd, False)
    except OSError as exc:
        print("gate: could not protect the exec-status descriptor (%s); "
              "nothing ran" % exc, file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    try:
        ready_state, ready_detail = _write_ready_byte_raw(ready_fd)
    except Exception as exc:
        ready_state, ready_detail = _READY_UNKNOWN, exc
    except BaseException as primary:
        ready_state, ready_detail = _READY_UNKNOWN, primary
    if ready_state == _READY_PROVED_NOT_DELIVERED:
        print("gate: ready was proved not delivered (%s); nothing ran"
              % ready_detail, file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    ready_close_error = None
    try:
        # CLOSED IMMEDIATELY, and the close is half the protocol: the parent
        # proves "exactly one byte" by seeing EOF behind it, and the exec below
        # must not carry a stray descriptor into the user's process.
        os.close(ready_fd)
    except OSError as exc:
        # READY has already been emitted. Continue holding the command until
        # the parent either releases or abandons it; returning here would let
        # the parent accept READY for a wrapper that is no longer gated.
        ready_close_error = exc
    try:
        got = os.read(read_fd, 1)
    except OSError as exc:
        print("gate: release descriptor unreadable (%s); nothing ran" % exc,
              file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    if got != _RELEASE_BYTE:
        # EOF (b"") or a byte nobody sent: no record was published, so there is
        # no work to do. Exit WITHOUT touching the user's command.
        print("gate: never released (no record was published); nothing ran",
              file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    if isinstance(ready_detail, BaseException) and not isinstance(
            ready_detail, Exception):
        _note_fact(
            ready_detail,
            "READY delivery was UNKNOWN; release was later received; "
            "configured shell was not executed")
        raise ready_detail
    release_close_error = None
    try:
        os.close(read_fd)
    except OSError as exc:
        release_close_error = exc
    if release_close_error is not None and ready_close_error is None:
        # RELEASE IS ALREADY DELIVERED, so this is a registered child outcome,
        # not a parent-side launch refusal. Do not leak an uncertain inheritable
        # descriptor into arbitrary user work; the owned log records the exact
        # reason this now-DEAD entry never exec'd.
        outcome_state, outcome_detail = _write_registered_child_outcome_raw(
            exec_fd)
        if outcome_state != _EXEC_DELIVERED:
            _hold_exec_status_unknown(exec_fd, outcome_detail)
            print("gate: release was received, but its descriptor close is "
                  "UNKNOWN (%s); the registered child outcome is also UNKNOWN "
                  "(%s); the user command did not run" % (
                      release_close_error, outcome_detail), file=sys.stderr)
            return _EXIT_GATE_ABANDONED
        print("gate: release was received, but its descriptor close is UNKNOWN "
              "(%s); the user command did not run" % release_close_error,
              file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    if ready_close_error is not None and release_close_error is not None:
        print("gate: ready was delivered and release received, but the ready "
              "descriptor close is UNKNOWN (%s); release descriptor close is "
              "also UNKNOWN (%s); the user command did not run" % (
                  ready_close_error, release_close_error), file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    if ready_close_error is not None:
        # The parent can accept READY only after observing terminal EOF on this
        # pipe. That observation resolves the syscall's ambiguous return: the
        # descriptor really closed, so it is safe to continue after RELEASE.
        print("gate: ready descriptor close reported UNKNOWN (%s), but the "
              "launcher observed a terminal ready channel; continuing after "
              "release" % ready_close_error, file=sys.stderr)
    # One attempt byte followed by CLOEXEC EOF is the bounded conventional
    # gate-to-shell handoff signal. It intentionally says nothing about the
    # asynchronous command interpreted by that shell.
    try:
        attempt_state, attempt_detail = _write_exec_attempt_raw(exec_fd)
    except BaseException as exc:
        # A wrapper/helper may have performed the write before raising.  Only
        # the raw helper's explicit zero-delivery receipt permits early EOF.
        _hold_exec_status_unknown(exec_fd, exc)
        print("gate: could not report the configured-shell exec attempt (%s); "
              "the handoff is UNKNOWN" % exc, file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    if attempt_state == _EXEC_PROVED_NOT_DELIVERED:
        print("gate: exec attempt was proved not delivered (%s); the handoff "
              "is UNKNOWN" % attempt_detail, file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    if attempt_state != _EXEC_DELIVERED:
        _hold_exec_status_unknown(exec_fd, attempt_detail)
        print("gate: exec-attempt delivery is UNKNOWN (%s)" % attempt_detail,
              file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    # execvp, not a child: the pid, start time and process group registered by
    # the launcher must be the ones the work actually runs under.
    try:
        os.execvp(user_argv[0], user_argv)
    except OSError as exc:
        frame_complete = False
        try:
            frame = _encode_exec_failure("execvp", exc)
            frame_complete = _write_exec_failure_frame(exec_fd, frame) == len(frame)
        except BaseException as frame_error:
            _hold_exec_status_unknown(exec_fd, frame_error)
            print("gate: configured-shell failure record is UNKNOWN (%s); "
                  "command did not run" % frame_error, file=sys.stderr)
            return _EXIT_GATE_ABANDONED
        if not frame_complete:
            _hold_exec_status_unknown(exec_fd)
            print("gate: configured-shell failure record was incomplete; "
                  "command did not run", file=sys.stderr)
            return _EXIT_GATE_ABANDONED
        try:
            os.close(exec_fd)
        except OSError:
            pass
        print("gate: configured shell could not be executed: %s (%s); command "
              "did not run" % (user_argv[0], exc), file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    except Exception as exc:
        _hold_exec_status_unknown(exec_fd, exc)
        print("gate: configured-shell exec is UNKNOWN (%s); command did not "
              "run" % exc, file=sys.stderr)
        return _EXIT_GATE_ABANDONED
    except BaseException as primary:
        detail = _hold_exec_status_unknown(exec_fd, primary)
        print("gate: configured-shell exec was interrupted and is UNKNOWN "
              "(%s); command did not run" % _exception_text(detail),
              file=sys.stderr)
        return _EXIT_GATE_ABANDONED


def _proc_ppid(pid):
    """Field 4 of /proc/<pid>/stat, parsed from the LAST ')' for the same
    reason proc_starttime is: field 2 is the comm and may contain spaces."""
    try:
        raw = pathlib.Path("/proc", str(pid), "stat").read_text()
    except (OSError, ValueError):
        return None
    try:
        after = raw[raw.rindex(")") + 1:].split()
        return int(after[1])           # field 4 == index 1 after comm
    except (ValueError, IndexError):
        return None


def _terminate_and_wait(pid, timeout=None):
    """Kill the wrapper's GROUP -- but only when it is proven to be OURS -- and
    WAIT for it, because an unwaited child is a zombie holding the pid, and a
    pid /proc still answers for is a job this tool would still call alive.

    OWNERSHIP IS PROVEN, NOT ASSUMED, and this is the whole point of the check.
    MEASURED while building this transaction: a test whose fake launcher
    reported the LAUNCHER's own pid sent this function into `os.killpg` on our
    own process group, and SIGKILLed the entire pytest run. The cleanup path of
    a tool whose subject is killing the wrong process must not itself kill the
    wrong process. Only a live process whose parent is this one can be a
    wrapper this call created; anything else is a stranger and is left alone.

    Returns a phrase naming the signal and bounded wait outcomes -- including
    refusal or uncertainty, which are operator facts, not silent no-ops.
    """
    ppid = _proc_ppid(pid)
    if ppid != os.getpid():
        return ("NOTHING -- pid %s is not a child of this launcher (its parent "
                "is %r), so it was not this transaction's to kill" % (pid, ppid))
    try:
        pgid = os.getpgid(pid)
    except OSError:
        pgid = None
    if pgid is not None and pgid == pid:
        scope = "process group %s" % pgid
        try:
            os.killpg(pgid, 9)
        except OSError as exc:
            signal_note = "COULD NOT signal %s: %s" % (scope, exc)
        else:
            signal_note = "sent SIGKILL to %s" % scope
    else:
        # Never signal a group this pid did not establish: that would be the
        # LAUNCHER's group -- this shell and everything above it.
        scope = "pid %s only (it does not lead its group)" % pid
        try:
            os.kill(pid, 9)
        except OSError as exc:
            signal_note = "COULD NOT signal %s: %s" % (scope, exc)
        else:
            signal_note = "sent SIGKILL to %s" % scope

    timeout = _TERMINATE_TIMEOUT_S if timeout is None else timeout
    deadline = time.monotonic() + max(0.0, timeout)
    while True:
        try:
            waited, _ = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return "%s; pid %s was already reaped" % (signal_note, pid)
        except OSError as exc:
            return "%s; wait UNKNOWN for pid %s: %s" % (signal_note, pid, exc)
        if waited == pid:
            return "%s; reaped pid %s" % (signal_note, pid)
        if waited not in (0, pid):              # pragma: no cover - defensive
            return ("%s; wait UNKNOWN for pid %s: waitpid returned %s"
                    % (signal_note, pid, waited))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return ("%s; wait UNKNOWN after %.1fs: pid %s was not reaped"
                    % (signal_note, timeout, pid))
        time.sleep(min(0.05, remaining))


def _discard_owned_log(log_path, observed=None, *, _txn=None,
                       _component=None):
    """Remove one owned log only through its pinned registry transaction."""
    if not _log_is_a_direct_child_of_the_registry(log_path):
        return (
            "KEPT its log %s: it is not one lexical direct child of %s, so it "
            "is not this transaction's to remove" % (log_path, JOBS_DIR))
    try:
        txn, owned = _writer_txn(_txn)
    except Exception as exc:
        return (
            "UNKNOWN: could not open pinned cleanup for owned log %s (%s); "
            "the log is RETAINED" % (log_path, _exception_text(exc)))
    primary = None
    try:
        component = (_component if _component is not None
                     else txn.component_from_display(log_path))
        if observed is None:
            observed = _component_identity(txn, component)
        removed, note = _cleanup_attempt_identity(
            log_path, observed, _txn=txn, _component=component)
        return ("removed its log %s" % log_path) if removed else (
            "COULD NOT remove its log -- %s" % note)
    except Exception as exc:
        return (
            "UNKNOWN: owned-log cleanup helper raised for %s (%s); the log is "
            "RETAINED" % (log_path, _exception_text(exc)))
    except BaseException as exc:
        primary = exc
        raise
    finally:
        if owned:
            txn.close(primary=primary)
def _strip_separator(command):
    """argparse.REMAINDER KEEPS THE `--`, and it must never reach a shell.

    MEASURED on this tool's first live run: `bd-jobs run --host X -- sleep 90`
    sent `bash -c "-- sleep 90"`, bash answered `--: invalid option` and exited
    instantly, and the registry then held a correct entry for a process that
    had already died -- `list` said DEAD and everything LOOKED consistent.
    """
    parts = list(command or [])
    return parts[1:] if parts and parts[0] == "--" else parts


def _user_command(command):
    """The exact command STRING the job runs, assembled from argv.

    SHLEX.JOIN, NOT " ".JOIN. Found by this tool's own second live use, one cut
    after the `--` bug: `-- bash -c "a && b"` was re-joined with bare spaces, so
    the shell saw `bash -c a && b`, ran `bash -c a`, and then ran `b` as a
    separate command in the wrong directory. Both of this tool's shipped bugs
    live in this one conversion, so it is a named function with its own tests
    rather than an expression buried in a launcher.
    """
    parts = _strip_separator(command)
    return shlex.join(parts) if parts else ""


def _user_argv(cmd):
    """The command string as the argv a local job is actually executed as."""
    return ["bash", "-c", cmd]


def _gate_argv(release_fd, ready_fd, exec_fd, user_argv):
    """The wrapper's argv: this tool, its three descriptors -- the release channel
    it waits on and the ready channel it reports through -- then, verbatim and
    last, the user's own argv. Its own `--` delimiter is what keeps the two
    apart, so nothing in the user's command can be read as an option of the
    wrapper."""
    return [sys.executable, str(pathlib.Path(__file__).resolve()),
            _GATE_FLAG, str(release_fd), str(ready_fd), str(exec_fd), "--"] + list(user_argv)


class _LaunchAborted(RuntimeError):
    """A local launch being undone. Carries the exit status and the exact
    operator sentence, so no branch invents its own wording or its own code."""

    def __init__(self, status, message):
        self.status = status
        self.message = message
        super().__init__(message)


class _LocalLaunch:
    """ONE transaction, owning every resource a local launch creates.

    THE AUDIT'S THIRD FINDING. The log and the pipes used to be acquired before
    any cleanup boundary existed, so a failure between them escaped as a
    traceback while the earlier resources -- a created log, an open descriptor,
    a live child -- belonged to nobody. A launcher that leaks a log for a job
    that never existed is the same defect as a job with no log, one level up.

    So: nothing is acquired without being recorded here, nothing is released
    that this object did not acquire, and every failure funnels through
    `abort()`, which undoes what exists in the only safe order and returns a
    sentence describing WHAT WAS ACTUALLY DONE -- never what was attempted.
    """

    def __init__(self, purpose, request_id=None, adopt_path=None,
                 attempt_token=None):
        self.registry_txn = _RegistryTxn(
            JOBS_DIR, require_write=True, create=True)
        self.log_component = None
        self.adopt_component = None
        self.purpose = purpose
        self.request_id = request_id
        self.attempt_token = attempt_token
        # A file this transaction ADOPTS: a script the launching host copied in
        # for a delegated job. Owned exactly like the log -- removed if the
        # launch is undone, handed to the entry if it succeeds.
        self.adopt_path = adopt_path
        self.adopt_identity = None
        self.log_path = None
        self.log_identity = None
        self.log_fd = None
        self.release_r = None
        self.release_w = None
        self.ready_r = None
        self.ready_w = None
        self.exec_r = None
        self.exec_w = None
        self.proc = None
        self.user_argv = None
        self.pid = None
        self.entry = None
        self.retained_entry_id = None
        self.released = False
        self.release_phase = _RELEASE_PRE
        self.abort_settled = False
        self.may_signal_child = True
        self.may_delete_artifacts = True
        # Non-fatal facts. They go to stderr BEFORE the id, never instead of it.
        self.notes = []
        self.close_failed = False

    # ── owned descriptors ────────────────────────────────────────────────────

    def _close(self, name):
        """Close one owned descriptor, once, and never let the close itself
        abort the transaction: an fd that cannot be closed is not recoverable
        by trying harder, while skipping the rest of the cleanup would leave a
        live wrapper behind. The failure is REPORTED instead of swallowed."""
        fd = getattr(self, name)
        if fd is None:
            return
        setattr(self, name, None)
        try:
            os.close(fd)
        except BaseException as exc:
            self.close_failed = True
            self.notes.append(
                "UNKNOWN: could not close the %s descriptor (fd %d): %s -- "
                "the transaction continued, but this descriptor's state is "
                "unknown"
                % (name, fd, exc))
            if not isinstance(exc, Exception):
                raise

    def _close_preserving(self, name, primary):
        """Close one descriptor without replacing an already-decided outcome."""
        try:
            self._close(name)
        except BaseException as secondary:
            if secondary is not primary:
                _note_secondary_failure(
                    primary, "secondary cancellation while closing %s" % name,
                    secondary)

    def close_idle(self, primary=None):
        """Close every remaining descriptor, preserving the first cancellation."""
        first = primary
        for name in ("log_fd", "release_r", "ready_w", "ready_r", "release_w",
                     "exec_r", "exec_w"):
            try:
                self._close(name)
            except BaseException as exc:
                if first is None:
                    first = exc
                elif exc is not first:
                    _note_secondary_failure(
                        first, "secondary cancellation while closing %s" % name,
                        exc)
        try:
            self.registry_txn.close(primary=first)
        except Exception as exc:
            if first is not None:
                if exc is not first:
                    _note_secondary_failure(
                        first, "secondary registry transaction close failure",
                        exc)
            else:
                self.close_failed = True
                self.notes.append(
                    "UNKNOWN: registry transaction close failed: %s"
                    % _exception_text(exc))
        except BaseException as exc:
            if first is None:
                first = exc
            elif exc is not first:
                _note_secondary_failure(
                    first, "secondary registry transaction close cancellation",
                    exc)
        if first is not None:
            if (not isinstance(first, Exception)
                    and self.entry is not None
                    and self.release_phase in (
                        _RELEASE_IN_FLIGHT, _RELEASE_UNKNOWN,
                        _RELEASE_DELIVERED)):
                _note_fact(first,
                    "post-release reconciliation was interrupted; exact "
                    "durable entry %s and its log/adopted artifacts are "
                    "RETAINED without signal or deletion"
                    % self.entry["id"])
            raise first

    # ── the steps ────────────────────────────────────────────────────────────

    def open_log(self):
        try:
            self.registry_txn.open()
            if self.adopt_path is not None:
                self.adopt_component = self.registry_txn.component_from_display(
                    self.adopt_path)
                self.adopt_identity = _component_identity(
                    self.registry_txn, self.adopt_component)
            self.log_path, self.log_fd = open_job_log(
                self.purpose, _txn=self.registry_txn)
            self.log_component = self.registry_txn.component_from_display(
                self.log_path)
            self.log_identity = _component_identity(
                self.registry_txn, self.log_component)
        except Exception as exc:
            self.abort(_EXIT_REGISTRATION_FAILED,
                       "could not create a log for %s (%s), so nothing was "
                       "launched" % (self.purpose, _exception_text(exc)))
        except BaseException as primary:
            self.abort(
                reason="could not create a log for %s; nothing was launched"
                % self.purpose, primary=primary)

    def open_channels(self):
        """Both pipes, before anything is launched.

        The RELEASE channel is the launcher's word to the wrapper; the READY
        channel is the wrapper's word back. They are separate objects because
        they carry opposite directions and their EOFs mean different things.
        """
        try:
            self.release_r, self.release_w = os.pipe()
            self.ready_r, self.ready_w = os.pipe()
            self.exec_r, self.exec_w = os.pipe()
            os.set_blocking(self.release_w, False)
        except OSError as exc:
            self.abort(_EXIT_REGISTRATION_FAILED,
                       "could not open the gate channels for %s (%s)"
                       % (self.purpose, exc))

    def spawn(self, user_argv):
        self.user_argv = list(user_argv)
        try:
            self.proc = subprocess.Popen(
                _gate_argv(self.release_r, self.ready_w, self.exec_w, user_argv),
                stdout=self.log_fd, stderr=subprocess.STDOUT,
                start_new_session=True,
                pass_fds=(self.release_r, self.ready_w, self.exec_w))
        except Exception as exc:
            self.abort(_EXIT_REGISTRATION_FAILED,
                       "could not launch %s (%s)" % (self.purpose, exc))
        except BaseException as primary:
            self.abort(
                reason="could not launch %s; it was never released"
                % self.purpose,
                primary=primary)
        self.pid = self.proc.pid
        # THE CHILD-ONLY ENDS GO NOW, deterministically. While the launcher
        # holds ready_w, the wrapper's EOF can never arrive; while it holds
        # release_r, a wrapper that died is indistinguishable from one waiting.
        self._close("release_r")
        self._close("ready_w")
        self._close("exec_w")
        self._close("log_fd")

    def await_exec_handoff(self, timeout=None):
        """Classify the bounded gate-to-configured-shell status protocol."""
        timeout = _EXEC_HANDOFF_TIMEOUT_S if timeout is None else timeout
        deadline = time.monotonic() + timeout
        got = bytearray()
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return self._exec_handoff_unknown(
                    "configured-shell handoff did not reach terminal EOF "
                    "within %.1fs" % timeout)
            try:
                readable, _, _ = select.select([self.exec_r], [], [], remaining)
            except OSError as exc:
                return self._exec_handoff_unknown(
                    "configured-shell status wait failed (%s)" % exc)
            if not readable:                       # pragma: no cover - select
                continue
            try:
                chunk = os.read(self.exec_r, _EXEC_STATUS_MAX_BYTES + 1)
            except OSError as exc:
                return self._exec_handoff_unknown(
                    "configured-shell status read failed (%s)" % exc)
            if chunk == b"":
                break
            got.extend(chunk)
            if len(got) > _EXEC_STATUS_MAX_BYTES:
                return self._exec_handoff_unknown(
                    "configured-shell status exceeded %d bytes"
                    % _EXEC_STATUS_MAX_BYTES)
        self._close("exec_r")
        if bytes(got) == _EXEC_ATTEMPT_BYTE:
            return 0, "configured shell handoff observed"
        raw = bytes(got)
        if raw == _EXEC_REGISTERED_CHILD_BYTE:
            if self.proc is None:
                return self._exec_handoff_unknown(
                    "registered child outcome had no exact child owner")
            try:
                child_status = self.proc.wait(
                    timeout=max(0.0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                return self._exec_handoff_unknown(
                    "registered child outcome did not settle its exact child")
            if child_status != _EXIT_GATE_ABANDONED:
                return self._exec_handoff_unknown(
                    "registered child outcome exited with status %r, expected %r"
                    % (child_status, _EXIT_GATE_ABANDONED))
            return 0, "registered child outcome observed after release"
        prefix = _EXEC_ATTEMPT_BYTE + _EXEC_FAILURE_PREFIX
        failure = raw[len(prefix):] if raw.startswith(prefix) else b""
        if failure.endswith(b"\n") and failure.count(b"\n") == 1:
            try:
                record = json.loads(failure[:-1].decode("utf-8"))
            except (UnicodeError, ValueError):
                record = None
            if (record is not None
                    and set(record) == {"errno", "kind", "stage"}
                    and record.get("kind") == "EXEC_FAILED"
                    and record.get("stage") == "execvp"
                    and (record.get("errno") is None
                         or type(record.get("errno")) is int)):
                executable = (self.user_argv[0] if self.user_argv
                              else "<configured executable>")
                entry_id = (self.entry or {}).get("id", "<entry>")
                return (_EXIT_EXEC_FAILED,
                        "EXEC_FAILED: record %s is durable and RETAINED; "
                        "configured shell %s could not be executed at execvp "
                        "(errno %r); command did not run"
                        % (entry_id, executable, record.get("errno")))
        return self._exec_handoff_unknown(
            "configured-shell status was malformed or incomplete: %r" % raw)

    def _exec_handoff_unknown(self, reason):
        entry_id = (self.entry or {}).get("id") or self.retained_entry_id or "<entry>"
        return (_EXIT_EXEC_HANDOFF_UNKNOWN,
                "EXEC_HANDOFF_UNKNOWN: record %s is durable and RETAINED; "
                "%s; reconcile by id" % (entry_id, reason))

    def await_ready(self, timeout=None):
        """Exactly one READY byte, under a bound, or the launch is undone.

        Reading it is the only proof that the wrapper reached the gate -- that
        it started, loaded this file, parsed its argv, and is now doing nothing
        but waiting. Everything before this point is proof that an interpreter
        exec'd, which is a different and much weaker fact.
        """
        timeout = _READY_TIMEOUT_S if timeout is None else timeout
        deadline = time.monotonic() + timeout
        got = bytearray()
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                if got:
                    self.abort(
                        _EXIT_REGISTRATION_FAILED,
                        "%s reported a ready byte but did not finalize the "
                        "ready channel within %.1fs, so the wrapper's gate "
                        "state is UNKNOWN" % (self.purpose, timeout))
                self.abort(
                    _EXIT_REGISTRATION_FAILED,
                    "%s never reported ready within %.1fs: the wrapper was "
                    "launched but never reached the gate, so nothing was "
                    "holding the command" % (self.purpose, timeout))
            try:
                readable, _, _ = select.select([self.ready_r], [], [], remaining)
            except OSError as exc:
                self.abort(_EXIT_REGISTRATION_FAILED,
                           "could not wait for %s to report ready (%s)"
                           % (self.purpose, exc))
            if not readable:                         # pragma: no cover - select
                continue
            try:
                chunk = os.read(self.ready_r, 2)
            except OSError as exc:
                self.abort(_EXIT_REGISTRATION_FAILED,
                           "could not read %s's ready byte (%s)"
                           % (self.purpose, exc))
            if chunk == b"":
                break
            got.extend(chunk)
            if len(got) > 1:
                self.abort(
                    _EXIT_REGISTRATION_FAILED,
                    "the wrapper for %s sent %r rather than exactly one ready "
                    "byte" % (self.purpose, bytes(got)))
        if not got:
            self.abort(_EXIT_REGISTRATION_FAILED,
                       "the wrapper for %s exited before it reached the gate "
                       "(EOF on the ready channel, exit status %r): it never "
                       "held the command, so nothing may be registered"
                       % (self.purpose, self.proc.poll()))
        if bytes(got) != _READY_BYTE:
            self.abort(_EXIT_REGISTRATION_FAILED,
                       "the wrapper for %s sent %r rather than one ready byte"
                       % (self.purpose, bytes(got)))
        try:
            child_status = self.proc.poll()
        except (OSError, ChildProcessError) as exc:
            self.abort(
                _EXIT_REGISTRATION_FAILED,
                "could not verify that the wrapper for %s remained live after "
                "its ready record (%s)" % (self.purpose, exc))
        if child_status is not None:
            self.abort(
                _EXIT_REGISTRATION_FAILED,
                "the wrapper for %s exited after reporting ready (status %r), "
                "so nothing may be registered" % (
                    self.purpose, child_status))
        self._close("ready_r")

    def publish(self, cmd, origin):
        try:
            publication = register(
                self.pid, self.purpose, cmd, origin=origin,
                log=self.log_path, log_owned=True,
                request_id=self.request_id,
                attempt_token=self.attempt_token,
                owned_paths=[self.adopt_path] if self.adopt_path else None,
                _return_publication=True, _txn=self.registry_txn)
        except PublishedLockUnknown as exc:
            self.entry = exc.entry
            self.retained_entry_id = exc.entry_id
            self.abort(
                _EXIT_PUBLISHED_NOT_DURABLE,
                "%s has durable record %s, but publication lock release is "
                "UNKNOWN; the command was never released and all pinned-root "
                "components are RETAINED (%s)"
                % (self.purpose, exc.entry_id, _exception_text(exc)),
                keep_log=True)
        except PublishedNotDurable as exc:
            # A COMPLETE RECORD EXISTS. Nothing below may delete its log, and
            # the status must not be the one that means "nothing was written".
            self.retained_entry_id = exc.entry_id
            self.abort(_EXIT_PUBLISHED_NOT_DURABLE,
                       "%s was published but not durably (%s), so the command "
                       "was never released" % (
                           self.purpose, _exception_text(exc)),
                       keep_log=True)
        except Exception as exc:
            self.abort(_EXIT_REGISTRATION_FAILED,
                       "%s was NOT registered (%s), so it was never released "
                       "and never ran" % (
                           self.purpose, _exception_text(exc)))
        except BaseException as primary:
            published = getattr(primary, "bd_published_result", None)
            if published is not None:
                self.entry = published.entry
                self.retained_entry_id = published.entry["id"]
                self.abort(
                    reason="%s has a durable retained entry %s; publication "
                    "finalization was interrupted before release"
                    % (self.purpose, published.entry["id"]),
                    keep_log=True, primary=primary)
            self.abort(
                reason="%s was not registered, so it was never released and never ran"
                % self.purpose,
                primary=primary)
        self.entry = publication.entry
        if publication.disposition == "preserved":
            keys = ("pid", "starttime", "log", "log_owned", "cmd",
                    "request_id", "owned_paths", "attempt_token")
            expected = publication.attempted
            adopted = all(
                self.entry.get(key) == expected.get(key) for key in keys)
            if not adopted:
                self.retained_entry_id = self.entry["id"]
                final = self.entry.get("_path") or str(
                    JOBS_DIR / ("%s.json" % self.entry["id"]))
                self.abort(
                    _EXIT_REGISTRATION_FAILED,
                    "prior record %s is RETAINED unchanged at %s for the same "
                    "process but does not adopt this attempt's exact command, "
                    "log, request and script resources; this attempt published "
                    "no record and was not released" % (self.entry["id"], final))
        return self.entry

    def release(self):
        if self.entry is None:
            self.abort(
                _EXIT_REGISTRATION_FAILED,
                "%s could not be released because no durable registry entry "
                "exists" % self.purpose)
        try:
            self.registry_txn.require_attached("before local release")
        except RegistrationError as exc:
            self.retained_entry_id = self.entry["id"]
            known = [
                value for value in (
                    getattr(self.entry, "_registry_component", None),
                    self.log_component, self.adopt_component)
                if value]
            self.abort(
                _EXIT_PUBLISHED_NOT_DURABLE,
                "%s release was withheld: %s; pinned root identity %r; known "
                "components %s are RETAINED"
                % (self.purpose, _exception_text(exc),
                   self.registry_txn.root_identity,
                   ", ".join(known) or "none"),
                keep_log=True)
        # This assignment spends destructive authority BEFORE the syscall.
        # A wrapper may perform the write and then raise, so exception type is
        # never evidence that the byte was not delivered.
        self.release_phase = _RELEASE_IN_FLIGHT
        self.may_signal_child = False
        self.may_delete_artifacts = False
        try:
            state, detail = _write_release_byte_raw(self.release_w)
        except Exception as exc:
            state, detail = _RELEASE_UNKNOWN, exc
        except BaseException as primary:
            self.release_phase = _RELEASE_UNKNOWN
            self.retained_entry_id = self.entry["id"]
            self._close_preserving("release_w", primary)
            _note_fact(
                primary,
                "release delivery is UNKNOWN; exact durable entry %s and "
                "its artifacts are retained" % self.entry["id"])
            raise
        self.release_phase = state
        if state == _RELEASE_PROVED_NOT_DELIVERED:
            # The raw one-byte primitive proved that no reader received a byte.
            # Reacquire pre-release cleanup authority only for this state.
            self.may_signal_child = True
            self.may_delete_artifacts = True
            outcome = _forget_or_retain(self.entry)
            # forget() has now accounted for both paths, whether it removed them
            # or kept them behind a record it could not remove. They are no
            # longer separate resources for abort() to describe a second time.
            self.log_path = None
            self.adopt_path = None
            if not outcome.get("entry_absent_durable"):
                self.retained_entry_id = self.entry["id"]
            self.abort(_EXIT_RELEASE_PROVED_NOT_DELIVERED,
                       "%s release was proved not delivered (%s), so the work "
                       "never started. Entry %s: %s"
                       % (self.purpose, detail, self.entry["id"],
                          "; ".join(outcome["notes"])),
                       keep_log=True)   # forget() already decided the log
        if state == _RELEASE_UNKNOWN:
            self.retained_entry_id = self.entry["id"]
            outcome = _LaunchAborted(
                _EXIT_RELEASE_UNKNOWN,
                "%s release delivery is UNKNOWN (%s); exact durable entry %s "
                "and its artifacts are retained without signal or deletion"
                % (self.purpose, detail, self.entry["id"]))
            self._close_preserving("release_w", outcome)
            raise outcome
        self.released = True
        self._close("release_w")

    # ── undo ─────────────────────────────────────────────────────────────────

    def abort(self, status=None, reason=None, keep_log=False, primary=None):
        done = []
        cancellation = None

        def record_cleanup_failure(label, exc):
            nonlocal cancellation
            if isinstance(exc, Exception):
                done.append("UNKNOWN: %s cleanup raised unexpectedly (%s)"
                            % (label, exc))
            else:
                note = "%s cleanup was interrupted (%s)" % (label, exc)
                done.append("UNKNOWN: " + note)
                if cancellation is None:
                    cancellation = exc
                else:
                    _note_fact(cancellation, note)

        # 1. CLOSE THE GATE FIRST. A waiting wrapper reads EOF and exits by
        #    itself, before any signal, having run no user work.
        for name in ("release_w", "ready_r", "ready_w", "release_r",
                     "log_fd"):
            try:
                self._close(name)
            except BaseException as exc:
                record_cleanup_failure("%s descriptor" % name, exc)
        # 2. The wrapper, if this transaction created one. _terminate_and_wait
        #    proves ownership itself and waits, so no zombie holds the pid.
        if self.pid is not None and self.may_signal_child:
            try:
                done.append(_terminate_and_wait(self.pid))
            except BaseException as exc:
                record_cleanup_failure("child process", exc)
        elif self.pid is not None:
            done.append(
                "KEPT child pid %s: signal authority was already spent"
                % self.pid)
        # 3. The log -- unless a record that names it is being retained.
        if self.log_path is not None:
            if keep_log or not self.may_delete_artifacts:
                done.append("KEPT its log %s, which a retained record names"
                            % self.log_path)
            else:
                try:
                    done.append(_discard_owned_log(
                        self.log_path, observed=self.log_identity,
                        _txn=self.registry_txn,
                        _component=self.log_component))
                except BaseException as exc:
                    record_cleanup_failure("owned log", exc)
        # 4. An adopted file, on the same rule: if a record survives, the record
        #    owns it; otherwise this transaction is the only thing that ever did.
        if self.adopt_path is not None:
            if keep_log or not self.may_delete_artifacts:
                done.append(
                    "KEPT adopted path %s, which a retained record names"
                    % self.adopt_path)
            else:
                try:
                    _removed, note = _cleanup_attempt_identity(
                        self.adopt_path, self.adopt_identity,
                        _txn=self.registry_txn,
                        _component=self.adopt_component)
                    done.append(note)
                except BaseException as exc:
                    record_cleanup_failure("adopted path", exc)
        if cancellation is not None:
            if primary is not None:
                _note_secondary_failure(
                    primary, "secondary cancellation during bd-jobs cleanup",
                    cancellation)
            else:
                done.append(
                    "secondary cancellation during cleanup: %s"
                    % _exception_text(cancellation))
        self.abort_settled = True
        if primary is not None:
            _note_secondary_failure(
                primary, reason,
                RuntimeError("bd-jobs cleanup facts: %s"
                             % ("; ".join(done) or "nothing to undo")))
            raise primary
        if status is None:
            raise AssertionError("abort status is required without a primary")
        raise _LaunchAborted(status, "REFUSED: %s -- %s"
                             % (reason, "; ".join(done) or "nothing to undo"))


def _safe_remote_script_stem(script):
    """Return one bounded ASCII component safe for legacy scp transport."""
    stem = pathlib.Path(script).stem[:24]
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", stem)
    return safe or "script"


def _terminate_owned_popen_group(process, timeout=None):
    """Terminate one proven child-led group under one total cleanup deadline."""
    pid = process.pid
    timeout = _TERMINATE_TIMEOUT_S if timeout is None else timeout
    timeout = max(0.0, timeout)
    deadline = time.monotonic() + timeout

    ppid = _proc_ppid(pid)
    if ppid != os.getpid():
        return (False, "pid %s / pgid UNKNOWN is not this launcher's child "
                "(parent %r)" % (pid, ppid))
    try:
        pgid = os.getpgid(pid)
    except OSError as exc:
        return (False, "pid %s / pgid UNKNOWN could not be identified: %s"
                % (pid, exc))
    if pgid != pid:
        return (False, "pid %s does not lead process group %s" % (pid, pgid))
    try:
        os.killpg(pgid, 9)
    except OSError as exc:
        signal_note = "could not signal process group %s: %s" % (pgid, exc)
    else:
        signal_note = "sent SIGKILL to process group %s" % pgid

    remaining = max(0.0, deadline - time.monotonic())
    try:
        process.communicate(timeout=remaining)
    except subprocess.TimeoutExpired:
        return (False, "%s; pid %s / process group %s was not reaped within "
                "the %.1fs cleanup bound"
                % (signal_note, pid, pgid, timeout))
    except OSError as exc:
        return (False, "%s; wait UNKNOWN for pid %s / process group %s: %s"
                % (signal_note, pid, pgid, exc))

    while True:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            return (True, "%s; reaped pid %s and process group %s is gone"
                    % (signal_note, pid, pgid))
        except OSError as exc:
            if exc.errno == errno.ESRCH:
                return (True, "%s; reaped pid %s and process group %s is gone"
                        % (signal_note, pid, pgid))
            return (False, "%s; process group %s terminal probe UNKNOWN: %s"
                    % (signal_note, pgid, exc))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return (False, "%s; reaped pid %s but process group %s still "
                    "exists after the %.1fs cleanup bound"
                    % (signal_note, pid, pgid, timeout))
        time.sleep(min(0.05, remaining))


class _RemoteDeadline:
    """One monotonic budget shared by every stage of a remote operation.

    CREATED ONCE at the entry point that owns the operation and threaded
    through. A deadline created per stage is the "budget reset" this row names
    as a mutant: it would look like a fix while restoring the unbounded total.
    """

    def __init__(self, total=_REMOTE_TOTAL_DEADLINE_S,
                 reserve=_REMOTE_SETTLEMENT_RESERVE_S):
        self.total = total
        self.reserve = reserve
        self._end = None

    def _start_if_needed(self):
        """Begin the budget at the FIRST REMOTE STAGE, not at construction.

        Two reasons, and the second is the one that matters. First, the budget
        is for remote work, so local setup before the first ssh should not eat
        it. Second, reading the clock in __init__ consumes a tick, and this
        tool's tests drive it with tuned fake clocks -- `iter([0.0, 0.0, 11.0])`
        in test_scp_timeout_with_a_surviving_group_is_unknown_and_names_ownership
        -- so an extra reading silently shifts every later measurement and
        changes what those tests observe. An instrument that perturbs what it
        measures is the defect this tool spends its time catching elsewhere.
        """
        if self._end is None:
            self._end = time.monotonic() + self.total

    def remaining(self):
        self._start_if_needed()
        return self._end - time.monotonic()

    def slice_for_stage(self):
        """What a stage may wait, keeping the settlement reserve intact.

        None when only the reserve is left: a stage that cannot run inside its
        budget must not be STARTED, because starting it and bounding it out
        immediately produces a side effect nobody can describe.
        """
        usable = self.remaining() - self.reserve
        return usable if usable > 0 else None


def _run_remote(argv, deadline, *, phase, retained="", fixed_timeout=None):
    """Run one ssh/scp stage through the sole owned-process transport funnel.

    SSH stages share ``deadline``.  SCP deliberately passes ``deadline=None``
    and ``fixed_timeout=_SCP_TRANSFER_TIMEOUT_S``: its existing 60-second copy
    allowance remains independent of the SSH operation's total budget.  This
    preserves the measured pre-unification contract instead of silently making
    a copy's allowance depend on how long earlier probes took.

    Both budget forms use the same owned Popen, BaseException settlement,
    cancellation preservation, cleanup-proof retention, and 124/125 result
    vocabulary.  ``phase`` keeps the stage-specific operator diagnostics that
    existed before the funnels were unified.

    Returns (CompletedProcess, cleanup_complete, cleanup_note). Exit 124 is a
    bounded-out stage and 125 a transport failure in either budget mode.
    """
    if (deadline is None) == (fixed_timeout is None):
        raise ValueError(
            "remote transport requires exactly one deadline or fixed timeout")
    budget = (fixed_timeout if fixed_timeout is not None
              else deadline.slice_for_stage())
    if budget is None:
        return (subprocess.CompletedProcess(
            argv, 124, "",
            "%s was not started: the %.0fs total remote budget is spent, with "
            "only the %.0fs settlement reserve left"
            % (phase, deadline.total, deadline.reserve)),
            True, "no process was acquired, so nothing needs reaping")

    try:
        process = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            start_new_session=True)
    except OSError as exc:
        return (subprocess.CompletedProcess(
            argv, 125, "", "could not start %s: %s" % (phase, exc)),
            True, ("no scp process was acquired" if phase == "scp"
                   else "no process was acquired"))

    try:
        stdout, stderr = process.communicate(timeout=budget)
    except BaseException as primary:
        primary_text = str(primary)
        try:
            cleanup_complete, cleanup_note = _terminate_owned_popen_group(process)
        except BaseException as cleanup_exc:
            cleanup_complete = False
            cleanup_note = ("pid %s / process group UNKNOWN cleanup raised: %s"
                            % (process.pid, cleanup_exc))

        if not isinstance(primary, Exception):
            if retained:
                if phase == "scp":
                    _note_secondary_failure(
                        primary,
                        "scp remote destination is RETAINED UNKNOWN",
                        RuntimeError(
                            "%s may be partial and was not deleted because "
                            "pathname ownership is not proven after interrupted "
                            "scp" % retained))
                else:
                    _note_secondary_failure(
                        primary, "%s left RETAINED UNKNOWN state" % phase,
                        RuntimeError(
                            "%s is retained because ownership is not proven "
                            "after an interrupted %s" % (retained, phase)))
            if not cleanup_complete:
                _note_secondary_failure(
                    primary, "%s process-group cleanup is UNKNOWN" % phase,
                    RuntimeError(cleanup_note))
            raise

        if isinstance(primary, subprocess.TimeoutExpired):
            if phase == "scp":
                error = "scp timed out after %s seconds" % primary.timeout
            else:
                error = ("%s reached %s but did not answer within its %.0fs "
                         "slice of the %.0fs total remote budget"
                         % (phase,
                            argv[-2] if len(argv) > 1 else "the target",
                            budget, deadline.total))
            returncode = 124
        else:
            error = ("scp communication failed: %s" % primary_text
                     if phase == "scp"
                     else "%s transport failed: %s" % (phase, primary_text))
            returncode = 125

        return (subprocess.CompletedProcess(argv, returncode, "", error),
                cleanup_complete, cleanup_note)

    return (subprocess.CompletedProcess(
        argv, process.returncode, stdout, stderr), True, "")


def cmd_run(args):
    """Launch a command on a host and register it THERE, before returning.

    --script FILE is the option to reach for whenever the work is more than one
    command. MEASURED at v3.66.1044: a four-iteration sweep passed inline as
    `bash -c '...for N in 8 16 32 64...'` crossed argv -> shlex.join -> ssh ->
    the remote shell -> `bash -c`, died on the far side, and produced NO OUTPUT
    AT ALL -- the registry held a correct entry for a job that had already
    failed. A file crosses one layer: it is copied, and its path is the only
    thing quoted. The two `--` bugs in this tool's short history were both at
    this seam.
    """
    explicit_request = getattr(args, "request_id", None)
    if explicit_request is not None:
        reason = _request_id_reason(explicit_request)
        if reason is not None:
            print("REFUSED: request id %r %s -- nothing was copied, acquired "
                  "or launched" % (explicit_request, reason), file=sys.stderr)
            return 2
        request_id = explicit_request
    else:
        try:
            request_id = _new_request_id()
        except OSError as exc:
            print("REFUSED: could not acquire a fresh request id (%s) -- "
                  "nothing was acquired, copied or launched" % exc,
                  file=sys.stderr)
            return 2

    # THE COMMAND ASSEMBLY LIVES IN _strip_separator/_user_command, above, and
    # both of this tool's shipped bugs were in it. Nothing here reimplements
    # them: a launcher that assembles the command a second way is a launcher
    # whose tests measure a string production never sends.
    script = getattr(args, "script", None)
    if script:
        if list(args.command or []) not in ([], ["--"]):
            print("REFUSED: --script and a command are two different jobs. "
                  "Give one.", file=sys.stderr)
            return 2
        local = pathlib.Path(script)
        if not local.is_file():
            print("REFUSED: no script at %s" % local, file=sys.stderr)
            return 2

    parts = _strip_separator(args.command)
    if not parts and not script:
        print("REFUSED: no command given. Use: bd-jobs run --host H --purpose P "
              "-- <command>, or --script FILE", file=sys.stderr)
        return 2
    cmd = _user_command(args.command)
    here = socket.gethostname()

    # --adopt-script IS A CLEANUP CLAIM, SO IT IS VALIDATED LIKE ONE. It is
    # hidden (help=SUPPRESS) because it is half of the delegation protocol, not
    # an operator surface, and it is accepted only for the exact file this
    # launch is about, only inside the registry, and only under the prefix the
    # copier uses. Anything else would make it a general "unlink this for me"
    # option -- which is precisely what `forget()` must never become.
    adopt = getattr(args, "adopt_script", None)
    attempt_token_arg = getattr(args, "attempt_token", None)
    if attempt_token_arg is not None:
        problem = _attempt_token_reason(attempt_token_arg)
        if problem is not None:
            print("REFUSED: attempt token %s -- nothing was acquired or "
                  "launched" % problem, file=sys.stderr)
            return 2
    if (adopt is None) != (attempt_token_arg is None):
        print("REFUSED: --adopt-script and --attempt-token must describe the "
              "same delegated attempt -- nothing was acquired or launched",
              file=sys.stderr)
        return 2
    if adopt is not None:
        adopt = str(adopt)
        problem = None
        if not script:
            problem = "it is only meaningful together with --script"
        elif adopt != str(script):
            problem = "it names a different file from --script"
        elif not _log_is_a_direct_child_of_the_registry(adopt):
            problem = "it is not a direct child of %s" % JOBS_DIR
        elif not os.path.basename(adopt).startswith(_REMOTE_SCRIPT_PREFIX):
            problem = ("it does not carry the %r prefix this tool's own copies "
                       "use" % _REMOTE_SCRIPT_PREFIX)
        if problem:
            print("REFUSED: --adopt-script %s: %s" % (adopt, problem),
                  file=sys.stderr)
            return 2

    if script and args.host in (None, "", here, "local"):
        # A LOCAL --script RUNS THE FILE. One layer, no re-quoting: the path is
        # the only thing that crosses, which is the reason --script exists.
        cmd = _user_command(["bash", str(script)])

    if args.host in (None, "", here, "local"):
        # start_new_session PUTS THE CHILD IN ITS OWN PROCESS GROUP, and reap
        # depends on it. Without it the child shares OUR group, so reap can only
        # ever signal the single registered pid -- which is how a driver shell
        # was reaped while its pytest child kept running and blocked every
        # deploy on two hosts (backlog 88). Establishing the group is the
        # LAUNCHER's job: reap cannot retrofit one onto a process it did not
        # start, and must not guess.
        # DEVNULL UNTIL v3.66.1087, WHICH MEANT A REGISTERED JOB PRODUCED NO
        # OUTPUT ANYWHERE. That is "never filter at capture time" in its
        # strongest form -- the evidence was discarded before it existed, so a
        # job could not be read afterwards and progress() had nothing to
        # measure. The log is opened BEFORE the launch, so a job that cannot be
        # given one never starts (the same order the remote path uses for
        # registration: prove the record can be written, then act).
        # ONE TRANSACTION, in order, each step undoing everything before it if
        # it cannot complete. THE ORDER IS THE INVARIANT: acquire, launch, be
        # told the gate is held, publish durably, and only then release. There
        # is no path on which the user's command runs unrecorded, and none on
        # which a record survives a command that was never released.
        launch = _LocalLaunch(args.purpose,
                              request_id=request_id, adopt_path=adopt,
                              attempt_token=attempt_token_arg)
        status = 0
        message = None
        active_primary = None
        try:
            launch.open_log()
            launch.open_channels()
            launch.spawn(_user_argv(cmd))
            launch.await_ready()
            launch.publish(cmd, getattr(args, "origin", None) or here)
            launch.release()
            handoff_status, handoff_detail = launch.await_exec_handoff()
            if handoff_status:
                active_primary = _LaunchAborted(
                    handoff_status, handoff_detail)
        except _LaunchAborted as aborted:
            active_primary = aborted
        except BaseException as primary:
            # A step that has acquired ownership can be interrupted outside
            # its own ordinary-error funnel.  Close-only settlement would
            # strand a gated wrapper, log, or adopted script.  Run the full
            # state-aware abort first; its authority flags already prohibit
            # signalling or deletion once release delivery may have begun.
            if launch.abort_settled:
                active_primary = primary
            else:
                retained = launch.entry is not None
                if retained:
                    launch.retained_entry_id = launch.entry["id"]
                    reason = (
                        "local launch orchestration was interrupted; exact durable "
                        "entry %s and its artifacts are RETAINED for reconciliation"
                        % launch.entry["id"])
                else:
                    reason = (
                        "local launch orchestration was interrupted before durable "
                        "publication; every acquired pre-release resource was drained")
                try:
                    launch.abort(
                        reason=reason, keep_log=retained, primary=primary)
                except BaseException as reconciled:
                    active_primary = reconciled
        try:
            launch.close_idle(primary=active_primary)
        except _LaunchAborted as aborted:
            status, message = aborted.status, _exception_text(aborted)

        if status == 0 and launch.close_failed:
            status = _EXIT_CLOSE_UNKNOWN
            message = (
                "LAUNCHED BUT CLOSE UNKNOWN: record %s is durable and its "
                "work was released; reconcile that job by id"
                % launch.entry["id"])

        # DIAGNOSTICS BEFORE THE ID, ALWAYS. `bd-sweep-run` reads the job id as
        # the last non-empty line of the MERGED streams, so anything printed
        # after the id -- on either stream -- becomes the id it parses.
        for note in launch.notes:
            print(note, file=sys.stderr)
        if status:
            print(message, file=sys.stderr)
            if status == _EXIT_RELEASE_PROVED_NOT_DELIVERED:
                entry_id = launch.retained_entry_id
                if entry_id is not None:
                    print(entry_id)
            elif status in (
                    _EXIT_PUBLISHED_NOT_DURABLE, _EXIT_CLOSE_UNKNOWN,
                    _EXIT_RELEASE_UNKNOWN, _EXIT_EXEC_FAILED,
                    _EXIT_EXEC_HANDOFF_UNKNOWN):
                # Both statuses prove a complete record exists. Preserve the
                # id-last reconciliation contract even when work was not
                # released because publication durability stayed UNKNOWN.
                entry_id = (launch.entry["id"] if launch.entry is not None
                            else launch.retained_entry_id)
                if entry_id is not None:
                    print(entry_id)
            return status
        # ASYNCHRONOUS BY CONTRACT: 0 means the wrapper proved ready, the record
        # is durable, and the release was delivered. The workload's own status
        # is observable through `list` and its log, never returned here.
        print(launch.entry["id"])
        return 0

    # PREFLIGHT THE TARGET BEFORE LAUNCHING ANYTHING. Measured at v3.66.1040 on
    # the tool's own first live run: the remote command started, then
    # registration failed because bd-jobs was not deployed there yet -- so the
    # job ran with NO RECORD, which is precisely the orphan this tool exists to
    # prevent. The tool manufactured its own subject. Launch second, verify
    # first: an unregisterable host is a refusal, not a launch.
    #
    # RESOLVE THE LABEL ONCE, HERE, and use `target` for every network call
    # below. `args.host` stays the name the operator typed, so the refusals
    # quote what they asked for rather than an address they never mentioned.
    target = _resolve_host(args.host)
    unsafe = _unsafe_target(target)
    if unsafe:
        print("REFUSED: %s -- nothing was copied or launched" % unsafe,
              file=sys.stderr)
        return 2
    try:
        status_nonce = _new_status_nonce()
        attempt_token = _new_attempt_token() if script else None
    except OSError as exc:
        print("REFUSED: could not acquire fresh transport entropy (%s) -- "
              "nothing was copied or launched" % exc, file=sys.stderr)
        return 2
    self_path = _remote_self(args.host)

    # PROBE BEFORE ACQUIRING A REMOTE SCRIPT. The identity and cleanup helpers
    # live in the very tool this checks for; calling either before this probe
    # makes the known "deploy it" refusal unreachable and strands a copy.
    # ONE budget for every remote stage of this run, created HERE because
    # cmd_run owns the whole operation. Creating one per stage would restore the
    # unbounded total while looking like a bound (backlog row 217).
    remote_deadline = _RemoteDeadline()

    probe, _, _ = _run_remote(
        _ssh_argv(target, "test -f %s" % shlex.quote(self_path)),
        remote_deadline, phase="the installed-tool probe")
    if probe.returncode == 124:
        # PRE-EFFECT, so this MAY refuse: nothing has been copied and nothing
        # launched at this point, and that is provable rather than assumed. It
        # is a DIFFERENT fact from 255 below -- reached, then silent -- so it
        # gets its own sentence.
        print("REFUSED: %s answered the connection and then went silent: %s. "
              "Nothing was copied and nothing was launched."
              % (args.host, probe.stderr.strip()), file=sys.stderr)
        return 2
    if probe.returncode == 255:
        print("REFUSED: could not reach %s%s: %s"
              % (args.host,
                 "" if target == args.host else " (%s)" % target,
                 probe.stderr.strip() or "ssh failed with no message"),
              file=sys.stderr)
        return 2
    if probe.returncode != 0:
        print("REFUSED: %s has no %s -- deploy it there first. Launching "
              "without it would leave the job unregistered, which is the "
              "failure this tool exists to prevent."
              % (args.host, self_path), file=sys.stderr)
        return 2

    remote_script = None
    captured_identity = None
    if script:
        # COPY FIRST, LAUNCH SECOND, same rule as the deploy probe below: a
        # script that did not arrive is a refusal, not a job that runs the
        # previous copy of itself.
        #
        # INTO THE TARGET'S REGISTRY DIRECTORY, under a unique non-JSON name.
        # The old destination was `/tmp/bd-jobs-script-<stem>-<pid>.sh`, which
        # nothing ever removed and which no entry could reclaim: it sat outside
        # every owned tree. Inside the registry it is a path the target's own
        # transaction can adopt and `forget()` can collect, and the prefix keeps
        # it out of the `*.json` population `load_all()` reads.
        remote_script = str(JOBS_DIR / ("%s%s-%s.sh" % (
            _REMOTE_SCRIPT_PREFIX, _safe_remote_script_stem(script),
            attempt_token)))
        prepare, _, _ = _run_remote(
            _ssh_argv(
                target, "%s %s" % (
                    shlex.quote(self_path), _PREPARE_REGISTRY_FLAG)),
            remote_deadline, phase="registry preparation")
        if prepare.returncode != 0:
            print("REFUSED: could not prepare %s on %s: %s"
                  % (JOBS_DIR, args.host,
                     prepare.stderr.strip()
                     or "ssh exited %d" % prepare.returncode),
                  file=sys.stderr)
            return 2
        scp_destination = "%s:%s" % (target, remote_script)
        scp, copy_cleanup_complete, copy_cleanup_note = _run_remote([
            "scp", "-q", "-o", "BatchMode=yes", "-o",
            _REMOTE_CONNECT_TIMEOUT_OPTION, "--", str(script),
            scp_destination], None, phase="scp", retained=scp_destination,
            fixed_timeout=_SCP_TRANSFER_TIMEOUT_S)
        if scp.returncode != 0:
            result = "REFUSED" if copy_cleanup_complete else "UNKNOWN"
            cleanup = (("; %s" % copy_cleanup_note)
                       if copy_cleanup_note else "")
            print("%s: could not copy %s to %s: %s%s; RETAINED UNKNOWN %s "
                  "may be partial, and was not deleted because pathname "
                  "ownership is not proven after failed scp"
                  % (result, script, args.host, scp.stderr.strip(), cleanup,
                     remote_script),
                  file=sys.stderr)
            return 2 if copy_cleanup_complete else _EXIT_REMOTE_UNKNOWN
        try:
            captured_identity, identity_note = _capture_remote_copy_identity(
                target, self_path, remote_script, request_id, status_nonce,
                attempt_token, remote_deadline)
        except Exception as exc:
            captured_identity = None
            identity_note = (
                "UNKNOWN: identity helper raised unexpectedly for request %s; "
                "RETAINED %s (%s)\n" % (request_id, remote_script, exc))
        if identity_note:
            sys.stderr.write(identity_note)
        if captured_identity is None:
            print("UNKNOWN: copied script %s for request %s is RETAINED because "
                  "the target did not return one bound captured identity; no "
                  "launch or pathname deletion was attempted"
                  % (remote_script, request_id), file=sys.stderr)
            return _EXIT_REMOTE_UNKNOWN

    # THE TARGET RUNS ITS OWN TRANSACTION. This used to be a second launch
    # protocol -- `nohup ... & P=$!; register --pid $P; echo $P` -- and every
    # part of it was a defect the local path had already fixed: the register
    # status was discarded so the ssh command exited 0 for an unregistered job,
    # `>$$.log` named the ssh shell rather than the job, `register` had no
    # `--log` so the entry recorded none, plain `&` left the job in the ssh
    # shell's process group so `reap` orphaned its children, and `echo $P`
    # printed after the id every consumer reads.
    remote = _remote_launch_command(self_path, args.purpose,
                                    getattr(args, "origin", None) or here,
                                    request_id, status_nonce, parts,
                                    attempt_token=attempt_token,
                                    adopt=remote_script)
    # POST-EFFECT. A timeout here is NOT a refusal: nobody measured whether the
    # job launched, which is exactly the case the `status is None` branch below
    # already describes ("MAY HAVE LAUNCHED and MAY be running unattended").
    # A 124 is routed INTO that branch rather than given a second name, because
    # one fact with two vocabularies reads as two different situations.
    r, _, _ = _run_remote(_ssh_argv(target, remote), remote_deadline,
                          phase="the authenticated launch",
                          retained=remote_script or "")
    status, stderr_text = _parse_target_status(r.stderr, request_id,
                                               status_nonce)

    if status is None:
        # NOBODY MEASURED WHETHER THIS LAUNCHED. ssh's own 255 covers a refused
        # connection AND a connection that dropped after the command was
        # accepted, and those are opposite facts about the target. Saying
        # "nothing ran" here would be a claim about a host we lost contact
        # with, so the honest answer is UNKNOWN plus the request id, which is
        # what makes it reconcilable: `bd-jobs list` on the target shows it.
        sys.stdout.write(r.stdout)
        sys.stderr.write(stderr_text)
        if remote_script:
            print("RETAINED UNKNOWN copied script %s: it may be owned by the "
                  "target entry for request %s or may be unowned; do not "
                  "delete it until reconciliation" % (remote_script, request_id),
                  file=sys.stderr)
        print("UNKNOWN: %s answered with no status marker that uniquely matched "
              "this request (ssh exited %d), so "
              "the job MAY HAVE LAUNCHED and MAY be running unattended. "
              "Reconcile it on the target by request id %s -- `bd-jobs list` "
              "there names it; do not assume nothing ran."
              % (args.host, r.returncode, request_id),
              file=sys.stderr)
        return _EXIT_REMOTE_UNKNOWN

    disposition = None
    if remote_script:
        disposition, clean_stderr = _parse_target_disposition(
            stderr_text, request_id, status_nonce, attempt_token)
        if disposition is None:
            sys.stdout.write(r.stdout)
            sys.stderr.write(stderr_text)
            print("UNKNOWN: target result for request %s did not contain exactly "
                  "one matching disposition immediately before its final status; "
                  "RETAINED %s and granted no cleanup permission"
                  % (request_id, remote_script), file=sys.stderr)
            return _EXIT_REMOTE_UNKNOWN
        stderr_text = clean_stderr

    # An authenticated status: the target ran and answered, so relay its answer
    # rather than inventing one. DIAGNOSTICS FIRST, id last -- consumers read
    # the last non-empty line of the merged stream.
    sys.stderr.write(stderr_text)
    if remote_script and (
            status in (
                0, _EXIT_PUBLISHED_NOT_DURABLE, _EXIT_CLOSE_UNKNOWN,
                _EXIT_RELEASE_UNKNOWN, _EXIT_EXEC_FAILED,
                _EXIT_EXEC_HANDOFF_UNKNOWN)
            or (status == _EXIT_RELEASE_PROVED_NOT_DELIVERED
                and disposition == "ADOPTED")):
        if disposition != "ADOPTED":
            print("UNKNOWN: target status %d did not carry ADOPTED disposition; "
                  "RETAINED %s for request %s"
                  % (status, remote_script, request_id), file=sys.stderr)
            return _EXIT_REMOTE_UNKNOWN
        # A COMPLETE ENTRY EXISTS ON THE TARGET and owns this copy. Removing it
        # here would leave that retained record pointing at a missing script.
        if status != 0:
            print("target RETAINED a record; %s is left for it to collect"
                  % remote_script, file=sys.stderr)
    elif remote_script and (
            status in (2, _EXIT_REGISTRATION_FAILED)
            or (status == _EXIT_RELEASE_PROVED_NOT_DELIVERED
                and disposition == "NOT_ADOPTED")):
        if disposition != "NOT_ADOPTED":
            print("UNKNOWN: refusal status %d had disposition %s; RETAINED %s "
                  "for request %s" % (
                      status, disposition, remote_script, request_id),
                  file=sys.stderr)
            return _EXIT_REMOTE_UNKNOWN
        try:
            removed, cleanup_note = _remove_remote_copy(
                target, self_path, remote_script, captured_identity,
                request_id, status_nonce, attempt_token,
                remote_deadline)
        except Exception as exc:
            removed = False
            cleanup_note = (
                "RETAINED %s for request %s: cleanup helper raised "
                "unexpectedly (%s)" % (remote_script, request_id, exc))
        print("target refused; %s" % cleanup_note, file=sys.stderr)
        if not removed:
            return _EXIT_REMOTE_UNKNOWN
    elif remote_script:
        print("UNKNOWN: authenticated target status %d does not authorize "
              "cleanup; RETAINED %s for request %s"
              % (status, remote_script, request_id), file=sys.stderr)
        if status == _EXIT_RELEASE_PROVED_NOT_DELIVERED:
            return _EXIT_REMOTE_UNKNOWN
    sys.stdout.write(r.stdout)
    return status


_REMOTE_SELF_DEFAULT = "/usr/local/bin/bd-jobs"
_REMOTE_STATUS_SENTINEL = "BD-JOBS-TARGET-STATUS="
_REMOTE_DISPOSITION_SENTINEL = "BD-JOBS-TARGET-DISPOSITION="
_REMOTE_IDENTITY_SENTINEL = "BD-JOBS-TARGET-IDENTITY="
_REMOTE_CLEANUP_SENTINEL = "BD-JOBS-TARGET-CLEANUP="
_REMOTE_SCRIPT_PREFIX = ".bd-jobs-script-"
_ATTEMPT_DISPOSITION_FLAG = "--internal-attempt-disposition"
_ATTEMPT_IDENTITY_FLAG = "--internal-attempt-identity"
_ATTEMPT_CLEANUP_FLAG = "--internal-attempt-cleanup"
_PREPARE_REGISTRY_FLAG = "--internal-prepare-registry"


def _attempt_path_is_valid(path):
    return (_filesystem_path_reason(path) is None
            and _log_is_a_direct_child_of_the_registry(path)
            and os.path.basename(path).startswith(_REMOTE_SCRIPT_PREFIX))


def _attempt_disposition(request_id, attempt_token, path):
    """Read one exact adoption fact under one pinned registry lock."""
    txn = _RegistryTxn(JOBS_DIR, require_write=True, create=True)
    value = "UNKNOWN"
    primary = None
    try:
        txn.open()
        txn.lock()
        rows = _load_all_txn(txn)
        attached = txn.root_receipt("before attempt disposition result")
        matches = [
            entry for entry in rows
            if entry.get("request_id") == request_id
            and entry.get("attempt_token") == attempt_token
            and path in (entry.get("owned_paths") or [])
        ]
        if attached.state != _OBS_PRESENT:
            value = "UNKNOWN"
        elif len(matches) == 1:
            value = "ADOPTED"
        elif len(matches) > 1 or rows.malformed:
            value = "UNKNOWN"
        else:
            value = "NOT_ADOPTED"
    except Exception:
        value = "UNKNOWN"
    except BaseException as exc:
        primary = exc
    finally:
        settled, _events = _settle_registry_owner(
            txn, unlock=True, close=True, primary=primary,
            context="attempt disposition")
        if primary is not None:
            primary = settled
        elif settled is not None:
            if not isinstance(settled, Exception):
                primary = settled
            value = "UNKNOWN"
    if primary is not None:
        raise primary
    return value


def _attempt_disposition_main(argv):
    if len(argv) != 4:
        print("REFUSED: internal attempt disposition expects 4 fields",
              file=sys.stderr)
        return 2
    request_id, nonce, attempt_token, path = argv
    if (_request_id_reason(request_id) is not None
            or _attempt_token_reason(attempt_token) is not None
            or re.fullmatch(r"[0-9a-f]{32}", nonce) is None
            or not _attempt_path_is_valid(path)):
        print("REFUSED: internal attempt disposition binding is invalid",
              file=sys.stderr)
        return 2
    try:
        value = _attempt_disposition(request_id, attempt_token, path)
    except Exception:
        value = "UNKNOWN"
    print("%s%s:%s:%s:%s" % (
        _REMOTE_DISPOSITION_SENTINEL, request_id, nonce, attempt_token, value))
    return 0


def _attempt_identity_main(argv):
    if len(argv) != 4:
        print("REFUSED: internal attempt identity expects 4 fields",
              file=sys.stderr)
        return 2
    request_id, nonce, attempt_token, path = argv
    if (_request_id_reason(request_id) is not None
            or _attempt_token_reason(attempt_token) is not None
            or re.fullmatch(r"[0-9a-f]{32}", nonce) is None
            or not _attempt_path_is_valid(path)):
        print("REFUSED: internal attempt identity binding is invalid",
              file=sys.stderr)
        return 2
    txn = _RegistryTxn(JOBS_DIR, require_write=False, create=False)
    observed = ("unreadable",)
    primary = None
    try:
        opened = txn.open()
        if not opened:
            observed = ("unreadable",)
        else:
            component = txn.component_from_display(path)
            observed = _component_identity(txn, component)
            if txn.root_receipt(
                    "after attempt identity observation").state != _OBS_PRESENT:
                observed = ("unreadable",)
    except Exception:
        observed = ("unreadable",)
    except BaseException as exc:
        primary = exc
    finally:
        settled, _events = _settle_registry_owner(
            txn, unlock=False, close=True, primary=primary,
            context="attempt identity")
        if primary is not None:
            primary = settled
        elif settled is not None:
            if not isinstance(settled, Exception):
                primary = settled
            observed = ("unreadable",)
    if primary is not None:
        raise primary
    if observed[0] != "present":
        value = "UNKNOWN"
    else:
        value = "PRESENT:%d:%d:%d" % observed[1:]
    print("%s%s:%s:%s:%s" % (
        _REMOTE_IDENTITY_SENTINEL, request_id, nonce, attempt_token, value))
    return 0


def _attempt_cleanup_main(argv):
    if len(argv) != 7:
        print("REFUSED: internal attempt cleanup expects 7 fields",
              file=sys.stderr)
        return 2
    request_id, nonce, attempt_token, path, dev, ino, kind = argv
    if (_request_id_reason(request_id) is not None
            or _attempt_token_reason(attempt_token) is not None
            or re.fullmatch(r"[0-9a-f]{32}", nonce) is None
            or not _attempt_path_is_valid(path)):
        print("REFUSED: internal attempt cleanup binding is invalid",
              file=sys.stderr)
        return 2
    try:
        observed = ("present", int(dev), int(ino), int(kind))
    except ValueError:
        print("REFUSED: internal attempt cleanup binding is invalid",
              file=sys.stderr)
        return 2
    try:
        removed, note = _cleanup_attempt_identity(path, observed)
    except Exception as exc:
        removed, note = False, (
            "RETAINED %s: cleanup disposition is UNKNOWN (%s)"
            % (path, _exception_text(exc)))
    print(note, file=sys.stderr)
    print("%s%s:%s:%s:%s" % (
        _REMOTE_CLEANUP_SENTINEL, request_id, nonce, attempt_token,
        "REMOVED" if removed else "RETAINED"))
    return 0


def _parse_bound_terminal(text, sentinel, request_id, nonce, attempt_token,
                          allowed):
    prefix = "%s%s:%s:%s:" % (
        sentinel, request_id, nonce, attempt_token)
    lines = text.splitlines(True)
    candidates = [(index, line) for index, line in enumerate(lines)
                  if line.startswith(prefix)]
    if len(candidates) != 1:
        return None, text
    index, line = candidates[0]
    if index != len(lines) - 1 or not line.endswith("\n"):
        return None, text
    value = line[len(prefix):-1]
    if value not in allowed:
        return None, text
    return value, "".join(lines[:index])


def _parse_target_disposition(text, request_id, nonce, attempt_token):
    return _parse_bound_terminal(
        text, _REMOTE_DISPOSITION_SENTINEL, request_id, nonce, attempt_token,
        {"ADOPTED", "NOT_ADOPTED", "UNKNOWN"})


def _parse_target_identity(text, request_id, nonce, attempt_token):
    prefix = "%s%s:%s:%s:" % (
        _REMOTE_IDENTITY_SENTINEL, request_id, nonce, attempt_token)
    lines = text.splitlines(True)
    candidates = [(i, line) for i, line in enumerate(lines)
                  if line.startswith(prefix)]
    if len(candidates) != 1:
        return None, text
    index, line = candidates[0]
    if index != len(lines) - 1 or not line.endswith("\n"):
        return None, text
    value = line[len(prefix):-1]
    match = re.fullmatch(r"PRESENT:(\d+):(\d+):(\d+)", value)
    if match is None:
        return None, text
    return (("present",) + tuple(int(v) for v in match.groups()),
            "".join(lines[:index]))


def _remote_self(host=None):
    """Where this tool lives ON THE TARGET -- the installed public surface.

    MEASURED at v3.66.1207: `/usr/local/bin/bd-jobs` is a root-owned symlink
    into a per-user staged copy, so `Path(__file__).resolve()` COLLAPSES the
    one uniform path every host shares into a HOME-anchored one -- and from a
    worktree into a `.worktrees/...` path that exists on no target at all. The
    launcher's own location is not evidence about the target's filesystem.

    `BD_JOBS_REMOTE_SELF` is the deterministic override the tests and an
    operator with a non-default install both need. `host` is accepted and
    ignored: the path is uniform, and taking it keeps the one call site honest
    about what it is asking for.
    """
    return os.environ.get("BD_JOBS_REMOTE_SELF") or _REMOTE_SELF_DEFAULT


def _unsafe_target(target):
    """Why this address may not be handed to ssh, or None if it may.

    An address goes into an argv AND into diagnostics. Whitespace, control
    characters and an option-shaped leading dash are not things to quote
    around -- no legitimate host has them, and each is a way to make ssh read
    the operator's target as ssh's own instruction.
    """
    if not target:
        return "the resolved target is empty"
    if target.startswith("-"):
        return "the resolved target is option-shaped (%r)" % target
    for ch in target:
        if ch.isspace() or not ch.isprintable():
            return ("the resolved target contains %r, which no hostname has"
                    % ch)
    return None


def _ssh_argv(target, command, *, config=None):
    """`--` TERMINATES SSH'S OWN OPTIONS. Without it a target that begins with
    a dash is read by ssh as a flag, which is a way to make the launcher run
    something the operator did not ask for.

    ``config`` is the isolated acceptance-harness seam.  Production callers
    leave it unset and retain their byte-for-byte argv; the live OpenSSH test
    passes one exact temporary file so it need not read or modify operator SSH
    configuration or bind a test daemon to port 22.
    """
    if config is not None:
        return ["ssh", "-F", os.fspath(config), "-o", "BatchMode=yes", "-o",
                _REMOTE_CONNECT_TIMEOUT_OPTION, "--", target, command]
    # THE PRODUCTION ARGV STAYS BYTE-IDENTICAL. tests/mutants/
    # v3_66_1207_jobs_registration.json::N12 anchors on exactly this line to
    # prove ssh still terminates its own option parsing, and row357 accepts a
    # new anchor only when it is structural -- this one is not, it is quoted
    # values. Rewriting the line would have forced either a laundered
    # stable-value exception or a census bump, so the seam is a separate
    # branch above and the anchored return is untouched.
    return ["ssh", "-o", "BatchMode=yes", "-o",
            _REMOTE_CONNECT_TIMEOUT_OPTION, "--", target, command]


def _new_request_id():
    """One launch attempt's id. EVIDENCE ONLY -- it is what lets an operator
    ask the target "did this land?" after a transport failure that cannot be
    resolved from this side. It is never an identity the registry decides on."""
    return os.urandom(8).hex()


def _new_status_nonce():
    """A launcher-only 128-bit authenticator for one terminal status record."""
    return os.urandom(16).hex()


def _new_attempt_token():
    """Independent 128-bit identity for one copied-script attempt."""
    return os.urandom(16).hex()


def _remote_launch_command(self_path, purpose, origin, request_id, status_nonce,
                           parts, attempt_token=None,
                           adopt=None):
    """The target runs ITS OWN gated local transaction. One quoting layer.

    `shlex.join` over the TOKEN LIST, not over a pre-joined string: the remote
    shell splits it back into exactly these tokens, the target's own `cmd_run`
    re-joins them with the same `shlex.join`, and the recorded `cmd` is
    byte-identical to the local case. That is what removes the `bash -c`
    nesting this tool has been bitten by twice.

    `--host local` is what buys everything the remote protocol used to get
    wrong on its own: the release gate, `start_new_session` (so `reap` kills a
    GROUP), a target-owned log recorded in the entry, and the id-last contract.

    `rc=$?` BEFORE the sentinel, and `exit "$rc"` last: the status is captured
    before anything can overwrite it, and nothing runs after the exit. The old
    protocol ended in `echo $P`, which is precisely how a failed registration
    became a successful launch with a job id on stdout.
    """
    argv = [self_path, "run", "--host", "local", "--purpose", purpose,
            "--origin", origin, "--request-id", request_id]
    if adopt:
        argv += ["--script", adopt, "--adopt-script", adopt,
                 "--attempt-token", attempt_token]
    argv += ["--"] + list(parts)
    status_format = "%s%s:%s:%%s\\n" % (
        _REMOTE_STATUS_SENTINEL, request_id, status_nonce)
    if adopt:
        disposition = "; %s >&2" % shlex.join([
            self_path, _ATTEMPT_DISPOSITION_FLAG, request_id, status_nonce,
            attempt_token, adopt])
    else:
        disposition = ""
    return ("%s; rc=$?%s; printf %s \"$rc\" >&2; exit \"$rc\""
            % (shlex.join(argv), disposition, shlex.quote(status_format)))


def _parse_target_status(text, expected_request_id, expected_nonce):
    """Pull one request-bound, newline-complete terminal status record.

    ssh exits 255 for its own failures and passes the remote status through
    otherwise, so 255 alone cannot say which happened. The marker can: only the
    target's own shell emits it, so its presence means the command ran and
    answered. Returns (status or None, stderr without the marker line).

    Anything ambiguous stays raw: a duplicate, malformed, truncated or
    non-terminal candidate cannot authorize cleanup of a copied script.
    """
    prefix = "%s%s:%s:" % (
        _REMOTE_STATUS_SENTINEL, expected_request_id, expected_nonce)
    lines = text.splitlines(True)
    candidates = [(index, line) for index, line in enumerate(lines)
                  if line.startswith(prefix)]
    if len(candidates) != 1:
        return None, text
    index, line = candidates[0]
    if index != len(lines) - 1 or not line.endswith("\n"):
        return None, text
    value = line[len(prefix):-1]
    if re.fullmatch(r"(?:0|[1-9]\d{0,2})", value) is None:
        return None, text
    status = int(value)
    if status > 255:
        return None, text
    return status, "".join(lines[:index])


def _capture_remote_copy_identity(target, self_path, remote_script, request_id,
                                  nonce, attempt_token, deadline):
    command = shlex.join([
        self_path, _ATTEMPT_IDENTITY_FLAG, request_id, nonce, attempt_token,
        remote_script])
    try:
        r, _, _ = _run_remote(
            _ssh_argv(target, command), deadline,
            phase="identity capture", retained=remote_script)
        observed, remaining = _parse_target_identity(
            r.stdout, request_id, nonce, attempt_token)
    except Exception as exc:
        return None, (
            "UNKNOWN: identity transport/helper failed for request %s; "
            "RETAINED %s (%s)\n" % (request_id, remote_script, exc))
    raw = remaining + r.stderr
    if r.returncode != 0 or observed is None:
        return None, raw
    return observed, raw


def _remove_remote_copy(target, self_path, remote_script, observed, request_id,
                        nonce, attempt_token, deadline):
    """Ask the target to compare and quarantine; never issue bare pathname rm."""
    if observed is None or observed[0] != "present":
        return False, "RETAINED %s: no captured target identity" % remote_script
    command = shlex.join([
        self_path, _ATTEMPT_CLEANUP_FLAG, request_id, nonce, attempt_token,
        remote_script, str(observed[1]), str(observed[2]), str(observed[3])])
    try:
        r, _, _ = _run_remote(
            _ssh_argv(target, command), deadline,
            phase="identity-bound cleanup", retained=remote_script)
        value, remaining = _parse_bound_terminal(
            r.stdout, _REMOTE_CLEANUP_SENTINEL, request_id, nonce, attempt_token,
            {"REMOVED", "RETAINED"})
    except Exception as exc:
        return False, (
            "RETAINED %s for request %s: cleanup transport/helper is UNKNOWN "
            "(%s)" % (remote_script, request_id, exc))
    detail = (remaining + r.stderr).strip()
    if r.returncode == 0 and value == "REMOVED":
        return True, (detail + "; " if detail else "") + (
            "removed the captured copy at %s through target-side "
            "identity-bound quarantine" % remote_script)
    return False, (detail + "; " if detail else "") + (
        "RETAINED %s: target cleanup identity/durability is UNKNOWN"
        % remote_script)


def _hosts_file():
    return pathlib.Path(os.environ.get("HOSTS_FILE")
                        or pathlib.Path.home() / ".config" / "bd" / "hosts")


def _resolve_host(host):
    """A fleet LABEL -> its address. Anything else passes through unchanged.

    MEASURED at v3.66.1072: `run --host test6` was refused as "test6 has no
    bd-jobs -- deploy it there first" while the file sat there executable on a
    correctly deployed tree. `test6` is the label `scripts/deploy_fleet.sh`
    reads out of this same file; it has no DNS entry, so ssh never reached the
    box. The fleet is addressed by label everywhere else an operator types, and
    this tool was the one place it was not.

    PASS-THROUGH IS THE LOAD-BEARING HALF. An IP, a real DNS name, or a host
    that predates the fleet file must keep working -- turning resolution into a
    whitelist would make every unlisted host unreachable, which is a worse
    defect than the one this closes. A missing or unreadable file degrades to
    pass-through for the same reason.
    """
    path = _hosts_file()
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return host
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 2 and parts[0] == host:
            return parts[1]
    return host


def cmd_register(args):
    """Record an already-running pid, and REFUSE in words rather than a stack.

    Every direct consumer runs this as a subprocess and reads its output:
    `bd-sweep-run` merges stderr into stdout and takes the last non-empty line
    as the job id. An uncaught `RegistrationError` therefore does not merely
    look untidy -- it writes a Python traceback whose last line becomes the
    "job id" that run carries from then on.
    """
    try:
        entry = register(args.pid, args.purpose, args.cmd, origin=args.origin,
                         request_id=getattr(args, "request_id", None))
    except PublishedLockUnknown as exc:
        # register() owns and closes its transaction before this exception
        # reaches the CLI, so no flock can leak into a caller.  The final is
        # nevertheless real and durable: preserve the existing id-last
        # reconciliation contract instead of emitting a traceback or claiming
        # that nothing was published.
        print("PUBLISHED BUT REGISTRY LOCK RELEASE UNKNOWN: %s"
              % _exception_text(exc),
              file=sys.stderr)
        print(exc.entry_id)
        return _EXIT_PUBLISHED_NOT_DURABLE
    except PublishedCloseUnknown as exc:
        print("PUBLISHED BUT REGISTRY LOCK CLOSE UNKNOWN: %s"
              % _exception_text(exc),
              file=sys.stderr)
        print(exc.entry_id)
        return _EXIT_CLOSE_UNKNOWN
    except RegistrationError as exc:
        print("REFUSED: %s" % _exception_text(exc), file=sys.stderr)
        return _EXIT_REGISTRATION_FAILED
    except PublishedNotDurable as exc:
        # THE RECORD EXISTS. Say so first, then print the id last, because the
        # entry is real and a consumer that parses the id is not being misled.
        print("PUBLISHED BUT NOT DURABLE: %s" % _exception_text(exc),
              file=sys.stderr)
        print(exc.entry_id)
        return _EXIT_PUBLISHED_NOT_DURABLE
    print(entry["id"])
    return 0


# ── selftest ─────────────────────────────────────────────────────────────────

def cmd_selftest(args):
    global JOBS_DIR
    import tempfile
    failures = []

    with tempfile.TemporaryDirectory() as tmp:
        JOBS_DIR = pathlib.Path(tmp) / "jobs"

        proc = subprocess.Popen(["sleep", "30"])
        entry = register(proc.pid, "selftest sleeper", "sleep 30")

        if entry.get("starttime") is None:
            failures.append("registration recorded no start time, so the reuse "
                            "guard cannot work")
        if not alive(entry):
            failures.append("a live process was not seen as alive")

        # THE REUSE GUARD, exercised rather than asserted: a WRONG start time
        # must read as dead even though the pid is real and running. Without
        # this the guard could be absent and every other check would still pass.
        tampered = dict(entry, starttime=(entry.get("starttime") or 0) + 1)
        if alive(tampered):
            failures.append("an entry whose start time does not match the "
                            "running process was treated as alive -- a recycled "
                            "pid would be killed")

        if len(load_all()) != 1:
            failures.append("registry did not round-trip exactly one entry")

        proc.kill()
        proc.wait(timeout=10)
        if alive(entry):
            failures.append("a dead process was still reported alive")

        cleanup = _forget_or_retain(entry)
        if not cleanup.get("cleanup_complete"):
            failures.append(
                "forget() cleanup was incomplete: %s"
                % "; ".join(cleanup.get("notes", [])))
        if load_all():
            failures.append("forget() left the entry behind")

        # starttime parsing must survive a comm containing spaces/brackets
        if proc_starttime(os.getpid()) is None:
            failures.append("could not read this process's own start time")

        # --script refusals, exercised rather than described.
        #
        # THROUGH main(), NOT A HAND-BUILT NAMESPACE. `--script` was advertised
        # from v3.66.1047 and argparse never owned the flag, so every operator
        # invocation died with `unrecognized arguments` while this selftest
        # certified the option by constructing the namespace the CLI could not
        # produce. A selftest that cannot reach the interface it certifies is
        # measuring itself.
        missing = os.path.join(tmp, "nope.sh")
        if main(["run", "--host", "somewhere", "--purpose", "p",
                 "--script", missing]) != 2:
            failures.append("a --script that does not exist was not refused")
        real = os.path.join(tmp, "ok.sh")
        with open(real, "w") as fh:
            fh.write("echo hi\n")
        if cmd_run(type("A", (), {"host": "somewhere", "purpose": "p",
                                  "script": real,
                                  "command": ["sleep", "1"]})()) != 2:
            failures.append("--script together with a command was not refused "
                            "-- they are two different jobs")

    if failures:
        for f in failures:
            print("SELFTEST FAIL: %s" % f, file=sys.stderr)
        return 1
    print("SELFTEST PASS: registry round-trip, liveness, reuse guard, cleanup, "
          "--script refusals")
    return 0


def main(argv=None):
    # THE GATE MODE IS DISPATCHED BEFORE ARGPARSE, deliberately: it is half of
    # `run`, not a verb, and argparse would advertise it in --help as though an
    # operator could usefully type it. It is also the one mode whose argv must
    # pass through completely untouched -- it is somebody else's command line.
    raw = list(sys.argv[1:] if argv is None else argv)
    if raw and raw[0] == _GATE_FLAG:
        return _gate_main(raw[1:])
    if raw and raw[0] == _ATTEMPT_DISPOSITION_FLAG:
        return _attempt_disposition_main(raw[1:])
    if raw and raw[0] == _ATTEMPT_IDENTITY_FLAG:
        return _attempt_identity_main(raw[1:])
    if raw and raw[0] == _ATTEMPT_CLEANUP_FLAG:
        return _attempt_cleanup_main(raw[1:])
    if raw and raw[0] == _PREPARE_REGISTRY_FLAG:
        if len(raw) != 1:
            print("REFUSED: registry preparation accepts no arguments",
                  file=sys.stderr)
            return 2
        try:
            _prepare_registry()
        except RegistrationError as exc:
            print("REFUSED: %s" % exc, file=sys.stderr)
            return 2
        return 0

    p = argparse.ArgumentParser(prog="bd-jobs", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="verb")

    sub.add_parser("list", help="what is running here, and what is stale")
    sub.add_parser("orphans", help="pytest with no registry entry (reports, never kills)")

    r = sub.add_parser("reap", help="kill registered jobs, guarding against pid reuse")
    r.add_argument("--id", default=None)

    n = sub.add_parser("run", help="launch a command and register it")
    n.add_argument("--host", default=None)
    n.add_argument("--purpose", required=True)
    # ADVERTISED SINCE v3.66.1047 AND UNREACHABLE UNTIL NOW: cmd_run has read
    # `args.script` all along, argparse never owned the flag, and every
    # operator invocation died with `unrecognized arguments: --script`. Only a
    # main()-level test can see that; a hand-built namespace cannot.
    n.add_argument("--script", default=None,
                   help="run a script FILE rather than an inline command")
    n.add_argument("--origin", default=None,
                   help="the host this launch came from (used by delegation)")
    n.add_argument("--request-id", dest="request_id", default=None,
                   help=argparse.SUPPRESS)
    n.add_argument("--adopt-script", dest="adopt_script", default=None,
                   help=argparse.SUPPRESS)
    n.add_argument("--attempt-token", dest="attempt_token", default=None,
                   help=argparse.SUPPRESS)
    n.add_argument("command", nargs=argparse.REMAINDER)

    g = sub.add_parser("register", help="record an already-running pid")
    g.add_argument("--pid", type=int, required=True)
    g.add_argument("--purpose", required=True)
    g.add_argument("--cmd", default="")
    g.add_argument("--origin", default=None)
    g.add_argument("--request-id", dest="request_id", default=None,
                   help=argparse.SUPPRESS)

    p.add_argument("--selftest", action="store_true")
    args = p.parse_args(argv)

    if args.selftest:
        return cmd_selftest(args)
    return {
        "list": cmd_list, "orphans": cmd_orphans, "reap": cmd_reap,
        "run": cmd_run, "register": cmd_register,
    }.get(args.verb, lambda a: (p.print_help(), 2)[1])(args)


if __name__ == "__main__":
    sys.exit(main())
