#!/usr/bin/env python3
"""bd-treecheck -- is the source tree structurally sound? (the generalized
verify-after-mutation gate).

Parses every .py (ast), loads every .json, and confirms critical files aren't
empty/truncated. Catches the class of corruption that a mutating tool or a bad
manual edit can introduce (e.g. a botched pin rewrite -> SyntaxError) across the
WHOLE tree in one fast pass — before it reaches the slow build_release chain.

Modes:
    bd-treecheck                 source (bulk_downloader/ + tools/) + all .json
    bd-treecheck --tests         also parse tests/  (adds ~1k files)
    bd-treecheck --changed       ONLY files changed vs HEAD (fast inner-loop)
    bd-treecheck --py-only       skip the .json pass (pure syntax gate)
    bd-treecheck --work DIR      (default: the checkout this tool lives in)
Exit 0 if everything parses/loads, 1 on the first structural failure,
2 CANNOT-EVALUATE when --work holds no .py to parse (an unscannable tree is
not a clean one).

v3.66.855 port: --changed used to diff the work tree against the newest
BulkDownloader_v3_66_*.zip in /home/claude or /mnt/user-data/uploads. Both are
retired (CLAUDE.md s7); the baseline is now git, so --changed asks git.
"""
import argparse
import ast
import glob
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402  (after the import block -- os/sys are bound above)


G, R, Y, DIM, BOLD, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[1m", "\033[0m"

CRITICAL = ["bulk_downloader/__init__.py", "bulk_downloader/app.py", "CHANGELOG.md",
            "requirements.txt"]

_CHANGED_DIRS = ("bulk_downloader", "tools", "tests")


def changed_files(work):
    """Files changed vs HEAD, from git. None when `work` is not a usable repo --
    the caller then falls back to the full source pass and SAYS SO.

    Returns tracked modifications (`diff --name-only HEAD`) UNIONED with untracked
    files (`ls-files --others --exclude-standard`). The untracked half is the whole
    point of the mode: a brand-new module is exactly the file most likely to carry
    a SyntaxError, and it is invisible to `git diff` alone. The zip-era predecessor
    got this right by comparing against a member list, so dropping it here would
    have been a silent narrowing of the denominator.
    """
    def _git(*args):
        r = subprocess.run(["git", "-C", work] + list(args),
                           capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            return None
        return [ln for ln in r.stdout.splitlines() if ln.strip()]

    if _git("rev-parse", "--git-dir") is None:
        return None
    tracked = _git("diff", "--name-only", "HEAD", "--") or []
    untracked = _git("ls-files", "--others", "--exclude-standard") or []
    keep = []
    for rel in dict.fromkeys(tracked + untracked):
        if not rel.startswith(_CHANGED_DIRS):
            continue
        if os.path.isfile(os.path.join(work, rel)):   # a DELETED path has nothing to parse
            keep.append(rel)
    return keep



def selftest():
    """Delegates to bd-coretest --only bd-treecheck -- the REAL fault-injection case
    (I-5/C-23). A bespoke smoke selftest would assert "it runs", which is the
    ~92%-are-smoke problem bd-coretest exists to fix. If the harness is absent
    we say so and FAIL: a selftest that cannot verify must not report success."""
    import subprocess as _sp
    ct = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-coretest")
    if not os.path.isfile(ct):
        print("SELFTEST FAIL")
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=ABSENT "
                         "(bd-coretest harness not found)\n")
        return 2
    cp = _sp.run([sys.executable, ct, "--no-cache", "--only", "bd-treecheck"],
                 capture_output=True, text=True, timeout=180)
    sys.stdout.write(cp.stdout)
    ok = cp.returncode == 0
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--tests", action="store_true")
    ap.add_argument("--changed", action="store_true")
    ap.add_argument("--py-only", action="store_true")
    ap.add_argument("--selftest", action="store_true",
                    help="fault-injection selftest (delegates to bd-coretest)")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    w = a.work

    # ---- select the .py set ----
    if a.changed:
        ch = changed_files(w)
        if ch is None:
            print(f"{Y}--work is not a git checkout; falling back to full source{RST}")
            a.changed = False
    if a.changed:
        pyfiles = [os.path.join(w, r) for r in ch if r.endswith(".py")]
        jsonfiles = [os.path.join(w, r) for r in ch if r.endswith(".json")]
        scope = f"{len(ch)} changed file(s)"
    else:
        dirs = ["bulk_downloader", "tools"] + (["tests"] if a.tests else [])
        pyfiles = []
        for d in dirs:
            pyfiles += glob.glob(os.path.join(w, d, "**", "*.py"), recursive=True)
        jsonfiles = glob.glob(os.path.join(w, "*.json")) + \
            glob.glob(os.path.join(w, "bulk_downloader", "**", "*.json"), recursive=True)
        scope = f"{'+'.join(dirs)}" + (" +json" if not a.py_only else "")

        # A full-source pass that found NO .py is not a sound tree -- it is a tree
        # this tool could not see. Before the port it printed "OK 0 .py parsed" and
        # then failed on the four missing CRITICAL files, so the verdict named the
        # symptom ("4 structural failures -- fix before cutting") instead of the
        # cause (--work points at nothing). Refuse instead of minting a verdict.
        #
        # Deliberately NOT applied to --changed: there, an empty set is the real
        # answer ("nothing changed vs HEAD"), and refusing on it would be the
        # over-sensitivity failure -- equally a soundness bug, per CLAUDE.md s0.
        if not pyfiles:
            sys.stderr.write(
                "CANNOT-EVALUATE --work %s: reason=EMPTY (no .py under %s -- "
                "is --work the checkout?)\n" % (w, "/, ".join(dirs) + "/"))
            print(f"{Y}CANNOT-EVALUATE{RST} no .py found under {w}")
            return sec.EXIT_CANNOT_EVALUATE

    print(f"{BOLD}tree health{RST} {DIM}[{scope}]{RST}")
    fails = 0

    # ---- parse .py ----
    py_err = []
    for p in pyfiles:
        try:
            ast.parse(open(p, "rb").read(), filename=p)
        except SyntaxError as e:
            py_err.append((os.path.relpath(p, w), f"L{e.lineno}: {e.msg}"))
    if py_err:
        print(f"  {R}{len(py_err)} .py SYNTAX ERROR(s):{RST}")
        for rel, msg in py_err[:15]:
            print(f"    {R}XX{RST} {rel}  {DIM}{msg}{RST}")
        fails += len(py_err)
    else:
        print(f"  {G}OK{RST} {len(pyfiles)} .py parsed")

    # ---- load .json ----
    if not a.py_only:
        js_err = []
        for p in jsonfiles:
            try:
                json.load(open(p))
            except Exception as e:
                js_err.append((os.path.relpath(p, w), str(e)[:50]))
        if js_err:
            print(f"  {R}{len(js_err)} .json INVALID:{RST}")
            for rel, msg in js_err[:15]:
                print(f"    {R}XX{RST} {rel}  {DIM}{msg}{RST}")
            fails += len(js_err)
        else:
            print(f"  {G}OK{RST} {len(jsonfiles)} .json loaded")

    # ---- critical files non-empty ----
    empt = [c for c in CRITICAL
            if os.path.exists(os.path.join(w, c)) and os.path.getsize(os.path.join(w, c)) == 0]
    miss = [c for c in CRITICAL if not os.path.exists(os.path.join(w, c))]
    if empt or miss:
        for c in empt:
            print(f"  {R}XX{RST} critical file EMPTY: {c}")
        for c in miss:
            print(f"  {R}XX{RST} critical file MISSING: {c}")
        fails += len(empt) + len(miss)
    else:
        print(f"  {G}OK{RST} {len(CRITICAL)} critical files present + non-empty")

    if fails:
        print(f"{R}RESULT: {fails} structural failure(s) -- fix before cutting{RST}")
        return 1
    print(f"{G}RESULT: tree is structurally sound{RST}")
    return 0


sys.exit(main())
