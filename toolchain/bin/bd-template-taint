#!/usr/bin/env python3
"""bd-template-taint -- track secrets through template flows (capture/log/API -> template export/import). The last mile of bd-secret-taint. Advisory, read-only. Usage: bd-template-taint [--work DIR] [--json] [--selftest]"""
import argparse
import ast
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import bdtools_taint as taint

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

SOURCE_ATTRS = ['secrets.get', 'vault.get', 'request.cookies', 'self.token', 'capture', 'cfg.get']
SOURCE_PARAMS = ['secret', 'token', 'api_key', 'cookie', 'cookies', 'credential', 'signed_url', 'capture']
SINK_NAMES = ['write', 'write_text', 'dump', 'dumps', 'save_template', 'export', 'to_json', 'promote_template']
LABEL = 'template-secret'
TAG = 'TEMPLATE-TAINT'


def src_pred(node):
    d = taint.attr_source(node, SOURCE_ATTRS)
    if d:
        return d
    if isinstance(node, ast.Call):
        callee = taint._name_of(node.func) or ""
        # full-attribute match only (secrets.get, not any .get) -- avoids matching
        # every dict .get(); the source must be the specific secret/url accessor.
        if any(callee == s or callee.endswith("." + s) for s in SOURCE_ATTRS):
            return "source " + callee + "()"
    return None


def sink_pred(node):
    if not isinstance(node, ast.Call):
        return None
    nm = taint._name_of(node.func) or ""
    last = nm.rsplit(".", 1)[-1]
    for s in SINK_NAMES:
        if last == s or nm.endswith("." + s):
            return LABEL + " " + nm
    return None


def run(work):
    flows = taint.analyze_tree(work, src_pred, sink_pred,
                               lambda a: a in SOURCE_PARAMS)
    return [f.as_dict() for f in flows]


def selftest():
    ok = True
    real = run(sec.DEFAULT_WORK)
    r2 = run(sec.DEFAULT_WORK)
    det = ([(f["file"], f["source_line"], f["sink_line"]) for f in real]
           == [(f["file"], f["source_line"], f["sink_line"]) for f in r2])
    print(("PASS" if det else "FAIL") + "  real-tree determinism (" + str(len(real)) + " flows x2)")
    ok = ok and det
    code = "def save(token):\n    open('/tmp/tpl', 'w').write(token)\n"
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bulk_downloader")
        os.makedirs(b)
        open(os.path.join(b, "m.py"), "w").write(code)
        flows = run(d)
    good = len(flows) >= 1
    print(("PASS" if good else "FAIL") + "  synthetic flow detected (" + str(len(flows)) + ")")
    ok = ok and good
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    flows = run(a.work)
    if sec.emit({"flows": flows, "summary": {"count": len(flows)}}, as_json=a.json):
        return 0
    if not flows:
        print(G + "no " + LABEL + " flows found (intra-procedural)" + RST)
        return 0
    for f in flows[:40]:
        print("  " + Y + TAG + RST + " " + f["file"] + ":" + f["func"] + "  "
              + DIM + f["source"] + " (L" + str(f["source_line"]) + ") -> "
              + f["sink"] + " (L" + str(f["sink_line"]) + ")" + RST)
    print(DIM + str(len(flows)) + " " + LABEL + " flow(s) [intra-procedural]" + RST)
    return 0


sys.exit(main())
