#!/usr/bin/env python3
"""bd-ui-contract -- define + check expected UI behavior per route component.

Statically checks each route component (frontend/src/routes/*.tsx) for the UI
states a robust screen should handle: loading, error, empty, and disabled. A
component that fetches data but has no error-state or loading-state handling ->
BD-UI-CONTRACT-GAP (the operator sees a blank/hung screen on failure). Reports
per-route which states are handled. Heuristic, read-only.

Usage: bd-ui-contract [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
STATES={"loading":re.compile(r'(?i)isLoading|loading|isPending|<Spinner|Skeleton'),
        "error":re.compile(r'(?i)isError|error|catch\s*\(|onError|<Error|errorMessage'),
        "empty":re.compile(r'(?i)isEmpty|length\s*===\s*0|\.length\s*<\s*1|no results|empty'),
        "disabled":re.compile(r'(?i)disabled=|isDisabled|aria-disabled')}
FETCHES=re.compile(r'(?i)useQuery|fetch\(|useSWR|axios|\.get\(|useDashboardData')

def scan(work):
    rows=[]
    for f in glob.glob(os.path.join(work,"frontend","src","routes","*.tsx")):
        if ".test." in f: continue
        try: txt=open(f,errors="ignore").read()
        # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
        except Exception: continue
        fetches=bool(FETCHES.search(txt))
        handled={s:bool(rx.search(txt)) for s,rx in STATES.items()}
        gaps=[s for s in ("loading","error") if fetches and not handled[s]]
        rows.append({"route":os.path.basename(f)[:-4],"fetches":fetches,"handled":handled,"gaps":gaps})
    return rows

def selftest():
    ok=True
    rows=scan(sec.DEFAULT_WORK)
    print(("PASS" if len(rows)>0 else "FAIL")+"  route components scanned (%d)"%len(rows))
    ok=ok and len(rows)>0
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        r=os.path.join(d,"frontend","src","routes"); os.makedirs(r)
        open(os.path.join(r,"Bad.tsx"),"w").write("const x = useQuery(); return <div>{x.data}</div>")
        open(os.path.join(r,"Good.tsx"),"w").write("const x=useQuery(); if(x.isLoading)return <Spinner/>; if(x.isError)return <Error/>; return <div/>")
        s=scan(d)
    byr={x["route"]:x for x in s}
    good=byr["Bad"]["gaps"] and not byr["Good"]["gaps"]
    print(("PASS" if good else "FAIL")+"  fetch-without-error/loading flagged, complete one clean (Bad gaps=%s)"%byr["Bad"]["gaps"])
    ok=ok and good
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    rows=scan(a.work)
    withgaps=[r for r in rows if r["gaps"]]
    if sec.emit({"routes":rows,"summary":{"total":len(rows),"with_gaps":len(withgaps)}},as_json=a.json): return 0
    print("%d route component(s); %d with UI-contract gaps (fetch but no loading/error state):"%(len(rows),len(withgaps)))
    for r in withgaps[:40]: print("  %sBD-UI-CONTRACT-GAP%s %s: missing %s"%(Y,RST,r["route"],",".join(r["gaps"])))
    if not withgaps: print(G+"all data-fetching routes handle loading + error"+RST)
    return 0

if __name__ == "__main__":
    sys.exit(main())
