#!/usr/bin/env python3
"""bd-artifact-quarantine -- quarantine risky generated artifacts pending scrub.

Given artifacts (WACZ, logs, captures, reports), runs bd-scrub-proof and sorts
them: CLEAR (safe to release) vs QUARANTINE (secrets present -> needs scrub
before share/promote). In --apply mode moves quarantined files into a
quarantine/ subdir with a QUARANTINE_REASON.json; default is a dry-run report.
Reuses bd-scrub-proof. Read-only unless --apply.

Usage: bd-artifact-quarantine FILE... [--apply] [--qdir DIR] [--json]
       bd-artifact-quarantine --selftest
Exit 1 if any artifact quarantined, else 0.
"""
import argparse, json, os, shutil, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_sp=_load_tool("bd-scrub-proof")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def triage(files):
    clear=[]; quarantine=[]
    for f in files:
        if not os.path.exists(f): continue
        p=_sp.prove(f)
        (clear if p.get("safe") else quarantine).append({"file":f,"secrets":p.get("total_secrets",0)})
    return clear, quarantine

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        bad=os.path.join(d,"run.log"); open(bad,"w").write("Bearer abcdef0123456789ABCDEF")
        good=os.path.join(d,"ok.log"); open(good,"w").write("nothing here")
        clear,quar=triage([bad,good])
        cf={os.path.basename(x["file"]) for x in clear}; qf={os.path.basename(x["file"]) for x in quar}
        good1="ok.log" in cf and "run.log" in qf
        print(("PASS" if good1 else "FAIL")+"  triage: dirty quarantined, clean cleared (%s/%s)"%(sorted(cf),sorted(qf)))
        ok=ok and good1
        # apply moves the file
        qdir=os.path.join(d,"quarantine")
        for x in quar:
            os.makedirs(qdir,exist_ok=True); shutil.move(x["file"],os.path.join(qdir,os.path.basename(x["file"])))
        moved=os.path.exists(os.path.join(qdir,"run.log")) and not os.path.exists(bad)
        print(("PASS" if moved else "FAIL")+"  apply moves quarantined file")
        ok=ok and moved
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("files",nargs="*"); ap.add_argument("--apply",action="store_true")
    ap.add_argument("--qdir",default=None)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    if not a.files: print(R+"FILE... required"+RST); return 1
    clear,quar=triage(a.files)
    if a.apply and quar:
        qdir=a.qdir or os.path.join(os.path.dirname(os.path.abspath(quar[0]["file"])),"quarantine")
        os.makedirs(qdir,exist_ok=True)
        for x in quar:
            shutil.move(x["file"],os.path.join(qdir,os.path.basename(x["file"])))
        json.dump({"quarantined":[os.path.basename(x["file"]) for x in quar],"reason":"secrets present, pending scrub"},
                  open(os.path.join(qdir,"QUARANTINE_REASON.json"),"w"),indent=2)
    if sec.emit({"clear":clear,"quarantine":quar,"applied":a.apply},as_json=a.json): return 1 if quar else 0
    print("%d clear, %d quarantined%s"%(len(clear),len(quar)," (moved)" if a.apply else " (dry-run)"))
    for x in quar[:30]: print("  %sQUARANTINE%s %s (%d secrets)"%(R,RST,os.path.basename(x["file"]),x["secrets"]))
    for x in clear[:30]: print("  %sclear%s %s"%(G,RST,os.path.basename(x["file"])))
    return 1 if quar else 0
sys.exit(main())
