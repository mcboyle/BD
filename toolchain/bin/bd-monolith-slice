#!/usr/bin/env python3
"""bd-monolith-slice -- suggest concrete extraction slices.

Lighter-weight companion to bd-decomp-plan: lists the single best next slices to
extract from a module -- the lowest-risk pure helpers and any duplicated logic
blocks -- with exact line ranges, so an operator can extract one slice at a time.
Reuses bd-seam-finder. Read-only.

Usage: bd-monolith-slice [--module bulk_downloader/app.py] [--work DIR] [--n N] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_sf=_load_tool("bd-seam-finder")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def slices(work, module, n):
    path=os.path.join(work,module)
    if not os.path.exists(path):
        return []
    funcs=_sf.analyze(path)
    low=[f for f in funcs if f["tier"]=="LOW" and not f["route"]]
    low.sort(key=lambda f:(f["risk"],-f["size"]))
    out=[]
    for f in low[:n]:
        out.append({"func":f["func"],"lines":"%d-%d"%(f["line"],f["line"]+f["size"]),
                    "size":f["size"],"risk":f["risk"],
                    "why":"pure helper, %d global reads / %d writes"%(f["global_reads"],f["global_writes"])})
    return out

def selftest():
    ok=True
    s=slices(sec.DEFAULT_WORK,"bulk_downloader/app.py",10)
    print(("PASS" if len(s)>0 else "FAIL")+"  slices suggested (%d)"%len(s))
    ok=ok and len(s)>0
    print(("PASS" if all("-" in x["lines"] for x in s) else "FAIL")+"  each slice has a line range")
    ok=ok and all("-" in x["lines"] for x in s)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--module",default="bulk_downloader/app.py"); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--n",type=int,default=10)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    s=slices(a.work,a.module,a.n)
    if sec.emit({"slices":s,"summary":{"count":len(s)}},as_json=a.json): return 0
    print("suggested extraction slices for %s:"%a.module)
    for x in s: print("  %sL%s%s %s (%d lines) %s%s%s"%(G,x["lines"],RST,x["func"],x["size"],DIM,x["why"],RST))
    return 0
sys.exit(main())
