#!/usr/bin/env python3
"""bd-template-bench -- extraction schema parse/memory benchmark suite (row 922).

For each template store (templates/**/*.template.json), measures: (1) parse
latency in milliseconds (JSON load + compiling the network_patterns into
match regexes), (2) peak/current memory allocated during that parse via
tracemalloc, (3) a static regex-backtracking risk scan over every pattern the
template compiles, so a future template author who slips in a nested-
quantifier pattern gets caught before it ever runs against real traffic.

Read-only. Never fetches, never touches a site.

Usage: bd-template-bench [--work DIR] [--json] [--max-ms N] [--selftest]
Exit 1 if any template's parse exceeds --max-ms (default 15) or has a
redos-risk finding, else 0.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import sys
import time
import tracemalloc

DEFAULT_MAX_MS = 15.0

# {name} placeholder inside a network_patterns entry, e.g. .../{resolution}
_PLACEHOLDER = re.compile(r"\{([A-Za-z_][A-Za-z0-9_]*)\}")

# Conservative static ReDoS heuristics (the same shape flagged by safe-regex /
# eslint-plugin-redos): a quantified group that is ITSELF quantified --
# (x+)+, (x*)+, (x+)*, (x*)* -- and trivial alternation-with-overlap under a
# quantifier -- (a|a)+. Both are the textbook exponential-backtracking shapes;
# neither requires actually running the regex to detect.
_NESTED_QUANTIFIER = re.compile(r"\([^()]*[+*]\)[+*]")
_OVERLAPPING_ALTERNATION = re.compile(r"\(([^()|]+)\|\1\)[+*]")


def redos_risk(pattern: str) -> list[str]:
    """Findings for one regex source string. Empty list == no known-risky
    shape detected (NOT a proof of safety -- see module docstring: this is a
    static heuristic, not a backtracking simulator)."""
    findings = []
    if _NESTED_QUANTIFIER.search(pattern):
        findings.append("nested quantifier (quantified group inside a "
                         "quantified group) can backtrack exponentially")
    if _OVERLAPPING_ALTERNATION.search(pattern):
        findings.append("overlapping alternation under a quantifier "
                         "((x|x)+) can backtrack exponentially")
    return findings


def pattern_to_regex(pattern: str) -> str:
    """Turn one network_patterns URL template into a matching regex source.

    Literal text is escaped; each {name} placeholder becomes a single,
    non-nested, possessive-shaped segment match (`[^/]+`) -- one quantifier
    per placeholder, never wrapped in another quantified group, so the
    templates this tool generates are themselves never redos_risk-positive.
    """
    out = []
    pos = 0
    for m in _PLACEHOLDER.finditer(pattern):
        out.append(re.escape(pattern[pos:m.start()]))
        out.append(r"[^/]+")
        pos = m.end()
    out.append(re.escape(pattern[pos:]))
    return "".join(out)


def _iter_selector_strings(obj):
    if isinstance(obj, dict):
        for v in obj.values():
            yield from _iter_selector_strings(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from _iter_selector_strings(v)
    elif isinstance(obj, str):
        yield obj


def benchmark_template(path: str) -> dict:
    """Parse one template file, timing it and tracking its allocations.
    Never raises: an unparseable file reports parse_ms=None and an error."""
    # row922 fixer (E2): tracing is owned by this call -- start/stop are
    # paired in try/finally so an escaping error (or a caller's earlier
    # tracing) never leaks the peak into the next template's numbers.
    was_tracing = tracemalloc.is_tracing()
    if not was_tracing:
        tracemalloc.start()
    else:
        tracemalloc.reset_peak()
    t0 = time.perf_counter()
    findings: list[str] = []
    regex_count = 0
    error = None
    try:
        try:
            with open(path, "r", encoding="utf-8") as fh:
                doc = json.load(fh)
            # row922 fixer (E1): a template is a JSON OBJECT; a valid JSON
            # document with another root (null, 12345, "s", []) or non-string
            # pattern entries is a malformed template, reported not raised.
            if not isinstance(doc, dict):
                raise ValueError(f"template root must be an object, got {type(doc).__name__}")
            patterns = doc.get("network_patterns") or []
            if not isinstance(patterns, list):
                raise ValueError(f"network_patterns must be a list, got {type(patterns).__name__}")
            for raw in patterns:
                if not isinstance(raw, str):
                    raise ValueError(f"network_patterns entry must be a string, got {type(raw).__name__}")
                regex_src = pattern_to_regex(raw)
                re.compile(regex_src)
                regex_count += 1
                findings.extend(f"{raw}: {msg}" for msg in redos_risk(regex_src))
            # selectors are literal CSS/text specs, not compiled as regex here,
            # but a selector string that itself embeds a regex-looking pattern
            # (defensive; none do today) is scanned too so a future template
            # cannot smuggle a risky pattern in through that field instead.
            for s in _iter_selector_strings(doc.get("selectors") or {}):
                findings.extend(f"selector {s!r}: {msg}" for msg in redos_risk(s))
            # row922 fixer (r2 E1): match.url_patterns holds RAW regexes (the
            # product compiles them as-is -- app.py "matched url_patterns");
            # unlike network_patterns they are not re.escape()d, so this is
            # the field where a catastrophic pattern actually ships. Scan the
            # raw string, and compile it so a malformed one is an error too.
            match = doc.get("match") or {}
            if not isinstance(match, dict):
                raise ValueError(f"match must be an object, got {type(match).__name__}")
            url_patterns = match.get("url_patterns") or []
            if not isinstance(url_patterns, list):
                raise ValueError(f"match.url_patterns must be a list, got {type(url_patterns).__name__}")
            for raw in url_patterns:
                if not isinstance(raw, str):
                    raise ValueError(f"match.url_patterns entry must be a string, got {type(raw).__name__}")
                re.compile(raw)
                regex_count += 1
                findings.extend(f"url_pattern {raw!r}: {msg}" for msg in redos_risk(raw))
        except (OSError, ValueError, TypeError, AttributeError, re.error) as e:
            error = f"{type(e).__name__}: {e}"
        parse_ms = (time.perf_counter() - t0) * 1000.0
        current, peak = tracemalloc.get_traced_memory()
    finally:
        if not was_tracing:
            tracemalloc.stop()
    return {
        "file": path,
        "parse_ms": None if error else round(parse_ms, 3),
        "regex_count": regex_count,
        "redos_findings": findings,
        "memory": {"current_bytes": current, "peak_bytes": peak},
        "error": error,
    }


def scan(work: str) -> list[dict]:
    out = []
    for f in sorted(glob.glob(os.path.join(work, "templates", "**",
                                            "*.template.json"), recursive=True)):
        out.append(benchmark_template(f))
    return out


def selftest() -> bool:
    ok = True
    # positive control: a textbook catastrophic-backtracking shape.
    bad = redos_risk(r"(a+)+$")
    ok = ok and bool(bad)
    # negative control: what this tool itself generates for a placeholder.
    safe = redos_risk(pattern_to_regex("https://api.example.com/{id}/watch"))
    ok = ok and not safe
    # a real parse reports a float ms and no error.
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        td = os.path.join(d, "templates", "reviewed")
        os.makedirs(td)
        with open(os.path.join(td, "x.template.json"), "w") as fh:
            json.dump({"selectors": {"a": ".b"},
                       "network_patterns": ["https://x/{id}/w"]}, fh)
        results = scan(d)
    ok = ok and len(results) == 1 and results[0]["error"] is None \
        and isinstance(results[0]["parse_ms"], float) \
        and not results[0]["redos_findings"]
    print("BD-TEMPLATE-BENCH-SELFTEST:", "OK" if ok else "FAIL")
    return ok


def main() -> int:
    ap = argparse.ArgumentParser(prog="bd-template-bench")
    ap.add_argument("--work", default=".")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max-ms", type=float, default=DEFAULT_MAX_MS)
    ap.add_argument("--selftest", action="store_true")
    args = ap.parse_args()

    if args.selftest:
        return 0 if selftest() else 1

    results = scan(args.work)
    if args.json:
        print(json.dumps(results, indent=2))
    else:
        for r in results:
            if r["error"]:
                print(f"ERROR  {r['file']}: {r['error']}")
                continue
            flag = "OVER" if r["parse_ms"] > args.max_ms else "ok"
            print(f"{flag:5s} {r['file']}: {r['parse_ms']}ms "
                  f"peak={r['memory']['peak_bytes']}B "
                  f"regexes={r['regex_count']} "
                  f"redos={len(r['redos_findings'])}")
            for f in r["redos_findings"]:
                print(f"      REDOS-RISK: {f}")

    bad = any(r["error"] or r["redos_findings"]
              or (r["parse_ms"] is not None and r["parse_ms"] > args.max_ms)
              for r in results)
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
