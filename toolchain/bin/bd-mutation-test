G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

CAUGHT, SURVIVED, UNKNOWN, BASELINE_RED = (
    "CAUGHT", "SURVIVED", "UNKNOWN", "BASELINE-RED")

_BIN = os.path.dirname(os.path.realpath(__file__))


def _sub(pattern, repl, count=1):
    def apply(text):
        new, n = re.subn(pattern, repl, text, count=count)
        return new if n else None          # None => did not apply => UNKNOWN
    return apply


