def _run(cmd, cwd, timeout=900):
    env = dict(os.environ)
    env.setdefault("PYTHONPATH", "/tmp/prestaged_site_packages")
    env.setdefault("BD_DISABLE_KEEPALIVE", "1")
    env["BD_HOME"] = tempfile.mkdtemp()
    try:
        p = subprocess.run(cmd, shell=True, cwd=cwd, env=env, timeout=timeout,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        return None, f"TIMEOUT after {timeout}s"
    except Exception as e:                                # pragma: no cover
        return None, f"could not run: {e}"


def _apply(row, tree):
    tgt = row["target"]
    if tgt.startswith("__PLANT__:"):
        rel = tgt.split(":", 1)[1]
        path = os.path.join(tree, rel)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as fh:
            fh.write(row["plant"])
        os.chmod(path, 0o755)
        return True, f"planted {rel}"
    path = os.path.join(tree, tgt)
    if not os.path.exists(path):
        return False, f"target missing: {tgt}"
    before = open(path, encoding="utf-8", errors="replace").read()
    after = row["mutate"](before)
    if after is None or after == before:
        return False, ("mutation did not apply (pattern did not match) -- a "
                       "gate that 'passes' against an UNMUTATED tree proves "
                       "nothing")
    if path.endswith(".py"):
        try:
            ast.parse(after)
        except SyntaxError as e:
            return False, f"mutation broke syntax ({e}) -- not a semantic mutation"
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(after)
    return True, "mutation applied"


def check(row, src_tree):
    src_tree = row.get("src", src_tree)
    scratch = tempfile.mkdtemp(prefix="bdmut_")
    tree = os.path.join(scratch, "t")
    try:
        # node_modules is 348M and would dominate every copy. It is READ-ONLY
        # to every gate here (vitest/tsc only import from it), so it is skipped
        # and symlinked back. If a gate ever WROTE to node_modules this would
        # pollute the source tree -- hence the explicit note, not a silent trick.
        shutil.copytree(src_tree, tree, symlinks=True,
                        ignore=shutil.ignore_patterns("__pycache__", "*.pyc",
                                                      ".git", "node_modules",
                                                      "venv", ".hypothesis"))
        # node_modules (348M) and venv (400M+) are READ-ONLY to every gate here,
        # so they are skipped and symlinked back rather than copied. Copying them
        # filled the disk and produced a torrent of ENOSPC that looked like a
        # tool bug. Named, not hidden: if a gate ever WROTE to either, this would
        # reach through into the source tree.
        for rel in ("frontend/node_modules", "venv"):
            real = os.path.join(src_tree, rel)
            link = os.path.join(tree, rel)
            if os.path.isdir(real) and not os.path.exists(link):
                os.makedirs(os.path.dirname(link), exist_ok=True)
                os.symlink(real, link)
        cwd = os.path.join(tree, row.get("cwd", ""))
        # MANY bd-* TOOLS HARDCODE --tree/--work=/home/claude/work AND IGNORE CWD.
        # Running one inside a mutated scratch copy therefore inspects the
        # PRISTINE tree, comes back green, and this harness would call it a
        # SURVIVOR -- a false finding manufactured by the instrument, which is
        # the exact disease being audited. Rows for such tools MUST carry {tree}.
        gate = row["gate"].replace("{tree}", tree).replace("{py}", sys.executable)
        out = dict(id=row["id"], why=row["why"], gate=gate)

        rc0, log0 = _run(gate, cwd)
        if rc0 is None:
            out.update(state=UNKNOWN, detail=f"gate could not run: {log0[:140]}")
            return out
        if rc0 != 0:
            out.update(state=BASELINE_RED,
                       detail="gate is ALREADY RED on the pristine tree -- it "
                              "cannot prove it fails for THIS reason")
            return out

        ok, detail = _apply(row, tree)
        if not ok:
            out.update(state=UNKNOWN, detail=detail)
            return out

        rc1, log1 = _run(gate, cwd)
        if rc1 is None:
            out.update(state=UNKNOWN,
                       detail=f"gate could not run post-mutation: {log1[:140]}")
        elif rc1 != 0:
            out.update(state=CAUGHT, detail="gate went RED on the mutant")
        else:
            out.update(state=SURVIVED,
                       detail="gate stayed GREEN with the feature BROKEN -- it "
                              "cannot see its own subject")
        return out
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def selftest():
    """Prove the HARNESS can tell its four states apart -- on synthetic trees with
    trivial gates, so it is fast and needs nothing from the real repo.

    A mutation-tester whose own verdicts cannot be trusted is the disease it was
    built to cure. The old bd-mutation-test's selftest passed 4/4 forever because
    it compared its own mutants to its own reference; this one checks the thing
    that actually matters -- that CAUGHT, SURVIVED, UNKNOWN and BASELINE-RED are
    each reachable and each correct.
    """
    ok = True
    sand = tempfile.mkdtemp(prefix="bdmut_self_")
    tree = os.path.join(sand, "src")
    os.makedirs(tree)
    with open(os.path.join(tree, "feature.txt"), "w") as fh:
        fh.write("FEATURE_PRESENT\n")

    cases = [
        # gate greps for the feature: mutation removes it -> gate goes red -> CAUGHT
        ("CAUGHT", dict(
            id="self/caught", why="", target="feature.txt",
            mutate=_sub(r"FEATURE_PRESENT", "GONE", 1),
            gate="grep -q FEATURE_PRESENT feature.txt")),
        # gate ignores the feature entirely -> stays green -> SURVIVED
        ("SURVIVED", dict(
            id="self/survived", why="", target="feature.txt",
            mutate=_sub(r"FEATURE_PRESENT", "GONE", 1),
            gate="true")),
        # the mutation pattern never matches -> we learned NOTHING -> UNKNOWN
        ("UNKNOWN", dict(
            id="self/unknown", why="", target="feature.txt",
            mutate=_sub(r"THIS_PATTERN_IS_NOT_THERE", "x", 1),
            gate="grep -q FEATURE_PRESENT feature.txt")),
        # gate is already failing before we touch anything -> BASELINE-RED
        ("BASELINE-RED", dict(
            id="self/baseline", why="", target="feature.txt",
            mutate=_sub(r"FEATURE_PRESENT", "GONE", 1),
            gate="false")),
    ]
    for want, row in cases:
        got = check(row, tree)["state"]
        good = got == want
        ok &= good
        print(f"{'PASS' if good else 'FAIL'}  {row['id']}: expected {want}, got {got}")

    # SELECTOR SOUNDNESS (GATE-SOUND-REM @808): the state machine above is sound,
    # but main()'s --only selector is the operator's real interface, and a selector
    # that silently drops requested rows is the empty-denominator shape in the tool
    # built to hunt it. Two live defects, both proven through the real CLI.
    import subprocess as _sp
    def _run_cli(*args):
        return _sp.run([sys.executable, os.path.realpath(__file__), *args],
                       capture_output=True, text=True, timeout=60)
    ids = [r["id"] for r in REGISTRY]
    two = ids[:2]
    r = _run_cli("--list", "--json", "--only", two[0], "--only", two[1])
    try:
        sel = {d["id"] for d in json.loads(r.stdout)["catalog"]}
    except Exception:
        sel = set()
    c_multi = (two[0] in sel and two[1] in sel)
    print(f"{'PASS' if c_multi else 'FAIL'}  SELECTOR-MULTI: two --only select both "
          f"rows (selected {len(sel)})")
    ok &= c_multi
    r = _run_cli("--only", "no_such_row_xyz")
    c_nomatch = (r.returncode != 0)
    print(f"{'PASS' if c_nomatch else 'FAIL'}  SELECTOR-NOMATCH: unmatched --only "
          f"fails (rc={r.returncode})")
    ok &= c_nomatch

    shutil.rmtree(sand, ignore_errors=True)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=os.path.dirname(os.path.dirname(_BIN)))
    ap.add_argument("--only", action="append",
                    help="row-id substring; repeatable. Each --only must match "
                         "at least one row or the run FAILS (no silent 0-row run).")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()

    if a.selftest:
        return selftest()

    if a.only:
        # Each selector must hit at least one row. A selector matching nothing is
        # an empty denominator -- running the survivors as "0/0 caught, success"
        # is the exact false-green this tool exists to catch. (GATE-SOUND-REM @808.)
        unmatched = [sel for sel in a.only
                     if not any(sel in r["id"] for r in REGISTRY)]
        if unmatched:
            print("%sNO MATCH%s --only did not match any row: %s\n  known ids: %s"
                  % (R, RST, ", ".join(unmatched),
                     ", ".join(sorted(r["id"] for r in REGISTRY))), file=sys.stderr)
            return 2
        rows = [r for r in REGISTRY if any(sel in r["id"] for sel in a.only)]
    else:
        rows = list(REGISTRY)
    if a.list:
        if a.json:
            # deterministic catalog surface -- gate-able by bd-golden without the live
            # mutation run (which is slow + effectively unbounded). (GATE-SOUND-REM @756.)
            cat = sorted(({"id": r["id"], "gate": r["gate"]} for r in rows),
                         key=lambda d: d["id"])
            print(json.dumps({"catalog": cat, "total": len(cat)}, indent=1, sort_keys=True))
            return 0
        for r in rows:
            print(f"  {r['id']:44} gate: {r['gate']}")
        return 0

    results = []
    for r in rows:
        res = check(r, a.work)
        results.append(res)
        if not a.json:
            col = {CAUGHT: G, SURVIVED: R, UNKNOWN: Y, BASELINE_RED: Y}[res["state"]]
            print(f"  {col}{res['state']:<12}{RST} {res['id']}")
            print(f"      {DIM}{res['detail']}{RST}")
            sys.stdout.flush()

    bad = [r for r in results if r["state"] != CAUGHT]
    caught = len(results) - len(bad)
    if a.json:
        print(json.dumps({"results": results, "caught": caught,
                          "total": len(results),
                          "failing": [r["id"] for r in bad]}, indent=1))
        return 1 if bad else 0

    print(f"\n  kill-rate: {caught}/{len(results)} "
          f"(mutating the REAL tree, running the REAL gate)")
    for state, colour, label in (
            (SURVIVED, R, "SURVIVOR(S) -- these gates cannot see their own subject"),
            (UNKNOWN, Y, "UNKNOWN -- unverifiable. Unknown is a third state and it FAILS"),
            (BASELINE_RED, Y, "BASELINE-RED -- already failing; cannot prove it fails for THIS reason")):
        hits = [r for r in results if r["state"] == state]
        if hits:
            print(f"{colour}  {len(hits)} {label}:{RST}")
            for r in hits:
                print(f"    - {r['id']}: {r['detail']}")
    if not bad:
        print(f"{G}  every gate went RED when its feature was broken.{RST}")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
