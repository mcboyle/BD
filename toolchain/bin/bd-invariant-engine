#!/usr/bin/env python3
"""bd-invariant-engine -- define + enforce project invariants as one gate.

A declarative invariant checker that composes the release-discipline floor into
a single pass/fail. Built-in invariants (each maps to an existing check):
  GUARD-UNCHANGED   7 guard files' live sha == STATE.guards_full_sha256
  VERSION-HONEST    __version__ == test pin == CHANGELOG top == STATE version
  TREE-PARSES       every .py in the tree ast-parses (no corruption)
  NO-BANNED-EGRESS  no encoded-IP/loopback bypass in the classifier (self-probe)
  ROUTE-STABLE      ENDPOINT_CATALOG route count matches STATE (advisory)
Each invariant is a named predicate over (work, home); the engine reports which
hold and which are violated. Extensible via --only / a future rules file.
Read-only.

Usage: bd-invariant-engine [--work DIR] [--home DIR] [--only NAME] [--json]
       bd-invariant-engine --selftest
Exit 1 if any invariant is violated, else 0.
"""
import argparse
import ast
import glob
import hashlib
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

GUARD_FILES = [
    "bulk_downloader/extraction_core.py", "bulk_downloader/session_capture.py",
    "bulk_downloader/dom_capture.py", "bulk_downloader/dom_recorder.py",
    "bulk_downloader/capture_bodies.py", "tools/capture_session.py",
    "tools/build_release.py",
]


def _guards_from_manifest(work):
    """guards.json (CLAUDE.md section 2) is now the single source of truth for
    the 7 guard-file pins -- STATE.json, which sec.load_state()/home look for,
    is a retired sandbox session-bundle artifact this git checkout never
    produces. bd-guardcheck already reads guards.json first and STATE.json
    only as a fallback; mirror that order here rather than staying permanently
    CANNOT-EVALUATE on a source that no longer exists in this world."""
    p = os.path.join(work, "guards.json")
    try:
        doc = __import__("json").load(open(p))
    except Exception:
        return None
    guards = doc.get("guards")
    if not isinstance(guards, dict) or not guards:
        return None
    return guards


def inv_guard_unchanged(work, home):
    want = _guards_from_manifest(work)
    if want is None:
        st = sec.load_state(home)
        if not st:
            return (None, "no guards.json in %s and no STATE.json in %s" % (work, home))
        want = sec.state_guard_shas(st)
    mismatches = []
    for rel, sha in want.items():
        p = os.path.join(work, rel)
        if not os.path.exists(p):
            mismatches.append(f"{rel}: missing")
            continue
        cur = hashlib.sha256(open(p, "rb").read()).hexdigest()
        if cur != sha:
            mismatches.append(f"{os.path.basename(rel)}: sha drift")
    return (not mismatches, "; ".join(mismatches) or f"{len(want)} guards match")


def inv_version_honest(work, home):
    # CLAUDE.md section 3: a version bump is three edits together --
    # __init__.py, the test pin (tests/test_settings_center_slice4.py), and
    # CHANGELOG.md's top header. STATE.json's built_version/live_version was
    # the sandbox's fourth comparand; it is retired and this git checkout
    # never produces one, so anchoring on it left this invariant permanently
    # CANNOT-EVALUATE here. The three in-repo comparands are the real,
    # currently-authoritative ones -- ported to compare those instead.
    initp = os.path.join(work, "bulk_downloader", "__init__.py")
    m = re.search(r'__version__\s*=\s*["\']([^"\']+)', open(initp).read()) \
        if os.path.exists(initp) else None
    code_ver = m.group(1) if m else None
    pinp = os.path.join(work, "tests", "test_settings_center_slice4.py")
    pm = re.search(r'__version__\s*==\s*["\']([^"\']+)', open(pinp).read()) \
        if os.path.exists(pinp) else None
    pin_ver = pm.group(1) if pm else None
    chlog = os.path.join(work, "CHANGELOG.md")
    ctop = None
    if os.path.exists(chlog):
        cm = re.search(r'##\s*v?([0-9.]+)', open(chlog).read())
        ctop = cm.group(1) if cm else None
    # J-85: `code_ver == ver` is TRUE when both are None. In a bare sandbox this
    # invariant reported VERSION-HONEST=True over three absent values -- a 4-way
    # equality that held because nothing was there to disagree. An invariant needs
    # an EXISTENCE PREDICATE: absent comparands are CANNOT-EVALUATE (None), never
    # agreement. Vacuous truth is the most confident kind.
    if code_ver is None or pin_ver is None:
        return (None, "CANNOT-EVALUATE: comparand absent (code=%s pin=%s changelog=%s)"
                % (code_ver, pin_ver, ctop))
    agree = code_ver == pin_ver and (ctop is None or ctop == pin_ver)
    return (agree, f"code={code_ver} test_pin={pin_ver} changelog={ctop}")


def inv_tree_parses(work, home):
    """J-86: `not bad` is TRUE when nothing was parsed. "0 files failed to parse"
    over 0 files is the purest vacuous green in the suite -- and it fed 15 points
    straight into the trust score. The invariant now carries its DENOMINATOR, and
    a parse check that parsed nothing CANNOT-EVALUATE."""
    bad, parsed = [], 0
    for f in glob.glob(os.path.join(work, "bulk_downloader", "**", "*.py"), recursive=True):
        parsed += 1
        try:
            ast.parse(open(f, errors="ignore").read())
        except SyntaxError:
            bad.append(os.path.relpath(f, work))
    if parsed == 0:
        return (None, "CANNOT-EVALUATE: 0 .py files found -- nothing was parsed")
    if bad:
        return (False, "%s (%d/%d parsed)" % ("; ".join(bad[:3]), parsed - len(bad), parsed))
    return (True, "all %d .py parse" % parsed)


def inv_no_banned_egress(work, home):
    # NOTE: this is a self-probe of the URL CLASSIFIER, not a property of the
    # tree -- it holds identically for any --work. Kept (it is a real check), but
    # it must not be read as evidence about the tree it is listed beside.
    # self-probe the classifier: known bypass forms must be blocked
    probes = ["http://127.1/", "http://169.254.169.254/", "http://10.0.70.20/",
              "http://[::1]/", "http://2130706433/"]
    leaked = [u for u in probes if sec.classify_url(u)["verdict"] != "blocked"]
    return (not leaked, "; ".join(leaked) or f"{len(probes)} bypass forms blocked")


def inv_route_stable(work, home):
    cat = sec.parse_endpoint_catalog(work)
    n = len(cat)
    return (n > 0, f"{n} routes in catalog" if n else "no ENDPOINT_CATALOG")


INVARIANTS = {
    "GUARD-UNCHANGED": inv_guard_unchanged,
    "VERSION-HONEST": inv_version_honest,
    "TREE-PARSES": inv_tree_parses,
    "NO-BANNED-EGRESS": inv_no_banned_egress,
    "ROUTE-STABLE": inv_route_stable,
}


def run(work, home, only):
    results = []
    for name, fn in INVARIANTS.items():
        if only and name != only:
            continue
        try:
            holds, detail = fn(work, home)
        except Exception as e:
            holds, detail = False, f"check errored: {e}"
        results.append({"invariant": name, "holds": holds, "detail": detail})
    return results


def selftest():
    ok = True
    res = run(sec.DEFAULT_WORK, sec.DEFAULT_WORK, None)
    print(f"  {DIM}invariants: {len(res)}{RST}")
    # on a pristine tree, GUARD/VERSION/TREE/EGRESS must hold
    must = {"GUARD-UNCHANGED", "VERSION-HONEST", "TREE-PARSES", "NO-BANNED-EGRESS"}
    for r in res:
        if r["invariant"] in must:
            tag = "PASS" if r["holds"] else ("UNKNOWN" if r["holds"] is None else "FAIL")
            print(f"  {tag}  {r['invariant']}: {r['detail']}")
            ok &= bool(r["holds"])
    # NO-BANNED-EGRESS is the one we can force-check: it must catch a leak if the
    # classifier regressed -- prove the predicate discriminates.
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--home", default=sec.DEFAULT_WORK,
                    help="legacy STATE.json bundle root (fallback only -- "
                         "GUARD-UNCHANGED now reads --work/guards.json first)")
    ap.add_argument("--only", default=None)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    # require_bundle() demands a release-zip bundle in --home (BUNDLE_MARKERS:
    # BulkDownloader_*.zip / BulkDL_next_session_*.zip / STATE.json) -- the
    # retired zip world (CLAUDE.md s7). No invariant below needs that bundle
    # any more: GUARD-UNCHANGED reads --work/guards.json first, VERSION-HONEST
    # reads the in-repo test pin, and the rest never touched --home. Gating
    # the WHOLE engine on an artifact nothing here needs is the over-sensitive
    # twin of a blind gate -- it would report CANNOT-EVALUATE on a fully
    # evaluable tree. Dropped; --home is now a fallback only (see load_state).
    res = run(a.work, a.home, a.only)
    # TRI-STATE (B-15). holds is True / False / None, and None is not False:
    # "this invariant is broken" and "I could not evaluate this invariant" are
    # different facts and must not be printed as the same word. Both fail the
    # gate -- unknown is never green -- but a reader who is told VIOLATED when
    # the truth is CANNOT-EVALUATE goes looking for a bug that is not there.
    unevaluable = [r for r in res if r["holds"] is None]
    violated = [r for r in res if r["holds"] is False]
    if sec.emit({"invariants": res, "summary": {"total": len(res),
                 "violated": len(violated),
                 "unevaluable": len(unevaluable),
                 "green": len(res) - len(violated) - len(unevaluable),
                 "total": len(res)}}, as_json=a.json):
        return 1 if (violated or unevaluable) else 0
    for r in res:
        if r["holds"] is None:
            tag = Y + "UNKNOWN " + RST
        elif r["holds"]:
            tag = G + "HOLDS " + RST
        else:
            tag = R + "VIOLATED" + RST
        print(f"  {tag} {r['invariant']:<18} {DIM}{r['detail']}{RST}")
    if violated or unevaluable:
        parts = []
        if violated:
            parts.append("%d violated" % len(violated))
        if unevaluable:
            parts.append("%d CANNOT-EVALUATE" % len(unevaluable))
        print("%s%s of %d invariant(s)%s -- unknown is not green"
              % (R, ", ".join(parts), len(res), RST))
        return 1
    print(f"{G}all {len(res)} invariants hold{RST}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
