#!/usr/bin/env python3
"""bd-parband -- run targeted test suites CONCURRENTLY (the fast, isolated band).

bd-band runs suites one at a time. bd-parband runs them in parallel, each in its
OWN subprocess with its OWN BD_HOME (mktemp) + the correct sandbox env + a per-suite
timeout. The per-process BD_HOME means the state-leak co-band hazards (e.g.
test_phases_195_199 leaking BD_INSTALL_DIR) can't cross suites — parallel is both
faster AND safer than sequential co-banding for those.

Refuses the known hangers (perf_lab, nav_guard) and a bare tests/ dir. Writes the
run to the band-results file -- default <checkout>/.bd_last_band.json, override
with BD_LAST_BAND -- so `bd-retest` can re-run just the failures (bd-retest reads
the SAME default/override; change one and you break the pair).

Usage:
    bd-parband tests/a.py tests/b.py tests/c.py [--jobs 4] [--timeout 300] [--work DIR]
Exit 0 = every suite Failed:0 ; 1 = any failure/timeout ; 2 = CANNOT-EVALUATE,
nothing was dispatched (a refused hazard, or a suite path that does not exist).
Exit 2 never writes the band-results file: a refusal is not a band.
"""
import argparse
import concurrent.futures as cf
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import time


def _resolve_default_work():
    env = os.environ.get("BD_ROOT")
    if env and os.path.isfile(os.path.join(env, "bulk_downloader", "__init__.py")):
        return env
    directory = os.path.dirname(os.path.realpath(__file__))
    for _ in range(8):
        if os.path.isfile(os.path.join(directory, "bulk_downloader", "__init__.py")):
            return directory
        parent = os.path.dirname(directory)
        if parent == directory:
            break
        directory = parent
    return os.environ.get("BD_WORK_TREE", os.getcwd())


DEFAULT_WORK = _resolve_default_work()
EXIT_CANNOT_EVALUATE = 2


def _imports_pytest(executable, timeout=30):
    try:
        return subprocess.run(
            [executable, "-c", "import pytest"], capture_output=True,
            timeout=timeout).returncode == 0
    except Exception:
        return False


def _resolve_test_interpreter(work=None):
    work = work or DEFAULT_WORK
    candidates = [os.path.join(work, "venv", "bin", "python"),
                  os.path.join(DEFAULT_WORK, "venv", "bin", "python"),
                  sys.executable, shutil.which("python3") or ""]
    seen = set()
    for candidate in candidates:
        if not candidate or candidate in seen:
            continue
        seen.add(candidate)
        if os.path.exists(candidate) and _imports_pytest(candidate):
            return candidate
    return None


def _missing_suite_reason(work, suite):
    path = suite if os.path.isabs(suite) else os.path.join(work or DEFAULT_WORK, suite)
    if os.path.isfile(path):
        return None
    return ("no such file under %s -- the compatibility runner falls back to "
            "a BROAD RUN of the whole tree and the result would be attributed "
            "to this path"
            % (work or DEFAULT_WORK))


# INLINE BY DESIGN (row 243).  This block is duplicated in every owning pytest
# launcher so a byte-for-byte copy of this tool has no sibling Python import.
# The bootstrap registers its own PID, refuses if publication fails, and only
# then imports pytest.  runpy keeps registration and pytest in the same process
# without a wrapper file or an exec hand-off.
_PYTEST_REGISTRATION_BOOTSTRAP = r'''\
import os
import runpy
import shlex
import subprocess
import sys

jobs, purpose, *pytest_args = sys.argv[1:]
command = shlex.join([sys.executable, "-m", "pytest", *pytest_args])
registration = subprocess.run(
    [sys.executable, jobs, "register", "--pid", str(os.getpid()),
     "--purpose", purpose, "--cmd", command],
    capture_output=True, text=True,
)
if registration.returncode:
    detail = (registration.stdout + registration.stderr).strip()
    print("BD-PYTEST REFUSED: registration failed before pytest import/work"
          + (": " + detail if detail else ""), file=sys.stderr)
    raise SystemExit(3)
sys.argv[:] = ["pytest", *pytest_args]
runpy.run_module("pytest", run_name="__main__", alter_sys=True)
'''


def _registered_pytest_argv(python, purpose, *pytest_args, work=None):
    """Return a same-PID, register-before-import pytest command."""
    candidates = []
    if work is not None:
        candidates.append(pathlib.Path(work) / "toolchain" / "bin" / "bd-jobs")
    here = pathlib.Path(__file__).resolve()
    candidates.append(here.with_name("bd-jobs"))
    if len(here.parents) >= 3:
        candidates.append(here.parents[2] / "toolchain" / "bin" / "bd-jobs")
    try:
        resolved_python = pathlib.Path(python).resolve()
    except (OSError, RuntimeError):
        resolved_python = None
    if resolved_python is not None:
        candidates.extend(
            parent / "toolchain" / "bin" / "bd-jobs"
            for parent in resolved_python.parents
        )
    installed = shutil.which("bd-jobs")
    if installed:
        candidates.append(pathlib.Path(installed))
    jobs = next((path for path in candidates if path.is_file()), None)
    if jobs is None:
        raise RuntimeError(
            "owned pytest launch refused: bd-jobs is not reachable; nothing ran")
    return [str(python), "-c", _PYTEST_REGISTRATION_BOOTSTRAP,
            str(jobs), str(purpose), *[str(arg) for arg in pytest_args]]

_PY_CACHE = {}


def _py(work):
    """The interpreter that can run this project's tests. Memoized: the probe
    spawns a subprocess and these runners call this once per suite.

    None from the resolver is FATAL, never a silent fallback -- a band under a
    deps-less interpreter reports failures that read as real defects, which is
    the v3.66.850 finding (CLAUDE.md s5).
    """
    if work not in _PY_CACHE:
        exe = _resolve_test_interpreter(work)
        if exe is None:
            print("BD-UNEVALUABLE: no interpreter under %s can import pytest -- "
                  "refusing to run rather than report interpreter artifacts as "
                  "test failures." % work, file=sys.stderr)
            raise SystemExit(EXIT_CANNOT_EVALUATE)
        _PY_CACHE[work] = exe
    return _PY_CACHE[work]

G, R, Y, DIM, BOLD, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[1m", "\033[0m"
HANGERS = ("test_perf_lab", "test_v3_66_146_nav_guard")
# The bd-retest CONTRACT: both tools resolve this identically (env override,
# then checkout-relative default). Edit them together or the pair breaks.
RESULTS = os.environ.get("BD_LAST_BAND",
                         os.path.join(DEFAULT_WORK, ".bd_last_band.json"))
# Optional env file sourced for the suite env (GTK stack etc.). The retired
# sandbox kept one at /home/claude/bdenv.sh; no such file ships in this
# checkout, so the default is ABSENT and the tool falls back to os.environ --
# which is correct here (the provisioner sets the GTK env directly). Do NOT
# point this at toolchain/bdenv.sh: that file still exports the retired
# prestaged PYTHONPATH and /home/claude paths.
BDENV = os.environ.get("BD_ENV_FILE",
                       os.path.join(DEFAULT_WORK, "bdenv.sh"))

_BD_ENV_CACHE = None


def _bd_env():
    """The FULL `bd` env, derived by sourcing bdenv.sh -- NOT a hand-kept subset.
    v3.66.762: bd-parband used to set only PYTHONPATH/BD_HOME/PLAYWRIGHT, omitting
    the GTK vars (GTK_ROOT/LD_LIBRARY_PATH/GI_TYPELIB_PATH/XDG_DATA_DIRS) that the
    `bd` wrapper provides. Any suite importing Gtk then false-RED'd with
    'Namespace Gtk not available'. Sourcing the canonical env source means this
    can never drift from `bd` again. Falls back to os.environ if bdenv is absent."""
    global _BD_ENV_CACHE
    if _BD_ENV_CACHE is not None:
        return dict(_BD_ENV_CACHE)
    base = dict(os.environ)
    if os.path.isfile(BDENV):
        try:
            r = subprocess.run(
                ["bash", "-c", "set -a; . %s >/dev/null 2>&1; env -0" % BDENV],
                capture_output=True, text=True, timeout=30)
            if r.returncode == 0 and r.stdout:
                for chunk in r.stdout.split("\0"):
                    if "=" in chunk:
                        k, v = chunk.split("=", 1)
                        base[k] = v
        except Exception:  # why: fall back to os.environ; never crash the band.
            # (Reason moved ONTO the handler: it sat on the `pass` line below,
            # where the lint's two-line window could not see it -- a justified
            # handler reading as unjustified.)
            pass
    _BD_ENV_CACHE = dict(base)
    return dict(base)


def run_one(work, suite, timeout):
    env = _bd_env()
    env.pop("BD_INSTALL_DIR", None)
    env.update(BD_HOME=tempfile.mkdtemp(prefix="bdpb_"), BD_DISABLE_KEEPALIVE="1")
    t0 = time.time()
    try:
        # @950: REAL PYTEST, for the reason bd-band records at length. This ran
        # the run_tests_core shim, which installs itself whenever pytest is not
        # ALREADY imported -- always, here -- despite _py() having just proven
        # pytest importable. Measured at v3.66.949 across the whole suite with
        # per-file isolation on both sides: the shim called 28 files non-PASS
        # and 24 of them pass under real pytest, verified 24/24.
        py = _py(work)
        r = subprocess.run(_registered_pytest_argv(
                               py, f"bd-parband {suite}", suite, "-q", "-p",
                               "no:randomly", work=work),
                           cwd=work, env=env,
                           capture_output=True, text=True, timeout=timeout)
        out = r.stdout + r.stderr
        # pytest's counts, not the shim's "Total: N | Failed: N". A summary that
        # is absent is NOT zero failures: fall back to the exit code, which is
        # the only thing that cannot be missing.
        m = re.search(r'(\d+) failed', out)
        failed = int(m.group(1)) if m else (0 if r.returncode == 0 else -1)
        passed = re.search(r'(\d+) passed', out)
        # Exit 5 is "no tests collected" -- nothing ran, so nothing was proven,
        # and it must not read as green. See bd-band.grade_pytest_rc.
        status = "pass" if r.returncode == 0 else (
            "nothing-ran" if r.returncode == 5 else "fail")
        return {"suite": suite, "status": status, "failed": failed,
                "passed": int(passed.group(1)) if passed else None,
                "secs": round(time.time() - t0, 1),
                "tail": "\n".join(l for l in out.splitlines() if l.strip())[-400:]}
    except subprocess.TimeoutExpired:
        return {"suite": suite, "status": "timeout", "failed": -1,
                "secs": round(time.time() - t0, 1), "tail": f"timed out >{timeout}s"}


def selftest():
    """DELEGATE: wraps real pytest under the work tree's interpreter. The
    selftest asserts the real target is reachable; if it is not, FAIL -- a
    wrapper that cannot find what it wraps is broken, and a selftest that cannot
    verify must not report success.

    @950: the target used to be the compatibility shim, and asserting that
    shim's PRESENCE was a check that could not fail for the reason that
    mattered. It is always present in a checkout, so the selftest reported PASS
    while the tool ran a runner documented as "NOT a replacement for pytest in
    production" -- which manufactured 24 of the 28 non-PASS verdicts measured at
    v3.66.949. Presence of a file is not reachability of a runner; ask the
    interpreter instead.

    The shim is named by MECHANISM and not by filename here on purpose: a
    docstring that spells the retired command re-creates it in the file, and
    tests/test_v3_66_950_* asserts these tools no longer reference it. CLAUDE.md
    section 0 records four instances of exactly that; this cut hit three more."""
    import os as _o, subprocess as _sp
    py = _py(DEFAULT_WORK)
    hit = None
    if py:
        r = _sp.run([py, "-c", "import pytest; print(pytest.__version__)"],
                    capture_output=True, text=True, timeout=120)
        hit = r.stdout.strip() if r.returncode == 0 else None
    print(("PASS" if hit else "FAIL")
          + "  delegation target reachable: pytest (%s)" % (hit or "NOT IMPORTABLE"))
    ok = bool(hit)
    # The env a suite runs under MUST carry the GTK stack, or pygobject suites
    # false-RED with 'Namespace Gtk not available'. Assert the derived env is the
    # full `bd` env, not the old hand-kept subset. (Skipped only if bdenv is
    # absent -- and skip says so, it does not report success.)
    if _o.path.isfile(BDENV):
        e = _bd_env()
        need = ("GTK_ROOT", "GI_TYPELIB_PATH", "LD_LIBRARY_PATH", "XDG_DATA_DIRS")
        have = [k for k in need if e.get(k) and "gtk" in e[k].lower()]
        gtk_ok = len(have) == len(need)
        print(("PASS" if gtk_ok else "FAIL") +
              "  GTK env carried into the suite env (%d/%d: %s)"
              % (len(have), len(need), ",".join(have) or "none"))
        ok = ok and gtk_ok
    else:
        print("SKIP  bdenv.sh absent -- cannot verify GTK env carry")
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser()
    ap.add_argument("suites", nargs="+")
    ap.add_argument("--jobs", type=int, default=4)
    ap.add_argument("--timeout", type=int, default=300)
    ap.add_argument("--work", "--tree", default=DEFAULT_WORK)
    a = ap.parse_args()

    # Door check. Two tiers, ONE exit code: the known hazards (which this tool
    # has always refused) and, since @868, existence. Both are CANNOT-EVALUATE
    # -- a target that was not dispatched has no verdict, and exit 1 would say
    # "the suite failed", which is a claim about a run that never happened.
    #
    # Per-target reason, computed in the loop. The old comprehension mislabelled
    # a non-.py path whose basename lacked "test" as "bare tests/ dir".
    #
    # The .py check stays AHEAD of the existence check on purpose: pytest node
    # ids (tests/x.py::TestY) are already rejected, and "improving" that by
    # splitting on "::" would WIDEN accepted input inside a cut about narrowing
    # it.
    bad = []
    for s in a.suites:
        if any(h in s for h in HANGERS):
            bad.append((s, "known hanger"))
        elif s.rstrip("/") in ("tests", "tests/"):
            bad.append((s, "bare tests/ dir (hangs)"))
        elif not s.endswith(".py"):
            bad.append((s, "not a .py file"))
        else:
            why = _missing_suite_reason(a.work, s)
            if why:
                bad.append((s, why))
    if bad:
        # Discriminating marker: argparse also exits 2 on a bad argv, so the
        # code alone cannot tell a caller which condition it hit.
        print(f"{R}BD-PARBAND UNEVALUABLE{RST} -- refusing to dispatch; "
              f"no verdict minted:", file=sys.stderr)
        for s, why in bad:
            print(f"  {R}XX{RST} {s} {DIM}({why}){RST}", file=sys.stderr)
        print(f"{DIM}run hangers alone via bd-band with a big --timeout, "
              f"or fix the path{RST}", file=sys.stderr)
        # Deliberately do NOT write RESULTS here. A refusal is not a band, and
        # bd-retest reads that file back; leaving the previous run's file
        # untouched is correct.
        return EXIT_CANNOT_EVALUATE

    print(f"{BOLD}parallel band{RST} {DIM}{len(a.suites)} suites, {a.jobs} jobs, "
          f"{a.timeout}s each{RST}")
    t0 = time.time()
    results = []
    with cf.ThreadPoolExecutor(max_workers=a.jobs) as ex:
        futs = {ex.submit(run_one, a.work, s, a.timeout): s for s in a.suites}
        for fut in cf.as_completed(futs):
            r = fut.result()
            results.append(r)
            tag = {"pass": G + "PASS" + RST, "fail": R + "FAIL" + RST,
                   "timeout": R + "TIMEOUT" + RST}[r["status"]]
            extra = f"({r['failed']} failed)" if r["failed"] > 0 else ""
            print(f"  {tag}  {r['suite']}  {DIM}{r['secs']}s {extra}{RST}")

    wall = round(time.time() - t0, 1)
    seq = round(sum(r["secs"] for r in results), 1)
    json.dump({"work": a.work, "timeout": a.timeout, "results": results},
              open(RESULTS, "w"), indent=2)
    bad = [r for r in results if r["status"] != "pass"]
    if bad:
        print(f"\n{R}{len(bad)}/{len(results)} suite(s) not clean{RST} "
              f"{DIM}(wall {wall}s vs ~{seq}s sequential){RST}")
        for r in bad:
            print(f"  {DIM}{r['suite']} tail:{RST}")
            for l in r.get("tail", "").splitlines()[-4:]:
                print(f"    {l[:100]}")
        print(f"{DIM}re-run just these: bd-retest{RST}")
        return 1
    print(f"\n{G}all {len(results)} suites clean{RST} "
          f"{DIM}(wall {wall}s vs ~{seq}s sequential; results -> {RESULTS}){RST}")
    return 0


sys.exit(main())
