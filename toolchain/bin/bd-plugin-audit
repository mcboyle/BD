#!/usr/bin/env python3
"""bd-plugin-audit -- audit plugin source surfaces.

Scans plugin modules (plugin_*.py + plugins.py + any plugins/ dir) for risk
surfaces: capabilities that require full-access (lifecycle/page_access),
forbidden/high-power imports (subprocess/os.system/socket/ctypes/eval/exec),
and network/filesystem sinks. Reports per-plugin the access level implied by
its declared caps + the powerful imports present, so a reviewer sees the actual
blast radius before enabling. Advisory, read-only.

Usage: bd-plugin-audit [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse, ast, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
FORBIDDEN=re.compile(r'\b(subprocess|os\.system|socket|ctypes|eval\(|\bexec\(|__import__|pickle\.load|marshal\.loads)\b')
FULL_ACCESS=re.compile(r'\b(lifecycle|page_access|set_full_access|full_access)\b')

def scan(work):
    rows=[]
    pats=[os.path.join(work,"bulk_downloader","plugin_*.py"),
          os.path.join(work,"bulk_downloader","plugins.py"),
          os.path.join(work,"plugins","**","*.py")]
    seen=set()
    for pat in pats:
        for f in glob.glob(pat,recursive=True):
            if f in seen: continue
            seen.add(f)
            try: txt=open(f,errors="ignore").read()
            # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
            except Exception: continue
            forb=sorted(set(m.group(1) for m in FORBIDDEN.finditer(txt)))
            fa=bool(FULL_ACCESS.search(txt))
            if forb or fa:
                rows.append({"file":os.path.relpath(f,work),
                             "forbidden_imports":forb,"full_access_surface":fa,
                             "access_level":"full-access" if fa else "sandboxed"})
    return rows

def selftest():
    ok=True
    rows=scan(sec.DEFAULT_WORK)
    print(("PASS" if isinstance(rows,list) else "FAIL")+"  plugin audit ran (%d surfaces)"%len(rows))
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b=os.path.join(d,"bulk_downloader"); os.makedirs(b)
        open(os.path.join(b,"plugin_evil.py"),"w").write("import subprocess\ndef page_access(): pass\n")
        open(os.path.join(b,"plugin_safe.py"),"w").write("def extractor(x): return x\n")
        s=scan(d)
    files={os.path.basename(r["file"]) for r in s}
    good="plugin_evil.py" in files and "plugin_safe.py" not in files
    print(("PASS" if good else "FAIL")+"  risky plugin flagged, safe one clean (%s)"%sorted(files))
    ok=ok and good
    evil=[r for r in s if "evil" in r["file"]][0]
    caught="subprocess" in evil["forbidden_imports"] and evil["full_access_surface"]
    print(("PASS" if caught else "FAIL")+"  subprocess + full-access surface detected")
    ok=ok and caught
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    rows=scan(a.work)
    if sec.emit({"plugins":rows,"summary":{"surfaces":len(rows),"full_access":sum(1 for r in rows if r["full_access_surface"])}},as_json=a.json): return 0
    print("%d plugin surface(s) with risk (%d full-access):"%(len(rows),sum(1 for r in rows if r["full_access_surface"])))
    for r in rows[:40]:
        col=R if r["full_access_surface"] else Y
        print("  %s%s%s %s  %s%s%s"%(col,r["access_level"],RST,r["file"],DIM,",".join(r["forbidden_imports"]) or "-",RST))
    return 0
if __name__ == "__main__":
    sys.exit(main())
