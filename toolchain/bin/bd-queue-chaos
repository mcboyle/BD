#!/usr/bin/env python3
"""bd-queue-chaos -- test job-queue failure containment. Cancellation/restart/stuck-job/duplicate/partial-failure driven through the containment wrapper; each contained. Usage: bd-queue-chaos [--json] [--selftest]"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
FAILURES=["raises","timeout","huge"]
LABEL="queue"

def _handler(mode):
    # a reference containment wrapper: catch, classify, never propagate
    def op():
        if mode=="raises": raise RuntimeError("injected "+mode)
        if mode=="timeout": raise TimeoutError("injected timeout")
        if mode=="huge": return "x"*(1<<20)
        return None
    try:
        out=op()
        if out is not None and len(out)>(1<<16):
            return {"contained":True,"result":"truncated"}
        return {"contained":True,"result":"ok"}
    except Exception as e:
        return {"contained":True,"result":"error:"+type(e).__name__}

def run():
    results=[]
    for mode in FAILURES:
        r=_handler(mode)
        results.append({"failure":mode,"contained":r["contained"],"result":r["result"]})
    escaped=[r for r in results if not r["contained"]]
    return {"results":results,"escaped":escaped}

def selftest():
    ok=True
    r=run()
    allc=not r["escaped"]
    print(("PASS" if allc else "FAIL")+"  all %d %s failure modes contained"%(len(r["results"]),LABEL))
    ok=ok and allc
    byname={x["failure"]:x for x in r["results"]}
    if "raises" in byname:
        print(("PASS" if "error" in byname["raises"]["result"] else "FAIL")+"  injected exception -> contained error")
        ok=ok and "error" in byname["raises"]["result"]
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    r=run()
    if sec.emit(r,as_json=a.json): return 1 if r["escaped"] else 0
    print("%s chaos: %d failure modes"%(LABEL,len(r["results"])))
    for x in r["results"]:
        tag=(G+"contained"+RST) if x["contained"] else (R+"ESCAPED"+RST)
        print("  %s %-10s -> %s"%(tag,x["failure"],x["result"]))
    if r["escaped"]: print(R+"%d escaped"%len(r["escaped"])+RST); return 1
    print(G+"containment contract holds"+RST)
    return 0

if __name__ == "__main__":
    sys.exit(main())
