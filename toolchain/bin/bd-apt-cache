#!/usr/bin/env python3
"""bd-apt-cache -- Apt-Cacher-NG integration for container and VM OS package updates.

Configures /etc/apt/apt.conf.d/01proxy targeting http://127.0.0.1:3142 during
worker initialization to accelerate package installs and reduce WAN bandwidth.
Provides automatic fail-open bypass if the proxy service is unreachable.

Usage:
  bd-apt-cache [--configure] [--proxy-url URL] [--proxy-file PATH]
  bd-apt-cache --bypass [--proxy-file PATH]
  bd-apt-cache --status [--proxy-url URL] [--proxy-file PATH]
  bd-apt-cache --check [--proxy-url URL]
  bd-apt-cache --benchmark-fetch --package-path PATH [--proxy-url URL]
  bd-apt-cache --selftest
  bd-apt-cache --json ...
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer

DEFAULT_PROXY_URL = os.environ.get("BD_APT_CACHE_URL", "http://127.0.0.1:3142")
DEFAULT_PROXY_FILE = os.environ.get("BD_APT_PROXY_FILE", "/etc/apt/apt.conf.d/01proxy")
DEFAULT_TIMEOUT = 1.0


def probe_proxy(proxy_url: str, timeout: float = DEFAULT_TIMEOUT) -> tuple[bool, str]:
    """Probe whether the Apt-Cacher-NG proxy is responsive."""
    parsed = urllib.parse.urlparse(proxy_url)
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or 3142

    # Step 1: Fast TCP connect check
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect((host, port))
    except (OSError, socket.timeout) as exc:
        return False, f"TCP connection failed: {exc}"

    # Step 2: HTTP probe check
    report_url = f"{proxy_url.rstrip('/')}/acng-report.html"
    try:
        req = urllib.request.Request(
            report_url,
            headers={"User-Agent": "bd-apt-cache-probe/1.0"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status = resp.getcode()
            if 200 <= status < 400:
                return True, f"HTTP {status}"
    except (urllib.error.URLError, OSError, TimeoutError):
        # Even if acng-report.html is disabled or 404s, TCP connection succeeded.
        pass

    return True, "TCP connected"


def generate_proxy_config(proxy_url: str) -> str:
    """Generate apt proxy configuration text."""
    normalized_url = proxy_url.rstrip("/")
    return (
        "// Generated by bd-apt-cache (Row 843)\n"
        f'Acquire::http::Proxy "{normalized_url}";\n'
    )


def _safe_write_file(path: str, content: str) -> tuple[bool, str | None]:
    """Write file with permission error handling and optional sudo fallback."""
    try:
        parent_dir = os.path.dirname(path)
        if parent_dir:
            os.makedirs(parent_dir, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
        return True, None
    except (PermissionError, OSError) as exc:
        # Fallback: try sudo -n if available and not disabled by unprivileged env
        if os.environ.get("BD_APT_NO_SUDO") != "1" and shutil.which("sudo"):
            try:
                proc = subprocess.run(
                    ["sudo", "-n", "tee", path],
                    input=content,
                    text=True,
                    capture_output=True,
                    timeout=5,
                )
                if proc.returncode == 0:
                    return True, None
            except Exception:
                pass
        return False, f"Permission denied writing {path}: {exc}"


def _safe_remove_file(path: str) -> tuple[bool, str | None]:
    """Remove file with permission error handling and optional sudo fallback."""
    if not os.path.exists(path):
        return True, None
    try:
        os.remove(path)
        return True, None
    except (PermissionError, OSError) as exc:
        if os.environ.get("BD_APT_NO_SUDO") != "1" and shutil.which("sudo"):
            try:
                proc = subprocess.run(
                    ["sudo", "-n", "rm", "-f", path],
                    capture_output=True,
                    timeout=5,
                )
                if proc.returncode == 0:
                    return True, None
            except Exception:
                pass
        return False, f"Permission denied removing {path}: {exc}"


def bypass_proxy(proxy_file: str = DEFAULT_PROXY_FILE) -> dict:
    """Remove apt proxy configuration to allow unproxied WAN fetches."""
    if os.path.exists(proxy_file):
        ok, err = _safe_remove_file(proxy_file)
        if not ok:
            return {
                "success": False,
                "bypass_active": False,
                "removed": False,
                "proxy_file": proxy_file,
                "error": err,
            }
        return {
            "success": True,
            "bypass_active": True,
            "removed": True,
            "proxy_file": proxy_file,
        }
    return {
        "success": True,
        "bypass_active": True,
        "removed": False,
        "proxy_file": proxy_file,
        "reason": "Proxy file did not exist",
    }


def configure_proxy(
    proxy_url: str = DEFAULT_PROXY_URL,
    proxy_file: str = DEFAULT_PROXY_FILE,
    timeout: float = DEFAULT_TIMEOUT,
    force: bool = False,
) -> dict:
    """Configure APT proxy if reachable; automatically bypass if unreachable."""
    is_up, reason = probe_proxy(proxy_url, timeout=timeout)

    if is_up or force:
        config_text = generate_proxy_config(proxy_url)
        ok, err = _safe_write_file(proxy_file, config_text)
        if not ok:
            return {
                "success": False,
                "proxy_available": is_up,
                "configured": False,
                "bypass_active": False,
                "proxy_url": proxy_url,
                "proxy_file": proxy_file,
                "error": err,
            }
        return {
            "success": True,
            "proxy_available": True,
            "configured": True,
            "bypass_active": False,
            "proxy_url": proxy_url,
            "proxy_file": proxy_file,
            "probe_reason": reason,
        }

    # Proxy is unreachable: automatic fail-open bypass
    bypass_res = bypass_proxy(proxy_file)
    return {
        "success": bypass_res["success"],
        "proxy_available": False,
        "configured": False,
        "bypass_active": True,
        "proxy_url": proxy_url,
        "proxy_file": proxy_file,
        "probe_reason": reason,
        "bypass_details": bypass_res,
    }


def get_status(
    proxy_url: str = DEFAULT_PROXY_URL,
    proxy_file: str = DEFAULT_PROXY_FILE,
    timeout: float = DEFAULT_TIMEOUT,
) -> dict:
    """Get current proxy reachability and active apt configuration status."""
    is_up, reason = probe_proxy(proxy_url, timeout=timeout)
    is_configured = False
    current_content = None

    if os.path.isfile(proxy_file):
        try:
            with open(proxy_file, "r", encoding="utf-8") as f:
                current_content = f.read()
                if "Acquire::http::Proxy" in current_content:
                    is_configured = True
        except (PermissionError, OSError):
            pass

    return {
        "proxy_available": is_up,
        "configured": is_configured,
        "proxy_url": proxy_url,
        "proxy_file": proxy_file,
        "probe_reason": reason,
        "content_length": len(current_content) if current_content else 0,
    }


def benchmark_fetch(
    proxy_url: str,
    package_path: str,
    timeout: float = 10.0,
) -> dict:
    """Benchmark fetching a package path through the proxy, measuring latency and hit status."""
    target_url = f"{proxy_url.rstrip('/')}/{package_path.lstrip('/')}"
    req = urllib.request.Request(
        target_url,
        headers={"User-Agent": "bd-apt-cache-benchmark/1.0"},
    )

    t0 = time.perf_counter()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            content = resp.read()
            elapsed_sec = time.perf_counter() - t0
            elapsed_ms = elapsed_sec * 1000.0

            cache_hdr = resp.headers.get("X-Apt-Cache", "")
            if not cache_hdr:
                # Infer from latency: under 500ms is warm hit, over is cold miss
                cache_hdr = "HIT" if elapsed_ms < 500 else "MISS"

            return {
                "success": True,
                "status_code": resp.getcode(),
                "bytes_received": len(content),
                "elapsed_ms": round(elapsed_ms, 2),
                "cache_status": cache_hdr.upper(),
            }
    except Exception as exc:
        elapsed_ms = (time.perf_counter() - t0) * 1000.0
        return {
            "success": False,
            "error": str(exc),
            "elapsed_ms": round(elapsed_ms, 2),
            "cache_status": "ERROR",
        }


def run_selftest() -> bool:
    """Hermetic internal self-test for bd-apt-cache."""
    print("Running bd-apt-cache hermetic selftest...")

    # Ephemeral mock HTTP server
    class SelftestHandler(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path == "/acng-report.html":
                self.send_response(200)
                self.end_headers()
                self.wfile.write(b"OK")
            elif self.path == "/deb/test.deb":
                self.send_response(200)
                self.send_header("X-Apt-Cache", "HIT")
                self.end_headers()
                self.wfile.write(b"PKG_DATA")
            else:
                self.send_response(404)
                self.end_headers()

        def log_message(self, *args):
            pass

    server = HTTPServer(("127.0.0.1", 0), SelftestHandler)
    port = server.server_address[1]
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()

    temp_proxy_file = f"/tmp/bd_apt_selftest_{os.getpid()}_{time.time_ns()}.conf"
    try:
        url = f"http://127.0.0.1:{port}"
        # Test 1: Probe
        ok, _ = probe_proxy(url)
        assert ok, "Probe failed on live mock server"

        # Test 2: Configure
        res = configure_proxy(proxy_url=url, proxy_file=temp_proxy_file)
        assert res["success"] and res["configured"]
        assert os.path.exists(temp_proxy_file)

        # Test 3: Status
        status = get_status(proxy_url=url, proxy_file=temp_proxy_file)
        assert status["proxy_available"] and status["configured"]

        # Test 4: Benchmark
        bench = benchmark_fetch(url, "/deb/test.deb")
        assert bench["success"] and bench["cache_status"] == "HIT"

        # Test 5: Bypass
        b_res = bypass_proxy(proxy_file=temp_proxy_file)
        assert b_res["success"] and not os.path.exists(temp_proxy_file)

        print("SELFTEST PASS")
        return True
    except Exception as exc:
        print(f"SELFTEST FAIL: {exc}")
        return False
    finally:
        server.shutdown()
        server.server_close()
        thread.join(timeout=1)
        if os.path.exists(temp_proxy_file):
            os.remove(temp_proxy_file)


def main() -> int:
    parser = argparse.ArgumentParser(description="Apt-Cacher-NG proxy configuration tool")
    parser.add_argument("--configure", action="store_true", help="Configure apt proxy")
    parser.add_argument("--bypass", action="store_true", help="Remove apt proxy configuration")
    parser.add_argument("--status", action="store_true", help="Check apt proxy status")
    parser.add_argument("--check", action="store_true", help="Probe proxy reachability")
    parser.add_argument("--benchmark-fetch", action="store_true", help="Benchmark package fetch")
    parser.add_argument("--package-path", type=str, default="", help="Package path for benchmark")
    parser.add_argument("--proxy-url", type=str, default=DEFAULT_PROXY_URL, help="Proxy base URL")
    parser.add_argument("--proxy-file", type=str, default=DEFAULT_PROXY_FILE, help="Path to apt proxy config")
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="Probe timeout in seconds")
    parser.add_argument("--force", action="store_true", help="Force configuration even if probe fails")
    parser.add_argument("--selftest", action="store_true", help="Run internal self-tests")
    parser.add_argument("--json", action="store_true", help="Emit output as JSON")

    args = parser.parse_args()

    if args.selftest:
        return 0 if run_selftest() else 1

    if args.check:
        is_up, reason = probe_proxy(args.proxy_url, timeout=args.timeout)
        data = {"available": is_up, "reason": reason, "proxy_url": args.proxy_url}
        if args.json:
            print(json.dumps(data, indent=2))
        else:
            print(f"Proxy {args.proxy_url} is {'AVAILABLE' if is_up else 'UNAVAILABLE'} ({reason})")
        return 0 if is_up else 1

    if args.bypass:
        res = bypass_proxy(args.proxy_file)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            if res["success"]:
                print(f"Proxy bypassed. Removed {args.proxy_file}: {res.get('removed', False)}")
            else:
                print(f"WARN: could not bypass proxy: {res.get('error')}", file=sys.stderr)
        return 0

    if args.status:
        res = get_status(args.proxy_url, args.proxy_file, timeout=args.timeout)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"Proxy available: {res['proxy_available']}")
            print(f"Proxy configured: {res['configured']} ({args.proxy_file})")
        return 0

    if args.benchmark_fetch:
        if not args.package_path:
            print("Error: --package-path required for --benchmark-fetch", file=sys.stderr)
            return 2
        res = benchmark_fetch(args.proxy_url, args.package_path, timeout=args.timeout or 10.0)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"Fetch status: {res.get('cache_status')} in {res.get('elapsed_ms')}ms")
        return 0 if res.get("success") else 1

    # Default action or --configure
    res = configure_proxy(
        proxy_url=args.proxy_url,
        proxy_file=args.proxy_file,
        timeout=args.timeout,
        force=args.force,
    )
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        if res.get("configured"):
            print(f"Apt proxy configured at {args.proxy_file} targeting {args.proxy_url}")
        elif res.get("bypass_active"):
            print(f"Apt proxy bypassed (proxy unreachable: {res.get('probe_reason')})")
        else:
            print(f"WARN: could not configure proxy: {res.get('error')}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
