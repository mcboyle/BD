#!/usr/bin/env python3
"""bd-secret-fixture -- generate a fake-secret test corpus (deterministic).

Emits synthetic-but-realistic secret material for negative-control testing of
scrubbers/scanners: JWTs, API keys (AWS/generic), bearer tokens, cookies,
signed/expiring URLs, CSRF tokens, private-key headers, high-entropy opaque
runs. All values are FAKE (fixed seed, obvious sentinels) -- never real
secrets. Consumed by bd-secret-canary and the fuzz tools. Read-only (prints).

Usage:
    bd-secret-fixture [--n N] [--kinds jwt,apikey,...] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse
import base64
import hashlib
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, DIM, RST = "\033[32m", "\033[2m", "\033[0m"

SENTINEL = "FAKEsecret"  # every generated value carries this so nothing is real


def _det(seed):
    return hashlib.sha256(seed.encode()).hexdigest()


def gen(kind, i):
    h = _det(f"{kind}:{i}:{SENTINEL}")
    if kind == "jwt":
        hdr = base64.urlsafe_b64encode(b'{"alg":"HS256","typ":"JWT"}').decode().rstrip("=")
        pay = base64.urlsafe_b64encode(
            json.dumps({"sub": f"fake{i}", "s": SENTINEL}).encode()).decode().rstrip("=")
        return f"{hdr}.{pay}.{SENTINEL}{h[:22]}"
    if kind == "apikey":
        return f"AKIA{h[:12].upper()}{SENTINEL}"  # AWS-shaped, fake
    if kind == "generic":
        return f"api_key={SENTINEL}{h[:24]}"
    if kind == "bearer":
        return f"Bearer {SENTINEL}{h[:28]}"
    if kind == "cookie":
        return f"session={SENTINEL}{h[:20]}; Path=/; HttpOnly"
    if kind == "signed_url":
        return (f"https://cdn.example.com/v/{i}.m3u8?token={SENTINEL}{h[:16]}"
                f"&signature={h[16:40]}&expires=1999999999")
    if kind == "csrf":
        return f"csrf_token={SENTINEL}{h[:24]}"
    if kind == "privkey":
        return "-----BEGIN PRIVATE KEY-----\n" + SENTINEL + h[:40] + "\n-----END PRIVATE KEY-----"
    if kind == "opaque":
        return SENTINEL + h  # 64-hex high-entropy run
    return SENTINEL + h[:16]


ALL_KINDS = ["jwt", "apikey", "generic", "bearer", "cookie", "signed_url",
             "csrf", "privkey", "opaque"]


def corpus(n, kinds):
    out = []
    for kind in kinds:
        for i in range(n):
            out.append({"kind": kind, "value": gen(kind, i)})
    return out


def selftest():
    ok = True
    a = corpus(2, ALL_KINDS)
    b = corpus(2, ALL_KINDS)
    det = [x["value"] for x in a] == [x["value"] for x in b]
    print(("PASS" if det else "FAIL") + f"  deterministic ({len(a)} entries x2)")
    ok &= det
    all_fake = all(SENTINEL in x["value"] for x in a)
    print(("PASS" if all_fake else "FAIL") + "  every value carries the FAKE sentinel")
    ok &= all_fake
    kinds = {x["kind"] for x in a}
    print(("PASS" if kinds == set(ALL_KINDS) else "FAIL") + f"  all kinds present ({len(kinds)})")
    ok &= kinds == set(ALL_KINDS)
    # JWT looks like a JWT (matches bd-secrets' pattern)
    import re
    jwt = next(x["value"] for x in a if x["kind"] == "jwt")
    jwtok = bool(re.match(r'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+', jwt))
    print(("PASS" if jwtok else "FAIL") + f"  JWT shape valid ({jwt[:24]}...)")
    ok &= jwtok
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--n", type=int, default=3)
    ap.add_argument("--kinds", default=None)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    kinds = [k for k in (a.kinds.split(",") if a.kinds else ALL_KINDS) if k in ALL_KINDS]
    c = corpus(a.n, kinds)
    if sec.emit({"corpus": c, "sentinel": SENTINEL, "count": len(c)}, as_json=a.json):
        return 0
    print(f"{DIM}fake-secret corpus ({len(c)} entries, sentinel={SENTINEL}){RST}")
    for x in c:
        print(f"  {G}{x['kind']:<11}{RST} {x['value'][:70]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
