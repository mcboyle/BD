#!/usr/bin/env python3
"""bd-doc-truth -- compare docs to source behavior.

WHAT IT ACTUALLY CHECKS, stated narrowly on purpose: backticked
`bulk_downloader/...py` file-path claims that no longer resolve against the
work tree -> BD-DOC-STALE. That is ONE detector.

THE CORPUS IS THE PK DOCS *PLUS* THE ROOT-LEVEL DOCUMENTS (@929). Until then
it was project-knowledge only -- 65 documents, and CLAUDE.md in none of them.
The operating contract, which outranks every document this gate did check, was
the one document nothing checked, and CLAUDE.md section 0 records what that
cost in its own words: "THE FRESHNESS GATE CANNOT SEE THIS FILE, WHICH IS WHY
THIS FILE WENT STALE."

The widening is DERIVED rather than keyed on a filename: every `*.md` at the
work root joins the corpus. A gate that can see the contract only because
someone typed its name goes blind again the next time a root document appears.

CHANGELOG.md is EXCLUDED, and the exclusion is REPORTED rather than silent.
Measured at v3.66.928: 53 backticked references, of which 2 no longer resolve
(`deep_detect.py`, `dev_suite.py` -- both since split into packages). Those
entries were true when written; rewriting history to satisfy a gate falsifies
the record. A silent exclusion is how a denominator rots, so both the count
and the reason are printed.

This docstring used to also advertise version-claim, tool-count and route-count
checks. The code has never implemented them. A tool's own docstring is a
document and goes stale like any other (CLAUDE.md section 1); claiming coverage
that does not exist is how a narrow detector gets read as a broad one.

Usage: bd-doc-truth [--docs DIR] [--work DIR] [--json] [--selftest]

EXIT IS A VERDICT, NOT A FORMALITY (@850):
  0  scanned >=1 document, found nothing stale
  1  found at least one stale claim
  2  CANNOT EVALUATE -- the docs dir is absent, or contains no .md at all

Until @850 this returned 0 unconditionally and `--docs` defaulted to
/mnt/project, a path from the retired sandbox that no git checkout has. Since
bd-freshcheck:193 invokes it with NO ARGUMENTS, the wired path scanned zero
documents and reported clean -- inside a CI gate. Both halves had to be fixed:
aiming it at real docs while main() still returned 0 would have left it equally
blind, because check_delegate maps rc0 -> OK.
"""
import argparse, glob, os, re, subprocess, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def current_version(work):
    p=os.path.join(work,"bulk_downloader","__init__.py")
    if os.path.exists(p):
        m=re.search(r'__version__\s*=\s*["\']([^"\']+)',open(p).read())
        if m: return m.group(1)
    return None

# Documents that are an APPEND-ONLY HISTORICAL RECORD. Their claims were true
# when written, so a reference that no longer resolves is a fact about the
# past, not a stale claim -- and "fixing" one to satisfy a gate falsifies the
# record. Excluded by name, reported by main(), never dropped silently.
HISTORICAL_DOCS={
    "CHANGELOG.md": "append-only historical record; its references describe "
                    "the tree as it was, not as it is",
}

# This is deliberately a narrow publication vocabulary, not a claim that NLP
# can recognise every count in English.  ``THE POPULATION`` is the explicit
# marker used by register rows when a number is meant to be complete.  The
# derivation words below are evidence labels, not proof that the derivation is
# correct; this gate prevents an unlabelled survey result from reading as one.
_PUBLISHED_POPULATION = re.compile(r"\bTHE\s+POPULATION\b")
_NUMERIC_CLAIM = re.compile(r"(?<![A-Za-z0-9_])\d[\d,]*(?:\.\d+)?(?![A-Za-z0-9_])")
_STATED_DERIVATION = re.compile(
    r"\b(?:DERIV(?:ED|ATION)|RE-COUNTED|MEASURED|CENSUS|PARSED|"
    r"HAND-LABELLED|REPRODUCED|ESTABLISHED|CONFIRMED)\b",
    re.IGNORECASE,
)


def _markdown_prose(text):
    """Remove fenced examples and comments before classifying prose claims."""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)
    return re.sub(r"^\s*```.*?^\s*```\s*$", "", text,
                  flags=re.DOTALL | re.MULTILINE)


def _published_population_findings(name, text):
    """Return (numeric publication count, underived findings)."""
    prose = _markdown_prose(text)
    published = 0
    findings = []
    for marker in _PUBLISHED_POPULATION.finditer(prose):
        start = max(0, marker.start() - 320)
        end = min(len(prose), marker.end() + 320)
        window = prose[start:end]
        if not _NUMERIC_CLAIM.search(window):
            continue
        published += 1
        if _STATED_DERIVATION.search(window):
            continue
        line = prose.count("\n", 0, marker.start()) + 1
        excerpt = " ".join(window.split())[:240]
        findings.append({
            "doc": name,
            "kind": "underived-population",
            "claim": "line %d: %s" % (line, excerpt),
        })
    return published, findings


def contract_docs(work):
    """The root-level documents, split into (included, excluded).

    Returns excluded as [(path, why)] so the caller can NAME what it did not
    look at. A corpus that quietly omits a document reports a count the reader
    will over-read as coverage -- section 0's subject, applied to this tool's
    own denominator.
    """
    included, excluded = [], []
    for f in sorted(glob.glob(os.path.join(work,"*.md"))):
        why=HISTORICAL_DOCS.get(os.path.basename(f))
        (excluded.append((f,why)) if why else included.append(f))
    return included, excluded


def scan(docs, work, extra=(), files=None, historical_excluded=0):
    cur=current_version(work)
    stale=[]
    # docs_scanned is not cosmetic: it is the DENOMINATOR, and reporting a
    # count without it is exactly how "0 stale claims" over zero documents read
    # as clean for as long as it did.
    files=(sorted(glob.glob(os.path.join(docs,"*.md")))+list(extra)
           if files is None else list(files))
    published_population_claims = 0
    underived_population_claims = 0
    # file-path claims: `some/path.py` references that don't exist
    for f in files:
        name=os.path.relpath(f,work).replace(os.sep,"/")
        txt=open(f,errors="ignore").read()
        for m in re.finditer(r'`(bulk_downloader/[a-zA-Z0-9_/]+\.py)`',txt):
            path=m.group(1)
            if not os.path.exists(os.path.join(work,path)):
                stale.append({"doc":name,"kind":"missing-file","claim":path})
        published, underived = _published_population_findings(name, txt)
        published_population_claims += published
        underived_population_claims += len(underived)
        stale.extend(underived)
    return {"current_version":cur,"stale":stale[:60],"stale_count":len(stale),
            "docs_dir":docs,"docs_scanned":len(files),
            "current_docs":len(files),
            "published_population_claims":published_population_claims,
            "underived_population_claims":underived_population_claims,
            "historical_excluded":historical_excluded,
            "docs_dir_exists":os.path.isdir(docs)}

def selftest():
    """Every case below is a NEGATIVE control except the last two.

    The pre-@850 selftest called scan("/mnt/project", ...) and then asserted
    only that a version string could be read -- which comes from --work, not
    from --docs. So it passed at full volume while the docs corpus it was
    pointed at did not exist. A selftest whose inputs are all well-formed
    cannot see the case the environment actually produced.
    """
    import tempfile
    ok=True
    def chk(cond,label):
        nonlocal ok
        ok = ok and bool(cond)
        print(("PASS" if cond else "FAIL")+"  "+label)

    chk(bool(current_version(sec.DEFAULT_WORK)),
        "current version read from --work (%s)"%current_version(sec.DEFAULT_WORK))

    # The default must resolve inside the tree, not onto a retired sandbox path.
    d=default_docs(sec.DEFAULT_WORK)
    chk(os.path.isdir(d), "default --docs resolves to a real dir (%s)"%d)
    chk("/mnt/" not in d, "default --docs is not a sandbox absolute path")

    with tempfile.TemporaryDirectory() as td:
        # NEG: absent dir -> 2. The exact shape of the shipped defect.
        r=scan(os.path.join(td,"nope"),sec.DEFAULT_WORK)
        chk(verdict(r)==sec.EXIT_CANNOT_EVALUATE,
            "NEG absent docs dir -> CANNOT-EVALUATE (got %d)"%verdict(r))

        # NEG: present but empty -> 2, NOT a clean 0.
        e=os.path.join(td,"empty"); os.makedirs(e)
        r=scan(e,sec.DEFAULT_WORK)
        chk(verdict(r)==sec.EXIT_CANNOT_EVALUATE,
            "NEG empty docs dir -> CANNOT-EVALUATE (got %d)"%verdict(r))

        # POS: a genuinely stale claim -> 1, and the claim is named.
        b=os.path.join(td,"bad"); os.makedirs(b)
        open(os.path.join(b,"x.md"),"w").write(
            "See `bulk_downloader/does_not_exist.py` for details.\n")
        r=scan(b,sec.DEFAULT_WORK)
        chk(verdict(r)==1 and any("does_not_exist" in x["claim"] for x in r["stale"]),
            "stale missing-file claim -> 1 and is named (%d found)"%r["stale_count"])

        # POS/OVER-SENSITIVITY: a real file must NOT be flagged. A detector
        # that fires on everything gets switched off, which section 0 counts
        # as the equal of a false clean.
        g=os.path.join(td,"good"); os.makedirs(g)
        open(os.path.join(g,"y.md"),"w").write(
            "See `bulk_downloader/__init__.py`, which exists.\n")
        r=scan(g,sec.DEFAULT_WORK)
        chk(verdict(r)==0 and r["docs_scanned"]==1,
            "clean non-empty corpus -> 0 over a denominator of 1 (got %d/%d)"
            %(verdict(r),r["docs_scanned"]))

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def default_docs(work):
    """The PK docs of THIS tree. Resolved from --work so a relocated checkout
    follows it, rather than a literal that only existed in one sandbox."""
    return os.path.join(work,"project-knowledge")


def verdict(r):
    """0 clean / 1 stale / 2 cannot-evaluate. Split out so the selftest can
    assert the mapping directly instead of only through a subprocess.

    Keyed on the TOTAL scanned rather than on docs_dir_exists, so the @850
    negative controls survive the @929 widening: an explicitly empty --docs
    corpus still scans zero documents and is still UNKNOWN. Keying it on the
    directory alone would have let root documents from --work mask an empty
    corpus, which is the exact defect @850 fixed.
    """
    if r["docs_scanned"]==0:
        return sec.EXIT_CANNOT_EVALUATE
    return 1 if r["stale_count"] else 0


def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--docs",default=None); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    # An explicit --docs means "scan exactly this corpus", so the root
    # documents join only the DEFAULT invocation -- the one bd-freshcheck runs.
    # That keeps @850's empty/absent-corpus controls meaningful.
    explicit=a.docs is not None
    docs=a.docs if explicit else default_docs(a.work)
    if explicit:
        included,excluded=(),()
        r=scan(docs,a.work)
    else:
        try:
            current,historical=sec.tracked_markdown_corpus(a.work)
        except (OSError,RuntimeError,subprocess.SubprocessError) as exc:
            print("BD-DOC-TRUTH UNEVALUABLE -- %s"%exc,file=sys.stderr)
            return sec.EXIT_CANNOT_EVALUATE
        included=[os.path.join(a.work,p) for p in current]
        excluded=[(os.path.join(a.work,p),"tracked historical evidence") for p in historical]
        r=scan(docs,a.work,files=included,historical_excluded=len(excluded))
    r["contract_scanned"]=sum(
        1 for f in included if len(os.path.relpath(f,a.work).split(os.sep)) == 1)
    r["excluded"]=[{"doc":os.path.basename(f),"why":w} for f,w in excluded]
    rc=verdict(r)
    # The verdict is computed BEFORE emit(), because emit() returns True for
    # --json and the old code returned 0 on that branch without ever grading.
    if sec.emit(r,as_json=a.json): return rc
    if rc==sec.EXIT_CANNOT_EVALUATE:
        why=("does not exist" if not r["docs_dir_exists"] else "contains no .md files")
        print("%sBD-DOC-TRUTH UNEVALUABLE%s %s %s -- 0 documents scanned. That is "
              "UNKNOWN, not clean."%(R,RST,docs,why))
        return rc
    print("current version %s; %d document(s) scanned in %s (+%d root document(s)); "
          "%d stale doc claim(s):"
          %(r["current_version"],r["docs_scanned"]-r.get("contract_scanned",0),
            docs,r.get("contract_scanned",0),r["stale_count"]))
    # Never silent: what was NOT looked at is part of the denominator too.
    for x in r.get("excluded",[]):
        print("  %sexcluded%s %s -- %s"%(DIM,RST,x["doc"],x["why"]))
    for x in r["stale"][:40]: print("  %sBD-DOC-STALE%s %s: %s (%s)"%(Y,RST,x["doc"],x["claim"],x["kind"]))
    if not r["stale"]: print(G+"no stale file-path claims in %d document(s)"%r["docs_scanned"]+RST)
    return rc

if __name__ == "__main__":
    sys.exit(main())
