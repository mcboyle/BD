#!/usr/bin/env python3
"""bd-precut -- predict + GATE a release cut before you bump/build.

Three checks, each delegating to the authoritative source (no re-derived models):
  1. precut_check.py     -- version/pin consistency, changed-file surface, guards.
  2. in-sync GENERATORS  -- runs the actual in-sync gate tests (they regenerate the
                            derived doc in-process and diff vs source). This catches
                            a FUNCTION_INDEX/ROUTE_INDEX/etc that is stale vs source
                            -- the class the old file-diff prediction MISSED (F-03).
  3. bd-envscan (v2)     -- the exact env_vars that would fail the env-tranche gate
                            (delegates to config_surface_inventory). Catches the
                            BD_-literal trap (F-01) the old flow shipped at v3.66.699.

Usage:
  bd-precut [--baseline ZIP] [--root DIR] [--json]        # advisory (exit 0)
  bd-precut --gate [...]                                  # BLOCKING: exit != 0 if any
                                                          #   real problem -> gate a cut:
                                                          #   bd-precut --gate && bd-cut ...
  bd-precut --no-insync / --no-envscan                   # skip a check
"""
import argparse, atexit, glob, json, os, pathlib, re, shutil, subprocess, sys, tempfile, zipfile

# Placed AFTER the whole import block on purpose: inserting above `import sys`
# leaves sys undefined at the insertion point and --help dies with NameError,
# while ast.parse still accepts the file (the v3.66.851 trap).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402  -- DEFAULT_WORK follows a relocated checkout

IN_SYNC = [
    "tests/test_function_index_in_sync.py",
    "tests/test_dependency_graph_in_sync.py",
    "tests/test_import_graph_no_new_edges.py",
    "tests/test_route_index_in_sync.py",
    "tests/test_endpoint_catalog_in_sync.py",
    "tests/test_pin_index_in_sync.py",
    "tests/test_route_map_invariant.py",
]


def _version(name):
    m = re.search(r"v?(\d+)[._](\d+)[._](\d+)", os.path.basename(name))
    return tuple(int(x) for x in m.groups()) if m else (0, 0, 0)


def _auto_baseline(root=None):
    """Newest release zip to diff against, or None.

    v3.66.855 port: the three sandbox globs (/mnt/user-data/uploads,
    /home/claude/out, /home/claude) are retired and can never match here, so the
    only honest default is the ONE place a zip can now appear -- <root>/out,
    which is where bd-cut --out writes. Returning None is the normal case in a
    git checkout, and the caller already says so out loud rather than pretending
    precut_check ran.
    """
    root = root or sec.DEFAULT_WORK
    found = [f for f in glob.glob(os.path.join(root, "out", "BulkDownloader_v*.zip"))
             if "overlay" not in os.path.basename(f).lower()]
    return max(found, key=_version) if found else None


def _derive_baseline(root, tmpdir):
    """Build the previous tree from git when there is no release zip.

    WHY THIS EXISTS. precut_check needs a snapshot of the tree the cut is being
    measured against; it happens to READ that snapshot from a zip. The release
    zip flow is retired here, so in a git checkout there was never a baseline
    and the version/pin/surface check NEVER RAN -- reported honestly as UNKNOWN,
    on every cut, forever. A permanent UNKNOWN is not a measurement: it held
    v3.66.1360 for hours and blocked v3.66.1378, and a verdict nobody can ever
    satisfy is one people learn to step over, which is worse than no verdict.

    origin/main is the snapshot the cut is actually measured against, and git
    can produce it exactly. THIS DOES NOT REVIVE THE RELEASE ZIP FLOW: the
    archive is a private temp file, never published, never a release artifact.

    Returns (path, reason). Exactly one is None. A failure returns the reason so
    the caller can keep saying UNKNOWN out loud instead of guessing.
    """
    if not os.path.isdir(os.path.join(root, ".git")) and not os.path.isfile(
            os.path.join(root, ".git")):
        return None, "not a git checkout, so no baseline can be derived"
    rev = subprocess.run(["git", "-C", root, "rev-parse", "--verify", "-q",
                          "origin/main^{commit}"], capture_output=True, text=True)
    if rev.returncode != 0 or not rev.stdout.strip():
        return None, "origin/main does not resolve here, so no baseline can be derived"
    sha = rev.stdout.strip()
    out = os.path.join(tmpdir, "baseline-origin-main.zip")
    ar = subprocess.run(["git", "-C", root, "archive", "--format=zip", "-o", out, sha],
                        capture_output=True, text=True)
    if ar.returncode != 0 or not os.path.isfile(out) or os.path.getsize(out) == 0:
        return None, f"git archive of {sha[:12]} produced no usable baseline"
    return out, None


def _auto_root():
    """v3.66.855 port: /home/claude/work is gone. sec.DEFAULT_WORK walks up from
    the shared library's own file to the checkout that owns this tool, so it is
    right from any cwd; cwd stays as the second rung for a tree that is not the
    one this tool was installed into."""
    for c in (sec.DEFAULT_WORK, os.getcwd()):
        if os.path.isdir(os.path.join(c, "bulk_downloader")):
            return c
    return os.getcwd()


def _run_insync(root):
    """Run the in-sync gate tests (authoritative staleness check). Returns
    (ok, detail). Degrades to (None, reason) if the harness can't run."""
    rt = os.path.join(root, "run_tests.py")
    if not os.path.isfile(rt):
        return None, "run_tests.py not found"
    present = [t for t in IN_SYNC if os.path.isfile(os.path.join(root, t))]
    if not present:
        return None, "no in-sync test files found"
    env = dict(os.environ)
    env.pop("BD_INSTALL_DIR", None)
    env["BD_HOME"] = tempfile.mkdtemp()
    env["BD_DISABLE_KEEPALIVE"] = "1"
    # v3.66.855 port: this used to CLOBBER PYTHONPATH with the retired prestaged
    # site-packages -- both a dead path and a destructive assignment, since a
    # caller's own PYTHONPATH was discarded. The deps now come from the venv that
    # is running us; the tree root is what the in-sync tests actually need.
    _prev = env.get("PYTHONPATH", "")
    env["PYTHONPATH"] = f"{root}:{_prev}" if _prev else root
    try:
        r = subprocess.run([sys.executable, "run_tests.py"] + present,
                           cwd=root, env=env, capture_output=True, text=True, timeout=180)
    except Exception as e:
        return None, f"harness error: {e}"
    out = r.stdout + r.stderr
    m = re.search(r"Failed:\s*(\d+)", out)
    failed = int(m.group(1)) if m else (0 if r.returncode == 0 else 1)
    fails = re.findall(r"FAIL\s+(\S+)", out)
    return (failed == 0), (fails[:8] if failed else "all in-sync gates green")


def _run_envscan(root):
    """Run bd-envscan (v2). Returns (ok, open_env_vars)."""
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-envscan")
    try:
        r = subprocess.run([sys.executable, exe, "--tree", root, "--json"],
                           capture_output=True, text=True, timeout=120)
        import json
        d = json.loads(r.stdout) if r.stdout.strip().startswith("{") else {}
        ev = d.get("open_env_vars", [])
        return (not ev), ev
    except Exception as e:
        return None, f"envscan error: {e}"


def selftest():
    """DELEGATE: wraps bd-coretest. Asserts the target file is present in the tool's own
    bin dir -- if not, FAIL (a wrapper that cannot find what it wraps is broken;
    a selftest that cannot verify must not report success)."""
    import os as _o
    here = _o.path.dirname(_o.path.realpath(__file__))
    found = _o.path.isfile(_o.path.join(here, "bd-coretest"))
    print(("PASS" if found else "FAIL") + "  delegation target present: bd-coretest")
    print("SELFTEST PASS" if found else "SELFTEST FAIL")
    return 0 if found else 1


def check_release_trio(root, baseline=None):
    """Return None when A6's tree facts agree, otherwise a blocking reason.

    ``baseline`` supplies the independent previous-header identity.  Without it
    top-entry agreement and ASCII are still measured, but a changed release
    cannot prove which exact header it was prepended above.
    """
    root = pathlib.Path(root)
    try:
        init = (root / "bulk_downloader" / "__init__.py").read_text(encoding="utf-8")
        match = re.search(r'^__version__ = "([^"]+)"', init, re.M)
        if not match:
            return "bulk_downloader/__init__.py declares no __version__"
        version = match.group(1)

        pin = (root / "tests" / "test_settings_center_slice4.py").read_text(
            encoding="utf-8"
        )
        if ('__version__ == "%s"' % version) not in pin:
            return ("the version pin in tests/test_settings_center_slice4.py "
                    "does not name %s" % version)

        changelog = (root / "CHANGELOG.md").read_text(encoding="utf-8")
        headers = list(re.finditer(r"^## (v\S+).*?$", changelog, re.M))
        if not headers:
            return "CHANGELOG.md has no release header"
        if headers[0].group(1) != "v" + version:
            return ("CHANGELOG.md's top entry is %s, not v%s -- the entry must "
                    "be PREPENDED and anchored on the previous release"
                    % (headers[0].group(1), version))

        entry_end = headers[1].start() if len(headers) > 1 else len(changelog)
        body = changelog[headers[0].start():entry_end]
        nonascii = [char for char in body if ord(char) > 127]
        if nonascii:
            return ("the %s CHANGELOG entry contains %d non-ASCII character(s) "
                    "(%r) -- A6 requires ASCII-only"
                    % (headers[0].group(1), len(nonascii), nonascii[:4]))

        if baseline is None:
            return ("previous release baseline is absent, so the exact prior "
                    "CHANGELOG header is UNMEASURED")
        with zipfile.ZipFile(baseline) as archive:
            baseline_changelog = archive.read("CHANGELOG.md").decode("utf-8")
        old_headers = list(
            re.finditer(r"^## (v\S+).*?$", baseline_changelog, re.M)
        )
        if not old_headers:
            return "baseline CHANGELOG.md has no previous release header"
        old_header = old_headers[0].group(0)
        if headers[0].group(0) != old_header:
            if len(headers) < 2 or headers[1].group(0) != old_header:
                got = headers[1].group(0) if len(headers) > 1 else "ABSENT"
                return ("CHANGELOG.md's new entry is not anchored on the previous "
                        "release header %r (found %r)" % (old_header, got))

        pin_index = root / "PIN_INDEX.json"
        if not pin_index.is_file():
            return "PIN_INDEX.json is absent -- the generated version pin is UNMEASURED"
        index = json.loads(pin_index.read_text(encoding="utf-8"))
        version_pins = [item for item in index.get("pins", [])
                        if item.get("form") == "version"]
        expected = [{"file": "tests/test_settings_center_slice4.py",
                     "value": version}]
        measured = [{"file": item.get("file"), "value": item.get("value")}
                    for item in version_pins]
        if measured != expected:
            return ("PIN_INDEX.json version-pin population differs: expected %r, "
                    "measured %r -- regenerate with bd-regen-order AFTER the last "
                    "source edit" % (expected, measured))
    except (OSError, UnicodeError, KeyError, TypeError, ValueError,
            zipfile.BadZipFile) as exc:
        return "release trio unreadable: %s" % exc
    return None


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bd-precut")
    ap.add_argument("--baseline")
    ap.add_argument("--root")
    ap.add_argument("--gate", action="store_true", help="exit != 0 on any real problem")
    ap.add_argument("--no-insync", action="store_true")
    ap.add_argument("--no-envscan", action="store_true")
    ap.add_argument("--no-coretest", action="store_true",
                    help="skip the tool-integrity check (bd-coretest, ~12s)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args(argv)
    if a.selftest:
        return selftest()

    root = a.root or _auto_root()
    tmpdir = tempfile.mkdtemp(prefix="bd-precut-baseline.")
    atexit.register(shutil.rmtree, tmpdir, True)
    derived_reason = None
    tracked_only = False
    baseline = a.baseline or _auto_baseline(root)
    if not baseline:
        baseline, derived_reason = _derive_baseline(root, tmpdir)
        tracked_only = baseline is not None
    print(f"== bd-precut{' --gate' if a.gate else ''} :: root={root}")
    if baseline:
        kind = "derived from origin/main" if tracked_only else "release zip"
        print(f"               baseline={os.path.basename(baseline)} ({kind})\n")

    blocking = []
    unknown = []          # checks that did NOT run -- never fold these into "OK"

    # 1. precut_check (version/pin/surface)
    tool = os.path.join(root, "tools", "precut_check.py")
    if os.path.isfile(tool) and baseline:
        cmd = [sys.executable, tool, "--baseline", baseline, "--root", root]
        if tracked_only:
            # BOTH SIDES MUST USE THE SAME DENOMINATOR. A git archive holds the
            # tracked set; build_release's walk holds the tracked set PLUS the
            # generated artifacts it would package. Comparing one against the
            # other reports every generated file as newly added, which is a
            # surface report that describes the tooling rather than the cut.
            cmd.append("--tracked-only")
        rc = subprocess.run(cmd, timeout=900).returncode
        if rc != 0:
            blocking.append("precut_check (version/pin/surface)")
    else:
        # v3.66.855 (CLAUDE.md s0): this branch is the COMMON case in a git
        # checkout -- there is no release zip to diff against -- and the final
        # verdict used to say "version/pin/surface OK" regardless. A verdict over
        # a check that never ran is exactly the gate-that-cannot-see-its-subject
        # shape. Record it as UNKNOWN and say so in the RESULT line.
        why = "no tools/precut_check.py" if not os.path.isfile(tool) else \
              (derived_reason or "no baseline available")
        print(f"  [precut_check NOT RUN -- {why}]\n")
        unknown.append(f"version/pin/surface (precut_check did not run: {why})")

    # 2. executable footgun registry (env-tranche F-01 + in-sync F-03 + route-map +
    #    import-edge + endpoint + pin + guard-sha) -- the single source of truth,
    #    so no lesson is forgotten and nothing is double-run.
    fge = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-footguns")
    if os.path.isfile(fge):
        rc = subprocess.run([sys.executable, fge, "--check", "--tree", root], timeout=900).returncode
        if rc == 3:
            blocking.append("footgun violation(s) -- see bd-footguns output above")
    else:
        print("  [bd-footguns not found -- footgun registry SKIPPED]")

    # 3. metric ratchets (Plan A2/F1): a cut must not regress a pinned metric
    #    (unwired operator endpoints, defect DP total, ...). Delegates to bd-ratchet.
    rex = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-ratchet")
    if os.path.isfile(rex):
        import subprocess as _sp
        rc = _sp.run([sys.executable, rex, "--check", "--tree", root], timeout=900).returncode
        if rc == 3:
            blocking.append("metric ratchet regressed -- see bd-ratchet output above")

    # 4. TOOL INTEGRITY (702): the gates above are only as trustworthy as the
    #    tools that run them. bd-coretest fault-injects the release-gating
    #    mutators (bd-cut/bd-bump/bd-regen/bd-guardcheck/...)
    #    and asserts each CATCHES an injected fault. It existed but NOTHING RAN IT
    #    -- a check that never runs is prose, not a gate (the whole thesis of the
    #    footgun registry). This program has already been bitten: bd-band-derive
    #    once shipped a near-constant band (a false-GREEN class bug) caught only by
    #    manual diffing. ~12s against a ~32s gate: cheap insurance that the tool
    #    about to cut a release is not itself broken.
    ct = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-coretest")
    if os.path.isfile(ct) and not a.no_coretest:
        import subprocess as _sp
        cp = _sp.run([sys.executable, ct], capture_output=True, text=True, timeout=900)
        tail = [ln for ln in cp.stdout.splitlines() if "CORE TOOLS PASSING" in ln]
        print("  [tool integrity] " + (tail[0].strip() if tail else
                                       "bd-coretest rc=%d" % cp.returncode))
        if cp.returncode != 0:
            blocking.append("core tool integrity FAILED -- a release-gating tool "
                            "does not catch an injected fault (bd-coretest)")
    elif a.no_coretest:
        print("  [tool integrity] SKIPPED (--no-coretest)")
        unknown.append("core tool integrity (--no-coretest)")
    else:
        print("  [bd-coretest not found -- tool integrity SKIPPED]")
        unknown.append("core tool integrity (bd-coretest not found)")

    print()
    # N-1. THE RELEASE TRIO, FROM GIT RATHER THAN FROM A ZIP.
    #
    # precut_check owns this, but it needs a baseline release zip and the zip
    # flow is retired in this checkout -- so it printed
    # "version/pin/surface NOT RUN" on EVERY invocation. An UNKNOWN that appears
    # every single time is worse than no line at all: it trains the reader to
    # skip the summary, which is where the real UNKNOWNs also live. This derives
    # the same three facts from the working tree.
    trio_problem = check_release_trio(root, baseline)
    if trio_problem:
        blocking.append("release trio: " + trio_problem)
    else:
        print("  [release trio] version, pin and CHANGELOG head agree; entry is ASCII")

    # N-2. CI SHARD HEADROOM.
    #
    # CLAUDE.md A5 forbids trimming a slow shard and requires splitting or
    # asking when one exceeds its budget -- but nothing MEASURED the budget, so
    # the first symptom of a squeeze is a timeout on somebody else's unrelated
    # cut. v3.66.1236 added 87s to one shard in a single cut (a gate went 3s to
    # 89.6s), which is the rate that makes this worth watching.
    #
    # ADVISORY BY CONSTRUCTION: it reads the LAST CI run, which is about a
    # different commit than the one being cut. A verdict from stale evidence is
    # not a verdict (A2), so this reports headroom and never blocks.
    try:
        wf = pathlib.Path(root, ".github", "workflows", "ci.yml").read_text(encoding="utf-8")
        cap = re.search(r"^\s*timeout-minutes:\s*(\d+)", wf, re.M)
        cap_s = int(cap.group(1)) * 60 if cap else None
        jobs = subprocess.run(
            ["gh", "run", "list", "--limit", "1", "--json", "databaseId",
             "--jq", ".[0].databaseId"],
            cwd=root, capture_output=True, text=True, timeout=120)
        run_id = jobs.stdout.strip()
        if cap_s and run_id:
            det = subprocess.run(
                ["gh", "run", "view", run_id, "--json", "jobs", "--jq",
                 ".jobs[] | select(.conclusion==\"success\") | "
                 "[.name, (((.completedAt|fromdate) - (.startedAt|fromdate))|tostring)] | @tsv"],
                cwd=root, capture_output=True, text=True, timeout=120)
            worst = None
            for line in det.stdout.splitlines():
                parts = line.split("\t")
                if len(parts) != 2:
                    continue
                try:
                    secs = int(float(parts[1]))
                except ValueError:
                    continue
                if worst is None or secs > worst[1]:
                    worst = (parts[0], secs)
            if worst:
                pct = 100.0 * worst[1] / cap_s
                print("  [shard headroom] slowest lane %r ran %ds of a %ds cap (%.0f%%)"
                      % (worst[0], worst[1], cap_s, pct))
                if pct >= 70.0:
                    print("      NOTE: past 70%% of the cap. A5 says SPLIT or ASK -- "
                          "never trim the shard to regain green.")
            else:
                unknown.append("CI shard headroom (no successful lane durations read)")
        else:
            unknown.append("CI shard headroom (no timeout-minutes or no recent run)")
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        unknown.append("CI shard headroom is UNKNOWN: %s" % exc)

    # N. THE GATES bd-band-derive DOES NOT DERIVE.
    #
    # WHY THIS CHECK EXISTS, and it is not four checks but one. Between
    # v3.66.1223 and v3.66.1238 the same integrator shipped four separate
    # defects that a gate ALREADY IN THIS TREE would have caught -- a mutation
    # anchor that resolved zero or two times (four times over), a subprocess
    # budget of 600s inside a 240s bound, and a subprocess inheriting the
    # ambient LC_ALL. None was a missing gate. Every one was a gate that exists
    # and did not RUN, because `bd-band-derive` derives an affected band from
    # CHANGED PATHS and these gates judge the TREE, so no diff ever reaches them.
    # Two were caught by GitHub CI after a push, each costing a re-run and a
    # force-push; the other two were caught by a battery that only ran because
    # someone remembered.
    #
    # A floor is not a ceiling (CLAUDE.md A5). This is the part of the ceiling
    # that is mechanical, so it belongs in a tool rather than in a habit.
    _UNDERIVED_GATES = [
        ("tests/test_v3_66_1184_mutation_specs_are_tracked.py",
         "every tracked mutant anchor occurs exactly once"),
        ("tests/test_row357_mutant_anchors_are_not_fragile.py",
         "no literal mutation anchor freezes a re-derived value"),
        ("tests/test_v3_66_1222_every_budget_is_subordinate_to_its_bound.py",
         "no inner budget is at or above the bound governing its item"),
        ("tests/test_v3_66_1197_ambient_locale_into_subprocess.py",
         "an env-inheriting subprocess pins LC_ALL"),
        ("tests/test_import_graph_no_new_edges.py",
         "no undeclared import edge"),
        # ADDED AT ROW 315, AND IT COST A CI CYCLE TO FIND. This is the
        # sys.modules leak RATCHET: it censuses EVERY tracked tests/*.py for a
        # file that drops `bulk_downloader.*` and never restores it, then
        # compares the count to a fixed budget. Its subject is the whole tree, so
        # bd-band-derive can never select it -- exactly the shape above
        # are here for -- yet it was missing from this list.
        #
        # MEASURED: on 2026-08-27 a candidate returned PRECUT_RC=0 and a GREEN
        # band of 1476 tests, then GitHub CI failed `gate-suites (isolation)`
        # with "14 files delete bulk_downloader.* from sys.modules without
        # restoring it, over a budget of 13". Precut is the pre-freeze floor and
        # it said cut-ready about a tree that was not.
        ("tests/test_v3_66_1034_guards_survive_a_module_wipe.py",
         "no new sys.modules leaker over the ratchet budget"),
    ]
    present = [(rel, why) for rel, why in _UNDERIVED_GATES
               if os.path.isfile(os.path.join(root, rel))]
    if not present:
        unknown.append("underived gates (none of the six are present in this tree)")
    else:
        # ASSERT THE POPULATION BEFORE THE VERDICT. A list that silently shrank
        # to one would still print a green line, which is the shape these gates
        # exist to refuse.
        if len(present) < len(_UNDERIVED_GATES):
            missing = [rel for rel, _ in _UNDERIVED_GATES
                       if not os.path.isfile(os.path.join(root, rel))]
            unknown.append("underived gates: %d of %d absent (%s)"
                           % (len(missing), len(_UNDERIVED_GATES), ", ".join(missing)))
        env = dict(os.environ)
        env.pop("BD_INSTALL_DIR", None)          # A5: pop, do not merely omit
        env["BD_DISABLE_KEEPALIVE"] = "1"
        rc = subprocess.run(
            [sys.executable, "-m", "pytest", "-q", "-p", "no:randomly",
             "--timeout=240", "--timeout-method=signal"] + [r for r, _ in present],
            cwd=root, env=env, timeout=1800).returncode
        if rc != 0:
            blocking.append(
                "underived gate(s) FAILED -- these judge the whole tree, so "
                "bd-band-derive never selects them and a green band says "
                "nothing about them: " + "; ".join(w for _, w in present))

    if blocking:
        print("RESULT: NOT CUT-READY -- " + "; ".join(blocking))
        return 3 if a.gate else 0   # only BLOCK (non-zero) in --gate mode
    # The verdict now enumerates ONLY what actually ran. A check that did not run
    # is UNKNOWN, and UNKNOWN is a third state -- it is reported, not absorbed
    # into "cut-ready". The exit code is unchanged (an unrun check is not a
    # finding, and making it one would be the over-sensitivity bug), so --gate
    # keeps exactly the teeth it had.
    ran = "footguns clean, metric ratchets clean"
    if unknown:
        print(f"RESULT: cut-ready for what RAN ({ran}) -- "
              f"{len(unknown)} check(s) NOT RUN, so UNKNOWN, not OK:")
        for u in unknown:
            print(f"  - {u}")
    else:
        print("RESULT: cut-ready (version/pin/surface OK, derived docs in sync, "
              "no env trap, gating tools have teeth)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
