#!/usr/bin/env python3
"""bd-config-lineage -- trace a config key end-to-end.

For a given key (or all keys), reports each stage of its lineage: env-var form
present, runtime read sites (cfg.get), settings/GUI surface mention, docs
mention, and test coverage. Shows where the chain breaks (e.g. read in runtime
but no env + no docs = the same orphan bd-config-orphan flags, but per-key with
the full lineage). Read-only.

Usage: bd-config-lineage [--key KEY] [--work DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
# read-sites: cfg.get("k") AND bracket access cfg["k"] (the pattern the old
# model missed -- a config key read via [] would give a false all-clear).
GETKEY=re.compile(r'(?:cfg|config|_cfg|global_config|gc|conf)\.get\(\s*["\']([a-zA-Z0-9_]+)["\']'
                  r'|(?:cfg|config|_cfg|global_config|gc|conf)\[\s*["\']([a-zA-Z0-9_]+)["\']\s*\]')

def index(work):
    py=[]; reads={}
    for _p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        py.append((rel,txt))
        for m in GETKEY.finditer(txt):
            reads.setdefault(m.group(1) or m.group(2),set()).add(rel)
    corpus="\n".join(t for _r,t in py)
    docs=""
    for f in glob.glob(os.path.join(work,"**","*.md"),recursive=True):
        try: docs+=open(f,errors="ignore").read()
        # why: handled failure is non-fatal; proceed with the value left unset
        except Exception: pass
    tests="\n".join(t for r,t in py if r.startswith("tests") or "test" in r)
    return reads, corpus, docs, tests

def lineage(work, key=None):
    reads, corpus, docs, tests = index(work)
    keys=[key] if key else sorted(reads)
    out=[]
    for k in keys:
        env="BD_"+k.upper()
        out.append({"key":k,
            "env_var": env in corpus,
            "read_sites": sorted(reads.get(k,[]))[:5],
            "read_count": len(reads.get(k,[])),
            "settings_surface": bool(re.search(r'(settings|widgets_config|dev_config)',corpus)) and (corpus.count('"'+k+'"')+corpus.count("'"+k+"'"))>1,
            "docs": ('`'+k+'`') in docs or (' '+k+' ') in docs,
            "tested": ('"'+k+'"') in tests or ("'"+k+"'") in tests})
    return out

def selftest():
    ok=True
    l=lineage(sec.DEFAULT_WORK)
    print(("PASS" if len(l)>0 else "FAIL")+"  lineage built for %d keys"%len(l))
    ok=ok and len(l)>0
    fields=set(l[0].keys()) if l else set()
    need={"env_var","read_sites","settings_surface","docs","tested"}
    print(("PASS" if need<=fields else "FAIL")+"  each key has full lineage stages")
    ok=ok and need<=fields
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--key",default=None); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    l=lineage(a.work,a.key)
    if sec.emit({"lineage":l},as_json=a.json): return 0
    for k in l[:40]:
        stages="".join([("E" if k["env_var"] else "-"),("R" if k["read_count"] else "-"),
                        ("S" if k["settings_surface"] else "-"),("D" if k["docs"] else "-"),("T" if k["tested"] else "-")])
        broken = not (k["env_var"] or k["settings_surface"] or k["docs"])
        col=R if broken else G
        print("  %s[%s]%s %s %s(reads:%d)%s"%(col,stages,RST,k["key"],DIM,k["read_count"],RST))
    print(DIM+"stages: E=env R=read S=settings D=docs T=tested"+RST)
    return 0
sys.exit(main())
