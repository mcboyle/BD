#!/usr/bin/env python3
"""bd-plugin-manifest -- validate plugin manifests (schema, caps, api, paths).

Loads the app's real plugins module and validates each plugin manifest against
its contract: api_compatible() (min/max api), declared capabilities are known
kinds, full-access-requiring caps (lifecycle/page_access) are declared, and
paths are relative (no absolute/traversal). A manifest that fails a hard check
-> BD-PLUGIN-MANIFEST-INVALID. Read-only.

Usage: bd-plugin-manifest [--work DIR] [--json] [--selftest]
Exit 1 if any manifest invalid, else 0.
"""
import argparse, glob, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def _load_mod(work, modname):
    import importlib.util, types
    p=os.path.join(work,"bulk_downloader",modname+".py")
    if not os.path.exists(p): return None
    try:
        pkg=types.ModuleType("bulk_downloader"); pkg.__path__=[os.path.join(work,"bulk_downloader")]
        sys.modules.setdefault("bulk_downloader",pkg)
        for e in (work,"/tmp/prestaged_site_packages"):
            if e not in sys.path: sys.path.insert(0,e)
        spec=importlib.util.spec_from_file_location("bulk_downloader."+modname,p)
        m=importlib.util.module_from_spec(spec); sys.modules["bulk_downloader."+modname]=m
        spec.loader.exec_module(m); return m
    except Exception:  # why: input unavailable/unreadable; return empty so the caller uses its fallback, not a wrong value
        return None

KNOWN_CAPS={"extractor","hook","processor","config","lifecycle","page_access","recognizer","prefilter","namer"}
FULL_ACCESS_CAPS={"lifecycle","page_access"}

def validate(man, api_compatible):
    errs=[]
    if api_compatible:
        try:
            ok,reason=api_compatible(man)
            if not ok: errs.append("api: "+reason)
        except Exception as e: errs.append("api_compatible raised: "+str(e))
    caps=man.get("capabilities") or man.get("caps") or []
    if isinstance(caps,str): caps=[caps]
    if not isinstance(caps,(list,tuple,set)):
        errs.append("capabilities must be a list, got %s"%type(caps).__name__)
        caps=[]
    for c in caps:
        if c not in KNOWN_CAPS: errs.append("unknown capability %r"%c)
    for p in [man.get("path"),man.get("entry"),man.get("main")]:
        if isinstance(p,str) and (os.path.isabs(p) or ".." in p):
            errs.append("unsafe path %r"%p)
    return errs

def scan(work):
    plugins=_load_mod(work,"plugins")
    apic=getattr(plugins,"api_compatible",None) if plugins else None
    findings=[]; checked=0
    for f in glob.glob(os.path.join(work,"**","*.json"),recursive=True):
        if "node_modules" in f: continue
        try: obj=json.load(open(f))
        # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
        except Exception: continue
        if not (isinstance(obj,dict) and ("capabilities" in obj or "caps" in obj or "api_version" in obj or ("name" in obj and "hooks" in obj))): continue
        checked+=1
        for e in validate(obj,apic):
            findings.append({"file":os.path.relpath(f,work),"error":e})
    return findings, checked, apic is not None

def selftest():
    ok=True
    f,c,loaded=scan(sec.DEFAULT_WORK)
    print(("PASS" if loaded else "WARN")+"  real plugins.api_compatible loaded (%s)"%loaded)
    # synthetic
    bad={"name":"x","capabilities":["lifecycle","bogus_cap"],"path":"../etc/passwd","api_version":"notint"}
    errs=validate(bad, None)
    good=any("bogus_cap" in e for e in errs) and any("unsafe path" in e for e in errs)
    print(("PASS" if good else "FAIL")+"  synthetic manifest: bad cap + unsafe path caught (%d)"%len(errs))
    ok=ok and good
    good2=validate({"name":"y","capabilities":["extractor"],"path":"sub/x.py"},None)==[]
    print(("PASS" if good2 else "FAIL")+"  clean manifest passes")
    ok=ok and good2
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    f,c,loaded=scan(a.work)
    if sec.emit({"findings":f,"summary":{"checked":c,"invalid":len(f),"api_loaded":loaded}},as_json=a.json): return 1 if f else 0
    print("%d plugin manifest(s) checked; %d issue(s)"%(c,len(f)))
    for x in f[:40]: print("  %sBD-PLUGIN-MANIFEST-INVALID%s %s: %s"%(R,RST,x["file"],x["error"]))
    if not f: print(G+"all plugin manifests valid"+RST)
    return 1 if f else 0
if __name__ == "__main__":
    sys.exit(main())
