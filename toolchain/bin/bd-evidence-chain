#!/usr/bin/env python3
"""bd-evidence-chain -- tamper-evident manifest linking every release artifact.

Given a set of evidence files (release zip, bdsuite, version pack, proof ledger,
logs, screenshots, test output), computes a sha256 for each and a Merkle-style
chained root so any later tampering with any artifact is detectable. Emits a
manifest {artifact -> sha256, prev_link} + a single chain_root. Optionally
--verify a previously-emitted manifest against the current files. Read-only.

Usage:
    bd-evidence-chain [--home DIR] [--glob PATTERN...] [--json]
    bd-evidence-chain --verify MANIFEST.json [--home DIR]
    bd-evidence-chain --selftest
Exit 1 if --verify detects tampering, else 0.
"""
import argparse
import glob
import hashlib
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

DEFAULT_GLOBS = ["bdsuite_v3_66_*.zip", "bd_project_files.zip",
                 "BulkDownloader_v3_66_*.zip", "BulkDL_next_session_*.zip",
                 "audit_state_v3_66_*.zip"]


def _sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def build_chain(files):
    """Ordered artifacts -> chained manifest. Each link hashes (prev_root +
    this artifact's sha), giving a tamper-evident root."""
    entries = []
    root = "0" * 64
    for path in sorted(files):
        sha = _sha(path)
        link = hashlib.sha256((root + sha).encode()).hexdigest()
        entries.append({"artifact": os.path.basename(path), "sha256": sha,
                        "prev_root": root, "link": link})
        root = link
    return {"schema": "bd-evidence-chain/1",
            "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "artifacts": entries, "chain_root": root}


def collect(home, globs):
    files = []
    for g in globs:
        files += glob.glob(os.path.join(home, g))
    # dedup + keep only existing files
    return sorted({f for f in files if os.path.isfile(f)})


def verify(manifest_path, home):
    man = json.load(open(manifest_path))
    problems = []
    root = "0" * 64
    for e in man["artifacts"]:
        p = os.path.join(home, e["artifact"])
        if not os.path.exists(p):
            problems.append({"artifact": e["artifact"], "issue": "missing"})
            root = e["link"]
            continue
        cur = _sha(p)
        if cur != e["sha256"]:
            problems.append({"artifact": e["artifact"], "issue": "sha mismatch",
                             "expected": e["sha256"][:12], "got": cur[:12]})
        expect_link = hashlib.sha256((root + e["sha256"]).encode()).hexdigest()
        if expect_link != e["link"]:
            problems.append({"artifact": e["artifact"], "issue": "broken chain link"})
        root = e["link"]
    root_ok = root == man["chain_root"]
    if not root_ok:
        problems.append({"artifact": "<root>", "issue": "chain root mismatch"})
    return problems, root_ok


def selftest():
    ok = True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        for n, c in (("a.zip", b"AAA"), ("b.zip", b"BBB"), ("c.zip", b"CCC")):
            open(os.path.join(d, n), "wb").write(c)
        files = [os.path.join(d, n) for n in ("a.zip", "b.zip", "c.zip")]
        chain = build_chain(files)
        mpath = os.path.join(d, "manifest.json")
        json.dump(chain, open(mpath, "w"))
        # 1. clean verify passes
        probs, root_ok = verify(mpath, d)
        print(("PASS" if not probs and root_ok else "FAIL") +
              f"  clean chain verifies ({len(probs)} problems)")
        ok &= not probs and root_ok
        # 2. tamper one artifact -> detected
        open(os.path.join(d, "b.zip"), "wb").write(b"TAMPERED")
        probs2, _ = verify(mpath, d)
        detected = any(p["artifact"] == "b.zip" and "sha" in p["issue"] for p in probs2)
        print(("PASS" if detected else "FAIL") + f"  tamper detected ({[p['issue'] for p in probs2]})")
        ok &= detected
        # 3. chain root changes when order/content changes
        chain3 = build_chain(files[:2])
        print(("PASS" if chain3["chain_root"] != chain["chain_root"] else "FAIL") +
              "  chain root sensitive to artifact set")
        ok &= chain3["chain_root"] != chain["chain_root"]
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--home", default="/home/claude")
    ap.add_argument("--glob", action="append", default=None)
    ap.add_argument("--verify", metavar="MANIFEST", default=None)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_bundle(a.home)
    if a.verify:
        probs, root_ok = verify(a.verify, a.home)
        if sec.emit({"problems": probs, "root_ok": root_ok}, as_json=a.json):
            return 1 if probs else 0
        if not probs:
            print(f"{G}evidence chain intact -- no tampering detected{RST}")
            return 0
        for p in probs:
            print(f"  {R}{p['issue']}{RST} {p['artifact']}")
        return 1
    files = collect(a.home, a.glob or DEFAULT_GLOBS)
    chain = build_chain(files)
    if not a.json:
        json.dump(chain, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    sec.emit(chain, as_json=True)
    return 0


sys.exit(main())
