#!/usr/bin/env python3
"""bd-changelog -- the CHANGELOG-emoji gate has bitten 3x: a non-ASCII char in the
CURRENT release entry fails an on-stash-only gate POST-deploy. This checks it
BEFORE you cut/deploy: top entry is ASCII-only, is anchored on a `## v...` header,
and matches the tree __version__.

Usage:
  bd-changelog [--tree DIR] [--changelog PATH]
Exit 1 on any problem, else 0.
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # for DEFAULT_WORK (resolves the repo root on a clone)

def tree_version(tree):
    try:
        t = open(os.path.join(tree, "bulk_downloader/__init__.py"), errors="ignore").read()
        m = re.search(r'__version__\s*=\s*["\']([0-9.]+)["\']', t)
        return m.group(1) if m else None
    except Exception:  # why: input unavailable/unreadable; return empty so the caller uses its fallback, not a wrong value
        return None

def selftest():
    import tempfile, os as _o
    d = tempfile.mkdtemp(prefix="ct_cl_")
    _o.makedirs(_o.path.join(d, "bulk_downloader"))
    open(_o.path.join(d, "bulk_downloader", "__init__.py"), "w").write('__version__ = "3.66.700"\n')
    got = tree_version(d)
    ok = (got == "3.66.700")
    print(("PASS" if ok else "FAIL") + "  reads tree __version__ (%s)" % got)
    # NEG: a tree with no __version__ must not fabricate one
    import shutil as _s
    d2 = tempfile.mkdtemp(prefix="ct_cl2_"); _o.makedirs(_o.path.join(d2, "bulk_downloader"))
    open(_o.path.join(d2, "bulk_downloader", "x.py"), "w").write("x=1\n")
    got2 = tree_version(d2)
    neg = got2 in (None, "")
    print(("PASS" if neg else "FAIL") + "  NEG: no __version__ -> no fabricated value (%r)" % got2)
    _s.rmtree(d, ignore_errors=True); _s.rmtree(d2, ignore_errors=True)
    ok = ok and neg
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tree","--work", default=sec.DEFAULT_WORK)
    ap.add_argument("--changelog", default=None)
    ap.add_argument("--selftest", action="store_true",
                   help="real fault-injection selftest")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    cl = a.changelog or os.path.join(a.tree, "CHANGELOG.md")
    if not os.path.exists(cl):
        print(f"no CHANGELOG at {cl}"); return 1
    lines = open(cl, errors="ignore").read().splitlines()
    # find the first version header and the block up to the next one
    hdr_idx = next((i for i, l in enumerate(lines) if re.match(r"^#{1,3}\s*v?3\.66\.\d+", l.strip())), None)
    if hdr_idx is None:
        print("FAIL: no '## v3.66.N' header found near the top."); return 1
    nxt = next((i for i in range(hdr_idx + 1, len(lines)) if re.match(r"^#{1,3}\s*v?3\.66\.\d+", lines[i].strip())), len(lines))
    block = lines[hdr_idx:nxt]
    top_hdr = lines[hdr_idx].strip()
    hv = re.search(r"3\.66\.(\d+)", top_hdr).group(0)
    print(f"top entry: {top_hdr}")
    rc = 0
    # 1. ASCII-only
    bad = []
    for off, l in enumerate(block):
        for ch in l:
            if ord(ch) > 127:
                bad.append((hdr_idx + off + 1, ch, hex(ord(ch)))); break
    if bad:
        print(f"FAIL: non-ASCII char(s) in the current entry (the on-stash gate will fail post-deploy):")
        for ln, ch, code in bad[:8]:
            print(f"    line {ln}: {code!r} ({ch!r})")
        rc = 1
    else:
        print("  ASCII-only: ok")
    # 2. version match
    tv = tree_version(a.tree)
    if tv and tv not in hv:
        print(f"WARN: top entry {hv} != tree __version__ {tv} (bump the 3-part set together).")
        rc = rc or 0  # warn, not hard-fail (bd-versync gates that)
    elif tv:
        print(f"  matches tree __version__ {tv}: ok")
    if rc == 0:
        print("\nCHANGELOG current entry is clean.")
    return rc

if __name__ == "__main__":
    sys.exit(main())
