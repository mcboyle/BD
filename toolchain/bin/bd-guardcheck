#!/usr/bin/env python3
"""bd-guardcheck -- the 7 release-guard files must stay byte-identical unless a new
SHA is explicitly declared. An accidental edit is catastrophic (on-stash guard gate
+ the merge-not-overlay deploy trap). This hashes the guards in the work tree and
compares them to the pinned SHAs -> catches an unintended guard edit BEFORE the cut.

Usage:
  bd-guardcheck [--tree DIR] [--guards guards.json] [--state STATE.json]

Guards baseline, in order of precedence:
  --guards PATH   an explicit manifest.  If it is absent or malformed this is a
                  HARD ERROR -- never a silent fallback.
  --state PATH    an explicit STATE.json (version-pack workflow).
  <tree>/guards.json   the repo-root manifest.  This is the default and the
                  single source of truth for a git checkout.
  operator STATE discovery (BD_STATE_ROOT, then newest version pack).

Exit codes:
  0  every guard resolved and matched.
  1  at least one guard DRIFTED -> declare a new SHA (bd-guard-declare) or revert.
  2  UNKNOWN: no guards baseline at all, a guard file missing/unreadable, a guard
     with no pin, or a summary whose buckets do not account for every guard.

CLAUDE.md 0 -- why exit 2 exists at all.  This tool used to default --tree to
an absent sandbox tree. Run from a git checkout and all 7
guards read as FILE MISSING; and `if drift: return 1` was the only non-zero path,
so the gate printed "0 ok, 0 drifted, 7 missing." and exited 0.  It certified a
tree it had never read.  A gate that cannot see its subject reports OK, and that
is worse than no gate: unknown is a THIRD STATE and it FAILS.

The inverse rule binds just as hard: on an intact tree this must exit 0 and
report every guard ok.  A gate that cries wolf gets switched off.
"""
import argparse, glob, hashlib, importlib.util, json, os, re, sys, zipfile

_RESOLVER_PATH = os.path.join(os.path.dirname(os.path.realpath(__file__)), "_bd_work_tree.py")
_resolver_spec = importlib.util.spec_from_file_location("_bd_guard_work_tree", _RESOLVER_PATH)
if _resolver_spec is not None and _resolver_spec.loader is not None:
    _resolver = importlib.util.module_from_spec(_resolver_spec)
    try:
        _resolver_spec.loader.exec_module(_resolver)
    except OSError:
        _resolver = None
else:
    _resolver = None

MANIFEST_NAME = "guards.json"
UNRUNNABLE = 2
DRIFTED = 1


def _bd_pick_newest(paths):
    """Highest VERSION wins; ties resolve to the operator artifact root.

    These lists can span uploads and the operator artifact root; sorting the PATH
    STRINGS with reverse=True. Lexicographically "/mnt..." > "/home...", so the READ-ONLY
    UPLOADS COPY ALWAYS WON -- regardless of version. bd-since cheerfully diffed the work
    tree against a FOUR-RELEASE-STALE zip (722 against a live 726) while looking entirely
    correct; bd-agent-scorecard scored off that, and bd-evidence BLOCKED on the result.

    The denominator CONTAINED the right file. The ORDERING discarded it. Sort by the thing
    actually being asked about -- the version -- not by where the file happens to live.
    """
    def _k(p):
        nums = tuple(int(x) for x in re.findall(r"\d+", os.path.basename(p)))
        return nums
    return sorted(paths, key=_k, reverse=True)


# --- 702: --selftest delegates to the tool's own bd-coretest fault-injection case.
# These are the RELEASE-GATING MUTATORS: they edit the tree and gate a cut, and they
# had NO selftest at their own entry point (bd-tool-lint: 10/10 untested). The teeth
# already existed in bd-coretest -- they were just unreachable from the tool itself.
# Delegating (not re-asserting) keeps ONE source of truth for what "correct" means.
def _selftest_via_coretest():
    import subprocess as _sp, sys as _sys, os as _os
    _me = _os.path.basename(_os.path.realpath(__file__))
    _ct = _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "bd-coretest")
    if not _os.path.isfile(_ct):
        print("SELFTEST FAIL -- bd-coretest not found (cannot verify teeth)")
        return 2
    _cp = _sp.run([_sys.executable, _ct, "--only", _me], capture_output=True, text=True, timeout=900)
    for _ln in _cp.stdout.splitlines():
        if _ln.startswith(_me) or _ln.strip().startswith("["):
            print(_ln)
    print("SELFTEST PASS" if _cp.returncode == 0 else "SELFTEST FAIL")
    return _cp.returncode


if "--selftest" in sys.argv:
    sys.exit(_selftest_via_coretest())


# The fallback guard list, used when the baseline is a STATE.json (which carries
# pins but not the roster).  guards.json carries its OWN roster and wins over this.
GUARDS = [
    "bulk_downloader/extraction_core.py", "bulk_downloader/session_capture.py",
    "bulk_downloader/dom_capture.py", "bulk_downloader/dom_recorder.py",
    "bulk_downloader/capture_bodies.py", "tools/capture_session.py", "tools/build_release.py",
]

_HEX64 = re.compile(r"^[0-9a-f]{64}$")


def unrunnable(reason, *hints):
    """The gate cannot answer the question it was asked. Say so, loudly, and FAIL.

    Historically the failure mode was the opposite: print a clean-looking table
    over an empty denominator and exit 0. Never do that again.
    """
    print(f"\nBD-GATE-UNRUNNABLE: {reason}")
    for h in hints:
        print(f"  {h}")
    print("  (unknown is a third state, and it FAILS -- see CLAUDE.md section 0)")
    return UNRUNNABLE


def _upward(start):
    """start and every ancestor directory, nearest first."""
    d = os.path.abspath(start)
    seen = []
    while True:
        seen.append(d)
        parent = os.path.dirname(d)
        if parent == d:
            return seen
        d = parent


def resolve_tree(explicit):
    """Find the tree whose guards we are checking.

    Explicit --tree always wins (that is the version-pack / fault-injection path).
    Otherwise: walk up from CWD for a guards.json, then the repo root implied by
    this script's own location.

    The old code hardcoded a sandbox tree as the default, which is why a run
    from a git checkout hashed nothing at all.
    """
    if explicit:
        return os.path.abspath(explicit), "--tree"
    if _resolver is None:
        raise RuntimeError("checkout resolver is missing beside physical tool")
    return str(_resolver.resolve_work_tree(__file__)), "checkout authority"


def load_manifest(path):
    """Read guards.json -> (guard_list, full_pins). Raises ValueError if unusable.

    A malformed manifest is an UNKNOWN, not an empty pin map: an empty pin map
    would make every guard 'unpinned' and, in the old code, silently ok.
    """
    def reject_duplicates(pairs):
        out = {}
        for key, value in pairs:
            if key in out:
                raise ValueError(f"duplicate JSON key: {key}")
            out[key] = value
        return out
    with open(path) as fh:
        doc = json.load(fh, object_pairs_hook=reject_duplicates)
    if not isinstance(doc, dict):
        raise ValueError("top level is not an object")
    guards = doc.get("guards")
    if not isinstance(guards, dict) or not guards:
        raise ValueError("no non-empty 'guards' object")
    pins = {}
    for rel, sha_hex in guards.items():
        if not isinstance(sha_hex, str) or not _HEX64.match(sha_hex.strip().lower()):
            raise ValueError(f"{rel}: pin is not a full 64-hex sha256 ({sha_hex!r})")
        pins[rel] = sha_hex.strip().lower()
    return list(guards.keys()), pins


def resolve_state(explicit):
    """Find STATE.json: --state, common pack dirs, or newest version-pack zip."""
    state_root = os.environ.get("BD_STATE_ROOT", os.getcwd())
    for p in ([explicit] if explicit else []) + [
            os.path.join(state_root, "nextsess", "STATE.json"),
            os.path.join(state_root, "work_pack", "STATE.json")]:
        if p and os.path.isfile(p):
            try:
                return json.load(open(p)), p
            except Exception:  # why: this STATE candidate is unreadable; try the next known location
                pass
    for z in _bd_pick_newest(glob.glob("/mnt/user-data/uploads/BulkDL_next_session_*.zip")):
        try:
            with zipfile.ZipFile(z) as zf:
                return json.loads(zf.read("STATE.json")), z + "!STATE.json"
        except Exception:  # why: this session zip lacks a readable STATE.json; try the next
            continue
    return None, None


def resolve_baseline(a, tree):
    """Return (guard_list, full_pins, short_pins, source_label) or (None, ...) on
    an unrunnable baseline. The caller turns None into exit 2."""
    if a.guards:
        if not os.path.isfile(a.guards):
            return None, None, None, f"--guards {a.guards}: no such file"
        try:
            names, pins = load_manifest(a.guards)
        except Exception as ex:
            return None, None, None, f"--guards {a.guards}: {type(ex).__name__}: {ex}"
        return names, pins, {}, a.guards
    if a.state:
        d, src = resolve_state(a.state)
        if not d:
            return None, None, None, f"--state {a.state}: unreadable or not found"
        return list(GUARDS), d.get("guards_full_sha256") or {}, d.get("guards") or {}, src
    local = os.path.join(tree, MANIFEST_NAME)
    if os.path.isfile(local):
        try:
            names, pins = load_manifest(local)
        except Exception as ex:
            return None, None, None, f"{local}: {type(ex).__name__}: {ex}"
        return names, pins, {}, local
    d, src = resolve_state(None)
    if d:
        return list(GUARDS), d.get("guards_full_sha256") or {}, d.get("guards") or {}, src
    return None, None, None, "no guards.json in the tree and no STATE.json anywhere"


def sha(path):
    try:
        return hashlib.sha256(open(path, "rb").read()).hexdigest()
    except Exception:  # why: file absent/unreadable; None so the caller reports a MISSING guard, not a wrong sha
        return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tree", "--work", default=None,
                    help="tree to hash (default: resolved checkout authority)")
    ap.add_argument("--guards", default=None,
                    help="explicit guards.json manifest (absent/malformed => exit 2)")
    ap.add_argument("--state", default=None,
                    help="explicit STATE.json baseline (version-pack workflow)")
    a = ap.parse_args()

    try:
        tree, how = resolve_tree(a.tree)
    except RuntimeError as exc:
        return unrunnable(str(exc), "pass --tree to name the intended checkout")
    names, pinned_full, pinned_short, src = resolve_baseline(a, tree)
    print(f"(tree: {tree}  [{how}])")
    if names is None:
        return unrunnable(
            f"no guards baseline: {src}",
            "the 7 guard SHAs could not be loaded, so NOTHING was verified",
            f"fix: create {MANIFEST_NAME} at the tree root, or pass --guards/--state",
        )
    print(f"(baseline: {src})")

    total = len(names)
    ok = drift = miss = unpinned = 0
    print(f"{'guard':<40} {'status'}")
    for g in names:
        h = sha(os.path.join(tree, g))
        if h is None:
            print(f"  {g:<38} FILE MISSING"); miss += 1; continue
        pf = pinned_full.get(g); ps = pinned_short.get(g)
        if pf:
            if h == pf:
                print(f"  {g:<38} ok ({h[:8]})"); ok += 1
            else:
                print(f"  {g:<38} DRIFT  tree {h[:8]} != pinned {pf[:8]}"); drift += 1
        elif ps:
            if h.startswith(ps) or ps.startswith(h[:len(ps)]):
                print(f"  {g:<38} ok (short {h[:8]})"); ok += 1
            else:
                print(f"  {g:<38} DRIFT  tree {h[:8]} != pinned {ps[:8]}"); drift += 1
        else:
            print(f"  {g:<38} NO PIN (tree {h[:8]}) -- unverifiable"); unpinned += 1

    print(f"\n{ok} ok, {drift} drifted, {miss} missing, {unpinned} unpinned.")

    # A summary whose buckets do not account for every guard is a denominator lie.
    if ok + drift + miss + unpinned != total:
        return unrunnable(
            f"summary buckets ({ok}+{drift}+{miss}+{unpinned}) do not sum to the "
            f"{total} guards checked",
            "refusing to report a verdict over a denominator that lost rows",
        )

    if miss or unpinned:
        bits = []
        if miss:
            bits.append(f"{miss} guard file(s) missing/unreadable under {tree}")
        if unpinned:
            bits.append(f"{unpinned} guard(s) have no pin in {os.path.basename(str(src))}")
        rc = unrunnable("; ".join(bits),
                        "the gate could not verify every guard, so it cannot report OK")
        if drift:
            print("=> and at least one guard DRIFTED as well.")
        return rc
    if drift:
        print("=> a guard changed. If intentional: bd-guard-declare + bump the pinned SHA. If not: REVERT before cutting.")
        return DRIFTED
    return 0


if __name__ == "__main__":
    sys.exit(main())
