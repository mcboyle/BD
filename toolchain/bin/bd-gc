#!/usr/bin/env python3
"""bd-gc -- report, and only on demand remove, the litter a test run leaves.

MEASURED, and it is worse than the number that prompted the tool. v3.66.1035
found 744 empty directories under /tmp from one session's socket recorder. Asked
again at v3.66.1042 with bd-fleet: **9479** /tmp/bd-* and /tmp/pytest-of-* paths
on the master, 1349 on the candidate, 354 on the box provisioned that same day.
Nothing removes them; git status stays clean because they live outside the repo;
the cost is a slow leak nobody trips over until a disk does.

THIS TOOL IS THE DANGEROUS ONE IN THE SET, so read the refusals.

  * DRY RUN IS THE DEFAULT. Without --apply it removes nothing, and it says
    NOTHING REMOVED in those words -- a dry run that reads like a completed
    cleanup is the same defect as deploy_fleet.sh's dry run printing "all 3
    hosts deployed and verified" having touched nothing.
  * /tmp/bd-jobs AND /tmp/bd-runctx ARE NEVER CANDIDATES. They are retained
    registries/corpora, excluded structurally rather than by an age heuristic.
  * NOTHING RECENT. Generic litter uses --older-than (default 120 minutes).
    Marked test roots use their durable outcome timestamp and a 24-hour policy
    floor. --older-than below 10 is refused outright.
  * NOTHING OUTSIDE /tmp. Every candidate is re-checked against the allowed
    prefixes after globbing, because a symlink or a crafted name is exactly how
    a cleanup tool becomes an incident.
"""
import argparse
import fcntl
import json
import math
import os
import pathlib
import stat
import subprocess
import sys
import tempfile
import time

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from tools.safe_temp_remove import rename_verify_destroy

# Structural, not configurable. A cleanup tool with a --path flag is a wrapper
# around rm -rf with better manners.
PREFIXES = ("/tmp/bd-", "/tmp/bdcut_", "/tmp/pytest-of-",
            "/tmp/bd_capture_vault-")
NEVER = ("/tmp/bd-jobs", "/tmp/bd-runctx")
MIN_AGE_MIN = 10
RUN_MARKER = ".bd-testrun"
RUN_LOCK = ".bd-testrun.lock"
POLICY_MIN_AGE_S = 24 * 60 * 60
FORENSICS_KEEP = 20
PROTECTED_STATES = {"KEPT_FOR_FORENSICS", "ABANDONED"}
CAPTURE_VAULT_LOCK = ".bd-capture-vault.lock"


def _capture_vault_state(path, now):
    try:
        root_st = os.lstat(path)
        lock_fd = os.open(
            os.path.join(path, CAPTURE_VAULT_LOCK),
            os.O_RDONLY | os.O_NOFOLLOW)
        if not stat.S_ISREG(os.fstat(lock_fd).st_mode):
            raise OSError("capture-vault lock is not a regular file")
    except OSError as exc:
        return "UNKNOWN", None, "vault lock cannot be evaluated (%s)" % exc
    acquired = False
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except BlockingIOError:
            return "LIVE", None, "capture-vault lock is held"
        except OSError as exc:
            return "UNKNOWN", None, "vault lock cannot be evaluated (%s)" % exc
    finally:
        if acquired:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(lock_fd)
    return "ABANDONED", root_st.st_mtime, "keyed vault has no held lock"


def finish_capture_vault(path, owned_fd, allowed_parent=pathlib.Path("/tmp")):
    """Remove only the capture-vault object held from its creation."""
    target = pathlib.Path(path)
    parent = pathlib.Path(allowed_parent)
    if (target.parent != parent or
            not target.name.startswith("bd_capture_vault-") or
            target.name in ("bd_capture_vault-", ".", "..")):
        return False, "capture-vault path is outside the owned keyed namespace"
    try:
        held = os.fstat(owned_fd)
        named = os.lstat(target)
    except OSError as exc:
        return False, "capture-vault identity is unavailable (%s)" % exc
    expected = (held.st_dev, held.st_ino)
    if (named.st_dev, named.st_ino) != expected:
        return False, "creation identity mismatch at capture-vault pathname"
    return rename_verify_destroy(target, expected_identity=expected)


def _test_root_state(path, now):
    """Return the disk-decidable policy state and its outcome timestamp."""
    try:
        root_st = os.lstat(path)
        lock_fd = os.open(
            os.path.join(path, RUN_LOCK), os.O_RDONLY | os.O_NOFOLLOW)
        lock_st = os.fstat(lock_fd)
        if not stat.S_ISREG(lock_st.st_mode):
            raise OSError("run-root lock is not a regular file")
    except OSError as exc:
        return "UNKNOWN", None, "lock cannot be evaluated (%s)" % exc
    acquired = False
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except BlockingIOError:
            return "LIVE", None, "run-root lock is held"
        except OSError as exc:
            return "UNKNOWN", None, "lock cannot be evaluated (%s)" % exc
    finally:
        if acquired:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(lock_fd)

    marker_fd = None
    try:
        marker_fd = os.open(
            os.path.join(path, RUN_MARKER), os.O_RDONLY | os.O_NOFOLLOW)
        marker_st = os.fstat(marker_fd)
        if not stat.S_ISREG(marker_st.st_mode):
            return "UNKNOWN", None, "marker is not a regular file"
        chunks, total = [], 0
        while total <= 65536:
            chunk = os.read(marker_fd, min(8192, 65537 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > 65536:
            return "UNKNOWN", None, "marker exceeds 65536 bytes"
        record = json.loads(b"".join(chunks).decode("ascii"))
    except (OSError, UnicodeError, ValueError, TypeError) as exc:
        return "UNKNOWN", None, "marker is unreadable (%s)" % exc
    finally:
        if marker_fd is not None:
            os.close(marker_fd)
    if not isinstance(record, dict) or record.get("schema") != 1:
        return "UNKNOWN", None, "marker schema is not understood"
    if (record.get("root_dev"), record.get("root_ino")) != (
            root_st.st_dev, root_st.st_ino):
        return "UNKNOWN", None, "marker identity does not match the root"
    if (record.get("lock_dev"), record.get("lock_ino")) != (
            lock_st.st_dev, lock_st.st_ino):
        return "UNKNOWN", None, "marker identity does not match the lock"
    try:
        stamp = float(record.get("updated_at", record["started_at"]))
    except (KeyError, TypeError, ValueError):
        return "UNKNOWN", None, "marker timestamp is unreadable"
    if not math.isfinite(stamp) or stamp > now + 300:
        return "UNKNOWN", None, "marker timestamp is impossible"
    state = record.get("state")
    if state == "RUNNING":
        return "ABANDONED", stamp, "RUNNING marker has no held lock"
    outcome = record.get("exitstatus")
    if state == "KEPT_FOR_FORENSICS" and type(outcome) is int and outcome != 0:
        return state, stamp, "terminal nonzero outcome"
    if state == "RECLAIMABLE" and type(outcome) is int and outcome == 0:
        return state, stamp, "terminal clean outcome whose immediate removal refused"
    if state == "UNKNOWN":
        return "UNKNOWN", stamp, record.get("reason", "producer recorded UNKNOWN")
    return "UNKNOWN", stamp, "marker state and outcome contradict"


def is_candidate(path, now, older_than_s):
    """Every reason a path may be removed, in one testable predicate."""
    p = str(path)
    # A DIRECT CHILD OF A PREFIX, never something nested under one. A bare
    # startswith() also accepts /tmp/bd-run/2026/deep/thing, so a predicate
    # written to describe "a litter directory" quietly described "anything
    # anywhere inside one" -- and this tool deletes what the predicate accepts.
    # Caught by its own selftest, which asserted a nested path was ineligible.
    matched = [pre for pre in PREFIXES
               if p.startswith(pre) and "/" not in p[len(pre):]]
    if not matched:
        return False, "outside the allowed prefixes, or nested inside one"
    for never in NEVER:
        if p == never or p.startswith(never + "/"):
            if never.endswith("bd-runctx"):
                return False, "the retained run context is never a candidate"
            return False, "the bd-jobs registry is never a candidate"
    real = os.path.realpath(p)
    if not real.startswith("/tmp/"):
        return False, "resolves outside /tmp (%s)" % real
    if os.path.basename(p).startswith("bd-testrun-"):
        state, stamp, detail = _test_root_state(p, now)
        if state in ("LIVE", "UNKNOWN"):
            return False, "[%s] %s" % (state, detail)
        age = now - stamp
        threshold = max(older_than_s, POLICY_MIN_AGE_S)
    elif os.path.basename(p).startswith("bd_capture_vault-"):
        state, stamp, detail = _capture_vault_state(p, now)
        if state in ("LIVE", "UNKNOWN"):
            return False, "[%s] %s" % (state, detail)
        age = now - stamp
        threshold = max(older_than_s, POLICY_MIN_AGE_S)
    else:
        state = None
        try:
            age = now - os.lstat(p).st_mtime
        except OSError as exc:
            return False, "cannot stat: %s" % exc
        threshold = older_than_s
    prefix = "[%s] " % state if state else ""
    if age < threshold:
        return False, "%smodified %d minute(s) ago" % (prefix, age / 60)
    return True, "%seligible" % prefix


def scan(now, older_than_s, root="/tmp"):  # noqa: D401
    """(eligible, skipped) over the allowed prefixes. Reports both, always."""
    eligible, skipped = [], []
    base = pathlib.Path(root)
    for pre in PREFIXES:
        if pre.endswith("/"):
            here, pattern = pathlib.Path(pre), "*"
        else:
            here, pattern = base, os.path.basename(pre) + "*"
        for path in sorted(here.glob(pattern)):
            ok, why = is_candidate(path, now, older_than_s)
            (eligible if ok else skipped).append((str(path), why))
    protected = [
        (path, why) for path, why in eligible + skipped
        if any(why.startswith("[%s]" % state) for state in PROTECTED_STATES)
    ]
    def observed_mtime(item):
        try:
            return os.lstat(item[0]).st_mtime
        except OSError:
            return float("-inf")

    protected.sort(key=observed_mtime, reverse=True)
    keep = {path for path, _ in protected[:FORENSICS_KEEP]}
    if keep:
        retained, remaining = [], []
        for path, why in eligible:
            if path in keep:
                retained.append((path, "%s protected as one of newest %d" %
                                 (why.split(" ", 1)[0], FORENSICS_KEEP)))
            else:
                remaining.append((path, why))
        eligible = remaining
        skipped.extend(retained)
    return eligible, skipped


def size_of(path):
    try:
        r = subprocess.run(["du", "-sb", path], capture_output=True, text=True,
                           timeout=60)
        return int(r.stdout.split()[0]) if r.returncode == 0 else 0
    except (ValueError, IndexError, OSError, subprocess.SubprocessError):
        return 0


def remove(path):
    removed, reason = rename_verify_destroy(path)
    return None if removed else reason


def run(args):
    if args.older_than < MIN_AGE_MIN:
        print("bd-gc: REFUSED: --older-than %d is below the %d-minute floor. A "
              "path younger than that may belong to a run in progress."
              % (args.older_than, MIN_AGE_MIN), file=sys.stderr)
        return 2

    now = time.time()
    eligible, skipped = scan(now, args.older_than * 60)
    total = len(eligible) + len(skipped)
    # STATE THE DENOMINATOR. "142 removed" over an unstated total is the shape
    # this repo keeps finding.
    print("bd-gc: %d path(s) under %s; %d eligible, %d skipped (older-than=%dm)"
          % (total, " and ".join(PREFIXES), len(eligible), len(skipped),
             args.older_than))
    state_counts = {
        state: sum(why.startswith("[%s]" % state)
                   for _path, why in eligible + skipped)
        for state in ("LIVE", "KEPT_FOR_FORENSICS", "RECLAIMABLE",
                      "ABANDONED", "UNKNOWN")
    }
    if sum(state_counts.values()):
        print("bd-gc: states " + " ".join(
            "%s=%d" % item for item in state_counts.items()))
    if args.verbose:
        for path, why in skipped[:args.show]:
            print("  skip  %-50s %s" % (path, why))
        if len(skipped) > args.show:
            print("  ... showing %d of %d skipped" % (args.show, len(skipped)))

    if not eligible:
        print("bd-gc: nothing eligible. NOTHING REMOVED.")
        return 0

    freed = sum(size_of(p) for p, _ in eligible) if args.measure else 0
    if not args.apply:
        for path, _ in eligible[:args.show]:
            print("  would remove  %s" % path)
        if len(eligible) > args.show:
            print("  ... showing %d of %d eligible" % (args.show, len(eligible)))
        print("bd-gc: DRY RUN -- %d path(s) eligible%s. NOTHING REMOVED. "
              "Re-run with --apply." % (len(eligible),
                                        ", %.1f MB" % (freed / 1e6) if args.measure else ""))
        return 0

    errors = []
    for path, _ in eligible:
        err = remove(path)
        if err:
            errors.append((path, err))
    print("bd-gc: removed %d of %d eligible path(s)%s"
          % (len(eligible) - len(errors), len(eligible),
             ", freed %.1f MB" % (freed / 1e6) if args.measure else ""))
    for path, err in errors[:args.show]:
        print("  FAILED %s: %s" % (path, err), file=sys.stderr)
    return 1 if errors else 0


def selftest(_args):
    failures = []
    now = time.time()
    old = 3600.0

    with tempfile.TemporaryDirectory(dir="/tmp", prefix="bd-gctest-") as td:
        stale = pathlib.Path(td) / "old"
        stale.mkdir()
        os.utime(stale, (now - 99999, now - 99999))
        fresh = pathlib.Path(td) / "new"
        fresh.mkdir()

        # The temp dir itself starts with /tmp/bd- so its children do not; test
        # the predicate directly on paths that do.
        ok, why = is_candidate("/tmp/bd-jobs", now, old)
        if ok or "registry" not in why:
            failures.append("the bd-jobs registry was treated as removable -- "
                            "deleting it manufactures the orphans it prevents")
        ok, _ = is_candidate("/tmp/bd-jobs/abc.json", now, old)
        if ok:
            failures.append("a file INSIDE the registry was eligible")
        ok, why = is_candidate("/var/tmp/bd-thing", now, old)
        if ok or "prefix" not in why:
            failures.append("a path outside the allowed prefixes was eligible")
        # /tmp/bd-gctest-XXXX/old starts with /tmp/bd- and is NOT litter: it is
        # a child of a litter directory. The predicate must see the difference.
        ok, why = is_candidate(str(stale), now, old)
        if ok or "nested" not in why:
            failures.append("a path NESTED inside a litter directory was "
                            "eligible in its own right: %s" % why)

        # A real eligible path, and a real ineligible one, under the prefix.
        with tempfile.TemporaryDirectory(dir="/tmp", prefix="bd-") as bd:
            os.utime(bd, (now - 99999, now - 99999))
            ok, why = is_candidate(bd, now, old)
            if not ok:
                failures.append("an old /tmp/bd-* dir was not eligible: %s" % why)
            ok, why = is_candidate(bd, now, 10 ** 9)
            if ok or "minute" not in why:
                failures.append("a path younger than the window was eligible")

            eligible, _skipped = scan(now, old)
            if bd not in [p for p, _ in eligible]:
                failures.append("scan() missed a path its own predicate accepts")

            # DRY RUN MUST NOT REMOVE, AND MUST SAY SO. Scoped to this temp
            # prefix rather than the real /tmp: a selftest whose denominator is
            # "whatever litter this box happens to hold" measures the box, not
            # the tool, and on the master that is 9440 paths and a du storm.
            global PREFIXES
            saved = PREFIXES
            PREFIXES = (bd + "/",)
            try:
                victim = pathlib.Path(bd) / "victim"
                victim.mkdir()
                os.utime(victim, (now - 99999, now - 99999))
                ns = argparse.Namespace(older_than=60, apply=False, show=5,
                                        verbose=False, measure=False)
                rc = run(ns)
                if rc != 0 or not victim.is_dir():
                    failures.append("a dry run removed something, or exited "
                                    "nonzero")
                ns.apply = True
                rc = run(ns)
                if rc != 0 or victim.exists():
                    failures.append("--apply did not remove an eligible path")
            finally:
                PREFIXES = saved

        ns = argparse.Namespace(older_than=1, apply=True, show=5, verbose=False,
                                measure=False)
        if run(ns) != 2:
            failures.append("--older-than below the floor was not refused")

    for f in failures:
        print("SELFTEST FAIL: %s" % f, file=sys.stderr)
    if failures:
        return 1
    print("SELFTEST PASS: registry exclusion, prefix scope, age floor, scan "
          "agreement, dry run removes nothing")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        description="report (and with --apply, remove) /tmp litter from test runs")
    p.add_argument("--older-than", type=int, default=120,
                   help="minutes; paths younger are never touched (floor %d)"
                        % MIN_AGE_MIN)
    p.add_argument("--apply", action="store_true",
                   help="actually remove. Without it, nothing is removed.")
    p.add_argument("--measure", action="store_true",
                   help="du each candidate (slow on thousands of paths)")
    p.add_argument("--show", type=int, default=20)
    p.add_argument("--verbose", action="store_true")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--finish-capture-vault")
    p.add_argument("--owned-fd", type=int)
    args = p.parse_args(argv)
    if args.finish_capture_vault is not None:
        if args.owned_fd is None:
            p.error("--finish-capture-vault requires --owned-fd")
        ok, why = finish_capture_vault(args.finish_capture_vault, args.owned_fd)
        if ok:
            print("bd-gc: removed descriptor-owned capture vault")
            return 0
        print("bd-gc: REFUSED capture-vault removal: %s" % why,
              file=sys.stderr)
        return 1
    if args.owned_fd is not None:
        p.error("--owned-fd requires --finish-capture-vault")
    if args.selftest:
        return selftest(args)
    return run(args)


if __name__ == "__main__":
    sys.exit(main())
