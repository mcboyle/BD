#!/usr/bin/env python3
"""bd-gc -- report, and only on demand remove, the litter a test run leaves.

MEASURED, and it is worse than the number that prompted the tool. v3.66.1035
found 744 empty directories under /tmp from one session's socket recorder. Asked
again at v3.66.1042 with bd-fleet: **9479** /tmp/bd-* and /tmp/pytest-of-* paths
on the master, 1349 on the candidate, 354 on the box provisioned that same day.
Nothing removes them; git status stays clean because they live outside the repo;
the cost is a slow leak nobody trips over until a disk does.

THIS TOOL IS THE DANGEROUS ONE IN THE SET, so read the refusals.

  * DRY RUN IS THE DEFAULT. Without --apply it removes nothing, and it says
    NOTHING REMOVED in those words -- a dry run that reads like a completed
    cleanup is the same defect as deploy_fleet.sh's dry run printing "all 3
    hosts deployed and verified" having touched nothing.
  * /tmp/bd-jobs AND /tmp/bd-runctx ARE NEVER CANDIDATES. They are retained
    registries/corpora, excluded structurally rather than by an age heuristic.
  * NOTHING RECENT. Generic litter uses --older-than (default 120 minutes).
    Marked test roots use their durable outcome timestamp and a 24-hour policy
    floor. --older-than below 10 is refused outright.
  * NOTHING OUTSIDE /tmp. Every candidate is re-checked against the allowed
    prefixes after globbing, because a symlink or a crafted name is exactly how
    a cleanup tool becomes an incident.
"""
import argparse
import fcntl
import hmac
import json
import math
import os
import pathlib
import stat
import subprocess
import sys
import tempfile
import time

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from tools.safe_temp_remove import rename_verify_destroy

# Structural, not configurable. A cleanup tool with a --path flag is a wrapper
# around rm -rf with better manners.
PREFIXES = ("/tmp/bd-", "/tmp/bdcut_", "/tmp/pytest-of-",
            "/tmp/bd_capture_vault-")
NEVER = ("/tmp/bd-jobs", "/tmp/bd-runctx")
MIN_AGE_MIN = 10
RUN_MARKER = ".bd-testrun"
RUN_LOCK = ".bd-testrun.lock"
POLICY_MIN_AGE_S = 24 * 60 * 60
FORENSICS_KEEP = 20
PROTECTED_STATES = {"KEPT_FOR_FORENSICS", "ABANDONED"}
DURABLE_STATES = (
    "LIVE", "KEPT_FOR_FORENSICS", "RECLAIMABLE", "ABANDONED", "UNKNOWN")
CAPTURE_VAULT_LOCK = ".bd-capture-vault.lock"
WORKTREE_ROOT_MARKER = ".bd-worktree-cleanup.json"
WORKTREE_OWNER_DIR = ".bd-worktree-owners"
WORKTREE_SCHEMA = 1
_MARKER_MAX_BYTES = 65536


def _open_regular_lock(path, not_regular):
    """Open and validate a lock, closing it whenever validation raises."""
    lock_fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        lock_st = os.fstat(lock_fd)
        if not stat.S_ISREG(lock_st.st_mode):
            raise OSError(not_regular)
        return lock_fd, lock_st
    except BaseException:
        try:
            os.close(lock_fd)
        except OSError:
            pass
        raise


def _capture_vault_state(path, now):
    try:
        root_st = os.lstat(path)
        name = os.path.basename(path)
        private_tail = name.rpartition(".bdrm-")[2]
        if (".bdrm-" in name and len(private_tail) == 16 and
                all(ch in "0123456789abcdef" for ch in private_tail) and
                not os.path.lexists(os.path.join(path, CAPTURE_VAULT_LOCK))):
            return ("RECLAIMABLE", root_st.st_mtime,
                    "interrupted authenticated vault removal residue")
        lock_fd, _lock_st = _open_regular_lock(
            os.path.join(path, CAPTURE_VAULT_LOCK),
            "capture-vault lock is not a regular file")
    except OSError as exc:
        return "UNKNOWN", None, "vault lock cannot be evaluated (%s)" % exc
    acquired = False
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except BlockingIOError:
            return "LIVE", None, "capture-vault lock is held"
        except OSError as exc:
            return "UNKNOWN", None, "vault lock cannot be evaluated (%s)" % exc
    finally:
        if acquired:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(lock_fd)
    return "ABANDONED", root_st.st_mtime, "keyed vault has no held lock"


def finish_capture_vault(path, owned_fd, allowed_parent=pathlib.Path("/tmp")):
    """Remove only the capture-vault object held from its creation."""
    target = pathlib.Path(path)
    parent = pathlib.Path(allowed_parent)
    if (target.parent != parent or
            not target.name.startswith("bd_capture_vault-") or
            target.name in ("bd_capture_vault-", ".", "..")):
        return False, "capture-vault path is outside the owned keyed namespace"
    try:
        held = os.fstat(owned_fd)
        named = os.lstat(target)
    except OSError as exc:
        return False, "capture-vault identity is unavailable (%s)" % exc
    expected = (held.st_dev, held.st_ino)
    if (named.st_dev, named.st_ino) != expected:
        return False, "creation identity mismatch at capture-vault pathname"
    return rename_verify_destroy(target, expected_identity=expected)


def _read_regular_json(path, label):
    """Read one small, non-symlinked JSON ownership record or explain refusal."""
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        observed = os.fstat(fd)
        if not stat.S_ISREG(observed.st_mode):
            return None, None, "%s is not a regular file" % label
        chunks, total = [], 0
        while total <= _MARKER_MAX_BYTES:
            chunk = os.read(fd, min(8192, _MARKER_MAX_BYTES + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > _MARKER_MAX_BYTES:
            return None, None, "%s exceeds %d bytes" % (label,
                                                           _MARKER_MAX_BYTES)
        record = json.loads(b"".join(chunks).decode("ascii"))
        if not isinstance(record, dict):
            return None, None, "%s is not a JSON object" % label
        return record, (observed.st_dev, observed.st_ino), None
    except FileNotFoundError:
        return None, None, "%s is absent" % label
    except (OSError, UnicodeError, ValueError, TypeError) as exc:
        return None, None, "%s is unreadable (%s)" % (label, exc)
    finally:
        if fd is not None:
            os.close(fd)


def _same_owner(record, owner):
    """Owner IDs are opaque capabilities, never a prefix or display match."""
    claimed = record.get("owner") if isinstance(record, dict) else None
    return (isinstance(owner, str) and bool(owner) and
            isinstance(claimed, str) and
            hmac.compare_digest(claimed, owner))


def _worktree_root_record(root, owner):
    """Validate the bounded parent before looking at any child within it."""
    root = pathlib.Path(root).absolute()
    try:
        root_st = os.lstat(root)
    except OSError as exc:
        return root, None, "cleanup root cannot be evaluated (%s)" % exc
    if not stat.S_ISDIR(root_st.st_mode) or stat.S_ISLNK(root_st.st_mode):
        return root, None, "cleanup root is not a real directory"
    record, _identity, why = _read_regular_json(
        root / WORKTREE_ROOT_MARKER, "cleanup-root ownership record")
    if why:
        return root, None, why
    if record.get("schema") != WORKTREE_SCHEMA:
        return root, None, "cleanup-root ownership schema is not understood"
    if not _same_owner(record, owner):
        return root, None, "cleanup-root owner does not match the requested owner"
    if (record.get("root_dev"), record.get("root_ino")) != (
            root_st.st_dev, root_st.st_ino):
        return root, None, "cleanup-root ownership identity does not match"
    records = root / WORKTREE_OWNER_DIR
    try:
        records_st = os.lstat(records)
    except OSError as exc:
        return root, None, "worktree ownership directory cannot be evaluated (%s)" % exc
    if not stat.S_ISDIR(records_st.st_mode) or stat.S_ISLNK(records_st.st_mode):
        return root, None, "worktree ownership directory is not a real directory"
    return root, records, None


def _linked_worktree_state(path):
    """Prove that a candidate is a registered linked worktree, never a primary."""
    gitfile = pathlib.Path(path) / ".git"
    try:
        git_st = os.lstat(gitfile)
    except OSError as exc:
        return "not a linked worktree (%s)" % exc
    if not stat.S_ISREG(git_st.st_mode) or stat.S_ISLNK(git_st.st_mode):
        return "not a linked worktree (.git is not a regular link file)"
    try:
        content = gitfile.read_text(encoding="ascii")
    except (OSError, UnicodeError) as exc:
        return "linked-worktree gitfile is unreadable (%s)" % exc
    if not content.startswith("gitdir: "):
        return "linked-worktree gitfile has no gitdir declaration"
    try:
        result = subprocess.run(
            ["git", "-C", str(path), "worktree", "list", "--porcelain"],
            capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as exc:
        return "linked-worktree registration cannot be evaluated (%s)" % exc
    if result.returncode:
        detail = (result.stderr or result.stdout).strip().replace("\n", " ")
        return "linked-worktree registration refused (%s)" % (detail or result.returncode)
    target = os.path.realpath(path)
    current, locked = None, False
    for line in result.stdout.splitlines() + [""]:
        if line.startswith("worktree "):
            current, locked = line[9:], False
        elif line.startswith("locked") and current is not None:
            locked = True
        elif not line and current is not None:
            if os.path.realpath(current) == target:
                return "linked worktree is locked" if locked else None
            current, locked = None, False
    return "linked-worktree registration does not name this path"


def _owned_worktree_state(root, records, path, owner, now, older_than_s):
    """Return one direct child's removable state; anything uncertain is UNKNOWN."""
    if path.parent != root:
        return False, "[UNKNOWN] candidate is outside the cleanup root", None
    try:
        observed = os.lstat(path)
    except OSError as exc:
        return False, "[UNKNOWN] candidate cannot be evaluated (%s)" % exc, None
    if not stat.S_ISDIR(observed.st_mode) or stat.S_ISLNK(observed.st_mode):
        return False, "[UNKNOWN] candidate is not a real directory", None
    linked_why = _linked_worktree_state(path)
    if linked_why:
        return False, "[UNKNOWN] %s" % linked_why, None
    record_path = records / (path.name + ".json")
    record, record_identity, why = _read_regular_json(
        record_path, "worktree ownership record")
    if why:
        return False, "[UNKNOWN] %s" % why, None
    if record.get("schema") != WORKTREE_SCHEMA:
        return False, "[UNKNOWN] worktree ownership schema is not understood", None
    if not _same_owner(record, owner):
        return False, "[UNKNOWN] worktree owner does not match the requested owner", None
    if (record.get("worktree_dev"), record.get("worktree_ino")) != (
            observed.st_dev, observed.st_ino):
        return False, "[UNKNOWN] worktree ownership identity does not match", None
    try:
        released = float(record["released_at"])
    except (KeyError, TypeError, ValueError):
        return False, "[UNKNOWN] worktree release timestamp is unreadable", None
    if not math.isfinite(released) or released > now + 300:
        return False, "[UNKNOWN] worktree release timestamp is impossible", None
    age = now - released
    if age < older_than_s:
        return False, "[OWNED] released %d minute(s) ago" % (age / 60), None
    return True, "[OWNED] eligible", (record_path, record_identity)


def scan_worktrees(root, owner, now, older_than_s):
    """Classify the bounded worktree population; unknown ownership is retained."""
    root, records, root_why = _worktree_root_record(root, owner)
    if root_why:
        return [], [(str(root), "[UNKNOWN] %s" % root_why)]
    eligible, skipped = [], []
    try:
        children = sorted(root.iterdir(), key=lambda child: child.name)
    except OSError as exc:
        return [], [(str(root), "[UNKNOWN] cleanup root cannot be listed (%s)" % exc)]
    for path in children:
        if path.name in (WORKTREE_ROOT_MARKER, WORKTREE_OWNER_DIR):
            continue
        try:
            if not stat.S_ISDIR(os.lstat(path).st_mode):
                continue
        except OSError as exc:
            skipped.append((str(path), "[UNKNOWN] candidate cannot be listed (%s)" % exc))
            continue
        ok, why, _record = _owned_worktree_state(
            root, records, path, owner, now, older_than_s)
        (eligible if ok else skipped).append((str(path), why))
    return eligible, skipped


def _remove_owned_worktree(root, owner, path, older_than_s):
    """Revalidate immediately before Git removes the exact released worktree."""
    root, records, root_why = _worktree_root_record(root, owner)
    if root_why:
        return "cleanup root became UNKNOWN (%s)" % root_why
    target = pathlib.Path(path)
    ok, why, record = _owned_worktree_state(
        root, records, target, owner, time.time(), older_than_s)
    if not ok:
        return "candidate became ineligible (%s)" % why
    try:
        result = subprocess.run(
            ["git", "-C", str(target), "worktree", "remove", "--", str(target)],
            capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        return "git worktree removal failed (%s)" % exc
    if result.returncode:
        detail = (result.stderr or result.stdout).strip().replace("\n", " ")
        return "git worktree removal refused (%s)" % (detail or result.returncode)
    if os.path.lexists(target):
        return "git worktree removal reported success but the path remains"
    record_path, expected_identity = record
    try:
        current = os.lstat(record_path)
        if (current.st_dev, current.st_ino) != expected_identity:
            return "worktree ownership record changed before retirement"
        os.unlink(record_path)
    except OSError as exc:
        return "worktree removed but ownership-record retirement failed (%s)" % exc
    return None


def _test_root_state(path, now):
    """Return the disk-decidable policy state and its outcome timestamp."""
    try:
        root_st = os.lstat(path)
        name = os.path.basename(path)
        private_tail = name.rpartition(".bdrm-")[2]
        removal_residue = (
            ".bdrm-" in name and len(private_tail) == 16 and
            all(ch in "0123456789abcdef" for ch in private_tail))
        if (removal_residue and
                not os.path.lexists(os.path.join(path, RUN_LOCK)) and
                not os.path.lexists(os.path.join(path, RUN_MARKER))):
            return ("RECLAIMABLE", root_st.st_mtime,
                    "interrupted object-bound removal residue")
        lock_fd, lock_st = _open_regular_lock(
            os.path.join(path, RUN_LOCK),
            "run-root lock is not a regular file")
    except OSError as exc:
        return "UNKNOWN", None, "lock cannot be evaluated (%s)" % exc
    acquired = False
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except BlockingIOError:
            return "LIVE", None, "run-root lock is held"
        except OSError as exc:
            return "UNKNOWN", None, "lock cannot be evaluated (%s)" % exc
    finally:
        if acquired:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(lock_fd)

    marker_fd = None
    try:
        marker_fd = os.open(
            os.path.join(path, RUN_MARKER), os.O_RDONLY | os.O_NOFOLLOW)
        marker_st = os.fstat(marker_fd)
        if not stat.S_ISREG(marker_st.st_mode):
            return "UNKNOWN", None, "marker is not a regular file"
        chunks, total = [], 0
        while total <= 65536:
            chunk = os.read(marker_fd, min(8192, 65537 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > 65536:
            return "UNKNOWN", None, "marker exceeds 65536 bytes"
        record = json.loads(b"".join(chunks).decode("ascii"))
    except FileNotFoundError:
        # The exact lock name plus a released flock is the durable remainder
        # of a producer killed between lock creation and first marker publish.
        # Markerless legacy roots have no lock and remain UNKNOWN above.
        return ("ABANDONED", root_st.st_mtime,
                "run-root lock exists but initial marker was interrupted")
    except (OSError, UnicodeError, ValueError, TypeError) as exc:
        return "UNKNOWN", None, "marker is unreadable (%s)" % exc
    finally:
        if marker_fd is not None:
            os.close(marker_fd)
    if not isinstance(record, dict) or record.get("schema") != 1:
        return "UNKNOWN", None, "marker schema is not understood"
    if (record.get("root_dev"), record.get("root_ino")) != (
            root_st.st_dev, root_st.st_ino):
        return "UNKNOWN", None, "marker identity does not match the root"
    if (record.get("lock_dev"), record.get("lock_ino")) != (
            lock_st.st_dev, lock_st.st_ino):
        return "UNKNOWN", None, "marker identity does not match the lock"
    try:
        started = float(record["started_at"])
        stamp = float(record.get("updated_at", started))
    except (KeyError, TypeError, ValueError):
        return "UNKNOWN", None, "marker timestamp is unreadable"
    if (not math.isfinite(started) or not math.isfinite(stamp) or
            started > stamp or stamp > now + 300 or
            stamp < marker_st.st_mtime - 300 or
            stamp > marker_st.st_mtime + 300):
        return "UNKNOWN", None, "marker timestamp is impossible"
    state = record.get("state")
    if state == "RUNNING":
        return "ABANDONED", stamp, "RUNNING marker has no held lock"
    outcome = record.get("exitstatus")
    if state == "KEPT_FOR_FORENSICS" and type(outcome) is int and outcome != 0:
        return state, stamp, "terminal nonzero outcome"
    if state == "RECLAIMABLE" and type(outcome) is int and outcome == 0:
        return state, stamp, "terminal clean outcome whose immediate removal refused"
    if state == "UNKNOWN":
        return "UNKNOWN", stamp, record.get("reason", "producer recorded UNKNOWN")
    return "UNKNOWN", stamp, "marker state and outcome contradict"


def is_candidate(path, now, older_than_s):
    """Every reason a path may be removed, in one testable predicate."""
    p = str(path)
    # A DIRECT CHILD OF A PREFIX, never something nested under one. A bare
    # startswith() also accepts /tmp/bd-run/2026/deep/thing, so a predicate
    # written to describe "a litter directory" quietly described "anything
    # anywhere inside one" -- and this tool deletes what the predicate accepts.
    # Caught by its own selftest, which asserted a nested path was ineligible.
    matched = [pre for pre in PREFIXES
               if p.startswith(pre) and "/" not in p[len(pre):]]
    if not matched:
        return False, "outside the allowed prefixes, or nested inside one"
    for never in NEVER:
        if p == never or p.startswith(never + "/"):
            if never.endswith("bd-runctx"):
                return False, "the retained run context is never a candidate"
            return False, "the bd-jobs registry is never a candidate"
    real = os.path.realpath(p)
    if not real.startswith("/tmp/"):
        return False, "resolves outside /tmp (%s)" % real
    if os.path.basename(p).startswith("bd-testrun-"):
        state, stamp, detail = _test_root_state(p, now)
        if state in ("LIVE", "UNKNOWN"):
            return False, "[%s] %s" % (state, detail)
        age = now - stamp
        threshold = max(older_than_s, POLICY_MIN_AGE_S)
    elif os.path.basename(p).startswith("bd_capture_vault-"):
        state, stamp, detail = _capture_vault_state(p, now)
        if state in ("LIVE", "UNKNOWN"):
            return False, "[%s] %s" % (state, detail)
        age = now - stamp
        threshold = max(older_than_s, POLICY_MIN_AGE_S)
    else:
        state = None
        try:
            age = now - os.lstat(p).st_mtime
        except OSError as exc:
            return False, "cannot stat: %s" % exc
        threshold = older_than_s
    prefix = "[%s] " % state if state else ""
    if age < threshold:
        return False, "%smodified %d minute(s) ago" % (prefix, age / 60)
    return True, "%seligible" % prefix


def scan(now, older_than_s, root="/tmp", only_family=None):  # noqa: D401
    """(eligible, skipped) over the allowed prefixes. Reports both, always."""
    eligible, skipped = [], []
    base = pathlib.Path(root)
    for pre in PREFIXES:
        if pre.endswith("/"):
            here, pattern = pathlib.Path(pre), "*"
        else:
            here, pattern = base, os.path.basename(pre) + "*"
        for path in sorted(here.glob(pattern)):
            if (only_family == "bd-testrun" and
                    not path.name.startswith("bd-testrun-")):
                continue
            if (only_family == "classified" and
                    not (path.name.startswith("bd-testrun-") or
                         path.name.startswith("bd_capture_vault-"))):
                continue
            ok, why = is_candidate(path, now, older_than_s)
            (eligible if ok else skipped).append((str(path), why))
    protected = [
        (path, why) for path, why in eligible
        if any(why.startswith("[%s]" % state) for state in PROTECTED_STATES)
    ]
    def observed_mtime(item):
        try:
            return os.lstat(item[0]).st_mtime
        except OSError:
            return float("-inf")

    # Test diagnostics and secrets-bearing capture vaults are distinct
    # retention populations.  Each gets the documented newest-N floor; one
    # busy family cannot silently consume every slot belonging to the other.
    protected_groups = {"test-root": [], "capture-vault": []}
    for item in protected:
        family = ("capture-vault" if os.path.basename(item[0]).startswith(
                  "bd_capture_vault-") else "test-root")
        protected_groups[family].append(item)
    keep = set()
    for group in protected_groups.values():
        group.sort(key=observed_mtime, reverse=True)
        keep.update(path for path, _ in group[:FORENSICS_KEEP])
    if keep:
        retained, remaining = [], []
        for path, why in eligible:
            if path in keep:
                retained.append((path, "%s protected as one of newest %d" %
                                 (why.split(" ", 1)[0], FORENSICS_KEEP)))
            else:
                remaining.append((path, why))
        eligible = remaining
        skipped.extend(retained)
    return eligible, skipped


def size_of(path):
    try:
        r = subprocess.run(["du", "-sb", path], capture_output=True, text=True,
                           timeout=60)
        return int(r.stdout.split()[0]) if r.returncode == 0 else 0
    except (ValueError, IndexError, OSError, subprocess.SubprocessError):
        return 0


def remove(path):
    removed, reason = rename_verify_destroy(path)
    return None if removed else reason


def run_worktree_cleanup(args):
    """Report, and only on demand retire, one explicitly owned worktree root."""
    root = pathlib.Path(args.worktree_root).absolute()
    now = time.time()
    eligible, skipped = scan_worktrees(
        root, args.worktree_owner, now, args.older_than * 60)
    total = len(eligible) + len(skipped)
    print("bd-gc: worktree cleanup: %d direct child directory(s) under %s; "
          "%d eligible, %d skipped (older-than=%dm)" % (
              total, root, len(eligible), len(skipped), args.older_than))
    state_counts = {
        state: sum(why.startswith("[%s]" % state)
                   for _path, why in eligible + skipped)
        for state in ("OWNED", "UNKNOWN")
    }
    print("bd-gc: worktree states " + " ".join(
        "%s=%d" % item for item in state_counts.items()))
    if args.verbose:
        for path, why in skipped[:args.show]:
            print("  skip  %-50s %s" % (path, why))
        if len(skipped) > args.show:
            print("  ... showing %d of %d skipped" % (args.show, len(skipped)))
    if not eligible:
        print("bd-gc: no owned worktrees are eligible. NOTHING REMOVED.")
        return 0
    if not args.apply:
        for path, _ in eligible[:args.show]:
            print("  would remove  %s" % path)
        if len(eligible) > args.show:
            print("  ... showing %d of %d eligible" % (args.show, len(eligible)))
        print("bd-gc: DRY RUN -- %d owned worktree(s) eligible. NOTHING REMOVED. "
              "Re-run with --apply." % len(eligible))
        return 0
    errors = []
    for path, _ in eligible:
        err = _remove_owned_worktree(
            root, args.worktree_owner, path, args.older_than * 60)
        if err:
            errors.append((path, err))
    print("bd-gc: retired %d of %d eligible owned worktree(s)" % (
        len(eligible) - len(errors), len(eligible)))
    for path, err in errors[:args.show]:
        print("  FAILED %s: %s" % (path, err), file=sys.stderr)
    return 1 if errors else 0


def run(args):
    if args.older_than < MIN_AGE_MIN:
        print("bd-gc: REFUSED: --older-than %d is below the %d-minute floor. A "
              "path younger than that may belong to a run in progress."
              % (args.older_than, MIN_AGE_MIN), file=sys.stderr)
        return 2

    worktree_root = getattr(args, "worktree_root", None)
    worktree_owner = getattr(args, "worktree_owner", None)
    if worktree_root is not None or worktree_owner is not None:
        if not worktree_root or not worktree_owner:
            print("bd-gc: REFUSED: worktree cleanup requires both "
                  "--worktree-root and --worktree-owner.", file=sys.stderr)
            return 2
        return run_worktree_cleanup(args)

    now = time.time()
    only_family = getattr(args, "only", None)
    eligible, skipped = scan(now, args.older_than * 60,
                             only_family=only_family)
    total = len(eligible) + len(skipped)
    # STATE THE DENOMINATOR. "142 removed" over an unstated total is the shape
    # this repo keeps finding.
    scope = ("classified prefixes /tmp/bd-testrun-* and /tmp/bd_capture_vault-*"
             if only_family == "classified" else
             "bd-testrun prefix /tmp/bd-testrun-*" if only_family == "bd-testrun"
             else " and ".join(PREFIXES))
    print("bd-gc: %d path(s) under %s; %d eligible, %d skipped (older-than=%dm)"
          % (total, scope, len(eligible), len(skipped),
             args.older_than))
    state_counts = {
        state: sum(why.startswith("[%s]" % state)
                   for _path, why in eligible + skipped)
        for state in ("LIVE", "KEPT_FOR_FORENSICS", "RECLAIMABLE",
                      "ABANDONED", "UNKNOWN")
    }
    if sum(state_counts.values()):
        print("bd-gc: states " + " ".join(
            "%s=%d" % item for item in state_counts.items()))
    if args.verbose:
        for path, why in skipped[:args.show]:
            print("  skip  %-50s %s" % (path, why))
        if len(skipped) > args.show:
            print("  ... showing %d of %d skipped" % (args.show, len(skipped)))

    if not eligible:
        print("bd-gc: nothing eligible. NOTHING REMOVED.")
        return 0

    freed = sum(size_of(p) for p, _ in eligible) if args.measure else 0
    if not args.apply:
        for path, _ in eligible[:args.show]:
            print("  would remove  %s" % path)
        if len(eligible) > args.show:
            print("  ... showing %d of %d eligible" % (args.show, len(eligible)))
        print("bd-gc: DRY RUN -- %d path(s) eligible%s. NOTHING REMOVED. "
              "Re-run with --apply." % (len(eligible),
                                        ", %.1f MB" % (freed / 1e6) if args.measure else ""))
        return 0

    errors = []
    for path, _ in eligible:
        err = remove(path)
        if err:
            errors.append((path, err))
    print("bd-gc: removed %d of %d eligible path(s)%s"
          % (len(eligible) - len(errors), len(eligible),
             ", freed %.1f MB" % (freed / 1e6) if args.measure else ""))
    for path, err in errors[:args.show]:
        print("  FAILED %s: %s" % (path, err), file=sys.stderr)
    return 1 if errors else 0


def selftest(_args):
    failures = []
    now = time.time()
    old = 3600.0

    with tempfile.TemporaryDirectory(dir="/tmp", prefix="bd-gctest-") as td:
        stale = pathlib.Path(td) / "old"
        stale.mkdir()
        os.utime(stale, (now - 99999, now - 99999))
        fresh = pathlib.Path(td) / "new"
        fresh.mkdir()

        # The temp dir itself starts with /tmp/bd- so its children do not; test
        # the predicate directly on paths that do.
        ok, why = is_candidate("/tmp/bd-jobs", now, old)
        if ok or "registry" not in why:
            failures.append("the bd-jobs registry was treated as removable -- "
                            "deleting it manufactures the orphans it prevents")
        ok, _ = is_candidate("/tmp/bd-jobs/abc.json", now, old)
        if ok:
            failures.append("a file INSIDE the registry was eligible")
        ok, why = is_candidate("/var/tmp/bd-thing", now, old)
        if ok or "prefix" not in why:
            failures.append("a path outside the allowed prefixes was eligible")
        # /tmp/bd-gctest-XXXX/old starts with /tmp/bd- and is NOT litter: it is
        # a child of a litter directory. The predicate must see the difference.
        ok, why = is_candidate(str(stale), now, old)
        if ok or "nested" not in why:
            failures.append("a path NESTED inside a litter directory was "
                            "eligible in its own right: %s" % why)

        # A real eligible path, and a real ineligible one, under the prefix.
        with tempfile.TemporaryDirectory(dir="/tmp", prefix="bd-") as bd:
            os.utime(bd, (now - 99999, now - 99999))
            ok, why = is_candidate(bd, now, old)
            if not ok:
                failures.append("an old /tmp/bd-* dir was not eligible: %s" % why)
            ok, why = is_candidate(bd, now, 10 ** 9)
            if ok or "minute" not in why:
                failures.append("a path younger than the window was eligible")

            eligible, _skipped = scan(now, old)
            if bd not in [p for p, _ in eligible]:
                failures.append("scan() missed a path its own predicate accepts")

            # DRY RUN MUST NOT REMOVE, AND MUST SAY SO. Scoped to this temp
            # prefix rather than the real /tmp: a selftest whose denominator is
            # "whatever litter this box happens to hold" measures the box, not
            # the tool, and on the master that is 9440 paths and a du storm.
            global PREFIXES
            saved = PREFIXES
            PREFIXES = (bd + "/",)
            try:
                victim = pathlib.Path(bd) / "victim"
                victim.mkdir()
                os.utime(victim, (now - 99999, now - 99999))
                ns = argparse.Namespace(older_than=60, apply=False, show=5,
                                        verbose=False, measure=False)
                rc = run(ns)
                if rc != 0 or not victim.is_dir():
                    failures.append("a dry run removed something, or exited "
                                    "nonzero")
                ns.apply = True
                rc = run(ns)
                if rc != 0 or victim.exists():
                    failures.append("--apply did not remove an eligible path")
            finally:
                PREFIXES = saved

        ns = argparse.Namespace(older_than=1, apply=True, show=5, verbose=False,
                                measure=False)
        if run(ns) != 2:
            failures.append("--older-than below the floor was not refused")

    for f in failures:
        print("SELFTEST FAIL: %s" % f, file=sys.stderr)
    if failures:
        return 1
    print("SELFTEST PASS: registry exclusion, prefix scope, age floor, scan "
          "agreement, dry run removes nothing")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        description="report (and with --apply, remove) /tmp litter from test runs")
    p.add_argument("--older-than", type=int, default=120,
                   help="minutes; paths younger are never touched (floor %d)"
                        % MIN_AGE_MIN)
    p.add_argument("--apply", action="store_true",
                   help="actually remove. Without it, nothing is removed.")
    p.add_argument("--measure", action="store_true",
                   help="du each candidate (slow on thousands of paths)")
    p.add_argument("--show", type=int, default=20)
    p.add_argument("--verbose", action="store_true")
    p.add_argument("--only", choices=("bd-testrun", "classified"),
                   help="scope automatic cleanup to a classified family")
    p.add_argument("--worktree-root",
                   help="explicit parent carrying the bounded worktree ownership record")
    p.add_argument("--worktree-owner",
                   help="exact owner capability required by worktree ownership records")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--finish-capture-vault")
    p.add_argument("--owned-fd", type=int)
    args = p.parse_args(argv)
    if (args.worktree_root is None) != (args.worktree_owner is None):
        p.error("--worktree-root and --worktree-owner must be given together")
    if args.worktree_root is not None and args.only is not None:
        p.error("--only does not apply to ownership-record worktree cleanup")
    if args.finish_capture_vault is not None:
        if args.owned_fd is None:
            p.error("--finish-capture-vault requires --owned-fd")
        ok, why = finish_capture_vault(args.finish_capture_vault, args.owned_fd)
        if ok:
            print("bd-gc: removed descriptor-owned capture vault")
            return 0
        print("bd-gc: REFUSED capture-vault removal: %s" % why,
              file=sys.stderr)
        return 1
    if args.owned_fd is not None:
        p.error("--owned-fd requires --finish-capture-vault")
    if args.selftest:
        return selftest(args)
    return run(args)


if __name__ == "__main__":
    sys.exit(main())
