#!/usr/bin/env python3
"""bd-dependency-license -- inventory dependency licenses.

Reads Python requirements + installed wheel METADATA (License / Classifier) and
node package.json license fields to build a license inventory. Flags deps with
NO discoverable license (a compliance gap) and any copyleft (GPL/AGPL) that may
need review for a distributed app. Read-only.

Usage: bd-dependency-license [--work DIR] [--home DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
COPYLEFT=re.compile(r'(?i)\b(GPL|AGPL|LGPL)\b')

def from_wheel_metadata(sp_dir):
    lic={}
    for meta in glob.glob(os.path.join(sp_dir,"*.dist-info","METADATA")):
        name=os.path.basename(os.path.dirname(meta)).split("-")[0]
        l=None
        for line in open(meta,errors="ignore"):
            if line.startswith("License:") and line[8:].strip() not in ("","UNKNOWN"):
                l=line[8:].strip()[:40]; break
            if line.startswith("Classifier: License ::"):
                l=line.split("::")[-1].strip()[:40]
        lic[name]=l
    return lic

def scan(work, home):
    lic={}
    # installed venv wheels
    for base in (os.path.join(work,"venv","lib"),):
        for sp in glob.glob(os.path.join(base,"python*","site-packages")):
            lic.update(from_wheel_metadata(sp))
    # requirements (names only, license unknown unless in venv)
    reqs=set()
    for rf in glob.glob(os.path.join(work,"requirements*.txt")):
        for line in open(rf,errors="ignore"):
            m=re.match(r'\s*([A-Za-z0-9_.\-]+)',line)
            if m and not line.strip().startswith("#"): reqs.add(m.group(1).lower())
    for r in reqs: lic.setdefault(r,None)
    rows=[{"dep":k,"license":v,"copyleft":bool(v and COPYLEFT.search(v)),"unknown":v is None} for k,v in sorted(lic.items())]
    return rows

def selftest():
    ok=True
    rows=scan("/home/claude/work","/home/claude")
    print(("PASS" if len(rows)>0 else "FAIL")+"  license inventory built (%d deps)"%len(rows))
    ok=ok and len(rows)>0
    known=sum(1 for r in rows if not r["unknown"])
    print(("PASS" if known>0 else "WARN")+"  %d deps have a discoverable license"%known)
    print(("PASS" if isinstance(rows,list) else "FAIL")+"  copyleft flagged: %d"%sum(1 for r in rows if r["copyleft"]))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default="/home/claude/work"); ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    sec.require_bundle(a.home)
    rows=scan(a.work,a.home)
    unk=[r for r in rows if r["unknown"]]; cl=[r for r in rows if r["copyleft"]]
    if sec.emit({"deps":rows,"summary":{"total":len(rows),"unknown_license":len(unk),"copyleft":len(cl)}},as_json=a.json): return 0
    print("%d dep(s); %d unknown-license, %d copyleft:"%(len(rows),len(unk),len(cl)))
    for r in cl[:20]: print("  %scopyleft%s %s (%s)"%(Y,RST,r["dep"],r["license"]))
    for r in unk[:20]: print("  %sunknown %s %s"%(DIM,RST,r["dep"]))
    return 0
sys.exit(main())
