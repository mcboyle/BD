#!/usr/bin/env python3
"""bd-verify -- run the app capability suites (the verification kit) as one gate.

The verification kit (bd_verification_kit.zip) has 6 app suites -- ~1,134 real
assertions against the live app source (SSRF guard, DB round-trips, 810 pure
functions, respx/hypothesis property spaces) -- covering surface pytest doesn't
reach. This makes them a first-class toolchain entry point: discover the suites,
run each against the work tree, aggregate PASS/FAIL, and gate on any failure.

Suites are found in (first that exists): --kit DIR, /home/claude/kit_build/
verification/app_suites, or a bd_verification_kit.zip in the home dir. Each suite
runs with the app on PYTHONPATH; a suite's own nonzero exit or any FAIL line ->
BD-VERIFY-FAIL. Read-only w.r.t. the tree.

Usage:
    bd-verify [--work DIR] [--kit DIR] [--suite NAME] [--json] [--gate]
    bd-verify --selftest
Exit 3 (with --gate) if any suite fails; 2 if no suites found; else 0.
"""
import argparse
import glob
import os
import re
import subprocess
import sys
import zipfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"
_THISRUN = re.compile(r"THIS RUN:\s*PASS=(\d+).*?FAIL=(\d+)", re.S)


def find_suites(kit):
    # explicit --kit is authoritative: if given, use ONLY it (no silent fallback
    # to the default kit dir -- otherwise a bogus --kit masks a missing kit).
    if kit is not None:
        if os.path.isdir(kit):
            s = sorted(glob.glob(os.path.join(kit, "*suite*.py")))
            if s:
                return s, kit
        return [], None
    roots = ["/home/claude/kit_build/verification/app_suites"]
    for r in roots:
        if os.path.isdir(r):
            s = sorted(glob.glob(os.path.join(r, "*suite*.py")))
            if s:
                return s, r
    # fall back: extract app_suites from a kit zip in home
    for z in glob.glob("/home/claude/bd_verification_kit.zip"):
        dest = "/tmp/_bdverify_kit"
        try:
            with zipfile.ZipFile(z) as zf:
                zf.extractall(dest)
            d = os.path.join(dest, "verification", "app_suites")
            if os.path.isdir(d):
                return sorted(glob.glob(os.path.join(d, "*suite*.py"))), d
        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
            pass
    return [], None


def _run_suite(path, work):
    venv_sp = os.path.join(work, "venv", "lib", "python3.12", "site-packages")
    pp = ":".join([work, venv_sp, "/tmp/prestaged_site_packages"])
    env = {k: v for k, v in os.environ.items() if k != "PYTHONPATH"}
    env["PYTHONPATH"] = pp
    try:
        r = subprocess.run([sys.executable, path], cwd=work, env=env,
                           capture_output=True, text=True, timeout=300)
        out = r.stdout + r.stderr
        m = _THISRUN.search(out)
        if m:
            p, f = int(m.group(1)), int(m.group(2))
            return {"passed": p, "failed": f, "rc": r.returncode}
        return {"passed": 0, "failed": 0, "rc": r.returncode,
                "note": "no THIS RUN line (crash?)"}
    except subprocess.TimeoutExpired:
        return {"passed": 0, "failed": 0, "rc": -99, "note": "timeout"}
    except Exception as e:
        return {"passed": 0, "failed": 0, "rc": -98, "note": str(e)}


def run(work, kit, only):
    suites, root = find_suites(kit)
    if not suites:
        return {"status": "no_suites",
                "reason": "no app_suites found (kit dir or bd_verification_kit.zip)"}
    results = []
    for s in suites:
        name = os.path.basename(s)[:-3]
        if only and only not in name:
            continue
        r = _run_suite(s, work)
        r["suite"] = name
        r["ok"] = (r["failed"] == 0 and r.get("rc", 1) == 0 and r["passed"] > 0)
        results.append(r)
    tp = sum(r["passed"] for r in results)
    tf = sum(r["failed"] for r in results)
    bad = [r for r in results if not r["ok"]]
    return {"status": "ok", "root": root, "suites": results,
            "total_pass": tp, "total_fail": tf, "clean": not bad}


def selftest():
    ok = True
    import tempfile
    # a fake suite dir with a passing and a failing suite; verify aggregation + gate
    with tempfile.TemporaryDirectory() as d:
        kit = os.path.join(d, "app_suites"); os.makedirs(kit)
        open(os.path.join(kit, "good_suite.py"), "w").write(
            'print("=" * 5)\nprint("THIS RUN: PASS=3  FAIL=0   (ran 3: X)")\n'
            'import sys; sys.exit(0)\n')
        open(os.path.join(kit, "bad_suite.py"), "w").write(
            'print("THIS RUN: PASS=1  FAIL=2   (ran 3: Y)")\n'
            'import sys; sys.exit(1)\n')
        # use a throwaway "work" (suites here don't import the app)
        res = run(d, kit, None)
        by = {r["suite"]: r for r in res["suites"]}
        good = by.get("good_suite", {}).get("ok") is True
        print(("PASS" if good else "FAIL") + "  passing suite parsed as ok (PASS=3/FAIL=0)")
        ok &= good
        bad = by.get("bad_suite", {}).get("ok") is False
        print(("PASS" if bad else "FAIL") + "  failing suite flagged not-ok (FAIL=2) [neg control]")
        ok &= bad
        agg = res["total_pass"] == 4 and res["total_fail"] == 2 and not res["clean"]
        print(("PASS" if agg else "FAIL") +
              "  aggregation: 4 pass / 2 fail, clean=False (got %d/%d/%s)" %
              (res["total_pass"], res["total_fail"], res["clean"]))
        ok &= agg
    # no-suites path
    with tempfile.TemporaryDirectory() as d2:
        r2 = run(d2, os.path.join(d2, "nope"), None)
        print(("PASS" if r2["status"] == "no_suites" else "FAIL") +
              "  missing suites -> no_suites status")
        ok &= r2["status"] == "no_suites"
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--kit", default=None)
    ap.add_argument("--suite", default=None)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--gate", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    res = run(a.work, a.kit, a.suite)
    if res.get("status") == "no_suites":
        if sec.emit(res, as_json=a.json):
            return 2
        print("%sno app suites found%s (%s)" % (Y, RST, res["reason"]))
        return 2
    if sec.emit(res, as_json=a.json):
        return 3 if (a.gate and not res["clean"]) else 0
    print("app verification: %s%d pass%s / %s%d fail%s across %d suite(s)" %
          (G, res["total_pass"], RST,
           R if res["total_fail"] else G, res["total_fail"], RST, len(res["suites"])))
    for r in res["suites"]:
        tag = (G + "OK  " + RST) if r["ok"] else (R + "FAIL" + RST)
        extra = (" [%s]" % r["note"]) if r.get("note") else ""
        print("  %s %-34s %d pass / %d fail%s" %
              (tag, r["suite"], r["passed"], r["failed"], extra))
    if not res["clean"]:
        print("%sBD-VERIFY-FAIL: one or more app suites failed against the tree.%s"
              % (R, RST))
        return 3 if a.gate else 1
    print("%sall app suites pass%s" % (G, RST))
    return 0


if __name__ == "__main__":
    sys.exit(main())
