#!/usr/bin/env python3
"""bd-plugin-threatmodel -- threat-model a plugin before enabling.

Builds a per-plugin threat model from bd-plugin-audit's surface data: maps each
plugin's declared/implied capabilities and powerful imports to a threat tier
(CRITICAL = full-access + exec/network; HIGH = exec OR full-access; MEDIUM =
filesystem/network only; LOW = pure compute). Lists the specific threats
(arbitrary code exec, live browser access, egress, fs write) each plugin could
realize. The go/no-go brief a reviewer reads before enabling. Advisory, read-only.

Usage: bd-plugin-threatmodel [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_pa=_load_tool("bd-plugin-audit")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
EXEC={"subprocess","os.system","eval(","exec(","ctypes","__import__","pickle.load","marshal.loads"}
NET={"socket"}

def model(work):
    rows=[]
    for r in _pa.scan(work):
        imps=set(r["forbidden_imports"])
        fa=r["full_access_surface"]
        has_exec=bool(imps & EXEC)
        has_net=bool(imps & NET)
        if fa and has_exec: tier="CRITICAL"
        elif has_exec or fa: tier="HIGH"
        elif has_net: tier="MEDIUM"
        else: tier="LOW"
        threats=[]
        if has_exec: threats.append("arbitrary code execution")
        if fa: threats.append("live browser context / page access")
        if has_net: threats.append("network egress")
        rows.append({"file":r["file"],"tier":tier,"threats":threats,"imports":sorted(imps),"full_access":fa})
    order={"CRITICAL":0,"HIGH":1,"MEDIUM":2,"LOW":3}
    rows.sort(key=lambda r:order[r["tier"]])
    return rows

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b=os.path.join(d,"bulk_downloader"); os.makedirs(b)
        open(os.path.join(b,"plugin_crit.py"),"w").write("import subprocess\ndef page_access(): pass\n")
        open(os.path.join(b,"plugin_net.py"),"w").write("import socket\n")
        rows=model(d)
    tiers={r["file"].split("/")[-1]:r["tier"] for r in rows}
    good=tiers.get("plugin_crit.py")=="CRITICAL" and tiers.get("plugin_net.py")=="MEDIUM"
    print(("PASS" if good else "FAIL")+"  threat tiers (crit=CRITICAL, net=MEDIUM): %s"%tiers)
    ok=ok and good
    real=model(sec.DEFAULT_WORK)
    print(("PASS" if isinstance(real,list) else "FAIL")+"  real tree: %d plugins modeled"%len(real))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    rows=model(a.work)
    if sec.emit({"plugins":rows,"summary":{"total":len(rows),"critical":sum(1 for r in rows if r["tier"]=="CRITICAL")}},as_json=a.json): return 0
    for r in rows[:40]:
        col={"CRITICAL":R,"HIGH":R,"MEDIUM":Y,"LOW":G}[r["tier"]]
        print("  %s%-8s%s %s  %s%s%s"%(col,r["tier"],RST,r["file"],DIM,", ".join(r["threats"]) or "none",RST))
    return 0
sys.exit(main())
