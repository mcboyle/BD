#!/usr/bin/env python3
"""bd-netns-proof -- evidence that a process is (or isn't) in a distinct netns.

Collects the network-namespace evidence for a PID: the net-ns inode (from
/proc/<pid>/ns/net), the host's own inode for comparison, interface list, and
route/DNS reachability where inspectable. A process is CONFINED iff its net-ns
inode differs from the host's. In-sandbox we can read our own + a child PID's
inode (real evidence); actually CREATING a netns needs CAP_NET_ADMIN (stash) --
so --logic-only verifies the comparison logic against synthetic inodes without
requiring privilege. Read-only.

A verdict has THREE states: confined / shared / unknown. An unreadable ns
inode is UNKNOWN -- it is never reported as "shares host net namespace"; a
verdict nobody observed is not evidence (the v3.66.740 finding: unknown was
laundered into "shared" inside the F5 evidence chain).

Usage:
    bd-netns-proof [--pid PID] [--json]           # evidence for PID (default: self)
    bd-netns-proof --gate --expect confined|shared [--pid PID]
    bd-netns-proof --logic-only                   # self-verifying comparator check
    bd-netns-proof --selftest
Exit: report mode 0. --gate: 0 iff the verdict MATCHES --expect; 1 on the
opposite verdict; 2 on UNKNOWN (unknown never satisfies a gate, for either
expectation). --logic-only: 0 iff every comparator case yields its expected
verdict, else 1.
"""
import argparse
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def ns_inode(pid):
    """Read the net-ns inode for a pid from /proc/<pid>/ns/net (link target)."""
    try:
        target = os.readlink(f"/proc/{pid}/ns/net")  # 'net:[4026531833]'
        return target.split("[", 1)[1].rstrip("]") if "[" in target else target
    except OSError:
        return None


def host_inode():
    return ns_inode(1) or ns_inode("self")


def evidence(pid):
    self_ino = ns_inode(pid)
    host_ino = host_inode()
    logic = confinement_logic(self_ino, host_ino)
    ev = {"pid": pid, "ns_inode": self_ino, "host_ns_inode": host_ino,
          "confined": logic["confined"], "verdict": logic["verdict"],
          "reason": logic["reason"],
          "interfaces": [], "netns_toolchain": None}
    # interface list (best-effort, from the pid's ns via ip if privileged)
    import shutil
    ev["netns_toolchain"] = shutil.which("ip") is not None
    try:
        out = subprocess.run(["ip", "-o", "link"], capture_output=True,
                             text=True, timeout=5)
        ev["interfaces"] = [l.split(":", 2)[1].strip()
                            for l in out.stdout.splitlines() if ":" in l][:10]
    except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
        pass
    return ev


def confinement_logic(child_ino, host_ino):
    """Pure logic: verdict for a process with net-ns inode child_ino vs host.

    THREE states. confined=True ("confined"), False ("shared"), None
    ("unknown"). An unreadable inode is UNKNOWN -- reporting it as "shared"
    would be a definite verdict nobody observed.
    """
    if child_ino is None:
        return {"confined": None, "verdict": "unknown",
                "reason": "no ns inode readable for the pid -- UNKNOWN, not shared"}
    if host_ino is None:
        return {"confined": None, "verdict": "unknown",
                "reason": "host ns inode unreadable -- UNKNOWN, not shared"}
    if child_ino == host_ino:
        return {"confined": False, "verdict": "shared",
                "reason": "shares host net namespace"}
    return {"confined": True, "verdict": "confined",
            "reason": f"distinct net-ns ({child_ino} != {host_ino})"}


def selftest():
    ok = True
    # 1. we can read our own ns inode (real evidence path works)
    ev = evidence("self")
    got = ev["ns_inode"] is not None and ev["host_ns_inode"] is not None
    print(("PASS" if got else "FAIL") +
          f"  own ns inode readable (ns={ev['ns_inode']}, host={ev['host_ns_inode']})")
    ok &= got
    # 2. in-sandbox self shares host ns -> not confined (expected)
    shares = not ev["confined"]
    print(("PASS" if shares else "WARN") +
          f"  self shares host netns in-sandbox (confined={ev['confined']})")
    # 3. confinement logic: distinct inode -> confined; same -> shared
    a = confinement_logic("4026999999", "4026531833")
    b = confinement_logic("4026531833", "4026531833")
    logic = a["verdict"] == "confined" and b["verdict"] == "shared"
    print(("PASS" if logic else "FAIL") +
          f"  confinement logic (distinct->confined, same->shared): {logic}")
    ok &= logic
    # 3b. UNKNOWN IS A THIRD STATE. An unreadable inode must never yield the
    # definite verdict "shared" (the v3.66.740 laundering finding).
    u1 = confinement_logic(None, "4026531833")
    u2 = confinement_logic("4026531833", None)
    third = (u1["verdict"] == "unknown" and u1["confined"] is None
             and u2["verdict"] == "unknown" and u2["confined"] is None)
    print(("PASS" if third else "FAIL") +
          f"  unreadable inode -> UNKNOWN, not 'shared' (third state): {third}")
    ok &= third
    # 3c. THE GATE CAN FAIL. Real subprocess exits: expecting the verdict we
    # actually have -> 0; expecting the opposite -> 1. In-sandbox self is
    # reliably readable, so the live verdict here is confined/shared, not
    # unknown -- both directions of the gate are exercised for real.
    me = os.path.realpath(__file__)
    have = ev["verdict"]
    if have in ("confined", "shared"):
        anti = "shared" if have == "confined" else "confined"
        r_hit = subprocess.run([sys.executable, me, "--gate", "--expect", have],
                               capture_output=True, timeout=30)
        r_miss = subprocess.run([sys.executable, me, "--gate", "--expect", anti],
                                capture_output=True, timeout=30)
        gate = r_hit.returncode == 0 and r_miss.returncode == 1
        print(("PASS" if gate else "FAIL") +
              f"  --gate exits 0 on match / 1 on mismatch "
              f"(match={r_hit.returncode}, mismatch={r_miss.returncode})")
        ok &= gate
    else:
        print("FAIL  own verdict is unknown in-sandbox -- cannot exercise the gate")
        ok = False
    # 4. real module's is_supported agrees on toolchain presence
    print(("PASS" if ev["netns_toolchain"] is not None else "FAIL") +
          f"  netns toolchain probed (ip present={ev['netns_toolchain']})")
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pid", default="self")
    ap.add_argument("--logic-only", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--gate", action="store_true",
                    help="exit non-zero unless the verdict matches --expect "
                         "(unknown NEVER satisfies the gate)")
    ap.add_argument("--expect", choices=["confined", "shared"],
                    help="the verdict --gate asserts")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if a.gate and not a.expect:
        print("--gate requires --expect confined|shared: a gate must declare "
              "what it is proving", file=sys.stderr)
        return 2
    if a.logic_only:
        # SELF-VERIFYING: each case carries its expected verdict, and a
        # comparator that disagrees FAILS this mode. Previously this printed
        # whatever the comparator said and exited 0 -- a check that could not
        # fail on its own subject.
        cases = [("4026999999", "4026531833", "confined"),
                 ("4026531833", "4026531833", "shared"),
                 (None, "4026531833", "unknown"),
                 ("4026531833", None, "unknown")]
        res, bad = [], 0
        for c, h, want in cases:
            r = {"child": c, "host": h, "expected": want, **confinement_logic(c, h)}
            r["ok"] = (r["verdict"] == want)
            bad += 0 if r["ok"] else 1
            res.append(r)
        if sec.emit({"logic_cases": res, "failed": bad}, as_json=a.json):
            return 0 if bad == 0 else 1
        for r in res:
            tag = {"confined": G + "CONFINED" + RST,
                   "shared": Y + "shared  " + RST,
                   "unknown": Y + "UNKNOWN " + RST}[r["verdict"]]
            mark = "" if r["ok"] else (R + "  <- WRONG (expected %s)" % r["expected"] + RST)
            print(f"  {tag} child={r['child']} host={r['host']}  {DIM}{r['reason']}{RST}{mark}")
        if bad:
            print(R + f"logic-only: {bad} comparator case(s) wrong" + RST)
            return 1
        return 0
    ev = evidence(a.pid)
    if sec.emit(ev, as_json=a.json):
        if a.gate:
            if ev["verdict"] == "unknown":
                return 2
            return 0 if ev["verdict"] == a.expect else 1
        return 0
    tag = {"confined": G + "CONFINED" + RST,
           "shared": Y + "NOT confined (shared)" + RST,
           "unknown": Y + "UNKNOWN" + RST}[ev["verdict"]]
    print(f"pid {ev['pid']}: {tag}")
    print(f"  net-ns inode: {ev['ns_inode']}  (host: {ev['host_ns_inode']})")
    print(f"  {DIM}{ev['reason']}{RST}")
    print(f"  interfaces: {', '.join(ev['interfaces']) or '(none/unreadable)'}")
    print(f"  {DIM}netns toolchain present: {ev['netns_toolchain']}; "
          f"creating a netns needs CAP_NET_ADMIN (stash-only){RST}")
    if a.gate:
        if ev["verdict"] == "unknown":
            print(R + f"GATE FAIL -- verdict UNKNOWN (expected {a.expect}); "
                  "unknown never satisfies a proof gate" + RST)
            return 2
        if ev["verdict"] != a.expect:
            print(R + f"GATE FAIL -- verdict {ev['verdict']}, expected {a.expect}" + RST)
            return 1
        print(G + f"GATE PASS -- verdict {ev['verdict']} as expected" + RST)
    return 0


sys.exit(main())
