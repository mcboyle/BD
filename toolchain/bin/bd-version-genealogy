#!/usr/bin/env python3
"""bd-version-genealogy -- build a version ancestry graph from the changelog.

Parses CHANGELOG.md version headers in order to build the ancestry chain
(each version descends from the one below it) with the one-line summary of what
changed at each step. Also cross-checks which source zips exist for each version
in home, so gaps in the artifact history are visible. The "which version came
from which and what changed" map. Read-only.

Usage: bd-version-genealogy [--work DIR] [--home DIR] [--limit N] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
HEADER=re.compile(r'^##\s*v?(\d+\.\d+\.\d+)\s*(?:[-\u2013:]\s*)?(.*)$')

def genealogy(work, home, limit):
    chlog=os.path.join(work,"CHANGELOG.md")
    chain=[]
    if os.path.exists(chlog):
        for line in open(chlog,errors="ignore"):
            m=HEADER.match(line.strip())
            if m:
                chain.append({"version":m.group(1),"summary":m.group(2).strip()[:80]})
    # de-dup consecutive same-version (multi-rev entries)
    seen=set(); uniq=[]
    for c in chain:
        if c["version"] in seen: continue
        seen.add(c["version"]); uniq.append(c)
    for c in uniq:
        n=c["version"].split(".")[-1]
        c["source_zip_present"]=os.path.exists(os.path.join(home,"BulkDownloader_v3_66_%s.zip"%n))
    return uniq[:limit]

def selftest():
    ok=True
    g=genealogy("/home/claude/work","/home/claude",50)
    print(("PASS" if len(g)>=1 else "FAIL")+"  ancestry built (%d versions)"%len(g))
    ok=ok and len(g)>=1
    # newest first, descending
    if len(g)>=2:
        v0=[int(x) for x in g[0]["version"].split(".")]
        v1=[int(x) for x in g[1]["version"].split(".")]
        desc=v0>=v1
        print(("PASS" if desc else "FAIL")+"  ordered newest-first (%s -> %s)"%(g[0]["version"],g[1]["version"]))
        ok=ok and desc
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--limit",type=int,default=30)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    sec.require_bundle(a.home)
    g=genealogy(a.work,a.home,a.limit)
    if sec.emit({"genealogy":g,"summary":{"versions":len(g)}},as_json=a.json): return 0
    print("version ancestry (newest first, %d shown):"%len(g))
    for i,c in enumerate(g):
        arrow="" if i==len(g)-1 else " |"
        zip_mark=(G+"z"+RST) if c["source_zip_present"] else (DIM+"-"+RST)
        print("  [%s] v%s  %s%s%s%s"%(zip_mark,c["version"],DIM,c["summary"],RST,arrow))
    return 0
sys.exit(main())
