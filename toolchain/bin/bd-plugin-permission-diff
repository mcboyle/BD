#!/usr/bin/env python3
"""bd-plugin-permission-diff -- detect plugin permission creep across manifest versions. Diffs capabilities/permissions between an old and new plugin manifest; a NEW full-access cap (lifecycle/page_access) or added permission is creep to review. Usage: bd-plugin-permission-diff OLD.json NEW.json [--json] [--selftest]"""
import argparse, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
FIELDS=["capabilities","caps","permissions","full_access","access_level","api_version"]

def load(p):
    try: return json.load(open(p))
    # why: input unavailable/unreadable; caller uses its fallback, not a wrong value
    except Exception: return None

def diff(a, b):
    out={"added_keys":[],"removed_keys":[],"changed":[]}
    ak=set(a.keys()) if isinstance(a,dict) else set()
    bk=set(b.keys()) if isinstance(b,dict) else set()
    out["added_keys"]=sorted(bk-ak); out["removed_keys"]=sorted(ak-bk)
    for f in FIELDS:
        if isinstance(a,dict) and isinstance(b,dict) and a.get(f)!=b.get(f):
            out["changed"].append({"field":f,"was":a.get(f),"now":b.get(f)})
    return out

def selftest():
    ok=True
    f0=FIELDS[0]
    a={f0:"aaa","selectors":{"x":1}}; b={f0:"bbb","selectors":{"x":2},"new":1}
    d=diff(a,b)
    good="new" in d["added_keys"] and any(c["field"]==f0 for c in d["changed"])
    print(("PASS" if good else "FAIL")+"  added key + changed field detected (%s)"%d)
    ok=ok and good
    d2=diff(a,a)
    print(("PASS" if not d2["added_keys"] and not d2["changed"] else "FAIL")+"  self-diff empty")
    ok=ok and not d2["changed"]
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("old",nargs="?"); ap.add_argument("new",nargs="?")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    if not a.old or not a.new: print(R+"OLD and NEW json paths required"+RST); return 1
    A=load(a.old); B=load(a.new)
    if A is None or B is None: print(R+"could not load both files"+RST); return 1
    d=diff(A,B)
    drift=d["added_keys"] or d["removed_keys"] or d["changed"]
    if sec.emit({**d,"summary":{"added":len(d["added_keys"]),"removed":len(d["removed_keys"]),"changed":len(d["changed"])}},as_json=a.json): return 1 if drift else 0
    for k in d["added_keys"]: print("  %s+ %s%s"%(G,k,RST))
    for k in d["removed_keys"]: print("  %s- %s%s"%(R,k,RST))
    for c in d["changed"]: print("  %s~ %s: %r -> %r%s"%(Y,c["field"],c["was"],c["now"],RST))
    if not drift: print(G+"no significant differences"+RST)
    return 1 if drift else 0

if __name__ == "__main__":
    sys.exit(main())
