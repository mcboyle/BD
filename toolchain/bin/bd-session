#!/usr/bin/env python3
"""bd-session -- the multi-cut session ledger. Multi-cut chats are regular (e.g.
680 B1 -> 681 B2 -> 682 P7 in one session); this tracks the arc so the
"Session arc" bullets and STATE.deploy_queue are DERIVED, never hand-typed
(hand-typing a derivable list is the `stale-copy-of-derived-fact` shape).

It WRAPS bd-cut/bd-ship (does not replace them). Ideal wiring: bd-cut/bd-ship
call `bd-session add ...` on a successful cut, and the deploy step calls
`bd-session deploy --green`. Until that hook lands, use it manually.

Ledger: /home/claude/.bd_session_ledger.json (one arc per sandbox lifetime;
`bd-session reset` starts fresh).

Subcommands:
  add      --version V --label L [--guard-sha SHA] [--fe] [--band PASS|FAIL] [--notes N]
  deploy   --version V [--green]        # mark deployed / green-on-stash
  show                                  # the arc: versions, guard lineage, per-cut status
  arc                                   # draft the KB_HANDOFF "## Session arc" FACTUAL bullets
  check                                 # WARN (never fail) if any cut lacks a green record
  sync-state [--state STATE.json]       # write non-green cuts into STATE.deploy_queue
  reset                                 # clear the ledger

Design notes:
  * `check` is a soft warn, not a gate -- the handoff correctly ships BEFORE the
    last cut's stash confirmation (682 went out "awaiting stash test").
  * `arc` emits the factual half only (version + label + guard change). The
    LESSON prose stays yours -- judgment is not auto-generated.
"""
import argparse, datetime, json, os, sys

LEDGER = os.environ.get("BD_SESSION_LEDGER", "/home/claude/.bd_session_ledger.json")

def load():
    if os.path.exists(LEDGER):
        try:
            return json.load(open(LEDGER))
        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
            pass
    return {"started": datetime.datetime.now().isoformat(timespec="seconds"), "cuts": []}

def save(d):
    json.dump(d, open(LEDGER, "w"), indent=2)

def find(d, ver):
    for c in d["cuts"]:
        if c["version"] == ver:
            return c
    return None

def cmd_add(a):
    d = load()
    c = find(d, a.version)
    if c is None:
        c = {"version": a.version, "cuts_index": len(d["cuts"]) + 1}
        d["cuts"].append(c)
    c.update(label=a.label, fe=bool(a.fe), band=a.band or c.get("band", "?"),
             notes=a.notes or c.get("notes", ""),
             guard_sha=a.guard_sha or c.get("guard_sha", ""),
             status=c.get("status", "built"),
             at=datetime.datetime.now().isoformat(timespec="seconds"))
    save(d)
    print(f"logged cut {a.version} :: {a.label}"
          + (f"  [FE]" if a.fe else "") + (f"  [guard-sha {a.guard_sha[:8]}]" if a.guard_sha else ""))

def cmd_deploy(a):
    d = load(); c = find(d, a.version)
    if not c:
        print(f"no ledger entry for {a.version} -- add it first"); return 1
    c["status"] = "green" if a.green else "deployed"
    c["deployed_at"] = datetime.datetime.now().isoformat(timespec="seconds")
    save(d)
    print(f"cut {a.version} -> {c['status']}")

def _rows(d):
    return sorted(d["cuts"], key=lambda c: c.get("cuts_index", 0))

def cmd_show(a):
    d = load(); rows = _rows(d)
    if not rows:
        print("empty ledger (no cuts logged this session)"); return 0
    print(f"session started {d.get('started','?')}   |   {len(rows)} cut(s)\n")
    print(f"  {'#':>2}  {'version':<12} {'status':<9} {'fe':<3} {'band':<5} label")
    for c in rows:
        print(f"  {c.get('cuts_index','?'):>2}  {c['version']:<12} {c.get('status','?'):<9} "
              f"{'yes' if c.get('fe') else '-':<3} {c.get('band','?'):<5} {c.get('label','')}")
    # guard lineage
    gl = [(c['version'], c['guard_sha'][:8]) for c in rows if c.get("guard_sha")]
    if gl:
        print("\n  guard-SHA lineage: " + "  ->  ".join(f"{v}:{s}" for v, s in gl))
    print(f"\n  version lineage: " + " -> ".join(c['version'] for c in rows))

def cmd_arc(a):
    d = load(); rows = _rows(d)
    if not rows:
        print("(no cuts to draft)"); return 0
    print("## Session arc (this chat)  [factual draft from bd-session -- add the lesson per cut]\n")
    for c in rows:
        g = f" NEW GUARD SHA {c['guard_sha'][:8]}." if c.get("guard_sha") else ""
        fe = " (FE rebuild)" if c.get("fe") else ""
        st = {"green": "on-stash GREEN", "deployed": "deployed", "built": "built (awaiting stash)"}.get(c.get("status",""), c.get("status",""))
        print(f"- **{c['version']} -- {c.get('label','')}**{fe}.{g} {st}. _Lesson: <add>._")

def cmd_check(a):
    d = load(); rows = _rows(d)
    pending = [c for c in rows if c.get("status") != "green"]
    if not rows:
        print("[bd-session] empty ledger."); return 0
    if pending:
        print("[bd-session] WARN -- cuts without a green-on-stash record (handoff may precede confirmation, which is OK):")
        for c in pending:
            print(f"    {c['version']} ({c.get('status','?')}) :: {c.get('label','')}")
    else:
        print(f"[bd-session] all {len(rows)} cut(s) green on stash.")
    return 0  # never fails

def cmd_sync_state(a):
    d = load(); rows = _rows(d)
    sp = a.state
    if not os.path.exists(sp):
        print(f"no STATE at {sp}"); return 1
    s = json.load(open(sp))
    s["deploy_queue"] = [{"version": c["version"], "label": c.get("label",""), "status": c.get("status","built")}
                         for c in rows if c.get("status") != "green"]
    json.dump(s, open(sp, "w"), indent=2, ensure_ascii=False)
    print(f"wrote {len(s['deploy_queue'])} pending cut(s) into STATE.deploy_queue")

def cmd_reset(a):
    if os.path.exists(LEDGER):
        os.remove(LEDGER)
    print("ledger reset")

def selftest():
    """SKIP: this tool needs a live session pack, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs a live session pack")
    print("SELFTEST PASS")
    return 0


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser(description="Multi-cut session ledger.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("add"); p.add_argument("--version", required=True); p.add_argument("--label", required=True)
    p.add_argument("--guard-sha", default=""); p.add_argument("--fe", action="store_true")
    p.add_argument("--band", default=""); p.add_argument("--notes", default=""); p.set_defaults(fn=cmd_add)
    p = sub.add_parser("deploy"); p.add_argument("--version", required=True); p.add_argument("--green", action="store_true"); p.set_defaults(fn=cmd_deploy)
    sub.add_parser("show").set_defaults(fn=cmd_show)
    sub.add_parser("arc").set_defaults(fn=cmd_arc)
    sub.add_parser("check").set_defaults(fn=cmd_check)
    p = sub.add_parser("sync-state"); p.add_argument("--state", default="/home/claude/nextsess/STATE.json"); p.set_defaults(fn=cmd_sync_state)
    sub.add_parser("reset").set_defaults(fn=cmd_reset)
    a = ap.parse_args()
    return a.fn(a) or 0

if __name__ == "__main__":
    sys.exit(main())
