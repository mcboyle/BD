#!/usr/bin/env python3
"""Reconcile independent register decisions and candidate blobs with the backlog."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
from typing import Any


_ROW = re.compile(r"^\|\s*(?P<row>[1-9]\d*)\s*\|\s*(?P<status>[A-Z]+)(?P<evidence>[^|]*)\|", re.MULTILINE)
_DECISION_ID = re.compile(r"[a-z0-9][a-z0-9-]*\Z")
_EXCLUDED_PATHS = frozenset(
    {
        "bulk_downloader/__init__.py",
        "CHANGELOG.md",
        "tests/test_settings_center_slice4.py",
        "DEPENDENCY_GRAPH.json",
        "DEPENDENCY_GRAPH.md",
        "FUNCTION_INDEX.md",
        "INV_TAGS.md",
        "PIN_INDEX.json",
        "ROUTE_INDEX.json",
        "tests/source_window_hashes.json",
        "tools/decomp/import_graph_baseline.json",
    }
)


class ReconciliationError(ValueError):
    """An explicit FAIL or UNKNOWN reconciliation result."""


def _load_json(path: Path, label: str) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="ascii"))
    except FileNotFoundError as exc:
        raise ReconciliationError(f"UNKNOWN: {label} is absent") from exc
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ReconciliationError(f"UNKNOWN: {label} is unreadable") from exc
    if not isinstance(payload, dict):
        raise ReconciliationError(f"UNKNOWN: {label} is not an object")
    return payload


def _rows(path: Path) -> dict[int, tuple[str, str]]:
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeDecodeError) as exc:
        raise ReconciliationError("UNKNOWN: canonical register is unreadable") from exc
    rows: dict[int, tuple[str, str]] = {}
    for match in _ROW.finditer(text):
        row = int(match.group("row"))
        if row in rows:
            raise ReconciliationError(f"UNKNOWN: canonical register duplicates row {row}")
        rows[row] = (match.group("status"), match.group("evidence").strip())
    if not rows:
        raise ReconciliationError("UNKNOWN: canonical register denominator is zero")
    return rows


def _git(repo: Path, *args: str) -> str:
    result = subprocess.run(["git", "-C", str(repo), *args], text=True, capture_output=True)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "git command failed"
        raise ReconciliationError(f"UNKNOWN: git {' '.join(args)}: {detail}")
    return result.stdout


def _candidate_paths(repo: Path, candidate: str) -> list[str]:
    _git(repo, "rev-parse", "--verify", f"{candidate}^{{commit}}")
    changed = [path for path in _git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", candidate).splitlines() if path]
    substantive = sorted(set(changed) - _EXCLUDED_PATHS)
    if not substantive:
        raise ReconciliationError(f"UNKNOWN: candidate {candidate} has zero substantive paths after stated exclusions")
    return substantive


def _blob(repo: Path, ref: str, path: str) -> str:
    return _git(repo, "rev-parse", "--verify", f"{ref}:{path}").strip()


def reconcile(repo: Path, base: str) -> tuple[int, int]:
    rows = _rows(repo / "project-knowledge" / "IMPROVEMENT_BACKLOG.md")
    intake = _load_json(repo / "project-knowledge" / "REGISTER_INTAKE.json", "decision intake")
    if set(intake) != {"schema", "decisions"} or intake["schema"] != 1 or not isinstance(intake["decisions"], list):
        raise ReconciliationError("UNKNOWN: decision intake schema is invalid")
    decisions = intake["decisions"]
    if not decisions:
        raise ReconciliationError("UNKNOWN: decision intake denominator is zero")
    decision_ids: set[str] = set()
    for entry in decisions:
        if not isinstance(entry, dict) or not isinstance(entry.get("id"), str) or _DECISION_ID.fullmatch(entry["id"]) is None:
            raise ReconciliationError("UNKNOWN: decision intake has an invalid id")
        identity = entry["id"]
        if identity in decision_ids:
            raise ReconciliationError(f"UNKNOWN: decision intake duplicates id {identity}")
        decision_ids.add(identity)
        disposition = entry.get("disposition")
        if disposition == "defer" and set(entry) == {"id", "disposition", "row"} and isinstance(entry["row"], int) and entry["row"] > 0:
            if entry["row"] not in rows:
                raise ReconciliationError(f"FAIL: decision {identity} has no canonical register row {entry['row']}")
        elif disposition == "non-deferral" and set(entry) == {"id", "disposition", "evidence"} and isinstance(entry.get("evidence"), str) and entry["evidence"].strip():
            continue
        else:
            raise ReconciliationError(f"UNKNOWN: decision {identity} has an invalid disposition record")

    shipment_file = repo / "project-knowledge" / "REGISTER_SHIPMENTS.json"
    shipments_doc = _load_json(shipment_file, "shipment denominator")
    if set(shipments_doc) != {"schema", "shipments"} or shipments_doc["schema"] != 1 or not isinstance(shipments_doc["shipments"], list):
        raise ReconciliationError("UNKNOWN: shipment denominator schema is invalid")
    shipments = shipments_doc["shipments"]
    if not shipments:
        raise ReconciliationError("UNKNOWN: shipment denominator is zero")
    shipment_rows: set[int] = set()
    for entry in shipments:
        if not isinstance(entry, dict) or set(entry) != {"row", "candidate", "substantive_paths"}:
            raise ReconciliationError("UNKNOWN: shipment entry schema is invalid")
        row, candidate, expected = entry["row"], entry["candidate"], entry["substantive_paths"]
        if not isinstance(row, int) or row <= 0 or row in shipment_rows or not isinstance(candidate, str) or not isinstance(expected, list) or not all(isinstance(path, str) for path in expected):
            raise ReconciliationError("UNKNOWN: shipment entry fields are invalid")
        shipment_rows.add(row)
        if row not in rows:
            raise ReconciliationError(f"UNKNOWN: shipment entry names absent row {row}")
        actual = _candidate_paths(repo, candidate)
        if actual != sorted(expected) or len(expected) != len(set(expected)):
            raise ReconciliationError(f"UNKNOWN: candidate {candidate} substantive denominator disagrees with its manifest")
        equal = [_blob(repo, candidate, path) == _blob(repo, base, path) for path in actual]
        if all(equal) and rows[row][0] == "OPEN":
            raise ReconciliationError(f"FAIL: OPEN row {row} is fully landed from candidate {candidate}")
    return len(decisions), len(shipments)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True, type=Path)
    parser.add_argument("--base", default="HEAD")
    args = parser.parse_args()
    try:
        decisions, shipments = reconcile(args.repo.resolve(), args.base)
    except ReconciliationError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    print(f"PASS: reconciled {decisions} decision(s) and {shipments} candidate shipment(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
