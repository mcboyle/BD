#!/usr/bin/env python3
"""bd-corpus -- pull recognizer corpus from SANCTIONED public test/demo sites,
distill + REDACT it, and pin the verdict, reusing the REAL recognizer pipeline
(tools/build_recognizer_corpus.py: distill -> write_fixture -> build_from_fixture
-> verdict_pin) rather than a parallel reimplementation.

WHY: static/synthetic fixtures can't catch that a real player only instantiates
its seam after JS (or after a click). Live corpus from official player demos gives
real player-family DOM for all recognizer families; auth practice sites exercise
the login/session path; challenge TEST pages exercise detection.

ETHICS (hard lines, enforced here -- NOT the production automation policy):
  * ALLOWLIST ONLY. Live pulls run only against the built-in sanctioned hosts
    (public, non-adult, purpose-built-for-testing). A URL off the allowlist is
    refused. The adult registry sites are never in the allowlist.
  * CHALLENGE = DETECTION ONLY. On a challenge page we RECORD "detected -> would
    route to needs-review/handoff" and STOP. We never click, submit, solve, or
    use a solving service. `--challenge-detect` asserts detection happened and
    FAILS if a challenge was ever cleared.
  * REDACTED. Every fixture is run through the real redactor's residual scan
    (scan_artifact_secrets); a fixture with ANY residual token/cookie/signed-URL/
    credential is REJECTED (not written). Pins are name/shape/count/tag only.
  * READ-ONLY. Render + read DOM + light network log. Never downloads media,
    never submits a form (auth pages: we detect the form, we don't log in here).

Runs under `bd` (needs the staged chromium + the bulk_downloader import). Uses the
PRESTAGED playwright (matches the staged chromium build); the venv's newer
playwright wants its own browser install (see SANDBOX_LAYOUT_MAP 0.5).

Usage:
  bd-corpus --list                       show the allowlist (grouped)
  bd-corpus --group players              pull+distill+pin every player-demo URL
  bd-corpus --group auth                 render auth practice pages (detect login form)
  bd-corpus --group challenge            challenge TEST pages: detect-only
  bd-corpus --url <allowlisted-url>      one URL (must be on the allowlist)
  bd-corpus --url <u> --click "<sel>"    click a selector first (reach a lazy seam)
  bd-corpus --all                        players + auth + challenge
  bd-corpus --out <dir>                  fixture output dir (default kb/recognizer_corpus_live)
  bd-corpus --regen-pins                 rebuild expected_verdicts.json from fixtures (delegates)
Exit 0 on success; 1 on a redaction rejection, an off-allowlist URL, or a
challenge that was cleared (policy failure); 2 = CANNOT-EVALUATE (--selftest
cannot find the recognizer corpus it would pin against).
"""
import argparse
import json
import os
import re
import sys
import time
from pathlib import Path
from urllib.parse import urlparse

# v3.66.855 desandbox. AFTER the whole import block on purpose (sys must already
# be bound before it is used here).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

# The recognizer corpus lives in the checkout now (47 *.cap.json fixtures plus
# expected_verdicts.json), written by tools/build_recognizer_corpus.py, whose own
# --out default is this same path. The retired sandbox kept it under
# /home/claude/verification/corpus, which does not exist on a git checkout.
CORPUS_DIR = os.path.join(sec.DEFAULT_WORK, "tests", "corpus", "recognizer")

G, R, Y, B, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[34m", "\033[2m", "\033[0m"

# --- allowlist: public, non-adult, purpose-built-for-testing --------------
# host -> group. A URL is allowed iff its host (or a parent) is here.
ALLOWLIST = {
    # player demo/example sites (recognizer corpus, all families)
    "videojs.org": "players", "videojs-test.github.io": "players",
    "hlsjs.video-dev.org": "players", "reference.dashif.org": "players",
    "bitmovin.com": "players", "shaka-player-demo.appspot.com": "players",
    "nightly-dot-shaka-player-demo.appspot.com": "players",
    "docs.flowplayer.com": "players", "vidstack.io": "players",
    "developers.cloudflare.com": "challenge",  # also hosts the Turnstile test page
    "www.mediaelementjs.com": "players", "www.radiantmediaplayer.com": "players",
    "artplayer.org": "players", "dplayer.diygod.dev": "players",
    "unpkg.com": "players", "playerjs.com": "players",
    "www.media-chrome.org": "players", "www.theoplayer.com": "players",
    "tools.axinom.com": "players",
    # auth/login PRACTICE sites (published creds; sanctioned automation targets)
    "the-internet.herokuapp.com": "auth",
    "practicetestautomation.com": "auth", "practice.expandtesting.com": "auth",
    "opensource-demo.orangehrmlive.com": "auth",
    "parabank.parasoft.com": "auth", "automationexercise.com": "auth",
    "www.oauth.com": "auth", "openidconnect.net": "auth",
    "developers.login.gov": "auth",
    # challenge TEST pages -- OFFICIAL vendor test keys ONLY (detection only)
    "recaptcha-demo.appspot.com": "challenge",
    "accounts.hcaptcha.com": "challenge", "altcha.org": "challenge",
    # NOTE: 2captcha & any captcha-SOLVING service are deliberately EXCLUDED.
}

# a few good default URLs per group (the embed/sample pages, not homepages)
GROUP_URLS = {
    "players": [
        "https://reference.dashif.org/dash.js/latest/samples/dash-if-reference-player/index.html",
        "https://hlsjs.video-dev.org/demo/",
        "https://shaka-player-demo.appspot.com/demo/",
        "https://docs.flowplayer.com/demos/hls-plugin",
        "https://vidstack.io/player/demo/",
        "https://dplayer.diygod.dev/",
        "https://www.mediaelementjs.com/examples.html",
        "https://tools.axinom.com/players/theoplayer",
    ],
    "auth": [
        "https://the-internet.herokuapp.com/login",
        "https://practicetestautomation.com/practice-test-login/",
        "https://practice.expandtesting.com/login",
    ],
    "challenge": [
        "https://developers.cloudflare.com/turnstile/troubleshooting/testing/",
        "https://recaptcha-demo.appspot.com/",
        "https://accounts.hcaptcha.com/demo",
        "https://altcha.org/",
    ],
}


# Multi-step recipes: player demos whose recognizer seam (primary_protocol /
# manifest) only appears after a SEQUENCE of interactions, not a single click.
# Each recipe = (url, [selectors clicked in order]). Best-effort per step
# (a missing/renamed control is skipped, not fatal). Content-agnostic.
STEP_RECIPES = {
    # dash.js reference client (redesigned 2026): #stream-url is PRE-FILLED with a
    # BBB MPD, so a single #btn-load ("Load") fetches the manifest. Old selectors
    # (#loadButton / button.btn-primary / #play-pause-btn) are stale (count=0/hidden).
    "dashjs-drm": (
        "https://reference.dashif.org/dash.js/latest/samples/dash-if-reference-player/index.html",
        ["#btn-load"],
    ),
    # Shaka demo moved to Polymer shadow DOM -- asset-card/play selectors are
    # unreachable via querySelector. The robust seam is the demo's HASH-DEEPLINK:
    # #asset=<mpd>;play=true preloads + autoplays, so NO clicks are needed (the
    # manifest fetches on load). Steps intentionally empty; the URL carries it.
    "shaka": (
        "https://shaka-player-demo.appspot.com/demo/"
        "#audiolang=en-US;textlang=en-US;uilang=en-US;"
        "asset=https://storage.googleapis.com/shaka-demo-assets/angel-one/dash.mpd;play=true",
        [],
    ),
    # THEOplayer demos are DOMAIN-LOCKED (the license binds to the hosting domain,
    # so third-party sanctioned demos won't fetch a manifest headlessly -- the
    # axinom demo also gates on SSO/DRM-capability). The theoplayer FAMILY is
    # already pinned via tests/corpus/recognizer/theo.cap.json; a live re-pull is
    # not reliably obtainable. Replaced with bitmovin: a DISTINCT player family
    # (not dashjs/shaka/hlsjs) whose public stream-test demo AUTO-LOADS its
    # manifest on page load (no clicks), giving a clean headless capture.
    "bitmovin": (
        "https://bitmovin.com/demos/stream-test",
        [],
    ),
}

CHALLENGE_MARKERS = (
    "cf-turnstile", "challenges.cloudflare.com", "turnstile",
    "g-recaptcha", "grecaptcha", "recaptcha/api",
    "h-captcha", "hcaptcha.com", "altcha", "geetest",
)
LOGIN_MARKERS = ("type=\"password\"", "type='password'", "name=\"password\"",
                 "login", "sign in", "username", "oauth", "openid")


def _host_allowed(url: str):
    host = (urlparse(url).hostname or "").lower()
    if host in ALLOWLIST:
        return ALLOWLIST[host]
    # allow a parent-domain match (e.g. foo.bitmovin.com)
    for h, grp in ALLOWLIST.items():
        if host.endswith("." + h):
            return grp
    return None


def _render(url, click=None, steps=None, timeout_ms=45000, settle_ms=3500):
    """Headless render via the prestaged playwright; return (dom, netlog, title).
    After a --click we wait longer AND poll for a manifest (.mpd/.m3u8) response,
    since the player fetches its manifest a few seconds after the load control is
    pressed (a fixed short settle fires before primary_protocol can be seen).

    ``steps`` (list of CSS selectors) drives a MULTI-STEP interaction for players
    whose seam only appears after a sequence (e.g. dash.js DRM: pick asset -> load;
    dash.js: single #btn-load; shaka: hash-deeplink (no steps); bitmovin:
    autoloads (no steps)). Each selector is
    clicked in order with a short settle between; the manifest poll runs after the
    final step. Best-effort per step (a missing control is skipped, not fatal)."""
    from playwright.sync_api import sync_playwright
    netlog = []
    saw_manifest = {"v": False}

    def _is_mani(u, ct):
        u = (u or "").split("?")[0].lower()
        return u.endswith(".mpd") or u.endswith(".m3u8") \
            or "mpegurl" in ct or "dash+xml" in ct

    with sync_playwright() as p:
        b = p.chromium.launch(headless=True)
        pg = b.new_page()

        def _on_resp(resp):
            try:
                hdrs = resp.headers or {}
                netlog.append({
                    "url": resp.url,
                    "response_status": resp.status,
                    "response_headers": [{"name": k, "value": v}
                                         for k, v in hdrs.items()],
                })
                if _is_mani(resp.url, str(hdrs.get("content-type", "")).lower()):
                    saw_manifest["v"] = True
            except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
                pass
        pg.on("response", _on_resp)
        try:
            pg.goto(url, timeout=timeout_ms, wait_until="domcontentloaded")
            seq = list(steps) if steps else ([click] if click else [])
            # A deeplink URL (hash/query carrying a manifest, e.g. shaka
            # #asset=...;play=true) triggers an async manifest fetch with NO clicks.
            # Poll for the manifest whenever we either clicked a sequence OR the URL
            # itself looks like a manifest deeplink -- not just when steps exist.
            _u = (url or "").lower()
            deeplink = ("asset=" in _u or ".mpd" in _u or ".m3u8" in _u
                        or "manifest" in _u or "url=" in _u)
            if seq:
                pg.wait_for_timeout(1500)
                for sel in seq:
                    if not sel:
                        continue
                    try:
                        pg.click(sel, timeout=6000)
                    except Exception:  # why: the native click failed actionability checks;
                                       # the JS click below IS the fallback (and it re-raises
                                       # nothing, so a genuinely dead control still yields no hit)
                        # try a JS click (bypasses actionability for odd controls)
                        try:
                            pg.evaluate("(s)=>{var e=document.querySelector(s); if(e)e.click();}", sel)
                        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
                            pass
                    pg.wait_for_timeout(1200)  # settle between steps
            if seq or deeplink:
                # poll up to ~12s for the manifest fetch the sequence/deeplink triggers
                deadline = time.time() + 12
                while time.time() < deadline and not saw_manifest["v"]:
                    pg.wait_for_timeout(500)
                pg.wait_for_timeout(1500)  # let the player finish parsing it
            else:
                pg.wait_for_timeout(settle_ms)
            dom = pg.content() or ""
            title = pg.title() or ""
        finally:
            b.close()
    return dom, netlog, title


def _capture_dict(url, dom, netlog):
    """Shape a live render like a capture.json the corpus distiller consumes:
    a single full_snapshot html entry + a light network log (headers only)."""
    return {
        "url": url,
        "origin": "{uri.scheme}://{uri.netloc}".format(uri=urlparse(url)),
        "host": urlparse(url).hostname,
        "captured_at": int(time.time()),
        "dom_log": [{"type": "full_snapshot", "html": dom}],
        "network_log": netlog,
        "cookies": [],  # never persist cookies into corpus
    }


def _load_corpus_tool():
    """Import tools/build_recognizer_corpus.py (the real distill/build/pin)."""
    import importlib.util
    repo = Path(__file__).resolve()
    # find the work tree root (has bulk_downloader/ + tools/)
    for base in (Path(sec.DEFAULT_WORK), Path.cwd()):
        t = base / "tools" / "build_recognizer_corpus.py"
        if t.is_file():
            spec = importlib.util.spec_from_file_location("bd_corpus_tool", t)
            m = importlib.util.module_from_spec(spec)
            sys.path.insert(0, str(base))
            spec.loader.exec_module(m)
            return m, base
    raise SystemExit(f"{R}cannot find tools/build_recognizer_corpus.py{RST}")


def _scan_secrets(obj):
    from bulk_downloader.capture_artifact_redact import scan_artifact_secrets
    return scan_artifact_secrets(obj)


def _redact(obj):
    """Run the production redactor over the distilled capture BEFORE the residual
    scan, exactly as the real capture path does (redact -> scan)."""
    from bulk_downloader.capture_artifact_redact import redact_artifact
    return redact_artifact(obj)


def do_url(url, tool, base, out_dir, click=None, steps=None, challenge_detect=False):
    grp = _host_allowed(url)
    if grp is None:
        print(f"  {R}REFUSED (off-allowlist){RST} {url}")
        return "refused"
    dom, netlog, title = _render(url, click=click, steps=steps)
    low = dom.lower()

    # challenge pages: DETECTION ONLY -- never interact/solve
    if grp == "challenge" or challenge_detect:
        hits = sorted({m for m in CHALLENGE_MARKERS if m in low})
        if hits:
            print(f"  {G}CHALLENGE DETECTED{RST} {url}")
            print(f"       markers={hits}  title={title[:40]!r}")
            print(f"       -> would route to needs-review/handoff; {B}no solve attempted{RST}")
            return "challenge_detected"
        else:
            print(f"  {Y}no challenge markers{RST} {url}  title={title[:40]!r}")
            return "challenge_absent"

    # auth pages: detect the login form (we do NOT submit here)
    if grp == "auth":
        is_login = any(m in low for m in LOGIN_MARKERS)
        print(f"  {G if is_login else Y}{'LOGIN-FORM DETECTED' if is_login else 'no login markers'}{RST}"
              f" {url}  title={title[:40]!r}")
        return "login_detected" if is_login else "login_absent"

    # players: distill -> REDACT (real redactor) -> residual-scan gate -> fixture
    #          -> real recognizer -> pin
    cap = _capture_dict(url, dom, netlog)
    distilled = tool.distill(cap)
    # Run the SAME redactor the production capture path uses, THEN assert the
    # residual scan is clean. (Scanning the raw render over-rejects: real demo
    # pages carry analytics tokens / CDN-signed media that the redactor strips.)
    distilled = _redact(distilled)
    residual = _scan_secrets(distilled)
    if residual:
        print(f"  {R}REJECTED (residual after redaction: {residual[:3]}){RST} {url}")
        return "rejected"
    slug = re.sub(r"[^a-z0-9]+", "-", (urlparse(url).hostname or "site").lower()).strip("-")
    out_dir.mkdir(parents=True, exist_ok=True)
    dest = out_dir / f"{slug}.cap.json"
    tool.write_fixture(distilled, dest)
    try:
        draft = tool.build_from_fixture(dest)
        pin = tool.verdict_pin(draft)
        fam = pin.get("player_family") or "-"
        proto = pin.get("primary_protocol") or "-"
        print(f"  {G}CORPUS{RST} {url}\n       family={fam} protocol={proto} "
              f"downloadable={pin.get('downloadable')} -> {dest.name}")
        return "corpus"
    except Exception as e:
        print(f"  {Y}rendered+redacted but recognizer issue{RST} {url}: {str(e)[:80]}")
        return "partial"


def selftest():
    """Assert the recognizer corpus this tool regenerates pins against is real.

    IT SAID "SKIP ... SELFTEST PASS" AND EXITED 0. The old body pointed at
    /home/claude/verification/corpus -- a directory that does not exist on a git
    checkout -- so the not-a-dir branch fired on EVERY run and printed a pass. A
    skip is never a pass, and that comment was in the docstring while the code
    below it did the opposite (CLAUDE.md s0). Two further denominator bugs came
    with it: it counted `*.py`, and the corpus is `*.cap.json` fixtures, so even
    against the right directory it would have reported 0 and FAILED.

    Absent/empty corpus is now CANNOT-EVALUATE (2), never 0 and never a blanket 1.
    """
    import os as _o
    if not _o.path.isdir(CORPUS_DIR):
        sys.stderr.write("CANNOT-EVALUATE: recognizer corpus absent (%s) reason=%s\n"
                         % (CORPUS_DIR, sec.REASON_ABSENT))
        print("SELFTEST CANNOT-EVALUATE")
        return sec.EXIT_CANNOT_EVALUATE
    fixtures = [f for f in _o.listdir(CORPUS_DIR) if f.endswith(".cap.json")]
    if not fixtures:
        sys.stderr.write("CANNOT-EVALUATE: recognizer corpus holds 0 *.cap.json "
                         "fixtures (%s) reason=%s\n" % (CORPUS_DIR, sec.REASON_EMPTY))
        print("SELFTEST CANNOT-EVALUATE")
        return sec.EXIT_CANNOT_EVALUATE
    pins = _o.path.isfile(_o.path.join(CORPUS_DIR, "expected_verdicts.json"))
    print("PASS  corpus present with %d fixture file(s)" % len(fixtures))
    print(("PASS" if pins else "FAIL") + "  expected_verdicts.json present (the pins "
          "--regen-pins rewrites)")
    print("SELFTEST PASS" if pins else "SELFTEST FAIL")
    return 0 if pins else 1


def main():
    ap = argparse.ArgumentParser(description="Pull recognizer corpus from sanctioned test/demo sites.")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--group", choices=("players", "auth", "challenge"))
    ap.add_argument("--url")
    ap.add_argument("--click", help="CSS selector to click before capturing (lazy seams)")
    ap.add_argument("--steps", help="comma-separated CSS selectors clicked IN ORDER "
                                    "(multi-step players: DRM/shaka/theoplayer)")
    ap.add_argument("--step-recipe", choices=tuple(STEP_RECIPES),
                    help="a named multi-step recipe (see --list-recipes)")
    ap.add_argument("--list-recipes", action="store_true")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--challenge-detect", action="store_true",
                    help="treat --url as a challenge page: detect-only, fail if cleared")
    ap.add_argument("--out", default="kb/recognizer_corpus_live")
    ap.add_argument("--regen-pins", action="store_true")
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()

    if a.list:
        print("bd-corpus allowlist (public, non-adult, purpose-built):")
        for grp in ("players", "auth", "challenge"):
            hosts = sorted(h for h, g in ALLOWLIST.items() if g == grp)
            print(f"\n  [{grp}] {len(hosts)} hosts:")
            for h in hosts:
                print(f"    {h}")
        print(f"\n  {DIM}EXCLUDED: 2captcha / any captcha-solving service; adult registry sites.{RST}")
        return 0

    tool, base = _load_corpus_tool()
    out_dir = (base / a.out) if not os.path.isabs(a.out) else Path(a.out)

    if a.list_recipes:
        print("bd-corpus multi-step recipes (player seams needing a sequence):")
        for name, (url, sels) in STEP_RECIPES.items():
            print(f"\n  [{name}]\n    url:   {url}\n    steps: {sels}")
        return 0

    if a.regen_pins:
        # delegate to the real tool's --regen against the live corpus dir
        import subprocess
        r = subprocess.run([sys.executable, str(base / "tools" / "build_recognizer_corpus.py"),
                            "--regen", "--out", str(out_dir)])
        return r.returncode

    urls = []
    steps = None
    if a.step_recipe:
        rec_url, steps = STEP_RECIPES[a.step_recipe]
        urls = [rec_url]
    elif a.url:
        urls = [a.url]
        if a.steps:
            steps = [s.strip() for s in a.steps.split(",") if s.strip()]
    elif a.group:
        urls = GROUP_URLS[a.group]
    elif a.all:
        urls = GROUP_URLS["players"] + GROUP_URLS["auth"] + GROUP_URLS["challenge"]
    else:
        ap.print_help()
        return 0

    print(f"bd-corpus -- {len(urls)} URL(s)" + (f" [steps: {steps}]" if steps else ""))
    print("=" * 62)
    tally = {}
    cleared = False
    for u in urls:
        try:
            res = do_url(u, tool, base, out_dir, click=a.click, steps=steps,
                         challenge_detect=a.challenge_detect)
        except Exception as e:
            print(f"  {R}ERROR{RST} {u}: {type(e).__name__} {str(e)[:100]}")
            res = "error"
        tally[res] = tally.get(res, 0) + 1
    print("=" * 62)
    print("  " + "  ".join(f"{k}={v}" for k, v in sorted(tally.items())))
    # policy failure: a challenge that was somehow cleared (should be impossible
    # here since we never interact) -- belt-and-suspenders
    if cleared:
        print(f"  {R}POLICY FAILURE: a challenge was cleared{RST}")
        return 1
    if tally.get("refused") or tally.get("rejected"):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
