#!/usr/bin/env python3
"""bd-policy-compiler -- compile markdown policy rules into executable checks.

Parses the KB policy docs (AUTOMATION_POLICY.md, TESTING_ETHICS_FRAME.md, etc)
for rule bullets carrying an enforceable directive (a "no X" / "never Y" /
"must Z" pattern with a concrete token) and compiles each into a declarative
CHECK descriptor {rule_id, kind, pattern, severity, source_line} that a static
or route gate can consume. It does NOT invent enforcement -- it surfaces which
policy statements are mechanically checkable vs advisory, so the gap between
written policy and enforced policy is visible. Read-only.

Usage: bd-policy-compiler [--docs DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

STRONG=re.compile(r'(?i)\b(never|must not|must|shall|always|fail[- ]closed)\b')
WEAK=re.compile(r'(?i)\b(no|not|do not|don\047t)\b')
TOKENISH=re.compile(r'`([^`]+)`|"([^"]+)"|\b([a-z_]{3,}\.[a-z_]{2,}|[A-Z_]{4,})\b')

def compile_docs(docs_dir):
    checks=[]
    for f in sorted(glob.glob(os.path.join(docs_dir,"*.md"))):
        name=os.path.basename(f)
        for i,line in enumerate(open(f,errors="ignore"),1):
            s=line.strip()
            if not s.startswith(("-","*")): continue
            toks=[t for grp in TOKENISH.findall(s) for t in grp if t]
            strong=bool(STRONG.search(s))
            weak=bool(WEAK.search(s))
            # a rule counts if it's a strong directive, or a weak prohibition
            # WITH a concrete token (weak alone = prose like "no X here")
            if not (strong or (weak and toks)): continue
            kind=("forbid" if (WEAK.search(s) or re.search(r'(?i)never|must not',s)) else "require")
            checkable=bool(toks)
            checks.append({"source":name,"line":i,"kind":kind,
                           "checkable":checkable,
                           "tokens":toks[:4],
                           "text":s[:120]})
    return checks

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        open(os.path.join(d,"P.md"),"w").write(
            "- No `2captcha` solving service, ever.\n"
            "- The scrubber must run on every artifact, fail-closed.\n"
            "- This is just prose, no directive here.\n")
        c=compile_docs(d)
    kinds={x["kind"] for x in c}
    print(("PASS" if len(c)==2 else "FAIL")+"  2 directives compiled, prose skipped (%d)"%len(c))
    ok=ok and len(c)==2
    forbid=any(x["kind"]=="forbid" and "2captcha" in x["tokens"] for x in c)
    print(("PASS" if forbid else "FAIL")+"  forbid rule tokenized (2captcha)")
    ok=ok and forbid
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--docs",default="/mnt/project")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    c=compile_docs(a.docs)
    checkable=sum(1 for x in c if x["checkable"])
    if sec.emit({"checks":c,"summary":{"total":len(c),"checkable":checkable,"advisory":len(c)-checkable}},as_json=a.json): return 0
    print("policy rules compiled: %d (%d mechanically checkable, %d advisory)"%(len(c),checkable,len(c)-checkable))
    for x in c[:30]:
        tag=(G+"check"+RST) if x["checkable"] else (Y+"advis"+RST)
        print("  %s [%s] %s:%d  %s%s%s"%(tag,x["kind"],x["source"],x["line"],DIM,x["text"][:70],RST))
    return 0
sys.exit(main())
