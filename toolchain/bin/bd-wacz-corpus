#!/usr/bin/env python3
"""bd-wacz-corpus -- read-only survey of a local WACZ corpus.

Read-only analyses over ONE denominator, each independently selectable so their
answers can be compared rather than taken on trust:

  --group    site grouping from the `t_<hash>_<name>.wacz` naming, so the inputs
             to a template merge are DERIVED rather than eyeballed
  --hosts    grouping by HOST, three tiers, every group labelled with the method
             that produced it (see mode_hosts)
  --templates which sites can make a GREEN template -- from one capture or from
             a combination -- and whether the answer is corroborated across that
             site's captures (see mode_templates)
  --pairs    raw <-> `.redacted` twins and the size ratio between them
  --health   does each archive open, pass CRC, and carry a WARC payload
  --scrub    screening pass for credential-shaped material still in the archive
  --dupes    byte-identical copies, and derivatives identical to their source
  --all      every mode

WHY THE DENOMINATOR IS REPORTED EVERYWHERE. CLAUDE.md section 0 opens with a
gate that cannot see its subject reporting OK -- truthfully, and uselessly --
and this repo owns the scar: bd-wacz-scrub, bd-scrub-proof and bd-share-safe
each carried a TEXT_EXT allowlist containing no `.warc`, which is where a WACZ's
payload lives, and all three printed "verified clean" over what turned out to be
228 contaminated files. So: every mode states what it examined, an empty corpus
is UNKNOWN rather than "0 problems", and a member that could not be READ is
counted separately from a member that was read and found clean.

WHAT --scrub IS NOT. It is a SCREEN, not the canonical floor. The floor is
`bulk_downloader.capture_artifact_redact.scan_floor_secrets`, which operates on
a parsed capture rather than on raw archive bytes. This mode exists to shortlist
files worth putting through that, and its own output says so. Treating a clean
screen as a clean floor would be the same substitution error the allowlists made.

Exit: 0 ran-and-clean, 1 ran-with-findings, 2 UNKNOWN (cannot answer).
2 is not a softer 1 -- it means the question was not evaluated.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import sys
import zipfile
from urllib.parse import urlsplit

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)
import bdtools_sec as sec  # noqa: E402

EXIT_OK, EXIT_FINDINGS, EXIT_UNKNOWN = 0, 1, 2

_WACZ = ".wacz"

# MEASURED against the real 1251-file corpus, not assumed. The first version of
# this tool tested `name.endswith(".redacted.wacz")`, which classified 197 of
# the 601 redacted files -- 33% -- as RAW captures, because 216 files carry a
# Windows-style copy suffix and `x.redacted (2).wacz` does not end in
# `.redacted.wacz`. It also had no concept of `.scrubbed` (176 files) or
# `.redacted.scrubbed` (46), counting all of them as raw.
_DERIVATIVE_MARKERS = ("redacted", "scrubbed")
# `(2)` and `(dup1)`, with or without a leading space -- both forms are real.
_COPY_SUFFIX = re.compile(r"\s*\((?:dup)?\d+\)")

# @983: the marker set was DOT-prefixed, and the box's corpus also writes the
# UNDERSCORE form with a profile qualifier. Measured over the operator's 742
# real names: `.redacted` x329, `.scrubbed` x104, `_redacted_safe` x4,
# `_redacted_strict` x2, `.redacted_2` x1. Six read as RAW captures and the
# seventh based to the fragment `shaka_2`, which pairs with nothing.
#
# Three things this pattern is doing deliberately:
#   - a LEADING SEPARATOR is required, so a capture of a site whose name merely
#     begins with the word is not reclassified into an empty base;
#   - the qualifier tail `(_safe|_strict|_2|...)` is part of the marker, because
#     `bang247_redacted_safe` and `bang247_redacted_strict` are two redaction
#     PROFILES of one capture and must collapse to one family;
#   - the tail only eats `_`-joined runs AFTER the marker word, so
#     `cap_355b_redacted_safe` keeps `cap_355b`. A rule that ate from the first
#     underscore would merge every `cap_*` capture into one bucket -- the
#     over-sensitivity direction, and the one a careless fix breaks.
# `-1` / `-2` are NOT markers: `wowza` and `wowza-1` differ in size on the box,
# so they are distinct captures and collapsing them would delete one.
_MARKER_RE = re.compile(
    r"[._-](%s)(?:_[a-z0-9]+)*" % "|".join(_DERIVATIVE_MARKERS), re.I)

# `t_<hex>_<name>.wacz` is the export convention; the <name> is the only site
# signal a filename carries. Anything not matching keeps its whole stem, so an
# unrecognised naming scheme groups under itself rather than vanishing.
_NAMED = re.compile(r"^t_[0-9a-fA-F]{6,}_(.+)$")
_SITE = re.compile(r"^([A-Za-z]+)")

# STRUCTURAL, not entropy-based and not a bare word: a credential-ish key, a
# separator, then a value with some length to it. `SECRET_WORD_RE` alone fires
# on any prose containing "secret" -- over-sensitivity is a soundness bug
# (section 0), and a screen that cries wolf gets switched off.
_KV = re.compile(
    rb"(?i)\b(secret|token|api[_-]?key|apikey|password|passwd|authorization"
    rb"|bearer|session[_-]?id|access[_-]?token)\b\s*[=:]\s*[^\s\"'&;]{8,}")


def enumerate_corpus(root: pathlib.Path):
    """Every *.wacz under root. Returns (files, reason_if_unknown)."""
    if not root.exists():
        return [], "root does not exist: %s" % root
    if not root.is_dir():
        return [], "root is not a directory: %s" % root
    files = sorted(p for p in root.rglob("*" + _WACZ) if p.is_file())
    if not files:
        return [], "no *.wacz found under root: %s" % root
    return files, None


def _markers(p: pathlib.Path):
    """Which derivative markers this filename carries, in order of appearance."""
    stem = p.name[:-len(_WACZ)] if p.name.lower().endswith(_WACZ) else p.name
    stem = _COPY_SUFFIX.sub("", stem)
    return tuple(m.group(1).lower() for m in _MARKER_RE.finditer(stem))


def _is_redacted(p: pathlib.Path) -> bool:
    """Any derivative, not just a literal `.redacted.wacz` ending."""
    return bool(_markers(p))


def _base(p: pathlib.Path) -> str:
    """The SOURCE capture name: copy suffix and every derivative marker removed.

    So `x.wacz`, `x.redacted (2).wacz`, `x.scrubbed.wacz`,
    `x.redacted.scrubbed.wacz`, `x_redacted_safe.wacz` and `x.redacted_2.wacz`
    all resolve to `x` -- one family, which is what pairing and the no-op check
    both need.

    The marker's qualifier goes with the marker. Stripping `.redacted` from
    `shaka.redacted_2` and leaving `shaka_2` is worse than not stripping at all:
    a half-stripped base matches nothing and still looks like a real name.
    """
    n = p.name
    n = n[:-len(_WACZ)] if n.lower().endswith(_WACZ) else n
    n = _COPY_SUFFIX.sub("", n)
    return _MARKER_RE.sub("", n)


def _site_of(p: pathlib.Path) -> str:
    stem = _base(p)
    m = _NAMED.match(stem)
    if not m:
        # Unrecognised naming: group under the WHOLE stem. Running _SITE over it
        # would take the leading alpha run of a string never meant to be parsed
        # -- measured, every `t_<short>_<name>` fixture collapsed into a single
        # bucket called "t", which is a silent mis-grouping that looks like a
        # real answer. The docstring already promised this behaviour; the code
        # did not implement it.
        return stem.lower()
    m2 = _SITE.match(m.group(1))
    return (m2.group(1) if m2 else m.group(1)).lower()


def mode_group(files):
    raws = [p for p in files if not _is_redacted(p)]
    buckets = {}
    for p in raws:
        buckets.setdefault(_site_of(p), []).append(p.name)
    groups = [{"site": s, "captures": len(v), "merge_candidate": len(v) > 1,
               "files": sorted(v)}
              for s, v in sorted(buckets.items())]
    return {"examined": len(raws),
            "denominator": "raw (non-.redacted) *.wacz under root",
            "sites": len(groups),
            "merge_candidates": sum(1 for g in groups if g["merge_candidate"]),
            "groups": groups}


# ---------------------------------------------------------------- host grouping
#
# `--group` reads the `t_<hex>_<name>` EXPORT convention. The box's real corpus
# does not use it: there, `123.wacz` and `1232.wacz` carry no site signal at all
# and no filename heuristic will ever group them. Three tiers, filename-first
# with the archive as the authority, and every group states which one answered.

_PAGES_MEMBER = "pages/pages.jsonl"
# Bounded on purpose. The member is decompressed, so an unbounded read on an
# untrusted archive is a memory question, and the entry-point page record is the
# first line after the format header -- scanning a whole browsertrix crawl to
# find a netloc would be slow AND would risk picking an off-site resource.
_PAGES_READ_CAP = 1 << 20
_PAGES_LINE_CAP = 64

_PARSER_CACHE = None


def _load_filename_parser():
    """(callable, label) for tier 1, or (None, why-not).

    IMPORTED, not copied. `bulk_downloader.dom_analyzer._parse_capture_host` is
    the same function the capture picker and `scan_captures` use, and a second
    copy of a naming rule is how two answers to one question start to disagree
    (CLAUDE.md section 5 on `system_deps.sh`: three copies is a denominator that
    drifts, and the copy nobody updated is the one that runs).

    The cost of importing rather than copying is that a rename makes tier 1
    vanish, so the failure is REPORTED rather than absorbed: without it every
    BD-named capture falls through to an archive read, which a REDACTED capture
    cannot answer, and a whole corpus would read as `unknown` with nothing in
    the output saying why.
    """
    try:
        if sec.DEFAULT_WORK not in sys.path:
            sys.path.insert(0, sec.DEFAULT_WORK)
        from bulk_downloader.dom_analyzer import _parse_capture_host
    except Exception as exc:                       # pragma: no cover - env-only
        return None, "UNAVAILABLE: %s: %s" % (type(exc).__name__, exc)
    return (_parse_capture_host,
            "bulk_downloader.dom_analyzer._parse_capture_host")


def _filename_parser():
    global _PARSER_CACHE
    if _PARSER_CACHE is None:
        _PARSER_CACHE = _load_filename_parser()
    return _PARSER_CACHE


def _host_from_archive(p):
    """(host, reason_if_none) from the archive's own page record.

    `wacz_export._pages_jsonl` writes a format header followed by a page entry
    carrying the captured top-level URL. Measured on a BD-built archive: the
    redactor scrubs the query but leaves the netloc, so this answers for a
    `.redacted` capture too.

    `hostname`, NOT `netloc` as first sketched: netloc keeps `user:pass@` and
    `:port`, so one site behind a port would form a second group and the group
    LABEL -- which is printed -- would become a place a credential lives
    (section 7). `hostname` is also already lowercased, which is the shape tier
    1 returns, so the two tiers can land in the same bucket.
    """
    try:
        with zipfile.ZipFile(p) as z:
            if _PAGES_MEMBER not in set(z.namelist()):
                return None, "no_pages_jsonl"
            with z.open(_PAGES_MEMBER) as fh:
                blob = fh.read(_PAGES_READ_CAP)
    except Exception:
        return None, "unreadable"
    saw_url = False
    for line in blob.splitlines()[:_PAGES_LINE_CAP]:
        try:
            rec = json.loads(line)
        except Exception:
            continue                               # header, blank, or truncated
        if not isinstance(rec, dict):
            continue
        url = rec.get("url")
        if not isinstance(url, str) or not url:
            continue
        saw_url = True
        host = urlsplit(url).hostname
        if host:
            return host.lower(), None
    return None, ("no_host" if saw_url else "no_url")


def _place_by_host(files):
    """[(path, label, method, reason)], archives_attempted, parser_label.

    Factored out because `--templates` needs the SAME tiering `--hosts` reports.
    Two copies of the placement rule is how the two modes would start disagreeing
    about which captures belong to one site, and the merge half of `--templates`
    is only meaningful if its grouping is the grouping `--hosts` printed.
    """
    parser, parser_label = _filename_parser()
    placed = []
    attempted = 0
    for p in files:
        base = _base(p)
        host = None
        if parser is not None:
            try:
                host = parser(base)
            except Exception:
                host = None
        if host:
            placed.append((p, host.lower(), "filename", None))
            continue
        attempted += 1
        host, why = _host_from_archive(p)
        if host:
            placed.append((p, host, "archive", None))
        else:
            placed.append((p, base.lower(), "unknown", why))
    return placed, attempted, parser_label


def mode_hosts(files):
    """Group by host: filename first, the archive as the authority, never a guess.

      1. `{host}_{siteid}_{YYYYMMDD}` in the filename    -> method=filename
      2. `pages/pages.jsonl` inside the archive          -> method=archive
      3. the stem, grouped under ITSELF                  -> method=unknown

    Tier 1 runs against `_base()`, not the raw stem. MEASURED on this tree: the
    capture parser anchors on a date-ish TAIL, and a derivative marker or copy
    suffix sits exactly where that tail has to be, so
    `<name>.redacted (2)` returns None while `_base()` of it returns the host.
    Forgetting the strip sends all 601 redacted files through an archive read
    they do not need.

    An UNKNOWN bucket is keyed apart from the resolved hosts even when the label
    matches, so a stem that happens to look like a host can never be laundered
    into a measured group -- "never guessed" has to hold in the OUTPUT, not just
    in the derivation.

    Only `unreadable` -- an archive that was opened and could not be read --
    counts as a finding. An archive that opens and simply carries no URL is a
    property of this corpus, not a defect; firing on it would flag the hundreds
    of site-signal-free names the mode exists to describe, and a screen that
    cries wolf gets switched off (section 0's over-sensitivity failure).
    """
    placed, attempted, parser_label = _place_by_host(files)

    buckets = {}
    for p, label, method, reason in placed:
        buckets.setdefault((method == "unknown", label), []).append(
            (p, method, reason))

    groups = []
    for (is_unknown, label), members in sorted(buckets.items()):
        sources = {_base(m[0]) for m in members}
        entries = []
        for m_p, m_method, m_reason in sorted(members, key=lambda m: m[0].name):
            e = {"name": m_p.name, "method": m_method}
            if m_reason:
                e["reason"] = m_reason
            entries.append(e)
        groups.append({"host": label,
                       "captures": len(members),
                       # SOURCES, not files: a raw capture and its `.redacted`
                       # twin are one capture in two forms, and a merge needs
                       # two DIFFERENT captures to have anything to merge.
                       "sources": len(sources),
                       "merge_candidate": (not is_unknown) and len(sources) > 1,
                       "methods": sorted({m[1] for m in members}),
                       "files": entries})

    by_method = {"filename": 0, "archive": 0, "unknown": 0}
    reasons = {}
    for _p, _label, method, reason in placed:
        by_method[method] += 1
        if method == "unknown" and reason:
            reasons[reason] = reasons.get(reason, 0) + 1

    return {"examined": len(files),
            "denominator": ("all *.wacz under root; host resolved filename-"
                            "first, the archive's own page record as authority"),
            "filename_parser": parser_label,
            "hosts": sum(1 for g in groups if g["methods"] != ["unknown"]),
            "unresolved_groups": sum(1 for g in groups
                                     if g["methods"] == ["unknown"]),
            "merge_candidates": sum(1 for g in groups if g["merge_candidate"]),
            "by_method": by_method,
            # ATTEMPTS, not successes: an archive that failed to open is counted
            # here and again under `unreadable`.
            "archives_opened": attempted,
            "unreadable": reasons.get("unreadable", 0),
            "unknown_reasons": reasons,
            "groups": groups}


# --------------------------------------------------------- template viability
#
# "Can any of these captures, or a combination of one site's captures, make a
# green and reliable template?" -- the operator, 2026-08-09.
#
# GREEN IS NOT DEFINED HERE. `tools/promote_template.py` is the gate and
# `template_inventory.assess` mirrors it deliberately, "so the numbers can't
# diverge from reality". This mode RUNS that predicate. A fourth definition of
# green is how a tool starts disagreeing with the gate it exists to predict.
#
# RELIABLE IS SUPPORT ACROSS A SITE'S CAPTURES -- the operator's definition,
# taken verbatim. `bd-template-merge` already records it with denominators, so
# this reads that rather than inventing a score.

_BUILDER_CACHE = None
_MERGE_CACHE = None

# The gate's own clauses, so reliability is read off the selector the template
# lives or dies on. An average across ALL selectors would let a
# well-corroborated login mask a one-vote download trigger.
_GATE_KEYS = ("download.trigger", "download.row_selectors", "download.button")


def _load_template_builder():
    """(build_template, assess, label) or (None, None, why-not).

    Imported from `tools/`, not vendored: `assess` is the promote gate's mirror
    and a copy of it would be a second answer to "is this promotable".
    """
    try:
        for d in (sec.DEFAULT_WORK, os.path.join(sec.DEFAULT_WORK, "tools")):
            if d not in sys.path:
                sys.path.insert(0, d)
        from build_template_from_wacz import build_template
        from template_inventory import assess
        from bulk_downloader.template_normalize import normalize_draft
    except Exception as exc:                       # pragma: no cover - env-only
        return None, None, "UNAVAILABLE: %s: %s" % (type(exc).__name__, exc)
    return (build_template, normalize_draft), assess, (
        "build_template_from_wacz.build_template -> "
        "template_normalize.normalize_draft -> template_inventory.assess "
        "(promote-gate mirror)")


def _template_builder():
    global _BUILDER_CACHE
    if _BUILDER_CACHE is None:
        _BUILDER_CACHE = _load_template_builder()
    return _BUILDER_CACHE


def _merge_fn():
    """`bd-template-merge.merge_drafts`, loaded by path -- the file is
    extensionless, so there is no import statement that can reach it."""
    global _MERGE_CACHE
    if _MERGE_CACHE is None:
        try:
            import importlib.machinery
            import importlib.util
            ld = importlib.machinery.SourceFileLoader(
                "bd_template_merge", os.path.join(_HERE, "bd-template-merge"))
            mod = importlib.util.module_from_spec(
                importlib.util.spec_from_loader(ld.name, ld))
            ld.exec_module(mod)
            _MERGE_CACHE = (mod.merge_drafts, None)
        except Exception as exc:                   # pragma: no cover - env-only
            _MERGE_CACHE = (None, "%s: %s" % (type(exc).__name__, exc))
    return _MERGE_CACHE


def _gate_support(merged):
    """Support for the gate-critical selector, with its denominator attached."""
    sup = ((merged or {}).get("merge") or {}).get("selector_support") or {}
    best = None
    for k in _GATE_KEYS:
        for e in sup.get(k, []) or []:
            if best is None or (e.get("support") or 0) > (best[1].get("support") or 0):
                best = (k, e)
    if best is None:
        return None
    k, e = best
    return {"key": k, "value": e.get("value"), "support": e.get("support"),
            "of": e.get("of")}


def _reliability(n_drafts, gate_support):
    """Three states, and `unknown` is the one that matters.

    A site with fewer than TWO drafts has nothing to corroborate against: its
    support reads 1 of 1, arithmetically identical to a selector every capture
    agreed on. `bd-template-merge` refuses to merge a single draft for exactly
    that reason, and this refuses to grade one.

    Extracted from `mode_templates` because the n<2 guard was UNREACHABLE where
    it sat -- a single-capture site never produces a merged draft, so the
    `gate_support is None` branch answered first and a mutation removing the
    guard changed nothing observable. It escaped its battery. The rule is only
    defensive if nothing can reach it; as a function it is testable, and the
    day something merges a lone draft it will still refuse to call 1 of 1
    corroboration.
    """
    if n_drafts < 2 or gate_support is None:
        return "unknown"
    return ("corroborated" if (gate_support.get("support") or 0) > 1
            else "single_witness")


def _blocking(a):
    """Which of the gate's clauses failed, in the gate's own words. 'missing
    resolutions' is actionable where a score out of 100 is not."""
    if a is None:
        return ["no_draft"]
    out = []
    if not (a.get("download_trigger") or a.get("row_selectors_count")):
        out.append("gate_selector")
    if not a.get("resolutions"):
        out.append("resolutions")
    if a.get("blocked_terms"):
        out.append("blocked_terms")
    return out


def _progress(on, done, total, label):
    """Position with its DENOMINATOR, on stderr. `--json` owns stdout, and a
    progress line there would break every machine consumer -- a worse defect
    than having no progress at all, which is the state this replaces."""
    if not on:
        return
    sys.stderr.write("  %s %d/%d  %s\n" % (label, done, total, ""))
    sys.stderr.flush()


def _build_one(args):
    """One capture -> (index, raw draft or None). Runs in a POOL WORKER.

    THE CATCH LIVES HERE, NOT IN THE CALLER, and that is the whole point.
    `build_template` raises SystemExit for a wacz with no capture.json -- the
    box's corpus has five such archives out of 742. A SystemExit escaping a
    worker kills it and the executor raises BrokenProcessPool, aborting a run
    the serial version completes. `BaseException` rather than `Exception`
    because SystemExit is not an Exception.
    """
    idx, path = args
    fns, _assess, _label = _template_builder()
    if not fns:
        return idx, None
    build, _normalize = fns
    try:
        return idx, build(pathlib.Path(path))
    except BaseException:
        return idx, None


def _resolve_jobs(n):
    """0 -> auto; anything else clamped to at least 1.

    Default 1 (serial) is set by argparse, not here: parallelism is opted into.
    A default of auto would spawn one process per core under a caller that asked
    for none of it."""
    if n == 0:
        return max(1, os.cpu_count() or 1)
    return max(1, n)


def _reassemble(n, pairs):
    """[(index, value)] in ANY order -> a list in index order.

    Extracted so the ordering property is testable. `ProcessPoolExecutor.map`
    happens to yield in input order today, which made a mutant that indexed by
    COMPLETION order behaviourally identical -- it escaped a green band. The
    index is only decorative while that holds; the day anything switches to
    `as_completed`, it is the whole contract. A rule nothing can exercise is a
    rule nothing protects.
    """
    out = [None] * n
    for idx, value in pairs:
        out[idx] = value
    return out


def _build_all(paths, jobs, progress):
    """[(path, raw draft or None)] in the SAME ORDER as `paths`.

    Order is restored by index rather than by completion, because workers finish
    out of order by definition and two runs of one corpus must not disagree.
    """
    items = list(enumerate(str(p) for p in paths))
    out = [None] * len(items)
    if jobs <= 1:
        for i, (idx, sp) in enumerate(items, 1):
            out[idx] = _build_one((idx, sp))[1]
            _progress(progress, i, len(items), "build")
        return list(zip(paths, out))
    import concurrent.futures as _cf
    pairs = []
    with _cf.ProcessPoolExecutor(max_workers=jobs) as ex:
        for pair in ex.map(_build_one, items, chunksize=1):
            pairs.append(pair)
            if len(pairs) % 25 == 0 or len(pairs) == len(items):
                _progress(progress, len(pairs), len(items), "build")
    return list(zip(paths, _reassemble(len(items), pairs)))


def mode_templates(files, jobs=1, progress=False):
    """Per site: can ONE capture make a green template, can the COMBINATION, or
    neither -- and is the answer corroborated across that site's captures.

    Four verdicts, and `unbuildable` is a third state rather than a failure:
    an archive that yields no draft answers NOTHING about the site, and folding
    it into `not_green` would report a measurement nobody took.

    RELIABILITY IS THREE-STATE, and `unknown` is the one a plausible
    implementation gets wrong. A lone capture reports support 1 of 1, which is
    arithmetically identical to a selector every capture agrees on --
    `bd-template-merge` refuses to merge a single draft for exactly that reason.
    Calling it corroborated would be a verdict over a denominator that cannot
    contain its subject.
    """
    fns, assess, label = _template_builder()
    build, normalize = fns if fns else (None, None)
    merge, _merge_err = _merge_fn()
    jobs = _resolve_jobs(jobs)
    placed, _attempted, _parser = _place_by_host(files)

    # PER CAPTURE, not per site. A task per site is bounded by the largest site
    # -- 62 of the box's 742 captures sit under one host, capping site-level
    # parallelism near 12x however many cores exist. Per-capture tasks have a
    # tail of one capture.
    built = dict(_build_all([p for p, _h, _m, _r in placed], jobs, progress)) \
        if build is not None else {}

    buckets = {}
    for p, host, method, _reason in placed:
        buckets.setdefault((method == "unknown", host), []).append(p)

    sites, verdicts, unbuildable_total = [], {}, 0
    for (is_unknown, host), paths in sorted(buckets.items()):
        paths = sorted(paths, key=lambda x: x.name)
        drafts, normed, names, unbuildable = [], [], [], 0
        for p in paths:
            raw = built.get(p) if build is not None else None
            if raw is None:
                # Includes the builder being unavailable, an unreadable archive,
                # and the SystemExit a wacz with no capture.json provokes -- all
                # already caught inside the worker.
                unbuildable += 1
                continue
            try:
                normed.append(normalize(raw))
                drafts.append(raw)
                names.append(p.name)
            except BaseException:
                unbuildable += 1
        unbuildable_total += unbuildable

        singles = [assess(d, source=n) for d, n in zip(normed, names)] if assess else []
        ready = [(a, n) for a, n in zip(singles, names) if a["promotion_ready"]]
        best = max(singles, key=lambda a: (a["promotion_ready"],
                                           a["completeness_score"]),
                   default=None)

        merged = merged_a = None
        if len(drafts) >= 2 and merge is not None:
            try:
                # merge consumes RAW drafts (its own docstring: it feeds the
                # draft -> normalize -> promote pipeline), and the support block
                # it writes lives on that raw output -- so normalize a COPY for
                # assessing and read support off the raw one.
                merged = merge(drafts, names)
                merged_a = assess(normalize(merged), source="MERGED")
            except Exception:
                merged = merged_a = None

        if not drafts:
            verdict = "unbuildable"
        elif ready:
            verdict = "green_from_one"
        elif merged_a is not None and merged_a["promotion_ready"]:
            verdict = "green_only_merged"
        else:
            verdict = "not_green"
        verdicts[verdict] = verdicts.get(verdict, 0) + 1

        gs = _gate_support(merged)
        reliability = _reliability(len(drafts), gs)

        sites.append({
            "host": host,
            "resolved_host": not is_unknown,
            "captures": len(paths),
            "drafts_built": len(drafts),
            "unbuildable": unbuildable,
            "verdict": verdict,
            "green_capture": ready[0][1] if ready else None,
            "best_single_ready": bool(ready),
            "best_single_score": best["completeness_score"] if best else 0,
            "merged_ready": bool(merged_a and merged_a["promotion_ready"]),
            "merge_inputs": names if len(drafts) >= 2 else [],
            "blocking": _blocking(merged_a or best),
            "reliability": reliability,
            "gate_support": gs,
            "missing": (merged_a or best or {}).get("missing", []),
        })

    return {"examined": len(files),
            "denominator": ("all *.wacz under root, grouped by the same host "
                            "tiering --hosts reports; green is "
                            "template_inventory.assess, the promote gate's own "
                            "mirror, never a second definition"),
            "template_builder": label,
            "jobs": jobs,
            "sites": len(sites) and sites or [],
            "site_count": len(sites),
            "verdicts": verdicts,
            "unbuildable_captures": unbuildable_total,
            "reliability_note": ("support is across a site's captures; a lone "
                                 "capture is 1 of 1, indistinguishable from a "
                                 "universal, and is reported unknown"),
            }


def mode_pairs(files):
    raws = {_base(p): p for p in files if not _is_redacted(p)}
    reds = {_base(p): p for p in files if _is_redacted(p)}
    entries = []
    for b, r in sorted(raws.items()):
        if b in reds:
            rb, db = r.stat().st_size, reds[b].stat().st_size
            entries.append({"base": b, "raw_bytes": rb, "redacted_bytes": db,
                            "ratio": round(db / rb, 4) if rb else None})
    ratios = [e["ratio"] for e in entries if e["ratio"] is not None]
    return {"examined": len(files),
            "denominator": "all *.wacz under root, split raw vs .redacted",
            "paired": len(entries),
            "unpaired_raw": sum(1 for b in raws if b not in reds),
            "unpaired_redacted": sum(1 for b in reds if b not in raws),
            "median_ratio": (sorted(ratios)[len(ratios) // 2] if ratios else None),
            "entries": entries}


def mode_health(files):
    ok = unreadable = no_payload = 0
    detail = []
    for p in files:
        try:
            with zipfile.ZipFile(p) as z:
                bad = z.testzip()
                if bad is not None:
                    unreadable += 1
                    detail.append({"file": p.name, "state": "crc_failed", "member": bad})
                    continue
                names = z.namelist()
        except Exception as exc:
            unreadable += 1
            detail.append({"file": p.name, "state": "unreadable",
                           "reason": type(exc).__name__})
            continue
        if not any(".warc" in n.lower() for n in names):
            no_payload += 1
            detail.append({"file": p.name, "state": "no_warc_payload",
                           "members": len(names)})
            continue
        ok += 1
    return {"examined": len(files),
            "denominator": "all *.wacz under root",
            "ok": ok, "unreadable": unreadable, "no_payload": no_payload,
            "detail": detail}


def mode_scrub(files):
    clean = with_findings = unreadable = 0
    unscannable_members = 0
    detail = []
    for p in files:
        hits, unscannable = 0, 0
        try:
            with zipfile.ZipFile(p) as z:
                for n in z.namelist():
                    if n.endswith("/"):
                        continue
                    try:
                        data = z.read(n)
                    except Exception:
                        unscannable += 1
                        continue
                    # CONTENT, not extension -- the whole point of @859.
                    if not sec.should_scan(n, data):
                        unscannable += 1
                        continue
                    hits += len(_KV.findall(data))
        except Exception as exc:
            unreadable += 1
            detail.append({"file": p.name, "state": "unreadable",
                           "reason": type(exc).__name__})
            continue
        unscannable_members += unscannable
        if hits:
            with_findings += 1
            detail.append({"file": p.name, "state": "findings", "hits": hits,
                           "unscannable_members": unscannable})
        elif unscannable:
            # NOT clean. The scan's denominator excluded members it could not
            # read, so "no hits" here is a statement about the part it saw.
            detail.append({"file": p.name, "state": "inconclusive",
                           "unscannable_members": unscannable})
        else:
            clean += 1
    return {"examined": len(files),
            "denominator": "all *.wacz under root; per-member content sniffed",
            "clean": clean,
            "with_findings": with_findings,
            "inconclusive": len(files) - clean - with_findings - unreadable,
            "unreadable": unreadable,
            "unscannable_members": unscannable_members,
            "screen_only": ("this is a SCREEN, not the canonical floor "
                            "(capture_artifact_redact.scan_floor_secrets); a "
                            "clean result here shortlists, it does not clear"),
            "detail": detail}


def _sha256(path, _buf=1 << 20):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(_buf), b""):
            h.update(chunk)
    return h.hexdigest()


def mode_dupes(files):
    """Two-stage: size groups first, hash ONLY inside them.

    Stage one exists to avoid reading the corpus. Measured on the box: 429
    collision groups cover 1000 of 1251 files and 1.73 GB, so hashing every file
    would read 4.04 GB to answer a question 1.71 GB settles.

    Two OUTPUTS, deliberately not one. Identical copies of the same artifact are
    a disk question. A DERIVATIVE byte-identical to its source is not -- it means
    the scrubber returned its input unchanged, and @971 established that path
    could pass binary members through untouched. Counting that as "reclaimable"
    would invite deleting the evidence that redaction never happened.
    """
    by_size = {}
    for p in files:
        try:
            by_size.setdefault(p.stat().st_size, []).append(p)
        except OSError:
            pass
    candidates = [p for v in by_size.values() if len(v) > 1 for p in v]

    digests = {}
    unreadable = 0
    for p in candidates:
        try:
            digests[p] = _sha256(p)
        except OSError:
            unreadable += 1

    by_hash = {}
    for p, h in digests.items():
        by_hash.setdefault(h, []).append(p)

    groups, noop, reclaimable = [], [], 0
    for h, members in sorted(by_hash.items()):
        if len(members) < 2:
            continue
        bases = {_base(m) for m in members}
        raws = [m for m in members if not _is_redacted(m)]
        derivs = [m for m in members if _is_redacted(m)]
        # Same source AND a raw sibling identical to a derivative -> the scrub
        # was a no-op. Evidence, not disk.
        if len(bases) == 1 and raws and derivs:
            noop.append({"base": sorted(bases)[0], "sha256": h[:16],
                         "source": raws[0].name,
                         "identical_derivatives": sorted(d.name for d in derivs)})
            continue
        size = members[0].stat().st_size
        reclaimable += size * (len(members) - 1)
        groups.append({"sha256": h[:16], "bytes_each": size,
                       "copies": len(members),
                       "reclaimable_bytes": size * (len(members) - 1),
                       "files": sorted(m.name for m in members)})

    groups.sort(key=lambda g: -g["reclaimable_bytes"])
    return {"examined": len(files),
            "denominator": ("all *.wacz under root; hashed only those sharing a "
                            "size with another file"),
            "size_collision_candidates": len(candidates),
            "hashed": len(digests),
            "unreadable": unreadable,
            "duplicate_groups": len(groups),
            "reclaimable_bytes": reclaimable,
            # Counts DERIVATIVE FILES, not groups: the question is "how many
            # redaction outputs were a no-op", and one source with three
            # identical derivatives is three failed scrubs, not one.
            "noop_derivatives": sum(len(n["identical_derivatives"]) for n in noop),
            "noop_groups": len(noop),
            "noop_detail": noop,
            "report_only": ("nothing is deleted or modified; a no-op derivative "
                            "is a REDACTION finding, never reclaimable disk"),
            "groups": groups}


_MODES = {"group": mode_group, "hosts": mode_hosts, "templates": mode_templates,
          "pairs": mode_pairs, "health": mode_health, "scrub": mode_scrub,
          "dupes": mode_dupes}


def main() -> int:
    ap = argparse.ArgumentParser(description="read-only WACZ corpus survey")
    ap.add_argument("--root", required=True)
    for m in _MODES:
        ap.add_argument("--" + m, action="store_true")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--json", action="store_true")
    # DEFAULT 1 -- serial, so an existing invocation is byte-for-byte unchanged.
    # Parallelism is opted into: an `auto` default would spawn one process per
    # core under a caller that asked for none of it. 0 means auto.
    ap.add_argument("--jobs", "-j", type=int, default=1, metavar="N",
                    help="worker processes for --templates (default 1 = serial, "
                         "0 = one per core)")
    ap.add_argument("--progress", action="store_true",
                    help="position with its denominator, on STDERR (stdout "
                         "belongs to --json)")
    a = ap.parse_args()

    chosen = [m for m in _MODES if getattr(a, m)] or (list(_MODES) if a.all else [])
    if a.all:
        chosen = list(_MODES)
    if not chosen:
        # Derived from _MODES rather than spelled: the hand-written version of
        # this line had already gone stale, omitting --dupes.
        ap.error("pick at least one of %s, or --all"
                 % "/".join("--" + m for m in _MODES))

    root = pathlib.Path(a.root).expanduser()
    files, why = enumerate_corpus(root)
    if why:
        out = {"status": "unknown", "root": str(root),
               "denominator": {"wacz_files": 0}, "reason": why,
               "modes": {}}
        print(json.dumps(out, indent=2) if a.json
              else "UNKNOWN  %s\n         nothing was examined, so this is not "
                   "a clean result." % why)
        return EXIT_UNKNOWN

    modes = {}
    for m in chosen:
        if m == "templates":
            modes[m] = mode_templates(files, jobs=a.jobs, progress=a.progress)
        else:
            modes[m] = _MODES[m](files)
    findings = (modes.get("health", {}).get("unreadable", 0)
                + modes.get("health", {}).get("no_payload", 0)
                # An archive tier 2 could not OPEN is a finding; one that opened
                # and carries no URL is a corpus property and deliberately is not.
                + modes.get("hosts", {}).get("unreadable", 0)
                + modes.get("scrub", {}).get("with_findings", 0)
                + modes.get("scrub", {}).get("inconclusive", 0)
                + modes.get("scrub", {}).get("unreadable", 0)
                + modes.get("templates", {}).get("unbuildable_captures", 0)
                + modes.get("dupes", {}).get("noop_derivatives", 0))
    status = "findings" if findings else "ok"
    out = {"status": status, "root": str(root),
           "denominator": {"wacz_files": len(files)}, "modes": modes}

    if a.json:
        print(json.dumps(out, indent=2))
    else:
        print("bd-wacz-corpus  root=%s  wacz_files=%d" % (root, len(files)))
        for m in chosen:
            d = modes[m]
            print("  %-7s examined=%s  %s" % (
                m, d["examined"],
                " ".join("%s=%s" % (k, v) for k, v in d.items()
                         if k not in ("examined", "detail", "entries", "groups",
                                      "denominator", "screen_only"))))
            print("          over: %s" % d["denominator"])
        print("STATUS %s" % status.upper())
    return EXIT_FINDINGS if findings else EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
