#!/usr/bin/env python3
"""bd-wacz-corpus -- read-only survey of a local WACZ corpus.

Four analyses over ONE denominator, each independently selectable so their
answers can be compared rather than taken on trust:

  --group    site grouping from the `t_<hash>_<name>.wacz` naming, so the inputs
             to a template merge are DERIVED rather than eyeballed
  --hosts    grouping by HOST, three tiers, every group labelled with the method
             that produced it (see mode_hosts)
  --pairs    raw <-> `.redacted` twins and the size ratio between them
  --health   does each archive open, pass CRC, and carry a WARC payload
  --scrub    screening pass for credential-shaped material still in the archive
  --dupes    byte-identical copies, and derivatives identical to their source
  --all      every mode

WHY THE DENOMINATOR IS REPORTED EVERYWHERE. CLAUDE.md section 0 opens with a
gate that cannot see its subject reporting OK -- truthfully, and uselessly --
and this repo owns the scar: bd-wacz-scrub, bd-scrub-proof and bd-share-safe
each carried a TEXT_EXT allowlist containing no `.warc`, which is where a WACZ's
payload lives, and all three printed "verified clean" over what turned out to be
228 contaminated files. So: every mode states what it examined, an empty corpus
is UNKNOWN rather than "0 problems", and a member that could not be READ is
counted separately from a member that was read and found clean.

WHAT --scrub IS NOT. It is a SCREEN, not the canonical floor. The floor is
`bulk_downloader.capture_artifact_redact.scan_floor_secrets`, which operates on
a parsed capture rather than on raw archive bytes. This mode exists to shortlist
files worth putting through that, and its own output says so. Treating a clean
screen as a clean floor would be the same substitution error the allowlists made.

Exit: 0 ran-and-clean, 1 ran-with-findings, 2 UNKNOWN (cannot answer).
2 is not a softer 1 -- it means the question was not evaluated.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import sys
import zipfile
from urllib.parse import urlsplit

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)
import bdtools_sec as sec  # noqa: E402

EXIT_OK, EXIT_FINDINGS, EXIT_UNKNOWN = 0, 1, 2

_WACZ = ".wacz"

# MEASURED against the real 1251-file corpus, not assumed. The first version of
# this tool tested `name.endswith(".redacted.wacz")`, which classified 197 of
# the 601 redacted files -- 33% -- as RAW captures, because 216 files carry a
# Windows-style copy suffix and `x.redacted (2).wacz` does not end in
# `.redacted.wacz`. It also had no concept of `.scrubbed` (176 files) or
# `.redacted.scrubbed` (46), counting all of them as raw.
_DERIVATIVE_MARKERS = (".redacted", ".scrubbed")
# `(2)` and `(dup1)`, with or without a leading space -- both forms are real.
_COPY_SUFFIX = re.compile(r"\s*\((?:dup)?\d+\)")

# `t_<hex>_<name>.wacz` is the export convention; the <name> is the only site
# signal a filename carries. Anything not matching keeps its whole stem, so an
# unrecognised naming scheme groups under itself rather than vanishing.
_NAMED = re.compile(r"^t_[0-9a-fA-F]{6,}_(.+)$")
_SITE = re.compile(r"^([A-Za-z]+)")

# STRUCTURAL, not entropy-based and not a bare word: a credential-ish key, a
# separator, then a value with some length to it. `SECRET_WORD_RE` alone fires
# on any prose containing "secret" -- over-sensitivity is a soundness bug
# (section 0), and a screen that cries wolf gets switched off.
_KV = re.compile(
    rb"(?i)\b(secret|token|api[_-]?key|apikey|password|passwd|authorization"
    rb"|bearer|session[_-]?id|access[_-]?token)\b\s*[=:]\s*[^\s\"'&;]{8,}")


def enumerate_corpus(root: pathlib.Path):
    """Every *.wacz under root. Returns (files, reason_if_unknown)."""
    if not root.exists():
        return [], "root does not exist: %s" % root
    if not root.is_dir():
        return [], "root is not a directory: %s" % root
    files = sorted(p for p in root.rglob("*" + _WACZ) if p.is_file())
    if not files:
        return [], "no *.wacz found under root: %s" % root
    return files, None


def _markers(p: pathlib.Path):
    """Which derivative markers this filename carries, in order."""
    stem = p.name[:-len(_WACZ)] if p.name.lower().endswith(_WACZ) else p.name
    stem = _COPY_SUFFIX.sub("", stem).lower()
    return tuple(m for m in _DERIVATIVE_MARKERS if m in stem)


def _is_redacted(p: pathlib.Path) -> bool:
    """Any derivative, not just a literal `.redacted.wacz` ending."""
    return bool(_markers(p))


def _base(p: pathlib.Path) -> str:
    """The SOURCE capture name: copy suffix and every derivative marker removed.

    So `x.wacz`, `x.redacted (2).wacz`, `x.scrubbed.wacz` and
    `x.redacted.scrubbed.wacz` all resolve to `x` -- one family, which is what
    pairing and the no-op check both need.
    """
    n = p.name
    n = n[:-len(_WACZ)] if n.lower().endswith(_WACZ) else n
    n = _COPY_SUFFIX.sub("", n)
    low = n.lower()
    for m in _DERIVATIVE_MARKERS:
        i = low.find(m)
        while i != -1:
            n = n[:i] + n[i + len(m):]
            low = n.lower()
            i = low.find(m)
    return n


def _site_of(p: pathlib.Path) -> str:
    stem = _base(p)
    m = _NAMED.match(stem)
    if not m:
        # Unrecognised naming: group under the WHOLE stem. Running _SITE over it
        # would take the leading alpha run of a string never meant to be parsed
        # -- measured, every `t_<short>_<name>` fixture collapsed into a single
        # bucket called "t", which is a silent mis-grouping that looks like a
        # real answer. The docstring already promised this behaviour; the code
        # did not implement it.
        return stem.lower()
    m2 = _SITE.match(m.group(1))
    return (m2.group(1) if m2 else m.group(1)).lower()


def mode_group(files):
    raws = [p for p in files if not _is_redacted(p)]
    buckets = {}
    for p in raws:
        buckets.setdefault(_site_of(p), []).append(p.name)
    groups = [{"site": s, "captures": len(v), "merge_candidate": len(v) > 1,
               "files": sorted(v)}
              for s, v in sorted(buckets.items())]
    return {"examined": len(raws),
            "denominator": "raw (non-.redacted) *.wacz under root",
            "sites": len(groups),
            "merge_candidates": sum(1 for g in groups if g["merge_candidate"]),
            "groups": groups}


# ---------------------------------------------------------------- host grouping
#
# `--group` reads the `t_<hex>_<name>` EXPORT convention. The box's real corpus
# does not use it: there, `123.wacz` and `1232.wacz` carry no site signal at all
# and no filename heuristic will ever group them. Three tiers, filename-first
# with the archive as the authority, and every group states which one answered.

_PAGES_MEMBER = "pages/pages.jsonl"
# Bounded on purpose. The member is decompressed, so an unbounded read on an
# untrusted archive is a memory question, and the entry-point page record is the
# first line after the format header -- scanning a whole browsertrix crawl to
# find a netloc would be slow AND would risk picking an off-site resource.
_PAGES_READ_CAP = 1 << 20
_PAGES_LINE_CAP = 64

_PARSER_CACHE = None


def _load_filename_parser():
    """(callable, label) for tier 1, or (None, why-not).

    IMPORTED, not copied. `bulk_downloader.dom_analyzer._parse_capture_host` is
    the same function the capture picker and `scan_captures` use, and a second
    copy of a naming rule is how two answers to one question start to disagree
    (CLAUDE.md section 5 on `system_deps.sh`: three copies is a denominator that
    drifts, and the copy nobody updated is the one that runs).

    The cost of importing rather than copying is that a rename makes tier 1
    vanish, so the failure is REPORTED rather than absorbed: without it every
    BD-named capture falls through to an archive read, which a REDACTED capture
    cannot answer, and a whole corpus would read as `unknown` with nothing in
    the output saying why.
    """
    try:
        if sec.DEFAULT_WORK not in sys.path:
            sys.path.insert(0, sec.DEFAULT_WORK)
        from bulk_downloader.dom_analyzer import _parse_capture_host
    except Exception as exc:                       # pragma: no cover - env-only
        return None, "UNAVAILABLE: %s: %s" % (type(exc).__name__, exc)
    return (_parse_capture_host,
            "bulk_downloader.dom_analyzer._parse_capture_host")


def _filename_parser():
    global _PARSER_CACHE
    if _PARSER_CACHE is None:
        _PARSER_CACHE = _load_filename_parser()
    return _PARSER_CACHE


def _host_from_archive(p):
    """(host, reason_if_none) from the archive's own page record.

    `wacz_export._pages_jsonl` writes a format header followed by a page entry
    carrying the captured top-level URL. Measured on a BD-built archive: the
    redactor scrubs the query but leaves the netloc, so this answers for a
    `.redacted` capture too.

    `hostname`, NOT `netloc` as first sketched: netloc keeps `user:pass@` and
    `:port`, so one site behind a port would form a second group and the group
    LABEL -- which is printed -- would become a place a credential lives
    (section 7). `hostname` is also already lowercased, which is the shape tier
    1 returns, so the two tiers can land in the same bucket.
    """
    try:
        with zipfile.ZipFile(p) as z:
            if _PAGES_MEMBER not in set(z.namelist()):
                return None, "no_pages_jsonl"
            with z.open(_PAGES_MEMBER) as fh:
                blob = fh.read(_PAGES_READ_CAP)
    except Exception:
        return None, "unreadable"
    saw_url = False
    for line in blob.splitlines()[:_PAGES_LINE_CAP]:
        try:
            rec = json.loads(line)
        except Exception:
            continue                               # header, blank, or truncated
        if not isinstance(rec, dict):
            continue
        url = rec.get("url")
        if not isinstance(url, str) or not url:
            continue
        saw_url = True
        host = urlsplit(url).hostname
        if host:
            return host.lower(), None
    return None, ("no_host" if saw_url else "no_url")


def mode_hosts(files):
    """Group by host: filename first, the archive as the authority, never a guess.

      1. `{host}_{siteid}_{YYYYMMDD}` in the filename    -> method=filename
      2. `pages/pages.jsonl` inside the archive          -> method=archive
      3. the stem, grouped under ITSELF                  -> method=unknown

    Tier 1 runs against `_base()`, not the raw stem. MEASURED on this tree: the
    capture parser anchors on a date-ish TAIL, and a derivative marker or copy
    suffix sits exactly where that tail has to be, so
    `<name>.redacted (2)` returns None while `_base()` of it returns the host.
    Forgetting the strip sends all 601 redacted files through an archive read
    they do not need.

    An UNKNOWN bucket is keyed apart from the resolved hosts even when the label
    matches, so a stem that happens to look like a host can never be laundered
    into a measured group -- "never guessed" has to hold in the OUTPUT, not just
    in the derivation.

    Only `unreadable` -- an archive that was opened and could not be read --
    counts as a finding. An archive that opens and simply carries no URL is a
    property of this corpus, not a defect; firing on it would flag the hundreds
    of site-signal-free names the mode exists to describe, and a screen that
    cries wolf gets switched off (section 0's over-sensitivity failure).
    """
    parser, parser_label = _filename_parser()
    placed = []            # (path, label, method, reason)
    attempted = 0
    for p in files:
        base = _base(p)
        host = None
        if parser is not None:
            try:
                host = parser(base)
            except Exception:
                host = None
        if host:
            placed.append((p, host.lower(), "filename", None))
            continue
        attempted += 1
        host, why = _host_from_archive(p)
        if host:
            placed.append((p, host, "archive", None))
        else:
            placed.append((p, base.lower(), "unknown", why))

    buckets = {}
    for p, label, method, reason in placed:
        buckets.setdefault((method == "unknown", label), []).append(
            (p, method, reason))

    groups = []
    for (is_unknown, label), members in sorted(buckets.items()):
        sources = {_base(m[0]) for m in members}
        entries = []
        for m_p, m_method, m_reason in sorted(members, key=lambda m: m[0].name):
            e = {"name": m_p.name, "method": m_method}
            if m_reason:
                e["reason"] = m_reason
            entries.append(e)
        groups.append({"host": label,
                       "captures": len(members),
                       # SOURCES, not files: a raw capture and its `.redacted`
                       # twin are one capture in two forms, and a merge needs
                       # two DIFFERENT captures to have anything to merge.
                       "sources": len(sources),
                       "merge_candidate": (not is_unknown) and len(sources) > 1,
                       "methods": sorted({m[1] for m in members}),
                       "files": entries})

    by_method = {"filename": 0, "archive": 0, "unknown": 0}
    reasons = {}
    for _p, _label, method, reason in placed:
        by_method[method] += 1
        if method == "unknown" and reason:
            reasons[reason] = reasons.get(reason, 0) + 1

    return {"examined": len(files),
            "denominator": ("all *.wacz under root; host resolved filename-"
                            "first, the archive's own page record as authority"),
            "filename_parser": parser_label,
            "hosts": sum(1 for g in groups if g["methods"] != ["unknown"]),
            "unresolved_groups": sum(1 for g in groups
                                     if g["methods"] == ["unknown"]),
            "merge_candidates": sum(1 for g in groups if g["merge_candidate"]),
            "by_method": by_method,
            # ATTEMPTS, not successes: an archive that failed to open is counted
            # here and again under `unreadable`.
            "archives_opened": attempted,
            "unreadable": reasons.get("unreadable", 0),
            "unknown_reasons": reasons,
            "groups": groups}


def mode_pairs(files):
    raws = {_base(p): p for p in files if not _is_redacted(p)}
    reds = {_base(p): p for p in files if _is_redacted(p)}
    entries = []
    for b, r in sorted(raws.items()):
        if b in reds:
            rb, db = r.stat().st_size, reds[b].stat().st_size
            entries.append({"base": b, "raw_bytes": rb, "redacted_bytes": db,
                            "ratio": round(db / rb, 4) if rb else None})
    ratios = [e["ratio"] for e in entries if e["ratio"] is not None]
    return {"examined": len(files),
            "denominator": "all *.wacz under root, split raw vs .redacted",
            "paired": len(entries),
            "unpaired_raw": sum(1 for b in raws if b not in reds),
            "unpaired_redacted": sum(1 for b in reds if b not in raws),
            "median_ratio": (sorted(ratios)[len(ratios) // 2] if ratios else None),
            "entries": entries}


def mode_health(files):
    ok = unreadable = no_payload = 0
    detail = []
    for p in files:
        try:
            with zipfile.ZipFile(p) as z:
                bad = z.testzip()
                if bad is not None:
                    unreadable += 1
                    detail.append({"file": p.name, "state": "crc_failed", "member": bad})
                    continue
                names = z.namelist()
        except Exception as exc:
            unreadable += 1
            detail.append({"file": p.name, "state": "unreadable",
                           "reason": type(exc).__name__})
            continue
        if not any(".warc" in n.lower() for n in names):
            no_payload += 1
            detail.append({"file": p.name, "state": "no_warc_payload",
                           "members": len(names)})
            continue
        ok += 1
    return {"examined": len(files),
            "denominator": "all *.wacz under root",
            "ok": ok, "unreadable": unreadable, "no_payload": no_payload,
            "detail": detail}


def mode_scrub(files):
    clean = with_findings = unreadable = 0
    unscannable_members = 0
    detail = []
    for p in files:
        hits, unscannable = 0, 0
        try:
            with zipfile.ZipFile(p) as z:
                for n in z.namelist():
                    if n.endswith("/"):
                        continue
                    try:
                        data = z.read(n)
                    except Exception:
                        unscannable += 1
                        continue
                    # CONTENT, not extension -- the whole point of @859.
                    if not sec.should_scan(n, data):
                        unscannable += 1
                        continue
                    hits += len(_KV.findall(data))
        except Exception as exc:
            unreadable += 1
            detail.append({"file": p.name, "state": "unreadable",
                           "reason": type(exc).__name__})
            continue
        unscannable_members += unscannable
        if hits:
            with_findings += 1
            detail.append({"file": p.name, "state": "findings", "hits": hits,
                           "unscannable_members": unscannable})
        elif unscannable:
            # NOT clean. The scan's denominator excluded members it could not
            # read, so "no hits" here is a statement about the part it saw.
            detail.append({"file": p.name, "state": "inconclusive",
                           "unscannable_members": unscannable})
        else:
            clean += 1
    return {"examined": len(files),
            "denominator": "all *.wacz under root; per-member content sniffed",
            "clean": clean,
            "with_findings": with_findings,
            "inconclusive": len(files) - clean - with_findings - unreadable,
            "unreadable": unreadable,
            "unscannable_members": unscannable_members,
            "screen_only": ("this is a SCREEN, not the canonical floor "
                            "(capture_artifact_redact.scan_floor_secrets); a "
                            "clean result here shortlists, it does not clear"),
            "detail": detail}


def _sha256(path, _buf=1 << 20):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(_buf), b""):
            h.update(chunk)
    return h.hexdigest()


def mode_dupes(files):
    """Two-stage: size groups first, hash ONLY inside them.

    Stage one exists to avoid reading the corpus. Measured on the box: 429
    collision groups cover 1000 of 1251 files and 1.73 GB, so hashing every file
    would read 4.04 GB to answer a question 1.71 GB settles.

    Two OUTPUTS, deliberately not one. Identical copies of the same artifact are
    a disk question. A DERIVATIVE byte-identical to its source is not -- it means
    the scrubber returned its input unchanged, and @971 established that path
    could pass binary members through untouched. Counting that as "reclaimable"
    would invite deleting the evidence that redaction never happened.
    """
    by_size = {}
    for p in files:
        try:
            by_size.setdefault(p.stat().st_size, []).append(p)
        except OSError:
            pass
    candidates = [p for v in by_size.values() if len(v) > 1 for p in v]

    digests = {}
    unreadable = 0
    for p in candidates:
        try:
            digests[p] = _sha256(p)
        except OSError:
            unreadable += 1

    by_hash = {}
    for p, h in digests.items():
        by_hash.setdefault(h, []).append(p)

    groups, noop, reclaimable = [], [], 0
    for h, members in sorted(by_hash.items()):
        if len(members) < 2:
            continue
        bases = {_base(m) for m in members}
        raws = [m for m in members if not _is_redacted(m)]
        derivs = [m for m in members if _is_redacted(m)]
        # Same source AND a raw sibling identical to a derivative -> the scrub
        # was a no-op. Evidence, not disk.
        if len(bases) == 1 and raws and derivs:
            noop.append({"base": sorted(bases)[0], "sha256": h[:16],
                         "source": raws[0].name,
                         "identical_derivatives": sorted(d.name for d in derivs)})
            continue
        size = members[0].stat().st_size
        reclaimable += size * (len(members) - 1)
        groups.append({"sha256": h[:16], "bytes_each": size,
                       "copies": len(members),
                       "reclaimable_bytes": size * (len(members) - 1),
                       "files": sorted(m.name for m in members)})

    groups.sort(key=lambda g: -g["reclaimable_bytes"])
    return {"examined": len(files),
            "denominator": ("all *.wacz under root; hashed only those sharing a "
                            "size with another file"),
            "size_collision_candidates": len(candidates),
            "hashed": len(digests),
            "unreadable": unreadable,
            "duplicate_groups": len(groups),
            "reclaimable_bytes": reclaimable,
            # Counts DERIVATIVE FILES, not groups: the question is "how many
            # redaction outputs were a no-op", and one source with three
            # identical derivatives is three failed scrubs, not one.
            "noop_derivatives": sum(len(n["identical_derivatives"]) for n in noop),
            "noop_groups": len(noop),
            "noop_detail": noop,
            "report_only": ("nothing is deleted or modified; a no-op derivative "
                            "is a REDACTION finding, never reclaimable disk"),
            "groups": groups}


_MODES = {"group": mode_group, "hosts": mode_hosts, "pairs": mode_pairs,
          "health": mode_health, "scrub": mode_scrub, "dupes": mode_dupes}


def main() -> int:
    ap = argparse.ArgumentParser(description="read-only WACZ corpus survey")
    ap.add_argument("--root", required=True)
    for m in _MODES:
        ap.add_argument("--" + m, action="store_true")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    chosen = [m for m in _MODES if getattr(a, m)] or (list(_MODES) if a.all else [])
    if a.all:
        chosen = list(_MODES)
    if not chosen:
        # Derived from _MODES rather than spelled: the hand-written version of
        # this line had already gone stale, omitting --dupes.
        ap.error("pick at least one of %s, or --all"
                 % "/".join("--" + m for m in _MODES))

    root = pathlib.Path(a.root).expanduser()
    files, why = enumerate_corpus(root)
    if why:
        out = {"status": "unknown", "root": str(root),
               "denominator": {"wacz_files": 0}, "reason": why,
               "modes": {}}
        print(json.dumps(out, indent=2) if a.json
              else "UNKNOWN  %s\n         nothing was examined, so this is not "
                   "a clean result." % why)
        return EXIT_UNKNOWN

    modes = {m: _MODES[m](files) for m in chosen}
    findings = (modes.get("health", {}).get("unreadable", 0)
                + modes.get("health", {}).get("no_payload", 0)
                # An archive tier 2 could not OPEN is a finding; one that opened
                # and carries no URL is a corpus property and deliberately is not.
                + modes.get("hosts", {}).get("unreadable", 0)
                + modes.get("scrub", {}).get("with_findings", 0)
                + modes.get("scrub", {}).get("inconclusive", 0)
                + modes.get("scrub", {}).get("unreadable", 0)
                + modes.get("dupes", {}).get("noop_derivatives", 0))
    status = "findings" if findings else "ok"
    out = {"status": status, "root": str(root),
           "denominator": {"wacz_files": len(files)}, "modes": modes}

    if a.json:
        print(json.dumps(out, indent=2))
    else:
        print("bd-wacz-corpus  root=%s  wacz_files=%d" % (root, len(files)))
        for m in chosen:
            d = modes[m]
            print("  %-7s examined=%s  %s" % (
                m, d["examined"],
                " ".join("%s=%s" % (k, v) for k, v in d.items()
                         if k not in ("examined", "detail", "entries", "groups",
                                      "denominator", "screen_only"))))
            print("          over: %s" % d["denominator"])
        print("STATUS %s" % status.upper())
    return EXIT_FINDINGS if findings else EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
