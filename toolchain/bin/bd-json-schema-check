#!/usr/bin/env python3
"""bd-json-schema-check -- validate JSON Schema definitions (structure + defaults).

Finds JSON files that look like JSON Schemas (have "type"/"properties"/"$schema")
and checks them for structural validity: valid type values, enum non-empty,
required fields that exist in properties, default values that match the declared
type. A malformed schema (bad enum/type/default) -> BD-SCHEMA-INVALID. Also
scans llm_schemas.py-style embedded schemas. Read-only.

Usage: bd-json-schema-check [--work DIR] [--json] [--selftest]
Exit 1 if any invalid schema, else 0.
"""
import argparse, glob, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
VALID_TYPES={"object","array","string","number","integer","boolean","null"}
TYPE_PY={"string":str,"number":(int,float),"integer":int,"boolean":bool,"array":list,"object":dict}

def looks_schema(obj):
    return isinstance(obj,dict) and ("$schema" in obj or "properties" in obj or
           (obj.get("type") in VALID_TYPES and "type" in obj))

def check_schema(obj, path="$"):
    errs=[]
    t=obj.get("type")
    if t is not None and t not in VALID_TYPES and not (isinstance(t,list) and all(x in VALID_TYPES for x in t)):
        errs.append("%s: invalid type %r"%(path,t))
    if "enum" in obj and (not isinstance(obj["enum"],list) or len(obj["enum"])==0):
        errs.append("%s: enum must be a non-empty list"%path)
    props=obj.get("properties",{})
    if "required" in obj and isinstance(obj["required"],list):
        for r in obj["required"]:
            if props and r not in props:
                errs.append("%s: required %r not in properties"%(path,r))
    if "default" in obj and t in TYPE_PY:
        if not isinstance(obj["default"], TYPE_PY[t]):
            errs.append("%s: default %r not of type %s"%(path,obj["default"],t))
    if isinstance(props,dict):
        for k,v in props.items():
            if isinstance(v,dict): errs.extend(check_schema(v, path+"."+k))
    return errs

def scan(work):
    findings=[]; checked=0
    for f in glob.glob(os.path.join(work,"**","*.json"),recursive=True):
        if "node_modules" in f: continue
        try: obj=json.load(open(f))
        # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
        except Exception: continue
        if not looks_schema(obj): continue
        checked+=1
        for e in check_schema(obj):
            findings.append({"file":os.path.relpath(f,work),"error":e})
    return findings, checked

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        good={"type":"object","properties":{"n":{"type":"integer","default":5}},"required":["n"]}
        bad={"type":"widget","properties":{"n":{"type":"integer","default":"five"}},"required":["missing"],"enum":[]}
        json.dump(good,open(os.path.join(d,"good.json"),"w"))
        json.dump(bad,open(os.path.join(d,"bad.json"),"w"))
        f,c=scan(d)
    byfile={}
    for x in f: byfile.setdefault(os.path.basename(x["file"]),[]).append(x["error"])
    good_clean="good.json" not in byfile
    bad_caught=len(byfile.get("bad.json",[]))>=3
    print(("PASS" if good_clean else "FAIL")+"  valid schema passes")
    print(("PASS" if bad_caught else "FAIL")+"  invalid schema: type+default+required+enum caught (%d)"%len(byfile.get("bad.json",[])))
    ok=ok and good_clean and bad_caught
    r=scan(sec.DEFAULT_WORK)
    print(("PASS" if r[1]>=0 else "FAIL")+"  real tree: %d schemas checked, %d issues"%(r[1],len(r[0])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    f,c=scan(a.work)
    if sec.emit({"findings":f,"summary":{"schemas_checked":c,"invalid":len(f)}},as_json=a.json): return 1 if f else 0
    print("%d JSON schema(s) checked; %d issue(s)"%(c,len(f)))
    for x in f[:40]: print("  %sBD-SCHEMA-INVALID%s %s: %s"%(R,RST,x["file"],x["error"]))
    if not f: print(G+"all schemas structurally valid"+RST)
    return 1 if f else 0
sys.exit(main())
