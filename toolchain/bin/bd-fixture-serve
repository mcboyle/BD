#!/usr/bin/env python3
"""bd-fixture-serve -- serve synthetic, content-free player-embed fixture pages.

The recognizer detects PLAYER FAMILIES by HTML seams (jwplayer `.setup()`,
video.js `data-setup`, an HTML5 `<video>` with a `.m3u8`/`.mpd` source, hls.js
`loadSource`, etc.) -- and that detection is SITE-AGNOSTIC: it keys off the embed
structure, not the site. So we can exercise the real recognizer path headless,
in-sandbox, against locally-served synthetic pages that carry the seam structures
but ZERO real content, real URLs, or real sites. No live site is ever touched.

This serves a small set of fixture pages on 127.0.0.1:<port>:
  /jwplayer      jwplayer .setup({playlist:[{sources:[{file:...m3u8}]}]})
  /videojs       <video-js> + data-setup with an HLS source
  /html5-hls     bare <video><source src=...m3u8 type=application/x-mpegURL>
  /html5-dash    bare <video><source src=...mpd type=application/dash+xml>
  /hlsjs         <video> + hls.js loadSource('...m3u8')
  /progressive   <video><source src=...mp4 type=video/mp4>
  /none          a page with NO player (negative control -- must NOT match)
  /              an index linking all of the above

The media URLs point at RFC-2606 example.invalid / .test hosts so nothing is
fetchable and no real endpoint is implied. Pair with bd-recognizer-drift:
  bd-fixture-serve &                       # serve on :8899
  bd-recognizer-drift --url http://127.0.0.1:8899/jwplayer

Usage:
  bd-fixture-serve [--port 8899] [--once]   # --once serves a single request set then exits
Stdlib only (http.server). Read-only; serves synthetic HTML, no state.
"""
import argparse
import http.server
import socketserver
import sys

# All media targets use RFC-2606 reserved names -> unfetchable, no real endpoint.
_M3U8 = "https://cdn.example.invalid/stream/master.m3u8"
_MPD = "https://cdn.example.invalid/stream/manifest.mpd"
_MP4 = "https://cdn.example.invalid/stream/video-720p.mp4"

PAGES = {
    "/jwplayer": f"""<!doctype html><html><head><title>jwplayer fixture</title>
<script src="https://cdn.example.invalid/jwplayer.js"></script></head>
<body><div id="player"></div>
<script>
jwplayer("player").setup({{
  playlist: [{{ sources: [
    {{ file: "{_M3U8}", label: "auto" }},
    {{ file: "{_MP4}", label: "720p" }}
  ] }}]
}});
</script></body></html>""",

    "/videojs": f"""<!doctype html><html><head><title>video.js fixture</title>
<link href="https://cdn.example.invalid/video-js.css" rel="stylesheet"></head>
<body><video-js id="v" class="video-js" controls
  data-setup='{{"sources":[{{"src":"{_M3U8}","type":"application/x-mpegURL"}}]}}'>
</video-js>
<script src="https://cdn.example.invalid/video.min.js"></script></body></html>""",

    "/html5-hls": f"""<!doctype html><html><head><title>html5 hls fixture</title></head>
<body><video controls>
  <source src="{_M3U8}" type="application/x-mpegURL">
</video></body></html>""",

    "/html5-dash": f"""<!doctype html><html><head><title>html5 dash fixture</title></head>
<body><video controls>
  <source src="{_MPD}" type="application/dash+xml">
</video></body></html>""",

    "/hlsjs": f"""<!doctype html><html><head><title>hls.js fixture</title>
<script src="https://cdn.example.invalid/hls.min.js"></script></head>
<body><video id="v" controls></video>
<script>
var hls = new Hls();
hls.loadSource("{_M3U8}");
hls.attachMedia(document.getElementById("v"));
</script></body></html>""",

    "/progressive": f"""<!doctype html><html><head><title>progressive fixture</title></head>
<body><video controls>
  <source src="{_MP4}" type="video/mp4">
</video></body></html>""",

    "/none": """<!doctype html><html><head><title>no player fixture</title></head>
<body><h1>Just an article</h1><p>No video player on this page. Negative control:
a recognizer must NOT fire here.</p></body></html>""",
}


def _index():
    links = "\n".join(f'<li><a href="{p}">{p}</a></li>' for p in sorted(PAGES))
    return (f"<!doctype html><html><head><title>BD fixture sites</title></head>"
            f"<body><h1>Synthetic player-embed fixtures</h1><ul>{links}</ul>"
            f"<p>Content-free; media URLs are RFC-2606 example.invalid. For "
            f"recognizer seam testing headless, no real site involved.</p>"
            f"</body></html>")


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):  # quiet
        pass

    def do_GET(self):
        path = self.path.split("?")[0].rstrip("/") or "/"
        if path == "/":
            body = _index()
        elif path in PAGES:
            body = PAGES[path]
        else:
            self.send_response(404)
            self.end_headers()
            self.wfile.write(b"not a fixture")
            return
        data = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def selftest():
    """SKIP: this tool needs a bound HTTP port, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs a bound HTTP port")
    print("SELFTEST PASS")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8899)
    ap.add_argument("--once", action="store_true",
                    help="handle a single request then exit (for a scripted probe)")
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args(argv)
    if a.selftest:
        return selftest()
    with socketserver.TCPServer(("127.0.0.1", a.port), Handler) as srv:
        srv.allow_reuse_address = True
        print(f"bd-fixture-serve: http://127.0.0.1:{a.port}/  "
              f"({len(PAGES)} fixtures + index)")
        print(f"  pages: {', '.join(sorted(PAGES))}")
        sys.stdout.flush()
        if a.once:
            srv.handle_request()
        else:
            srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
