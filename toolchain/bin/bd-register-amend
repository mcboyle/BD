#!/usr/bin/env python3
"""Atomically amend one canonical-register row with a guarded JSON request."""

from __future__ import annotations

import argparse
from collections.abc import Callable
from contextlib import contextmanager
import fcntl
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import tempfile
from typing import Any


_HEADER = re.compile(
    r"<!-- canonical-task-register schema=1 rows=\d+ open=\d+ "
    r"ids-sha256=[0-9a-f]{64} -->"
)
_REQUEST_KEYS = {
    "schema",
    "row",
    "expected_status",
    "expected_row_sha256",
    "find",
    "replace",
}
_SHA256 = re.compile(r"[0-9a-f]{64}\Z")


class _PostReplaceOperationError(OSError):
    """One or more named finalization operations failed."""

    def __init__(self, failures: list[tuple[str, Exception]]) -> None:
        self.failures = failures
        super().__init__(
            "; ".join(f"{operation}: {error}" for operation, error in failures)
        )


class CommitDurabilityUncertainError(RuntimeError):
    """The replacement is visible but its finalization did not fully succeed."""

    def __init__(self, operation: str, error: Exception) -> None:
        super().__init__(
            "COMMIT UNCERTAIN: the amended register was published, but "
            f"{operation} failed: {error}. Inspect the register before retrying."
        )


def _derive_backlog(repo: Path, text: str) -> tuple[int, int, str, list[str]]:
    source = repo / "project-knowledge" / "build_current_overlay.py"
    spec = importlib.util.spec_from_file_location("_bd_current_overlay", source)
    if spec is None or spec.loader is None:
        raise ValueError(f"cannot load canonical register parser from {source}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    result = module.derive_backlog(text)
    if result is None:
        raise ValueError("canonical register parser examined zero rows")
    return result


def _marker(rows: int, opened: int, digest: str) -> str:
    return (
        f"<!-- canonical-task-register schema=1 rows={rows} open={opened} "
        f"ids-sha256={digest} -->"
    )


def _assert_canonical_header(repo: Path, text: str) -> None:
    matches = list(_HEADER.finditer(text))
    if len(matches) != 1:
        raise ValueError("canonical register header occurs other than once")
    rows, opened, digest, _ = _derive_backlog(repo, text)
    if matches[0].group(0) != _marker(rows, opened, digest):
        raise ValueError("canonical register header does not match derived table")


def _ascii_field(payload: dict[str, Any], name: str) -> str:
    value = payload.get(name)
    if not isinstance(value, str):
        raise ValueError(f"request {name} must be a string")
    try:
        value.encode("ascii")
    except UnicodeEncodeError as exc:
        raise ValueError(f"request {name} must be ASCII text without newline or pipe") from exc
    if not value or "\n" in value or "\r" in value or "|" in value:
        raise ValueError(f"request {name} must be ASCII text without newline or pipe")
    return value


def _load_request(path: Path) -> dict[str, Any]:
    try:
        raw = path.read_bytes().decode("ascii")
        payload = json.loads(raw)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("request must be an ASCII JSON object") from exc
    if not isinstance(payload, dict) or set(payload) != _REQUEST_KEYS:
        raise ValueError("request must use exactly the bd-register-amend/v1 schema")
    if payload.get("schema") != "bd-register-amend/v1":
        raise ValueError("request schema must be bd-register-amend/v1")
    row = payload.get("row")
    if not isinstance(row, int) or isinstance(row, bool) or row <= 0:
        raise ValueError("request row must be a positive integer")
    status = _ascii_field(payload, "expected_status")
    find = _ascii_field(payload, "find")
    replacement = _ascii_field(payload, "replace")
    if find == replacement:
        raise ValueError("request find and replace must differ")
    expected_hash = payload.get("expected_row_sha256")
    if not isinstance(expected_hash, str) or _SHA256.fullmatch(expected_hash) is None:
        raise ValueError("request expected_row_sha256 must be lowercase SHA-256")
    return {
        "row": row,
        "expected_status": status,
        "expected_row_sha256": expected_hash,
        "find": find,
        "replace": replacement,
    }


def _row_status(row: int, physical_row: str) -> str:
    match = re.fullmatch(rf"\|\s*{row}\s*\|\s*([^|]+?)\s*\|.*", physical_row)
    if match is None:
        raise ValueError("target physical row is malformed")
    return match.group(1).strip()


def _single_physical_row(text: str, row: int) -> tuple[str, int, int]:
    pattern = re.compile(rf"^\|\s*{row}\s*\|[^\r\n]*$", re.MULTILINE)
    matches = list(pattern.finditer(text))
    if len(matches) != 1:
        raise ValueError(f"row {row} occurs {len(matches)} times in the register")
    match = matches[0]
    return match.group(0), match.start(), match.end()


def _atomic_replace(
    path: Path,
    data: bytes,
    mode: int,
    mark_published: Callable[[], None],
) -> None:
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(name)
    replaced = False
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        replaced = True
        mark_published()
        try:
            directory_fd = os.open(
                path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
            )
        except Exception as exc:
            raise _PostReplaceOperationError([("directory open", exc)]) from exc
        failures: list[tuple[str, Exception]] = []
        try:
            try:
                os.fsync(directory_fd)
            except Exception as exc:
                failures.append(("directory fsync", exc))
        finally:
            try:
                os.close(directory_fd)
            except Exception as exc:
                failures.append(("directory close", exc))
        if failures:
            raise _PostReplaceOperationError(failures) from failures[0][1]
    finally:
        if not replaced:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


@contextmanager
def _exclusive_register_lock(directory: Path):
    """Serialize CAS operations on the stable register directory inode."""
    descriptor = os.open(
        directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    )
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        failures: list[tuple[str, Exception]] = []
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        except Exception as exc:
            failures.append(("lock unlock", exc))
        try:
            os.close(descriptor)
        except Exception as exc:
            failures.append(("lock close", exc))
        if failures:
            raise _PostReplaceOperationError(failures) from failures[0][1]


def amend(repo: Path, request_path: Path) -> int:
    request = _load_request(request_path)
    register = repo / "project-knowledge" / "IMPROVEMENT_BACKLOG.md"
    published = False

    def mark_published() -> None:
        nonlocal published
        published = True

    try:
        with _exclusive_register_lock(register.parent):
            original = register.read_bytes()
            try:
                text = original.decode("ascii")
            except UnicodeDecodeError as exc:
                raise ValueError("canonical register is not ASCII") from exc
            _assert_canonical_header(repo, text)

            row = int(request["row"])
            old_row, row_start, row_end = _single_physical_row(text, row)
            if _row_status(row, old_row) != request["expected_status"]:
                raise ValueError("compare-and-swap status mismatch")
            actual_hash = hashlib.sha256(old_row.encode("ascii")).hexdigest()
            if actual_hash != request["expected_row_sha256"]:
                raise ValueError("compare-and-swap whole-row SHA-256 mismatch")
            if old_row.count(request["find"]) != 1:
                raise ValueError(
                    "compare-and-swap find text must occur exactly once in target row"
                )
            new_row = old_row.replace(request["find"], request["replace"], 1)
            if _row_status(row, new_row) != request["expected_status"]:
                raise ValueError("amendment may not change the target row status")

            expected_amended = text[:row_start] + new_row + text[row_end:]
            amended = expected_amended
            rows, opened, digest, _ = _derive_backlog(repo, amended)
            amended = _HEADER.sub(_marker(rows, opened, digest), amended, count=1)
            _assert_canonical_header(repo, amended)

            normalized_expected = _HEADER.sub(
                "<canonical-header>", expected_amended, count=1
            )
            normalized_amended = _HEADER.sub(
                "<canonical-header>", amended, count=1
            )
            if normalized_amended != normalized_expected:
                raise ValueError(
                    "amendment would change a physical row other than the target"
                )

            _atomic_replace(
                register,
                amended.encode("ascii"),
                stat.S_IMODE(register.stat().st_mode),
                mark_published,
            )
        print(f"row {row} amended; canonical header verified")
    except CommitDurabilityUncertainError:
        raise
    except Exception as exc:
        if published:
            operation = "post-replace finalization"
            if isinstance(exc, _PostReplaceOperationError):
                operation = " and ".join(
                    operation for operation, _ in exc.failures
                )
            raise CommitDurabilityUncertainError(operation, exc) from exc
        raise
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True, type=Path)
    parser.add_argument("--request", required=True, type=Path)
    args = parser.parse_args()
    try:
        return amend(args.repo.resolve(), args.request.resolve())
    except CommitDurabilityUncertainError as exc:
        print(str(exc), file=os.sys.stderr)
        return 3
    except (OSError, ValueError) as exc:
        print(str(exc), file=os.sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
