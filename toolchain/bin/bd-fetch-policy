#!/usr/bin/env python3
"""bd-fetch-policy -- the ONE canonical outbound-fetch policy + conformance check.

--emit prints a self-contained fetch_policy.py (safe_fetch wrapper: scheme
allowlist, public-host requirement with the bd-url-classify rules inlined,
timeout floor, redirect cap, optional proxy/VPN hook, fail-closed). The output
is ast.parse-verified before printing (the bd-bump lesson). --check reports
which existing fetch sinks conform (go through the wrapper) vs raw vs partial.
This is the target bd-fetch-migration migrates toward. Read-only.

Usage:
    bd-fetch-policy --emit
    bd-fetch-policy --check [--work DIR] [--json]
    bd-fetch-policy --selftest
Exit 0 (advisory).
"""
import argparse
import ast
import os
import re
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

POLICY_MODULE = '''\
"""fetch_policy -- canonical outbound-fetch policy for BulkDownloader.

Generated by bd-fetch-policy --emit. Self-contained, stdlib-only. All outbound
HTTP in the app should route through safe_fetch(); everything else is a raw
sink that bd-fetch-policy --check / bd-host-guard will flag.
"""
import ipaddress
import socket
import urllib.request
import urllib.error
from urllib.parse import urlsplit

POLICY = {
    "allowed_schemes": ("http", "https"),
    "require_public_host": True,
    "resolve_dns": True,        # DNS-rebind aware: every resolved IP must be public
    "timeout_floor": 5.0,       # seconds; never fetch with less
    "timeout_default": 15.0,
    "redirect_cap": 3,
    "vpn_required": False,      # when True, proxy_url must be set (fail-closed)
    "proxy_url": None,
    "fail_closed": True,
}

_METADATA_IPS = {"169.254.169.254", "fd00:ec2::254"}
_METADATA_HOSTS = {"metadata.google.internal"}


class FetchPolicyError(Exception):
    """Raised when a URL or fetch configuration violates POLICY."""


def _ip_blocked(ip_str):
    try:
        ip = ipaddress.ip_address(ip_str)
    except ValueError:
        return "unparseable"
    if ip_str in _METADATA_IPS or ip.exploded in _METADATA_IPS:
        return "metadata"
    if ip.is_loopback or ip.is_link_local or ip.is_private:
        return "private/loopback/link-local"
    if ip.is_multicast or ip.is_reserved or ip.is_unspecified:
        return "special"
    return None


def _canonical_ipv4(host):
    """Canonicalize lenient/encoded IPv4 (127.1, decimal, hex, octal) that
    strict ipaddress rejects but the resolver accepts. None if not encoded."""
    import re as _re
    if not _re.match(r"^[0-9xXoO.]+$", host):
        return None
    try:
        return ipaddress.IPv4Address(socket.inet_aton(host))
    except OSError:
        return None


def validate_url(url, resolve_dns=None):
    """Raise FetchPolicyError unless url is a policy-conforming public target."""
    parts = urlsplit(url)
    if parts.scheme.lower() not in POLICY["allowed_schemes"]:
        raise FetchPolicyError("scheme not allowed: %r" % parts.scheme)
    host = parts.hostname
    if not host:
        raise FetchPolicyError("empty host")
    if parts.username is not None:
        raise FetchPolicyError("userinfo in URL (SSRF obfuscation)")
    h = host.lower().rstrip(".")
    if h in _METADATA_HOSTS or h == "localhost" or h.endswith(".localhost") \\
            or h.endswith(".internal") or h.endswith(".local"):
        raise FetchPolicyError("non-public hostname: %r" % host)
    try:
        ipaddress.ip_address(host)
        why = _ip_blocked(host)
        if why:
            raise FetchPolicyError("blocked literal IP (%s): %r" % (why, host))
        return url  # public literal IP
    except ValueError:
        pass  # hostname; optionally resolve
    enc = _canonical_ipv4(host)
    if enc is not None:
        why = _ip_blocked(str(enc))
        if why:
            raise FetchPolicyError(
                "blocked encoded IPv4 %r -> %s (%s)" % (host, enc, why))
        return url  # public encoded IP
    if POLICY["require_public_host"] and (POLICY["resolve_dns"] if resolve_dns is None else resolve_dns):
        try:
            infos = socket.getaddrinfo(h, parts.port or 80, proto=socket.IPPROTO_TCP)
        except OSError as e:
            raise FetchPolicyError("DNS resolution failed (fail-closed): %s" % e)
        for info in infos:
            why = _ip_blocked(info[4][0])
            if why:
                raise FetchPolicyError(
                    "resolves to blocked address %s (%s)" % (info[4][0], why))
    return url


class _CappedRedirects(urllib.request.HTTPRedirectHandler):
    def __init__(self, cap):
        self._cap = cap
        self._seen = 0

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        self._seen += 1
        if self._seen > self._cap:
            raise FetchPolicyError("redirect cap exceeded (%d)" % self._cap)
        validate_url(newurl)  # every hop must re-validate (rebind/downgrade)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def safe_fetch(url, timeout=None, method="GET", data=None, headers=None):
    """Policy-enforcing fetch. Raises FetchPolicyError on any violation."""
    validate_url(url)
    if POLICY["vpn_required"] and not POLICY["proxy_url"]:
        raise FetchPolicyError("vpn_required but no proxy configured (fail-closed)")
    t = POLICY["timeout_default"] if timeout is None else timeout
    if t < POLICY["timeout_floor"]:
        t = POLICY["timeout_floor"]
    handlers = [_CappedRedirects(POLICY["redirect_cap"])]
    if POLICY["proxy_url"]:
        handlers.append(urllib.request.ProxyHandler(
            {"http": POLICY["proxy_url"], "https": POLICY["proxy_url"]}))
    opener = urllib.request.build_opener(*handlers)
    req = urllib.request.Request(url, data=data, headers=headers or {}, method=method)
    return opener.open(req, timeout=t)
'''

WRAPPER_RE = re.compile(r'\bsafe_fetch\s*\(')
IMPORT_POLICY_RE = re.compile(r'\bfetch_policy\b|\bfrom\s+\S*fetch_policy\s+import\b')


def emit_module():
    ast.parse(POLICY_MODULE)  # verify-after-write: never print unparseable code
    return POLICY_MODULE


def check(work):
    rows = []
    for r in sec.enumerate_fetch_sinks(work, strict=True, label="--work/--tree"):
        imports_policy = bool(IMPORT_POLICY_RE.search(r["text"]))
        conforming = raw = 0
        for lineno, line in r["fetches"]:
            if WRAPPER_RE.search(line):
                conforming += 1
            else:
                raw += 1
        status = ("conforming" if raw == 0 and conforming > 0 else
                  "partial" if imports_policy or conforming > 0 else "raw")
        rows.append({"file": r["rel"], "status": status,
                     "conforming": conforming, "raw": raw})
    total = sum(x["conforming"] + x["raw"] for x in rows) or 1
    conf = sum(x["conforming"] for x in rows)
    return rows, conf, total


def selftest():
    ok = True
    # 1. emitted module parses + enforces the url-classify negative-control table
    src = emit_module()
    ns = {}
    exec(compile(src, "fetch_policy.py", "exec"), ns)
    validate_url, Err = ns["validate_url"], ns["FetchPolicyError"]
    table_block = ["http://169.254.169.254/latest", "http://127.0.0.1:5555/",
                   "http://[::1]/", "http://10.0.70.20/", "http://[fd00:ec2::254]/",
                   "ftp://example.com/", "http://metadata.google.internal/",
                   "http://a:b@example.com/", "http://svc.internal/"]
    for u in table_block:
        try:
            validate_url(u, resolve_dns=False)
            print(f"FAIL  emitted policy allows {u}")
            ok = False
        except Err:
            print(f"PASS  emitted policy blocks {u}")
    try:
        validate_url("https://example.com/", resolve_dns=False)
        print("PASS  emitted policy allows https://example.com/ (offline)")
    except Err as e:
        print(f"FAIL  emitted policy blocks public URL: {e}")
        ok = False
    # 2. --check math on a 2-sink fixture: 1 conforming
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bulk_downloader")
        os.makedirs(b)
        open(os.path.join(b, "conf.py"), "w").write(
            "from bulk_downloader.fetch_policy import safe_fetch\n"
            "def f(u):\n    return safe_fetch(u)  # requests.get replaced\n")
        open(os.path.join(b, "raw.py"), "w").write(
            "import requests\n"
            "def f(u):\n    return requests.get(u)\n")
        rows, conf, total = check(d)
    good = conf == 1 and total == 2 and \
        {x["status"] for x in rows} == {"conforming", "raw"}
    print(("PASS" if good else "FAIL") +
          f"  fixture conformance math (conf={conf}/total={total}, "
          f"statuses={sorted(x['status'] for x in rows)})")
    ok &= good
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--emit", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if a.emit:
        sys.stdout.write(emit_module())
        return 0
    # default = --check
    rows, conf, total = check(a.work)
    pct = 100.0 * conf / total
    if sec.emit({"sinks": rows, "summary": {"conforming": conf, "total": total,
                 "conformance_pct": round(pct, 1)}}, as_json=a.json):
        return 0
    for x in sorted(rows, key=lambda r: (r["status"] != "raw", r["file"]))[:40]:
        tag = {"raw": R + "raw       " + RST, "partial": Y + "partial   " + RST,
               "conforming": G + "conforming" + RST}[x["status"]]
        print(f"  {tag} {x['file']}  {DIM}({x['conforming']} wrapped, {x['raw']} raw){RST}")
    print(f"{DIM}conformance: {conf}/{total} fetch sites ({pct:.1f}%) route through safe_fetch{RST}")
    return 0


sys.exit(main())
