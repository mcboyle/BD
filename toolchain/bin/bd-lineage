#!/usr/bin/env python3
"""bd-lineage -- track feature lineage across versions.

For a feature keyword, builds a lineage timeline from the CHANGELOG: the version
it was INTRODUCED (first mention), each version it CHANGED, and whether it has
test coverage now + is referenced in current source (still live vs abandoned).
The "when did this feature come in and is it still real" tracker. Read-only.

Usage: bd-lineage FEATURE [--work DIR] [--json] [--selftest]
Exit 0 lineage traced / 1 no --feature given (usage guard). Informational.
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def trace(feature, work):
    versions=[]
    ch=os.path.join(work,"CHANGELOG.md")
    if os.path.exists(ch):
        cur=None
        for line in open(ch,errors="ignore"):
            vm=re.match(r'##\s*v?([0-9.]+)',line.strip())
            if vm: cur=vm.group(1)
            elif feature.lower() in line.lower() and cur:
                versions.append(cur)
    versions=sorted(set(versions),key=lambda v:[int(x) for x in v.split(".")])
    # current liveness
    live=False; tested=False
    for _p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        if feature.lower() in txt.lower(): live=True; break
    for f in glob.glob(os.path.join(work,"tests","**","*.py"),recursive=True):
        if feature.lower() in os.path.basename(f).lower() or feature.lower() in open(f,errors="ignore").read().lower():
            tested=True; break
    return {"feature":feature,"introduced":versions[0] if versions else None,
            "changed_in":versions,"mentions":len(versions),"live_in_source":live,"tested":tested}

def selftest():
    ok=True
    r=trace("capture",sec.DEFAULT_WORK)
    print(("PASS" if r["mentions"]>=0 else "FAIL")+"  lineage traced (introduced=%s, %d versions)"%(r["introduced"],r["mentions"]))
    print(("PASS" if isinstance(r["live_in_source"],bool) else "FAIL")+"  liveness computed (live=%s tested=%s)"%(r["live_in_source"],r["tested"]))
    ok=ok and isinstance(r["live_in_source"],bool)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("feature",nargs="?"); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    if not a.feature: print(R+"FEATURE required"+RST); return 1
    r=trace(a.feature,a.work)
    if sec.emit(r,as_json=a.json): return 0
    print("lineage of '%s':"%a.feature)
    print("  introduced: %s | changed in %d version(s): %s"%(r["introduced"],r["mentions"],", ".join(r["changed_in"][-6:])))
    print("  live in source: %s%s%s | tested: %s%s%s"%(G if r["live_in_source"] else R,r["live_in_source"],RST,G if r["tested"] else Y,r["tested"],RST))
    return 0

if __name__ == "__main__":
    sys.exit(main())
