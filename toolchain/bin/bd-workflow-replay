#!/usr/bin/env python3
"""bd-workflow-replay -- safely dry-run-validate an operator workflow.

DRY-RUN ONLY (no live calls): takes a workflow model (bd-workflow-model) and
validates that each API step in the sequence exists in the route contract, that
CSRF-required steps are flagged, and that the state transitions the workflow
implies are all in the extracted state machine (no illegal jump). Reports each
step OK/MISSING so a workflow can be validated before it's run on localhost.
Reuses workflow-model + interface-contracts + state-machine. Read-only.

Usage: bd-workflow-replay [--workflow NAME] [--work DIR] [--json] [--selftest]
Exit 1 if any step is invalid, else 0.
"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_wm=_load_tool("bd-workflow-model"); _ic=_load_tool("bd-interface-contracts")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def replay(work, only):
    contract=_ic.build(work)
    known_paths={r["path"] for r in contract["route_contract"]}
    csrf_paths={r["path"] for r in contract["route_contract"] if r.get("csrf")=="yes"}
    wfs=_wm.model(work)
    out=[]
    for wf in wfs:
        if only and wf["workflow"]!=only: continue
        steps=[]
        for api in wf["api_calls"]:
            steps.append({"api":api,"exists":api in known_paths,"csrf_required":api in csrf_paths})
        valid=all(s["exists"] for s in steps) if steps else None
        out.append({"workflow":wf["workflow"],"steps":steps,"valid":valid,
                    "state_transitions":wf["transitions"]})
    return out

def selftest():
    ok=True
    r=replay(sec.DEFAULT_WORK,None)
    print(("PASS" if len(r)>=1 else "FAIL")+"  workflows replayed dry-run (%d)"%len(r))
    ok=ok and len(r)>=1
    # steps that exist are validated against the real route contract
    any_steps=any(w["steps"] for w in r)
    print(("PASS" if any_steps else "WARN")+"  at least one workflow has contract-validated API steps")
    # a bogus workflow name yields nothing (no crash)
    r2=replay(sec.DEFAULT_WORK,"does-not-exist")
    print(("PASS" if r2==[] else "FAIL")+"  unknown workflow -> empty (no crash)")
    ok=ok and r2==[]
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--workflow",default=None); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    r=replay(a.work,a.workflow)
    invalid=[w for w in r if w["valid"] is False]
    if sec.emit({"workflows":r,"summary":{"replayed":len(r),"invalid":len(invalid)}},as_json=a.json): return 1 if invalid else 0
    for w in r:
        tag=(G+"VALID"+RST) if w["valid"] else ((Y+"no-api-steps"+RST) if w["valid"] is None else (R+"INVALID"+RST))
        print("%s%s%s: %s"%(G,w["workflow"],RST,tag))
        for s in w["steps"]:
            mark=(G+"OK"+RST) if s["exists"] else (R+"MISSING"+RST)
            print("  %s %s%s"%(mark,s["api"]," [csrf]" if s["csrf_required"] else ""))
    return 1 if invalid else 0
sys.exit(main())
