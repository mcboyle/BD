#!/usr/bin/env python3
"""bd-trust-score -- score release confidence (0-100) from evidence.

Weighted score over: guards match (25), version honest (15), invariants hold
(20), validation GREEN / 0-fail (25), tree parses (15). Reads bd-proof-ledger +
bd-invariant-engine. A transparent rubric, not a black box -- prints the
per-factor contribution. Read-only.

Usage: bd-trust-score [--home DIR] [--work DIR] [--json] [--selftest]
--home defaults to $HOME. It supplies the STATE-derived ledger, which is
RETIRED along with the release zip (CLAUDE.md s7), so on a git checkout
bd-proof-ledger has nothing to hand over and the score is CANNOT-EVALUATE(2) --
correct: a score minted from a missing ledger would silently be 25-50 points
low and still look like a verdict. --home at a preserved bundle still scores.
Exit 0 = scored a single, verified tree at or above --threshold;
1 = scored, below --threshold; 2 = CANNOT-EVALUATE (absent tree, absent
bundle, or a CROSS-TREE blend). A score minted from two trees, or from
none, is not a score.
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def _tool_json(tool, *args):
    """Delegates to the ONE implementation. A dependency that could not be
    consulted refuses the score outright -- it does not quietly become {} and
    take 20 points off while still looking like a real verdict."""
    data, err = sec.tool_json(tool, *args)
    if err:
        sys.stderr.write("CANNOT-EVALUATE trust score: reason=DEP_FAILED (%s)\n" % err)
        sys.exit(sec.EXIT_CANNOT_EVALUATE)
    return data

def score(home, work):
    ledger=_tool_json("bd-proof-ledger","--home",home) or {}
    inv=_tool_json("bd-invariant-engine","--work",work,"--home",home) or {}
    invmap={i["invariant"]:i["holds"] for i in inv.get("invariants",[])}
    factors=[]
    def add(name,ok,pts): factors.append({"factor":name,"ok":bool(ok),"points":pts if ok else 0,"max":pts})
    add("guards_match", ledger.get("guards",{}).get("count")==7, 25)
    add("version_honest", invmap.get("VERSION-HONEST",False), 15)
    add("invariants_hold", inv.get("summary",{}).get("violated",1)==0, 20)
    val=str(ledger.get("validation") or "")
    green="0 fail" in val or "/ 0 fail" in val or re.search(r'0\s*fail',val)
    add("validation_green", bool(green), 25)
    add("tree_parses", invmap.get("TREE-PARSES",False), 15)
    total=sum(f["points"] for f in factors)
    return {"version":ledger.get("version"),"score":total,"factors":factors}

def selftest():
    ok=True
    unevaluable=False
    # The scoring path needs a STATE-derived ledger. Where none exists (a git
    # checkout: the bundle world is retired) the tool's own _tool_json exits 2,
    # which used to abort the WHOLE selftest at line 1 -- so the three NEG
    # controls below, which need no bundle at all, never ran and the tool's
    # exit contract went unverified. Catch the refusal, SAY it was skipped, and
    # go on: an unevaluable factor is not a reason to leave everything else
    # unmeasured. The final rc is still 2, not 0.
    try:
        s=score(os.path.expanduser("~"), sec.DEFAULT_WORK)
    except SystemExit as e:
        unevaluable=True
        print("SKIP  scoring assertions: no STATE-derived ledger under $HOME "
              "(rc=%s) -- the bundle world is retired; the NEG controls below "
              "do not need one"%getattr(e,"code",None))
        s=None
    if s is not None:
        print(("PASS" if 0<=s["score"]<=100 else "FAIL")+"  score in range (%d)"%s["score"])
        ok=ok and 0<=s["score"]<=100
        print(("PASS" if s["score"]>=80 else "WARN")+"  pristine tree scores high (%d)"%s["score"])
        ok=ok and s["score"]>=80
        print(("PASS" if len(s["factors"])==5 else "FAIL")+"  5 transparent factors")
        ok=ok and len(s["factors"])==5

    # I-4: the selftest asserted ONLY the happy path. The cross-tree assertion and
    # the 0/1/2 contract are real and working -- but nothing encoded them, which is
    # the C-7 shape (a celebrated property verified by hand and never written down).
    # These run the real CLI so they test the exit CONTRACT, not just the function.
    import subprocess as _sp, tempfile as _tf, os as _o, shutil as _sh, sys as _sy
    exe=_o.path.realpath(__file__)

    def _rc(*args):
        return _sp.run([_sy.executable, exe, *args],
                       capture_output=True, text=True, timeout=180).returncode

    # NEG 1: CROSS-TREE -- a well-shaped tree declaring a DIFFERENT version than the
    # bundle must refuse (2). A score about one tree labelled with another's version
    # is the F-1 headline.
    d=_tf.mkdtemp(prefix="ts_xtree_")
    _o.makedirs(_o.path.join(d,"bulk_downloader"))
    open(_o.path.join(d,"bulk_downloader","__init__.py"),"w").write('__version__ = "9.9.9"\n')
    open(_o.path.join(d,"bulk_downloader","m.py"),"w").write("x = 1\n")
    rc_x=_rc("--work",d)
    print(("PASS" if rc_x==2 else "FAIL")+"  NEG: cross-tree (9.9.9 vs bundle) -> CANNOT-EVALUATE 2 (got %d)"%rc_x)
    ok=ok and rc_x==2
    _sh.rmtree(d,ignore_errors=True)

    # NEG 2: GUTTED -- a tree with no package at all must refuse (2), never score it.
    d2=_tf.mkdtemp(prefix="ts_gutted_")
    rc_g=_rc("--work",d2)
    print(("PASS" if rc_g==2 else "FAIL")+"  NEG: gutted tree -> CANNOT-EVALUATE 2 (got %d)"%rc_g)
    ok=ok and rc_g==2
    _sh.rmtree(d2,ignore_errors=True)

    # NEG 3: THRESHOLD -- a scorer that cannot fail is decoration (I-2). This
    # one DOES need a scoreable bundle: with no ledger the run refuses (2)
    # before any threshold is applied, so asserting 1 there would be asserting
    # against a hole. Skipped, and said so, rather than quietly reinterpreted.
    if not unevaluable:
        rc_t=_rc("--threshold","101")
        print(("PASS" if rc_t==1 else "FAIL")+"  NEG: below --threshold -> 1 (got %d)"%rc_t)
        ok=ok and rc_t==1
    else:
        print("SKIP  NEG: --threshold seam needs a scoreable bundle")

    if unevaluable:
        print("SELFTEST CANNOT-EVALUATE" if ok else "SELFTEST FAIL")
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=%s (no STATE-derived "
                         "ledger; scoring assertions unmeasured)\n"%sec.REASON_ABSENT)
        return sec.EXIT_CANNOT_EVALUATE if ok else 1
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--home",default=os.path.expanduser("~")); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    ap.add_argument("--threshold",type=int,default=0,
                    help="exit 1 if the score is below this (default 0 = report only)")
    a=ap.parse_args()
    if a.selftest: return selftest()
    files=sec.require_source_tree(a.work)
    sec.require_bundle(a.home)
    # A verdict assembled from two trees is not a verdict. --home supplies the
    # version label and the other tools' output; --work supplies the code. Point
    # --work at a v9.9.9 tree beside the 728 bundle and this printed a confident
    # "trust score v3.66.728: 65/100" -- a number about one tree, labelled with the
    # version of another. Corpus guards do not catch it: BOTH trees exist.
    tree_version=sec.assert_same_tree(a.home,a.work,label="trust score")
    s=score(a.home,a.work)
    s["tree_version"]=tree_version; s["files_scanned"]=len(files)
    if sec.emit(s,as_json=a.json):
        return sec.EXIT_OK if s["score"]>=a.threshold else sec.EXIT_FINDINGS
    col=G if s["score"]>=80 else (Y if s["score"]>=50 else R)
    # The denominator: a score with no stated subject IS the bug.
    print("trust score v%s: %s%d/100%s  %s(tree %s, %d files)%s"
          %(s["version"],col,s["score"],RST,DIM,tree_version,len(files),RST))
    for f in s["factors"]:
        tag=(G+"+%d"%f["points"]+RST) if f["ok"] else (R+"+0"+RST)
        print("  %s/%d  %s"%(tag,f["max"],f["factor"]))
    if s["score"]<a.threshold:
        print("%sBELOW THRESHOLD (%d < %d)%s"%(R,s["score"],a.threshold,RST))
        return sec.EXIT_FINDINGS
    return sec.EXIT_OK
sys.exit(main())
