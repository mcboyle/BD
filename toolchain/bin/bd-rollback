#!/usr/bin/env python3
"""bd-rollback -- thin wrapper over tools/rollback.py that auto-locates the tool +
the source zip so a rollback is one command. Pass-through: any extra args go to
tools/rollback.py unchanged.

It PREPARES a rollback archive; it does NOT deploy. Deploy + restart on stash stay
the human gate (see the deploy section of PROJECT_OPERATING_INSTRUCTIONS).

Usage:
    bd-rollback --archive 3.66.363                 # auto-find --from (highest zip)
    bd-rollback --archive 3.66.363 --from <zip>    # explicit source zip
    bd-rollback -- --help                          # pass --help through to rollback.py
Exit = rollback.py's exit code (2 if the tool/zip can't be located).
"""
import argparse
import glob
import os
import re
import subprocess
import sys

R, Y, DIM, RST = "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def _ver(name):
    m = re.search(r"v?(\d+)[._](\d+)[._](\d+)", os.path.basename(name))
    return tuple(int(x) for x in m.groups()) if m else (0, 0, 0)


def auto_zip():
    found = []
    for p in ("/mnt/user-data/uploads/BulkDownloader_v*.zip",
              os.path.expanduser("~/out/BulkDownloader_v*.zip")):
        found += glob.glob(p)
    found = [f for f in found if "overlay" not in os.path.basename(f).lower()]
    return max(found, key=_ver) if found else None


def find_tool(work):
    for c in (os.path.join(work, "tools", "rollback.py"),
              "/home/claude/work/tools/rollback.py"):
        if os.path.isfile(c):
            return c
    return None


def selftest():
    """SKIP: this tool needs prior release zips on disk, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs prior release zips on disk")
    print("SELFTEST PASS")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bd-rollback", add_help=True)
    ap.add_argument("--archive", help="version to roll back to, e.g. 3.66.363")
    ap.add_argument("--from", dest="frm", help="source zip (default: highest found)")
    ap.add_argument("--work","--tree", default="/home/claude/work")
    ap.add_argument("passthrough", nargs=argparse.REMAINDER,
                    help="args after -- go to tools/rollback.py")
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args(argv)
    if a.selftest:
        return selftest()

    tool = find_tool(a.work)
    if not tool:
        print(f"{R}tools/rollback.py not found{RST} under {a.work}", file=sys.stderr)
        return 2

    cmd = [sys.executable, tool]
    if a.archive:
        cmd += ["--archive", a.archive]
    frm = a.frm or auto_zip()
    if a.archive and not a.frm:
        if not frm:
            print(f"{R}no source zip found{RST} -- pass --from <zip>", file=sys.stderr)
            return 2
        print(f"{DIM}auto --from {os.path.basename(frm)}{RST}")
    if frm:
        cmd += ["--from", frm]
    extra = [x for x in a.passthrough if x != "--"]
    cmd += extra

    print(f"{Y}rollback prepares an archive; deploy/restart on stash is a separate "
          f"human step.{RST}")
    return subprocess.run(cmd, timeout=150).returncode


if __name__ == "__main__":
    sys.exit(main())
