#!/usr/bin/env python3
"""bd-doctor -- one-shot READ-ONLY sandbox triage. Answers "is anything obviously
wrong?" in one command: tools on PATH, background services up, work tree present +
its version, work-tree venv, Playwright browsers, session register present.

Never changes anything; never deploys. Exit 0 if all CRITICAL checks pass, 1 if a
critical check fails (warnings alone don't fail).

Usage:
    bd-doctor
    bd-doctor --work /path/to/checkout      # defaults to $PWD
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
from shutil import which

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

CRIT = "crit"
WARN = "warn"


def browser_pool():
    """Where Playwright actually keeps its browsers, and how we know.

    PLAYWRIGHT_BROWSERS_PATH wins: it is what playwright itself honours.
    Previously every pool lookup here globbed /home/claude/.cache/ms-playwright
    directly. The trap: /home/claude often EXISTS while that leaf does not, and
    HOME may be another user entirely, so neither an isdir() guard on the home
    dir nor expanduser finds the real pool. Only the env var does.
    """
    env = os.environ.get("PLAYWRIGHT_BROWSERS_PATH")
    if env and os.path.isdir(env):
        return env
    for cand in (os.path.join(os.path.expanduser("~"), ".cache", "ms-playwright"),
                 "/opt/pw-browsers"):
        if os.path.isdir(cand):
            return cand
    return None


def line(status, label, detail=""):
    tag = {"ok": f"{G}OK  {RST}", CRIT: f"{R}FAIL{RST}", WARN: f"{Y}WARN{RST}"}[status]
    print(f"  {tag}  {label}{(' -- ' + detail) if detail else ''}")


def proc_running(pat):
    try:
        out = subprocess.run(["pgrep", "-fa", pat], capture_output=True, text=True, timeout=150)
        return out.returncode == 0 and bool(out.stdout.strip())
    # why: input unavailable/unreadable; return the safe default (False) rather than a value derived from a failed read
    except Exception:
        return False


def selftest():
    """SKIP: this tool needs the full service venv + running services, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs the full service venv + running services")
    print("SELFTEST PASS")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bd-doctor")
    # Default to the tree we are standing in. The old default,
    # /home/claude/work, is the retired sandbox path -- it does not exist,
    # so every row derived from it reported on nothing.
    ap.add_argument("--work","--tree",
                    default=os.environ.get("BD_REPO") or os.getcwd())
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args(argv)
    if a.selftest:
        return selftest()
    crit_fail = False

    print("== bd-doctor :: read-only triage\n-- tools on PATH")
    core = ["bd", "bd-install", "bd-status"]
    extras = ["bd-preflight", "bd-state", "bd-cut", "bd-handoff", "bd-pack",
              "bd-band", "bd-ship", "bd-touched", "bd-render", "bd-verify-live",
              "bd-curl", "bd-lsp", "bd-reconcile", "bd-precut", "bd-boot"]
    for t in core:
        if which(t):
            line("ok", t)
        else:
            line(CRIT, t, "missing -- run setup.sh"); crit_fail = True
    miss_extra = [t for t in extras if not which(t)]
    if miss_extra:
        line(WARN, "optional tools", "absent: " + ", ".join(miss_extra))
    else:
        line("ok", "optional tools", f"all {len(extras)} present")

    print("-- background services (bdenv)")
    for label, pat in (("Xvfb :99", "Xvfb :99"),
                       ("apprise webhook", "fake_webhook_server.py"),
                       ("mock plex", "mock_plex.py"),
                       ("mock jellyfin", "mock_jellyfin.py"),
                       ("mock stash", "mock_stash.py")):
        if proc_running(pat):
            line("ok", label)
        else:
            line(WARN, label, "not running (bdenv starts it on first `bd`)")

    print("-- work tree")
    initp = os.path.join(a.work, "bulk_downloader", "__init__.py")
    if os.path.isfile(initp):
        m = re.search(r'__version__\s*=\s*"([0-9.]+)"', open(initp).read())
        line("ok", "work tree", f"{a.work} (v{m.group(1) if m else '?'})")
    else:
        line(CRIT, "work tree", f"no bulk_downloader/__init__.py under {a.work}")
        crit_fail = True
    fe_nm = os.path.join(a.work, "frontend", "node_modules")
    line("ok" if os.path.isdir(fe_nm) else WARN, "frontend/node_modules",
         "" if os.path.isdir(fe_nm) else "absent -- tsc/vitest/vite will fail")

    # The prestaged_site_packages row is gone: that staging layer belonged to
    # the retired sandbox and exists on no current host, so the row could only
    # ever WARN about the absence of something nobody installs. Dependencies
    # now come from the work tree venv.
    print("-- python deps")
    _venv_py = os.path.join(a.work, "venv", "bin", "python")
    line("ok" if os.path.isfile(_venv_py) else WARN, "work-tree venv",
         _venv_py if os.path.isfile(_venv_py) else f"no venv under {a.work}")
    _pool = browser_pool()
    pw = glob.glob(os.path.join(_pool, "chromium*")) if _pool else []
    line("ok" if pw else WARN, "Playwright chromium",
         f"pool {_pool}" if pw else ("no pool located" if not _pool else f"none under {_pool}"))

    print("-- task register")
    # STATE.json is RETIRED: the session-state file belonged to the zip-overlay
    # sandbox, and project-knowledge/IMPROVEMENT_BACKLOG.md is the register now. The
    # old code globbed the retired trees (/mnt/user-data, /home/claude, all of
    # /tmp) and could pick up an unrelated STATE.json left by another process --
    # a diagnostic reading someone else's fixture as this host's state. Report
    # the retirement as a FACT and check the real register instead.
    _backlog = os.path.join(a.work, "project-knowledge", "IMPROVEMENT_BACKLOG.md")
    if os.path.isfile(_backlog):
        line("ok", "task register",
             "STATE.json retired -- project-knowledge/IMPROVEMENT_BACKLOG.md present")
    else:
        line(WARN, "task register",
             f"STATE.json retired; no IMPROVEMENT_BACKLOG.md under {a.work} "
             "(not a checkout, or the register moved)")

    # -- live capabilities (egress-era; what can this sandbox actually DO?) ----
    # A session should know its real capabilities instead of assuming the old
    # "can't test browser/network" constraints. All WARN-only (informational).
    print("-- live capabilities")
    # egress
    egress = False
    try:
        import urllib.request
        urllib.request.urlopen("https://pypi.org/simple/pip/", timeout=8)
        egress = True
    except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
        pass
    line("ok" if egress else WARN, "outbound egress",
         "PyPI/npm/GitHub reachable" if egress
         else "no network (offline packs required)")
    # audit venv (bd-rev target)
    rev = None
    for c in (os.path.expanduser("~/rev"),):
        if os.path.isdir(os.path.join(c, "bin")):
            rev = c
            break
    if rev:
        sg = os.path.join(rev, "bin", "semgrep")
        line("ok", "audit venv", f"{rev}" + (" (+semgrep)" if os.path.exists(sg) else ""))
    else:
        line(WARN, "audit venv", "absent -- run bd-rev to provision (live or wheels)")
    # playwright chromium present
    _pool2 = browser_pool()
    pw_cached = bool(glob.glob(os.path.join(_pool2, "chromium*"))) if _pool2 else False
    # can it actually DRIVE a headless browser? (only test if cached + egress)
    pw_live = False
    pw_backend = "unknown"
    if pw_cached:
        # Probe the backend BD is actually configured to run. cloak.py's
        # resolve_backend() is the single source of truth for that choice;
        # launching Playwright unconditionally answers about a backend the box
        # may not use -- a friendlier wrong answer, but the same wrong
        # denominator as the paths below. cloakbrowser owns its own binary and
        # never reads PLAYWRIGHT_BROWSERS_PATH, so the two cases genuinely
        # differ. Falls back to a plain Playwright probe when the app is not
        # importable, and says so rather than implying it tested the real one.
        probe = (
            "try:\n"
            "    from bulk_downloader.cloak import resolve_backend, CLOAKBROWSER\n"
            "    backend = resolve_backend()\n"
            "except Exception:\n"
            "    backend = 'playwright'; CLOAKBROWSER = 'cloakbrowser'\n"
            "if backend == CLOAKBROWSER:\n"
            "    from bulk_downloader import cloak as _c\n"
            "    _r = _c.launch_browser(headless=True)\n"
            "    _b = _r[0] if isinstance(_r, tuple) else _r\n"
            "    _b.close()\n"
            "else:\n"
            "    from playwright.sync_api import sync_playwright\n"
            "    with sync_playwright() as p:\n"
            "        b = p.chromium.launch(headless=True); b.close()\n"
            "print('ok ' + backend)\n"
        )
        # Inherit the caller's environment. The previous version FORCED
        # PLAYWRIGHT_BROWSERS_PATH=/home/claude/.cache/ms-playwright and
        # PYTHONPATH=/tmp/prestaged_site_packages -- both retired sandbox
        # paths that no longer exist. Measured: with that env the probe exits 1
        # with Playwright's "browser not found" banner on a host where it
        # exits 0. The row reported the browser broken while it worked, which
        # is the inverse failure -- a gate firing on nothing gets switched off,
        # and takes the real signal with it. PYTHONPATH in particular is
        # REPLACED, not appended, so forcing it also removed whatever the
        # caller had arranged.
        env = dict(os.environ)
        env.setdefault("PYTHONPATH", a.work)
        if not env.get("PLAYWRIGHT_BROWSERS_PATH"):
            for _cand in (os.path.join(os.path.expanduser("~"), ".cache", "ms-playwright"),
                          "/opt/pw-browsers"):
                if os.path.isdir(_cand):
                    env["PLAYWRIGHT_BROWSERS_PATH"] = _cand
                    break
        try:
            r = subprocess.run([sys.executable, "-c", probe],
                               capture_output=True, text=True, timeout=40, env=env)
            pw_live = (r.returncode == 0 and "ok" in r.stdout)
            # The probe prints "ok <backend>". Carry the name into the row: a
            # verdict about "the headless browser" that does not say WHICH
            # backend it launched is answering a question the reader did not
            # ask, since only one of the two uses a Playwright pool at all.
            if pw_live:
                _parts = r.stdout.strip().split()
                pw_backend = _parts[1] if len(_parts) > 1 else "unknown"
        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
            pass
    if pw_live:
        line("ok", f"headless browser ({pw_backend})",
             "launches -- headless-vs-real-sites IS testable here")
    elif pw_cached:
        line(WARN, "headless browser",
             "chromium cached but launch probe failed (run under `bd`)")
    else:
        line(WARN, "headless browser", "chromium not cached")
    # display (for the interactive/noVNC flow -- still operator-gated)
    disp = os.environ.get("DISPLAY", "")
    xvfb = proc_running("Xvfb")
    line("ok" if (disp or xvfb) else WARN, "display",
         (f"DISPLAY={disp} " if disp else "") + ("Xvfb up" if xvfb else "")
         + ("  (headless automation only; noVNC/interactive-capture/real-challenge "
            "remain operator-gated -- a display != an operator session)"
            if (disp or xvfb) else " -- none (interactive capture stays operator-gated)"))

    # Tier-1 (702): STALE __pycache__ is a SILENT liar. Observed this session:
    # bulk_downloader/__init__.py said 3.66.702 while `import bulk_downloader`
    # resolved 3.66.700 -- a .pyc left behind by an overlay restore. Every version
    # gate then reported the OLD version and nothing said why. Compare the SOURCE
    # version against the IMPORTED one; they must agree.
    try:
        import re as _re, subprocess as _sp
        _w = a.work
        _src = _re.search(r'__version__\s*=\s*"([^"]+)"',
                          open(os.path.join(_w, "bulk_downloader", "__init__.py")).read()).group(1)
        _vpy = os.path.join(_w, "venv", "bin", "python")
        _imp = _sp.run([_vpy if os.path.isfile(_vpy) else sys.executable, "-c",
                        "import sys;sys.path.insert(0,'.');import bulk_downloader as b;"
                        "print(b.__version__)"],
                       cwd=_w, capture_output=True, text=True).stdout.strip()
        if _imp and _imp != _src:
            crit_fail = True
            line(CRIT, "pycache", f"source says {_src} but `import bulk_downloader` "
                                  f"resolves {_imp} -- STALE __pycache__ is lying to every "
                                  f"version gate. Fix: find . -name __pycache__ -prune "
                                  f"-exec rm -rf {{}} +")
        else:
            line("ok", "pycache", f"import resolves the source version ({_src})")
    except Exception as _e:
        line(WARN, "pycache", f"could not compare source vs imported version ({_e})")

    print(f"\n{G+'RESULT: OK'+RST if not crit_fail else R+'RESULT: CRITICAL'+RST} "
          f"-- {'no critical issues' if not crit_fail else 'a critical check failed (see FAIL above)'}")
    return 1 if crit_fail else 0


if __name__ == "__main__":
    sys.exit(main())
