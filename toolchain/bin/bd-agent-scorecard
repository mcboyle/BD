#!/usr/bin/env python3
"""bd-agent-scorecard -- score an AI session's quality.

Composite 0-100 score for a work-tree change (an AI session's output):
  scope        no guard drift, no risky text (bd-agent-watchdog clean)   40
  tested       source changes have matching test changes                 25
  invariants   all project invariants still hold                         20
  cleanliness  tree parses, no stray debug prints/TODO-XXX added         15
Transparent rubric. On a pristine tree (no change) it scores the BASELINE (100,
nothing violated). Reuses bd-agent-watchdog + bd-invariant-engine. Read-only.

Usage: bd-agent-scorecard [--work DIR] [--home DIR] [--json] [--selftest]
Exit 0 scored (and >= --threshold if given) / 1 scored, below
--threshold / 2 CANNOT-EVALUATE. Without --threshold the score is
report-only and exit stays 0.
"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_wd=_load_tool("bd-agent-watchdog"); _inv=_load_tool("bd-invariant-engine")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def score(work, home):
    wd=_wd.watchdog(work,home)
    invres=_inv.run(work,home,None)
    factors=[]
    def add(name,ok,pts): factors.append({"factor":name,"ok":bool(ok),"points":pts if ok else 0,"max":pts})
    scope_ok = "error" not in wd and not wd.get("guard_touched") and not wd.get("risky_text")
    add("scope", scope_ok, 40)
    tested_ok = "error" not in wd and not wd.get("src_without_test")
    add("tested", tested_ok, 25)
    inv_ok = all(i["holds"] for i in invres)
    add("invariants", inv_ok, 20)
    clean_ok = any(i["invariant"]=="TREE-PARSES" and i["holds"] for i in invres)
    add("cleanliness", clean_ok, 15)
    total=sum(f["points"] for f in factors)
    return {"score":total,"factors":factors,"changed_files":wd.get("total_changed")}

def selftest():
    ok=True
    s=score(sec.DEFAULT_WORK,"/home/claude")
    print(("PASS" if 0<=s["score"]<=100 else "FAIL")+"  score in range (%d)"%s["score"])
    ok=ok and 0<=s["score"]<=100
    print(("PASS" if s["score"]>=80 else "WARN")+"  pristine tree scores high (%d)"%s["score"])
    ok=ok and s["score"]>=80
    print(("PASS" if len(s["factors"])==4 else "FAIL")+"  4 transparent factors")
    ok=ok and len(s["factors"])==4
    # verdict-seam controls (I-6)
    rcs=(_verdict_rc({"score":100},None), _verdict_rc({"score":100},80),
         _verdict_rc({"score":40},80))
    print(("PASS" if rcs==(0,0,1) else "FAIL")+
          "  NEG: below --threshold -> 1; no threshold -> report-only 0 (got %s)"%(rcs,))
    ok=ok and rcs==(0,0,1)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def _verdict_rc(s, threshold):
    """0 = scored (>= threshold if one was given); 1 = below threshold.
    No threshold -> report-only, exit 0."""
    if threshold is None:
        return 0
    return 0 if s.get("score", 0) >= threshold else 1


def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--threshold",type=int,default=None)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    sec.require_bundle(a.home)
    s=score(a.work,a.home)
    if sec.emit(s,as_json=a.json): return _verdict_rc(s,a.threshold)
    col=G if s["score"]>=80 else (Y if s["score"]>=50 else R)
    print("agent session score: %s%d/100%s (%s files changed)"%(col,s["score"],RST,s["changed_files"]))
    for f in s["factors"]:
        tag=(G+"+%d"%f["points"]+RST) if f["ok"] else (R+"+0"+RST)
        print("  %s/%d  %s"%(tag,f["max"],f["factor"]))
    return _verdict_rc(s,a.threshold)

if __name__ == "__main__":
    sys.exit(main())
