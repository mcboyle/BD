#!/usr/bin/env python3
"""bd-runtime-gate -- identify runtime-only validations.

Scans tests + code for markers of validations that CANNOT run in the sandbox and
need stash/live execution: JD/Java, headed Chrome, netns/CAP_NET_ADMIN, VPN
tunnel, live site fetches, yt-dlp network, real browser launch. Reports which
test files / functions are runtime-gated so a sandbox run knows what it CAN'T
prove and must defer to stash. Read-only.

Usage: bd-runtime-gate [--work DIR] [--json] [--selftest]
Exit 0 (INFORMATIONAL -- this tool classifies runtime-gated tests; it
is not itself a gate despite the name) / 2 CANNOT-EVALUATE.
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
GATES={"java_jd":re.compile(r'(?i)jdownloader|jd_bridge|java\b'),
       "headed_chrome":re.compile(r'(?i)headless\s*=\s*False|headed|xvfb'),
       "netns":re.compile(r'(?i)netns|CAP_NET_ADMIN|ip netns'),
       "vpn":re.compile(r'(?i)vpn_required|wireguard|tunnel_up'),
       "live_site":re.compile(r'(?i)@pytest\.mark\.(?:live|network|integration)|requires_network'),
       "real_browser":re.compile(r'(?i)playwright.*launch|browser\.new_context'),
       "yt_dlp_net":re.compile(r'(?i)yt_dlp.*(?:download|extract_info)')}

def scan(work):
    import glob as _g
    rows={}
    for f in _g.glob(os.path.join(work,"tests","**","*.py"),recursive=True)+_g.glob(os.path.join(work,"tests","*.py")):
        try: txt=open(f,errors="ignore").read()
        # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
        except Exception: continue
        rel=os.path.relpath(f,work)
        gates=[g for g,rx in GATES.items() if rx.search(txt)]
        if gates: rows[rel]=gates
    counts={}
    for gates in rows.values():
        for g in gates: counts[g]=counts.get(g,0)+1
    return {"runtime_gated_tests":len(rows),"by_gate":counts,
            "files":[{"file":k,"gates":v} for k,v in sorted(rows.items())][:60]}

def selftest():
    ok=True
    r=scan(sec.DEFAULT_WORK)
    # (was: assert count >= 0 -- vacuously true for any count; asserted nothing)
    print("INFO  runtime-gated tests on the real tree: %d"%r["runtime_gated_tests"])
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        t=os.path.join(d,"tests"); os.makedirs(t)
        open(os.path.join(t,"test_x.py"),"w").write("# uses ip netns and vpn_required tunnel\n")
        s=scan(d)
    gates=set(g for f in s["files"] for g in f["gates"])
    print(("PASS" if "netns" in gates and "vpn" in gates else "FAIL")+"  synthetic netns+vpn gate detected (%s)"%sorted(gates))
    ok=ok and "netns" in gates
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    r=scan(a.work)
    if sec.emit(r,as_json=a.json): return 0
    print("%d runtime-gated test file(s) (can't prove in sandbox):"%r["runtime_gated_tests"])
    for g,n in sorted(r["by_gate"].items(),key=lambda kv:-kv[1]): print("  %s%-14s%s %d files"%(Y,g,RST,n))
    return 0

if __name__ == "__main__":
    sys.exit(main())
