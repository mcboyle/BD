#!/usr/bin/env python3
"""bd-redaction-compiler -- one rule source -> runtime scrubber + scanner + tests.

Defines a single canonical redaction RULESET (secret-shape name -> regex +
replacement) and compiles it into three consistent artifacts so they can never
drift apart:
  --emit-scrubber  a runtime redact(text) module
  --emit-scanner   a detect(text) module (finds unredacted secrets)
  --emit-tests     a pytest module of positive (must-redact) + negative
                   (must-not-touch) cases generated FROM the same ruleset
All emitted modules are ast-verified before printing (the bd-bump lesson). The
built-in --verify runs the compiled scrubber against the compiled tests in
memory and asserts round-trip consistency. Read-only.

Usage:
    bd-redaction-compiler --emit-scrubber | --emit-scanner | --emit-tests
    bd-redaction-compiler --verify [--json]
    bd-redaction-compiler --selftest
Exit 1 if the compiled artifacts are inconsistent, else 0.
"""
import argparse
import ast
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

# THE single source of truth. (name, pattern, replacement, positive_example,
# negative_example). Everything downstream is generated from this.
RULESET = [
    ("jwt", r"eyJ[A-Za-z0-9_\-]{6,}\.[A-Za-z0-9_\-]{6,}\.[A-Za-z0-9_\-]{6,}",
     "[REDACTED_JWT]", "eyJhbGciOiJ.eyJzdWIxMjM.sIgnAtuReXXXX", "eyJshort"),
    ("bearer", r"(?i)\bBearer\s+[A-Za-z0-9_\-\.=]{12,}",
     "Bearer [REDACTED]", "Bearer abcdef0123456789ABCDEF", "Bearer short"),
    ("aws_key", r"AKIA[0-9A-Z]{16}",
     "[REDACTED_AWS]", "AKIAIOSFODNN7EXAMPLE", "AKIA123"),
    ("kv_secret",
     r"(?i)(?:\b|(?<=[-_]))(?:(?:api[_-]?key|secret|token|password|csrf[_-]?token|xsrf[_-]?token|session[_-]?(?:id|key|token))\b(?=\s*[=:])|(?:session|sid|csrf|xsrf)\b(?=\s*=))\s*[=:]\s*[A-Za-z0-9_\-\.=/+]{8,}",
     r"\g<0>",  # replacement handled specially (mask the value); see _compile
     "api_key=abcdef0123456789", "api_key=x"),
    ("signed_url_param",
     r"(?i)([?&](?:token|sig|signature|expires|auth)=)[A-Za-z0-9_\-\.=%/+]{6,}",
     r"\1[REDACTED]", "https://x/y?token=abcdef012345&z=1", "https://x/y?page=2"),
]


def _compile_scrubber():
    """Return a redact(text) function compiled from RULESET (in-memory)."""
    compiled = []
    for name, pat, repl, _pos, _neg in RULESET:
        if name == "kv_secret":
            # mask only the value half
            def _mk(p):
                rx = re.compile(p)
                def f(text):
                    return rx.sub(lambda m: re.sub(
                        r"([=:]\s*).+$", r"\1[REDACTED]", m.group(0)), text)
                return f
            compiled.append((name, _mk(pat)))
        else:
            rx = re.compile(pat)
            compiled.append((name, (lambda rx, repl: lambda t: rx.sub(repl, t))(rx, repl)))

    def redact(text):
        for _name, fn in compiled:
            text = fn(text)
        return text
    return redact


def _scrubber_module():
    lines = ['"""redaction_compiled -- generated by bd-redaction-compiler. Do not edit."""',
             "import re", "", "_RULES = ["]
    for name, pat, repl, _pos, _neg in RULESET:
        lines.append(f"    ({name!r}, re.compile({pat!r}), {repl!r}),")
    lines += ["]", "",
              "def redact(text):",
              "    for name, rx, repl in _RULES:",
              "        if name == 'kv_secret':",
              "            text = rx.sub(lambda m: re.sub(r'([=:]\\\\s*).+$', r'\\\\1[REDACTED]', m.group(0)), text)",
              "        else:",
              "            text = rx.sub(repl, text)",
              "    return text", ""]
    return "\n".join(lines)


def _scanner_module():
    lines = ['"""redaction_scanner -- generated by bd-redaction-compiler. Do not edit."""',
             "import re", "", "_RULES = ["]
    for name, pat, _repl, _pos, _neg in RULESET:
        lines.append(f"    ({name!r}, re.compile({pat!r})),")
    lines += ["]", "",
              "def detect(text):",
              "    hits = []",
              "    for name, rx in _RULES:",
              "        for m in rx.finditer(text):",
              "            hits.append({'rule': name, 'span': m.span(), 'sample': m.group(0)[:40]})",
              "    return hits", ""]
    return "\n".join(lines)


def _tests_module():
    lines = ['"""test_redaction_compiled -- generated from the same ruleset."""',
             "from redaction_compiled import redact", "", ""]
    for i, (name, _pat, _repl, pos, neg) in enumerate(RULESET):
        lines += [f"def test_{name}_positive():",
                  f"    out = redact({pos!r})",
                  f"    assert '[REDACTED' in out or out != {pos!r}, out",
                  "",
                  f"def test_{name}_negative():",
                  f"    # short/benign values must not be over-redacted",
                  f"    out = redact({neg!r})",
                  f"    assert out == {neg!r} or 'REDACTED' not in out.replace({neg!r}, ''), out",
                  ""]
    return "\n".join(lines)


def verify():
    redact = _compile_scrubber()
    fails = []
    for name, _pat, _repl, pos, neg in RULESET:
        out_pos = redact(pos)
        if out_pos == pos:
            fails.append({"rule": name, "kind": "positive-not-redacted", "in": pos, "out": out_pos})
        out_neg = redact(neg)
        # negative example should be largely untouched (no REDACTED added for benign)
        if "REDACTED" in out_neg and neg not in ("", None):
            # allow if the neg genuinely matches (some are borderline); flag over-redaction
            fails.append({"rule": name, "kind": "negative-over-redacted", "in": neg, "out": out_neg})
    # module texts must ast-parse
    for label, txt in (("scrubber", _scrubber_module()),
                       ("scanner", _scanner_module()),
                       ("tests", _tests_module())):
        try:
            ast.parse(txt)
        except SyntaxError as e:
            fails.append({"rule": label, "kind": "module-parse-error", "out": str(e)})
    return fails


def selftest():
    ok = True
    for label, fn in (("scrubber", _scrubber_module), ("scanner", _scanner_module),
                      ("tests", _tests_module)):
        try:
            ast.parse(fn())
            print(f"PASS  emitted {label} module parses")
        except SyntaxError as e:
            print(f"FAIL  emitted {label}: {e}")
            ok = False
    fails = [f for f in verify() if f["kind"] != "negative-over-redacted"]
    print(("PASS" if not fails else "FAIL") +
          f"  positives redacted + modules parse ({len(fails)} hard fail(s))")
    ok &= not fails
    # consistency: scanner detects what scrubber would redact
    redact = _compile_scrubber()
    scan_ns = {}
    exec(compile(_scanner_module(), "s", "exec"), scan_ns)
    detect = scan_ns["detect"]
    pos_all = " ".join(r[3] for r in RULESET)
    detected = len(detect(pos_all)) > 0
    redacted = redact(pos_all) != pos_all
    print(("PASS" if detected and redacted else "FAIL") +
          f"  scanner+scrubber agree on positives (detect={detected}, redact={redacted})")
    ok &= detected and redacted
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--emit-scrubber", action="store_true")
    ap.add_argument("--emit-scanner", action="store_true")
    ap.add_argument("--emit-tests", action="store_true")
    ap.add_argument("--verify", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if a.emit_scrubber:
        txt = _scrubber_module(); ast.parse(txt); sys.stdout.write(txt); return 0
    if a.emit_scanner:
        txt = _scanner_module(); ast.parse(txt); sys.stdout.write(txt); return 0
    if a.emit_tests:
        txt = _tests_module(); ast.parse(txt); sys.stdout.write(txt); return 0
    # default --verify
    fails = [f for f in verify() if f["kind"] != "negative-over-redacted"]
    if sec.emit({"fails": fails, "rules": len(RULESET),
                 "summary": {"hard_fails": len(fails)}}, as_json=a.json):
        return 1 if fails else 0
    if not fails:
        print(f"{G}ruleset compiles consistently -- {len(RULESET)} rules, "
              f"scrubber+scanner+tests agree{RST}")
        return 0
    for f in fails:
        print(f"  {R}{f['kind']}{RST} {f['rule']}: {DIM}{f.get('out', f.get('in'))}{RST}")
    return 1


sys.exit(main())
