#!/usr/bin/env python3
"""bd-retest -- re-run ONLY the failed suites from the last band (flake triage).

Reads the band-results file written by bd-parband -- default
<checkout>/.bd_last_band.json, override with BD_LAST_BAND (bd-parband resolves
the SAME default/override; change one and you break the pair) -- and re-runs each
failed/timed-out suite N times. Passes on retry => FLAKE; fails every time => REAL
failure. Saves re-running the whole band to find out. Runner is inline (no fragile
cross-tool import). Suite env is inherited from os.environ (venv carries the
deps; PLAYWRIGHT_BROWSERS_PATH comes from the environment, never hardcoded).

Usage: bd-retest [--retries 2] [--timeout 300] [--work DIR]
Exit 0 if every previously-failing suite now passes; 1 on a consistent (real)
failure; 2 (CANNOT-EVALUATE) if there is no band-results file to read, or if a
row in it names a suite that no longer exists (nothing to retest -- and grading
the substituted broad run is how a real failure gets deleted as a FLAKE).
"""
import argparse, json, os, re, subprocess, sys, tempfile, time
import os as _os_bd, sys as _sys_bd  # noqa: E402
_sys_bd.path.insert(0, _os_bd.path.dirname(_os_bd.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

_PY_CACHE = {}


def _py(work):
    """The interpreter that can run this project's tests. Memoized: the probe
    spawns a subprocess and these runners call this once per suite.

    None from the resolver is FATAL, never a silent fallback -- a band under a
    deps-less interpreter reports failures that read as real defects, which is
    the v3.66.850 finding (CLAUDE.md s5).
    """
    if work not in _PY_CACHE:
        exe = sec.resolve_test_interpreter(work)
        if exe is None:
            print("BD-UNEVALUABLE: no interpreter under %s can import pytest -- "
                  "refusing to run rather than report interpreter artifacts as "
                  "test failures." % work, file=sys.stderr)
            raise SystemExit(sec.EXIT_CANNOT_EVALUATE)
        _PY_CACHE[work] = exe
    return _PY_CACHE[work]

G,R,Y,DIM,BOLD,RST="\033[32m","\033[31m","\033[33m","\033[2m","\033[1m","\033[0m"
# The bd-parband CONTRACT: both tools resolve this identically (env override,
# then checkout-relative default). Edit them together or the pair breaks.
RESULTS=os.environ.get("BD_LAST_BAND",
                       os.path.join(sec.DEFAULT_WORK, ".bd_last_band.json"))
def run_one(work,suite,timeout):
    env=dict(os.environ); env.update(BD_HOME=tempfile.mkdtemp(prefix="bdrt_"),
        BD_DISABLE_KEEPALIVE="1")
    try:
        r=subprocess.run([_py(work),"run_tests.py",suite],cwd=work,env=env,
                         capture_output=True,text=True,timeout=timeout)
        out=r.stdout+r.stderr; m=re.search(r'Failed:\s*(\d+)',out)
        failed=int(m.group(1)) if m else (0 if r.returncode==0 else -1)
        return "pass" if (r.returncode==0 and failed==0) else "fail"
    except subprocess.TimeoutExpired: return "timeout"
def selftest():
    """DELEGATE: wraps run_tests.py, which lives in the WORK TREE / PK, not in bin/. The
    selftest asserts the real target is reachable; if it is not, FAIL -- a
    wrapper that cannot find what it wraps is broken, and a selftest that cannot
    verify must not report success."""
    import os as _o
    cands = [_os_bd.path.join(sec.DEFAULT_WORK, 'run_tests.py')]
    hit = next((p for p in cands if _o.path.isfile(p)), None)
    print(("PASS" if hit else "FAIL") + "  delegation target present: run_tests.py (%s)" % (hit or "NOT FOUND"))
    print("SELFTEST PASS" if hit else "SELFTEST FAIL")
    return 0 if hit else 1


def main():
    ap=argparse.ArgumentParser(); ap.add_argument("--retries",type=int,default=2)
    ap.add_argument("--timeout",type=int,default=300); ap.add_argument("--work","--tree")
    ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest:
        return selftest()
    if not os.path.exists(RESULTS):
        # absent corpus: there is nothing to grade, which is NOT a failure
        # verdict -- unknown is a third state (CLAUDE.md s0).
        print(f"{Y}no last-band results ({RESULTS}). run bd-parband first.{RST}")
        return sec.EXIT_CANNOT_EVALUATE
    d=json.load(open(RESULTS)); work=a.work or d.get("work",sec.DEFAULT_WORK)
    failed=[r["suite"] for r in d["results"] if r["status"]!="pass"]
    if not failed:
        print(f"{G}last band had no failures -- nothing to retest{RST}"); return 0
    # @868. A ledger row whose suite is GONE cannot be retested, and run_one
    # below would not notice: run_tests.py falls back to a BROAD RUN for a path
    # it cannot find, and a green whole-tree run makes all(o=="pass") true, so
    # this tool would print FLAKE and DELETE a real failure from the ledger.
    # Reachable with no hand-editing -- band fails, the test file is renamed or
    # deleted as part of the fix, bd-retest re-reads the old results file.
    # Shared with bd-parband on purpose (sec.missing_suite_reason): two copies
    # of this predicate is how this half stayed open when the producer half was
    # closed.
    gone=[(s,sec.missing_suite_reason(work,s)) for s in failed]
    gone=[(s,w) for s,w in gone if w]
    if gone:
        print(f"{R}BD-RETEST UNEVALUABLE{RST} -- these ledger rows name suites "
              f"that no longer exist, so there is nothing to retest:",
              file=sys.stderr)
        for s,w in gone: print(f"  {R}XX{RST} {s} {DIM}({w}){RST}",file=sys.stderr)
        print(f"{DIM}re-run the band (bd-parband) to rebuild the ledger{RST}",
              file=sys.stderr)
        # Refuse the whole run rather than grading the survivors: a partial
        # retest reported as a clean verdict is the same false-clean this
        # closes. Unknown is a third state and it fails.
        return sec.EXIT_CANNOT_EVALUATE
    print(f"{BOLD}retest{RST} {DIM}{len(failed)} previously-failing suite(s), {a.retries} retries each{RST}")
    real=[]; flake=[]
    for s in failed:
        outcomes=[run_one(work,s,a.timeout) for _ in range(a.retries)]
        if all(o=="pass" for o in outcomes):
            flake.append(s); print(f"  {Y}FLAKE{RST} {s} {DIM}(passed {a.retries}/{a.retries} on retry){RST}")
        elif any(o=="pass" for o in outcomes):
            flake.append(s); print(f"  {Y}FLAKY{RST} {s} {DIM}({'/'.join(outcomes)}){RST}")
        else:
            real.append(s); print(f"  {R}REAL{RST}  {s} {DIM}(failed every retry){RST}")
    if real: print(f"\n{R}{len(real)} REAL failure(s), {len(flake)} flake(s){RST}"); return 1
    print(f"\n{G}all {len(flake)} were flakes -- clean on retry{RST}"); return 0
sys.exit(main())
