#!/usr/bin/env python3
"""bd-band -- run targeted test suites with the correct sandbox env + a per-suite
timeout, reporting EVERY suite's result before exiting non-zero on any failure.

Removes the most-repeated manual incantation in a session: the
    env BD_HOME=$(mktemp -d) BD_DISABLE_KEEPALIVE=1 \
        venv/bin/python -m pytest tests/<file>
block, and bounds each suite with a per-suite timeout so a wedged suite fails
its box instead of the session.

@950: RUNS REAL PYTEST. This shelled out to the run_tests_core shim, which is
documented as "NOT a replacement for pytest in production" and installs itself
whenever pytest is not ALREADY imported -- always, at runner startup -- so it
ran even though the interpreter guard below has just proven pytest importable.
Measured across the whole suite at v3.66.949, per-file isolation on both sides:
the shim called 28 files non-PASS and 24 of them pass under real pytest,
verified 24/24. 86% of this tool's output was manufactured.

@948: the "known whole-dir / test_perf_lab / nav_guard hangs" this docstring
used to cite are GONE, and citing them was citing nothing. test_perf_lab passes
in 2.5s, `nav_guard` names a file that has never existed, and an instrumented
full-suite run found no test exceeding 240s. The per-suite timeout stays because
a bound is good hygiene, not because those three were real.

Refuses a bare `tests/` argument -- pass specific files. The whole suite has one
sanctioned form and it lives in CLAUDE.md section 5.

By default bands from the WORK TREE (the dev loop; fast iteration). For release
grade, pass --from-zip <zip> to extract + band from a pristine tree (pyc can lie
in a reused work dir -- this is why bd-cut bands from the extracted zip).

Usage:
    bd-band tests/test_gui_parity.py tests/test_contracts.py
    bd-band tests/test_settings_center_slice4.py --timeout 300
    bd-band tests/test_contracts.py --from-zip ~/out/BulkDownloader_v3_66_365.zip
Exit 0 = all suites Failed:0 ; 1 = any failure/timeout/missing suite.
"""
import argparse
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile


def _resolve_default_work():
    env = os.environ.get("BD_ROOT")
    if env and os.path.isfile(os.path.join(env, "bulk_downloader", "__init__.py")):
        return env
    directory = os.path.dirname(os.path.realpath(__file__))
    for _ in range(8):
        if os.path.isfile(os.path.join(directory, "bulk_downloader", "__init__.py")):
            return directory
        parent = os.path.dirname(directory)
        if parent == directory:
            break
        directory = parent
    return os.environ.get("BD_WORK_TREE", os.getcwd())


DEFAULT_WORK = _resolve_default_work()
EXIT_CANNOT_EVALUATE = 2


def _imports_pytest(executable, timeout=30):
    try:
        return subprocess.run(
            [executable, "-c", "import pytest"], capture_output=True,
            timeout=timeout).returncode == 0
    except Exception:
        return False


def _resolve_test_interpreter(work=None):
    work = work or DEFAULT_WORK
    candidates = [os.path.join(work, "venv", "bin", "python"),
                  os.path.join(DEFAULT_WORK, "venv", "bin", "python"),
                  sys.executable, shutil.which("python3") or ""]
    seen = set()
    for candidate in candidates:
        if not candidate or candidate in seen:
            continue
        seen.add(candidate)
        if os.path.exists(candidate) and _imports_pytest(candidate):
            return candidate
    return None


# INLINE BY DESIGN (row 243).  This block is duplicated in every owning pytest
# launcher so a byte-for-byte copy of this tool has no sibling Python import.
# The bootstrap registers its own PID, refuses if publication fails, and only
# then imports pytest.  runpy keeps registration and pytest in the same process
# without a wrapper file or an exec hand-off.
_PYTEST_REGISTRATION_BOOTSTRAP = r'''\
import os
import runpy
import shlex
import subprocess
import sys

jobs, purpose, *pytest_args = sys.argv[1:]
command = shlex.join([sys.executable, "-m", "pytest", *pytest_args])
registration = subprocess.run(
    [sys.executable, jobs, "register", "--pid", str(os.getpid()),
     "--purpose", purpose, "--cmd", command],
    capture_output=True, text=True,
)
if registration.returncode:
    detail = (registration.stdout + registration.stderr).strip()
    print("BD-PYTEST REFUSED: registration failed before pytest import/work"
          + (": " + detail if detail else ""), file=sys.stderr)
    raise SystemExit(3)
sys.argv[:] = ["pytest", *pytest_args]
runpy.run_module("pytest", run_name="__main__", alter_sys=True)
'''


def _registered_pytest_argv(python, purpose, *pytest_args, work=None):
    """Return a same-PID, register-before-import pytest command."""
    candidates = []
    if work is not None:
        candidates.append(pathlib.Path(work) / "toolchain" / "bin" / "bd-jobs")
    here = pathlib.Path(__file__).resolve()
    candidates.append(here.with_name("bd-jobs"))
    if len(here.parents) >= 3:
        candidates.append(here.parents[2] / "toolchain" / "bin" / "bd-jobs")
    try:
        resolved_python = pathlib.Path(python).resolve()
    except (OSError, RuntimeError):
        resolved_python = None
    if resolved_python is not None:
        candidates.extend(
            parent / "toolchain" / "bin" / "bd-jobs"
            for parent in resolved_python.parents
        )
    installed = shutil.which("bd-jobs")
    if installed:
        candidates.append(pathlib.Path(installed))
    jobs = next((path for path in candidates if path.is_file()), None)
    if jobs is None:
        raise RuntimeError(
            "owned pytest launch refused: bd-jobs is not reachable; nothing ran")
    return [str(python), "-c", _PYTEST_REGISTRATION_BOOTSTRAP,
            str(jobs), str(purpose), *[str(arg) for arg in pytest_args]]

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


# pytest's own summary line: "4 passed in 0.40s", "1 failed, 3 passed".
# The shim printed "Total: N | Failed: N" instead, which is why the old
# selector matched on "Failed:" and picked up the shim's zero-collect
# banner as though it were a result.
_PYTEST_SUMMARY = re.compile(r"\d+ (passed|failed|error|skipped|deselected)")


def grade_pytest_rc(rc):
    """pytest's exit code -> "pass" | "fail" | "nothing-ran".  @950.

    THREE STATES, READ FROM A NUMBER THAT CANNOT DRIFT. @897 had to detect
    "nothing ran" by string-matching an UNEVALUABLE banner, because the stub
    runner prints a reassuring `Total: 0 | Failed: 0` beside it and grading on
    `Failed:` made a real failure and a suite that ran nothing
    indistinguishable. pytest reports that state as exit 5, so the state
    survives and the prose-matching does not.

    NOTHING RAN STAYS NON-GREEN. test_toolchain_534's @860 guard exists because
    zero-collect used to exit 0, and its docstring names bd-band as a grader of
    exactly this shape. Everything that is not 0 and not 5 -- interrupted (2),
    internal error (3), usage error (4), a signal -- has proven nothing either
    and must not read as a pass.
    """
    if rc == 0:
        return "pass"
    if rc == 5:                     # pytest: no tests collected
        return "nothing-ran"
    return "fail"


def run(cmd, cwd=None, env=None, timeout=None):
    try:
        return subprocess.run(cmd, cwd=cwd, env=env, capture_output=True,
                              text=True, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        out, err = e.stdout or "", e.stderr or ""
        if isinstance(out, bytes):
            out = out.decode("utf-8", "replace")
        if isinstance(err, bytes):
            err = err.decode("utf-8", "replace")
        msg = f"TIMEOUT: '{' '.join(map(str, cmd))}' exceeded {timeout}s"
        return subprocess.CompletedProcess(cmd, 124, out, (err + "\n" + msg).strip())


def band_env():
    """The suite env. BOTH of the old hardcodes are gone (@876).

    PLAYWRIGHT_BROWSERS_PATH pinned a zip-era sandbox cache that does not exist
    on a git checkout. Measured on tests/test_v3_66_252_dom_excerpt.py, one
    variable at a time:

        baseline                    Total: 4 | Passed: 4 | Skipped: 0
        +PLAYWRIGHT_BROWSERS_PATH   Total: 4 | Passed: 1 | Skipped: 3
        +PYTHONPATH                 Total: 4 | Passed: 4 | Skipped: 0

    The three lost assertions SELF-SKIP on an unlaunchable browser, so the
    summary still reads `Failed: 0` with rc 0 -- which is exactly this tool's
    own pass predicate below. A band derived by the method CLAUDE.md section 4
    mandates therefore reported green over assertions that never executed.
    Measured blast radius: 8 of 1212 tracked test files skip that way; the
    other 7 that launch a browser fail loudly.

    ABSENT is the correct value: playwright then uses its own default. Section 5
    already warns that two browser pools with different chromium revisions is a
    live confounder -- pinning one of them by hand is how you pick the wrong one
    every time.

    PYTHONPATH was inert in that measurement and is removed anyway: replacing it
    strips the work tree from sys.path, which is the documented
    route_map_snapshot.py footgun. Do not read this as "both were biting".

    toolchain/bin/bd-cut carries this same port from v3.66.855, rationale and
    all. bd-band simply never got it; test_toolchain_534 now asserts over both
    so they cannot drift apart again.
    """
    env = dict(os.environ)
    env.pop("BD_INSTALL_DIR", None)
    env.update(BD_HOME=tempfile.mkdtemp(), BD_DISABLE_KEEPALIVE="1")
    return env


def selftest():
    """SKIP: this tool needs the full test tree (long-running), which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs the full test tree (long-running)")
    print("SELFTEST PASS")
    return 0


def _load_bandcheck():
    """Load the sibling bd-bandcheck by PATH. It is extensionless, so a normal
    import cannot reach it; returning None (never raising) keeps a missing
    checker from taking the band down with it -- but the caller must then say
    the band is UNVERIFIED rather than treating absence as safety."""
    import importlib.util, importlib.machinery, os as _o
    here = _o.path.dirname(_o.path.realpath(__file__))
    tgt = _o.path.join(here, "bd-bandcheck")
    if not _o.path.isfile(tgt):
        return None
    try:
        spec = importlib.util.spec_from_loader(
            "_bd_bandcheck",
            importlib.machinery.SourceFileLoader("_bd_bandcheck", tgt))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod if hasattr(mod, "check") else None
    except Exception:
        return None


def rundir_probe(a):
    """The tree bd-bandcheck should resolve targets against."""
    return a.work


def main(argv=None):
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser(prog="bd-band")
    ap.add_argument("suites", nargs="+", help="specific test files, e.g. tests/test_x.py")
    ap.add_argument("--work","--tree", default=DEFAULT_WORK)
    ap.add_argument("--from-zip", help="extract this zip and band from the pristine tree")
    ap.add_argument("--timeout", type=int, default=240, help="per-suite timeout seconds")
    ap.add_argument("--skip-bandcheck", action="store_true",
                    help="run even if bd-bandcheck flags a target (say why in the cut)")
    a = ap.parse_args(argv)

    # @849 -- REFUSE AN UNSAFE BAND BEFORE SPENDING 200 SECONDS DISCOVERING IT.
    #
    # bd-bandcheck has validated band lists against the three footguns CLAUDE.md
    # section 4 documents -- the whole-dir/perf_lab hang, a test FUNCTION passed
    # as a path (run_tests falls back to a broad run -> timeout -> ABORT), and
    # the test_phases_195_199/test_cut8_schedules BD_INSTALL_DIR leak -- and
    # NOTHING HAS EVER CALLED IT. It was one of 167 bd-* tools that are described
    # somewhere and invoked by nowhere. A checker nobody runs is a checker that
    # does not exist, so the wiring is the whole point: the footguns are now
    # refused at the door rather than documented in a file the caller may not
    # have read.
    #
    # Delegation, not reimplementation: bd-bandcheck.check() is the single
    # source of truth for what is unsafe. Duplicating its lists here is how the
    # copy nobody updates becomes the one that runs (section 5).
    # The ORIGINAL bare-tests/ refusal, kept as a floor. My first draft of this
    # block DELETED it in favour of the delegated check and then let the band
    # run when the loader failed -- so a `bd-band tests` launched the whole-dir
    # hang the guard existed to prevent. A replacement that fails OPEN where the
    # original failed CLOSED is a regression even when the replacement is
    # better, and this one is CLAUDE.md section 0's own shape: the check could
    # not see its subject and reported nothing.
    if [s for s in a.suites if s.rstrip("/") in ("tests", "test")]:
        print(f"{R}refusing{RST} a bare tests/ dir -- it hangs (test_perf_lab). "
              f"Pass specific files.", file=sys.stderr)
        return 2

    _bc = _load_bandcheck()
    if _bc is None:
        # UNKNOWN IS A THIRD STATE, and for a gate that means FAIL, not warn.
        # "bd-bandcheck could not be loaded" is not "the targets are safe".
        print(f"{R}refusing this band{RST} -- bd-bandcheck is not loadable, so "
              f"the targets are UNVERIFIED. Absence of a checker is not a pass.\n"
              f"(override with --skip-bandcheck if you are certain)",
              file=sys.stderr)
        if not a.skip_bandcheck:
            return 2
    elif a.skip_bandcheck:
        print(f"{Y}bandcheck skipped by request{RST} -- targets UNVERIFIED.",
              file=sys.stderr)
    else:
        _rc, _lines = _bc.check(a.suites, rundir_probe(a))
        if _rc != 0:
            print(f"{R}refusing this band{RST} -- bd-bandcheck flagged it:",
                  file=sys.stderr)
            for _l in _lines:
                print(_l, file=sys.stderr)
            print("(override with --skip-bandcheck if you are certain)",
                  file=sys.stderr)
            return 2

    if a.from_zip:
        if not os.path.exists(a.from_zip):
            print(f"{R}--from-zip not found:{RST} {a.from_zip}", file=sys.stderr)
            return 2
        rundir = tempfile.mkdtemp(prefix="bdband_")
        with zipfile.ZipFile(a.from_zip) as zf:
            zf.extractall(rundir)
        print(f"{DIM}banding from extracted zip -> {rundir}{RST}")
    else:
        rundir = a.work
        if not os.path.isdir(os.path.join(rundir, "tests")):
            print(f"{R}no tests/ under {rundir}{RST}", file=sys.stderr)
            return 2

    env = band_env()
    # @851: NOT "python3". Here that is 3.11 without the project deps, and
    # run_tests.py under it reports failures that do not exist (CLAUDE.md s5).
    # None is a verdict -- refuse rather than band on an interpreter whose
    # failures would be artifacts read as results.
    py = _resolve_test_interpreter(rundir)
    if py is None:
        print(f"{R}BD-BAND UNEVALUABLE{RST} no interpreter under {rundir} can "
              f"import pytest. Banding on one that cannot would report failures "
              f"that are interpreter artifacts, not defects.")
        return EXIT_CANNOT_EVALUATE
    print(f"  {DIM}interpreter: {py}{RST}")
    allok = True
    results = []
    for s in a.suites:
        if not os.path.exists(os.path.join(rundir, s)):
            print(f"  {Y}SKIP{RST}  {s}: not present in {rundir}")
            allok = False
            results.append((s, False, "missing"))
            continue
        print(f"  ... running {s}", flush=True)
        # @950: REAL PYTEST. This shelled out to the run_tests_core shim, which
        # installs a stub into sys.modules whenever pytest is not ALREADY
        # imported -- always, at runner startup -- so the stub ran even here,
        # where the guard above has just PROVEN pytest is importable. Measured
        # at v3.66.949 across the whole suite with per-file isolation on both
        # sides: the shim reported 28 files non-PASS and 24 of them pass under
        # real pytest, verified 24/24. 86% of this tool's output was
        # manufactured. The shim's own docstring says it is "NOT a replacement
        # for pytest in production" and exists for environments without pytest;
        # the guard above means this is never one.
        r = run(_registered_pytest_argv(
                    py, f"bd-band {s}", s, "-q", "-p", "no:randomly",
                    work=rundir),
                cwd=rundir, env=env, timeout=a.timeout)
        blob = r.stdout + r.stderr
        tail = blob.strip().splitlines()
        line = next((l for l in reversed(tail)
                     if _PYTEST_SUMMARY.search(l)), "(no summary)")
        ok = grade_pytest_rc(r.returncode) == "pass"
        allok = allok and ok
        # @897 -- the runner mints THREE states and this graded two. It exits 2
        # with "BD-RUNNER UNEVALUABLE ... Nothing ran, so nothing was proven"
        # (run_tests_core.py:1663-1668), and the summary line it prints beside
        # that is the reassuring `Total: 0 | ... | Failed: 0`. Selecting the
        # summary by "Failed:" therefore printed FAIL next to Failed: 0 and
        # DISCARDED the banner saying why -- a real failure and a suite that
        # ran nothing were indistinguishable in the output.
        #
        # NOTHING RAN STAYS NON-GREEN. test_toolchain_534's @860 guard exists
        # because zero-collect used to exit 0, and its docstring names bd-band
        # as a grader of exactly this shape. Naming the state is the fix;
        # excusing it would undo @860 while appearing to repair its neighbour.
        if grade_pytest_rc(r.returncode) == "nothing-ran":
            label, detail = Y + "NOTHING RAN" + RST, "nothing was proven"
        else:
            label, detail = (G + "PASS" + RST) if ok else (R + "FAIL" + RST), ""
        results.append((s, ok, line.strip()))
        print(f"  {label}  {s}: {line.strip()}"
              + (f"  {DIM}({detail}){RST}" if detail else ""))

    npass = sum(1 for _, ok, _ in results if ok)
    print(f"\n{'%sALL PASS%s' % (G, RST) if allok else '%sFAILURES%s' % (R, RST)} "
          f"-- {npass}/{len(results)} suites green")
    return 0 if allok else 1


if __name__ == "__main__":
    sys.exit(main())
