#!/usr/bin/env python3
"""bd-sweep -- the budgeted, journaled, allowlisted EXECUTOR for the toolchain.

The suite has one static checker of itself (bd-tool-lint / bd-selfcheck, which
refuse to execute anything, by doctrine) and no honest way to RUN the toolchain
against itself. bd-tool-lint smuggles an executor inside a linter: its runtime
probe execs `bd -c "<tool> --json"` for EVERY tool -- including bd-boot and
bd-install, which have side effects -- with no budget and no journal. That is
the wrong place for execution and it is why --gate times out. bd-sweep is the
right place: execution is on purpose, allowlisted, bounded, and resumable.

TWO MODES:

  --selftests     run every tool's --selftest.
  --corpus-probes the F-1 methodology, productized: point every corpus-taking
                  tool at an ABSENT corpus, an EMPTY one, and one that exists
                  but has the wrong shape. Each must exit 2 (CANNOT-EVALUATE).
                  rc=0 there is a tool minting a green verdict over nothing.

FOUR DISCIPLINES, each one paid for:

 1. FLAGS ARE DERIVED, NEVER GUESSED. We probe the flags a tool actually
    declares (AST, via bdtools_sec.corpus_profile). Guessing --tree on a tool
    that has no --tree makes argparse exit 2, which reads as "guarded" -- that
    phantom is exactly how a prior review concluded bd-defect-scan had a corpus
    guard it did not have. An argparse usage error is NOT a guard, and this
    tool tells them apart by reading stderr.

 2. EXECUTION IS ALLOWLISTED. Only tools the suite classifies as analysis (they
    build on the shared libs) are ever run, minus an explicit never-exec set.
    A sweep that runs bd-install to see what it prints has destroyed the venv.

 3. PARTIAL IS NEVER GREEN. Budget exhaustion exits 2 with the remainder, not 0
    with a smile. SKIP is counted separately from PASS; a skip is not a pass.
    A tool we could not evaluate is reported as UNKNOWN, which fails.

 4. SERIAL BY DEFAULT. --jobs N exists, but concurrency makes timing-sensitive
    tools flake: measured here, two tools changed verdict between a 16-way
    parallel run and a serial one. Parallel is for triage; serial is for gates.

Usage: bd-sweep [--selftests] [--corpus-probes] [--bin DIR] [--budget S]
                [--timeout S] [--jobs N] [--journal FILE] [--resume]
                [--only TOOL[,TOOL]] [--json] [--selftest]
Exit 0 = full sweep, nothing failed; 1 = failures (listed); 2 = CANNOT-EVALUATE
(budget exhausted, bin unreadable, or nothing runnable). Partial is never green.
"""
import argparse
import ast
import concurrent.futures
import json
import os
import re
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

G, Y, R, DIM, RST = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"

DEFAULT_BIN = "/home/claude/bin"
GHOST = "/home/claude/BD_SWEEP_GHOST_DIR_DOES_NOT_EXIST"

# Never execute these, whatever their imports say. They mutate the sandbox, the
# work tree, or the venv. bd-install does `rm -rf work/*` and the release zip
# carries no venv/ -- a sweep that "just runs everything to see" ends the session.
NEVER_EXEC = frozenset([
    "bd-boot", "bd-install", "bd-venv", "bd-prestage", "bd-cut", "bd-bump",
    "bd-pack", "bd-handoff", "bd-ship", "bd-rollback", "bd-mkbdsuite",
    "bd-mkauditstate", "bd-optpack", "bd-fetch", "bd-repin-dist", "bd-kb-sync",
    "bd-reindex", "bd-regen", "bd-checkpoint", "bd-snapshot", "bd-fullsuite",
    "bd-opv", "bd-render", "bd-deep-capture", "bd-novnc", "bd-corpus",
    "bd-guard-declare", "bd-ratchet", "bd-sweep",
    # v3.66.738: bd-mutation-test is an ORCHESTRATOR. The rewrite (blind ->
    # real) makes it COPY THE TREE and run REAL gates -- run_tests, vitest,
    # bd-guardcheck, bd-gui-surface -- once per registry row. Executing it from
    # a sweep or a lint detonates the entire mutation battery, recursively,
    # under the caller's own load. Same doctrine as bd-fullsuite/bd-precut: a
    # checker must not detonate the thing it is checking.
    "bd-mutation-test",
    # v3.66.808 (operator ruling): the fault INJECTORS and proof harnesses.
    # bd-golden's --record executes its whole population; widening that
    # population past the --work/--tree contract (the "47 uncovered" work)
    # makes these reachable, and a coverage sweep that runs chaos injectors
    # against the live tree and services breaks the thing it is measuring.
    # Ruled ALL EIGHT rather than adjudicating the three proof harnesses
    # individually -- bd-netns-proof creates network namespaces, and being
    # wrong about a "read-only verifier" costs a damaged session while being
    # over-broad costs a visibly uncovered tool. Uncovered-and-visible beats
    # covered-by-detonation.
    "bd-capture-chaos", "bd-db-chaos", "bd-network-chaos", "bd-plugin-chaos",
    "bd-queue-chaos", "bd-netns-proof", "bd-scrub-proof", "bd-proof-ledger",
])

PASS, FAIL, SKIP, TIMEOUT, UNKNOWN = "PASS", "FAIL", "SKIP", "TIMEOUT", "UNKNOWN"


def discover(bindir):
    if not os.path.isdir(bindir):
        sys.stderr.write("CANNOT-EVALUATE --bin %s: reason=%s\n"
                         % (bindir, sec.REASON_ABSENT))
        sys.exit(sec.EXIT_CANNOT_EVALUATE)
    return sorted(t for t in os.listdir(bindir)
                  if t.startswith("bd-") and not t.endswith(".py")
                  and os.path.isfile(os.path.join(bindir, t)))


def runnable(bindir, tools):
    """The allowlist: analysis tools only, minus the never-exec set."""
    out = []
    for t in tools:
        if t in NEVER_EXEC:
            continue
        try:
            src = open(os.path.join(bindir, t), errors="ignore").read()
        except OSError:
            continue
        if sec.is_analysis_tool(src):
            out.append(t)
    return out


def _run(cmd, timeout):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or ""), (p.stderr or "")
    except subprocess.TimeoutExpired:
        return None, "", "timeout"
    except OSError as exc:
        return None, "", str(exc)


def selftest_case(bindir, tool, timeout):
    src = open(os.path.join(bindir, tool), errors="ignore").read()
    if "--selftest" not in src:
        return (tool, "selftest", SKIP, "no --selftest", 0.0)
    t0 = time.time()
    rc, out, _err = _run([os.path.join(bindir, tool), "--selftest"], timeout)
    dt = time.time() - t0
    if rc is None:
        return (tool, "selftest", TIMEOUT, "exceeded %ss" % timeout, dt)
    first = out.splitlines()[:1]
    if first and first[0].startswith("SKIP:"):
        return (tool, "selftest", SKIP, first[0][5:].strip(), dt)
    # The suite's selftest output contract: a machine-readable terminal verdict.
    # A tool that exits 0 while printing SELFTEST FAIL is not a pass, and a tool
    # that prints neither cannot be read -- that is UNKNOWN, and unknown fails.
    if "SELFTEST FAIL" in out:
        return (tool, "selftest", FAIL, "printed SELFTEST FAIL", dt)
    if rc != 0:
        return (tool, "selftest", FAIL, "rc=%d" % rc, dt)
    if "SELFTEST PASS" not in out:
        return (tool, "selftest", UNKNOWN, "rc=0 but no SELFTEST PASS line", dt)
    return (tool, "selftest", PASS, "", dt)


def positional_args(src):
    """Positional arguments the tool REQUIRES, derived from its argparse.

    A probe that omits them never reaches the corpus at all: bd-lineage prints
    "FEATURE required" and exits 1, which a naive prober scores as "findings
    over a corpus that is not there". That is the same misread as treating an
    argparse usage error as a guard -- an exit code read without asking what
    produced it. Supply a sentinel so the tool actually gets to the corpus.
    """
    try:
        tree = ast.parse(src)
    except SyntaxError:
        return []
    out = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        fname = getattr(node.func, "attr", None) or getattr(node.func, "id", None)
        if fname != "add_argument":
            continue
        for arg in node.args:
            if isinstance(arg, ast.Constant) and isinstance(arg.value, str) \
                    and not arg.value.startswith("-"):
                out.append(arg.value)
    return out


def corpus_cases(bindir, tool, timeout, shapes, control_root=None):
    """Probe the flags the tool ACTUALLY DECLARES against corpora that are not
    there. Each must refuse. Anything else is a verdict minted over nothing.

    A PROBE NEEDS ITS OWN POSITIVE CONTROL. Some tools exit nonzero for reasons
    that have nothing to do with the corpus -- bd-rollback-oracle wants
    --failure TYPE and stops before it ever looks at the tree. Scoring that as
    "findings over a corpus that is not there" is the same error as reading an
    argparse usage exit as a guard: an exit code interpreted without asking what
    produced it. So for any ambiguous nonzero rc we re-run the SAME invocation
    against a REAL tree; if it fails identically there, the rc is not
    corpus-dependent, the probe never reached the corpus, and the honest verdict
    is UNKNOWN -- which is not a pass."""
    src = open(os.path.join(bindir, tool), errors="ignore").read()
    declares, guarded, flags, parsed = sec.corpus_profile(src)
    if not parsed:
        return [(tool, "corpus", UNKNOWN, "source did not parse; could not derive flags", 0.0)]
    if not declares:
        return []
    # Supply any required positionals, or the tool errors on usage and we score
    # a verdict it never rendered.
    extra = ["BD_SWEEP_PROBE" for _ in positional_args(src)]
    # A tool may DECLARE how to be probed, for required options the prober cannot
    # guess (an enum like --failure guard). Without it the probe never reaches the
    # corpus and the honest verdict is UNKNOWN forever -- which is not a verdict.
    m = re.search(r"#\s*sweep:\s*probe-args\s+(.+)", src)
    if m:
        extra += m.group(1).split()
    rows = []
    for flag in flags:
        for shape_name, path in shapes:
            t0 = time.time()
            rc, _out, err = _run([os.path.join(bindir, tool), flag, path] + extra, timeout)
            dt = time.time() - t0
            case = "%s %s" % (flag, shape_name)
            if rc is None:
                rows.append((tool, case, TIMEOUT, "exceeded %ss" % timeout, dt))
                continue
            # An argparse usage error is NOT a guard. It also exits 2. Reading
            # that as "refused" is the phantom that put a nonexistent corpus
            # guard into a review document.
            if "unrecognized arguments" in err or "not allowed with" in err:
                rows.append((tool, case, UNKNOWN,
                             "argparse rejected the flag -- NOT a guard", dt))
                continue
            if rc == sec.EXIT_CANNOT_EVALUATE:
                rows.append((tool, case, PASS, "refused (rc=2)", dt))
            elif rc == 0:
                # Unambiguous: it rendered a clean verdict over nothing.
                rows.append((tool, case, FAIL,
                             "GREEN over a corpus that is not there (rc=0)", dt))
            else:
                ctl = None
                if control_root:
                    ctl, _o, _e = _run(
                        [os.path.join(bindir, tool), flag, control_root] + extra, timeout)
                if ctl is not None and ctl == rc:
                    rows.append((tool, case, UNKNOWN,
                                 "rc=%d on a REAL tree too -- not corpus-dependent; "
                                 "the probe never reached the corpus (needs args?)"
                                 % rc, dt))
                else:
                    rows.append((tool, case, FAIL,
                                 "rc=%d over a corpus that is not there" % rc, dt))
    if guarded and not rows:
        rows.append((tool, "corpus", SKIP, "declares a guard but no probeable flag", 0.0))
    return rows


def load_journal(path):
    done = {}
    if path and os.path.exists(path):
        for ln in open(path):
            f = ln.rstrip("\n").split("\t")
            if len(f) >= 4:
                done[(f[0], f[1])] = f[2]
    return done


def sweep(bindir, tools, do_selftests, do_probes, budget, timeout, jobs,
          journal, resume, control_root=None):
    shapes = []
    tmpdirs = []
    if do_probes:
        empty = tempfile.mkdtemp(prefix="bd_sweep_empty_")
        wrong = tempfile.mkdtemp(prefix="bd_sweep_wrong_")
        open(os.path.join(wrong, "readme.txt"), "w").write("not a source tree\n")
        tmpdirs = [empty, wrong]
        shapes = [("absent", GHOST), ("empty", empty), ("wrong-shape", wrong)]

    done = load_journal(journal) if resume else {}
    # Resume must skip the WORK, not merely the recording of it. Each tool's
    # cases are produced atomically, so a tool present in the journal is done.
    done_tools = set(k[0] for k in done)
    start = time.time()
    rows, exhausted = [], False

    def work(tool):
        out = []
        if do_selftests:
            out.append(selftest_case(bindir, tool, timeout))
        if do_probes:
            out.extend(corpus_cases(bindir, tool, timeout, shapes, control_root))
        return out

    pending = [t for t in tools]
    if jobs > 1:
        with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
            futs = {pool.submit(work, t): t for t in pending}
            for fut in concurrent.futures.as_completed(futs):
                rows.extend(fut.result())
    else:
        for i, t in enumerate(pending):
            if t in done_tools:
                continue
            if budget and (time.time() - start) > budget:
                exhausted = True
                remaining = len(pending) - i
                sys.stderr.write(
                    "BUDGET-EXHAUSTED: ran %d/%d, %d remain (re-run with "
                    "--resume --journal %s)\n"
                    % (i, len(pending), remaining, journal or "<none>"))
                break
            for row in work(t):
                if resume and (row[0], row[1]) in done:
                    continue
                rows.append(row)
                if journal:
                    with open(journal, "a") as fh:
                        fh.write("%s\t%s\t%s\t%s\t%.2f\n" % row)

    for d in tmpdirs:
        try:
            os.remove(os.path.join(d, "readme.txt"))
        except OSError:
            pass
        try:
            os.rmdir(d)
        except OSError:
            pass
    return rows, exhausted


def summarize(rows):
    c = {PASS: 0, FAIL: 0, SKIP: 0, TIMEOUT: 0, UNKNOWN: 0}
    for r in rows:
        c[r[2]] = c.get(r[2], 0) + 1
    return c


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", default=DEFAULT_BIN)
    ap.add_argument("--selftests", action="store_true")
    ap.add_argument("--corpus-probes", action="store_true")
    ap.add_argument("--budget", type=float, default=0.0,
                    help="seconds; 0 = unbounded. Exhaustion exits 2, never 0.")
    ap.add_argument("--timeout", type=float, default=30.0, help="per-invocation")
    ap.add_argument("--jobs", type=int, default=1,
                    help="serial by default; >1 is triage-grade (timing flake)")
    ap.add_argument("--journal", default=None)
    ap.add_argument("--resume", action="store_true")
    ap.add_argument("--only", default=None, help="comma-separated tool names")
    ap.add_argument("--control", default=sec.DEFAULT_WORK,
                    help="a REAL tree, used as the probe's positive control")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()

    if not a.selftests and not a.corpus_probes:
        a.selftests = a.corpus_probes = True

    tools = discover(a.bin)
    allow = runnable(a.bin, tools)
    not_runnable = len(tools) - len(allow)   # operational / never-exec: the REAL exclusion
    run_set = allow
    filtered = 0
    if a.only:
        want = set(x for x in a.only.split(",") if x)
        run_set = [t for t in run_set if t in want]
        filtered = len(allow) - len(run_set)   # a user filter is NOT "not runnable"
    if not run_set:
        sys.stderr.write("CANNOT-EVALUATE --bin %s: reason=%s (0 runnable tools)\n"
                         % (a.bin, sec.REASON_EMPTY))
        return sec.EXIT_CANNOT_EVALUATE

    control = a.control if os.path.isdir(os.path.join(a.control, "bulk_downloader")) else None
    rows, exhausted = sweep(a.bin, run_set, a.selftests, a.corpus_probes,
                            a.budget, a.timeout, a.jobs, a.journal, a.resume,
                            control)
    c = summarize(rows)
    payload = {"bin": a.bin, "tools_in_bin": len(tools),
               "allowlisted": len(allow), "runnable": len(run_set),
               "skipped_not_runnable": not_runnable,
               "excluded_by_only": filtered,
               "cases": len(rows), "counts": c, "budget_exhausted": exhausted,
               "jobs": a.jobs,
               "failures": [{"tool": r[0], "case": r[1], "status": r[2], "why": r[3]}
                            for r in rows if r[2] in (FAIL, TIMEOUT, UNKNOWN)]}
    if a.json:
        json.dump(payload, sys.stdout, indent=1, sort_keys=True)
        sys.stdout.write("\n")
    else:
        for r in sorted(rows):
            if r[2] in (FAIL, TIMEOUT, UNKNOWN):
                col = R if r[2] == FAIL else Y
                print("  %s%-8s%s %-24s %-18s %s" % (col, r[2], RST, r[0], r[1], r[3]))
        bad = c[FAIL] + c[TIMEOUT] + c[UNKNOWN]
        col = R if bad else G
        # The denominator, always: what was examined, and what was NOT.
        print("%sSWEEP ran %d/%d allowlisted tools (%d in bin; %d not runnable: "
              "operational/never-exec%s)%s"
              % (DIM, len(run_set), len(allow), len(tools), not_runnable,
                 "; %d excluded by --only" % filtered if filtered else "", RST))
        print("  %d case(s): %spass %d%s | fail %d | timeout %d | unknown %d | skip %d"
              % (len(rows), col, c[PASS], RST, c[FAIL], c[TIMEOUT], c[UNKNOWN], c[SKIP]))
        if exhausted:
            print("%sBUDGET EXHAUSTED -- partial sweep is NOT green%s" % (R, RST))

    if exhausted:
        return sec.EXIT_CANNOT_EVALUATE
    return sec.EXIT_FINDINGS if (c[FAIL] or c[TIMEOUT] or c[UNKNOWN]) else sec.EXIT_OK


def selftest():
    ok = True
    # I-7 SCOPE (@808, operator ruling): the fault INJECTORS and the proof
    # harnesses must never be auto-executed by a sweep, a lint, or bd-golden's
    # recorder. bd-golden's --record invokes its whole population; when it is
    # widened past the --work/--tree contract these become reachable, and a
    # coverage sweep that runs bd-db-chaos/bd-network-chaos against the live
    # tree and services is a coverage sweep that breaks the thing it measures.
    # Ruled ALL EIGHT (chaos 5 + proof 3) rather than adjudicating the proof
    # tools individually: bd-netns-proof creates network namespaces, and the
    # cost of being wrong about a "read-only verifier" is a damaged session,
    # while the cost of being over-broad is a visibly uncovered tool.
    _i7 = ["bd-capture-chaos", "bd-db-chaos", "bd-network-chaos",
           "bd-plugin-chaos", "bd-queue-chaos", "bd-netns-proof",
           "bd-scrub-proof", "bd-proof-ledger"]
    _missing = [t for t in _i7 if t not in NEVER_EXEC]
    _c = not _missing
    print(("PASS" if _c else "FAIL") +
          "  I7-CHAOS-PROOF: injectors/proof harnesses in NEVER_EXEC (missing: %s)"
          % (_missing or "none"))
    ok &= _c

    # The fixtures must RUN, not die on an ImportError -- a NEG that "catches"
    # a tool because its import failed has passed for the wrong reason, which is
    # worse than failing. Inject the real bin so `import bdtools_sec` resolves.
    shim = ("#!/usr/bin/env python3\nimport sys\nsys.path.insert(0, %r)\n"
            "import bdtools_sec  # --selftest\n" % os.path.dirname(os.path.realpath(__file__)))
    stub_pass = shim + "print('SELFTEST PASS')\nsys.exit(0)\n"
    stub_fail = shim + "print('SELFTEST FAIL')\nsys.exit(1)\n"
    # rc=0 but no verdict line: cannot be read -> UNKNOWN, and unknown fails.
    stub_mute = shim + "print('quiet')\nsys.exit(0)\n"
    with tempfile.TemporaryDirectory() as d:
        for name, body in (("bd-p", stub_pass), ("bd-f", stub_fail), ("bd-m", stub_mute)):
            fp = os.path.join(d, name)
            open(fp, "w").write(body)
            os.chmod(fp, 0o755)
        rows, _ = sweep(d, runnable(d, discover(d)), True, False, 0, 10, 1, None, False)
        c = summarize(rows)
    good = c[PASS] == 1 and c[FAIL] == 1 and c[UNKNOWN] == 1
    print(("PASS" if good else "FAIL") +
          "  POS/NEG selftest triage: pass=%d fail=%d unknown=%d (want 1/1/1)"
          % (c[PASS], c[FAIL], c[UNKNOWN]))
    ok &= good

    # NEG: an unguarded corpus tool must be caught minting green over nothing;
    # a guarded one must pass; and a GUESSED flag must never read as a guard.
    argshim = ("#!/usr/bin/env python3\nimport argparse, sys\n"
               "sys.path.insert(0, %r)\nimport bdtools_sec as sec  # --selftest\n"
               "ap = argparse.ArgumentParser()\n"
               'ap.add_argument("--tree", default=".")\n'
               "a = ap.parse_args()\n" % os.path.dirname(os.path.realpath(__file__)))
    # Must actually reach the print and exit 0 -- that IS the bug being detected.
    unguarded = argshim + "print('no problems found')\nsys.exit(0)\n"
    # A real scanner declares WHAT it scans (*.py), which is what makes the
    # wrong-shape probe bite: a dir that exists and has files, none of which are
    # the thing you scan, is just as unscannable as an empty one. A guard with
    # patterns=None would accept a lone readme.txt as a valid source tree.
    guarded = argshim + 'sec.require_corpus(a.tree, label="--tree", patterns=("*.py",))\n' + \
        "print('clean')\nsys.exit(0)\n"
    with tempfile.TemporaryDirectory() as d:
        for name, body in (("bd-u", unguarded), ("bd-g", guarded)):
            fp = os.path.join(d, name)
            open(fp, "w").write(body)
            os.chmod(fp, 0o755)
        rows, _ = sweep(d, ["bd-u", "bd-g"], False, True, 0, 15, 1, None, False)
    by = {}
    for r in rows:
        by.setdefault(r[0], []).append(r[2])
    u_caught = FAIL in by.get("bd-u", [])
    print(("PASS" if u_caught else "FAIL") +
          "  NEG unguarded tool caught minting GREEN over an absent corpus (%s)"
          % by.get("bd-u"))
    ok &= u_caught
    g_clean = by.get("bd-g") and all(s == PASS for s in by["bd-g"])
    print(("PASS" if g_clean else "FAIL") +
          "  POS guarded tool refuses all 3 corpus shapes (%s)" % by.get("bd-g"))
    ok &= bool(g_clean)
    probed = len(by.get("bd-g", []))
    print(("PASS" if probed == 3 else "FAIL") +
          "  denominator: 3 shapes probed (absent/empty/wrong-shape), got %d" % probed)
    ok &= (probed == 3)

    # NEG: budget exhaustion must exit 2 -- a partial sweep is never green.
    with tempfile.TemporaryDirectory() as d:
        fp = os.path.join(d, "bd-slow")
        open(fp, "w").write(shim + "import time\ntime.sleep(2)\n"
                            "print('SELFTEST PASS')\n")
        os.chmod(fp, 0o755)
        _rows, exhausted = sweep(d, ["bd-slow", "bd-slow"], True, False,
                                 0.001, 10, 1, None, False)
    print(("PASS" if exhausted else "FAIL") +
          "  NEG budget exhaustion flagged (partial is never green -> exit 2)")
    ok &= exhausted

    # The never-exec allowlist must actually hold.
    safe = not (NEVER_EXEC & set(runnable(DEFAULT_BIN, ["bd-install", "bd-boot"])))
    print(("PASS" if safe else "FAIL") + "  mutators (bd-install/bd-boot) never runnable")
    ok &= safe

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
