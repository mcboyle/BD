#!/usr/bin/env python3
"""bd-release-note -- generate release notes from STATE + tree diff + changelog.

Assembles a human-readable release note for the current version: changed files
vs the candidate base (via Git diff), the CHANGELOG top entry,
the validation line + guard status from STATE, and the next-actions from STATE.
For operator sign-off + the tracker. Read-only.

v3.66.855: --home defaulted to /home/claude, the retired sandbox root, so the
tool refused on EVERY invocation and its --selftest could never pass. --home now
defaults to <checkout>/out -- the one place a release zip can still appear, being
where bd-cut --out writes it -- and the selftest builds its own synthetic bundle
so the composition path is actually exercised rather than short-circuited by a
CANNOT-EVALUATE. NOTE FOR THE OPERATOR: the two corpora this reads (a release zip
and STATE.json) both belong to the retired zip/pack flow; in a plain git checkout
--home is empty and exit 2 is the correct and expected answer. See the batch
notes for the retirement question that raises.

Usage: bd-release-note [--work DIR] [--home DIR] [--json] [--selftest]
Exit 0 note composed (informational) / 2 CANNOT-EVALUATE (absent
tree/bundle -- guarded upstream).
"""
import argparse, glob, json, os, re, subprocess, sys, tempfile, zipfile
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def changed_files(work, home):
    # --home is a SECOND corpus root. With neither zip nor STATE, load_state()
    # returned {} and the tool cheerfully emitted release notes about nothing, rc=0.
    sec.require_corpus(home, min_files=1, label="--home",
                       patterns=("BulkDownloader_v3_66_*.zip",))
    zp=sorted(glob.glob(os.path.join(home,"BulkDownloader_v3_66_*.zip")),key=os.path.getmtime,reverse=True)
    if not zp: return None
    pinned={}
    with zipfile.ZipFile(zp[0]) as z:
        for n in z.namelist():
            if n.endswith(".py"): pinned[n]=z.read(n)
    ch=[]
    for p,rel,_t in sec.iter_py(work, strict=True, label="--work/--tree"):
        if rel not in pinned or pinned[rel]!=open(p,"rb").read(): ch.append(rel)
    return sorted(ch)

def build(work, home):
    st=sec.load_state(home) or {}
    ver=st.get("built_version") or st.get("live_version")
    chlog=os.path.join(work,"CHANGELOG.md")
    top=""
    if os.path.exists(chlog):
        s=open(chlog).read()
        m=re.search(r'(## v?[0-9].*?)(?=\n## v?[0-9]|\Z)', s, re.S)
        top=(m.group(1).strip()[:600] if m else "")
    ch=changed_files(work,home)
    nxt=st.get("next")
    return {"version":ver,"changed_files":ch if ch is not None else [],
            "changelog_top":top,"validation":st.get("validation"),
            "deploy_status":st.get("deploy_status"),"next":nxt}

def _expect_version():
    """The version the SOURCE TREE declares about itself.

    Deliberately a DIFFERENT route than the one under test (which reads the
    STATE pin), so this stays a cross-check and not x==x. Refuses rather than
    comparing None to None -- an absent comparand is CANNOT-EVALUATE, not a pass.
    """
    v = sec.detect_tree_version(sec.DEFAULT_WORK)
    if not v:
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=ABSENT "
                         "(work tree declares no __version__)\n")
        sys.exit(2)
    return v


def _synthetic_home(work, td):
    """Build a real bundle (STATE.json + a release zip pinned to the live tree).

    v3.66.855: the selftest used to pass --home /home/claude, which does not
    exist, so sec.require_corpus exited 2 and the selftest NEVER RAN its
    assertions -- it reported CANNOT-EVALUATE forever. A selftest that cannot
    reach its assertions is the gate-that-cannot-see-its-subject shape at the
    tool's own entry point. Building the corpus makes the assertions reachable,
    and building it FROM the live tree keeps 'pristine -> 0 changed files' a real
    comparison rather than a tautology over an empty set.
    """
    ver = sec.detect_tree_version(work)
    zp = os.path.join(td, "BulkDownloader_v3_66_selftest.zip")
    with zipfile.ZipFile(zp, "w") as z:
        for p, rel, _t in sec.iter_py(work, strict=True, label="--work/--tree"):
            z.write(p, rel)
    with open(os.path.join(td, "STATE.json"), "w") as fh:
        json.dump({"built_version": ver, "live_version": ver,
                   "validation": "synthetic selftest bundle",
                   "deploy_status": "not-deployed"}, fh)
    return td


def selftest():
    ok=True
    work = sec.DEFAULT_WORK
    with tempfile.TemporaryDirectory() as td:
        home = _synthetic_home(work, td)
        n = build(work, home)
        want=_expect_version()
        good=n["version"]==want and n["changelog_top"]
        print(("PASS" if good else "FAIL")+"  note built (version=%s, changelog top len=%d)"%(n["version"],len(n["changelog_top"])))
        ok=ok and good
        pristine=n["changed_files"]==[]
        print(("PASS" if pristine else "FAIL")+"  pristine tree -> 0 changed files (%d)"%len(n["changed_files"]))
        ok=ok and pristine
        # NEGATIVE half: the diff must actually SEE a divergence. Without this the
        # assertion above passes just as well when changed_files() is blind.
        victim = os.path.join(td, "victim")
        os.makedirs(os.path.join(victim, "bulk_downloader"))
        for p, rel, _t in sec.iter_py(work, strict=True, label="--work/--tree"):
            dst = os.path.join(victim, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "wb") as fh:
                fh.write(open(p, "rb").read())
        tgt = os.path.join(victim, "bulk_downloader", "__init__.py")
        with open(tgt, "ab") as fh:
            fh.write(b"\n# selftest divergence\n")
        n2 = build(victim, home)
        saw = "bulk_downloader/__init__.py" in (n2["changed_files"] or [])
        print(("PASS" if saw else "FAIL")+"  NEG: a mutated file IS reported changed (%d changed)"%len(n2["changed_files"] or []))
        ok = ok and saw
    # CANNOT-EVALUATE half: an absent --home must refuse, not compose a note
    # about nothing. This is the property the old default accidentally proved
    # and then reported as a failure; here it is asserted deliberately.
    rc = subprocess.run([sys.executable, os.path.realpath(__file__),
                         "--home", os.path.join(tempfile.gettempdir(),
                                                "bd_release_note_absent_xyz")],
                        capture_output=True, text=True).returncode
    refused = rc == sec.EXIT_CANNOT_EVALUATE
    print(("PASS" if refused else "FAIL")+"  NEG: absent --home => exit 2 (got %d)"%rc)
    ok = ok and refused
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    # v3.66.855: was /home/claude. <checkout>/out is where bd-cut --out writes a
    # release zip, so it is the only live candidate; empty is the normal case and
    # yields exit 2 rather than a note composed about nothing.
    ap.add_argument("--home",default=os.path.join(sec.DEFAULT_WORK,"out"))
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    n=build(a.work,a.home)
    if sec.emit(n,as_json=a.json): return 0
    print("=== Release note: v%s ==="%n["version"])
    print("deploy: %s"%n.get("deploy_status"))
    print("changed files vs pinned zip: %d"%len(n["changed_files"]))
    for f in n["changed_files"][:20]: print("  - %s"%f)
    if n.get("validation"): print("validation: %s"%str(n["validation"])[:160])
    print(DIM+"(changelog top + next-actions in --json)"+RST)
    return 0
sys.exit(main())
