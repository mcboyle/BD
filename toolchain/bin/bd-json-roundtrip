#!/usr/bin/env python3
"""bd-json-roundtrip -- test JSON load/save stability of stores.

For every JSON store in the tree (presets, templates, trackers, config,
sessions, manifests), verify json.loads(json.dumps(load(f))) == load(f) --
i.e. a load/save round-trip is lossless and stable (no key reordering data
loss, no float/precision drift, no non-serializable content). A store that
doesn't round-trip -> BD-JSON-UNSTABLE. Read-only.

Usage: bd-json-roundtrip [--work DIR] [--json] [--selftest]
Exit 1 if any store is unstable, else 0.
"""
import argparse, glob, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def scan(work):
    findings=[]; checked=0
    for f in glob.glob(os.path.join(work,"**","*.json"),recursive=True):
        if "node_modules" in f: continue
        try: obj=json.load(open(f))
        except Exception as e:
            findings.append({"file":os.path.relpath(f,work),"issue":"unparseable: %s"%e}); continue
        checked+=1
        try:
            rt=json.loads(json.dumps(obj))
            if rt != obj:
                findings.append({"file":os.path.relpath(f,work),"issue":"round-trip mismatch"})
        except Exception as e:
            findings.append({"file":os.path.relpath(f,work),"issue":"not re-serializable: %s"%e})
    return findings, checked

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        json.dump({"a":1,"b":[1,2,{"c":3}],"d":"x"},open(os.path.join(d,"good.json"),"w"))
        open(os.path.join(d,"bad.json"),"w").write('{"a": 1,,}')  # malformed
        f,c=scan(d)
    files={os.path.basename(x["file"]) for x in f}
    good="good.json" not in files and "bad.json" in files
    print(("PASS" if good else "FAIL")+"  good round-trips, malformed flagged (%s)"%sorted(files))
    ok=ok and good
    r=scan(sec.DEFAULT_WORK)
    print(("PASS" if r[1]>0 else "WARN")+"  real tree: %d stores checked, %d unstable"%(r[1],len(r[0])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    f,c=scan(a.work)
    if sec.emit({"findings":f,"summary":{"checked":c,"unstable":len(f)}},as_json=a.json): return 1 if f else 0
    print("%d JSON store(s) checked; %d unstable"%(c,len(f)))
    for x in f[:40]: print("  %sBD-JSON-UNSTABLE%s %s: %s"%(R,RST,x["file"],x["issue"]))
    if not f: print(G+"all JSON stores round-trip losslessly"+RST)
    return 1 if f else 0
sys.exit(main())
