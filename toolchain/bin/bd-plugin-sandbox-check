#!/usr/bin/env python3
"""bd-plugin-sandbox-check -- verify plugin isolation settings.

Inspects the node/python plugin bridges (plugin_node/plugin_py_bridge/
plugin_exec) for the isolation controls that should be present: a subprocess
timeout, a restricted env, no shell=True, and a bounded output size. A bridge
that spawns a plugin without a timeout or with shell=True -> BD-SANDBOX-WEAK.
Read-only, heuristic over the real bridge source.

Usage: bd-plugin-sandbox-check [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
BRIDGES=["plugin_node.py","plugin_py_bridge.py","plugin_exec.py"]

def scan(work):
    findings=[]; checked=0
    for name in BRIDGES:
        p=os.path.join(work,"bulk_downloader",name)
        if not os.path.exists(p): continue
        checked+=1
        txt=open(p,errors="ignore").read()
        spawns=re.search(r'subprocess\.(Popen|run|call)|asyncio\.create_subprocess',txt)
        if not spawns: continue
        if "shell=True" in txt:
            findings.append({"file":name,"issue":"spawns with shell=True"})
        if not re.search(r'\btimeout\s*=',txt):
            findings.append({"file":name,"issue":"subprocess spawn without a timeout="})
    return findings, checked

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b=os.path.join(d,"bulk_downloader"); os.makedirs(b)
        open(os.path.join(b,"plugin_node.py"),"w").write("import subprocess\nsubprocess.run(cmd, shell=True)\n")
        open(os.path.join(b,"plugin_exec.py"),"w").write("import subprocess\nsubprocess.run(cmd, timeout=30)\n")
        f,c=scan(d)
    issues=" ".join(x["issue"] for x in f)
    good="shell=True" in issues and any("plugin_node" in x["file"] and "timeout" in x["issue"] for x in f) and not any("plugin_exec" in x["file"] for x in f)
    print(("PASS" if good else "FAIL")+"  shell=True + no-timeout flagged, timeout-guarded clean (%d)"%len(f))
    ok=ok and good
    r=scan(sec.DEFAULT_WORK)
    print(("PASS" if r[1]>=0 else "FAIL")+"  real tree: %d bridges checked, %d issues"%(r[1],len(r[0])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    f,c=scan(a.work)
    if sec.emit({"findings":f,"summary":{"bridges":c,"weak":len(f)}},as_json=a.json): return 0
    print("%d plugin bridge(s) checked; %d isolation issue(s):"%(c,len(f)))
    for x in f[:40]: print("  %sBD-SANDBOX-WEAK%s %s: %s"%(Y,RST,x["file"],x["issue"]))
    if not f: print(G+"plugin bridges have timeout + no shell=True"+RST)
    return 0
sys.exit(main())
