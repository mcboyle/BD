#!/usr/bin/env python3
"""bd-fleet-run -- run one command across the operator's VM fleet, safely.

WHAT IT IS FOR. The operator drives several test VMs over ssh and needs a
command applied consistently across them with per-host output retained. That is
a live capability, not a convenience: model subagents are not an equivalent,
because they do not hold the ssh control path and cannot leave an artifact the
operator can re-read afterwards.

WHY IT WAS REWRITTEN AT v3.66.1142. The v3.66.1140 implementation was unsafe in
ways that a green test suite actively concealed:

  * `--selftest` built a fleet file naming `alpha 192.0.2.10` and drove main()
    through the "unwritable artifact root" refusal. That refusal held ONLY
    because `mkdir /proc/cannot/write/here` fails on procfs. Had it succeeded,
    control fell through the manifest write into run_one(), whose `label == me`
    test is False for "alpha", and reached
        ssh -o BatchMode=yes -o ConnectTimeout=10 192.0.2.10 ...
    `tests/test_toolchain_534.py` runs that selftest and sits in ci.yml's
    `toolchain` shard, so the fixture executed on GitHub-hosted runners on every
    PR. No egress ever occurred -- procfs held on the box and on the runners --
    but the property was enforced by the FILESYSTEM, never by the code. That is
    CLAUDE.md section 0's whole subject: a guard that reports safe for a reason
    unrelated to the thing it claims to guard.
  * The test that was supposed to catch a bypass could not. It asserted a LOCAL
    marker path stayed absent, while the command it guarded would have run on
    the REMOTE.
  * `prune()` would `shutil.rmtree` ANY subdirectory of `--root`, with no
    ownership check. `--root ~` deleted home directories. That is the identical
    two-definitions defect v3.66.1136 fixed in `bd-run`, reintroduced four cuts
    later.
  * Locality was inferred from `label == socket.gethostname()`. A fleet label is
    not a hostname -- CLAUDE.md's front matter records `bd-jobs` refusing a real
    host because a LABEL had no DNS entry -- so the inference is wrong in both
    directions and silently decides whether a command runs here or there.
  * Labels went into paths unvalidated; duplicate labels and same-second run ids
    collided; there was no concurrency cap; no commit was recorded.

THE STRUCTURAL FIX, and it is the only one that makes the tests trustworthy:
ALL process execution goes through an INJECTED runner. `main()` takes
`runner=`; nothing else in the module calls `subprocess`. A test supplies a fake
that records argv and can never open a socket, so "this test cannot reach the
network" is a property of the wiring rather than of a fixture's luck. The real
`SubprocessRunner` is constructed ONLY on the `--execute` path.

SAFETY POSTURE:
  * plan/dry-run is the DEFAULT; `--execute` is required to touch a host;
  * the resolved target list and the exact command print before anything runs;
  * locality is read from the inventory, never inferred;
  * artifact roots reject `/`, `$HOME`, any git work tree, traversal and
    symlink escapes; run directories carry an ownership sentinel and prune
    refuses anything without one;
  * ssh host-key verification is never weakened; there is no
    StrictHostKeyChecking=no and there must never be one;
  * an unknown or failed host outcome never becomes success.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import datetime
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import time

HERE = pathlib.Path(__file__).resolve().parent
DEFAULT_HOSTS = pathlib.Path.home() / ".config" / "bd" / "hosts"
# A FIXED SAFE BASE. Not the repo, not $HOME itself, not /tmp.
DEFAULT_ROOT = pathlib.Path.home() / ".local" / "share" / "bd-fleet-run" / "runs"
DEFAULT_KEEP = 20
DEFAULT_JOBS = 8

# A label becomes a path component, so it gets a restrictive filename grammar.
LABEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$")
# UTC stamp + entropy: two runs in the same second cannot collide.
RUN_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{8}$")
SENTINEL = ".bd-fleet-run-owned"
# Addresses are handed to ssh as argv, never to a shell -- but a value carrying
# whitespace, a shell metacharacter or an option-leading dash is an inventory
# defect worth refusing rather than normalising.
ADDR_BAD = re.compile(r"[\s;&|<>`$(){}\[\]'\"\\]|^-")

BLIND_SPOTS = (
    "the summary line is derived from the log's TAIL. A failure earlier in a "
    "run that ends cleanly is in the artifact but not in the summary.",
    "the exit code is the remote shell's; a pipeline on the far side masks it "
    "exactly as it does locally.",
    "ssh exit 255 cannot distinguish unreachable from authentication failure. "
    "It is reported as UNREACHABLE_OR_AUTH and never as a success.",
    "the recorded remote commit is what the host reported at run time; it does "
    "not prove the command READ that tree.",
)


class SubprocessRunner:
    """The only place in this module that starts a process."""

    name = "subprocess"

    def run(self, argv, log_path, timeout):
        """Return (returncode, error_or_None). Complete output -> log_path."""
        with open(log_path, "wb") as fh:
            try:
                p = subprocess.run(argv, stdout=fh, stderr=subprocess.STDOUT,
                                   stdin=subprocess.DEVNULL, timeout=timeout)
            except subprocess.TimeoutExpired:
                return None, f"TIMEOUT after {timeout}s"
            except FileNotFoundError as exc:
                return None, f"launcher missing: {exc}"
        return p.returncode, None


class Refusal(Exception):
    """A refusal names its own reason.

    Every refusal here exits 2, so a test asserting the CODE passes when any of
    them fires -- four mutants escaped exactly that way in bd-jobs and bd-ab
    (CLAUDE.md section 10). The message is the contract; tests assert on it.
    """


def _load_bd_fleet():
    """Import read_hosts from bd-fleet. ONE definition of the fleet file.

    bd-fleet is extensionless, so a plain import cannot reach it -- the
    population CLAUDE.md section 1 warns a `*.py` glob misses.
    """
    path = HERE / "bd-fleet"
    if not path.is_file():
        return None
    loader = importlib.machinery.SourceFileLoader("bd_fleet_for_run", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


# --------------------------------------------------------------- inventory

def read_locality(path: pathlib.Path) -> dict:
    """Optional THIRD column of the fleet file: `local` marks local execution.

    Locality is INVENTORY DATA, never an inference. `bd-fleet`'s read_hosts
    takes parts[0]/parts[1] and `scripts/deploy_fleet.sh` reads
    `label addr _rest`, so both already ignore a third field -- this extends the
    format without forking the parser that decides MEMBERSHIP.
    """
    out = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 3:
            out[parts[0]] = parts[2].lower() == "local"
        elif len(parts) >= 1:
            out.setdefault(parts[0], False)
    return out


def resolve_targets(hosts, locality):
    """Validate labels and addresses; dedupe addresses; report what was dropped.

    Returns (targets, collapsed) where targets is [(label, addr, is_local)].
    """
    if not hosts:
        raise Refusal("the fleet file lists no hosts. An empty fleet must not "
                      "report as a successful run of nothing.")

    seen_labels = set()
    for label, _addr in hosts:
        if not LABEL_RE.match(label):
            raise Refusal(
                f"label {label!r} is not filename-safe. A label becomes a path "
                "component; it must match [A-Za-z0-9][A-Za-z0-9._-]{0,62} and "
                "must not be absolute, contain a separator, '..', or control "
                "characters.")
        if label in seen_labels:
            raise Refusal(
                f"duplicate label {label!r} in the fleet file. Two hosts "
                "sharing a label would overwrite each other's log.")
        seen_labels.add(label)

    targets, collapsed, seen_addr = [], [], {}
    for label, addr in hosts:
        if not addr or ADDR_BAD.search(addr):
            raise Refusal(
                f"address {addr!r} for {label!r} is not a plain host address.")
        if addr in seen_addr:
            collapsed.append((label, addr, seen_addr[addr]))
            continue
        seen_addr[addr] = label
        targets.append((label, addr, bool(locality.get(label, False))))
    return targets, collapsed


# --------------------------------------------------------------- artifacts

def validate_root(raw_root: str) -> pathlib.Path:
    """Refuse broad or escaping artifact roots.

    Checked on the REALPATH, so a symlink cannot smuggle the base somewhere
    forbidden, and on the raw string, so traversal is refused before resolution.
    """
    if ".." in pathlib.PurePath(raw_root).parts:
        raise Refusal(f"artifact root {raw_root!r} contains '..'.")
    root = pathlib.Path(raw_root).expanduser()
    real = pathlib.Path(os.path.realpath(root))
    home = pathlib.Path(os.path.realpath(pathlib.Path.home()))

    if str(real) == os.sep:
        raise Refusal("artifact root '/' is refused.")
    if real == home:
        raise Refusal("artifact root is the home directory itself; prune would "
                      "be able to remove unrelated directories under it.")
    if len(real.parts) < 4:
        # parts[0] is '/', so this requires at least three components.
        raise Refusal(
            f"artifact root {str(real)!r} is too broad; give a dedicated "
            "directory, not a top-level one.")
    probe = real
    while True:
        if (probe / ".git").exists():
            raise Refusal(
                f"artifact root {str(real)!r} is inside the git work tree at "
                f"{str(probe)!r}. Run artifacts must not land in a repository.")
        if probe.parent == probe:
            break
        probe = probe.parent
    return real


def new_run_id(now=None) -> str:
    """UTC stamp plus entropy -- collision-safe within the same second."""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    return now.strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(4)


def prune(base: pathlib.Path, keep: int) -> list:
    """Remove old runs. ONLY tool-owned directories, ever.

    Three conditions, all required: the entry resolves BENEATH the artifact
    base, its name matches the run-id grammar, and it carries the ownership
    sentinel. The v3.66.1140 version had none of these and would rmtree any
    subdirectory of --root.
    """
    if keep <= 0 or not base.is_dir():
        return []
    base_real = pathlib.Path(os.path.realpath(base))
    owned = []
    for entry in base.iterdir():
        if not entry.is_dir() or entry.is_symlink():
            continue
        if not RUN_RE.match(entry.name):
            continue
        if not (entry / SENTINEL).is_file():
            continue
        real = pathlib.Path(os.path.realpath(entry))
        if real.parent != base_real:
            continue                      # symlink escape
        owned.append(entry)
    owned.sort(key=lambda p: p.name, reverse=True)
    dropped = []
    for entry in owned[keep:]:
        shutil.rmtree(entry, ignore_errors=True)
        dropped.append(entry.name)
    return dropped


# --------------------------------------------------------------- execution

def build_argv(label, addr, is_local, command, connect_timeout=10):
    """The exact argv. No shell on this side; ssh host-key checking intact.

    NEVER add StrictHostKeyChecking=no here. Disabling host-key verification
    turns a fleet runner into a machine that will execute the operator's
    commands against whatever answers on that address.
    """
    if is_local:
        return ["bash", "-c", command]
    return ["ssh", "-n", "-o", "BatchMode=yes",
            "-o", f"ConnectTimeout={connect_timeout}", addr,
            "bash -c %s" % shlex.quote(command)]


def classify(rc, err):
    if err and "TIMEOUT" in err:
        return "TIMEOUT"
    if err:
        return "ERROR"
    if rc == 0:
        return "ok"
    if rc == 255:
        return "UNREACHABLE_OR_AUTH"
    return "FAIL"


def run_one(runner, label, addr, is_local, command, logdir, timeout,
            record_commit):
    log = logdir / f"{label}.log"
    started = time.time()
    if record_commit:
        # Which tree did this run against? A host two cuts behind returns exit 0
        # for a command measuring the wrong source. Rides the SAME connection.
        wrapped = ("printf 'bd-fleet-run: commit=%s dirty=%s\\n' "
                   "\"$(git -C \"$PWD\" rev-parse --short HEAD 2>/dev/null || echo unknown)\" "
                   "\"$(git -C \"$PWD\" status --porcelain 2>/dev/null | wc -l)\"; "
                   + command)
    else:
        wrapped = command
    argv = build_argv(label, addr, is_local, wrapped)
    rc, err = runner.run(argv, log, timeout)
    return {"label": label, "addr": addr, "via": "local" if is_local else "ssh",
            "exit": rc, "error": err, "status": classify(rc, err),
            "wall": round(time.time() - started, 1),
            "log": str(log), "argv": argv,
            "bytes": log.stat().st_size if log.exists() else 0}


def summarise(row, pattern=None):
    tail = ""
    p = pathlib.Path(row["log"])
    if p.is_file() and row["bytes"]:
        lines = [l.rstrip() for l in p.read_text(errors="replace").splitlines()
                 if l.strip()]
        if pattern:
            hits = [l for l in lines if pattern in l]
            tail = hits[-1] if hits else f"(no match for {pattern!r})"
        elif lines:
            tail = lines[-1]
    code = "--" if row["exit"] is None else str(row["exit"])
    return (f"  {row['label']:12} {row['status']:20} exit={code:<5}"
            f" {row['wall']:7.1f}s {row['bytes']:>9,}b  "
            f"{(row['error'] or tail)[:70]}")


# --------------------------------------------------------------- main

def main(argv=None, runner=None) -> int:
    ap = argparse.ArgumentParser(
        description="Run one command across the fleet. Plans by default; "
                    "--execute is required to contact a host.")
    ap.add_argument("--hosts", default=str(DEFAULT_HOSTS))
    ap.add_argument("--root", default=str(DEFAULT_ROOT))
    ap.add_argument("--timeout", type=int, default=1800)
    ap.add_argument("--jobs", type=int, default=DEFAULT_JOBS)
    ap.add_argument("--keep", type=int, default=DEFAULT_KEEP)
    ap.add_argument("--grep", help="display filter only; capture is always whole")
    ap.add_argument("--only", help="comma-separated labels")
    ap.add_argument("--execute", action="store_true",
                    help="actually contact the hosts (default is plan only)")
    ap.add_argument("--no-record-commit", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("command", nargs=argparse.REMAINDER)
    args = ap.parse_args(argv)

    if args.selftest:
        return selftest()

    try:
        return _run(args, runner)
    except Refusal as exc:
        print(f"bd-fleet-run: REFUSED: {exc}", file=sys.stderr)
        return 2


def _run(args, runner) -> int:
    # argparse.REMAINDER KEEPS the `--`. bd-jobs shipped without stripping it
    # and sent bash `-c "-- sleep 90"` on its first real use.
    parts = list(args.command)
    while parts and parts[0] == "--":
        parts.pop(0)
    command = " ".join(parts).strip()
    if not command:
        raise Refusal("no command given. Usage: bd-fleet-run -- <command>")

    hosts_path = pathlib.Path(args.hosts).expanduser()
    if not hosts_path.is_file():
        raise Refusal(f"no fleet file at {hosts_path} -- it is untracked; copy "
                      "docs/repo/hosts.example there.")
    mod = _load_bd_fleet()
    if mod is None or not hasattr(mod, "read_hosts"):
        raise Refusal(f"cannot load read_hosts from {HERE / 'bd-fleet'}. "
                      "Reimplementing the fleet parser here would be a second "
                      "definition of the inventory; refusing instead.")
    try:
        hosts = mod.read_hosts(str(hosts_path))
    except Exception as exc:
        raise Refusal(f"{hosts_path}: {exc}")

    locality = read_locality(hosts_path)
    targets, collapsed = resolve_targets(hosts, locality)

    if args.only:
        want = {s.strip() for s in args.only.split(",") if s.strip()}
        targets = [t for t in targets if t[0] in want]
        if not targets:
            raise Refusal(f"--only {args.only} matched no host in {hosts_path}")

    if args.jobs < 1:
        raise Refusal("--jobs must be at least 1")
    base = validate_root(args.root)

    # THE PLAN PRINTS BEFORE ANYTHING RUNS, on both paths.
    print(f"bd-fleet-run: {'EXECUTE' if args.execute else 'PLAN (dry-run)'}"
          f"  {len(targets)} target(s), jobs={min(args.jobs, len(targets))}")
    print(f"  command: {command}")
    print(f"  artifacts base: {base}")
    for label, addr, is_local in targets:
        where = "LOCAL" if is_local else f"ssh {addr}"
        print(f"    {label:12} {where}")
        print(f"      argv: {' '.join(shlex.quote(a) for a in build_argv(label, addr, is_local, command))}")
    for label, addr, kept in collapsed:
        print(f"  NOTE: {label} collapsed -- address {addr} already covered by {kept}")

    if not args.execute:
        print("\n  PLAN ONLY. No host was contacted and no process was started.")
        print("  Re-run with --execute to apply.")
        return 0

    # PROVE THE RECORD CAN BE WRITTEN BEFORE ANYTHING RUNS. bd-jobs existed to
    # prevent untracked work and, on its first live invocation, launched and
    # THEN failed to register.
    run_id = new_run_id()
    logdir = base / run_id
    try:
        logdir.mkdir(parents=True, exist_ok=False)
        (logdir / SENTINEL).write_text(json.dumps({"tool": "bd-fleet-run"}))
        (logdir / "manifest.json").write_text(json.dumps({
            "run_id": run_id, "command": command,
            "targets": [{"label": l, "addr": a, "local": lo}
                        for l, a, lo in targets],
            "timeout": args.timeout, "jobs": args.jobs,
            "local_head": _local_head(),
        }, indent=2))
    except Refusal:
        raise
    except Exception as exc:
        raise Refusal(f"artifact root {logdir} is not writable ({exc}). A run "
                      "whose output cannot be recorded is not launched.")

    if runner is None:
        runner = SubprocessRunner()
    print(f"\n  run: {logdir}  (runner={getattr(runner, 'name', type(runner).__name__)})")

    rows = []
    with concurrent.futures.ThreadPoolExecutor(
            max_workers=min(args.jobs, len(targets))) as pool:
        futs = {pool.submit(run_one, runner, l, a, lo, command, logdir,
                            args.timeout, not args.no_record_commit): l
                for l, a, lo in targets}
        for f in concurrent.futures.as_completed(futs):
            rows.append(f.result())
    order = [t[0] for t in targets]
    rows.sort(key=lambda r: order.index(r["label"]))

    print(f"\n  {'host':12} {'status':20} {'exit':<6} {'wall':>7} {'stored':>10}")
    for r in rows:
        print(summarise(r, args.grep))
    (logdir / "summary.json").write_text(json.dumps(rows, indent=2))

    bad = [r for r in rows if r["status"] != "ok"]
    print(f"\n  {len(rows) - len(bad)}/{len(rows)} host(s) ok."
          f"  Full output: {logdir}/<host>.log")
    if bad:
        # Partial fleet failure is explicit and never becomes success.
        print("  NOT OK: " + ", ".join(f"{r['label']}={r['status']}" for r in bad))
    dropped = prune(base, args.keep)
    if dropped:
        print(f"  retention: removed {len(dropped)} owned run(s), keeping {args.keep}")

    print("\n=== WHAT THIS RUN CANNOT TELL YOU ===")
    for i, s in enumerate(BLIND_SPOTS, 1):
        print(f"  {i}. {s}")
    return 1 if bad else 0


def _local_head():
    try:
        r = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
                           capture_output=True, text=True, timeout=10)
        return r.stdout.strip() or "unknown"
    except Exception:
        return "unknown"


# --------------------------------------------------------------- selftest

class _FakeRunner:
    """Records argv; starts nothing. The hermetic guarantee lives here."""

    name = "fake"

    def __init__(self, rc=0, err=None, body="fake output\n"):
        self.calls = []
        self._rc, self._err, self._body = rc, err, body

    def run(self, argv, log_path, timeout):
        self.calls.append({"argv": list(argv), "timeout": timeout})
        pathlib.Path(log_path).write_text(self._body)
        return self._rc, self._err


def selftest() -> int:
    """Hermetic. Constructs no SubprocessRunner and starts no process.

    The v3.66.1140 selftest called main() with a real fleet file and relied on a
    procfs mkdir failing to keep it off the network. This one injects a fake
    runner on every execute path, so no code path here can reach ssh.
    """
    import tempfile
    fails = []

    def check(ok, msg):
        print(("  ok   " if ok else "  FAIL ") + msg)
        if not ok:
            fails.append(msg)

    with tempfile.TemporaryDirectory() as td:
        tmp = pathlib.Path(td)
        base = tmp / "a" / "runs"          # deep enough to pass validate_root
        hosts = tmp / "hosts"
        hosts.write_text("alpha 10.0.0.1\nbeta 10.0.0.2 local\n")

        fake = _FakeRunner()
        rc = main(["--hosts", str(hosts), "--root", str(base), "--execute",
                   "--", "echo", "hi"], runner=fake)
        check(rc == 0, f"an execute run through the fake returns 0 (got {rc})")
        check(len(fake.calls) == 2, f"one call per host (got {len(fake.calls)})")
        check(all(c["argv"][0] in ("ssh", "bash") for c in fake.calls),
              "every launch is ssh or bash and nothing else")
        ssh_calls = [c for c in fake.calls if c["argv"][0] == "ssh"]
        check(len(ssh_calls) == 1, "the non-local host used ssh")
        check(not any("StrictHostKeyChecking" in a for a in ssh_calls[0]["argv"]),
              "host-key verification is never disabled")
        check(any(c["argv"][0] == "bash" for c in fake.calls),
              "the inventory-declared local host ran locally")

        dry = _FakeRunner()
        rc = main(["--hosts", str(hosts), "--root", str(base),
                   "--", "echo", "hi"], runner=dry)
        check(rc == 0 and dry.calls == [],
              f"dry-run is the DEFAULT and starts nothing (calls={len(dry.calls)})")

        bad = tmp / "badhosts"
        bad.write_text("../evil 10.0.0.9\n")
        v = _FakeRunner()
        rc = main(["--hosts", str(bad), "--root", str(base), "--execute",
                   "--", "true"], runner=v)
        check(rc == 2 and v.calls == [],
              "a traversal label refuses with zero launches")

        rc = main(["--hosts", str(hosts), "--root", "/", "--execute",
                   "--", "true"], runner=v)
        check(rc == 2 and v.calls == [], "artifact root '/' refuses, no launch")

        owned = base / "20260101T000000Z-aaaaaaaa"
        owned.mkdir(parents=True, exist_ok=True)
        (owned / SENTINEL).write_text("{}")
        foreign = base / "please-do-not-delete-me"
        foreign.mkdir(parents=True, exist_ok=True)
        prune(base, 0)
        check(foreign.is_dir(), "prune(keep=0) leaves an unowned directory alone")

    if fails:
        print(f"\nSELFTEST FAIL: {len(fails)} check(s) failed")
        for f in fails:
            print(f"  - {f}")
        return 1
    print("\nSELFTEST PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
