#!/usr/bin/env python3
"""bd-secrets -- lightweight committed-secret scan of the source tree.

detect-secrets-lite: flags likely API keys / tokens / private keys accidentally
in source. Advisory (heuristic; expect some false positives). Read-only.
Usage: bd-secrets [--work DIR]   Exit 1 if any high-confidence hit.
"""
import argparse, glob, os, re, sys
R,Y,DIM,G,RST="\033[31m","\033[33m","\033[2m","\033[32m","\033[0m"
PATS=[("private key",re.compile(r'-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----')),
      ("aws akid",re.compile(r'AKIA[0-9A-Z]{16}')),
      ("bearer/jwt",re.compile(r'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{6,}')),
      ("generic secret assign",re.compile(r'(?i)(secret|token|api[_-]?key|password)\s*=\s*["\'][A-Za-z0-9/+=_-]{16,}["\']'))]
SKIP=("test","fixture","example","sample","mock","__pycache__","node_modules")
def selftest():
    """IMPORT-OK: secret-pattern scan with no independent fault surface. Structural check
    only -- the module parsed and exposes main(); this is the weakest selftest
    kind and says so."""
    ok = "main" in globals() and callable(main)
    print(("PASS" if ok else "FAIL") + "  module structural check (main present)")
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap=argparse.ArgumentParser(); ap.add_argument("--work","--tree",default="/home/claude/work"); a=ap.parse_args()
    hi=0; hits=[]
    for f in glob.glob(os.path.join(a.work,"bulk_downloader","**","*.py"),recursive=True):
        low=f.lower()
        try: txt=open(f,errors="ignore").read()
        # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
        except Exception: continue
        for name,pat in PATS:
            for m in pat.finditer(txt):
                skip=any(s in low for s in SKIP)
                hits.append((name,os.path.relpath(f,a.work),m.group(0)[:32],skip))
                if not skip and name!="generic secret assign": hi+=1
    if not hits: print(f"{G}no secrets detected in bulk_downloader/{RST}"); return 0
    for name,rel,snip,skip in hits[:30]:
        tag=DIM+"(test/fixture)"+RST if skip else R+"REVIEW"+RST
        print(f"  {tag} {name}: {rel}  {DIM}{snip}{RST}")
    print((f"{R}{hi} high-confidence hit(s) -- review{RST}" if hi else f"{Y}only low-confidence/test hits{RST}"))
    return 1 if hi else 0
sys.exit(main())
