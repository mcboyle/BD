#!/usr/bin/env python3
"""bd-interface-contracts -- generate subsystem interface contracts.

Emits a machine-readable contract per subsystem boundary: the ROUTE contract
(method+path+csrf from ENDPOINT_CATALOG), the CONFIG contract (BD_ env vars +
config keys the subsystem reads), and the PLUGIN capability contract (known
caps). These are the stable interfaces a decomposition must preserve; the output
feeds bd-contract-testgen. Read-only.

Usage: bd-interface-contracts [--work DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def build(work):
    routes=sec.parse_endpoint_catalog(work)
    route_contract=[{"method":r.get("method"),"path":r.get("path"),"csrf":r.get("csrf")} for r in routes]
    envs=set()
    for _p,_rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        envs |= set(re.findall(r'\bBD_[A-Z0-9_]+\b',txt))
    caps=["extractor","hook","processor","config","lifecycle","page_access","recognizer","prefilter","namer"]
    return {"schema":"bd-interface-contracts/1",
            "route_contract":route_contract,
            "config_contract":sorted(envs),
            "plugin_capability_contract":caps,
            "summary":{"routes":len(route_contract),"config_keys":len(envs),"caps":len(caps)}}

def selftest():
    ok=True
    c=build(sec.DEFAULT_WORK)
    print(("PASS" if c["summary"]["routes"]>100 else "FAIL")+"  route contract (%d)"%c["summary"]["routes"])
    ok=ok and c["summary"]["routes"]>100
    print(("PASS" if c["summary"]["config_keys"]>0 else "FAIL")+"  config contract (%d keys)"%c["summary"]["config_keys"])
    ok=ok and c["summary"]["config_keys"]>0
    print(("PASS" if len(c["plugin_capability_contract"])==9 else "FAIL")+"  plugin cap contract (9)")
    ok=ok and len(c["plugin_capability_contract"])==9
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    c=build(a.work)
    import json as _j
    _j.dump(c,sys.stdout,indent=2); sys.stdout.write(chr(10))
    return 0
if __name__ == "__main__":
    sys.exit(main())
