#!/usr/bin/env python3
import sys
import os
import subprocess
import json
"""bd-brief -- the session-start context loader (run this FIRST, every session).

Fights three review failures at once:
  * STALE MEMORY (version/guards/counts drift): DERIVES the volatile facts from
    source live -- never trust a remembered number.
  * FORGOTTEN FOOTGUNS: prints the active executable footgun registry (which the
    pre-cut gate enforces) so the hard-won lessons are in front of you, armed.
  * IMAGINARY BARRIER (G-1): probes which gates actually run in THIS sandbox +
    kernel/tool capability, so nothing gets mis-filed 'on-stash-only' or 'deferred'
    when it is runnable here.

Read-only. Usage: bd-brief [--tree DIR] [--json]
"""
import argparse, glob, hashlib, json, os, re, shutil, subprocess, sys, tempfile

GUARDS = ["bulk_downloader/extraction_core.py", "bulk_downloader/session_capture.py",
          "bulk_downloader/dom_capture.py", "bulk_downloader/dom_recorder.py",
          "bulk_downloader/capture_bodies.py", "tools/capture_session.py",
          "tools/build_release.py"]


def _version(tree):
    for f in ("bulk_downloader/__init__.py", "bulk_downloader/_version.py"):
        p = os.path.join(tree, f)
        if os.path.isfile(p):
            m = re.search(r'__version__\s*=\s*["\']([0-9.]+)["\']', open(p, errors="ignore").read())
            if m:
                return m.group(1)
    return "?"


def _sha(p):
    try:
        return hashlib.sha256(open(p, "rb").read()).hexdigest()[:8]
    except OSError:
        return "MISSING"


def _routes(tree):
    """(route_rows, unique_paths, spa_wired) from ROUTE_INDEX.json.

    v3.66.714: THREE route numbers circulate in this project and none of them stated
    its unit, so they looked like drift when they were simply counting different things:

        971  unique path strings
       1000  url_map Rule objects (an aliased path registers a second Rule)
       1012  ROUTE_INDEX rows == (path x METHOD) pairs -- 37 paths carry >1 method

    All three are correct. A number without its unit is not a fact, it is an argument
    waiting to happen, so this now reports the unit and both figures.
    """
    p = os.path.join(tree, "ROUTE_INDEX.json")
    if not os.path.isfile(p):
        return None, None, None
    try:
        d = json.load(open(p))
        rows = d.get("routes", []) if isinstance(d, dict) else d
        if not isinstance(rows, list):
            return None, None, None
        n = len(rows)
        uniq = len({(r.get("rule") or r.get("path")) for r in rows
                    if isinstance(r, dict)})
        wired = sum(1 for r in rows if isinstance(r, dict) and r.get("spa_wired"))
        return n, uniq, wired
    except Exception:  # why: input unavailable/unreadable; return None(s) so the caller uses its fallback, not a wrong value
        return None, None, None


def _footguns(tree):
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-footguns")
    if not os.path.isfile(exe):
        return None
    try:
        r = subprocess.run([sys.executable, exe, "--list", "--json", "--tree", tree],
                           capture_output=True, text=True, timeout=30)
        return json.loads(r.stdout)
    except Exception as e:  # noqa: BLE001
        # v3.66.754: this returned None and the caller printed
        # "Armed footguns (0 blocking + 0 advisory)" -- a session told it was standing on
        # NOTHING, in the calm voice of a successful load. An unreadable registry is UNKNOWN,
        # not empty. Say so, loudly, and let the caller show it.
        # NOTE: no colour constants here -- R/RST are locals of main(), and a NameError
        # on the FAILURE path would be a fail-open inside the fail-open fix.
        print("  FOOTGUN REGISTRY UNREADABLE (%s: %s) -- the armed list is NOT 'none', "
              "it is UNKNOWN. Fix this before cutting." % (type(e).__name__, e),
              file=sys.stderr)
        return None


def _capability(tree):
    caps = {}
    # env-tranche gate: is config_surface_inventory importable here?
    try:
        sys.path.insert(0, os.path.join(tree, "tools"))
        sys.path.insert(0, "/tmp/prestaged_site_packages")
        __import__("config_surface_inventory")
        caps["env_tranche_gate_runs_in_sandbox"] = True
    except Exception:  # why: operation failed; degrade to the default and continue -- correctness unaffected, only completeness
        caps["env_tranche_gate_runs_in_sandbox"] = False
    caps["is_root"] = (os.geteuid() == 0)
    caps["netns_toolchain"] = {t: bool(shutil.which(t)) for t in ("ip", "nft", "wg")}
    # can we actually make a netns? (cheap real probe)
    #
    # TRI-STATE, and the third state is the point. `ip` absent does NOT mean the
    # capability is unavailable -- it means the pack that CARRIES it (pack_G) has
    # not been installed yet. Those are different claims with different remedies,
    # and the old code collapsed them into a definite False that rendered as "no".
    # The probe then answered a question whose denominator structurally excluded
    # the thing being asked about: it reported a capability CEILING for a state
    # that was one `bd-optpack install G --apt` away. Measured @805: bd-boot runs
    # before optpack, so the session-opening brief said "no" while netns creation
    # actually succeeded (`ip netns add` exit=0, root) the moment G landed -- and
    # nothing re-derived it, so the false negative outlived its own cause.
    # UNKNOWN is a third state and it fails OPEN: it must never read as "cannot".
    if shutil.which("ip"):
        ns = "bd_brief_probe"
        subprocess.run(["ip", "netns", "del", ns], capture_output=True)
        r = subprocess.run(["ip", "netns", "add", ns], capture_output=True)
        caps["can_create_netns"] = (r.returncode == 0)
        # PROBED: a False here is a real refusal (no CAP_NET_ADMIN) and must stay
        # a False. The fix must not launder a true negative into UNKNOWN.
        caps["netns_probe_state"] = "probed"
        subprocess.run(["ip", "netns", "del", ns], capture_output=True)
    else:
        caps["can_create_netns"] = None
        caps["netns_probe_state"] = "not_provisioned"
    caps["run_tests_harness"] = os.path.isfile(os.path.join(tree, "run_tests.py"))
    return caps


def _fg_bit(f):
    """Format the '  bit@N' suffix for a footgun row. Tolerates the polymorphic
    `provenance` field (dict / str / present-but-null) that crashed the reader at
    753 -- a non-dict yields no bit, never an AttributeError. Extracted so the
    selftest can exercise the exact path that crashed (it previously could not)."""
    p = f.get("provenance")
    if not isinstance(p, dict):
        p = {}
    return f"  bit@{p['bit_at_cut']}" if p.get("bit_at_cut") else ""


def main():
    ap = argparse.ArgumentParser(prog="bd-brief")
    ap.add_argument("--tree", "--work", default="/home/claude/work")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        ok = True
        v = _version(a.tree); print(("PASS" if v != "?" else "FAIL") + f"  version derived from source ({v})")
        ok = ok and v != "?"
        rc, uq, sw = _routes(a.tree); print(("PASS" if isinstance(rc, int) else "FAIL") + f"  route_count derived ({rc} rows / {uq} paths / {sw} wired)")
        ok = ok and isinstance(rc, int)
        c = _capability(a.tree); print(("PASS" if "env_tranche_gate_runs_in_sandbox" in c else "FAIL") + "  capability probe returns")
        ok = ok and "env_tranche_gate_runs_in_sandbox" in c
        # v3.66.754c: the render loop is what crashed at 753, and the OLD selftest
        # never touched it -- it checked version/routes/capability only, so SELFTEST
        # PASS coexisted with a render that AttributeError'd on real data. Drive the
        # formatter across all three provenance shapes; a regression to a
        # non-tolerant reader raises here and fails the selftest LOUDLY.
        _shapes = [
            {"id": "FG-DICT", "provenance": {"bit_at_cut": 702}},
            {"id": "FG-STR",  "provenance": "bit@699 (a prose string)"},
            {"id": "FG-NULL", "provenance": None},
            {"id": "FG-MISSING"},
        ]
        try:
            _render_ok = ([_fg_bit(f) for f in _shapes] == ["  bit@702", "", "", ""])
        except Exception as _e:  # a non-tolerant reader raises here -- that IS the bug
            _render_ok = False
            print(f"       (render raised {type(_e).__name__}: {_e})")
        print(("PASS" if _render_ok else "FAIL") + "  footgun render tolerates dict/str/null/missing provenance")
        ok = ok and _render_ok

        # v3.66.805: the netns probe answered "no" for a tool it had never been
        # given. POS proves absent-tooling yields UNKNOWN; NEG proves a REAL
        # refusal is still a hard False -- because the cheap way to pass POS is to
        # launder every negative into UNKNOWN, which would be a worse gate than
        # the one being fixed. Both arms, or the control proves nothing.
        _real_which, _real_run = shutil.which, subprocess.run
        try:
            shutil.which = lambda _t: None
            _absent = _capability(a.tree)
            shutil.which = lambda _t: "/usr/sbin/" + _t
            subprocess.run = lambda *_a, **_k: type("R", (), {"returncode": 0})()
            _yes = _capability(a.tree)
            subprocess.run = lambda *_a, **_k: type("R", (), {"returncode": 1})()
            _no = _capability(a.tree)
        finally:
            shutil.which, subprocess.run = _real_which, _real_run
        _tri = (_absent["can_create_netns"] is None
                and _absent.get("netns_probe_state") == "not_provisioned"
                and _yes["can_create_netns"] is True
                and _no["can_create_netns"] is False)
        print(("PASS" if _tri else "FAIL")
              + "  netns capability is tri-state (absent->UNKNOWN, refusal->False)")
        ok = ok and _tri

        print("SELFTEST PASS" if ok else "SELFTEST FAIL")
        return 0 if ok else 1
    t = a.tree

    _rc, _uniq, _sw = _routes(t)
    facts = {
        "version_from_source": _version(t),
        "guards": {os.path.basename(g): _sha(os.path.join(t, g)) for g in GUARDS},
        "route_count": _rc,          # (path x method) pairs -- the ROUTE_INDEX unit
        "route_unique_paths": _uniq,  # distinct path strings
        "spa_wired": _sw,
    }
    fgs_raw = _footguns(t)
    fgs = fgs_raw or []
    active_block = [f for f in fgs if f.get("status") == "active" and f.get("severity") == "blocking"]
    advisory = [f for f in fgs if f.get("status") == "active" and f.get("severity") == "advisory"]
    caps = _capability(t)

    if a.json:
        print(json.dumps({"facts": facts, "footguns_active_blocking": len(active_block),
                          "footguns": fgs, "capability": caps}, indent=1))
        return 0

    B = "\033[1m"; RST = "\033[0m"; G = "\033[32m"; Y = "\033[33m"; R = "\033[31m"
    print(f"{B}=== BD SESSION BRIEF :: {t} ==={RST}")
    print(f"{B}Ground truth (DERIVED from source -- do not trust remembered numbers):{RST}")
    print(f"  version (source)   : {facts['version_from_source']}")
    print(f"  routes (path x method) : {facts['route_count']}"
          f"  |  unique paths: {facts['route_unique_paths']}"
          f"  |  spa_wired: {facts['spa_wired']}")
    miss = [k for k, v in facts["guards"].items() if v == "MISSING"]
    print(f"  guard SHAs (7)     : " + ("all present " + " ".join(f"{k.split('.')[0]}={v}" for k, v in list(facts["guards"].items())[:3]) + " ..." if not miss else R + f"MISSING {miss}" + RST))

    if fgs_raw is None:
        print(f"\n{R}Armed footguns: UNKNOWN -- the registry could not be read.{RST}")
        print(f"  {R}This is NOT 'no footguns armed'. Do not cut until it loads.{RST}")
    else:
        print(f"\n{B}Armed footguns ({len(active_block)} blocking + {len(advisory)} advisory) -- enforced by 'bd-precut --gate':{RST}")
    for f in active_block:
        # v3.66.754: `provenance` is POLYMORPHIC across the corpus -- dict (16), str (4),
        # and PRESENT-BUT-NULL (16). `f.get("provenance", {})` only defaults on a MISSING
        # key, so a str or a None both reached `.get("bit_at_cut")` and raised
        # AttributeError -- killing the loop on the FIRST non-dict. The newest footguns
        # sort LAST, so the truncation systematically ate the hazards about the work most
        # in flight: 4 blocking footguns, BOTH advisories, the whole capability map, and
        # the "Before any cut, run:" line never printed. FG-COMMENT-WIRES-A-ROUTE -- the
        # footgun armed for the very next staged cut -- was one of the four.
        # And bd-boot swallowed the traceback and still printed READY.
        bit = _fg_bit(f)
        print(f"  {G}#{RST} {f['id']}{bit}")
    for f in advisory:
        print(f"  {Y}~{RST} {f['id']}  (advisory -- no detector yet)")

    print(f"\n{B}Capability map (probe -- what actually runs HERE; do not mis-file as 'stash-only'):{RST}")
    ok = lambda b: (G + "YES" + RST) if b else (R + "no" + RST)
    print(f"  env-tranche gate in-sandbox : {ok(caps['env_tranche_gate_runs_in_sandbox'])}  (test_v3_66_319/305 runnable here)")
    # Three states, three glyphs. UNKNOWN must be visually distinct from "no" --
    # rendering them the same is how the probe's honest "I have not been given the
    # tools to answer" became a reported capability ceiling.
    def cap3(v):
        if v is True:
            return G + "YES" + RST
        if v is False:
            return R + "no" + RST
        return Y + "UNKNOWN" + RST

    _tools = ",".join(k for k, v in caps["netns_toolchain"].items() if v)
    if caps.get("netns_probe_state") == "not_provisioned":
        # Name the remedy. An UNKNOWN that does not say how to become known is
        # just a quieter "no".
        _suffix = "NOT PROBED -- pack_G absent; run 'bd-optpack install G --apt'"
    else:
        _suffix = f"ip/nft/wg: {_tools}"
    print(f"  root + CAP_NET_ADMIN netns  : {cap3(caps['can_create_netns'])}  ({_suffix})")
    print(f"  in-sync test harness        : {ok(caps['run_tests_harness'])}")

    # 702 (E4): the decomposition/arch program is the standing long work, and its
    # four lenses were orphans nobody ran. Surface the composed advisor here so a
    # session that touches the monolith is TOLD where the seams and the gates are.
    try:
        _cm = json.loads(subprocess.run(
            [sys.executable, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                          "bd-coupling-meter"), "--json"],
            capture_output=True, text=True, timeout=60).stdout)
        _ceil = json.load(open(os.path.expanduser("~/.bd_metrics_baseline.json"))).get("coupling_ratio")
        _r = _cm.get("coupling_ratio")
        _hot = (_ceil is not None and _r is not None and _r >= _ceil)
        print(f"\n{B}Decomposition (standing program):{RST}  coupling {_r} "
              f"(ratchet ceiling {_ceil}){'  ** AT CEILING **' if _hot else ''}")
        print(f"  run {B}bd-decomp{RST} before any extraction -- seams, ordered plan, and the "
              f"gates it will trip")
    except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
        pass

    print(f"\n{B}Before any cut, run:{RST}  bd-footguns --check && bd-precut --gate && bd-cut ...")
    print(f"{B}Session-close order:{RST}  build+verify+present -> STOP for stash GREEN -> bd-handoff -> bd-pack")
    return 0


if __name__ == "__main__":
    sys.exit(main())
