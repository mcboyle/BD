#!/usr/bin/env python3
"""bd-deploy-proof -- validate a deploy landed (version, assets, health, smoke).

Produces a post-deploy checklist with the checks the operator runs on stash:
version endpoint == expected, build_info.json present, static assets served,
health endpoint OK, capture.sh GREEN. In-sandbox the live service isn't up, so
this emits the CHECKLIST + any locally-verifiable evidence (expected version
from STATE, build_info presence in the tree) and marks live checks as
operator-run. Read-only.

Usage: bd-deploy-proof [--home DIR] [--work DIR] [--json] [--selftest]
--home defaults to $HOME, --work to the checkout the tool ships in.
Exit 0 all locally-verifiable checks OK / 1 a local check FAILED /
2 CANNOT-EVALUATE (absent tree, or no STATE-derivable expected version).

The expected version comes from STATE.json under --home, which is RETIRED
along with the release zip (CLAUDE.md s7). On a git checkout there is no STATE,
so the "expected version" check has no comparand -- that is CANNOT-EVALUATE(2),
not a FAILED check(1): nothing about the deploy was measured. The checklist and
its 4 operator-run live checks are unaffected, and --home at a preserved bundle
still reads the pinned version. The selftest exercises the ledger-independent
logic against a SYNTHETIC STATE fixture.
"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def build(home, work):
    st=sec.load_state(home) or {}
    ver=st.get("built_version") or st.get("live_version")
    bi=None
    for c in ("bulk_downloader/build_info.json","build_info.json","frontend/dist/build_info.json"):
        if os.path.exists(os.path.join(work,c)): bi=c; break
    checks=[
        {"check":"expected version","expect":ver,"verifiable_here":True,"ok":bool(ver)},
        {"check":"build_info.json present","expect":bi or "(none found)","verifiable_here":True,"ok":bool(bi)},
        # There is NO /api/version route (CLAUDE.md s7): the only version route
        # is /api/dev/version_check and it is dev-mode gated. The running
        # version is tools/deployed_version.txt, rewritten by the unit's
        # ExecStartPre on every start -- so it reflects the PROCESS, not the
        # tree, which is exactly what a deploy proof needs to compare.
        {"check":"running version == "+str(ver),"verifiable_here":False,"ok":None,"how":"cat ~/BulkDownloader/tools/deployed_version.txt"},
        {"check":"static assets served (503 = SPA bundle missing)","verifiable_here":False,"ok":None,"how":"curl -sI localhost:5555/"},
        {"check":"health OK","verifiable_here":False,"ok":None,"how":"curl -s localhost:5555/api/health"},
        {"check":"capture.sh GREEN","verifiable_here":False,"ok":None,"how":"./capture.sh --workers=$(nproc); echo exit=$?"},
    ]
    local_ok=all(c["ok"] for c in checks if c["verifiable_here"])
    return {"version":ver,"checks":checks,"local_evidence_ok":local_ok}

def _expect_version():
    """The version the SOURCE TREE declares about itself.

    Deliberately a DIFFERENT route than the one under test (which reads the
    STATE pin), so this stays a cross-check and not x==x. Refuses rather than
    comparing None to None -- an absent comparand is CANNOT-EVALUATE, not a pass.
    """
    v = sec.detect_tree_version(sec.DEFAULT_WORK)
    if not v:
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=ABSENT "
                         "(work tree declares no __version__)\n")
        sys.exit(2)
    return v


def _fixture_home(tmp, ver):
    """A synthetic STATE bundle pinning `ver`, so the STATE-read path stays
    verified without the retired zip world."""
    import json as _json
    os.makedirs(os.path.join(tmp,"nextsess"),exist_ok=True)
    with open(os.path.join(tmp,"nextsess","STATE.json"),"w") as fh:
        _json.dump({"built_version":ver},fh)
    return tmp


def selftest():
    ok=True
    import tempfile, shutil, subprocess
    tmp=tempfile.mkdtemp(prefix="dp_fixture_")
    want=_expect_version()
    d=build(_fixture_home(tmp,want), sec.DEFAULT_WORK)
    print(("PASS" if d["version"]==want else "FAIL")+"  version from STATE matches source (%s vs %s)"%(d["version"],want))
    ok=ok and d["version"]==want
    print(("PASS" if len(d["checks"])==6 else "FAIL")+"  6-point checklist")
    ok=ok and len(d["checks"])==6
    liveN=sum(1 for c in d["checks"] if not c["verifiable_here"])
    print(("PASS" if liveN==4 else "FAIL")+"  4 live checks flagged operator-run (%d)"%liveN)
    ok=ok and liveN==4
    # verdict-seam controls (I-6): the contract must be able to say 1
    pos_rc = _verdict_rc({"local_evidence_ok": True})
    neg_rc = _verdict_rc({"local_evidence_ok": False})
    print(("PASS" if (pos_rc, neg_rc) == (0, 1) else "FAIL") +
          "  NEG: failed local check -> exit 1 (got %s/%s)" % (pos_rc, neg_rc))
    ok = ok and (pos_rc, neg_rc) == (0, 1)

    # NEG (verdict seam): no STATE under --home means the expected version has
    # no comparand. That is CANNOT-EVALUATE(2), and it must not be reported as
    # a FAILED local check(1) -- a deploy that was never measured is not a
    # deploy that failed.
    empty=os.path.join(tmp,"empty_home"); os.makedirs(empty,exist_ok=True)
    rc=subprocess.run([sys.executable,os.path.realpath(__file__),"--home",empty],
                      capture_output=True,text=True,timeout=60).returncode
    print(("PASS" if rc==2 else "FAIL")+
          "  NEG: no STATE under --home -> CANNOT-EVALUATE 2 (got %d)"%rc)
    ok = ok and rc==2
    shutil.rmtree(tmp,ignore_errors=True)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def _verdict_rc(d):
    """0 = every locally-verifiable check OK; 1 = a local check failed.
    (Absent inputs never reach here -- require_* exits 2 upstream.)"""
    return 0 if d.get("local_evidence_ok") else 1


def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--home",default=os.path.expanduser("~")); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    # NOT require_bundle: the zip markers are not this tool's corpus, and their
    # absence is not what makes the proof unevaluable. The expected version is.
    if sec.load_state(a.home) is None:
        sys.stderr.write(
            "CANNOT-EVALUATE deploy proof: reason=%s (no STATE.json under %s, so "
            "there is no expected version to prove the deploy against. STATE.json "
            "and the release zip are RETIRED -- git replaced the zip overlay "
            "(CLAUDE.md s7). Pass --home at a preserved bundle to check an "
            "archived release.)\n" % (sec.REASON_ABSENT, a.home))
        return sec.EXIT_CANNOT_EVALUATE
    d=build(a.home,a.work)
    if sec.emit(d,as_json=a.json): return _verdict_rc(d)
    print("deploy-proof checklist for v%s:"%d["version"])
    for c in d["checks"]:
        if c["verifiable_here"]:
            tag=(G+"OK  "+RST) if c["ok"] else (R+"FAIL"+RST)
            print("  %s %s -> %s"%(tag,c["check"],c.get("expect")))
        else:
            print("  %sOPER%s %s  %s(%s)%s"%(Y,RST,c["check"],DIM,c.get("how"),RST))
    return _verdict_rc(d)
sys.exit(main())
