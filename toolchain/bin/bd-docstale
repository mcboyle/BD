#!/usr/bin/env python3
"""bd-docstale -- which PK docs are behind the current version.

Scans <dir>/*.md for `verified-against: vX.Y.Z` and reports how far each is
behind __version__. The complement of bd-doc-truth: that one asks whether a
cited PATH still resolves, this one asks whether a doc's own marker has fallen
behind.

Usage: bd-docstale [--dir DIR] [--work DIR] [--behind N]

EXIT (@853):
  0  scanned >=1 marked doc against a KNOWN current version
  1  --behind N given and some doc is more than N releases behind
  2  CANNOT EVALUATE -- no marked doc found, or __version__ unreadable

Until @853 this was "exit 0 always" over two dead defaults, and the second one
INVERTED the answer rather than merely missing it: --work pointed at
/home/claude/work, so `cur` was None, and `d = (cur - p) if cur else 0` scored
every doc as 0 behind. A doc pinned at 3.66.47 printed GREEN as "current" under
a summary reading "worst is 0 releases behind". A missing minuend must never
silently become zero.
"""
import argparse, glob, os, re, sys
_BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _BIN)
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
def patch(v): 
    m=re.match(r'3\.66\.(\d+)',v); return int(m.group(1)) if m else None
def selftest():
    """@853: the first two cases are the ORIGINAL selftest, and they are the
    reason this tool shipped inverted -- both exercise patch() and neither ever
    ran a scan. The tool could report an 805-releases-behind doc as "current"
    at full volume with SELFTEST PASS underneath it. The three added below drive
    the real CLI, because that is where the defect lived."""
    import subprocess, tempfile
    ok = (patch("3.66.700") == 700 and patch("not-a-version") is None)
    print(("PASS" if patch("3.66.700") == 700 else "FAIL") + "  parses 3.66.700 -> 700")
    print(("PASS" if patch("junk") is None else "FAIL") + "  NEG: junk -> None (no false cut number)")

    me = os.path.realpath(__file__)
    def rc(args):
        try:
            return subprocess.run([sys.executable, me] + args, capture_output=True,
                                  text=True, timeout=120).returncode
        except Exception:
            return -1

    with tempfile.TemporaryDirectory() as td:
        pk = os.path.join(sec.DEFAULT_WORK, "project-knowledge")
        # NEG: no readable __version__ -> refuse. Grading against an unknown
        # current version made every delta 0, which is worse than no answer.
        c1 = rc(["--dir", pk, "--work", td]) == sec.EXIT_CANNOT_EVALUATE
        print(("PASS" if c1 else "FAIL")
              + "  NEG: unreadable __version__ -> CANNOT-EVALUATE (not 'every doc is current')")
        ok = ok and c1

        # NEG: a corpus with no markers at all -> refuse.
        empty = os.path.join(td, "empty"); os.makedirs(empty)
        c2 = rc(["--dir", empty, "--work", sec.DEFAULT_WORK]) == sec.EXIT_CANNOT_EVALUATE
        print(("PASS" if c2 else "FAIL")
              + "  NEG: no marked doc -> CANNOT-EVALUATE (0 graded is not 0 stale)")
        ok = ok and c2

        # POS: a fully resolvable run must still REPORT. A tool that only
        # refuses is not an instrument.
        c3 = rc(["--dir", pk, "--work", sec.DEFAULT_WORK]) == 0
        print(("PASS" if c3 else "FAIL")
              + "  POS: resolvable corpus -> 0 and a real report (not over-refusing)")
        ok = ok and c3

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap=argparse.ArgumentParser(); ap.add_argument("--dir",default=None)
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--behind",type=int)
    ap.add_argument("--selftest", action="store_true",
                   help="real fault-injection selftest")
    a=ap.parse_args()
    if a.selftest:
        return selftest()
    docs = a.dir if a.dir is not None else os.path.join(a.work,"project-knowledge")
    cur=None
    try:
        cur=patch(re.search(r'3\.66\.\d+',open(os.path.join(a.work,"bulk_downloader/__init__.py")).read()).group(0))
    # why: handled below as CANNOT-EVALUATE. It is NOT non-fatal: without the
    # current version every delta would compute as 0 and the report would call
    # an 805-releases-behind doc "current".
    except Exception: pass
    if cur is None:
        print(f"{R}BD-DOCSTALE UNEVALUABLE{RST} cannot read __version__ under "
              f"{a.work} -- refusing to grade staleness against an unknown "
              f"current version (every doc would score 0 behind).")
        return sec.EXIT_CANNOT_EVALUATE
    rows=[]
    for f in sorted(glob.glob(os.path.join(docs,"*.md"))):
        try: head="".join([next(open(f)) for _ in range(3)])
        except Exception:  # why: fewer than 3 lines (StopIteration) or an odd encoding;
                           # read a fixed prefix instead -- the marker search below is identical
            head=open(f).read(300)
        m=re.search(r'verified-against:\s*v?(3\.66\.(\d+))',head)
        if m: rows.append((os.path.basename(f),int(m.group(2))))
    if not rows:
        print(f"{R}BD-DOCSTALE UNEVALUABLE{RST} no verified-against marker in "
              f"any *.md under {docs} -- 0 documents graded. That is UNKNOWN, "
              f"not clean.")
        return sec.EXIT_CANNOT_EVALUATE
    rows.sort(key=lambda r:r[1])
    print(f"{DIM}current __version__ patch: 3.66.{cur}{RST}")
    worst=0
    for name,p in rows:
        d=cur-p; worst=max(worst,d)   # cur is guaranteed non-None above
        tag=(G+"current"+RST if d==0 else (Y if d<100 else R)+f"{d} behind"+RST)
        print(f"  3.66.{p:<4} {tag:<20} {name}")
    print(f"{DIM}{len(rows)} marked docs; worst is {worst} releases behind{RST}")
    if a.behind is not None and worst>a.behind: return 1
    return 0
sys.exit(main())
