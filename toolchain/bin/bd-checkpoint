#!/usr/bin/env python3
"""bd-checkpoint -- wholesale source-tree checkpoint + restore (rollback safety).

bd-snapshot is per-file (pre-edit diffs); bd-checkpoint tars the whole SOURCE set
(bulk_downloader/tests/tools/frontend/src) so a risky multi-file operation can be
rolled back in one move. Cheap insurance before a big refactor/decomposition.

Usage:
    bd-checkpoint save <name> [--work DIR]     tar the source dirs
    bd-checkpoint restore <name> [--work DIR]  extract back over the work tree
    bd-checkpoint list
    bd-checkpoint diff <name> [--work DIR]     files that changed since the checkpoint
Exit 0 ok; 1 on a missing checkpoint / bad name.
"""
import argparse, glob, hashlib, os, sys, tarfile
import sys

# --- 702: --selftest delegates to the tool's own bd-coretest fault-injection case.
# These are the RELEASE-GATING MUTATORS: they edit the tree and gate a cut, and they
# had NO selftest at their own entry point (bd-tool-lint: 10/10 untested). The teeth
# already existed in bd-coretest -- they were just unreachable from the tool itself.
# Delegating (not re-asserting) keeps ONE source of truth for what "correct" means.
def _selftest_via_coretest():
    import subprocess as _sp, sys as _sys, os as _os
    _me = _os.path.basename(_os.path.realpath(__file__))
    _ct = _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "bd-coretest")
    if not _os.path.isfile(_ct):
        print("SELFTEST FAIL -- bd-coretest not found (cannot verify teeth)")
        return 2
    _cp = _sp.run([_sys.executable, _ct, "--only", _me], capture_output=True, text=True)
    for _ln in _cp.stdout.splitlines():
        if _ln.startswith(_me) or _ln.strip().startswith("["):
            print(_ln)
    print("SELFTEST PASS" if _cp.returncode == 0 else "SELFTEST FAIL")
    return _cp.returncode


if "--selftest" in sys.argv:
    sys.exit(_selftest_via_coretest())

G,R,Y,C,DIM,RST="\033[32m","\033[31m","\033[33m","\033[36m","\033[2m","\033[0m"
CKDIR="/home/claude/checkpoints"; SRC=["bulk_downloader","tests","tools","frontend/src"]
def path(n): return os.path.join(CKDIR,n+".tar.gz")
def save(a):
    os.makedirs(CKDIR,exist_ok=True); p=path(a.name); n=0
    with tarfile.open(p,"w:gz") as tar:
        for d in SRC:
            full=os.path.join(a.work,d)
            if os.path.isdir(full): tar.add(full,arcname=d); n+=1
    print(f"{G}checkpoint saved{RST} {p} {DIM}({n} source dirs, {os.path.getsize(p)//1024}KB){RST}")
    return 0
def restore(a):
    p=path(a.name)
    if not os.path.exists(p): print(f"{R}no checkpoint {a.name!r}{RST}"); return 1
    with tarfile.open(p,"r:gz") as tar:
        try:
            tar.extractall(a.work, filter="data")   # py3.12+: explicit, safe filter
        except TypeError:
            tar.extractall(a.work)                   # older python: no filter kwarg
    print(f"{G}restored{RST} {a.name} over {a.work} {DIM}(source dirs reverted){RST}")
    return 0
def lst(a):
    cps=sorted(glob.glob(os.path.join(CKDIR,"*.tar.gz")))
    print("checkpoints:")
    for c in cps:
        print(f"  {C}{os.path.basename(c)[:-7]}{RST} {DIM}{os.path.getsize(c)//1024}KB{RST}")
    if not cps: print(f"  {DIM}none{RST}")
    return 0
def diff(a):
    p=path(a.name)
    if not os.path.exists(p): print(f"{R}no checkpoint {a.name!r}{RST}"); return 1
    def sh(b): return hashlib.sha256(b).hexdigest()
    old={}
    with tarfile.open(p,"r:gz") as tar:
        for m in tar.getmembers():
            if m.isfile(): old[m.name]=sh(tar.extractfile(m).read())
    changed=[]
    for d in SRC:
        for f in glob.glob(os.path.join(a.work,d,"**","*"),recursive=True):
            if not os.path.isfile(f): continue
            rel=os.path.relpath(f,a.work)
            cur=sh(open(f,"rb").read())
            if rel not in old: changed.append(("+",rel))
            elif old[rel]!=cur: changed.append(("~",rel))
    for rel in old:
        if not os.path.exists(os.path.join(a.work,rel)): changed.append(("-",rel))
    if not changed: print(f"{G}no changes since checkpoint {a.name}{RST}"); return 0
    print(f"changed since {a.name} ({len(changed)}):")
    for t,rel in sorted(changed,key=lambda x:x[1])[:60]: print(f"  {C}{t}{RST} {rel}")
    return 0
def main():
    ap=argparse.ArgumentParser(); sub=ap.add_subparsers(dest="cmd")
    for c in ("save","restore","diff"):
        p=sub.add_parser(c); p.add_argument("name"); p.add_argument("--work","--tree",default="/home/claude/work")
    sub.add_parser("list")
    a=ap.parse_args()
    return {"save":save,"restore":restore,"list":lst,"diff":diff}.get(a.cmd,lambda _:(ap.print_help() or 1))(a)
sys.exit(main())
