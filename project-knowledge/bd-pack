#!/usr/bin/env python3
"""bd-pack -- assemble + LINT the next-session pack so a stale doc can never ship.

Hand-regenerating the pack under time pressure drops things (we once shipped a
pack with two old-pinned docs). bd-pack makes that impossible: it cross-checks
the pack against STATE.json and refuses to zip if the required set is incomplete,
a volatile doc still flies a stale `LIVE = <older>` banner, or more than one (or
an older) KB_HANDOFF is present.

It does NOT write your prose -- you still author the narrative. It guarantees the
STATE-derived facts are consistent and the required set is complete, then zips.

Usage:
    bd python3 bd-pack --dir /home/claude/pack286 --out /mnt/user-data/outputs
Required in --dir: STATE.json, KB_HANDOFF_v3_66_<built>.md, Backlog.md, Roadmap.md.
Exit 0 = linted + zipped, 1 = lint failure (nothing zipped).

Conventions (v3.66.286, BP-PR/C11):
  * CONTINUATION_MESSAGE.md is RETIRED -- not required.
  * The session kickoff is folded into the TOP of KB_HANDOFF -- no separate
    SESSION_KICKOFF file.
  * The pack zip is named for the BUILT version handed off (not built+1):
    BulkDL_next_session_v3_66_<built>.zip.
  * "Newest handoff only": exactly one KB_HANDOFF_*.md, pinned to <built>.
"""
import argparse
import glob
import json
import os
import re
import sys
import zipfile

# --- 702: --selftest delegates to the tool's own bd-coretest fault-injection case.
# These are the RELEASE-GATING MUTATORS: they edit the tree and gate a cut, and they
# had NO selftest at their own entry point (bd-tool-lint: 10/10 untested). The teeth
# already existed in bd-coretest -- they were just unreachable from the tool itself.
# Delegating (not re-asserting) keeps ONE source of truth for what "correct" means.
_STUB_MARKERS = ("todo(author)", "todo (author)", "tbd", "fill me in",
                 "<placeholder>", "lorem ipsum", "xxx replace")
_MIN_DOC_BYTES = 200          # a real Backlog/Roadmap is ~2-3KB; 30 bytes was the defect


def _stub_reason(path):
    """Is this required doc a PLACEHOLDER rather than a plan? Returns a reason, or None.

    Presence is not content. The 721 pack shipped 30-byte `TODO(author)` Backlog.md and
    Roadmap.md as the next session's planning docs and the gate said clean, because the
    gate was os.path.exists(). It RECURRED at 728 (35-byte stubs). Four ways a doc can
    exist and still say nothing:
      - empty / whitespace only
      - below a floor no real planning doc could be under
      - it IS a placeholder marker and little else
      - headings only, with no prose under them

    FALSE-POSITIVE GUARD (learned immediately, on this very handoff): a doc that merely
    MENTIONS the marker -- e.g. a handoff explaining "the pack shipped TODO(author) stubs"
    -- is NOT a stub. An earlier build did a bare `marker in text` and flagged a 12KB
    written document as a placeholder. Same shape as bd-tool-lint matching "--selftest"
    inside a comment. So: STRIP the marker lines, then judge WHAT IS LEFT. If substantial
    content remains, the doc is real and the marker is just prose about it.
    """
    try:
        raw = open(path, "rb").read()
    except OSError as e:
        return f"unreadable ({e})"
    if not raw.strip():
        return "empty"
    txt = raw.decode("utf-8", "replace")

    # what remains once every line carrying a placeholder marker is removed?
    kept = [l for l in txt.splitlines()
            if not any(m in l.lower() for m in _STUB_MARKERS)]
    body = "\n".join(kept).strip()
    had_marker = len(kept) != len(txt.splitlines())

    if had_marker and len(body.encode()) < _MIN_DOC_BYTES:
        return ("is a placeholder -- a marker (e.g. TODO(author)) and little else "
                f"({len(body.encode())} bytes of real content)")
    if len(raw) < _MIN_DOC_BYTES:
        return f"{len(raw)} bytes (< {_MIN_DOC_BYTES}-byte floor -- too short to be a plan)"
    # headings/bullets only: no line of actual prose
    prose = [l.strip() for l in body.splitlines()
             if l.strip() and not l.lstrip().startswith(("#", "-", "*", ">", "|", "`"))]
    if not prose:
        return "headings/bullets only -- no prose content"
    return None


def _selftest_via_coretest():
    import subprocess as _sp, sys as _sys, os as _os
    _me = _os.path.basename(_os.path.realpath(__file__))
    _ct = _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "bd-coretest")
    if not _os.path.isfile(_ct):
        print("SELFTEST FAIL -- bd-coretest not found (cannot verify teeth)")
        return 2
    _cp = _sp.run([_sys.executable, _ct, "--only", _me], capture_output=True, text=True, timeout=900)
    for _ln in _cp.stdout.splitlines():
        if _ln.startswith(_me) or _ln.strip().startswith("["):
            print(_ln)
    print("SELFTEST PASS" if _cp.returncode == 0 else "SELFTEST FAIL")
    return _cp.returncode


if "--selftest" in sys.argv:
    sys.exit(_selftest_via_coretest())


G, R, Y, RST = "\033[32m", "\033[31m", "\033[33m", "\033[0m"
VOLATILE = ["Backlog.md", "Roadmap.md"]

# v3.66.841 -- the TASK_TRACKER ledger is RETIRED. It shipped in every pack
# from 539 to 692, vanished at 700, and stayed gone for 48 versions because
# nothing asserted its presence -- and _tracker_drift() skipped when the files
# were absent, so the check policing the tracker reported CLEAN over its own
# subject's disappearance. That guidance ("regenerate, or formally kill the
# tracker and remove it from TRACKER_FILES -- do NOT let it silently
# disappear again") is now satisfied by the second branch: the ledger was
# folded into project-knowledge/SESSION_CARRY.md 15.15 and removed here
# deliberately. tests/test_task_tracker_stays_retired.py is the gate that
# keeps the removal honest, so absence is still policed -- by a test that
# asserts it, rather than by a lint that skipped over it.


def _kb_link_health(d):
    """Self-contained close-lint (the kb_link_validator idea, no external dep):
    warn when a pack doc links to a sibling .md/.json that isn't in the pack, and
    when a doc looks stale (no version >= a year of cuts). Non-fatal -- a broken
    handoff link or an orphaned reference is worth surfacing at close, not blocking.
    """
    import re as _re
    warns = []
    present = {os.path.basename(p) for p in glob.glob(os.path.join(d, "*"))}
    link_re = _re.compile(r"\]\(\.?/?([A-Za-z0-9_./-]+\.(?:md|json))\)")
    for md in sorted(glob.glob(os.path.join(d, "*.md"))):
        name = os.path.basename(md)
        try:
            txt = open(md, encoding="utf-8", errors="replace").read()
        except Exception:  # why: this item is unreadable/unparseable; skip it, the loop continues
            continue
        for m in link_re.finditer(txt):
            target = os.path.basename(m.group(1))
            if target not in present and not m.group(1).startswith(("http", "..")):
                warns.append(f"{name}: links to '{target}' which is not in the pack")
    return warns


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--dir", required=True)
    ap.add_argument("--out", default="/mnt/user-data/outputs")
    ap.add_argument("--allow-stale", nargs="*", default=[],
                    help="prior versions allowed to appear in the REQUIRED docs")
    a = ap.parse_args(argv)

    sp = os.path.join(a.dir, "STATE.json")
    if not os.path.exists(sp):
        print(f"{R}FAIL{RST} no STATE.json in {a.dir} (run bd-state first)"); return 1
    st = json.load(open(sp))
    live = st["live_version"]
    built = st.get("built_version") or live
    major = ".".join(live.split(".")[:2])              # 3.66
    n = int(live.split(".")[2])                        # live floor
    n_anchor = int(built.split(".")[2])                # built anchor (names + handoff pin)
    mtag = major.replace(".", "_")
    fails, warns = [], []

    handoff = f"KB_HANDOFF_v{mtag}_{n_anchor}.md"
    required = VOLATILE + TRACKER_FILES + [handoff]
    for r in required:
        rp = os.path.join(a.dir, r)
        if not os.path.exists(rp):
            fails.append(f"missing required doc: {r}")
            continue
        # CONTENT, NOT PRESENCE (v3.66.723+). os.path.exists() was the whole check, so
        # the 721 pack happily shipped 30-byte `TODO(author)` Backlog/Roadmap stubs as
        # the NEXT session's planning truth. A gate that checks the wrong thing reports
        # clean -- the project's own lesson, in its own toolchain. A required planning
        # doc must actually SAY SOMETHING.
        bad = _stub_reason(rp)
        if bad:
            fails.append(f"required doc is a STUB: {r} -- {bad} "
                         f"(a placeholder is not a plan; write it or drop the requirement)")

    # newest-handoff-only guard: exactly one KB_HANDOFF, pinned to <built>
    handoffs = sorted(os.path.basename(p) for p in
                      glob.glob(os.path.join(a.dir, "KB_HANDOFF_v*_*.md")))
    if len(handoffs) > 1:
        fails.append(f"multiple KB_HANDOFF docs present {handoffs} -- keep only {handoff}")
    for h in handoffs:
        hm = re.search(rf"KB_HANDOFF_v{mtag}_(\d+)\.md", h)
        if hm and int(hm.group(1)) != n_anchor:
            fails.append(f"stale handoff {h} (built is {built}); keep only {handoff}")

    # stale 'LIVE = <older>' banner in the REQUIRED volatile docs is a hard fail;
    # the older-version mention scan is limited to the handoff (history docs
    # legitimately cite old versions and would otherwise drown the signal).
    allow = set(a.allow_stale)
    stale_re = re.compile(rf"\b{re.escape(major)}\.(\d+)\b")
    for name in required:
        fp = os.path.join(a.dir, name)
        if not os.path.exists(fp):
            continue
        txt = open(fp, encoding="utf-8", errors="replace").read()
        for m in re.finditer(rf"LIVE\s*=\s*v?{re.escape(major)}\.(\d+)", txt):
            if int(m.group(1)) < n:
                fails.append(f"{name}: stale 'LIVE = {major}.{m.group(1)}' banner (live is {live})")
        if name == handoff and built not in txt:
            warns.append(f"{name}: does not mention current cut {built}")
        olders = {m.group(0) for m in stale_re.finditer(txt)
                  if int(m.group(0).split(".")[2]) < n
                  and m.group(0) not in allow}
        if olders and name == handoff:
            warns.append(f"{name}: mentions older version(s) {sorted(olders)} "
                         f"(ok if history; --allow-stale to silence)")

    for w in _kb_link_health(a.dir):
        warns.append(w)

    print(f"  pack dir: {a.dir}   live: {live}  built: {built}")
    for w in warns:
        print(f"  {Y}warn{RST} {w}")
    if fails:
        for f in fails:
            print(f"  {R}FAIL{RST} {f}")
        print(f"{R}RESULT: FAIL{RST} -- fix the pack; nothing zipped.")
        return 1

    os.makedirs(a.out, exist_ok=True)
    outzip = os.path.join(a.out, f"BulkDL_next_session_v{mtag}_{n_anchor}.zip")
    if os.path.exists(outzip):
        os.remove(outzip)
    count = 0
    with zipfile.ZipFile(outzip, "w", zipfile.ZIP_DEFLATED) as zf:
        for root, _, files in os.walk(a.dir):
            for f in files:
                if f.startswith("."):
                    continue
                full = os.path.join(root, f)
                zf.write(full, os.path.relpath(full, a.dir))
                count += 1
    print(f"  {G}PASS{RST} required set complete; one handoff @{built}; tracker in-sync; no stale LIVE banner")
    print(f"{G}RESULT: PASS{RST} -> {outzip} ({count} files)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
