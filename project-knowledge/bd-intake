#!/usr/bin/env python3
"""bd-intake -- the uploads dir (/mnt/user-data/uploads) is READ-ONLY and EVICTS
files mid-session. Every session must copy uploaded zips to /home/claude FIRST,
validate them, and know what's still missing from the full bootstrap set. This does
all three (it is the mechanized 'copy everything present, identify what's missing').

v3.66.688 optimization pass:
  * SKIP-IDENTICAL: a dest file with the same byte size is not re-copied or
    re-validated (a second intake call used to re-copy the whole ~2.2G set).
  * NON-BOOT DENY LIST: known-heavy non-bootstrap uploads (the consolidated
    corpus) are reported but NOT copied unless --all. Everything else still
    copies (unknown zips may be legitimate new artifacts -- the contract stays
    'copy everything present').
  * VALIDATE ONLY NEW COPIES: `unzip -t` runs on freshly copied files only;
    --verify additionally re-validates already-present ones.
  * ENOSPC DETECTION: a copy whose dest size != src size is reported as a
    truncated copy (likely disk-full), the partial file is removed, and the
    free-space number is printed.

Usage:
  bd-intake [--src DIR] [--dst DIR] [--all] [--verify]
Exit 1 if any validated zip fails `unzip -t` or any copy truncates, else 0.
Missing-set is reported, not fatal.
"""
import argparse, glob, os, shutil, subprocess, sys

# expected full bootstrap set (prefixes). Optional tier is informational only.
EXPECTED = {
    "pack_A": "bd-install pack A", "pack_B": "bd-install pack B",
    "pack_C": "bd-install pack C", "pack_D": "bd-install pack D (dev-kit: pytest+pyinstaller)",
    "bd_cloak_pack": "cloak wheels (venv consumable)",
    "BulkDownloader_v3": "source zip", "version": "version.zip (STATE + tracker + handoff)",
    "bdsuite": "toolchain", "audit_state": "audit ledger",
}
OPTIONAL = {"pack_E": "browsers", "pack_F": "pyext wheels", "pack_G": "net debs",
            "pack_G2": "pack_G dependency debs", "pack_H": "audit toolchain"}
# Known-heavy NON-boot uploads: report, don't copy (unless --all).
NONBOOT_PREFIXES = {"CONSOLIDATED_corpus": "capture corpus (not a boot item)"}

def _tag(b):
    # longest prefix wins so pack_G2 tags as pack_G2, not pack_G
    for pref in sorted(list(EXPECTED) + list(OPTIONAL), key=len, reverse=True):
        if b.startswith(pref) or (pref == "version" and b.startswith("BulkDL_next_session")):
            return pref
    return None

def selftest():
    """SKIP: this tool needs an uploaded intake zip, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs an uploaded intake zip")
    print("SELFTEST PASS")
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--src", default="/mnt/user-data/uploads")
    ap.add_argument("--dst", default="/home/claude")
    ap.add_argument("--all", action="store_true",
                    help="also copy known non-boot uploads (corpus etc)")
    ap.add_argument("--verify", action="store_true",
                    help="also unzip -t already-present (skipped) files")
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if not os.path.isdir(a.src):
        print(f"no uploads dir at {a.src}"); return 0
    zips = sorted(glob.glob(os.path.join(a.src, "*.zip")))
    if not zips:
        print(f"no zips in {a.src} (already evicted, or none uploaded).")
    copied, present, skipped_nonboot, bad, truncated = [], [], [], [], []
    present_prefixes = set()
    for z in zips:
        b = os.path.basename(z)
        dst = os.path.join(a.dst, b)
        nonboot = any(b.startswith(p) for p in NONBOOT_PREFIXES)
        try:
            src_size = os.path.getsize(z)
        except OSError as e:
            print(f"  stat FAILED {b}: {e} (evicted mid-scan?)"); continue
        # skip-identical fast path
        if os.path.isfile(dst) and os.path.getsize(dst) == src_size:
            present.append(b)
            if a.verify:
                r = subprocess.run(["unzip", "-t", dst], capture_output=True, text=True)
                if r.returncode != 0:
                    bad.append(b)
            p = _tag(b)
            if p: present_prefixes.add(p)
            continue
        if nonboot and not a.all:
            skipped_nonboot.append(b)
            continue
        try:
            shutil.copy2(z, dst)
        except Exception as e:
            print(f"  copy FAILED {b}: {e}"); continue
        # ENOSPC / truncation check: a short dest means the copy died mid-write.
        if os.path.getsize(dst) != src_size:
            free = shutil.disk_usage(a.dst).free // (1024 * 1024)
            print(f"  copy TRUNCATED {b} ({os.path.getsize(dst)} of {src_size} bytes)"
                  f" -- likely ENOSPC ({free} MB free on {a.dst}); partial removed")
            try: os.remove(dst)
            except OSError: pass
            truncated.append(b)
            continue
        copied.append(b)
        r = subprocess.run(["unzip", "-t", dst], capture_output=True, text=True)
        if r.returncode != 0:
            bad.append(b)
        p = _tag(b)
        if p: present_prefixes.add(p)
    if copied:
        print(f"copied {len(copied)} zip(s) to {a.dst}:")
        for b in copied:
            tag = "  [CORRUPT unzip -t]" if b in bad else ""
            print(f"  {b}{tag}")
    if present:
        vtag = "verified" if a.verify else "size-match"
        print(f"already present ({vtag}), not re-copied: {len(present)}")
        for b in present:
            tag = "  [CORRUPT unzip -t]" if b in bad else ""
            print(f"  {b}{tag}")
    if skipped_nonboot:
        print(f"non-boot uploads NOT copied ({len(skipped_nonboot)}) -- use --all to copy:")
        for b in skipped_nonboot:
            why = next(v for p, v in NONBOOT_PREFIXES.items() if b.startswith(p))
            print(f"  {b}  ({why})")
    # missing from the required set
    missing = [f"{p} ({EXPECTED[p]})" for p in EXPECTED if p not in present_prefixes]
    if missing:
        print(f"\nMISSING from the required bootstrap set ({len(missing)}):")
        for m in missing:
            print(f"  - {m}")
        print("  -> 'save and wait': hold bootstrap until the full set arrives.")
    else:
        print("\nrequired bootstrap set: COMPLETE.")
    opt_present = [p for p in OPTIONAL if p in present_prefixes]
    if opt_present:
        print(f"optional expansion packs present: {', '.join(opt_present)} (install-on-demand via bd-optpack).")
    rc = 0
    if bad:
        print(f"\n{len(bad)} CORRUPT zip(s) -- re-upload:", ", ".join(bad)); rc = 1
    if truncated:
        print(f"{len(truncated)} TRUNCATED cop(y/ies) -- free disk (see above) and re-run:", ", ".join(truncated)); rc = 1
    return rc

if __name__ == "__main__":
    sys.exit(main())
