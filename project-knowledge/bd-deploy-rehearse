#!/usr/bin/env python3
"""bd-deploy-rehearse -- run the disk-globbing gates against the POST-OVERLAY tree.

WHEN: before deploying any cut that DELETES a file. 718 went RED on stash with a
CORRECT release zip: a file deleted at 716 orphaned on the stash disk, and the graph
gates (dependency_graph, import_graph_gate) GLOB THE DISK -- so the ghost was scanned
as live source and its stale edge tripped the frozen baseline. The release zip can be
perfectly right and stash still goes RED. This reproduces what stash will see BEFORE
the 15-minute suite: it builds the tree the overlay actually produces (prev deployed
tree, then `unzip -o` the new zip over it WITHOUT deleting anything), then runs the
disk-globbing gates against that tree.

    bd-deploy-rehearse --new REL_NEW.zip [--prev REL_PREV.zip] [--deployed-root DIR]

  --prev / --deployed-root: the CURRENT deployed state to overlay onto. Exactly one.
    --prev REL_PREV.zip   reconstruct the deployed tree from the previous release zip
    --deployed-root DIR   use an actual copy of the deployed tree (most faithful)
  If neither is given, --prev defaults to the highest BulkDownloader zip below --new.

Distinct from: bd-deploy-manifest (EMITS the rm list -- the fix), bd-deploy-proof
(post-hoc, after deploy). This one SIMULATES the deploy and RUNS THE GATES on the
result, so the orphan is caught before deploy, not after a red stash suite.

Exit: 0 clean | 2 the tool broke | 3 a gate tripped on the rehearsed tree (would RED).
"""
import argparse
import glob
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile

G, R, Y, C, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[36m", "\033[2m", "\033[0m"

# runtime stores are never in the zip and must survive an overlay -- do not treat
# their absence-from-zip as an orphan (mirrors bd-deploy-manifest._NEVER_RM).
_NEVER_RM = ("bulk_downloader.db", "app_config.json", ".env", "sites_config.json",
             "secrets.json", "vault_tokens.json")
_PRUNE = (".git", "__pycache__", "node_modules", "venv", ".venv")


def _pick_newest(paths):
    """Highest VERSION wins; ties resolve to /home/claude.

    ADOPTED from the parallel session's fix (@726). The bug it kills, which THIS TOOL
    also had: globbing both /mnt/user-data/uploads and /home/claude and then sorting the
    PATH STRINGS. Lexicographically "/mnt..." > "/home...", so the READ-ONLY UPLOADS COPY
    ALWAYS WON regardless of version -- a stale 723 in uploads beat a fresh 725 in
    /home/claude, and the tool looked entirely correct while rehearsing against the wrong
    baseline.

    The denominator CONTAINED the right file. The ORDERING discarded it. Sort by the thing
    actually being asked about -- the version -- not by where the file happens to live.
    """
    def _k(p):
        nums = tuple(int(x) for x in re.findall(r"\d+", os.path.basename(p)))
        return (nums, p.startswith("/home/claude"))
    return sorted(paths, key=_k, reverse=True)


def _extract(zpath, dest):
    with zipfile.ZipFile(zpath) as zf:
        zf.extractall(dest)
    # a zip may nest under a top dir; find the tree root (dir containing bulk_downloader/)
    for dp, dn, _ in os.walk(dest):
        if "bulk_downloader" in dn:
            return dp
    return dest


def _overlay(src_zip, tree_root):
    """Apply src_zip over tree_root the way `unzip -o` does: overwrite + add, NEVER
    delete. This is the crux -- the orphan survives precisely because of this."""
    with zipfile.ZipFile(src_zip) as zf:
        names = [n for n in zf.namelist() if not n.endswith("/")]
        # detect + strip a common top-level prefix so files land at tree_root
        top = os.path.commonprefix(names)
        prefix = ""
        if "/" in top:
            cand = top.split("/")[0] + "/"
            if all(n.startswith(cand) for n in names):
                prefix = cand
        for n in names:
            rel = n[len(prefix):] if prefix else n
            if not rel:
                continue
            out = os.path.join(tree_root, rel)
            os.makedirs(os.path.dirname(out), exist_ok=True)
            with zf.open(n) as s, open(out, "wb") as d:
                shutil.copyfileobj(s, d)


def _orphans(new_zip, deployed_root):
    """DELEGATES to bd-deploy-manifest --json (the single owner of orphan
    semantics: zip-derived extension universe + the zip's own runtime
    predicate). The old inline copy here used a NARROWER allowlist than the
    tool it rehearses (no .js -- the 27-stale-js class was invisible in
    rehearsal while flagged by the real tool: a rehearsal that disagrees with
    the deploy step it rehearses). Legacy inline filter survives only as the
    fallback when delegation fails, with a stderr notice.
    Note: this rehearsal builds its trees from real release zips, which are
    rooted (no top folder); the old commonprefix strip is unnecessary against
    them and bd-deploy-manifest compares raw zip relpaths."""
    dm = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                      "bd-deploy-manifest")
    if os.path.isfile(dm):
        try:
            r = subprocess.run([sys.executable, dm, "--zip", new_zip,
                                "--deployed", deployed_root, "--json"],
                               capture_output=True, text=True, timeout=300)
            if r.returncode == 0:
                import json as _json
                return _json.loads(r.stdout)["orphans"]
            why = "rc=%d" % r.returncode
        except Exception as e:
            why = str(e)
    else:
        why = "bd-deploy-manifest not found beside this tool"
    print("bd-deploy-rehearse: orphan delegation UNAVAILABLE (%s) -- legacy "
          "inline filter (narrower; .js-blind)" % why, file=sys.stderr)
    with zipfile.ZipFile(new_zip) as zf:
        prefix = ""
        names = [n for n in zf.namelist() if not n.endswith("/")]
        top = os.path.commonprefix(names)
        if "/" in top:
            cand = top.split("/")[0] + "/"
            if all(n.startswith(cand) for n in names):
                prefix = cand
        zmem = {n[len(prefix):] for n in names}
    tmem = set()
    for dp, dn, fns in os.walk(deployed_root):
        dn[:] = [d for d in dn if d not in _PRUNE]
        for fn in fns:
            tmem.add(os.path.relpath(os.path.join(dp, fn), deployed_root))
    gone = []
    for rel in sorted(tmem - zmem):
        if rel.endswith((".py", ".ts", ".tsx", ".json", ".md")) \
           and not any(rel.endswith(n) for n in _NEVER_RM):
            gone.append(rel)
    return gone


def _run_gate(label, argv, cwd):
    try:
        r = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=300)
    except Exception as e:
        return ("unknown", label, str(e))
    ok = r.returncode == 0
    tail = (r.stdout + r.stderr).strip().splitlines()
    return ("pass" if ok else "fail", label, tail[-1] if tail else "")


def main():
    ap = argparse.ArgumentParser(prog="bd-deploy-rehearse")
    ap.add_argument("--new", help="the release zip about to be deployed")
    ap.add_argument("--prev", help="previous release zip (reconstruct deployed tree)")
    ap.add_argument("--deployed-root", help="an actual copy of the deployed tree")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()

    if a.selftest:
        return _selftest()

    if not a.new:
        print(f"{R}bd-deploy-rehearse: --new REL.zip required{RST}")
        return 2
    if not os.path.isfile(a.new):
        print(f"{R}no such zip: {a.new}{RST}")
        return 2

    if not a.prev and not a.deployed_root:
        base = os.path.basename(a.new)
        _bn = tuple(int(x) for x in re.findall(r"\d+", base))
        cands = (glob.glob("/home/claude/BulkDownloader_v3_66_*.zip")
                 + glob.glob("/home/claude/out/BulkDownloader_v3_66_*.zip")
                 + glob.glob("/mnt/user-data/uploads/BulkDownloader_v3_66_*.zip"))
        # strictly OLDER than --new, compared by VERSION (not by path string)
        cands = [c for c in cands
                 if tuple(int(x) for x in re.findall(r"\d+", os.path.basename(c))) < _bn]
        cands = _pick_newest(cands)          # highest version first
        if not cands:
            print(f"{Y}no previous zip found and no --deployed-root -- cannot rehearse an "
                  f"overlay onto nothing.{RST}")
            print(f"{DIM}  (a fresh deploy has no orphans by definition; pass --deployed-root "
                  f"to rehearse a real tree){RST}")
            return 3
        a.prev = cands[0]
        print(f"{DIM}auto-selected prev: {os.path.basename(a.prev)} "
              f"(highest version < {base}){RST}")

    work = tempfile.mkdtemp(prefix="bd_rehearse_")
    try:
        # 1. build the CURRENT deployed tree
        if a.deployed_root:
            tree = os.path.join(work, "tree")
            shutil.copytree(a.deployed_root, tree,
                            ignore=shutil.ignore_patterns(*_PRUNE))
            print(f"deployed tree: copied from {a.deployed_root}")
        else:
            ext = os.path.join(work, "prev")
            os.makedirs(ext)
            root = _extract(a.prev, ext)
            tree = os.path.join(work, "tree")
            shutil.copytree(root, tree)
            print(f"deployed tree: reconstructed from {os.path.basename(a.prev)}")

        # 2. what will the overlay ORPHAN? (files gone from --new but present on disk)
        gone = _orphans(a.new, tree)
        if gone:
            print(f"\n{Y}OVERLAY WILL ORPHAN {len(gone)} tracked file(s) "
                  f"(unzip -o cannot delete them):{RST}")
            for g in gone:
                print(f"  {R}ghost{RST} {g}")
            print(f"{DIM}  -> these must be rm'd on stash (bd-deploy-manifest --script | sh) "
                  f"BEFORE unzip -o, or the disk-globbing gates below will trip.{RST}")

        # 3. apply the overlay the way stash does: overwrite + add, NEVER delete
        _overlay(a.new, tree)
        print(f"\napplied overlay ({os.path.basename(a.new)}) -- ghosts, if any, remain on disk")

        # 4. run the disk-globbing gates against the RESULT
        gates = []
        dg = os.path.join(tree, "tools", "dependency_graph.py")
        ig = os.path.join(tree, "tools", "decomp", "import_graph_gate.py")
        py = sys.executable
        print(f"\n{C}running disk-globbing gates on the rehearsed tree:{RST}")
        if os.path.isfile(dg):
            gates.append(_run_gate("dependency_graph --check",
                                   [py, dg, "--check"], tree))
        if os.path.isfile(ig):
            gates.append(_run_gate("import_graph_gate (frozen baseline)",
                                   [py, ig], tree))
        if not gates:
            print(f"{Y}  no disk-globbing gate scripts found in the tree "
                  f"(tools/dependency_graph.py / tools/decomp/import_graph_gate.py){RST}")

        tripped = False
        for state, label, msg in gates:
            col = {"pass": G, "fail": R, "unknown": Y}[state]
            print(f"  {col}{state.upper():7}{RST} {label}  {DIM}{msg[:80]}{RST}")
            if state != "pass":
                tripped = True

        print()
        if tripped or gone:
            print(f"{R}REHEARSAL: would RED on stash.{RST} "
                  f"Emit + apply the rm list before deploy: "
                  f"bd-deploy-manifest --zip {os.path.basename(a.new)} --script | sh")
            return 3
        print(f"{G}REHEARSAL CLEAN{RST} -- no orphans, disk-globbing gates pass on the "
              f"post-overlay tree. Safe to deploy.")
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


def _selftest():
    """Negative control: an orphaned .py with a stale import edge MUST be flagged."""
    fails = []
    work = tempfile.mkdtemp(prefix="bd_rh_st_")
    try:
        # build a tiny 'prev' zip: pkg with a.py importing b, plus b.py
        prev = os.path.join(work, "prev")
        os.makedirs(os.path.join(prev, "bulk_downloader"))
        open(os.path.join(prev, "bulk_downloader", "__init__.py"), "w").close()
        open(os.path.join(prev, "bulk_downloader", "a.py"), "w").write("from . import b\n")
        open(os.path.join(prev, "bulk_downloader", "b.py"), "w").write("x=1\n")
        prev_zip = os.path.join(work, "prev.zip")
        with zipfile.ZipFile(prev_zip, "w") as zf:
            for dp, _, fns in os.walk(prev):
                for fn in fns:
                    fp = os.path.join(dp, fn)
                    zf.write(fp, os.path.relpath(fp, prev))
        # 'new' zip DELETES b.py but a.py still imports it -> overlay leaves b.py a ghost
        new = os.path.join(work, "new")
        os.makedirs(os.path.join(new, "bulk_downloader"))
        open(os.path.join(new, "bulk_downloader", "__init__.py"), "w").close()
        open(os.path.join(new, "bulk_downloader", "a.py"), "w").write("from . import b\n")
        new_zip = os.path.join(work, "new.zip")
        with zipfile.ZipFile(new_zip, "w") as zf:
            for dp, _, fns in os.walk(new):
                for fn in fns:
                    fp = os.path.join(dp, fn)
                    zf.write(fp, os.path.relpath(fp, new))
        # orphan detection must see b.py as a ghost
        tree = os.path.join(work, "tree")
        shutil.copytree(prev, tree)
        gone = _orphans(new_zip, tree)
        if "bulk_downloader/b.py" not in gone:
            fails.append("orphan b.py not detected (got %s)" % gone)
        # NEG: a runtime store absent from the zip must NOT be called an orphan
        open(os.path.join(tree, "bulk_downloader.db"), "w").write("db")
        gone2 = _orphans(new_zip, tree)
        if any(g.endswith("bulk_downloader.db") for g in gone2):
            fails.append("runtime DB wrongly flagged as orphan")
        # NEG (adopted @726): _pick_newest must sort by VERSION, not by PATH STRING.
        # "/mnt..." > "/home..." lexicographically, so a plain sorted() made a STALE
        # uploads copy beat a FRESH local one -- the tool then rehearsed against the
        # wrong baseline while looking correct.
        picked = _pick_newest(["/mnt/user-data/uploads/BulkDownloader_v3_66_723.zip",
                               "/home/claude/BulkDownloader_v3_66_725.zip"])[0]
        if not picked.endswith("725.zip"):
            fails.append("_pick_newest chose %s -- a LOWER version in uploads beat a "
                         "HIGHER one in /home/claude (path-string sort bug)" % picked)
        # tie on version -> /home/claude wins (it is the writable, in-session copy)
        tie = _pick_newest(["/mnt/user-data/uploads/BulkDownloader_v3_66_726.zip",
                            "/home/claude/BulkDownloader_v3_66_726.zip"])[0]
        if not tie.startswith("/home/claude"):
            fails.append("_pick_newest tie did not resolve to /home/claude")
    finally:
        shutil.rmtree(work, ignore_errors=True)
    if fails:
        for f in fails:
            print("  - " + f)
        print("SELFTEST FAIL")
        return 2
    print(f"{DIM}(orphan detected; runtime store spared){RST}")
    print("SELFTEST PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
