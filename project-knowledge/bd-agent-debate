#!/usr/bin/env python3
"""bd-agent-debate -- structured pro/con review of a proposed cut.

NOT an LLM: a checklist-driven pro/con generator. Given the changed-file set and
a cut description, it produces the architecture/security tradeoff points a
reviewer should weigh -- e.g. touches N modules across M subsystems (con:
coupling), adds tests (pro), touches a guard (con: high blast radius), adds a
route (con: contract surface). Deterministic, evidence-based talking points for
a go/no-go, not invented prose. Reuses bd-agent-watchdog + bd-coupling-meter.
Read-only.

Usage: bd-agent-debate [--work DIR] [--home DIR] [--json] [--selftest]
Exit 0 debate composed (informational) / 2 CANNOT-EVALUATE (inputs absent).
"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_wd=_load_tool("bd-agent-watchdog")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def debate(work, home):
    wd=_wd.watchdog(work,home)
    if "error" in wd: return {"error":wd["error"]}
    ch=wd.get("total_changed",0)
    pros=[]; cons=[]
    src=[c for c in [] ]  # placeholder
    if wd.get("src_without_test"): cons.append("source changed with no matching test change")
    else: pros.append("changes include test coverage (or no source changed)")
    if wd.get("guard_touched"): cons.append("touches %d guard file(s) -- high blast radius, needs declared SHA"%len(wd["guard_touched"]))
    else: pros.append("no guard files touched")
    if wd.get("risky_text"): cons.append("adds risky text (eval/exec/subprocess/secret) in %d file(s)"%len(wd["risky_text"]))
    else: pros.append("no risky constructs added")
    if ch==0: pros.append("no changes -- nothing to regress")
    elif ch>20: cons.append("wide change set (%d files) -- larger review + regression surface"%ch)
    else: pros.append("focused change set (%d files)"%ch)
    verdict = "PROCEED" if not cons or (len(pros)>len(cons) and not wd.get("guard_touched") and not wd.get("risky_text")) else "REVIEW"
    return {"changed":ch,"pros":pros,"cons":cons,"verdict":verdict}

def selftest():
    ok=True
    d=debate(sec.DEFAULT_WORK,os.path.expanduser("~"))
    print(("PASS" if "error" not in d else "FAIL")+"  debate produced (verdict=%s)"%d.get("verdict"))
    ok=ok and "error" not in d
    print(("PASS" if d.get("pros") and isinstance(d.get("cons"),list) else "FAIL")+"  pros+cons present (%d/%d)"%(len(d.get("pros",[])),len(d.get("cons",[]))))
    ok=ok and bool(d.get("pros"))
    print(("PASS" if d.get("verdict")=="PROCEED" else "WARN")+"  pristine tree -> PROCEED")
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--home",default=os.path.expanduser("~"))
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    sec.require_bundle(a.home)
    d=debate(a.work,a.home)
    if "error" in d:
        sys.stderr.write("CANNOT-EVALUATE agent debate: reason=ABSENT (%s)\n"%d["error"])
        print(R+d["error"]+RST); return 2
    if sec.emit(d,as_json=a.json): return 0
    col=G if d["verdict"]=="PROCEED" else Y
    print("cut debate (%d files changed) -- verdict: %s%s%s"%(d["changed"],col,d["verdict"],RST))
    print("  %sPROS:%s"%(G,RST))
    for p in d["pros"]: print("    + %s"%p)
    print("  %sCONS:%s"%(Y,RST))
    for c in d["cons"]: print("    - %s"%c)
    return 0

if __name__ == "__main__":
    sys.exit(main())
