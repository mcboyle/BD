#!/usr/bin/env python3
"""bd-pin -- when you tighten a dependency pin, EVERY occurrence must move together
(the `duplicate-pin-sites` footgun: a pin in requirements.txt but a stale one in a
guard test or requirements-cloak.txt). This finds all pin sites for a package across
requirements*, setup*, pyproject, and tests, and flags version disagreement.

Usage:
  bd-pin <package> [--tree DIR]
  bd-pin --all [--tree DIR]     # list every pinned package + its #sites
Exit 1 if a named package's pins disagree, else 0.
"""
import argparse, glob, os, re, sys
from collections import defaultdict
import os as _os_bd, sys as _sys_bd
_sys_bd.path.insert(0, _os_bd.path.dirname(_os_bd.path.realpath(__file__)))
import bdtools_sec as sec

PINFILES = ["requirements*.txt", "setup.py", "setup.cfg", "pyproject.toml",
            "constraints*.txt", "tests/*.py", "tools/*.py"]
# name (op version)  e.g.  playwright>=1.61,<2   authlib==1.3.1   cryptography <46
SPEC = re.compile(r"(?P<name>[A-Za-z0-9_.-]+)\s*(?P<spec>(?:[<>=!~]=?\s*[0-9][0-9A-Za-z.\*]*\s*,?\s*)+)")

def scan(tree, include_code=True):
    sites = defaultdict(list)   # pkg -> [(file, line, spec)]
    dep_pats = ["requirements*.txt", "setup.py", "setup.cfg", "pyproject.toml", "constraints*.txt"]
    code_pats = ["tests/*.py", "tools/*.py"]
    dep_files = []
    for pat in dep_pats:
        dep_files += glob.glob(os.path.join(tree, pat))
    code_files = []
    if include_code:
        for pat in code_pats:
            code_files += glob.glob(os.path.join(tree, pat))
    for f, is_code in [(x, False) for x in sorted(set(dep_files))] + [(x, True) for x in sorted(set(code_files))]:
        try:
            for i, line in enumerate(open(f, errors="ignore"), 1):
                s = line.strip()
                if s.startswith("#"):
                    continue
                if "==" not in line and "<" not in line and ">" not in line:
                    continue
                for m in SPEC.finditer(line):
                    name = m.group("name").lower().replace("_", "-")
                    spec = re.sub(r"\s+", "", m.group("spec")).rstrip(",")
                    if name in ("version", "v", "python", "test", "status-code", "resp", "r", "rc") or len(name) < 3:
                        continue
                    # in code files, only accept a DOTTED version (real dep, not status_code==200)
                    if is_code and "." not in spec:
                        continue
                    sites[name].append((os.path.relpath(f, tree), i, spec))
        except Exception:  # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
            continue
    return sites

def selftest():
    """SKIP: this tool needs pip network access, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs pip network access")
    print("SELFTEST PASS")
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("package", nargs="?")
    ap.add_argument("--tree","--work", default=sec.DEFAULT_WORK)
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if a.all:
        sites = scan(a.tree, include_code=False)
        print("pinned packages in dependency files (name : #sites):")
        for pkg in sorted(sites, key=lambda p: (-len(sites[p]), p)):
            specs = {s for _, _, s in sites[pkg]}
            flag = "  <-- DISAGREE" if len(specs) > 1 else ""
            print(f"  {len(sites[pkg]):>2}  {pkg}{flag}")
        return 0
    sites = scan(a.tree, include_code=True)
    if not a.package:
        print("usage: bd-pin <package> | bd-pin --all"); return 2
    pkg = a.package.lower().replace("_", "-")
    hits = sites.get(pkg, [])
    if not hits:
        print(f"no pin sites found for '{pkg}'."); return 0
    print(f"pin sites for '{pkg}':")
    for f, i, spec in hits:
        print(f"  {f}:{i}   {pkg}{spec}")
    specs = {s for _, _, s in hits}
    if len(specs) > 1:
        print(f"\nDISAGREEMENT: {len(specs)} distinct specs -> {sorted(specs)}")
        print("tighten ALL sites together + add a guard test covering them (the duplicate-pin-sites footgun).")
        return 1
    print(f"\nall {len(hits)} site(s) agree: {specs.pop()}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
