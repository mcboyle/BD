#!/usr/bin/env python3
"""bd-property-tests -- property-based tests for the critical guards.

Two modes:
  --emit   print a self-contained hypothesis test module (tests/test_bd_
           properties.py) with strategies for the URL guard, path guard,
           redaction, and finite-number/schema invariants -- for the operator
           to run under the audit venv (pack_H ships hypothesis).
  --run    execute a BUILT-IN deterministic generative check (no hypothesis
           dependency): thousands of pseudo-random-but-seeded inputs against
           bdtools_sec.classify_url + the real backup._is_safe_path, asserting
           the invariants hold. A violation -> BD-PROP-VIOLATION.
The emitted module is ast-verified before printing (the bd-bump lesson).
Read-only.

Usage: bd-property-tests [--emit | --run] [--work DIR] [--iters N] [--json]
       bd-property-tests --selftest
Exit 1 if a property is violated; 2 (CANNOT-EVALUATE) if the real
_is_safe_path could not be loaded (the path property was never tested, so
"all properties held" would be a verdict over half the subject); else 0.
"""
import argparse
import ast
import importlib.util
import ipaddress
import os
import random
import sys
import tempfile
import types
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

EMITTED = '''\
"""test_bd_properties -- property-based guard invariants (hypothesis).

Run under the audit venv (pack_H ships hypothesis):
    env -u PYTHONPATH ~/rev/bin/python -m pytest tests/test_bd_properties.py
Auto-generated by bd-property-tests --emit.
"""
import ipaddress
import pytest

hypothesis = pytest.importorskip("hypothesis")
from hypothesis import given, strategies as st

from bulk_downloader.backup import _is_safe_path
from pathlib import Path


# Property 1: any private/loopback/link-local IPv4 URL must be blocked by the
# egress classifier (imported from the shipped fetch policy if present).
try:
    from bulk_downloader.fetch_policy import validate_url, FetchPolicyError
    HAVE_POLICY = True
except Exception:
    HAVE_POLICY = False


@pytest.mark.skipif(not HAVE_POLICY, reason="fetch_policy not present yet")
@given(st.integers(min_value=0, max_value=255), st.integers(0, 255),
       st.integers(0, 255), st.integers(0, 255))
def test_private_ipv4_always_blocked(a, b, c, d):
    ip = f"{a}.{b}.{c}.{d}"
    addr = ipaddress.ip_address(ip)
    if addr.is_private or addr.is_loopback or addr.is_link_local:
        with pytest.raises(FetchPolicyError):
            validate_url(f"http://{ip}/", resolve_dns=False)


# Property 2: _is_safe_path never accepts a candidate that resolves outside base.
@given(st.lists(st.sampled_from(["..", "a", "b", "sub", "."]), max_size=8))
def test_path_confinement(parts):
    import os
    with tempfile.TemporaryDirectory() as d:
        base = Path(d) / "base"
        base.mkdir()
        cand = "/".join(parts) or "."
        resolved_inside = os.path.commonpath(
            [os.path.realpath(base), os.path.realpath(os.path.join(base, cand))]
        ) == os.path.realpath(base)
        result = _is_safe_path(base, Path(cand))
        if not resolved_inside:
            assert result is not True, f"escape accepted: {cand!r}"
'''


def _run_builtin(work, iters):
    """Deterministic generative check without hypothesis."""
    rng = random.Random(42)
    violations = []
    tested = 0
    # load real _is_safe_path
    guard = None
    p = os.path.join(work, "bulk_downloader", "backup.py")
    if os.path.exists(p):
        try:
            pkg = types.ModuleType("bulk_downloader")
            pkg.__path__ = [os.path.join(work, "bulk_downloader")]
            sys.modules.setdefault("bulk_downloader", pkg)
            if work not in sys.path:
                sys.path.insert(0, work)
            spec = importlib.util.spec_from_file_location("bulk_downloader.backup", p)
            m = importlib.util.module_from_spec(spec)
            sys.modules["bulk_downloader.backup"] = m
            spec.loader.exec_module(m)
            guard = getattr(m, "_is_safe_path", None)
        except Exception:  # why: operation failed; degrade to the default and continue -- correctness unaffected, only completeness
            guard = None

    # Property A: private/loopback/link-local IPs always blocked by classifier
    for _ in range(iters):
        tested += 1
        octets = [rng.randint(0, 255) for _ in range(4)]
        ip = ".".join(map(str, octets))
        addr = ipaddress.ip_address(ip)
        r = sec.classify_url(f"http://{ip}/")
        if (addr.is_private or addr.is_loopback or addr.is_link_local
                or addr.is_reserved or addr.is_multicast or addr.is_unspecified):
            if r["verdict"] != "blocked":
                violations.append({"prop": "private-ip-blocked", "input": ip,
                                   "got": r["verdict"]})
        elif r["verdict"] != "allowed":
            violations.append({"prop": "public-ip-allowed", "input": ip,
                               "got": r["verdict"], "why": "; ".join(r["reasons"])})

    # Property B: _is_safe_path never accepts an escaping candidate
    if guard:
        with tempfile.TemporaryDirectory() as d:
            base = Path(d) / "base"
            base.mkdir()
            (base / "sub").mkdir()
            for _ in range(iters):
                tested += 1
                parts = [rng.choice(["..", "a", "b", "sub", ".", "x"])
                         for _ in range(rng.randint(1, 6))]
                cand = "/".join(parts)
                inside = os.path.commonpath(
                    [os.path.realpath(base), os.path.realpath(os.path.join(base, cand))]
                ) == os.path.realpath(base)
                try:
                    res = guard(base, Path(cand)) is True
                except Exception:  # why: operation failed; degrade to the default and continue -- correctness unaffected, only completeness
                    res = False
                if res and not inside:
                    violations.append({"prop": "path-escape", "input": cand})
    return {"tested": tested, "violations": violations, "guard_loaded": guard is not None}


def selftest():
    ok = True
    ast.parse(EMITTED)
    print("PASS  emitted hypothesis module parses")
    res = _run_builtin(sec.DEFAULT_WORK, 500)
    clean = res["violations"] == []
    print(("PASS" if clean else "FAIL") +
          f"  built-in generative check: {res['tested']} cases, "
          f"{len(res['violations'])} violation(s) {res['violations'][:2]}")
    ok &= clean
    print(("PASS" if res["guard_loaded"] else "WARN") +
          f"  real _is_safe_path exercised ({res['guard_loaded']})")
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--emit", action="store_true")
    ap.add_argument("--run", action="store_true")
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--iters", type=int, default=1000)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    if a.emit:
        ast.parse(EMITTED)
        sys.stdout.write(EMITTED)
        return 0
    res = _run_builtin(a.work, a.iters)
    # Real findings outrank an incomplete corpus and are reported below; but a
    # CLEAN run with Property B's subject never loaded would cover only the URL
    # property while CLAIMING both (CLAUDE.md s0) -- no corpus, no verdict.
    if not res["violations"] and not res["guard_loaded"]:
        sec.emit(res, as_json=a.json)
        print(f"{Y}BD-UNEVALUABLE{RST}: bulk_downloader/backup.py _is_safe_path did not "
              f"load -- path-confinement property NOT tested (URL property alone "
              f"held on {res['tested']} cases).", file=sys.stderr)
        return sec.EXIT_CANNOT_EVALUATE
    if sec.emit(res, as_json=a.json):
        return 1 if res["violations"] else 0
    if not res["violations"]:
        print(f"{G}all properties held across {res['tested']} generated cases{RST}")
        return 0
    for v in res["violations"][:30]:
        print(f"  {R}BD-PROP-VIOLATION{RST} {v['prop']}: {v.get('input')}  {DIM}{v}{RST}")
    print(f"{R}{len(res['violations'])} property violation(s){RST}")
    return 1


sys.exit(main())
