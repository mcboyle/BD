#!/usr/bin/env python3
"""bd-regen -- check (or regenerate) every derived in-sync doc in one shot.

The pre-cut footgun: build_release runs the in-sync gates only AFTER the ~3-min
tsc+vitest chain and ABORTS on stale, forcing a full re-cut. Running this FIRST
(regenerate up front, confirm --check clean) avoids the retry.

Covers: FUNCTION_INDEX, DEPENDENCY_GRAPH, PIN_INDEX, route counts. (Import-graph
baseline is a SEPARATE freeze -- use bd-imports.)

Usage:
    bd-regen            # --check all generators, report DRIFT/OK (default)
    bd-regen --write    # actually regenerate the stale ones
    bd-regen --work DIR
Exit 0 if all in sync (or all written), 1 if any drifted (in --check mode).
"""
import argparse
import os
import subprocess
import sys

# --- 702: --selftest delegates to the tool's own bd-coretest fault-injection case.
# These are the RELEASE-GATING MUTATORS: they edit the tree and gate a cut, and they
# had NO selftest at their own entry point (bd-tool-lint: 10/10 untested). The teeth
# already existed in bd-coretest -- they were just unreachable from the tool itself.
# Delegating (not re-asserting) keeps ONE source of truth for what "correct" means.
def _selftest_via_coretest():
    import subprocess as _sp, sys as _sys, os as _os
    _me = _os.path.basename(_os.path.realpath(__file__))
    _ct = _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "bd-coretest")
    if not _os.path.isfile(_ct):
        print("SELFTEST FAIL -- bd-coretest not found (cannot verify teeth)")
        return 2
    _cp = _sp.run([_sys.executable, _ct, "--only", _me], capture_output=True, text=True)
    for _ln in _cp.stdout.splitlines():
        if _ln.startswith(_me) or _ln.strip().startswith("["):
            print(_ln)
    print("SELFTEST PASS" if _cp.returncode == 0 else "SELFTEST FAIL")
    return _cp.returncode


if "--selftest" in sys.argv:
    sys.exit(_selftest_via_coretest())


G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

# (label, script rel-path, check-flag, write-flag)
GEN = [
    ("FUNCTION_INDEX",  "tools/build_function_index.py", "--check", None),
    ("DEPENDENCY_GRAPH", "tools/dependency_graph.py",    "--check", None),
    ("PIN_INDEX",       "tools/build_pin_index.py",      "--check", None),
    ("route counts",    "tools/check_route_counts.py",   "--check", None),
]


def python_for(work):
    """Prefer the work tree's Python environment, then the running interpreter.
    The container's bare interpreter is 3.11 without the project deps (CLAUDE.md
    section 5), so the generators must run under <work>/venv."""
    for environment in (".venv", "venv"):
        py = os.path.join(work, environment, "bin", "python")
        if os.path.isfile(py) and os.access(py, os.X_OK):
            return py
    return sys.executable


def run(work, path, *args):
    env = {**os.environ, "PYTHONPATH": work}
    r = subprocess.run([python_for(work), path, *args], cwd=work, capture_output=True,
                       text=True, env=env, timeout=150)
    return r.returncode, (r.stdout + r.stderr)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work","--tree", default="/home/claude/work")
    ap.add_argument("--write", action="store_true")
    a = ap.parse_args()
    drift = 0
    missing = 0
    for label, rel, checkflag, writeflag in GEN:
        path = os.path.join(a.work, rel)
        if not os.path.exists(path):
            print(f"  {Y}?? {RST}{label} {DIM}({rel} missing){RST}")
            missing += 1
            continue
        if a.write:
            # regenerate for real: bare run writes; a declared --write flag is used as-is.
            wflag = [writeflag] if writeflag else []
            rc, out = run(a.work, path, *wflag)
            print(f"  {(G+'wrote'+RST) if rc == 0 else (R+'FAIL '+RST)} {label}")
            if rc != 0:
                print(f"        {DIM}{out.strip()[-160:]}{RST}")
                drift += 1
            continue
        # check mode -- provably read-only: run each generator ONLY with its DECLARED
        # read-only check invocation. NEVER probe capability by running --help. That
        # probe is what broke this: build_pin_index had no argparse and fell through
        # to out.write_text() on any unrecognized argv, so asking "do you support
        # --check?" REGENERATED the artifact and erased the very drift this check
        # exists to report -- then printed "all derived docs in sync", exit 0.
        if not checkflag:
            # UNKNOWN is a third state and it FAILS. A generator with no declared
            # read-only invocation cannot be verified here, and running it blind is
            # how the artifact got rewritten. Report it and refuse the green verdict.
            print(f"  {Y}?? {RST}{label} {DIM}(no declared --check; cannot verify){RST}")
            missing += 1
            continue
        rc, out = run(a.work, path, checkflag)
        if rc == 0:
            print(f"  {G}OK   {RST}{label}")
        else:
            print(f"  {R}DRIFT{RST} {label} {DIM}(regen needed){RST}")
            drift += 1
    if a.write:
        ok = not (drift or missing)
        print(f"{G}RESULT: regenerated{RST}" if ok
              else f"{R}RESULT: {drift} generator(s) failed, {missing} missing{RST}")
        return 0 if ok else 1
    # `missing` was previously incremented and never read, so a tree where EVERY
    # generator was absent printed "all derived docs in sync" and exited 0.
    if drift or missing:
        print(f"{R}RESULT: {drift} drifted, {missing} unverifiable/missing "
              f"-- NOT in sync{RST}")
        return 1
    print(f"{G}RESULT: all derived docs in sync{RST}")
    return 0


sys.exit(main())
