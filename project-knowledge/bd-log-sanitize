#!/usr/bin/env python3
"""bd-log-sanitize -- scrub a log/text file for safe handoff sharing.

Applies the secret redaction ruleset (jwt/bearer/aws/kv-secret/signed-url +
loopback/internal hosts) to a log file and writes a scrubbed copy, reporting how
many redactions per rule. --check mode only reports whether the log is already
clean (exit 1 if secrets present) without writing. Reuses bd-redaction-compiler's
ruleset shape. Read-only w.r.t. the source (writes a *.scrubbed copy).

Usage:
    bd-log-sanitize LOGFILE [--out FILE] [--json]
    bd-log-sanitize LOGFILE --check          # is it already safe?
    bd-log-sanitize --selftest
Exit 1 if --check finds secrets, else 0.
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
RULES=[("jwt",re.compile(r"eyJ[A-Za-z0-9_\-]{6,}\.[A-Za-z0-9_\-]{6,}\.[A-Za-z0-9_\-]{6,}"),"[REDACTED_JWT]"),
       ("bearer",re.compile(r"(?i)\bBearer\s+[A-Za-z0-9_\-\.=]{12,}"),"Bearer [REDACTED]"),
       ("aws",re.compile(r"AKIA[0-9A-Z]{16}"),"[REDACTED_AWS]"),
       ("signed_url",re.compile(r"(?i)([?&](?:token|sig|signature|expires|auth)=)[A-Za-z0-9_\-\.=%/+]{6,}"),r"\1[REDACTED]"),
       ("internal_host",re.compile(r"\b(?:10\.\d+\.\d+\.\d+|127\.0\.0\.1|169\.254\.\d+\.\d+|192\.168\.\d+\.\d+)\b"),"[REDACTED_HOST]")]
RE_KV=re.compile(r"(?i)\b(api[_-]?key|secret|token|password|csrf[_-]?token)(\s*[=:]\s*)[A-Za-z0-9_\-\.=/+]{8,}")

def scrub(text):
    counts={}
    for name,rx,repl in RULES:
        text,n=rx.subn(repl,text); counts[name]=counts.get(name,0)+n
    text,n=RE_KV.subn(lambda m:m.group(1)+m.group(2)+"[REDACTED]",text); counts["kv_secret"]=n
    return text, {k:v for k,v in counts.items() if v}

def selftest():
    ok=True
    dirty='login Bearer abcdef0123456789ABCDEF at 10.0.70.20 key api_key=supersecret123 url?token=abcdef012345'
    clean,counts=scrub(dirty)
    got=sum(counts.values())>=4 and "Bearer [REDACTED]" in clean and "[REDACTED_HOST]" in clean
    print(("PASS" if got else "FAIL")+"  multi-secret log scrubbed (%s)"%counts)
    ok=ok and got
    safe="just a normal log line with no secrets"
    c2,cnt2=scrub(safe)
    print(("PASS" if c2==safe and not cnt2 else "FAIL")+"  clean log untouched")
    ok=ok and c2==safe
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("logfile",nargs="?")
    ap.add_argument("--out",default=None); ap.add_argument("--check",action="store_true")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    if not a.logfile or not os.path.exists(a.logfile):
        print(R+"logfile required (existing path)"+RST); return 1
    text=open(a.logfile,errors="ignore").read()
    scrubbed,counts=scrub(text)
    total=sum(counts.values())
    if a.check:
        if sec.emit({"file":a.logfile,"secrets_found":total,"by_rule":counts},as_json=a.json): return 1 if total else 0
        if total: print("%s%d secret(s) present%s %s"%(R,total,RST,counts)); return 1
        print(G+"log is already safe to share"+RST); return 0
    out=a.out or (a.logfile+".scrubbed")
    open(out,"w").write(scrubbed)
    if sec.emit({"out":out,"redactions":total,"by_rule":counts},as_json=a.json): return 0
    print(G+"scrubbed"+RST+" -> %s (%d redactions: %s)"%(out,total,counts))
    return 0
if __name__ == "__main__":
    sys.exit(main())
