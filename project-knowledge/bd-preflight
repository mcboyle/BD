#!/usr/bin/env python3
"""bd-preflight -- assert the work tree faithfully matches the uploaded source
zip BEFORE any edit/build. Catches the stale-frontend divergence (and friends)
in ~2 seconds instead of 30 minutes into a cut.

Checks (each prints PASS/FAIL; exits non-zero on any failure):
  1. backend __version__ == the zip's version
  2. EVERY tracked file in work/ matches the zip byte-for-byte (excluding
     node_modules / __pycache__ / *.pyc) -> reports MISSING / EXTRA / CHANGED.
     This is the heart: it directly catches a stale frontend/src, stale tools,
     drifted guards, etc. -- one check, total fidelity.
  3. node_modules is usable + matches package-lock: vite/tsc resolve AND the
     work-tree package-lock.json sha == the zip's (stale deps => offline build
     silently uses old packages or fails 'vite: not found' -- the npm footgun).
  4. (--determinism, optional/slower) rebuild the UNMODIFIED frontend and assert
     the produced bundle hash == the zip's shipped dist bundle -> proves the
     sandbox toolchain reproduces the shipped artifact (catches cross-session
     toolchain drift before a cut, not after).

Usage:
    bd-preflight                       # checks 1-3
    bd-preflight --determinism         # + check 4 (runs a vite build)
    bd-preflight --zip /path/to.zip    # pin a specific source zip
    bd-preflight --work /home/claude/work

Exit: 0 = all green, 1 = any failure. Wrap in `bd` so PATH/Flask/etc. are set:
    bd python3 /path/to/bd-preflight --determinism
"""
import argparse
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile
import zipfile

EXCLUDE_DIRS = ("node_modules", "__pycache__", ".git", "venv", ".venv",
                ".pytest_cache", "bd_home")
EXCLUDE_SUFFIX = (".pyc",)
GREEN, RED, DIM, RST = "\033[32m", "\033[31m", "\033[2m", "\033[0m"


def _ok(msg):  print(f"  {GREEN}PASS{RST}  {msg}")
def _bad(msg): print(f"  {RED}FAIL{RST}  {msg}")


def _sha(b):
    return hashlib.sha256(b).hexdigest()


def _excluded(rel):
    parts = rel.split("/")
    if any(p in EXCLUDE_DIRS for p in parts):
        return True
    return rel.endswith(EXCLUDE_SUFFIX)


def find_zip(uploads="/mnt/user-data/uploads"):
    """Highest embedded-version BulkDownloader_v*.zip (mirrors bd-install)."""
    best, best_ver = None, None
    import glob
    for z in glob.glob(os.path.join(uploads, "BulkDownloader_v*.zip")):
        try:
            with zipfile.ZipFile(z) as zf:
                init = next((n for n in zf.namelist()
                             if n.endswith("bulk_downloader/__init__.py")), None)
                if not init:
                    continue
                txt = zf.read(init).decode("utf-8", "replace")
        except Exception:  # why: this zip is not a readable BD release; skip it, others remain
            continue
        ver = None
        for line in txt.splitlines():
            if "__version__" in line and "=" in line:
                ver = line.split("=", 1)[1].strip().strip('"').strip("'")
                break
        if not ver:
            continue
        key = tuple(int(x) for x in ver.replace("-", ".").split(".") if x.isdigit())
        if best_ver is None or key > best_ver:
            best, best_ver = z, key
    return best


def zip_members(zpath):
    """rel-path -> sha256 for every non-excluded file in the zip."""
    out = {}
    with zipfile.ZipFile(zpath) as zf:
        for n in zf.namelist():
            if n.endswith("/") or _excluded(n):
                continue
            out[n] = _sha(zf.read(n))
    return out


def tree_members(work):
    out = {}
    for root, dirs, files in os.walk(work):
        dirs[:] = [d for d in dirs if d not in EXCLUDE_DIRS]
        for f in files:
            full = os.path.join(root, f)
            rel = os.path.relpath(full, work)
            if _excluded(rel):
                continue
            try:
                with open(full, "rb") as fh:
                    out[rel] = _sha(fh.read())
            except OSError:
                pass
    return out


def check_version(work, zpath):
    def ver_of(read):
        for line in read.splitlines():
            if "__version__" in line and "=" in line:
                return line.split("=", 1)[1].strip().strip('"').strip("'")
        return None
    wt = open(os.path.join(work, "bulk_downloader/__init__.py")).read()
    with zipfile.ZipFile(zpath) as zf:
        zt = zf.read("bulk_downloader/__init__.py").decode()
    wv, zv = ver_of(wt), ver_of(zt)
    if wv == zv:
        _ok(f"backend version {wv} == zip")
        return True
    _bad(f"backend version {wv} != zip {zv}  (work tree is stale / not extracted)")
    return False


def check_tree(work, zpath):
    z, t = zip_members(zpath), tree_members(work)
    zk, tk = set(z), set(t)
    missing = sorted(zk - tk)          # in zip, absent from work  <- the stale-frontend bug
    changed = sorted(k for k in (zk & tk) if z[k] != t[k])
    # EXTRA: ignore generated runtime/build noise; only flag tracked-looking extras
    extra = sorted(k for k in (tk - zk)
                   if not k.startswith(("reports/", "frontend/dist/"))
                   and "/" in k  # ignore top-level runtime dot-state markers
                   and not k.endswith((".db", ".log", ".tsbuildinfo")))
    bad = bool(missing or changed)
    if not bad and not extra:
        _ok(f"work tree matches zip byte-for-byte ({len(z)} tracked files)")
    else:
        if missing:
            _bad(f"{len(missing)} file(s) MISSING from work (present in zip):")
            for m in missing[:12]:
                print(f"        {DIM}- {m}{RST}")
            if len(missing) > 12:
                print(f"        {DIM}... +{len(missing)-12} more{RST}")
        if changed:
            _bad(f"{len(changed)} file(s) CHANGED vs zip:")
            for c in changed[:12]:
                print(f"        {DIM}~ {c}{RST}")
            if len(changed) > 12:
                print(f"        {DIM}... +{len(changed)-12} more{RST}")
        if extra:
            print(f"  {DIM}note: {len(extra)} extra tracked file(s) in work not in zip "
                  f"(informational): {extra[:5]}{RST}")
    return not bad



def check_venv(work):
    """v3.66.721: the SERVICE VENV must exist. Its loss is completely silent.

    FG-BOOT-REVERTS-WORKTREE has a second consequence nobody had stated: bd-install does
    `rm -rf work/*` before extracting, and the release zip contains NO venv/ -- so
    re-running bd-boot/bd-install mid-session DESTROYS the venv and nothing restores it.
    Every tool that hardcodes venv/bin/python then silently probes NOTHING. That is
    exactly how bd-sbcap came to print "chromium build resolvable" having verified
    nothing at all: it probed $VENV/python, got an empty result, and the empty result
    fell through to the success branch.

    A missing venv is not fatal to the sandbox (tests run on the prestaged interpreter),
    so this is a LOUD WARNING rather than a hard failure -- but it must never be silent.
    """
    vpy = os.path.join(work, "venv", "bin", "python3")
    vpy_alt = os.path.join(work, "venv", "bin", "python")
    if os.path.isfile(vpy) or os.path.isfile(vpy_alt):
        _ok("service venv present (work/venv)")
        return True
    _bad("service venv MISSING (work/venv) -- re-running bd-boot/bd-install destroys it "
         "(rm -rf work/*; the zip has no venv/). Tools hardcoding venv/bin/python now "
         "probe NOTHING and may report OK having verified nothing. FIX: bd-venv")
    return False

def check_node_modules(work, zpath):
    fe = os.path.join(work, "frontend")
    vite = os.path.join(fe, "node_modules/.bin/vite")
    tsc = os.path.join(fe, "node_modules/.bin/tsc")
    have = os.path.exists(vite) and os.path.exists(tsc)
    if not have:
        _bad("node_modules missing vite/tsc -> offline SPA build impossible")
        return False
    # lockfile parity: stale node_modules vs a new dep = silent old-deps build
    lock = "frontend/package-lock.json"
    wl = os.path.join(work, lock)
    zhash = None
    try:
        with zipfile.ZipFile(zpath) as zf:
            if lock in zf.namelist():
                zhash = _sha(zf.read(lock))
    except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
        pass
    if zhash is None or not os.path.exists(wl):
        _ok("node_modules present (vite/tsc resolve); no package-lock to cross-check")
        return True
    with open(wl, "rb") as fh:
        whash = _sha(fh.read())
    if whash == zhash:
        _ok("node_modules present + package-lock matches zip")
        return True
    _bad("package-lock.json differs from zip -> staged node_modules may be STALE; "
         "refresh the deps kit before an offline build")
    return False


def check_vitest(work):
    # The jsdom behavioral-test harness must be ready every bootstrap.
    # config + setup ship in the source tree (check_tree already pins them
    # byte-for-byte); this additionally asserts the vitest binary resolves,
    # so a fresh sandbox can actually run the cut-time gate (bd-cut step 1b
    # = `node_modules/.bin/vitest run`). Read-only: never writes the tree.
    fe = os.path.join(work, "frontend")
    cfg = os.path.join(fe, "vitest.config.ts")
    setup = os.path.join(fe, "vitest.setup.ts")
    vbin = os.path.join(fe, "node_modules/.bin/vitest")
    miss = [p for p in (cfg, setup, vbin) if not os.path.exists(p)]
    if miss:
        _bad("vitest harness not ready -> missing "
             + ", ".join(os.path.relpath(m, work) for m in miss)
             + "  (config/setup ship in the zip; run `npm install` in "
             + "frontend/ if only the binary is absent)")
        return False
    _ok("vitest harness ready (config + setup + node_modules/.bin/vitest)")
    return True


def check_determinism(work, zpath):
    """Rebuild unmodified frontend; assert the JS bundle hash == the zip's."""
    fe = os.path.join(work, "frontend")
    # the zip's shipped JS bundle name + bytes
    with zipfile.ZipFile(zpath) as zf:
        js = [n for n in zf.namelist()
              if n.startswith("frontend/dist/assets/") and n.endswith(".js")]
        if not js:
            _bad("determinism: zip has no dist JS bundle to compare")
            return False
        shipped = sorted(js)[0]
        shipped_hash = _sha(zf.read(shipped))
    print(f"  {DIM}determinism: rebuilding unmodified frontend (vite build)...{RST}")
    # Build into a THROWAWAY outDir so we never touch the work tree's
    # frontend/dist (vite's default cwd build overwrites it; this system's
    # vite is non-deterministic, so an in-place rebuild both produces a
    # false FAIL *and* leaves the tree diverged from the zip). Read-only:
    # never writes the tree -- consistent with check_vitest's contract.
    tmp_out = tempfile.mkdtemp(prefix="bd_determinism_dist_")
    try:
        r = subprocess.run(["node_modules/.bin/vite", "build",
                            "--outDir", tmp_out, "--emptyOutDir"], cwd=fe,
                           capture_output=True, text=True, timeout=150)
        if r.returncode != 0:
            _bad("determinism: vite build failed\n" + r.stderr[-400:])
            return False
        assets = os.path.join(tmp_out, "assets")
        built = sorted(p for p in os.listdir(assets)
                       if p.endswith(".js")) if os.path.isdir(assets) else []
        if not built:
            _bad("determinism: no JS bundle produced")
            return False
        with open(os.path.join(assets, built[0]), "rb") as fh:
            built_hash = _sha(fh.read())
    finally:
        shutil.rmtree(tmp_out, ignore_errors=True)
    if built_hash == shipped_hash:
        _ok(f"determinism: rebuild reproduces shipped bundle {os.path.basename(shipped)}")
        return True
    _bad(f"determinism: rebuilt {built[0]} != shipped {os.path.basename(shipped)} "
         f"-> toolchain drift OR work-tree src differs from zip")
    return False


def selftest():
    """DELEGATE: wraps bd-state. FAIL if the target is not present in the bin dir."""
    import os as _o
    here=_o.path.dirname(_o.path.realpath(__file__))
    found=_o.path.isfile(_o.path.join(here,"bd-state"))
    print(("PASS" if found else "FAIL")+"  delegation target present: bd-state")
    print("SELFTEST PASS" if found else "SELFTEST FAIL"); return 0 if found else 1


def main(argv=None):
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser(description="assert work tree == source zip")
    ap.add_argument("--work","--tree", default="/home/claude/work")
    ap.add_argument("--zip", default=None, help="source zip (default: highest in uploads)")
    ap.add_argument("--determinism", action="store_true",
                    help="also rebuild unmodified frontend + compare bundle hash")
    a = ap.parse_args(argv)

    zpath = a.zip or find_zip()
    if not zpath:
        print(f"{RED}FAIL{RST}  no source zip found in uploads")
        return 1
    if not os.path.isdir(os.path.join(a.work, "bulk_downloader")):
        print(f"{RED}FAIL{RST}  no work tree at {a.work} (run bd-install)")
        return 1

    print("=" * 66)
    print(f"  bd-preflight -- work={a.work}")
    print(f"               zip ={os.path.basename(zpath)}")
    print("=" * 66)
    results = [
        check_version(a.work, zpath),
        check_tree(a.work, zpath),
        check_node_modules(a.work, zpath),
        check_vitest(a.work),
        check_venv(a.work),
    ]
    if a.determinism:
        results.append(check_determinism(a.work, zpath))
    print("=" * 66)
    if all(results):
        print(f"  {GREEN}RESULT: PASS{RST} -- work tree matches the source zip")
        return 0
    print(f"  {RED}RESULT: FAIL{RST} -- fix divergence before editing/building")
    print(f"  {DIM}stale frontend? : rm -rf {a.work}/frontend/src && "
          f"cp -r <zip>/frontend/src {a.work}/frontend/src{RST}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
