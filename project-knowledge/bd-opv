def _client(auth_token=None):
    """Boot the BD app under the test client. Returns (client, app)."""
    os.environ.setdefault("BD_HOME", tempfile.mkdtemp(prefix="opv_"))
    os.environ.setdefault("BD_DISABLE_KEEPALIVE", "1")
    if auth_token:
        os.environ["BD_AUTH_TOKEN"] = auth_token
    import importlib
    import bulk_downloader.app as m
    importlib.reload(m) if "BD_AUTH_TOKEN" in os.environ else None
    return m.app.test_client(), m.app


def _csrf(c):
    r = c.get("/api/csrf")
    d = r.get_json() or {}
    return d.get("csrf_token") or d.get("token") or ""


