        "recaptcha": '<div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe"></div>',
        "cloudflare": '<div id="cf-please-wait"><div id="challenge-stage"></div></div>',
    }
