               '<a href="/detail/clip1">clip1</a><a href="/detail/clip2">clip2</a></body></html>')
    DETAIL = ('<!doctype html><html lang="en"><head><title>d</title></head><body>'
              '<video src="/media/s.mp4"></video><a class="download-link" href="/media/s.mp4">dl</a></body></html>')
    MP4 = bytes.fromhex("000000186674797069736f6d0000020069736f6d69736f32") + b"\x00" * 256

    class _H(_hs.BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def _s(self, body, ct="text/html; charset=utf-8"):
            b = body.encode() if isinstance(body, str) else body
            self.send_response(200); self.send_header("Content-Type", ct)
            self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
        def do_GET(self):
            p = self.path
            if p in ("/", "/listing"): self._s(LISTING)
            elif p.startswith("/detail/"): self._s(DETAIL)
            elif p == "/media/s.mp4": self._s(MP4, "video/mp4")
            elif p.startswith("/challenge/"):
                k = p.rsplit("/", 1)[-1]
                self._s(f'<!doctype html><html lang="en"><head><title>{TITLES.get(k,"x")}</title>'
                        f'</head><body>{CH.get(k,"")}</body></html>')
            else:
                self.send_response(404); self.end_headers()

    _ss.TCPServer.allow_reuse_address = True
    port = 8774
    try:
        httpd = _ss.TCPServer(("127.0.0.1", port), _H)
    except OSError:
        port = 8775; httpd = _ss.TCPServer(("127.0.0.1", port), _H)
    _th.Thread(target=httpd.serve_forever, daemon=True).start()
    _t.sleep(0.3)
    base = f"http://127.0.0.1:{port}"
    try:
        html_res = {}
        for k in CH:
            h = _u.urlopen(f"{base}/challenge/{k}", timeout=3).read().decode()
            html_res[k] = CR.detect_captcha_in_html(h, TITLES[k])
        clean_html = _u.urlopen(f"{base}/detail/clip1", timeout=3).read().decode()
        html_clean = CR.detect_captcha_in_html(clean_html, "d")

        dom_res = {}
        with sync_playwright() as pw:
            b = pw.chromium.launch(headless=False, args=["--no-sandbox", "--disable-dev-shm-usage"])
            pg = b.new_page()
            for k in CH:
                pg.goto(f"{base}/challenge/{k}", wait_until="domcontentloaded", timeout=8000)
                dom_res[k] = CR.detect_captcha_in_page(pg)
            pg.goto(f"{base}/detail/clip1", wait_until="domcontentloaded", timeout=8000)
            dom_clean = CR.detect_captcha_in_page(pg)
            b.close()

        lst = _u.urlopen(f"{base}/listing", timeout=3).read().decode()
        links = _re.findall(r'href="(/detail/[^"]+)"', lst)
        media = None
        for dl in links:
            dh = _u.urlopen(base + dl, timeout=3).read().decode()
            mm = _re.search(r'href="(/media/[^"]+)"', dh)
            if mm:
                media = mm.group(1); break
        raw = _u.urlopen(base + media, timeout=3).read() if media else b""
    finally:
        httpd.shutdown()

    html_ok = all(html_res[k] == k for k in CH) and html_clean is None
    dom_ok = all(dom_res[k] == k for k in CH) and dom_clean is None
    dl_ok = raw[4:8] == b"ftyp" and len(raw) > 0 and len(links) >= 2
    handoff_ok = set(dom_res.values()) == set(CH.keys())  # every family -> a handoff type
