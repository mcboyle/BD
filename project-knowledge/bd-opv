def chk_f26_workbench():
    """OPV-F2.6 (sandboxable @539): the DOM-Analyzer workbench evaluates operator
    selectors against a (redacted) DOM and pins a REVIEW-ONLY draft. Drives the
    real selector_playground.evaluate_selectors + dom_analyzer.pin_candidate."""
    try:
        from bulk_downloader import dom_analyzer as DA
        from bulk_downloader import selector_playground as SP
    except Exception as e:
        return SKIP, f"analyzer import issue ({str(e)[:40]})"
    html = ("<div id=app><button id=dl class='btn'>Get</button>"
            "<ul><li class=item>A</li><li class=item>B</li></ul></div>")
    try:
        res = SP.evaluate_selectors(html, ["#dl", "li.item", ".nope"])
    except Exception as e:
        return FAIL, f"evaluate_selectors raised: {str(e)[:50]}"
    # evaluate_selectors reports a MISSING OPTIONAL DEP in each row's "error"
    # key rather than raising ("lxml not installed; ..."). Reading only "count"
    # turns that precondition miss into "selector counts wrong" -- a FAIL about
    # working code. Discriminate it (CLAUDE.md s2a) and SKIP with the reason.
    rows = res or []
    dep_err = next((r.get("error") for r in rows
                    if r.get("count") is None and r.get("error")), None)
    if dep_err:
        return SKIP, f"selector evaluation unavailable ({str(dep_err)[:60]})"
    by = {r.get("selector"): r.get("count") for r in rows}
    if not (by.get("#dl") == 1 and by.get("li.item") == 2 and by.get(".nope") == 0):
        return FAIL, f"selector counts wrong: {by}"
    import tempfile as _tf
    try:
        drafts = _tf.mkdtemp(prefix="opv_drafts_")
        pin = DA.pin_candidate("#dl", "download_button", host="synthetic.test",
                               drafts_dir=drafts, name="dl")
        enabled = bool(pin.get("enabled", False)) if isinstance(pin, dict) else True
        status = pin.get("status") if isinstance(pin, dict) else "?"
    except Exception as e:
        return FAIL, f"pin_candidate raised: {str(e)[:50]}"
    if enabled or status == "enabled":
        return FAIL, f"pinned candidate ENABLED (must be review-only): {status!r}"
    return PASS, f"selector eval correct; pin review-only (status={status!r})"


def chk_recognizer_corpus():
    """OPV-RECOG (new, sandboxable @539): the real recognizer fires against a live
    public player demo, headless, in-sandbox — proving the corpus-pull path
    (bd-corpus) works end-to-end. Picks a demo that renders its seam on load
    (dash.js reference client). SKIPs (precondition) if the browser/network isn't
    available; only a rendered-but-no-family case is a FAIL. Detection only — no
    media, no tokens (bd-corpus enforces the redaction gate)."""
    url = ("https://reference.dashif.org/dash.js/latest/samples/"
           "dash-if-reference-player/index.html")
    try:
        from playwright.sync_api import sync_playwright
    except Exception as e:
        return SKIP, f"playwright not importable ({str(e)[:40]}); run under bd"
    try:
        with sync_playwright() as p:
            b = p.chromium.launch(headless=True)
            pg = b.new_page()
            try:
                pg.goto(url, timeout=40000, wait_until="domcontentloaded")
                pg.wait_for_timeout(3000)
                dom = pg.content() or ""
            finally:
                b.close()
    except Exception as e:
        return SKIP, f"headless render unavailable ({type(e).__name__}); precondition"
    if not dom:
        return SKIP, "empty render; precondition"
    try:
        from bulk_downloader import plugins as _plugins
        verdict = _plugins.run_recognizers(dom[:20000], {}, {})
    except Exception as e:
        return SKIP, f"run_recognizers issue ({str(e)[:40]})"
    fam = ""
    try:
        fam = (getattr(verdict, "player_family", None)
               or (verdict.get("player_family") if isinstance(verdict, dict) else None)
               or ("dashjs" if "dashjs" in dom.lower() or "dash.js" in dom.lower() else ""))
    except Exception:  # why: the RECOGNIZER raised, and we fall back to a DOM string-sniff --
                       # i.e. an exception silently becomes a GUESS. Bounded on purpose: if the
                       # sniff finds nothing we return FAIL (possible drift) rather than PASS,
                       # so a broken recognizer cannot manufacture a green.
        fam = "dashjs" if "dashjs" in dom.lower() else ""
    if fam:
        return PASS, f"live recognizer fired on a public demo (family≈{fam}); corpus path works"
    return FAIL, "rendered a known player demo but no recognizer signal (possible drift)"


def chk_f11_retry_window():
    """OPV-F1.1 (sandboxable @540): the download-window retry gate snaps a
    retry that would fire while the site's window is CLOSED forward to the
    next window-open, and leaves an in-window retry (or a window-disabled
    site) unchanged. Drives the REAL admission.next_eligible_retry ->
    download_window.site_in_window/next_transition_seconds with a synthetic
    per-site config + injected retry timestamp -- a pure, clock-injectable
    path (same shape as F1.3), no browser/DB/display."""
    try:
        from bulk_downloader import admission as A
        from bulk_downloader import download_window as DW
    except Exception as e:
        return SKIP, f"admission/download_window import issue ({str(e)[:40]})"
    from datetime import datetime as _dt
    ts = lambda h, mi: _dt(2026, 7, 2, h, mi).timestamp()
    # inert when window disabled
    base = ts(10, 0)
    inert = A.next_eligible_retry(base, {"window_enabled": False})
    # in-window (allowed 09:00-18:00, retry 10:00) -> unchanged
    day = {"window_enabled": True, "window_active_hours": "09:00-18:00",
           "window_action_outside": "paused"}
    r_in = ts(10, 0)
    out_in = A.next_eligible_retry(r_in, day)
    # outside-window (retry 03:00) -> snapped forward, must land in an open window
    r_out = ts(3, 0)
    out_out = A.next_eligible_retry(r_out, day)
    snapped_in_win = DW.site_in_window(day, now=_dt.fromtimestamp(out_out))
    # midnight-crossing window 22:00-06:00, retry 12:00 -> snapped, must land in-window
    night = {"window_enabled": True, "window_active_hours": "22:00-06:00",
             "window_action_outside": "paused"}
    r_noon = ts(12, 0)
    out_night = A.next_eligible_retry(r_noon, night)
    night_in_win = DW.site_in_window(night, now=_dt.fromtimestamp(out_night))
    checks = {
        "window-off->inert": inert == base,
        "in-window->unchanged": out_in == r_in,
        "outside->moved-forward": out_out > r_out,
        "outside->lands-in-window": snapped_in_win,
        "midnight-cross->moved": out_night > r_noon,
        "midnight-cross->in-window": night_in_win,
    }
    bad = [k for k, v in checks.items() if not v]
    if bad:
        return FAIL, f"retry-window gate wrong: {bad}"
    return PASS, "closed-window retry snaps to next open; in-window/disabled unchanged"


def chk_f32_drift_repair():
    """OPV-F3.2 (sandboxable @540): the drift->AI-repair sweep is inert when
    AI is unavailable, and when AI proposes a replacement selector it lands a
    REVIEW-ONLY draft (status='draft_review_required', never enabled) via the
    real dom_analyzer.pin_candidate chokepoint. Drives the REAL
    drift_repair.propose_repairs with injected status_fn/ai_fn (the module's
    documented sandbox seam) + a synthetic DOM excerpt -- no live AI provider,
    no capture store, no display. The stash-only half is the dom_provider
    (pulling a real captured DOM); the proposal/gating/draft-write logic is
    fully exercised here."""
    try:
        from bulk_downloader import drift_repair as DR
    except Exception as e:
        return SKIP, f"drift_repair import issue ({str(e)[:40]})"
    import json as _json, tempfile as _tf
    from pathlib import Path as _P
    drafts = _P(_tf.mkdtemp(prefix="opv_f32_"))
    host = "opv-drift.test"
    dom = "<html><body><div class='new-row'><a class='t'>x</a></div></body></html>"
    ai_up = lambda: {"ok": True}
    ai_down = lambda: {"ok": False}
    def repair_fn(broken, working, excerpt, *, page_url=""):
        return {"ok": True, "repairs": [{"old_selector": ".old-row",
                "new_selector": ".new-row", "role": "row_selectors",
                "confidence": 0.82}]}
    # AI down -> inert
    r_down = DR.propose_repairs(host, broken_selectors=[".old-row"], dom_excerpt=dom,
                                drafts_dir=drafts, status_fn=ai_down, ai_fn=repair_fn)
    # AI up -> review-only draft
    r_up = DR.propose_repairs(host, broken_selectors=[".old-row"], dom_excerpt=dom,
                              drafts_dir=drafts, status_fn=ai_up, ai_fn=repair_fn)
    # empty broken set -> clean no-op
    r_none = DR.propose_repairs(host, broken_selectors=[], dom_excerpt=dom,
                                drafts_dir=drafts, status_fn=ai_up, ai_fn=repair_fn)
    status_val = enabled_val = None
    df = r_up.get("draft_file")
    if df:
        p = _P(df)
        if not p.is_absolute():
            p = drafts / p
        if p.exists():
            obj = _json.loads(p.read_text())
            status_val = obj.get("status")
            enabled_val = obj.get("enabled")
    checks = {
        "ai-down->inert": r_down.get("repairs") == 0 and r_down.get("skipped") == "ai_unavailable",
        "ai-up->one-draft": r_up.get("repairs") == 1 and bool(df),
        "draft->review-only": status_val == "draft_review_required",
        "draft->not-enabled": not enabled_val,
        "empty->noop": r_none.get("repairs") == 0,
    }
    bad = [k for k, v in checks.items() if not v]
    if bad:
        return FAIL, f"drift-repair posture wrong: {bad} (status={status_val!r})"
    return PASS, "AI-down inert; AI-up lands review-only draft (draft_review_required), never enabled"


def chk_f33_template_canary():
    """OPV-F3.3 (sandboxable @540): the template canary replays synthetic HAR
    fixtures HTTP-FREE (real synthetic_tests.run_all with an injected fixtures
    root -- the module is documented as making no HTTP requests) and the pure
    drop-detector (template_canary.compare_to_baseline) fires an alert for a
    site whose pass-rate collapsed vs its baseline, stays quiet for a healthy
    site, and never alerts on a first-sight site (no baseline). Two synthetic
    sites are built in a temp tree: one with matching markup (2/2 pass) and one
    with drifted markup (0/2). No live site, no DB, no network, no display."""
    try:
        from bulk_downloader import synthetic_tests as ST
        from bulk_downloader import template_canary as TC
    except Exception as e:
        return SKIP, f"canary import issue ({str(e)[:40]})"
    # PRECONDITION, not a finding: the whole fixture depends on CSS-selector
    # extraction, and synthetic_tests._try_selector is explicitly lxml-gated
    # (bulk_downloader/synthetic_tests.py:96-98 returns "lxml not installed").
    # Without it EVERY site extracts "" and both the good and the drifted site
    # score 0/2 -- which reads as "canary posture wrong" about code that is
    # fine. SKIP with the reason instead of manufacturing a FAIL.
    import importlib.util as _ilu
    if _ilu.find_spec("lxml") is None:
        return SKIP, ("lxml absent -- selector extraction is lxml-gated, so the "
                      "fixture replay cannot distinguish healthy from drifted")
    import json as _json, tempfile as _tf
    from pathlib import Path as _P
    root = _P(_tf.mkdtemp(prefix="opv_f33_"))

    def _har(body):
        return {"log": {"version": "1.2", "entries": [
            {"request": {"url": "u", "method": "GET"},
             "response": {"status": 200,
                          "content": {"mimeType": "text/html", "text": body}}}]}}

    def _wf(site, name, body, expects):
        d = root / site
        d.mkdir(parents=True, exist_ok=True)
