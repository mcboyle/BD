def chk_soak():
    """OPV-SOAK (sandboxable @540): a bounded in-process soak proves the app has
    no pathological per-request memory growth under sustained load, and freezegun
    time-warp drives the admission-window clock. Fires N read requests through
    app.test_client() while tracemalloc tracks heap growth; PASS = growth stays
    well under a per-request bound and every response is a real HTTP status. This
    is the sandbox-safe stand-in for the operator's long soak (a full week-long
    unattended run stays operator-gated; this proves the leak-freedom + time-warp
    machinery). Uses freezegun 1.5.5 for the clock warp."""
    try:
        import tracemalloc, gc, time as _t
        from bulk_downloader.app import app as _app
    except Exception as e:
        return SKIP, f"soak deps unavailable ({str(e)[:40]})"
    client = _app.test_client()
    endpoints = ["/api/health", "/api/history", "/api/csrf"]
    N = 300
    tracemalloc.start()
    gc.collect()
    snap0 = tracemalloc.take_snapshot()
    codes = {}
    for i in range(N):
        r = client.get(endpoints[i % len(endpoints)])
        codes[r.status_code] = codes.get(r.status_code, 0) + 1
    gc.collect()
    snap1 = tracemalloc.take_snapshot()
    grew = sum(s.size_diff for s in snap1.compare_to(snap0, "lineno") if s.size_diff > 0)
    tracemalloc.stop()
    per_req = grew / N
    # freezegun time-warp smoke (proves the admission window clock warps).
    # DISCRIMINATE the exception (CLAUDE.md s2a): freezegun is an OPTIONAL dep,
    # so its absence is a precondition miss and must not be reported as "soak
    # regressed" -- that is a false alarm about working code. Only a warp that
    # actually raised is a finding. Before v3.66.855 the whole check SKIPped on
    # an unrelated import error, so this arm was unreachable and the conflation
    # was invisible.
    warp_ok = True
    warp_note = "freezegun time-warp ran"
    try:
        from freezegun import freeze_time
    except ImportError as e:
        warp_ok = None
        warp_note = f"time-warp smoke unavailable ({str(e)[:40]})"
    if warp_ok is not None:
        try:
            from bulk_downloader import admission as A
            with freeze_time("2026-07-02 12:00:00"):
                A.next_eligible_retry(_t.time(),
                    {"window_enabled": True, "window_active_hours": "09:00-18:00",
                     "window_action_outside": "paused"})
        except Exception as e:
            warp_ok = False
            warp_note = f"time-warp RAISED: {type(e).__name__}: {str(e)[:50]}"
    checks = {
        "no-pathological-growth": per_req < 4096,
        "all-real-statuses": all(c in (200, 401, 403, 404, 405) for c in codes),
    }
    if warp_ok is not None:
        checks["freezegun-warp-ran"] = warp_ok
    bad = [k for k, v in checks.items() if not v]
    if bad:
        return FAIL, f"soak regressed: {bad} (per_req={per_req:.0f}B); {warp_note}"
    return PASS, f"{N} req, {per_req:.0f}B/req heap growth (no leak); {warp_note}"


