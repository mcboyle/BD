#!/usr/bin/env python3
"""bd-netns-launch-proof -- prove a launched process runs inside a netns.

Two evidences: (1) RUNTIME -- for a PID, its net-ns inode differs from the host;
(2) STATIC -- the launch path is confined by construction.

STATIC recognizes THREE confinement forms (v2):
  * argv wrap    -- netns_exec_argv / run_in_netns / ip netns exec in the body;
  * shim wrap    -- Playwright executable_path pointed at a netns shim
                    (netns_browser_shim / write_browser_shim / browser_launch_env)
                    -- the v3.66.699 browser-in-netns approach, which the v1 tool
                    did NOT recognize (it looked only for netns_exec_argv);
  * delegated    -- the function SPAWNs, references netns, has no in-body wrap, but
                    takes a `netns` PARAMETER -> the wrap lives in a helper it calls
                    (e.g. the 689 yt-dlp/gallery-dl fallbacks wrap in _build_ytdlp_cmd).
                    Reported as CONDITIONAL, not a hard gap (v1 over-flagged these).

A function that SPAWNs with netns context, has no wrap, and does NOT forward a
`netns` param is a genuine BD-NETNS-UNWRAPPED gap. Read-only.

Usage: bd-netns-launch-proof [--pid PID] [--work DIR] [--json] [--selftest]
"""
import argparse, ast, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

WRAP = re.compile(r"netns_exec_argv|run_in_netns|ip\s+netns\s+exec"
                  r"|capture_netns"                       # F5 isolation bracket (opt-in confine)
                  r"|netns_browser_shim|write_browser_shim|browser_launch_env")
SPAWN = re.compile(r"subprocess\.(?:Popen|run)|\.launch\(|launch_persistent")


def ns_inode(pid):
    try:
        t = os.readlink("/proc/%s/ns/net" % pid)
        return t.split("[", 1)[1].rstrip("]") if "[" in t else t
    except OSError:
        return None


def _has_netns_param(node):
    a = node.args
    names = []
    for grp in (getattr(a, "posonlyargs", []), a.args, a.kwonlyargs):
        names += [ar.arg for ar in grp]
    return "netns" in names


def static_scan(work):
    """Returns (hard_unwrapped, delegated). hard = genuine gap; delegated =
    wrap in a helper (param-gated), reported as conditional not a gap."""
    hard, delegated = [], []
    for _p, rel, txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        if "netns" not in txt and not SPAWN.search(txt):
            continue
        try:
            tree = ast.parse(txt)
        except SyntaxError:
            continue
        lines = txt.splitlines()
        for node in ast.walk(tree):
            if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                continue
            seg = "\n".join(lines[node.lineno - 1:getattr(node, "end_lineno", node.lineno + 30)])
            if not (SPAWN.search(seg) and "netns" in seg.lower()):
                continue
            if WRAP.search(seg):
                continue  # confined in-body (argv wrap OR executable_path shim)
            rec = {"file": rel, "func": node.name, "line": node.lineno}
            (delegated if _has_netns_param(node) else hard).append(rec)
    return hard, delegated


def selftest():
    ok = True
    ino = ns_inode("self"); host = ns_inode(1)
    print(("PASS" if ino and host else "FAIL") + "  ns inode read (self=%s host=%s)" % (ino, host))
    ok = ok and bool(ino and host)
    # determinism on both lists
    h1, d1 = static_scan(sec.DEFAULT_WORK); h2, d2 = static_scan(sec.DEFAULT_WORK)
    det = [(x["file"], x["line"]) for x in h1] == [(x["file"], x["line"]) for x in h2] \
        and [(x["file"], x["line"]) for x in d1] == [(x["file"], x["line"]) for x in d2]
    print(("PASS" if det else "FAIL") + "  static scan deterministic (hard=%d delegated=%d)" % (len(h1), len(d1)))
    ok = ok and det
    # NEG control: a shim-based launch is NOT a hard gap
    neg = 'def f(x):\n    executable_path = write_browser_shim("/t"); pw.chromium.launch_persistent(executable_path=executable_path)\n'
    try:
        t = ast.parse(neg); seg = neg
        flagged = SPAWN.search(seg) and "netns" not in seg.lower()
        recognized = bool(WRAP.search(seg))
        print(("PASS" if recognized else "FAIL") + "  shim (executable_path) recognized as wrapped")
        ok = ok and recognized
    except Exception as e:
        print("FAIL  shim recognition:", e); ok = False
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pid", default="self")
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    ino = ns_inode(a.pid); host = ns_inode(1)
    confined = bool(ino and host and ino != host)
    hard, delegated = static_scan(a.work)
    if sec.emit({"pid": a.pid, "ns_inode": ino, "host_ns_inode": host, "confined": confined,
                 "static_unwrapped": hard, "static_conditional_delegated": delegated},
                as_json=a.json):
        return 0 if not hard else 3
    tag = (G + "CONFINED" + RST) if confined else (Y + "not confined (shares host ns / stash-only)" + RST)
    print("runtime: pid %s -> %s (ns=%s host=%s)" % (a.pid, tag, ino, host))
    print("static: %d genuine gap(s) + %d conditional (wrap delegated to a helper)" % (len(hard), len(delegated)))
    for x in hard[:20]:
        print("  " + R + "BD-NETNS-UNWRAPPED" + RST + " %s:%s (L%s)  -- spawns, no wrap, no netns param" % (x["file"], x["func"], x["line"]))
    for x in delegated[:20]:
        print("  " + Y + "conditional" + RST + "        %s:%s (L%s)  -- netns param -> wrap in a helper (verify)" % (x["file"], x["func"], x["line"]))
    if not hard:
        print("  " + G + "no genuine unwrapped launch sites" + RST)
    return 3 if hard else 0


sys.exit(main())
