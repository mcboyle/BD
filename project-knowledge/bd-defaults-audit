#!/usr/bin/env python3
"""bd-defaults-audit -- audit dangerous default settings.

Scans for defaults that are risky when the app is exposed beyond its intended
single-user-LAN threat model: dev tools default-on, broad network bind
(0.0.0.0), permissive CORS (Access-Control-Allow-Origin: * / credentials
true), autoescape disabled, verify=False / shell=True defaults, and permissive
path roots. Each finding notes whether a documented mitigation (kill-switch,
env re-gate) exists. Advisory, read-only, deterministic.

Usage: bd-defaults-audit [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse
import os
import re
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

CHECKS = [
    ("BD-DEF-DEVON", "high", re.compile(r'def is_dev_mode'),
     lambda txt, i, lines: bool(re.search(r'return True',
                              "".join(lines[i - 1:i + 40]))),
     "dev surface default-on"),
    ("BD-DEF-BIND", "medium", re.compile(r'0\.0\.0\.0'),
     None, "broad network bind (0.0.0.0)"),
    ("BD-DEF-CORS-WILD", "high", re.compile(r'Access-Control-Allow-Origin["\']?\s*[:=].*\*'),
     None, "wildcard CORS origin"),
    ("BD-DEF-CORS-CRED", "high", re.compile(r'Allow-Credentials["\']?\s*[:=].*(true|True)'),
     None, "CORS allow-credentials true"),
    ("BD-DEF-NOESCAPE", "high", re.compile(r'autoescape\s*=\s*False'),
     None, "jinja autoescape disabled"),
    ("BD-DEF-VERIFY", "high", re.compile(r'verify\s*=\s*False'),
     None, "TLS verification disabled"),
    ("BD-DEF-SHELL", "high", re.compile(r'shell\s*=\s*True'),
     None, "subprocess shell=True"),
]
MITIGATION = re.compile(r'BD_DEV_MODE_DISABLE|kill[- _]?switch|re-?gate|SECURITY NOTE')


def scan(work):
    findings = []
    for _p, rel, txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        lines = txt.splitlines(keepends=True)
        has_mit = bool(MITIGATION.search(txt))
        for rule, sev, pat, extra_pred, desc in CHECKS:
            for m in pat.finditer(txt):
                i = txt[:m.start()].count("\n") + 1
                if extra_pred and not extra_pred(txt, i, lines):
                    continue
                findings.append(sec.finding(
                    "bd-defaults-audit", rule, sev, rel, i, desc,
                    mitigation_noted=has_mit, snippet=lines[i - 1].strip()[:100]))
    findings.sort(key=lambda f: (f["severity"] != "high", f["rule"], f["file"]))
    return findings


def selftest():
    ok = True
    risky = ('def is_dev_mode():\n    return True   # default on\n'
             'HEADERS = {"Access-Control-Allow-Origin": "*"}\n'
             'import requests\n'
             'def f(u): return requests.get(u, verify=False)\n')
    safe = ('def is_dev_mode():\n'
            '    # SECURITY NOTE: kill-switch below\n'
            '    if os.environ.get("BD_DEV_MODE_DISABLE"): return False\n'
            '    return True\n')
    clean = ('def add(a, b): return a + b\n')
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bulk_downloader")
        os.makedirs(b)
        open(os.path.join(b, "risky.py"), "w").write(risky)
        open(os.path.join(b, "safe.py"), "w").write(safe)
        open(os.path.join(b, "clean.py"), "w").write(clean)
        f = scan(d)
    rules = sorted({x["extra"]["snippet"][:1] and x["rule"] for x in f})
    risky_rules = {x["rule"] for x in f if os.path.basename(x["file"]) == "risky.py"}
    clean_hits = [x for x in f if os.path.basename(x["file"]) == "clean.py"]
    safe_mit = [x for x in f if os.path.basename(x["file"]) == "safe.py"
                and x["extra"]["mitigation_noted"]]
    good = ({"BD-DEF-DEVON", "BD-DEF-CORS-WILD", "BD-DEF-VERIFY"} <= risky_rules
            and clean_hits == [] and len(safe_mit) >= 1)
    print(("PASS" if good else "FAIL") +
          f"  fixture: risky flagged (rules={sorted(risky_rules)}), "
          f"clean=0, safe mitigation noted={bool(safe_mit)}")
    ok &= good
    a = scan(sec.DEFAULT_WORK)
    b2 = scan(sec.DEFAULT_WORK)
    det = [(x["rule"], x["file"], x["line"]) for x in a] == \
          [(x["rule"], x["file"], x["line"]) for x in b2]
    print(("PASS" if det else "FAIL") + f"  real-tree determinism ({len(a)} findings x2)")
    ok &= det
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    findings = scan(a.work)
    if sec.emit({"findings": findings, "summary": {
            "total": len(findings),
            "high": sum(1 for f in findings if f["severity"] == "high")}}, as_json=a.json):
        return 0
    if not findings:
        print(f"{G}no dangerous defaults found{RST}")
        return 0
    for f in findings[:50]:
        sev = (R if f["severity"] == "high" else Y) + f["severity"].upper() + RST
        mit = G + " [mitigation noted]" + RST if f["extra"]["mitigation_noted"] else ""
        print(f"  {sev:<14} {f['message']}  {DIM}{f['file']}:{f['line']}{RST}{mit}")
    print(f"{DIM}{len(findings)} dangerous-default finding(s) "
          f"(context: single-user-LAN threat model){RST}")
    return 0


sys.exit(main())
