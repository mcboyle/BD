#!/usr/bin/env python3
"""bd-release-attestation -- signed-style attestation bundle for a release.

Composes the release proof from the existing tools: bd-proof-ledger (version/
zip/guards/validation), bd-invariant-engine (which invariants hold), and
bd-evidence-chain (tamper-evident artifact root). Emits one attestation JSON
with an overall attested=true/false verdict (true iff STATE is honest AND all
invariants hold). Read-only.

Usage: bd-release-attestation [--home DIR] [--work DIR] [--json] [--selftest]
Exit 1 if not attestable, else 0.
"""
import argparse, hashlib, json, os, sys, time
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def _tool_json(tool, *args):
    """Delegates to sec.tool_json (ONE implementation, with an error channel).

    I-3: this was `except Exception: return None`, and callers wrote `... or {}`.
    A TIMED-OUT dependency was indistinguishable from one reporting nothing, and
    a crashed sub-tool silently zeroed whatever it fed. This pack is EVIDENCE; a
    pack assembled around a hole, that does not mention the hole, is not evidence.
    """
    data, err = sec.tool_json(tool, *args)
    if err:
        sys.stderr.write("CANNOT-EVALUATE: reason=DEP_FAILED (%s)\n" % err)
        sys.exit(sec.EXIT_CANNOT_EVALUATE)
    return data

def build(home, work):
    ledger = _tool_json("bd-proof-ledger", "--home", home)
    inv = _tool_json("bd-invariant-engine", "--work", work, "--home", home)
    chain = _tool_json("bd-evidence-chain", "--home", home)
    inv_ok = bool(inv) and inv.get("summary",{}).get("violated",1)==0
    state_ok = bool(ledger) and "error" not in ledger and ledger.get("guards",{}).get("count")==7
    att = {"schema":"bd-release-attestation/1",
            "generated_at":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime()),
            "version":(ledger or {}).get("version"),
            "attested": bool(inv_ok and state_ok),
            "state_honest":state_ok,"invariants_hold":inv_ok,
            "chain_root":(chain or {}).get("chain_root"),
            "proof_ledger_sha":(ledger or {}).get("self_sha256"),
            "invariants":(inv or {}).get("invariants")}
    # @805: a content fingerprint, so the attestation is REPRODUCIBLE. Same
    # pattern bd-proof-ledger already uses: hash the CONTENT with the volatile
    # fields excluded. Without it, two runs against an identical tree differed
    # only in generated_at, so the artifact could not be re-derived and
    # compared -- an attestation of WHEN, not WHAT. The timestamp stays in the
    # envelope; it just does not participate in the fingerprint. attestation_sha256
    # excludes itself and generated_at; every other field IS attested content and
    # must move the hash (the NEG the selftest pins).
    body = {k: v for k, v in att.items()
            if k not in ("attestation_sha256", "generated_at")}
    att["attestation_sha256"] = hashlib.sha256(
        json.dumps(body, sort_keys=True).encode()).hexdigest()
    return att

def _expect_version():
    """The version the SOURCE TREE declares about itself.

    Deliberately a DIFFERENT route than the one under test (which reads the
    STATE pin), so this stays a cross-check and not x==x. Refuses rather than
    comparing None to None -- an absent comparand is CANNOT-EVALUATE, not a pass.
    """
    v = sec.detect_tree_version(sec.DEFAULT_WORK)
    if not v:
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=ABSENT "
                         "(work tree declares no __version__)\n")
        sys.exit(2)
    return v


def selftest():
    ok=True
    att=build("/home/claude", sec.DEFAULT_WORK)
    want=_expect_version()
    print(("PASS" if att.get("version")==want else "FAIL")+"  composes 3 tools (version=%s, want %s)"%(att.get("version"),want))
    ok=ok and att.get("version")==want
    print(("PASS" if att.get("attested") else "FAIL")+"  attested true on pristine 688 (state=%s inv=%s)"%(att.get("state_honest"),att.get("invariants_hold")))
    ok=ok and att.get("attested")
    print(("PASS" if att.get("chain_root") else "FAIL")+"  evidence chain root present")
    ok=ok and bool(att.get("chain_root"))

    # @805: the attestation must be REPRODUCIBLE. Two builds against the same
    # inputs used to differ only in generated_at, with no fingerprint to
    # compare. Mock the 3 composed tools so the inputs are fixed, then pin:
    # (a) a fingerprint exists, (b) it survives a second build across a
    # timestamp tick, (c) a content change moves it. Same shape proven in
    # bd-proof-ledger's selftest.
    _real=globals()["_tool_json"]
    _LED={"version":"3.66.999","self_sha256":"s","guards":{"count":7}}
    _INV={"summary":{"violated":0},"invariants":[{"id":"X","ok":True}]}
    _CHN={"chain_root":"deadbeef"}
    def _mock(led):
        return lambda tool,*a:(led if "ledger" in tool else _INV if "invariant" in tool else _CHN if "evidence-chain" in tool else {})
    try:
        globals()["_tool_json"]=_mock(_LED)
        a1=build("/home/claude",sec.DEFAULT_WORK)
        time.sleep(1.1)  # force a generated_at tick
        a2=build("/home/claude",sec.DEFAULT_WORK)
        globals()["_tool_json"]=_mock({**_LED,"version":"3.66.111"})
        a3=build("/home/claude",sec.DEFAULT_WORK)
    finally:
        globals()["_tool_json"]=_real
    has_fp="attestation_sha256" in a1
    print(("PASS" if has_fp else "FAIL")+"  attestation_sha256 fingerprint present")
    ok=ok and has_fp
    repro=has_fp and a1.get("attestation_sha256")==a2.get("attestation_sha256")
    print(("PASS" if repro else "FAIL")+"  fingerprint reproducible across a timestamp tick")
    ok=ok and repro
    ts_only=(a1.get("generated_at")!=a2.get("generated_at"))
    print(("PASS" if ts_only else "FAIL")+"  generated_at actually varied (tick observed)")
    ok=ok and ts_only
    neg=has_fp and a3.get("attestation_sha256")!=a1.get("attestation_sha256")
    print(("PASS" if neg else "FAIL")+"  NEG: version change moves the fingerprint")
    ok=ok and neg

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--home",default="/home/claude"); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    sec.require_bundle(a.home)
    att=build(a.home,a.work)
    if sec.emit(att,as_json=a.json): return 0 if att["attested"] else 1
    tag=(G+"ATTESTED"+RST) if att["attested"] else (R+"NOT ATTESTABLE"+RST)
    print("release v%s: %s"%(att["version"],tag))
    print("  state honest: %s | invariants hold: %s"%(att["state_honest"],att["invariants_hold"]))
    print("  chain root: %s"%(att.get("chain_root") or "")[:20])
    return 0 if att["attested"] else 1


if __name__ == "__main__":
    sys.exit(main())
