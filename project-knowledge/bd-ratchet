#!/usr/bin/env python3
"""bd-ratchet -- turn any metric into a monotonic gate (Plan A2 + F1).

The suite measures many things (defect counts, coupling, unwired endpoints) but
nothing STOPS them regressing -- every metric is a snapshot that evaporates. This
records each metric per-run and FAILS a cut if it moved the wrong way.

  bd-ratchet --collect [--tree DIR]     measure all known metrics, append to store
  bd-ratchet --baseline                 pin the current values as the ratchet floor/ceiling
  bd-ratchet --check [--tree DIR]       exit 3 if ANY metric regressed vs baseline
  bd-ratchet --trend <name>             show a metric over runs
  bd-ratchet --selftest

Metrics (name, direction): a 'ceiling' metric must NOT rise; a 'floor' must NOT fall.
Store: JSONL at ~/.bd_metrics.jsonl (append-only, keyed by metric+ts).
"""
import argparse, json, os, re, subprocess, sys, time, glob

STORE = os.path.expanduser("~/.bd_metrics.jsonl")
BASELINE = os.path.expanduser("~/.bd_metrics_baseline.json")


def _routes_unwired_operator(tree):
    """Phase-19 / F1 debt: operator-facing API not wired to the SPA, excl cockpit
    (cockpit endpoints are intentionally cockpit-served)."""
    p = os.path.join(tree, "ROUTE_INDEX.json")
    if not os.path.isfile(p):
        return None
    d = json.load(open(p)); rows = d.get("routes", d) if isinstance(d, dict) else d
    return sum(1 for r in rows if isinstance(r, dict) and r.get("kind") == "api"
               and r.get("operator_facing") and not r.get("spa_wired")
               and r.get("blueprint") != "cockpit")


def _defect_total(tree):
    """Sum of DP-01..18 occurrences from bd-defect-scan (a ceiling metric).
    FAIL-SAFE: no source tree -> None (skip), never a bogus 0."""
    if not os.path.isdir(os.path.join(tree, "bulk_downloader")):
        return None
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-defect-scan")
    if not os.path.isfile(exe):
        return None
    try:
        # v3.66.706 INCIDENT FIX -- A GATE MUST NEVER TRUST A CACHE.
        # bd-defect-scan is memoized (bdtools_cache). A stale HIT is a silent
        # false-GREEN: it happened. The baseline read 2205 while every shipped tree
        # (701-705, cold-verified) was really 2207 -- the gate passed three cuts on a
        # cached value that did not match reality, and the truth only surfaced when a
        # file changed and forced a miss. The cache is for humans (17.9s -> 0.11s);
        # the RATCHET measures COLD, every time. Correctness beats speed at a gate.
        _env = dict(os.environ, BDTOOLS_CACHE="0")
        r = subprocess.run([sys.executable, exe, "--scan", tree, "--json"],
                           capture_output=True, text=True, timeout=600, env=_env)
        m = re.findall(r'"DP-\d+"\s*:\s*(\d+)', r.stdout)
        if m:
            return sum(int(x) for x in m)
        # fallback: parse the text "DP-NN: <count>" lines
        m = re.findall(r'DP-\d+:\s*(\d+)', r.stdout + r.stderr)
        return sum(int(x) for x in m) if m else None
    except Exception:  # why: input unavailable/unreadable; return empty so the caller uses its fallback, not a wrong value
        return None



def _tool_json(tool, tree, *extra):
    """Run a sibling bd-* tool with --json and return the parsed object (or None).

    This is a GATE, so the fail-safe stays: a metric that cannot be collected is
    None (skipped), NEVER a bogus 0 -- a ratchet that reads a dead tool as "zero
    defects" passes the cut. What changed (I-3): the skip is no longer SILENT.
    A gate must not pass because a tool quietly died.
    """
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), tool)
    if not os.path.isfile(exe):
        sys.stderr.write("ratchet: SKIP %s (not present) -- metric NOT collected\n" % tool)
        return None
    try:
        r = subprocess.run([sys.executable, exe, "--work", tree, "--json", *extra],
                           capture_output=True, text=True, timeout=240)
        s = r.stdout.strip()
        i = s.find("{")
        return json.loads(s[i:]) if i >= 0 else None
    except Exception:  # why: input unavailable/unreadable; return empty so the caller uses its fallback, not a wrong value
        return None


def _coupling_ratio(tree):
    """Cross-subsystem coupling (bd-coupling-meter). CEILING: must not rise.
    FAIL-SAFE: if the tree has no source to measure, return None (skip) rather than
    a bogus 0.0 -- a zero would read as a *huge improvement* and silently mask a
    real regression (false-green ceiling)."""
    if not os.path.isdir(os.path.join(tree, "bulk_downloader")):
        return None
    d = _tool_json("bd-coupling-meter", tree)
    v = (d or {}).get("coupling_ratio")
    if v is None:
        return None
    v = round(float(v), 4)
    return None if v == 0.0 else v


def _mutation_caught_pct(tree):
    """% of injected mutations the guards CATCH (bd-mutation-test). FLOOR: must not
    fall -- a drop means the tests got weaker (the Phase-7 'teeth' metric).
    FAIL-SAFE: no source tree -> None (skip)."""
    if not os.path.isdir(os.path.join(tree, "bulk_downloader")):
        return None
    d = _tool_json("bd-mutation-test", tree)
    res = (d or {}).get("results")
    if not res:
        return None
    caught = sum(1 for r in res if r.get("caught"))
    return round(100.0 * caught / len(res), 1)


def _spa_wired(tree):
    """Routes wired to the SPA. FLOOR: must not fall (the F2 drain counter -- it
    should only ever go UP as the 281-endpoint debt is paid down)."""
    p = os.path.join(tree, "ROUTE_INDEX.json")
    if not os.path.isfile(p):
        return None
    d = json.load(open(p)); rows = d.get("routes", d) if isinstance(d, dict) else d
    return sum(1 for r in rows if isinstance(r, dict) and r.get("spa_wired"))


# metric registry: name -> (collector, direction)   ceiling=must-not-rise, floor=must-not-fall
METRICS = {
    # ceilings -- must NOT rise
    "unwired_operator_endpoints": (_routes_unwired_operator, "ceiling"),
    "defect_DP_total":            (_defect_total,            "ceiling"),
    "coupling_ratio":             (_coupling_ratio,          "ceiling"),
    # floors -- must NOT fall
    "mutation_caught_pct":        (_mutation_caught_pct,     "floor"),
    "spa_wired":                  (_spa_wired,               "floor"),
}


def _collect(tree):
    out = {}
    for name, (fn, _dir) in METRICS.items():
        try:
            v = fn(tree)
        except Exception:  # why: operation failed; degrade to the default and continue -- correctness unaffected, only completeness
            v = None
        if v is not None:
            out[name] = v
    return out


def cmd_collect(a, record=True):
    vals = _collect(a.tree)
    ts = int(time.time())
    if record:
        with open(STORE, "a") as f:
            for n, v in vals.items():
                f.write(json.dumps({"ts": ts, "metric": n, "value": v}) + "\n")
    for n, v in sorted(vals.items()):
        print(f"  {n:32} = {v}  ({METRICS[n][1]})")
    return vals


def cmd_baseline(a):
    vals = _collect(a.tree)
    json.dump(vals, open(BASELINE, "w"), indent=1)
    print(f"pinned baseline ({len(vals)} metrics):")
    for n, v in sorted(vals.items()):
        print(f"  {n:32} {'<=' if METRICS[n][1]=='ceiling' else '>='} {v}")
    return 0


def cmd_check(a):
    if not os.path.isfile(BASELINE):
        print("no baseline -- run: bd-ratchet --baseline"); return 2
    base = json.load(open(BASELINE))
    cur = _collect(a.tree)
    regressed = []
    print("ratchet check vs baseline:")
    for n, bv in sorted(base.items()):
        # why: v3.66.805 -- keys starting with "_" are PROVENANCE (_meta:
        # who declared a hand-set floor, when, and why), not metrics. Without
        # this they fall through to the None branch and print
        # "[skip] _meta (not measurable now)", which reads like a metric that
        # failed to collect. Provenance must be storable in the same file the
        # gate reads (a sidecar is the written-to-one-channel/read-from-another
        # shape) without polluting the verdict.
        if n.startswith("_"):
            continue
        cv = cur.get(n)
        if cv is None:
            print(f"  [skip] {n} (not measurable now)"); continue
        d = METRICS[n][1]
        bad = (cv > bv) if d == "ceiling" else (cv < bv)
        tag = "REGRESSED" if bad else "ok"
        arrow = "<=" if d == "ceiling" else ">="
        print(f"  [{tag:9}] {n:32} {cv} {arrow} {bv}")
        if bad:
            regressed.append((n, bv, cv, d))
    print()
    if regressed:
        print(f"BLOCKED -- {len(regressed)} metric(s) regressed:")
        for n, bv, cv, d in regressed:
            verb = "rose" if d == "ceiling" else "fell"
            print(f"  * {n}: {verb} {bv} -> {cv}")
        return 3
    print("OK -- no metric regressed.")
    return 0


def cmd_trend(a):
    if not os.path.isfile(STORE):
        print("no data"); return 0
    rows = [json.loads(l) for l in open(STORE) if a.trend in l]
    rows = [r for r in rows if r.get("metric") == a.trend][-20:]
    for r in rows:
        print(f"  {time.strftime('%Y-%m-%d %H:%M', time.localtime(r['ts']))}  {r['value']}")
    return 0


def selftest():
    ok = True
    # NEG control: a ceiling metric at/below baseline does NOT regress
    from types import SimpleNamespace
    global BASELINE, STORE
    import tempfile
    BASELINE = tempfile.mktemp(); STORE = tempfile.mktemp()
    json.dump({"unwired_operator_endpoints": 280}, open(BASELINE, "w"))
    # monkeypatch collector to a controlled value
    METRICS["unwired_operator_endpoints"] = (lambda t: 280, "ceiling")
    rc = cmd_check(SimpleNamespace(tree="."))
    print(("PASS" if rc == 0 else "FAIL") + "  NEG: equal-to-baseline ceiling is not a regression")
    ok = ok and rc == 0
    # POS control: a rise IS a regression (exit 3)
    METRICS["unwired_operator_endpoints"] = (lambda t: 281, "ceiling")
    rc = cmd_check(SimpleNamespace(tree="."))
    print(("PASS" if rc == 3 else "FAIL") + "  POS: +1 over ceiling blocks (exit 3)")
    ok = ok and rc == 3
    # FLOOR control: a fall below a floor blocks
    json.dump({"cov": 90}, open(BASELINE, "w"))
    METRICS.clear(); METRICS["cov"] = (lambda t: 89, "floor")
    rc = cmd_check(SimpleNamespace(tree="."))
    print(("PASS" if rc == 3 else "FAIL") + "  FLOOR: below-floor blocks (exit 3)")
    ok = ok and rc == 3
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(prog="bd-ratchet")
    ap.add_argument("--tree", "--work", default="/home/claude/work")
    ap.add_argument("--collect", action="store_true")
    ap.add_argument("--baseline", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--trend", metavar="NAME")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest: return selftest()
    if a.baseline: return cmd_baseline(a)
    if a.check: return cmd_check(a)
    if a.trend: return cmd_trend(a)
    if a.collect: cmd_collect(a); return 0
    cmd_collect(a, record=False); return 0


if __name__ == "__main__":
    sys.exit(main())
