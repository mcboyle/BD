#!/usr/bin/env python3
"""bd-kb-conflict -- find contradictory KB instructions across docs.

Scans the PK docs for directive statements about the same subject that point in
opposite directions (a "never X" in one doc + a "must X"/"always X" in another
for the same token). Emits candidate conflicts for human review -- catches the
drift where two docs disagree on policy. Heuristic, read-only.

Usage: bd-kb-conflict [--docs DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
NEG=re.compile(r'(?i)\b(never|no|do not|don\047t|must not|avoid)\b')
POS=re.compile(r'(?i)\b(always|must|required|should)\b')
TOKEN=re.compile(r'`([a-zA-Z0-9_.\-]{3,})`')

def scan(docs):
    neg={}; pos={}
    for f in glob.glob(os.path.join(docs,"*.md")):
        name=os.path.basename(f)
        for i,line in enumerate(open(f,errors="ignore"),1):
            s=line.strip()
            toks=TOKEN.findall(s)
            if not toks: continue
            if NEG.search(s):
                for t in toks: neg.setdefault(t,[]).append((name,i,s[:70]))
            if POS.search(s):
                for t in toks: pos.setdefault(t,[]).append((name,i,s[:70]))
    conflicts=[]
    for t in set(neg)&set(pos):
        # only a conflict if different docs/lines
        nsrc={(x[0],x[1]) for x in neg[t]}; psrc={(x[0],x[1]) for x in pos[t]}
        if nsrc-psrc and psrc-nsrc:
            conflicts.append({"token":t,"negative":neg[t][:2],"positive":pos[t][:2]})
    return conflicts

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        open(os.path.join(d,"a.md"),"w").write("- Never run `full_suite` in sandbox.\n")
        open(os.path.join(d,"b.md"),"w").write("- You must always run `full_suite` before release.\n")
        open(os.path.join(d,"c.md"),"w").write("- Some neutral text about `full_suite`.\n")
        c=scan(d)
    toks={x["token"] for x in c}
    print(("PASS" if "full_suite" in toks else "FAIL")+"  contradictory never/always on same token detected (%s)"%sorted(toks))
    ok=ok and "full_suite" in toks
    real=scan("/mnt/project")
    print(("PASS" if isinstance(real,list) else "FAIL")+"  real PK docs scanned (%d candidate conflicts)"%len(real))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--docs",default="/mnt/project")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    c=scan(a.docs)
    if sec.emit({"conflicts":c,"summary":{"count":len(c)}},as_json=a.json): return 0
    print("%d candidate KB conflict(s):"%len(c))
    for x in c[:30]:
        print("  %sCONFLICT%s `%s`"%(Y,RST,x["token"]))
        for n in x["negative"][:1]: print("    %sneg%s %s:%d %s"%(DIM,RST,n[0],n[1],n[2]))
        for p in x["positive"][:1]: print("    %spos%s %s:%d %s"%(DIM,RST,p[0],p[1],p[2]))
    if not c: print(G+"no contradictory directives found"+RST)
    return 0

if __name__ == "__main__":
    sys.exit(main())
