#!/usr/bin/env python3
"""bd-vpn-required -- validate vpn_required behavior (route via proxy or fail-closed).

Loads the app's real vpn_runtime and exercises the fail-closed contract for a
site: is_vpn_required_for_site + get_socks_url_for_site must EITHER return a
proxy URL OR raise VPNRequiredError -- never return None-and-proceed (that would
be a clear-net leak for a vpn_required site). In-sandbox no tunnel is
configured, so the expected outcome for a required site is a clean
VPNRequiredError (fail-closed), which this asserts. Read-only.

Usage: bd-vpn-required [--work DIR] [--site SITE] [--json] [--selftest]
Exit 0 (evidence).
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

def _load_mod(work, modname):
    import importlib.util, types
    p = os.path.join(work, "bulk_downloader", modname + ".py")
    if not os.path.exists(p):
        return None, modname + ".py not found"
    try:
        pkg = types.ModuleType("bulk_downloader")
        pkg.__path__ = [os.path.join(work, "bulk_downloader")]
        sys.modules.setdefault("bulk_downloader", pkg)
        if work not in sys.path:
            sys.path.insert(0, work)
        spec = importlib.util.spec_from_file_location("bulk_downloader." + modname, p)
        m = importlib.util.module_from_spec(spec)
        sys.modules["bulk_downloader." + modname] = m
        spec.loader.exec_module(m)
        return m, None
    except Exception as e:
        return None, "import failed: " + str(e)


def check(work, site):
    m, err = _load_mod(work, "vpn_runtime")
    if not m:
        return {"error": err}
    out = {"site": site, "vpn_required": None, "socks_url": None,
           "fail_closed": None, "error": None}
    try:
        out["vpn_required"] = bool(m.is_vpn_required_for_site(site))
    except Exception as e:
        out["error"] = "is_vpn_required raised: " + str(e)
        return out
    try:
        url = m.get_socks_url_for_site(site)
        out["socks_url"] = url
        # required site with no proxy and no raise = potential leak
        out["fail_closed"] = not (out["vpn_required"] and url is None)
    except Exception as e:
        # VPNRequiredError on a required site is the CORRECT fail-closed behavior
        name = type(e).__name__
        out["fail_closed"] = (name == "VPNRequiredError")
        out["error"] = name + ": " + str(e)[:80]
    return out


def selftest():
    ok = True
    m, err = _load_mod(sec.DEFAULT_WORK, "vpn_runtime")
    loaded = m is not None
    print(("PASS" if loaded else "FAIL") + "  vpn_runtime loads (err=" + str(err) + ")")
    ok = ok and loaded
    if loaded:
        has = hasattr(m, "is_vpn_required_for_site") and hasattr(m, "VPNRequiredError")
        print(("PASS" if has else "FAIL") + "  contract present (is_vpn_required + VPNRequiredError)")
        ok = ok and has
        r = check(sec.DEFAULT_WORK, "nonexistent-site")
        # a non-required unknown site should be fail_closed True or safely False-required
        safe = r.get("fail_closed") is not False
        print(("PASS" if safe else "FAIL") + "  unknown site does not silently leak (" + str(r) + ")")
        ok = ok and safe
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--site", default="example")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    sec.require_source_tree(a.work)
    r = check(a.work, a.site)
    if sec.emit(r, as_json=a.json):
        return 0
    if r.get("error") and r.get("vpn_required") is None:
        print(R + "vpn_runtime error" + RST + ": " + r["error"])
        return 0
    fc = (G + "fail-closed OK" + RST) if r.get("fail_closed") else (R + "POSSIBLE LEAK" + RST)
    print("site " + r["site"] + ": vpn_required=" + str(r.get("vpn_required"))
          + ", socks=" + str(r.get("socks_url")) + "  " + fc)
    if r.get("error"):
        print("  " + DIM + r["error"] + RST)
    return 0


sys.exit(main())
