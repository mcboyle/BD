#!/usr/bin/env python3
"""bd-rollback-oracle -- decide rollback vs patch-forward.

A decision rubric: given a failure classification (--failure), the number of
touched files (--touched or auto from tree diff), and the release tier
(--tier), recommend ROLLBACK / PATCH-FORWARD / HOLD with reasons. Rules encode
the release-discipline floor: guard/security/data-loss failures -> rollback;
small isolated cosmetic/logic failures on a low tier -> patch-forward; unknown
or wide blast radius -> hold + investigate. Read-only.

Usage: bd-rollback-oracle --failure TYPE [--touched N] [--tier T] [--work DIR] [--json]
       bd-rollback-oracle --selftest
Exit 0 recommendation produced / 1 no --failure TYPE given (usage guard). Informational: advises, does not gate.
"""
import argparse, glob, os, sys, zipfile
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

ROLLBACK_FAILURES={"guard","security","ssrf","data-loss","corruption","auth","boot-fail","deploy-broken"}
PATCHABLE_FAILURES={"cosmetic","copy","typo","ui-minor","log-noise","perf-minor"}

def touched_count(work, home="/home/claude"):
    zp=sorted(glob.glob(os.path.join(home,"BulkDownloader_v3_66_*.zip")),key=os.path.getmtime,reverse=True)
    if not zp: return None
    pinned={}
    with zipfile.ZipFile(zp[0]) as z:
        for n in z.namelist():
            if n.endswith(".py"): pinned[n]=z.read(n)
    n=0
    for p,rel,_t in sec.iter_py(work, strict=True, label="--work/--tree"):
        if rel not in pinned or pinned[rel]!=open(p,"rb").read(): n+=1
    return n

def decide(failure, touched, tier):
    f=(failure or "").lower()
    reasons=[]
    if f in ROLLBACK_FAILURES:
        return {"decision":"ROLLBACK","reasons":["%s failures cross the discipline floor -- revert first, diagnose after"%f],"failure":f,"touched":touched,"tier":tier}
    if f in PATCHABLE_FAILURES:
        if touched is not None and touched<=5 and tier in ("low","cosmetic","docs",None):
            return {"decision":"PATCH-FORWARD","reasons":["low-severity %s, small blast radius (%s files), low tier"%(f,touched)],"failure":f,"touched":touched,"tier":tier}
        reasons.append("patchable failure but wide blast radius / higher tier -> confirm before patching")
        return {"decision":"HOLD","reasons":reasons,"failure":f,"touched":touched,"tier":tier}
    return {"decision":"HOLD","reasons":["unknown failure type %r -- investigate before deciding"%failure],"failure":f,"touched":touched,"tier":tier}

def selftest():
    ok=True
    a=decide("guard",2,"low")["decision"]=="ROLLBACK"
    b=decide("cosmetic",1,"low")["decision"]=="PATCH-FORWARD"
    c=decide("cosmetic",50,"high")["decision"]=="HOLD"
    d=decide("weird-thing",1,"low")["decision"]=="HOLD"
    for nm,v in [("guard->ROLLBACK",a),("cosmetic-small->PATCH",b),("cosmetic-wide->HOLD",c),("unknown->HOLD",d)]:
        print(("PASS" if v else "FAIL")+"  "+nm); ok=ok and v
    tc=touched_count(sec.DEFAULT_WORK)
    print(("PASS" if tc==0 else "WARN")+"  pristine tree touched=0 (%s)"%tc)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

# sweep: probe-args --failure guard
# (--failure is required BEFORE the tool looks at the tree; without it a
#  corpus probe never reaches the guard and reads as UNKNOWN forever.)
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--failure",required=False,default=None)
    ap.add_argument("--touched",type=int,default=None); ap.add_argument("--tier",default=None)
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    if not a.failure:
        print(R+"--failure TYPE required"+RST+DIM+" (guard|security|data-loss|cosmetic|copy|perf-minor|...)"+RST); return 1
    touched=a.touched if a.touched is not None else touched_count(a.work)
    d=decide(a.failure,touched,a.tier)
    if sec.emit(d,as_json=a.json): return 0
    col={"ROLLBACK":R,"PATCH-FORWARD":G,"HOLD":Y}[d["decision"]]
    print("decision: %s%s%s  (failure=%s touched=%s tier=%s)"%(col,d["decision"],RST,d["failure"],d["touched"],d["tier"]))
    for r in d["reasons"]: print("  "+DIM+r+RST)
    return 0
sys.exit(main())
