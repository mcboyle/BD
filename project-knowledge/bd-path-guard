#!/usr/bin/env python3
"""bd-path-guard -- confinement-helper coverage for filesystem writes.

The coverage complement to bd-path-scan (which finds unguarded sinks). This
enumerates the confinement helpers actually present in the tree (safe_join /
_is_safe_path / is_relative_to / _confine_extract / commonpath) and reports,
per write-surface module (writes, exports, templates, captures, backups),
whether a confinement helper is imported/used. Modules with write sinks but no
confinement helper -> BD-PATH-NO-CONFINE (medium). Advisory, read-only.

Usage: bd-path-guard [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse
import os
import re
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

WRITE_SINK = re.compile(
    r'\bopen\s*\([^)]*,\s*["\'][wa]b?\+?["\']|\bshutil\.(?:move|copy2?|copytree|copyfile)\s*\('
    r'|\.write_(?:text|bytes)\s*\(|\.extractall\s*\(|os\.rename\s*\(|os\.replace\s*\(')
CONFINE_USE = re.compile(
    r'safe_join|safe_slug|_is_safe_path|is_relative_to|_confine|commonpath|secure_filename'
    r'|\.resolve\(\)\.relative_to|realpath')
CONFINE_DEF = re.compile(
    r'def\s+(safe_join|safe_slug|_is_safe_path|_confine\w*)\s*\(')


def discover_helpers(work):
    helpers = set()
    for _p, _rel, txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        for m in CONFINE_DEF.finditer(txt):
            helpers.add(m.group(1))
    return sorted(helpers)


def audit(work):
    findings = []
    covered = 0
    total = 0
    for _p, rel, txt in sec.iter_py(work):
        sinks = [(i, l) for i, l in enumerate(txt.splitlines(), 1) if WRITE_SINK.search(l)]
        if not sinks:
            continue
        total += 1
        if CONFINE_USE.search(txt):
            covered += 1
            continue
        findings.append(sec.finding(
            "bd-path-guard", "BD-PATH-NO-CONFINE", "medium", rel, sinks[0][0],
            f"{len(sinks)} write sink(s), no confinement helper in module",
            sink_count=len(sinks), first_sink=sinks[0][1].strip()[:100]))
    findings.sort(key=lambda f: (-f["extra"]["sink_count"], f["file"]))
    return findings, covered, total


def selftest():
    ok = True
    guarded = ('from bulk_downloader.paths import safe_join\n'
               'def w(base, name):\n'
               '    p = safe_join(base, name)\n'
               '    open(p, "w").write("x")\n')
    ungrd = ('def w(base, name):\n'
             '    open(base + "/" + name, "w").write("x")\n')
    nowrite = ('def r(p):\n    return open(p).read()\n')
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bulk_downloader")
        os.makedirs(b)
        open(os.path.join(b, "g.py"), "w").write(guarded)
        open(os.path.join(b, "u.py"), "w").write(ungrd)
        open(os.path.join(b, "r.py"), "w").write(nowrite)
        f, cov, tot = audit(d)
    files = sorted(os.path.basename(x["file"]) for x in f)
    good = files == ["u.py"] and cov == 1 and tot == 2
    print(("PASS" if good else "FAIL") +
          f"  fixture: only u.py flagged, coverage 1/2 (got files={files}, {cov}/{tot})")
    ok &= good
    helpers = discover_helpers(sec.DEFAULT_WORK)
    hasreal = len(helpers) > 0
    print(("PASS" if hasreal else "FAIL") + f"  real confinement helpers discovered: {helpers}")
    ok &= hasreal
    a = audit(sec.DEFAULT_WORK)[0]
    b2 = audit(sec.DEFAULT_WORK)[0]
    det = [(x["file"], x["line"]) for x in a] == [(x["file"], x["line"]) for x in b2]
    print(("PASS" if det else "FAIL") + f"  real-tree determinism ({len(a)} findings x2)")
    ok &= det
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    helpers = discover_helpers(a.work)
    findings, cov, tot = audit(a.work)
    if sec.emit({"helpers": helpers, "findings": findings,
                 "summary": {"write_modules": tot, "covered": cov,
                             "uncovered": len(findings)}}, as_json=a.json):
        return 0
    print(f"confinement helpers in tree: {G}{', '.join(helpers) or '(none)'}{RST}")
    print(f"write-surface modules: {cov}/{tot} use a confinement helper")
    for f in findings[:40]:
        print(f"  {Y}NO CONFINE{RST} {f['file']}:{f['line']}  {DIM}"
              f"{f['extra']['sink_count']} sink(s): {f['extra']['first_sink']}{RST}")
    print(f"{DIM}{len(findings)} write module(s) with no confinement helper{RST}")
    return 0


sys.exit(main())
