#!/usr/bin/env python3
"""bd-template-safety -- check template export/import safety.

For each template store (templates/**/*.template.json), checks: (1) no secret-
bearing fields (cookie/token/authorization values embedded in selectors/api/
capture), (2) path fields are confined (no absolute/traversal), (3) an enable/
auto-apply flag isn't set without review status, (4) review state present
(status). A template that would leak a secret on export or auto-enable without
review -> BD-TEMPLATE-UNSAFE. Reuses the secret patterns from bdtools_sec.
Read-only.

Usage: bd-template-safety [--work DIR] [--json] [--selftest]
Exit 1 if any unsafe template, else 0.
"""
import argparse, glob, json, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
SECRET_KEY=re.compile(r'(?i)cookie|token|authorization|secret|api[_-]?key|password|credential|bearer')
# a value that looks like a CSS/XPath selector or DOM path, not a credential
SELECTORISH=re.compile(r'^[.#\[/]|::|input\[|button|\bnth-|>\s|xpath|querySelector|\bdiv\b|\[name|\[type')

def _looks_secret_value(val):
    if SELECTORISH.search(val): return False
    # a real secret is a longish opaque token: mostly [A-Za-z0-9_\-\.=/+], few spaces
    if " " in val.strip() and len(val.split()) > 2: return False
    return len(val) >= 12

def walk_strings(obj, path="$"):
    if isinstance(obj,dict):
        for k,v in obj.items():
            yield from walk_strings(v, path+"."+str(k))
    elif isinstance(obj,list):
        for i,v in enumerate(obj): yield from walk_strings(v, path+"[%d]"%i)
    elif isinstance(obj,str):
        yield path, obj

def check(obj):
    issues=[]
    for path,val in walk_strings(obj):
        leaf=path.rsplit(".",1)[-1]
        # selectors/selector subtrees are DOM paths, never credential values
        in_selector = ".selectors" in path or ".selector" in path.lower()
        if SECRET_KEY.search(leaf) and not in_selector and _looks_secret_value(val):
            issues.append("secret-bearing field %s"%path)
        if "path" in leaf.lower() and (os.path.isabs(val) or ".." in val):
            issues.append("unsafe path field %s=%r"%(path,val[:40]))
    # enable without review
    status=str(obj.get("status","")).lower()
    enabled=obj.get("enabled") or obj.get("auto_apply") or obj.get("gold")
    if enabled and status not in ("reviewed","gold","approved"):
        issues.append("enabled/auto-apply without reviewed status (status=%r)"%status)
    if "status" not in obj:
        issues.append("no review status field")
    return issues

def scan(work):
    findings=[]; checked=0
    for f in glob.glob(os.path.join(work,"templates","**","*.template.json"),recursive=True):
        try: obj=json.load(open(f))
        except Exception as e:
            findings.append({"file":os.path.relpath(f,work),"issue":"unparseable: %s"%e}); continue
        checked+=1
        for i in check(obj):
            findings.append({"file":os.path.relpath(f,work),"issue":i})
    return findings, checked

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        td=os.path.join(d,"templates","reviewed"); os.makedirs(td)
        json.dump({"status":"reviewed","selectors":{"x":".a"}},open(os.path.join(td,"safe.template.json"),"w"))
        json.dump({"status":"draft","enabled":True,"api":{"cookie":"abcdef0123456789xyz"},"dl_path":"/etc/x"},open(os.path.join(td,"bad.template.json"),"w"))
        f,c=scan(d)
    bad=[x for x in f if "bad" in x["file"]]
    issues=" ".join(x["issue"] for x in bad)
    good="secret-bearing" in issues and "unsafe path" in issues and "without reviewed" in issues and not any("safe.template" in x["file"] for x in f)
    print(("PASS" if good else "FAIL")+"  unsafe template: secret+path+enable caught, safe clean (%d issues)"%len(bad))
    ok=ok and good
    r=scan(sec.DEFAULT_WORK)
    print(("PASS" if r[1]>=0 else "FAIL")+"  real tree: %d templates, %d issues"%(r[1],len(r[0])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    f,c=scan(a.work)
    if sec.emit({"findings":f,"summary":{"checked":c,"unsafe":len(f)}},as_json=a.json): return 1 if f else 0
    print("%d template(s) checked; %d issue(s)"%(c,len(f)))
    for x in f[:40]: print("  %sBD-TEMPLATE-UNSAFE%s %s: %s"%(R,RST,x["file"],x["issue"]))
    if not f: print(G+"all templates safe to export"+RST)
    return 1 if f else 0
sys.exit(main())
