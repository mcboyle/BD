#!/usr/bin/env python3
"""bd-render -- one-command visual gate: start spa_serve, wait for it, run the
both-theme capture + montage, then ALWAYS tear the server down (even on failure).

The fiddly, reliable part this owns: locating + starting the render backend,
polling its port until it actually answers, and guaranteeing teardown via a
process group (no orphaned spa_serve eating :5599 across runs). The capture and
montage *invocations* live in the render harness (spa_render.sh / capture_all.py /
build_montage.py) -- their exact flags aren't pinned here, so they're DISCOVERED
with sane defaults and are fully overridable via --capture-cmd / --montage-cmd, and
anything after `--` is appended to the capture command. Adjust one flag if your
harness differs; the server lifecycle is correct regardless.

Usage:
    bd-render                                   # serve -> capture -> montage (defaults)
    bd-render --serve-only                      # just bring up :5599 and wait (Ctrl-C to stop)
    bd-render --no-montage -- --routes settings,queue   # capture only; pass routes through
    bd-render --capture-cmd "python3 tools/capture_all.py --both-themes" \
              --montage-cmd "python3 tools/build_montage.py"
    bd-render --baseline-dir /path/to/packed/montages   # name-level compare after
Exit 0 = served + capture + montage all returned 0; 1 = a step failed or server never came up.
"""
import argparse
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def _resolve(name):
    """Consult the shared bd-resolve.sh finder (searches every place files land,
    incl. relocated/evicted paths). Returns the path or None."""
    import subprocess
    for res in (os.path.join(sec.DEFAULT_WORK, "toolchain", "bin", "bd-resolve.sh"),
                "/usr/local/bin/bd-resolve.sh"):
        if os.path.isfile(res):
            try:
                out = subprocess.run(["sh", res, "file", name],
                                     capture_output=True, text=True, timeout=15).stdout.strip()
                if out and os.path.isfile(out):
                    return out
            except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
                pass
    return None


def find_first(work, names, subdirs=("tools", "scripts", "live_tests", "project-knowledge", "")):
    # 1) the shared resolver first -- broadest, drift/relocation proof
    for n in names:
        hit = _resolve(n)
        if hit:
            return hit
    # 2) fall back to the local search (kept so bd-render works even without the resolver)
    roots = [work, sec.DEFAULT_WORK, os.getcwd()]
    for root in roots:
        for sub in subdirs:
            for n in names:
                p = os.path.join(root, sub, n) if sub else os.path.join(root, n)
                if os.path.isfile(p):
                    return p
    return None


def port_open(host, port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex((host, port)) == 0


def selftest():
    """SKIP: this tool needs a headless browser render target, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs a headless browser render target")
    print("SELFTEST PASS")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bd-render")
    ap.add_argument("--work","--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--port", type=int, default=5599, help="spa_serve backend port")
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--serve-cmd", help="override the command that starts the render backend")
    ap.add_argument("--capture-cmd", help="override the capture command")
    ap.add_argument("--montage-cmd", help="override the montage command")
    ap.add_argument("--out", default=os.path.join(tempfile.gettempdir(), "bd_render_out"))
    ap.add_argument("--serve-only", action="store_true")
    ap.add_argument("--no-montage", action="store_true")
    ap.add_argument("--wait", type=int, default=40, help="seconds to wait for the port")
    ap.add_argument("--baseline-dir", help="dir of baseline montages for a name-level compare")
    ap.add_argument("passthrough", nargs=argparse.REMAINDER,
                    help="args after -- appended to the capture command")
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args(argv)
    if a.selftest:
        return selftest()

    os.makedirs(a.out, exist_ok=True)

    # --- resolve the serve command ---
    if a.serve_cmd:
        serve = a.serve_cmd.split()
    else:
        srv = find_first(a.work, ["spa_serve.py"])
        if not srv:
            sh = find_first(a.work, ["spa_render.sh"])
            if sh:
                print(f"{Y}note{RST} no spa_serve.py; using {sh} (it may serve+capture itself)")
                serve = ["bash", sh]
            else:
                print(f"{R}FAIL{RST} no spa_serve.py / spa_render.sh found "
                      f"(pass --serve-cmd)", file=sys.stderr)
                return 1
        else:
            serve = [sys.executable, srv, "--port", str(a.port)]

    if port_open(a.host, a.port):
        print(f"{Y}note{RST} :{a.port} already open -- reusing the running backend")
        proc = None
    else:
        print(f"== starting render backend: {' '.join(serve)}")
        # start_new_session => own process group => clean teardown of children
        proc = subprocess.Popen(serve, cwd=a.work, start_new_session=True,
                                 stdout=open(os.path.join(a.out, "spa_serve.log"), "w"),
                                 stderr=subprocess.STDOUT)

    def teardown():
        if proc and proc.poll() is None:
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
                time.sleep(1)
                if proc.poll() is None:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            except ProcessLookupError:
                pass
            print(f"{DIM}render backend stopped{RST}")

    rc = 0
    try:
        # --- wait for the port ---
        deadline = time.time() + a.wait
        while time.time() < deadline:
            if port_open(a.host, a.port):
                break
            if proc and proc.poll() is not None:
                print(f"{R}FAIL{RST} backend exited early (see {a.out}/spa_serve.log)")
                return 1
            time.sleep(0.5)
        else:
            print(f"{R}FAIL{RST} :{a.port} never opened within {a.wait}s "
                  f"(see {a.out}/spa_serve.log)")
            return 1
        print(f"  {G}backend up{RST} on {a.host}:{a.port}")

        if a.serve_only:
            print(f"{Y}--serve-only{RST}: backend is up. Ctrl-C to stop.")
            try:
                while proc and proc.poll() is None:
                    time.sleep(1)
            except KeyboardInterrupt:
                pass
            return 0

        # --- capture ---
        if a.capture_cmd:
            cap = a.capture_cmd.split()
        else:
            capt = find_first(a.work, ["capture_all.py", "capture.py"])
            if not capt:
                print(f"{R}FAIL{RST} no capture_all.py found (pass --capture-cmd)")
                return 1
            cap = [sys.executable, capt, "--out", a.out]
        cap += [x for x in a.passthrough if x != "--"]
        print(f"== capture: {' '.join(cap)}")
        rc = subprocess.run(cap, cwd=a.work).returncode
        if rc != 0:
            print(f"{R}FAIL{RST} capture returned {rc}")
            return rc

        # --- montage ---
        if not a.no_montage:
            if a.montage_cmd:
                mon = a.montage_cmd.split()
            else:
                mt = find_first(a.work, ["build_montage.py", "build_navigator.py"])
                if not mt:
                    print(f"{Y}note{RST} no build_montage.py found -- skipping montage")
                    mon = None
                else:
                    mon = [sys.executable, mt, "--out", a.out]
            if mon:
                print(f"== montage: {' '.join(mon)}")
                rc = subprocess.run(mon, cwd=a.work).returncode
                if rc != 0:
                    print(f"{R}FAIL{RST} montage returned {rc}")
                    return rc

        # --- name-level baseline compare (advisory) ---
        if a.baseline_dir and os.path.isdir(a.baseline_dir):
            new = {f for f in os.listdir(a.out) if f.endswith((".png", ".webp", ".html"))}
            base = {f for f in os.listdir(a.baseline_dir) if f.endswith((".png", ".webp", ".html"))}
            only_new = sorted(new - base)
            only_base = sorted(base - new)
            print("== baseline compare (name-level; not pixel)")
            if only_new:
                print(f"  {G}new vs baseline{RST}: {', '.join(only_new)}")
            if only_base:
                print(f"  {Y}in baseline, not produced{RST}: {', '.join(only_base)}")
            if not only_new and not only_base:
                print(f"  same set of artifacts as baseline ({len(new)} files)")

        print(f"\n{G}bd-render complete{RST} -> {a.out}")
        return 0
    finally:
        teardown()


if __name__ == "__main__":
    sys.exit(main())
