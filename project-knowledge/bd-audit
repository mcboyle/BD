#!/usr/bin/env python3
"""bd-audit -- hydrate the audit_state ledger and mine it for promotable tools.

The audit_state zip (audit ledger + witnesses/ + tools/) is uploaded but not
auto-hydrated. This hydrates it, then analyzes audit_state/tools/ to answer, per
script: is it ALREADY a bd tool, ALREADY in the static PK, does it OVERLAP an
existing tool, or is it a genuinely new CANDIDATE -- and if so, is it actually
PORTABLE (stdlib-only) or coupled to audit-only modules. So useful tooling gets
surfaced without re-shipping things that already exist.

Subcommands:
    bd-audit                     hydrate (if needed) + analyze  (default)
    bd-audit hydrate             unzip newest audit_state_*.zip -> /home/claude/audit_state
                                 (+ symlink /home/claude/review), preserving exec bits
    bd-audit analyze             classify every audit_state/tools/ script + doc
    bd-audit promote <name>      stage a PORTABLE candidate into /home/claude/bin
                                 (refuses non-portable; prints the bundle steps)
Options: [--pk /mnt/project] [--bin /home/claude/bin] [--audit /home/claude/audit_state]
Read-only except `hydrate` (writes under audit_state) and `promote` (stages one file).
"""
import argparse
import ast
import glob
import os
import re
import stat
import sys
import zipfile

G, C, Y, R, B, DIM, BOLD, RST = ("\033[32m", "\033[36m", "\033[33m", "\033[31m",
                                 "\033[34m", "\033[2m", "\033[1m", "\033[0m")

AUDIT = "/home/claude/audit_state"
REVIEW = "/home/claude/review"
BIN = "/home/claude/bin"
PK = "/mnt/project"

# stdlib top-level modules a portable CLI may use (not exhaustive; the common set)
STDLIB = set("""argparse ast json os re sys subprocess pathlib collections itertools
functools hashlib glob datetime shutil zipfile tarfile textwrap math random string io
time csv sqlite3 typing dataclasses enum contextlib tempfile difflib pprint copy heapq
statistics urllib http base64 hmac secrets warnings logging inspect operator uuid
importlib abc struct fnmatch shlex signal traceback gzip bz2 lzma pickle""".split())

# curated overlap boosters: audit-tool stem -> the existing bd tool it resembles
OVERLAP = {
    "staleness": "bd-docstale", "read_coverage": "bd-coverage",
    "coverage_map": "bd-coverage", "risk_score": "bd-band-derive",
    "defect_patterns": "bd-secrets / bd-ssrf", "reachability_ledger": "bd-deps",
    "graph_build": "bd-deps", "witness_drift": "bd-since", "verify_audit": "bd-zipcheck",
    "constraint_incidence": "bd-factcheck", "invariants": "bd-factcheck",
}


# ---------- helpers ----------
def find_zip():
    z = sorted(glob.glob("/mnt/user-data/uploads/audit_state_v3_66_*.zip")
               + glob.glob("/home/claude/audit_state_v3_66_*.zip"), reverse=True)
    return z[0] if z else None


def summary(path):
    """First non-empty line of the module docstring (what the tool does)."""
    try:
        src = open(path, errors="ignore").read()
    except Exception:  # why: input unavailable; return empty so the caller uses its fallback
        return ""
    try:
        doc = ast.get_docstring(ast.parse(src))
    except Exception:  # why: operation failed; degrade to the default and continue
        doc = None
    if not doc:
        m = re.search(r'"""(.+?)(?:\n|""")', src, re.S)
        doc = m.group(1) if m else ""
    line = (doc or "").strip().splitlines()[0] if doc else ""
    # strip a leading "name -- " prefix
    return re.sub(r'^[\w.-]+\s*--\s*', '', line).strip()


def imports_of(path):
    try:
        tree = ast.parse(open(path, errors="ignore").read())
    # why: input unavailable/unreadable; return an empty/default result so the caller uses its fallback
    except Exception:
        return set(), False
    mods = set()
    dynamic = "importlib.util" in open(path, errors="ignore").read() and \
              "spec_from_file_location" in open(path, errors="ignore").read()
    for n in ast.walk(tree):
        if isinstance(n, ast.Import):
            for a in n.names:
                mods.add(a.name.split(".")[0])
        elif isinstance(n, ast.ImportFrom):
            if n.level and n.level > 0:
                dynamic = True  # relative import -> package-coupled
            if n.module:
                mods.add(n.module.split(".")[0])
    return mods, dynamic


AUDIT_VENV_TOOLS = ("bandit", "vulture", "semgrep", "radon", "detect-secrets",
                    "jscpd", "pa11y", "lighthouse", "axe")


def runtime_coupling(path, audit_tools):
    """Detects runtime deps import analysis misses: shelling out to a sibling .py
    or to an audit-venv tool, or referencing the ~/rev venv. Returns a reason or ''."""
    try:
        src = open(path, errors="ignore").read()
    except Exception:  # why: input unavailable; return empty so the caller uses its fallback
        return ""
    reasons = []
    siblings = {os.path.basename(p) for p in audit_tools}
    for sib in siblings:
        if sib != os.path.basename(path) and sib in src and ("subprocess" in src or "/tmp/" in src or ".py" in src):
            reasons.append(f"runs {sib}")
    for t in AUDIT_VENV_TOOLS:
        if re.search(r'\b' + re.escape(t) + r'\b', src):
            reasons.append(t)
    if re.search(r'~/rev|/rev\b|throwaway venv|review/artifacts', src):
        reasons.append("~/rev audit venv")
    # dedupe, cap
    seen = []
    for r in reasons:
        if r not in seen:
            seen.append(r)
    return ", ".join(seen[:4])


def portability(path, audit_tools, bd_stems):
    """Return (verdict, detail). Portable = runnable outside audit_state as-is."""
    mods, dynamic = imports_of(path)
    audit_local = {os.path.splitext(os.path.basename(p))[0] for p in audit_tools}
    needs = []
    for m in sorted(mods):
        if m in STDLIB:
            continue
        if m in audit_local:                       # imports a sibling audit module
            needs.append(f"{m} (audit-local)")
        elif m in ("bulk_downloader",):            # bd source module
            needs.append(f"{m} (work-tree)")
        else:
            needs.append(m)                        # third-party
    if dynamic and not needs:
        needs.append("dynamic sibling-load (audit layout)")
    if not needs:
        return "portable", "stdlib-only"
    audit_coupled = any("audit-local" in n or "sibling-load" in n for n in needs)
    return ("not-portable" if audit_coupled else "needs-deps"), ", ".join(needs)


def hydrate():
    if os.path.isdir(AUDIT) and os.listdir(AUDIT):
        print(f"{DIM}audit_state already hydrated ({len(os.listdir(AUDIT))} entries){RST}")
    else:
        z = find_zip()
        if not z:
            print(f"{R}no audit_state_v3_66_*.zip found to hydrate{RST}")
            return False
        os.makedirs(AUDIT, exist_ok=True)
        with zipfile.ZipFile(z) as zf:
            for info in zf.infolist():
                if info.is_dir():
                    continue
                m = info.filename
                rel = m[len("audit_state/"):] if m.startswith("audit_state/") else m
                if not rel:
                    continue
                dst = os.path.join(AUDIT, rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, "wb") as fh:
                    fh.write(zf.read(m))
                mode = (info.external_attr >> 16) & 0o777
                if rel.endswith((".py", ".sh")) or (mode & 0o111):
                    os.chmod(dst, (mode or 0o644) | 0o755)
        print(f"{G}hydrated{RST} {os.path.basename(z)} -> {AUDIT} (exec bits preserved)")
    if not os.path.exists(REVIEW):
        try:
            os.symlink(AUDIT, REVIEW)
            print(f"  {DIM}symlinked {REVIEW} -> {AUDIT}{RST}")
        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
            pass
    return True


def tool_files(a):
    td = os.path.join(a.audit, "tools")
    if not os.path.isdir(td):
        # fall back: any scripts/docs at the audit_state root
        td = a.audit
    scripts = sorted(glob.glob(os.path.join(td, "*.py")) + glob.glob(os.path.join(td, "*.sh")))
    docs = sorted(glob.glob(os.path.join(td, "*.md")))
    return scripts, docs, td


def bd_stems(a):
    return {os.path.basename(p) for p in glob.glob(os.path.join(a.bin, "*"))} | \
           {os.path.splitext(os.path.basename(p))[0] for p in glob.glob(os.path.join(a.bin, "*"))}


def pk_names(a):
    return {os.path.basename(p) for p in glob.glob(os.path.join(a.pk, "*"))}


def classify(a):
    scripts, docs, td = tool_files(a)
    if not scripts and not docs:
        return None
    stems = bd_stems(a)
    pk = pk_names(a)
    pk_has_siblings = any(os.path.basename(x) in pk for x in scripts)
    rows = []
    for s in scripts:
        base = os.path.basename(s)
        stem = re.sub(r'\.(py|sh)$', '', base)
        summ = summary(s)
        port, detail = portability(s, scripts, stems)
        if base in stems or stem in stems:
            same = os.path.join(a.bin, base)
            div = ""
            if os.path.exists(same):
                div = "identical" if open(same, "rb").read() == open(s, "rb").read() else "DIFFERS"
            rows.append(("bin", base, summ, div, port, detail))
        elif base in pk:
            pkp = os.path.join(a.pk, base)
            div = "identical" if open(pkp, "rb").read() == open(s, "rb").read() else "DIFFERS"
            rows.append(("pk", base, summ, div, port, detail))
        elif stem in OVERLAP:
            rows.append(("overlap", base, summ, OVERLAP[stem], port, detail))
        else:
            coupled = runtime_coupling(s, scripts)
            det = detail + (f"; runtime-coupled: {coupled}" if coupled else "")
            if port == "portable" and base.startswith("bd-") and not coupled:
                rows.append(("candidate_bd", base, summ, "", "portable", det))
            elif (port == "portable" or coupled) and _cli(s) and pk_has_siblings:
                rows.append(("candidate_pk", base, summ, "", port, det))
            elif port == "portable" and _cli(s):
                rows.append(("candidate_bd", base, summ, "", "portable", det))
            else:
                rows.append(("audit", base, summ, "", port, det))
    return rows, docs, pk


def _cli(path):
    src = open(path, errors="ignore").read(4000)
    return "argparse" in src or "def main(" in src or '__main__' in src


def analyze(a):
    res = classify(a)
    if not res:
        print(f"{Y}no audit_state/tools/ to analyze (hydrate first?){RST}")
        return 1
    rows, docs, pk = res
    order = {"candidate_bd": 0, "candidate_pk": 1, "overlap": 2, "audit": 3, "bin": 4, "pk": 5}
    rows.sort(key=lambda r: (order[r[0]], r[1]))
    counts = {}
    for r in rows:
        counts[r[0]] = counts.get(r[0], 0) + 1
    print(f"{BOLD}audit_state/tools: {len(rows)} scripts, {len(docs)} docs{RST}  "
          f"{DIM}[bd-cand {counts.get('candidate_bd',0)} · pk-cand {counts.get('candidate_pk',0)} · "
          f"overlap {counts.get('overlap',0)} · audit-only {counts.get('audit',0)} · "
          f"in-bin {counts.get('bin',0)} · in-PK {counts.get('pk',0)}]{RST}")

    def block(kind, title, color):
        sub = [r for r in rows if r[0] == kind]
        if not sub:
            return
        print(f"\n{color}{title}{RST}")
        for _, base, summ, extra, port, detail in sub:
            tag = ""
            if kind in ("candidate_bd", "candidate_pk"):
                tag = f"  {G}[{port}: {detail}]{RST}"
            elif kind in ("bin", "pk"):
                tag = f"  {DIM}({extra}){RST}" if extra else ""
                if extra == "DIFFERS":
                    tag = f"  {Y}(DIFFERS from {kind.upper()} copy -- update?){RST}"
            elif kind == "overlap":
                tag = f"  {Y}~= {extra}{RST}"
            elif kind == "audit":
                tag = f"  {DIM}[{port}: {detail}]{RST}"
            print(f"  {base:<26}{RST}{tag}")
            if summ:
                print(f"    {DIM}{summ[:80]}{RST}")

    block("candidate_bd", "CANDIDATE bd tool (bd-named, portable -> promote to bin/bdsuite):", G)
    block("candidate_pk", "CANDIDATE static PK (portable audit-program; siblings already in PK -> add to complete the set):", C)
    block("overlap", "OVERLAPS an existing bd tool (compare; fold the best in, don't duplicate):", Y)
    block("audit", "AUDIT-ONLY / not portable (leave in the ledger):", DIM)
    block("bin", "already a bd tool:", DIM)
    block("pk", "already in the static PK:", DIM)
    if docs:
        print(f"\n{C}CANDIDATE static PK (reference docs in audit_state/tools/):{RST}")
        for d in docs:
            here = os.path.basename(d) in pk
            print(f"  {os.path.basename(d)}  {DIM}{'(already in PK)' if here else '(new)'}{RST}")
    print(f"\n{DIM}promote a candidate:  bd-audit promote <name>   "
          f"(stages into bin; then add to bdsuite bin/ + PK bundle, byte-identical){RST}")
    return 0


def promote(a):
    res = classify(a)
    if not res:
        print(f"{R}nothing to promote (hydrate first?){RST}")
        return 1
    rows, docs, pk = res
    hit = [r for r in rows if r[1] == a.name or r[1] == a.name + ".py"]
    if not hit:
        print(f"{R}no audit_state tool named {a.name!r} (see `bd-audit analyze`){RST}")
        return 1
    kind, base, summ, extra, port, detail = hit[0]
    if kind in ("bin", "pk"):
        print(f"{Y}{base} is already in the {kind.upper()} -- no need to promote{RST}")
        return 1
    if port != "portable":
        print(f"{R}refusing: {base} is {port} ({detail}). Not safe to promote as-is.{RST}")
        return 1
    if kind == "candidate_pk":
        print(f"{C}{base} is an audit-program script (siblings live in the static PK).{RST}")
        print(f"{DIM}add it to the project-files (static-PK) bundle rather than bin: "
              f"copy into the PK bundle + Manifest, re-zip bd_project_files.{RST}")
        return 0
    src = os.path.join(a.audit, "tools", base)
    if not os.path.exists(src):
        src = os.path.join(a.audit, base)
    dst = os.path.join(a.bin, base)
    with open(src, "rb") as f:
        data = f.read()
    with open(dst, "wb") as f:
        f.write(data)
    os.chmod(dst, 0o755)
    print(f"{G}staged{RST} {base} -> {dst} (exec)")
    print(f"{DIM}to ship it: copy into bdsuite bin/ + the project-files bundle (byte-identical), "
          f"chmod +x, add an entry to BD_TOOLCHAIN_REFERENCE, re-stamp bdsuite.{RST}")
    return 0


def selftest():
    """DELEGATE: wraps bd-coverage. FAIL if the target is not present in the bin dir."""
    import os as _o
    here=_o.path.dirname(_o.path.realpath(__file__))
    found=_o.path.isfile(_o.path.join(here,"bd-coverage"))
    print(("PASS" if found else "FAIL")+"  delegation target present: bd-coverage")
    print("SELFTEST PASS" if found else "SELFTEST FAIL"); return 0 if found else 1


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", nargs="?", default="all",
                    choices=["all", "hydrate", "analyze", "promote"])
    ap.add_argument("name", nargs="?")
    ap.add_argument("--pk", default=PK)
    ap.add_argument("--bin", default=BIN)
    ap.add_argument("--audit", default=AUDIT)
    a = ap.parse_args()
    if a.cmd in ("all", "hydrate"):
        if not hydrate() and a.cmd == "hydrate":
            return 1
    if a.cmd == "promote":
        return promote(a)
    if a.cmd in ("all", "analyze"):
        print()
        return analyze(a)
    return 0


sys.exit(main())
