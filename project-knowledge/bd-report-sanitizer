#!/usr/bin/env python3
"""bd-report-sanitizer -- canonical HTML sanitizer for rendered reports + a check.

--emit prints a self-contained, stdlib-only sanitize_report_html() (allowlist
tags/attrs, strips <script>/<style>/event handlers/dangerous href schemes
javascript:/data:/vbscript:, neutralizes on* attributes), ast-verified before
printing. --check finds markdown/report/notification HTML render paths
(markdown.*, to_html, body_format="html", jsonify of *_html) and reports which
pass through a sanitizer. Advisory, read-only.

Usage:
    bd-report-sanitizer --emit
    bd-report-sanitizer --check [--work DIR] [--json]
    bd-report-sanitizer --selftest
Exit 0 (advisory).
"""
import argparse
import ast
import os
import re
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

SANITIZER_MODULE = '''\
"""report_sanitizer -- canonical HTML sanitizer for rendered reports.

Generated by bd-report-sanitizer --emit. Stdlib-only (html.parser). Allowlist
model: unknown tags dropped, unsafe attributes/schemes stripped. Use for any
markdown/report HTML surfaced to the UI, notifications, or exports.
"""
from html.parser import HTMLParser
from html import escape

ALLOWED_TAGS = {
    "a", "b", "i", "em", "strong", "code", "pre", "blockquote", "br", "hr",
    "p", "ul", "ol", "li", "h1", "h2", "h3", "h4", "h5", "h6", "table",
    "thead", "tbody", "tr", "th", "td", "span", "div",
}
ALLOWED_ATTRS = {
    "a": {"href", "title"}, "span": {"class"}, "div": {"class"},
    "code": {"class"}, "th": {"scope"}, "td": {"colspan", "rowspan"},
}
SAFE_URL_SCHEMES = ("http", "https", "mailto", "")
_DROP_CONTENT_TAGS = {"script", "style"}


def _safe_href(value):
    v = (value or "").strip().lower()
    if v.startswith(("javascript:", "data:", "vbscript:", "file:")):
        return False
    scheme = v.split(":", 1)[0] if ":" in v.split("/", 1)[0] else ""
    return scheme in SAFE_URL_SCHEMES


class _Sanitizer(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out = []
        self._suppress = 0

    def handle_starttag(self, tag, attrs):
        if tag in _DROP_CONTENT_TAGS:
            self._suppress += 1
            return
        if tag not in ALLOWED_TAGS:
            return
        allowed = ALLOWED_ATTRS.get(tag, set())
        kept = []
        for k, v in attrs:
            kl = k.lower()
            if kl.startswith("on"):        # event handlers
                continue
            if kl not in allowed:
                continue
            if kl == "href" and not _safe_href(v):
                continue
            kept.append((kl, v))
        attr_str = "".join(
            ' %s="%s"' % (k, escape(v or "", quote=True)) for k, v in kept)
        self.out.append("<%s%s>" % (tag, attr_str))

    def handle_endtag(self, tag):
        if tag in _DROP_CONTENT_TAGS:
            if self._suppress:
                self._suppress -= 1
            return
        if tag in ALLOWED_TAGS:
            self.out.append("</%s>" % tag)

    def handle_data(self, data):
        if self._suppress:
            return
        self.out.append(escape(data))

    def result(self):
        return "".join(self.out)


def sanitize_report_html(html):
    """Return html with only allowlisted tags/attrs and safe href schemes."""
    p = _Sanitizer()
    p.feed(html or "")
    p.close()
    return p.result()
'''

RENDER_SINK = re.compile(
    r'markdown\.(?:markdown|Markdown)\s*\(|\.to_html\s*\('
    r'|body_format\s*=\s*["\'](?:html|markdown)["\']'
    r'|jsonify\([^)]*_html\b|render_markdown\s*\(')
SANITIZE_HINT = re.compile(r'sanitize_report_html|sanitize_html|\bbleach\b|DOMPurify|\bclean\(')


def emit_module():
    ast.parse(SANITIZER_MODULE)
    return SANITIZER_MODULE


def check(work):
    rows = []
    for _p, rel, txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        sinks = [(i, l) for i, l in enumerate(txt.splitlines(), 1) if RENDER_SINK.search(l)]
        if not sinks:
            continue
        sanitized = bool(SANITIZE_HINT.search(txt))
        rows.append({"file": rel, "sinks": len(sinks), "sanitized": sanitized,
                     "first": sinks[0][1].strip()[:90]})
    rows.sort(key=lambda r: (r["sanitized"], -r["sinks"]))
    return rows


def selftest():
    ok = True
    src = emit_module()
    ns = {}
    exec(compile(src, "report_sanitizer.py", "exec"), ns)
    san = ns["sanitize_report_html"]
    cases = [
        ("<script>alert(1)</script>hi", "script dropped", lambda o: "<script" not in o and "alert" not in o),
        ('<a href="javascript:x">c</a>', "js href stripped", lambda o: "javascript:" not in o),
        ('<a href="https://ok.com">c</a>', "safe href kept", lambda o: "https://ok.com" in o),
        ('<img src=x onerror=alert(1)>', "onerror + disallowed tag", lambda o: "onerror" not in o and "<img" not in o),
        ('<b>bold</b>', "allowed tag kept", lambda o: "<b>bold</b>" in o),
        ('<div onclick="x">y</div>', "on* stripped", lambda o: "onclick" not in o),
    ]
    for html_in, name, pred in cases:
        out = san(html_in)
        good = pred(out)
        print(("PASS" if good else "FAIL") + f"  sanitize: {name}" + ("" if good else f" (got {out!r})"))
        ok &= good
    # --check math on a 2-sink fixture
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bulk_downloader")
        os.makedirs(b)
        open(os.path.join(b, "clean.py"), "w").write(
            "from .report_sanitizer import sanitize_report_html\n"
            "import markdown\n"
            "def r(t): return sanitize_report_html(markdown.markdown(t))\n")
        open(os.path.join(b, "raw.py"), "w").write(
            "import markdown\n"
            "def r(t): return markdown.markdown(t)\n")
        rows = check(d)
    san_count = sum(1 for r in rows if r["sanitized"])
    good = len(rows) == 2 and san_count == 1
    print(("PASS" if good else "FAIL") +
          f"  --check: 2 render sinks, 1 sanitized (got {len(rows)}, {san_count})")
    ok &= good
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--emit", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if a.emit:
        sys.stdout.write(emit_module())
        return 0
    rows = check(a.work)
    san = sum(1 for r in rows if r["sanitized"])
    if sec.emit({"render_sinks": rows, "summary": {"files": len(rows), "sanitized": san}},
                as_json=a.json):
        return 0
    if not rows:
        print(f"{G}no markdown/report HTML render sinks found{RST}")
        return 0
    for r in rows[:40]:
        tag = (G + "sanitized" + RST) if r["sanitized"] else (R + "RAW      " + RST)
        print(f"  {tag} {r['file']}  {DIM}({r['sinks']} sink) {r['first']}{RST}")
    print(f"{DIM}{san}/{len(rows)} render module(s) route through a sanitizer{RST}")
    return 0


sys.exit(main())
