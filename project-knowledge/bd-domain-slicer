#!/usr/bin/env python3
"""bd-domain-slicer -- group code by product domain.

Assigns each bulk_downloader module to a product domain (Settings, Cockpit,
Capture, Templates, Plugins, VPN, Scheduler, Recognizer, Runner, Core) by name +
route prefix heuristics, and reports the module + LOC + route count per domain.
The domain map a decomposition uses to plan blueprint boundaries. Read-only.

Usage: bd-domain-slicer [--work DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
DOMAINS=[("Settings","settings|widgets_config|app_config|app_global_config"),
         ("Cockpit","cockpit|app_health|app_kernel|dashboard"),
         ("Capture","capture|dom_|session_capture|wacz|recorder"),
         ("Templates","template|recogniz"),("Plugins","plugin"),
         ("VPN","vpn|netns|egress|proxy|download_egress"),
         ("Scheduler","schedule|cron|cadence|session_keeper"),
         ("Runner","runner|download|extract|discovery"),
         ("AI","ai_provider|llm")]

def domain_of(mod):
    for name,pat in DOMAINS:
        if re.search(pat,mod): return name
    return "Core"

def slice_tree(work):
    domains={}
    for p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        if not rel.startswith("bulk_downloader/") or "/test" in rel: continue
        mod=os.path.basename(rel)[:-3]
        dom=domain_of(mod)
        loc=txt.count(chr(10))+1
        routes=len(re.findall(r'@\w+\.route\(|@app\.route\(|@bp\.route\(',txt))
        d=domains.setdefault(dom,{"modules":0,"loc":0,"routes":0,"names":[]})
        d["modules"]+=1; d["loc"]+=loc; d["routes"]+=routes
        if len(d["names"])<8: d["names"].append(mod)
    return domains

def selftest():
    ok=True
    d=slice_tree(sec.DEFAULT_WORK)
    print(("PASS" if len(d)>0 else "FAIL")+"  domains sliced (%d)"%len(d))
    ok=ok and len(d)>0
    print(("PASS" if domain_of("vpn_runtime")=="VPN" and domain_of("plugin_node")=="Plugins" else "FAIL")+"  domain classification")
    total_loc=sum(x["loc"] for x in d.values())
    print(("PASS" if total_loc>0 else "FAIL")+"  %d modules, %d LOC across %d domains"%(sum(x["modules"] for x in d.values()),total_loc,len(d)))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    d=slice_tree(a.work)
    if sec.emit({"domains":d,"summary":{"domains":len(d)}},as_json=a.json): return 0
    print("product-domain map:")
    for name,x in sorted(d.items(),key=lambda kv:-kv[1]["loc"]):
        print("  %s%-11s%s %3d modules  %6d LOC  %3d routes  %s%s%s"%(G,name,RST,x["modules"],x["loc"],x["routes"],DIM,",".join(x["names"][:4]),RST))
    return 0
sys.exit(main())
