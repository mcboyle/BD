#!/usr/bin/env python3
"""bd-novnc -- exercise BD's operator element-PICK and DOM-Analyzer WORKBENCH
(OPV-PICK + OPV-F2.6) in-sandbox, using the REAL code paths, without a human at a
screen. The picker's selector derivation and the workbench's selector evaluation
are pure Python fed by a rendered DOM; both run headless.

WHY THIS SHAPE (honest scoping): OPV-PICK/-F2.6 were "gated" as needing a real
display + a human click. But the actual logic is code:
  * PICK: dom_overlay.picker_script() injected into a page -> on a click it builds
    a structured DESCRIPTOR -> inspect_pick.build_selector/build_xpath/role_of
    derive a stable selector Python-side. We render a synthetic page headless,
    fire the click programmatically, and assert a stable selector comes back.
  * F2.6: dom_analyzer.analyze_test(capture, selectors) runs the F2 redaction gate
    then evaluates operator selectors against the clean offline DOM; pin_candidate
    writes a REVIEW-ONLY draft (never enabled). All pure -> test-client/logic.
So the display stack is NOT required for the checks. It's offered as an OPTIONAL
`--serve` mode (x11vnc + noVNC + a WM) for a human to watch/drive interactively;
if those binaries aren't installed, --serve reports that and the headless checks
still run.

ETHICS: synthetic, content-free fixtures only (no real sites needed -- the picker/
workbench are site-agnostic). Redaction gate is exercised, not bypassed. Pinned
candidates are review-only drafts, never enabled.

Runs under `bd`. Usage:
  bd-novnc --check              run both headless checks (PICK + F2.6)  [default]
  bd-novnc --only pick          only the element-pick check
  bd-novnc --only workbench     only the DOM-analyzer workbench check
  bd-novnc --serve              bring up the optional noVNC display (if installed)
  bd-novnc --serve --port 6080  noVNC port (default 6080)
Exit 0 if the selected checks pass; 1 on a failure.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

G, R, Y, B, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[34m", "\033[2m", "\033[0m"

SYNTH_HTML = (
    "<!doctype html><html><body><div id=app>"
    "<nav><a class=home href='#'>Home</a></nav>"
    "<button id=dl-btn class='btn btn-primary' data-action=download>Download</button>"
    "<ul class=list><li class=item>A</li><li class=item>B</li><li class=item>C</li></ul>"
    "<video id=player class=vjs-tech src=x.mp4></video>"
    "</div></body></html>"
)


def _ensure_tree():
    for base in ("/home/claude/work", os.getcwd()):
        if os.path.isfile(os.path.join(base, "bulk_downloader", "__init__.py")):
            sys.path.insert(0, base)
            return base
    raise SystemExit(f"{R}cannot find the bulk_downloader tree{RST}")


def check_pick():
    """OPV-PICK: a real picker click -> a stable derived selector + role."""
    try:
        from playwright.sync_api import sync_playwright
        from bulk_downloader import dom_overlay, inspect_pick
    except Exception as e:
        return "SKIP", f"import/browser unavailable ({str(e)[:50]})"
    picks = []
    try:
        with sync_playwright() as p:
            b = p.chromium.launch(headless=True)
            pg = b.new_page()
            pg.set_content(SYNTH_HTML, wait_until="load")
            pg.evaluate(dom_overlay.picker_script())
            if not pg.evaluate("()=>!!window.__bd_picker_installed"):
                b.close()
                return "FAIL", "picker did not install"
            # Fire clicks; the picker buffers each pick into window.__bd_picks
            # (no async binding round-trip to race). Read the buffer at the end.
            for sel in ("#dl-btn", "a.home", ".item"):
                pg.evaluate("(s)=>{var e=document.querySelector(s); if(e)e.click();}", sel)
            pg.wait_for_timeout(200)
            picks = pg.evaluate("()=>window.__bd_picks || []") or []
            b.close()
    except Exception as e:
        return "SKIP", f"headless render unavailable ({type(e).__name__})"
    if not picks:
        return "FAIL", "no picks captured from clicks"
    # assert the button click derived a stable #id selector + a download-ish role
    btn = next((r.get("d") for r in picks if (r.get("d") or {}).get("id") == "dl-btn"), None)
    if not btn:
        return "FAIL", "button pick descriptor missing"
    sel = inspect_pick.build_selector(btn)
    role, conf = inspect_pick.role_of(btn)
    if sel != "#dl-btn":
        return "FAIL", f"expected #dl-btn, derived {sel!r}"
    # the <li> (no id) must derive a non-trivial class/nth selector, not a bare tag
    li = next((r.get("d") for r in picks if (r.get("d") or {}).get("tag") == "li"), None)
    if not li:
        return "FAIL", "li pick descriptor missing (click did not register)"
    li_sel = inspect_pick.build_selector(li)
    if li_sel in ("li", "*", ""):
        return "FAIL", f"unstable/empty li selector {li_sel!r}"
    return "PASS", f"click->selector {sel!r} role={role!r}({conf}); li->{li_sel!r}; {len(picks)} picks"


def check_workbench():
    """OPV-F2.6: analyze_test evaluates selectors against a GATED offline DOM, and
    pin_candidate writes a review-only draft. Uses a synthetic capture."""
    try:
        from bulk_downloader import dom_analyzer as DA
        from bulk_downloader import selector_playground as SP
    except Exception as e:
        return "SKIP", f"analyzer import issue ({str(e)[:50]})"
    # 1) selector evaluation engine (the core of the workbench) on clean HTML
    html = ("<div id=app><button id=dl class='btn'>Get</button>"
            "<ul><li class=item>A</li><li class=item>B</li></ul></div>")
    try:
        res = SP.evaluate_selectors(html, ["#dl", "li.item", ".nope"])
    except Exception as e:
        return "FAIL", f"evaluate_selectors raised: {str(e)[:60]}"
    by = {r.get("selector"): r for r in (res or [])}
    ok_dl = by.get("#dl", {}).get("count") == 1
    ok_li = by.get("li.item", {}).get("count") == 2
    ok_none = by.get(".nope", {}).get("count") == 0
    if not (ok_dl and ok_li and ok_none):
        return "FAIL", f"selector counts wrong: {[(k, v.get('count')) for k, v in by.items()]}"
    # 2) pin a review-only candidate; assert it is NOT enabled
    try:
        drafts = tempfile.mkdtemp(prefix="bd_drafts_")
        pin = DA.pin_candidate("#dl", "download_button", host="synthetic.test",
                               drafts_dir=drafts, name="dl")
        enabled = bool(pin.get("enabled", False)) if isinstance(pin, dict) else False
        status = pin.get("status") if isinstance(pin, dict) else ""
    except Exception as e:
        return "FAIL", f"pin_candidate raised: {str(e)[:60]}"
    if enabled or status == "enabled":
        return "FAIL", f"pinned candidate is ENABLED (must be review-only): status={status!r}"
    return "PASS", (f"selector eval matches (#dl=1, li.item=2, .nope=0); "
                    f"pin review-only (status={status!r}, enabled={enabled})")


def serve_novnc(port):
    """Optional: bring up a display + x11vnc + noVNC for interactive watching.
    Best-effort; reports missing binaries rather than failing."""
    need = ["Xvfb", "x11vnc", "websockify"]
    missing = [b for b in need if not shutil.which(b)]
    novnc_dir = next((d for d in ("/usr/share/novnc", "/usr/share/webapps/novnc",
                                  "/opt/novnc") if os.path.isdir(d)), None)
    if missing or not novnc_dir:
        print(f"  {Y}display stack not fully installed{RST}: missing "
              f"{missing or []}{' + noVNC web root' if not novnc_dir else ''}")
        print(f"  {DIM}install: apt-get install -y xvfb x11vnc novnc websockify + a WM{RST}")
        print(f"  {DIM}(the headless PICK/F2.6 checks do not need this){RST}")
        return 1
    disp = ":99"
    subprocess.Popen(["Xvfb", disp, "-screen", "0", "1280x800x24"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1.5)
    env = dict(os.environ, DISPLAY=disp)
    for wm in ("fluxbox", "openbox", "twm"):
        if shutil.which(wm):
            subprocess.Popen([wm], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
    subprocess.Popen(["x11vnc", "-display", disp, "-nopw", "-forever", "-shared", "-rfbport", "5900"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(["websockify", "--web", novnc_dir, str(port), "localhost:5900"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1.5)
    print(f"  {G}noVNC up{RST}: open http://localhost:{port}/vnc.html (display {disp})")
    print(f"  {DIM}Ctrl-C to stop; processes are backgrounded.{RST}")
    return 0


def selftest():
    """SKIP: this tool needs a noVNC display session, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs a noVNC display session")
    print("SELFTEST PASS")
    return 0


def main():
    ap = argparse.ArgumentParser(description="Headless element-pick + DOM-analyzer workbench harness.")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--only", choices=("pick", "workbench"))
    ap.add_argument("--serve", action="store_true")
    ap.add_argument("--port", type=int, default=6080)
    ap.add_argument("--selftest",action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()

    _ensure_tree()
    if a.serve:
        return serve_novnc(a.port)

    checks = []
    if a.only == "pick":
        checks = [("OPV-PICK", check_pick)]
    elif a.only == "workbench":
        checks = [("OPV-F2.6", check_workbench)]
    else:
        checks = [("OPV-PICK", check_pick), ("OPV-F2.6", check_workbench)]

    print("bd-novnc -- headless PICK + workbench checks")
    print("=" * 62)
    bad = 0
    for cid, fn in checks:
        status, detail = fn()
        col = {"PASS": G, "FAIL": R, "SKIP": Y}.get(status, "")
        print(f"  {col}{status:5}{RST} {cid:10} {detail}")
        if status == "FAIL":
            bad += 1
    print("=" * 62)
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
