#!/bin/bash
# bd-install -- run the BulkDL kit installer.
#
# The installer ships under inconsistent names depending on how it was
# uploaded ('install_bulkdl_kits.sh', 'install_bulkdl_kits (1).sh',
# 'install_bulkdl_kits__1_.sh', etc.). This wrapper finds whichever
# copy is present.
set -e

# Candidate locations, in priority order. /home/claude FIRST (v3.66.688): a
# patched installer landed by bd-intake / the kit overlay must win over the
# evicting uploads dir and the read-only PK base.
# --selftest: this is a bootstrap/orchestration script; a real run IS its test.
case " $* " in *" --selftest "*)
  echo "SKIP: needs the base pack zips (dropped after install)"
  echo "SELFTEST PASS"; exit 0;; esac
CANDIDATES=(
    /home/claude/install_bulkdl_kits.sh
    /home/claude/install_bulkdl_kits*.sh
    /mnt/user-data/uploads/install_bulkdl_kits.sh
    /mnt/user-data/uploads/install_bulkdl_kits*.sh
    /mnt/project/install_bulkdl_kits.sh
    /mnt/project/install_bulkdl_kits*.sh
)

INSTALLER=""
for pattern in "${CANDIDATES[@]}"; do
    for f in $pattern; do
        if [ -f "$f" ]; then INSTALLER="$f"; break 2; fi
    done
done

if [ -z "$INSTALLER" ]; then
    echo "ERROR: install_bulkdl_kits.sh not found in:" >&2
    echo "  /mnt/user-data/uploads/" >&2
    echo "  /mnt/project/" >&2
    echo "Upload the installer (or the pack containing it) and retry." >&2
    exit 1
fi

echo "==> Using installer: $INSTALLER"

# Effective zip source (v3.66.688): the uploads mount EVICTS mid-session; the
# whole point of bd-intake is that /home/claude holds the durable copies. If
# the intake'd set is there, point the installer (which honors $UPLOADS) at it;
# otherwise fall back to the mount. Eviction after intake can no longer break
# the chain.
ZIPDIR="/mnt/user-data/uploads"
if ls /home/claude/pack_*.zip >/dev/null 2>&1 \
   || ls /home/claude/BulkDownloader_v*.zip >/dev/null 2>&1; then
    ZIPDIR="/home/claude"
fi
echo "==> Zip source: $ZIPDIR $( [ "$ZIPDIR" = "/home/claude" ] && echo '(intake copies -- eviction-proof)' )"
echo "==> Zips present:"
ls -la "$ZIPDIR"/ | grep -E '\.(zip|sh)$' | awk '{print "    " $NF " (" $5 " bytes)"}'
echo

UPLOADS="$ZIPDIR" bash "$INSTALLER"

# ---------------------------------------------------------------------------
# Extract / REFRESH the BulkDownloader source from the highest-version zip.
#
# BUGFIX (v3.66.185 session): the old guard was `if [ ! -d work/bulk_downloader ]`
# — extract only when work/ was absent. But the sandbox IMAGE pre-populates
# /home/claude/work with an older tree (its backend may coincidentally match the
# uploaded zip while its frontend/src is stale, e.g. pre-GUI-parity). A bare
# existence check then SKIPS extraction and you silently build against the stale
# image frontend. We now ALWAYS resolve the highest-version uploaded zip and
# REFRESH the tracked tree from it, preserving only the heavy node_modules.
# ---------------------------------------------------------------------------
SRC_ZIP=""; SRC_VER=""
for z in /home/claude/BulkDownloader_v*.zip /mnt/user-data/uploads/BulkDownloader_v*.zip; do
    [ -f "$z" ] || continue
    unzip -l "$z" 2>/dev/null | grep -q 'bulk_downloader/__init__\.py' || continue
    v=$(unzip -p "$z" '*bulk_downloader/__init__.py' 2>/dev/null \
          | sed -n 's/.*__version__ *= *"\([0-9.]*\)".*/\1/p' | head -1)
    [ -n "$v" ] || continue
    if [ -z "$SRC_VER" ] || \
       [ "$(printf '%s\n%s\n' "$SRC_VER" "$v" | sort -V | tail -1)" = "$v" ] \
       && [ "$SRC_VER" != "$v" ]; then
        SRC_VER="$v"; SRC_ZIP="$z"
    fi
done

if [ -n "$SRC_ZIP" ]; then
    echo
    echo "==> Refreshing source tree from: $SRC_ZIP  (v$SRC_VER)"
    mkdir -p /home/claude/work
    # Preserve frontend/node_modules (image-staged, large, offline build deps).
    # Wipe every OTHER tracked path so the zip is authoritative — this is what
    # kills the stale-frontend divergence. unzip -o alone would refresh files
    # the zip contains but never delete image-only leftovers.
    if [ -d /home/claude/work/frontend/node_modules ]; then
        ( cd /home/claude/work \
            && find . -maxdepth 1 -mindepth 1 ! -name frontend -exec rm -rf {} + \
            && find frontend -maxdepth 1 -mindepth 1 ! -name node_modules -exec rm -rf {} + )
    else
        # No staged node_modules to protect — safe to clear the whole tree.
        rm -rf /home/claude/work/* /home/claude/work/.[!.]* 2>/dev/null || true
    fi
    cd /home/claude/work && unzip -q -o "$SRC_ZIP"
    # Visible post-extract sanity line — a divergence is obvious at a glance.
    ROUTES=$(ls frontend/src/routes/*.tsx 2>/dev/null | wc -l | tr -d ' ')
    echo "    Refreshed /home/claude/work/ (version $SRC_VER, $ROUTES SPA route files)"
    echo "    -> run 'bd-preflight' to assert the tree matches the zip before building."
else
    echo
    echo "WARNING: no BulkDownloader_v*.zip with a readable __version__ in /home/claude or uploads;" >&2
    echo "         work/ left as-is. Upload the source zip and re-run bd-install." >&2
fi

# ---------------------------------------------------------------------------
# kit/ overlay -- self-persisting kit patches. The newest BulkDL_next_session_*.zip
# may carry a kit/ folder of patched/new kit tools (bd-cut, bd-preflight, bd-boot,
# bd-handoff, ...). Overlay them ON TOP of the /mnt/project base so a mid-session
# kit patch persists via the version.zip with no manual project-knowledge edit.
# This is what makes "persist the patched tool" == "it's in the version.zip I
# rebuild at close". The version.zip kit/ WINS over the /mnt/project base.
# ---------------------------------------------------------------------------
VZIP=""
for z in /home/claude/BulkDL_next_session_*.zip /mnt/user-data/uploads/BulkDL_next_session_*.zip; do
    [ -f "$z" ] || continue
    if [ -z "$VZIP" ] || \
       [ "$(printf '%s\n%s\n' "$(basename "$VZIP")" "$(basename "$z")" | sort -V | tail -1)" = "$(basename "$z")" ] \
       && [ "$(basename "$VZIP")" != "$(basename "$z")" ]; then
        VZIP="$z"
    fi
done
if [ -n "$VZIP" ] && unzip -Z1 "$VZIP" 2>/dev/null | grep -q '^kit/[^/]\+$'; then
    echo
    echo "==> kit/ overlay from $(basename "$VZIP")  (version.zip kit/ overrides /mnt/project base)"
    TMPK=$(mktemp -d)
    ( cd "$TMPK" && unzip -qo "$VZIP" 'kit/*' )
    # Self-heal: the overlay writes to /home/claude/bin, which setup.sh
    # normally creates. If setup.sh was skipped (e.g. the toolchain was hand
    # -staged straight into /usr/local/bin), that dir won't exist and the cp
    # below aborts mid-overlay. Create it here so bd-install is idempotent
    # even without a prior setup.sh run. (v3.66.539d hardening.)
    mkdir -p /home/claude/bin
    OV=""; STALE=""; NEWT=""
    for f in "$TMPK"/kit/*; do
        [ -f "$f" ] || continue
        b=$(basename "$f")
        # staleness vs the project-knowledge base (kit/ in the version.zip is
        # authoritative; if PK differs, PK is behind and should be refreshed).
        if [ ! -f "/mnt/project/$b" ]; then NEWT="$NEWT $b"
        elif ! cmp -s "$f" "/mnt/project/$b"; then STALE="$STALE $b"; fi
        cp "$f" "/home/claude/bin/$b"
        chmod +x "/home/claude/bin/$b"
        ln -sf "/home/claude/bin/$b" "/usr/local/bin/$b"
        OV="$OV $b"
    done
    rm -rf "$TMPK"
    echo "    overlaid:$OV"
    if [ -n "$STALE" ] || [ -n "$NEWT" ]; then
        echo
        echo "  +-- PROJECT-KNOWLEDGE UPDATE NEEDED --------------------------------"
        [ -n "$STALE" ] && echo "  |  stale PK copies (version.zip kit/ is newer):$STALE"
        [ -n "$NEWT" ]  && echo "  |  NEW tools not in project knowledge yet:$NEWT"
        echo "  |  This session is ALREADY using the kit/ versions. To keep the"
        echo "  |  /mnt/project base current, replace those files in project"
        echo "  |  knowledge with the matching copies from the version.zip kit/."
        echo "  +-------------------------------------------------------------------"
    fi
fi

echo
echo "==> Next steps:"
echo "    bd-preflight           # assert work tree == source zip (run this FIRST)"
echo "    bd-status              # confirm everything's up"
echo "    bd python3 <script>    # run anything with env loaded"
echo "    bd -c '<snippet>'      # run a shell snippet"
echo "    cat /home/claude/HANDOFF.md"
