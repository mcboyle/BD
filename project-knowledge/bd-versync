#!/usr/bin/env python3
"""bd-versync fixed."""
import argparse, importlib.util, os, re, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

VER = re.compile(r'\d+\.\d+\.\d+')


def init_version(tree):
    try:
        t = open(os.path.join(tree, "bulk_downloader/__init__.py"), errors="ignore").read()
        m = re.search(r'__version__\s*=\s*["\']([0-9.]+)["\']', t)
        return m.group(1) if m else None
    except Exception:
        return None


def changelog_version(tree):
    p = os.path.join(tree, "CHANGELOG.md")
    if not os.path.exists(p):
        return None
    for line in open(p, errors="ignore"):
        if re.match(r"^#{1,3}\s*v?\d+\.\d+\.\d+", line.strip()):
            m = VER.search(line)
            return m.group(0) if m else None
    return None


def _load_pin_index(tree):
    path = os.path.join(tree, "tools", "build_pin_index.py")
    if not os.path.isfile(path):
        return None, "%s absent (no pin-index tool to gate against)" % path
    try:
        spec = importlib.util.spec_from_file_location("bd_versync_pin_index", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
    except Exception as e:
        return None, "%s failed to load: %s: %s" % (path, type(e).__name__, e)
    if not (hasattr(mod, "build_index") and hasattr(mod, "unparseable_test_files")):
        return None, ("%s lacks build_index/unparseable_test_files "
                      "(too old to gate against)" % path)
    return mod, None


def selftest():
    import subprocess as _sp
    ct = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-coretest")
    if not os.path.isfile(ct):
        print("SELFTEST FAIL")
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=ABSENT "
                         "(bd-coretest harness not found)\n")
        return 2
    cp = _sp.run([sys.executable, ct, "--no-cache", "--only", "bd-versync"],
                 capture_output=True, text=True, timeout=180)
    sys.stdout.write(cp.stdout)
    ok = cp.returncode == 0
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tree", "--work", default=sec.DEFAULT_WORK)
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()

    sec.require_source_tree(a.tree)

    iv = init_version(a.tree)
    cv = changelog_version(a.tree)
    print(f"__init__.py __version__ : {iv or 'NOT FOUND'}")
    print(f"CHANGELOG top entry     : {cv or 'NOT FOUND'}")
    if iv is None:
        print("  FAIL: bulk_downloader/__init__.py declares no __version__ "
              "(no source version for the 3-part bump to agree with).")
        return sec.EXIT_FINDINGS

    rc = 0
    if cv and iv not in cv:
        print(f"  DISAGREE: __init__ {iv} != CHANGELOG {cv}"); rc = 1
    elif cv:
        print(f"  __init__ and CHANGELOG agree ({iv})")
    else:
        print(f"  FAIL: no CHANGELOG '## v{iv}' header found near the top."); rc = 1

    mod, err = _load_pin_index(a.tree)
    if err:
        sys.stderr.write("CANNOT-EVALUATE --tree/--work %s: reason=%s (%s)\n"
                         % (a.tree, sec.REASON_ABSENT, err))
        return sec.EXIT_CANNOT_EVALUATE
    bad = mod.unparseable_test_files()
    if bad:
        sys.stderr.write("CANNOT-EVALUATE --tree/--work %s: reason=%s "
                         "(unparseable test file(s): %s)\n"
                         % (a.tree, sec.REASON_UNREADABLE,
                            ", ".join("%s [%s]" % (f, k) for f, k in bad)))
        return sec.EXIT_CANNOT_EVALUATE

    vpins = [p for p in mod.build_index()["pins"] if p["form"] == "version"]

    if not vpins:
        print("\nFAIL: no version pin found. The 3-part bump has no test pin "
              "(a tree with no pin used to PASS the old text scan).")
        rc = 1
    elif len(vpins) > 1:
        print(f"\nFAIL: expected exactly ONE version pin (the slice4 pin); "
              f"found {len(vpins)} that disagree or duplicate:")
        for p in vpins:
            print(f"  {p['file']}:{p['line']}  (=={p['value']!r})")
        rc = 1
    else:
        p = vpins[0]
        if "settings_center_slice4" not in os.path.basename(p["file"]):
            print(f"\nFAIL: the sole version pin is in {p['file']}, not the "
                  f"settings_center_slice4 file.")
            rc = 1
        elif p["value"] != iv:
            print(f"\nFAIL: slice4 pin {p['file']}:{p['line']} == {p['value']!r} "
                  f"but source __version__ == {iv!r} (incomplete 3-part bump).")
            rc = 1
        else:
            print(f"\nversion pins: exactly one, {p['file']} == {iv} (ok).")

    print("\n" + ("VERSION CONSISTENT." if rc == 0
                  else "=> land the 3-part bump together (bd-cut does this) + clear stray pins."))
    return rc


if __name__ == "__main__":
    sys.exit(main())
