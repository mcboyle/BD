#!/usr/bin/env python3
"""bd-vpn-proof -- proof that vpn_required was honored for a site (request path, proxy, tunnel status, no direct egress). Loads vpn_runtime and records the resolved egress decision; a vpn_required site resolving to a direct path (no proxy, no VPNRequiredError) is a leak. Read-only. Usage: bd-vpn-proof [--work DIR] [--site SITE] [--json] [--selftest]"""
import argparse, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def _load_mod(work, modname):
    import importlib.util, types
    p=os.path.join(work,"bulk_downloader",modname+".py")
    if not os.path.exists(p): return None,modname+".py not found"
    try:
        pkg=types.ModuleType("bulk_downloader"); pkg.__path__=[os.path.join(work,"bulk_downloader")]
        sys.modules.setdefault("bulk_downloader",pkg)
        for e in (work,"/tmp/prestaged_site_packages"):
            if e not in sys.path: sys.path.insert(0,e)
        spec=importlib.util.spec_from_file_location("bulk_downloader."+modname,p)
        m=importlib.util.module_from_spec(spec); sys.modules["bulk_downloader."+modname]=m
        spec.loader.exec_module(m); return m,None
    except Exception as e: return None,"import failed: "+str(e)

def prove(work, site):
    vr,err=_load_mod(work,"vpn_runtime")
    out={"site":site,"vpn_required":None,"proxy":None,"path":None,"direct_leak":None,"error":None}
    if not vr:
        out["error"]=err; return out
    try:
        out["vpn_required"]=bool(vr.is_vpn_required_for_site(site))
    except Exception as e:
        out["error"]="is_vpn_required: "+str(e); return out
    try:
        url=vr.get_socks_url_for_site(site)
        out["proxy"]=url
        out["path"]=("proxy/vpn" if url else ("direct" if not out["vpn_required"] else "UNRESOLVED"))
        out["direct_leak"]=bool(out["vpn_required"] and not url)
    except Exception as e:
        nm=type(e).__name__
        out["path"]="fail-closed ("+nm+")"
        out["direct_leak"]=not (nm=="VPNRequiredError")
        out["error"]=nm+": "+str(e)[:80]
    return out

def selftest():
    ok=True
    vr,err=_load_mod(sec.DEFAULT_WORK,"vpn_runtime")
    print(("PASS" if vr else "FAIL")+"  vpn_runtime loads (err="+str(err)+")"); ok=ok and vr is not None
    if vr:
        r=prove(sec.DEFAULT_WORK,"nonexistent")
        noleak=r.get("direct_leak") is not True
        print(("PASS" if noleak else "FAIL")+"  no direct leak for unknown site ("+str(r)+")")
        ok=ok and noleak
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--site",default="example")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    r=prove(a.work,a.site)
    if sec.emit(r,as_json=a.json): return 0
    if r.get("error") and r.get("vpn_required") is None:
        print(R+"error"+RST+": "+r["error"]); return 0
    leak=(R+"DIRECT LEAK"+RST) if r.get("direct_leak") else (G+"no direct leak"+RST)
    print("site "+r["site"]+": vpn_required="+str(r.get("vpn_required"))+" path="+str(r.get("path"))
          +" proxy="+str(r.get("proxy"))+"  "+leak)
    if r.get("error"): print("  "+DIM+r["error"]+RST)
    return 0
sys.exit(main())
