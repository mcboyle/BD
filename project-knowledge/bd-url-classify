#!/usr/bin/env python3
"""bd-url-classify -- network-risk verdict for URLs (the Wave-0 egress primitive).

Classifies each URL: loopback / private (RFC1918+ULA) / link-local /
cloud-metadata (169.254.169.254, fd00:ec2::254) / reserved / public, flags
embedded userinfo (SSRF obfuscation), optional DNS-rebind-aware resolution.
Deterministic + offline by default. Every egress tool reuses this instead of
re-deriving IP classification. Read-only.

Usage:
    bd-url-classify <url> [<url>...] [--json] [--resolve-dns]
                    [--allow-scheme http,https]
    bd-url-classify --stdin          # one URL per line
    bd-url-classify --selftest
Exit 0 if all allowed, 1 if any blocked (usable as a pipeline gate).
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("urls", nargs="*")
    ap.add_argument("--stdin", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--resolve-dns", action="store_true")
    ap.add_argument("--allow-scheme", default="http,https")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()

    if a.selftest:
        # 702 selftest-contract: the checks live in the shared bdtools_sec core, but
        # the VERDICT must still be machine-readable at THIS tool's entry point --
        # a harness must not have to know which lib a tool delegates to.
        rc = sec._selftest()
        print("SELFTEST PASS" if rc == 0 else "SELFTEST FAIL")
        return rc

    urls = list(a.urls)
    if a.stdin:
        urls += [l.strip() for l in sys.stdin if l.strip()]
    if not urls:
        ap.error("no URLs given (positional or --stdin)")

    schemes = tuple(s.strip().lower() for s in a.allow_scheme.split(",") if s.strip())
    results = [sec.classify_url(u, allow_schemes=schemes, resolve_dns=a.resolve_dns)
               for u in urls]
    blocked = [r for r in results if r["verdict"] == "blocked"]

    if sec.emit({"results": results,
                 "summary": {"total": len(results), "blocked": len(blocked)}},
                as_json=a.json):
        return 1 if blocked else 0

    for r in results:
        tag = (R + "BLOCKED" + RST) if r["verdict"] == "blocked" else (G + "allowed" + RST)
        ui = Y + " [userinfo]" + RST if r["has_userinfo"] else ""
        why = ("; ".join(r["reasons"])) if r["reasons"] else ""
        res = ""
        if r["resolved"]:
            res = DIM + " -> " + ", ".join(f"{x['ip']}({x['classification']})"
                                           for x in r["resolved"]) + RST
        print(f"  {tag}  {r['classification']:<16} {r['url']}{ui}{res}")
        if why:
            print(f"          {DIM}{why}{RST}")
    print(f"{DIM}{len(results)} url(s); {len(blocked)} blocked{RST}")
    return 1 if blocked else 0


sys.exit(main())
