#!/usr/bin/env python3
"""bd-config-orphan -- find incomplete config surfaces.

A config key is "complete" when it is read in runtime AND reachable via at least
one surface (env var, GUI/settings reference, or docs). This flags keys read via
cfg.get("...")/config.get("...") that have NO env-var form and NO settings/docs
mention -- an orphan the operator can't discover or set. Read-only, heuristic.

Usage: bd-config-orphan [--work DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

# read-sites: cfg.get("k") AND bracket access cfg["k"] (the pattern the old
# model missed -- a config key read via [] would give a false all-clear).
GETKEY=re.compile(r'(?:cfg|config|_cfg|global_config|gc|conf)\.get\(\s*["\']([a-zA-Z0-9_]+)["\']'
                  r'|(?:cfg|config|_cfg|global_config|gc|conf)\[\s*["\']([a-zA-Z0-9_]+)["\']\s*\]')

def scan(work):
    reads={}; all_text=[]
    for _p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        all_text.append(txt)
        for m in GETKEY.finditer(txt):
            reads.setdefault(m.group(1) or m.group(2), set()).add(rel)
    corpus="\n".join(all_text)
    orphans=[]
    for key,files in reads.items():
        env_form="BD_"+key.upper()
        has_env=env_form in corpus
        # settings/docs surface: key appears in a settings_center / dev config / a .md
        has_surface=bool(re.search(r'settings|dev_config|widgets_config|SETTINGS', corpus)) and \
                    corpus.count('"'+key+'"')+corpus.count("'"+key+"'")>1
        if not has_env and not has_surface:
            orphans.append({"key":key,"read_in":sorted(files)[:3],"env_form":env_form})
    orphans.sort(key=lambda o:o["key"])
    return orphans, len(reads)

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b=os.path.join(d,"bulk_downloader"); os.makedirs(b)
        open(os.path.join(b,"m.py"),"w").write(
            'x = cfg.get("orphan_key")\n'
            'y = cfg.get("surfaced_key")\n'
            'SETTINGS = {"surfaced_key": 1}\n'
            'print("surfaced_key")\n')
        orphans,total=scan(d)
    keys={o["key"] for o in orphans}
    good="orphan_key" in keys and "surfaced_key" not in keys
    print(("PASS" if good else "FAIL")+"  orphan detected, surfaced excluded (%s)"%sorted(keys))
    ok=ok and good
    real=scan(sec.DEFAULT_WORK)
    print(("PASS" if real[1]>0 else "WARN")+"  real tree: %d keys read, %d orphans"%(real[1],len(real[0])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    orphans,total=scan(a.work)
    if sec.emit({"orphans":orphans,"summary":{"keys_read":total,"orphans":len(orphans)}},as_json=a.json): return 0
    print("%d config keys read; %d orphaned (no env form, no settings/docs surface):"%(total,len(orphans)))
    for o in orphans[:40]:
        print("  %sorphan%s %-28s %s(want %s or a settings/docs mention)%s"%(Y,RST,o["key"],DIM,o["env_form"],RST))
    return 0
sys.exit(main())
