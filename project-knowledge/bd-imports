#!/usr/bin/env python3
"""bd-imports -- undeclared new import edges vs the frozen baseline.

Wraps tools/decomp/import_graph_gate.py --check (the on-stash-only gate). If any
NEW edge exists, lists them and reminds you to re-freeze IN THE SAME CUT with
--update (separate from regenerating DEPENDENCY_GRAPH.json).
Usage: bd-imports [--work DIR] [--update]   Exit 1 if undeclared edges exist.
"""
import argparse, os, subprocess, sys
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
import bdtools_sec as sec
def gate(work,*args):
    p=os.path.join(work,"tools/decomp/import_graph_gate.py")
    if not os.path.exists(p): return None,None
    # venv/bin/python, never bare python3 -- a bare python3 can be 3.11 with
    # none of the project deps (CLAUDE.md s5), and there is no reason to make
    # the wrapped gate run under a different interpreter than this wrapper.
    py = sys.executable
    r=subprocess.run([py,p,*args],cwd=work,capture_output=True,text=True,
                     env={**os.environ,"PYTHONPATH":work})
    return r.returncode,(r.stdout+r.stderr)
def selftest():
    """DELEGATE: wraps tools/decomp/import_graph_gate.py, which lives in the WORK TREE / PK, not in bin/. The
    selftest asserts the real target is reachable; if it is not, FAIL -- a
    wrapper that cannot find what it wraps is broken, and a selftest that cannot
    verify must not report success."""
    import os as _o
    cands = [_o.path.join(sec.DEFAULT_WORK, 'tools/decomp/import_graph_gate.py')]
    hit = next((p for p in cands if _o.path.isfile(p)), None)
    print(("PASS" if hit else "FAIL") + "  delegation target present: tools/decomp/import_graph_gate.py (%s)" % (hit or "NOT FOUND"))
    if hit:
        rc, out = gate(sec.DEFAULT_WORK, "--check")
        ran = rc is not None
        print(("PASS" if ran else "FAIL") + "  wrapped gate actually RUNS under venv's interpreter (rc=%s)" % rc)
        print("SELFTEST PASS" if (hit and ran) else "SELFTEST FAIL")
        return 0 if (hit and ran) else 1
    print("SELFTEST FAIL")
    return 1


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap=argparse.ArgumentParser(); ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--update",action="store_true"); a=ap.parse_args()
    rc,out=gate(a.work,"--check")
    if rc is None: print(f"{R}import_graph_gate.py not found{RST}"); return 1
    if rc==0:
        print(f"{G}OK{RST} no new import edges (baseline current)"); return 0
    print(f"{Y}new import edge(s) detected:{RST}")
    _,lst=gate(a.work,"--list"); print((lst or out).strip()[:1500])
    if a.update:
        rc2,o2=gate(a.work,"--update")
        print(f"{G}re-froze baseline{RST}" if rc2==0 else f"{R}--update failed{RST}\n{o2[-300:]}")
        return 0 if rc2==0 else 1
    print(f"{DIM}intended? re-freeze in THIS cut: bd-imports --update  "
          f"(then also regen DEPENDENCY_GRAPH). band test_import_graph_no_new_edges.py{RST}")
    return 1
sys.exit(main())
