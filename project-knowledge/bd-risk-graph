#!/usr/bin/env python3
"""bd-risk-graph -- build a code risk relationship graph.

Assembles a graph whose nodes are modules annotated with risk signals: guard
files (immutable, high blast-radius), route-bearing modules, egress-bearing
modules (network sinks), secret-touching modules, and plugin modules. Edges are
import relationships. Ranks modules by a composite risk score (guard + routes +
egress + secrets + fan-in). The "where is the risk concentrated" map for
prioritizing review + decomposition. Reuses coupling edges + sec sinks. Read-only.

Usage: bd-risk-graph [--work DIR] [--top N] [--json] [--selftest]
Exit 0 (informational -- ranks modules by risk score; a ranking, not a gate. No bad-state to fail on).
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
GUARDS={"extraction_core","session_capture","dom_capture","dom_recorder","capture_bodies"}
EGRESS=re.compile(r'requests\.|httpx\.|urlopen|\.fetch\(|http_probe')
SECRET=re.compile(r'(?i)secret|token|cookie|api_key|password|vault')
ROUTE=re.compile(r'@\w+\.route\(|@app\.route\(')

def build(work, top):
    nodes={}; fanin={}
    for _p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        if not rel.startswith("bulk_downloader/") or "/test" in rel: continue
        mod=os.path.basename(rel)[:-3]
        score=0; tags=[]
        if mod in GUARDS: score+=10; tags.append("guard")
        routes=len(ROUTE.findall(txt))
        if routes: score+=min(routes,10); tags.append("routes:%d"%routes)
        if EGRESS.search(txt): score+=5; tags.append("egress")
        if SECRET.search(txt): score+=3; tags.append("secret")
        if mod.startswith("plugin"): score+=3; tags.append("plugin")
        nodes[mod]={"score":score,"tags":tags,"routes":routes}
        for m in re.finditer(r'from\s+\.(\w+)\s+import|import\s+bulk_downloader\.(\w+)',txt):
            tgt=m.group(1) or m.group(2)
            if tgt: fanin[tgt]=fanin.get(tgt,0)+1
    for mod,d in nodes.items():
        d["fan_in"]=fanin.get(mod,0); d["score"]+=min(d["fan_in"],10)
    ranked=sorted(nodes.items(),key=lambda kv:(-kv[1]["score"], kv[0]))
    return {"source":"ast_rederive","modules":len(nodes),"top":[{"module":m,**d} for m,d in ranked[:top]]}

def build_from_graph(db, top):
    """Delegate to l0_extract's KNOWLEDGE_GRAPH: routes from .route decorators,
    egress from 'fetch' sinks, secrets from the graph's secret facts, fan-in from
    import edges -- authoritative facts instead of regex (anti-G-3)."""
    import sqlite3, json as _j
    con=sqlite3.connect(db); cur=con.cursor()
    def leaf(path):
        b=path[len("bulk_downloader/"):] if path.startswith("bulk_downloader/") else path
        if b.endswith(".py"): b=b[:-3]
        return b.split("/")[-1]
    nodes={}
    # seed modules
    for (path,) in cur.execute("SELECT path FROM nodes WHERE kind='module' AND path LIKE 'bulk_downloader/%'"):
        if "/test" in path: continue
        nodes[leaf(path)]={"score":0,"tags":[],"routes":0,"_egress":False,"_secret":False}
    # per-function facts -> module rollup
    for path,meta in cur.execute("SELECT path,meta_json FROM nodes WHERE kind='function' AND path LIKE 'bulk_downloader/%'"):
        if "/test" in path: continue
        mod=leaf(path); d=nodes.get(mod)
        if d is None: continue
        try: mj=_j.loads(meta)
        # why: read failed; degrade to the default and continue -- affects completeness, not correctness
        except Exception: mj={}
        if any(str(x).endswith("route") for x in mj.get("decorators",[])): d["routes"]+=1
        if "fetch" in [str(s) for s in mj.get("sinks",[])]: d["_egress"]=True
        if mj.get("secrets"): d["_secret"]=True
    # fan-in from import edges
    fanin={}
    for (dst,) in cur.execute("SELECT dst FROM edges WHERE kind='imports'"):
        l=dst.split(".")[-1].lstrip(".")
        if l in nodes: fanin[l]=fanin.get(l,0)+1
    con.close()
    for mod,d in nodes.items():
        if mod in GUARDS: d["score"]+=10; d["tags"].append("guard")
        if d["routes"]: d["score"]+=min(d["routes"],10); d["tags"].append("routes:%d"%d["routes"])
        if d["_egress"]: d["score"]+=5; d["tags"].append("egress")
        if d["_secret"]: d["score"]+=3; d["tags"].append("secret")
        if mod.startswith("plugin"): d["score"]+=3; d["tags"].append("plugin")
        d["fan_in"]=fanin.get(mod,0); d["score"]+=min(d["fan_in"],10)
        d.pop("_egress"); d.pop("_secret")
    ranked=sorted(nodes.items(),key=lambda kv:(-kv[1]["score"], kv[0]))
    return {"source":"knowledge_graph","modules":len(nodes),"top":[{"module":m,**d} for m,d in ranked[:top]]}

def selftest():
    ok=True
    g=build(sec.DEFAULT_WORK,20)
    print(("PASS" if g["modules"]>0 else "FAIL")+"  risk graph built (%d modules)"%g["modules"])
    ok=ok and g["modules"]>0
    top_names={t["module"] for t in g["top"]}
    guardy=any(t["module"] in GUARDS for t in g["top"])
    print(("PASS" if guardy else "WARN")+"  guard modules rank high (top: %s)"%sorted(top_names)[:3])
    print(("PASS" if all("score" in t for t in g["top"]) else "FAIL")+"  each node has a risk score")
    ok=ok and all("score" in t for t in g["top"])
    import os
    kg=os.environ.get("BD_KG_DB")
    if kg and os.path.exists(kg):
        gg=build_from_graph(kg,20)
        agree=gg["modules"]>0 and all("score" in t for t in gg["top"])
        # both sources should agree that a guard module is among the very top
        both_guardy=any(t["module"] in GUARDS for t in gg["top"])
        print(("PASS" if agree and both_guardy else "FAIL")+"  graph-delegated risk works (%d modules, guard-in-top=%s)"%(gg["modules"],both_guardy))
        ok=ok and agree
    else:
        print("  (skip graph-delegation check: set BD_KG_DB to a KNOWLEDGE_GRAPH.db)")
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--top",type=int,default=25)
    ap.add_argument("--graph",default=None,help="delegate to a KNOWLEDGE_GRAPH.db")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    g=build_from_graph(a.graph,a.top) if a.graph else build(a.work,a.top)
    if sec.emit(g,as_json=a.json): return 0
    print("risk graph: %d modules; highest-risk:"%g["modules"])
    for t in g["top"]:
        col=R if t["score"]>=15 else (Y if t["score"]>=8 else DIM)
        print("  %srisk %2d%s %-28s %s%s%s"%(col,t["score"],RST,t["module"],DIM,",".join(t["tags"]),RST))
    return 0
sys.exit(main())
