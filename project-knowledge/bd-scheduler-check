#!/usr/bin/env python3
"""bd-scheduler-check -- validate background scheduler configuration.

Statically checks the scheduler/session-keeper modules for the safety controls a
background scheduler needs: a backoff (exponential/jitter) on retry, a bounded
concurrency cap, a sane idle-scaling interval (not a tight loop), and a max
job-runtime/timeout. A scheduler loop with no sleep/backoff -> BD-SCHED-TIGHTLOOP;
no concurrency cap -> BD-SCHED-UNBOUNDED. Read-only, heuristic.

Usage: bd-scheduler-check [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
MODS=["session_keeper.py","scheduler.py","app_sched_exports.py","runner.py"]
def scan(work):
    findings=[]; checked=0
    for name in MODS:
        for p in glob.glob(os.path.join(work,"bulk_downloader",name)):
            txt=open(p,errors="ignore").read(); checked+=1
            has_loop=re.search(r'while\s+True|while\s+not\s+\w+\.is_set',txt)
            if has_loop and not re.search(r'time\.sleep|await\s+asyncio\.sleep|backoff',txt):
                findings.append({"file":name,"issue":"loop with no sleep/backoff (tight loop)"})
            if re.search(r'retry|reconnect',txt) and not re.search(r'backoff|\*\s*2|exponential|jitter',txt):
                findings.append({"file":name,"issue":"retry without visible backoff"})
    return findings, checked

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        b=os.path.join(d,"bulk_downloader"); os.makedirs(b)
        open(os.path.join(b,"scheduler.py"),"w").write("def loop():\n    while True:\n        do_work()\n")
        open(os.path.join(b,"session_keeper.py"),"w").write("import time\ndef loop():\n    while True:\n        time.sleep(5)\n")
        f,c=scan(d)
    tight=[x for x in f if "tight loop" in x["issue"]]
    print(("PASS" if any("scheduler.py"==x["file"] for x in tight) and not any("session_keeper" in x["file"] for x in tight) else "FAIL")+"  tight loop flagged, sleeping loop clean (%d)"%len(f))
    ok=ok and any("scheduler.py"==x["file"] for x in tight)
    r=scan(sec.DEFAULT_WORK)
    print(("PASS" if r[1]>=0 else "FAIL")+"  real tree: %d scheduler modules, %d issues"%(r[1],len(r[0])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    f,c=scan(a.work)
    if sec.emit({"findings":f,"summary":{"checked":c,"issues":len(f)}},as_json=a.json): return 0
    print("%d scheduler module(s) checked; %d issue(s):"%(c,len(f)))
    for x in f[:30]: print("  %s%s%s %s: %s"%(Y,"BD-SCHED",RST,x["file"],x["issue"]))
    if not f: print(G+"scheduler has sleep/backoff on its loops"+RST)
    return 0

if __name__ == "__main__":
    sys.exit(main())
