#!/usr/bin/env python3
"""bd-supply-chain-scan -- inspect vendored/offline dependencies.

Scans the offline pack zips + wheelhouse for supply-chain risks: duplicate
packages at DIFFERENT versions across packs (ambiguous which installs),
wheels/debs whose name-version can't be parsed, and suspicious files inside
packs (setup.py with exec, .pth files, scripts outside expected dirs). Records a
per-pack manifest with counts. Read-only.

Usage: bd-supply-chain-scan [--home DIR] [--json] [--selftest]
Exit 0 report-only (default) / 1 with --strict and a dup-version or
suspicious file exists / 2 CANNOT-EVALUATE. --strict makes supply-chain
risks gate.
"""
import argparse, glob, os, re, sys, zipfile
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
WHEEL=re.compile(r'^([A-Za-z0-9_.\-]+)-(\d[^-]*)-')
SUSPICIOUS=re.compile(r'\.pth$|/setup\.py$|/conftest\.py$|/\.\.?/')

def scan(home):
    pkgver={}  # name -> {version -> [packs]}
    suspicious=[]; packs={}
    for zp in glob.glob(os.path.join(home,"pack_*.zip")):
        name=os.path.basename(zp); packs[name]={"members":0,"wheels":0,"debs":0}
        try: z=zipfile.ZipFile(zp)
        # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
        except Exception: continue
        for n in z.namelist():
            packs[name]["members"]+=1
            base=os.path.basename(n)
            if base.endswith(".whl"):
                packs[name]["wheels"]+=1
                m=WHEEL.match(base)
                if m: pkgver.setdefault(m.group(1).lower().replace("_","-"),{}).setdefault(m.group(2),[]).append(name)
            elif base.endswith(".deb"):
                packs[name]["debs"]+=1
            if SUSPICIOUS.search(n):
                suspicious.append({"pack":name,"path":n})
    dup=[{"package":k,"versions":sorted(v)} for k,v in pkgver.items() if len(v)>1]
    return {"packs":packs,"duplicate_versions":dup,"suspicious":suspicious[:50],
            "unique_packages":len(pkgver)}

def selftest():
    ok=True
    # The live-home scan is ENVIRONMENT-DEPENDENT: the expansion packs are
    # consumed and dropped after install, so asserting they exist tests the
    # sandbox, not the tool. Skip explicitly, naming the requirement -- a SKIP
    # is never a pass. The synthetic fixture below is the gating control.
    r=scan("/home/claude")
    if not r["packs"]:
        print("SKIP: needs pack_*.zip in /home/claude (dropped after install)")
    else:
        total_wheels=sum(p["wheels"] for p in r["packs"].values())
        print("PASS  live scan: %d pack(s), %d wheels, %d unique packages, %d dup-version"%(len(r["packs"]),total_wheels,r["unique_packages"],len(r["duplicate_versions"])))
    # synthetic dup
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        for v in ("1.0","2.0"):
            zp=os.path.join(d,"pack_X%s.zip"%v)
            with zipfile.ZipFile(zp,"w") as z: z.writestr("wheels/foo-%s-py3-none-any.whl"%v,"x")
        # rename so both match pack_*.zip and carry same pkg different version
        os.rename(os.path.join(d,"pack_X1.0.zip"),os.path.join(d,"pack_A.zip"))
        os.rename(os.path.join(d,"pack_X2.0.zip"),os.path.join(d,"pack_B.zip"))
        s=scan(d)
    dup=[x["package"] for x in s["duplicate_versions"]]
    print(("PASS" if "foo" in dup else "FAIL")+"  duplicate-version package detected (%s)"%dup)
    ok=ok and "foo" in dup
    _clean={"duplicate_versions":[],"suspicious":[]}
    _dirty={"duplicate_versions":[{"package":"foo"}],"suspicious":[]}
    rcs=(_verdict_rc(_dirty,False),_verdict_rc(_clean,True),_verdict_rc(_dirty,True))
    print(("PASS" if rcs==(0,0,1) else "FAIL")+"  NEG: --strict + dup -> 1 (got %s)"%(rcs,))
    ok=ok and rcs==(0,0,1)
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def _verdict_rc(r, strict):
    """0 report-only; 1 if --strict and any dup-version or suspicious file."""
    if not strict:
        return 0
    bad = len(r["duplicate_versions"]) + len(r["suspicious"])
    if bad:
        sys.stderr.write("supply-chain risks under --strict: %d dup-version, "
                         "%d suspicious\n"
                         % (len(r["duplicate_versions"]), len(r["suspicious"])))
        return 1
    return 0


def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--strict",action="store_true",help="exit 1 on any dup-version or suspicious file")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_bundle(a.home)
    r=scan(a.home)
    if sec.emit({**r,"summary":{"packs":len(r["packs"]),"unique_packages":r["unique_packages"],"dup_versions":len(r["duplicate_versions"]),"suspicious":len(r["suspicious"])}},as_json=a.json): return _verdict_rc(r,a.strict)
    print("%d pack(s), %d unique packages:"%(len(r["packs"]),r["unique_packages"]))
    for name,p in sorted(r["packs"].items()):
        print("  %s%s%s %d members (%d wheels, %d debs)"%(DIM,name,RST,p["members"],p["wheels"],p["debs"]))
    for d in r["duplicate_versions"][:20]: print("  %sDUP-VERSION%s %s: %s"%(Y,RST,d["package"],d["versions"]))
    for s in r["suspicious"][:10]: print("  %ssuspicious%s %s/%s"%(Y,RST,s["pack"],s["path"]))
    if not r["duplicate_versions"] and not r["suspicious"]: print(G+"no dup-version or suspicious files"+RST)
    return _verdict_rc(r,a.strict)
sys.exit(main())
