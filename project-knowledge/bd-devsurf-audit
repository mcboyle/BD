#!/usr/bin/env python3
"""bd-devsurf-audit -- audit dev/cockpit exposed surfaces.

Enumerates dev-surface endpoints (/api/dev/*, /cockpit/api/*, dev_suite) and
reports, per surface: is it default-off or default-on, what env unlock / kill-
switch gates it, whether a dev-mode guard is referenced, and whether it is a
mutating route (CSRF-relevant). Cross-references the real gate
(dev_tools.is_dev_mode + BD_DEV_MODE_DISABLE kill-switch). Advisory, read-only.

Usage: bd-devsurf-audit [--work DIR] [--json] [--selftest]
Exit 0 (advisory).
"""
import argparse
import os
import re
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

DEV_PREFIXES = ("/api/dev/", "/cockpit/api/", "/api/cockpit/")
KILL_SWITCH = re.compile(r'BD_DEV_MODE_DISABLE')
DEFAULT_ON = re.compile(r'default[-_ ]?on|always[-_ ]?on|return True\s*$', re.M)


def gate_facts(work):
    """Read dev_tools.is_dev_mode to learn the default posture + kill-switch."""
    facts = {"default_on": None, "kill_switch": None, "env_unlock": []}
    for _p, rel, txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        if "def is_dev_mode" not in txt:
            continue
        facts["kill_switch"] = bool(KILL_SWITCH.search(txt))
        body = txt.split("def is_dev_mode", 1)[1]
        # bound to the function: up to the next top-level def/class
        nxt = re.search(r'\n(?:def |class )', body)
        body = body[:nxt.start()] if nxt else body
        # default posture = the fall-through return (last return in the body)
        returns = re.findall(r'return\s+(True|False)', body)
        facts["default_on"] = (returns[-1] == "True") if returns else None
        facts["env_unlock"] = sorted(set(re.findall(r'BD_[A-Z_]+', txt)))
        break
    return facts


def audit(work):
    cat = sec.parse_endpoint_catalog(work)
    rows = []
    for r in cat:
        if not any(r["path"].startswith(p) for p in DEV_PREFIXES):
            continue
        rows.append({"method": r["method"], "path": r["path"],
                     "mutating": r["method"] in sec.MUTATING,
                     "csrf": r["csrf"], "desc": r["desc"]})
    rows.sort(key=lambda x: (not x["mutating"], x["path"]))
    return rows, gate_facts(work)


def selftest():
    ok = True
    fake_cat = ("```\n"
                "GET     /api/dev/logs            CSRF: no   - dev logs\n"
                "POST    /api/dev/run             CSRF: yes  - run tests\n"
                "POST    /cockpit/api/queue       CSRF: no   - queue write\n"
                "GET     /api/activity/v2         CSRF: no   - not a dev route\n"
                "```\n")
    fake_gate = ('import os\n'
                 'def is_dev_mode():\n'
                 '    if os.environ.get("BD_DEV_MODE_DISABLE") == "1":\n'
                 '        return False\n'
                 '    return True\n')
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bulk_downloader")
        os.makedirs(b)
        open(os.path.join(d, "ENDPOINT_CATALOG.md"), "w").write(fake_cat)
        open(os.path.join(b, "dev_tools.py"), "w").write(fake_gate)
        rows, gate = audit(d)
    paths = sorted(r["path"] for r in rows)
    good = (paths == ["/api/dev/logs", "/api/dev/run", "/cockpit/api/queue"]
            and gate["default_on"] is True and gate["kill_switch"] is True
            and "BD_DEV_MODE_DISABLE" in gate["env_unlock"])
    print(("PASS" if good else "FAIL") +
          f"  fixture: 3 dev routes, default-on+killswitch (paths={paths}, gate={gate})")
    ok &= good
    rows, gate = audit(sec.DEFAULT_WORK)
    real = len(rows) > 0 and gate["default_on"] is not None
    print(("PASS" if real else "FAIL") +
          f"  real tree: {len(rows)} dev routes, default_on={gate['default_on']}, "
          f"kill_switch={gate['kill_switch']}")
    ok &= real
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", "--tree", default=sec.DEFAULT_WORK)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    rows, gate = audit(a.work)
    mut = sum(1 for r in rows if r["mutating"])
    if sec.emit({"gate": gate, "surfaces": rows,
                 "summary": {"dev_surfaces": len(rows), "mutating": mut}}, as_json=a.json):
        return 0
    posture = (R + "DEFAULT-ON" + RST) if gate["default_on"] else (G + "default-off" + RST)
    ks = (G + "kill-switch present" + RST) if gate["kill_switch"] else (R + "NO kill-switch" + RST)
    print(f"dev-mode gate: {posture}, {ks}  {DIM}(unlocks: {', '.join(gate['env_unlock'])}){RST}")
    for r in rows[:60]:
        m = Y + "MUT " + RST if r["mutating"] else DIM + "read" + RST
        c = "csrf" if r["csrf"] else DIM + "no-csrf" + RST
        print(f"  {m} {c:<8} {r['method']:<6} {r['path']}")
    print(f"{DIM}{len(rows)} dev/cockpit surface(s), {mut} mutating{RST}")
    return 0


sys.exit(main())
