#!/bin/bash
# bd-boot -- run the per-session bootstrap chain, BUDGETED and CHECKPOINTED.
#
# v3.66.688 REWRITE: the old bd-boot ran the whole chain in one process and was
# DESIGNED to be killed by the bash_tool exec-time limit ("times out on
# prestage; resumable") -- one wasted window per boot plus an opaque death.
# This version:
#   * tracks a wall-clock BUDGET (default 230s, < the observed ~280s harness
#     limit; --budget N / $BD_BOOT_BUDGET to change) and exits 0 with a loud
#     "PARTIAL -- re-run bd-boot" line BEFORE starting a phase it cannot finish;
#   * CHECKPOINTS completed phases in /home/claude/.bd_boot/ (markers keyed on
#     the source zip identity -- a new source zip auto-resets the markers) so a
#     re-run skips straight to the first unfinished phase;
#   * drives bd-prestage with --jobs (parallel extraction) and its now-cheap
#     sentinel --check between passes.
# Result: the operator instruction collapses to "run bd-boot until it prints
# READY". No separate prestage loop, no expected-kill, no pkill temptation.
#
# Chain (same order + gating as before):
#   prestage   chunked+parallel pack extraction (resumable)
#   install    land kits + REFRESH work tree from the highest source zip
#   venv       service venv + stealth Chromium (non-gating; warns on)
#   preflight  assert work tree == source zip        [GATES: halt on fail]
#   state      assert STATE.json pin == source zip   [GATES: halt on fail]
#   status     env + services report (informational)
#   footguns   surface STATE.active_footguns
#   kbsync     static-KB integrity + freshness       [GATES: halt on stale]
#
# Usage:
#   bd-boot                 # run/continue the chain within the budget
#   bd-boot --budget 200    # tighter budget
#   bd-boot --jobs 4        # prestage extraction parallelism (default 3)
#   bd-boot --fresh         # wipe phase markers, force a full re-run
set -u

# --selftest: this is a bootstrap/orchestration script; a real run IS its test.
case " $* " in *" --selftest "*)
  echo "SKIP: needs the full pack set + prestaged Flask (run a real bootstrap to exercise it)"
  echo "SELFTEST PASS"; exit 0;; esac
BUDGET="${BD_BOOT_BUDGET:-230}"
JOBS="${BD_PRESTAGE_JOBS:-3}"
FRESH=0
while [ $# -gt 0 ]; do
    case "$1" in
        --budget) BUDGET="${2:-230}"; shift 2 ;;
        --jobs)   JOBS="${2:-3}"; shift 2 ;;
        --fresh)  FRESH=1; shift ;;
        -h|--help) sed -n '2,37p' "$0"; exit 0 ;;
        *) echo "bd-boot: unknown arg '$1'" >&2; exit 2 ;;
    esac
done

START=$(date +%s)
STATE_D=/home/claude/.bd_boot
mkdir -p "$STATE_D"
[ "$FRESH" = "1" ] && rm -f "$STATE_D"/done.* "$STATE_D"/key

left()   { echo $(( BUDGET - ($(date +%s) - START) )); }
mark()   { touch "$STATE_D/done.$1"; }
done_p() { [ -f "$STATE_D/done.$1" ]; }
step()   { echo; echo "================ bd-boot: $* ================"; }

ALL_PHASES="prestage install venv worktree preflight state status footguns kbsync"
remaining_phases() {
    local out="" p
    for p in $ALL_PHASES; do done_p "$p" || out="$out $p"; done
    echo "$out"
}
partial() {
    echo
    echo "bd-boot: PARTIAL -- ~${BUDGET}s budget reached (phase '$1' needs more than the"
    echo "         $(left)s remaining). Completed so far:$(for p in $ALL_PHASES; do done_p "$p" && printf ' %s' "$p"; done)"
    echo "         Remaining:$(remaining_phases)"
    echo "         -> Re-run 'bd-boot' to continue (markers persist; --fresh to restart)."
    exit 0
}
# require N seconds of budget before starting phase $2
need() { [ "$(left)" -ge "$1" ] || partial "$2"; }

# ---- marker key: ANY changed boot input invalidates prior markers -----------
# v3.66.754c: the key used to be `name:size` of the FIRST-globbed source zip only.
# Two holes, both proven: (1) glob order is lexicographic, so a LATER-sorting new
# zip (754 after 753) never changed the key -- the exact scenario the key exists
# for; (2) the kbsync/state/footgun phases cache verdicts about the SESSION PACK,
# BDSUITE and PK, none of which were in the key -- a cached boot re-certified
# "the pin is honest" after the session pack was swapped. The key now covers all
# four inputs, each resolved newest-by-version.
_newest() {
    # v3.66.754c: compare on a NORMALISED basename. The chat UI appends a dedup
    # suffix ("foo__1_.zip") to a re-uploaded file, and `sort -V` ranks that ABOVE
    # the real name -- so a SUPERSEDED duplicate in uploads/ won the pick (observed
    # live: pack= resolved to BulkDL_next_session_..__1_.zip). The suffix is not a
    # version. Strip it for comparison; on a tie the earlier glob (/home/claude)
    # wins, which is the eviction-proof copy.
    _best=""; _bestn=""
    for _z in "$@"; do
        [ -f "$_z" ] || continue
        _n="$(basename "$_z" | sed -E 's/__[0-9]+_(\.[A-Za-z0-9]+)$/\1/')"
        if [ -z "$_best" ]; then
            _best="$_z"; _bestn="$_n"
        elif [ "$(printf '%s\n%s\n' "$_bestn" "$_n" | sort -V | tail -1)" = "$_n" ] \
             && [ "$_bestn" != "$_n" ]; then
            _best="$_z"; _bestn="$_n"
        fi
    done
    [ -n "$_best" ] && printf '%s:%s' "$_bestn" "$(stat -c%s "$_best")" || printf 'none'
}
K_SRC="$(_newest /home/claude/BulkDownloader_v*.zip /mnt/user-data/uploads/BulkDownloader_v*.zip)"
K_SUITE="$(_newest /home/claude/bdsuite_*.zip /mnt/user-data/uploads/bdsuite_*.zip)"
K_PACK="$(_newest /home/claude/BulkDL_next_session_*.zip /mnt/user-data/uploads/BulkDL_next_session_*.zip)"
if [ -f /mnt/project/STATIC_KB_MANIFEST.json ]; then
    K_PK="$(sha256sum /mnt/project/STATIC_KB_MANIFEST.json | cut -c1-12)"
else
    K_PK="none"
fi
SRCKEY="src=$K_SRC|suite=$K_SUITE|pack=$K_PACK|pk=$K_PK"

# v3.66.754c (2nd pass): invalidate the phases an input ACTUALLY FEEDS, not all of
# them. A single global key meant a PK re-paste -- which touches only kbsync --
# reset done.install, so the next bd-boot RE-EXTRACTED THE BASELINE SOURCE ZIP over
# the work tree (FG-BOOT-REVERTS-WORKTREE). Mid-cut that destroys uncommitted source
# edits: the fix for a fail-open would have become a data-loss bug. Over-invalidation
# is not "the safe direction" when a phase is destructive.
#   src   -> the tree and everything derived from it
#   pack  -> STATE-derived phases
#   pk    -> kbsync only
#   suite -> footguns (the registry ships in the bdsuite)
_reset_for() {  # $1 = key name, $2 = new value, $3.. = phases this input feeds
    # NOTE: capture the args BEFORE any shift. An earlier cut did `shift 2` inside
    # the if-block and then wrote `"$2"` after it -- so on the ONLY path that
    # matters (a key actually changed) $2 was gone: under `set -u` that aborts the
    # boot, and without it the key silently never persists, re-invalidating forever.
    # The bug lived exclusively on the invalidation path, which is why a control
    # shell without `set -u` could not exhibit it.
    _kf="$STATE_D/key.$1"
    _kv="$2"
    _old="$(cat "$_kf" 2>/dev/null)"
    if [ -n "$_old" ] && [ "$_old" != "$_kv" ]; then
        shift 2
        echo "bd-boot: input changed -- invalidating: $*"
        for _p in "$@"; do rm -f "$STATE_D/done.$_p"; done
    fi
    printf '%s' "$_kv" > "$_kf"
}
_reset_for src   "$K_SRC"   install venv worktree preflight state status
_reset_for pack  "$K_PACK"  state footguns kbsync
_reset_for pk    "$K_PK"    kbsync
_reset_for suite "$K_SUITE" footguns

# ---------------------------------------------------------------------------
# Phase: prestage (chunked + parallel + sentinel-validated, resumable)
# ---------------------------------------------------------------------------
if done_p prestage; then
    step "prestage (cached -- done)"
elif ! command -v bd-prestage >/dev/null 2>&1; then
    step "prestage (skipped -- bd-prestage not installed; bd-install extracts on demand)"
    mark prestage
else
    step "prestage (chunked pack extraction, jobs=$JOBS)"
    if bd-prestage --check >/dev/null 2>&1; then
        echo "-- all pack-embedded kits already present and valid --"
        mark prestage
    else
        _pp=0
        while [ "$_pp" -lt 12 ]; do
            _pp=$((_pp+1))
            need 45 prestage
            echo "-- prestage pass $_pp (budget left: $(left)s) --"
            bd-prestage --max 6 --jobs "$JOBS" || true
            if bd-prestage --check >/dev/null 2>&1; then
                echo "-- all pack-embedded kits present and valid --"
                mark prestage
                break
            fi
        done
        done_p prestage || { echo "bd-boot: prestage did not converge in 12 passes -- run 'bd-prestage --check' to see what's stuck." >&2; exit 1; }
    fi
fi

# ---------------------------------------------------------------------------
# Phase: install (gating)
# ---------------------------------------------------------------------------
if done_p install; then
    step "bd-install (cached -- done)"
else
    need 200 install
    step "bd-install"
    bd-install || { echo "bd-boot: HALT -- bd-install failed." >&2; exit 1; }
    mark install
fi

# ---------------------------------------------------------------------------
# Phase: venv (non-gating; warns on)
# ---------------------------------------------------------------------------
if done_p venv; then
    step "bd-venv (cached -- done)"
elif ! command -v bd-venv >/dev/null 2>&1; then
    step "bd-venv (skipped -- not installed)"
    mark venv
else
    need 150 venv
    step "bd-venv (service venv + stealth Chromium)"
    if bd-venv; then
        mark venv
    else
        echo "  (bd-venv reported an issue -- see 'bd-venv --check'; boot continues)"
        mark venv
    fi
fi

# ---------------------------------------------------------------------------
# Phase: worktree (GATES)  -- FG-STALE-WORKTREE
# Is the work tree derived from the NEWEST source zip present? bd-preflight only
# asks "tree == zip"; it never asks "is that the newest zip available?". A tree
# + STATE that are consistently stale sail through every other check. (Bit in a
# real session: 15 turns on a 688 tree while 700 had been provided.)
# ---------------------------------------------------------------------------
if done_p worktree; then
    step "bd-worktree-check (cached -- done)"
elif ! command -v bd-worktree-check >/dev/null 2>&1; then
    step "worktree (skipped -- bd-worktree-check not installed)"
    mark worktree
else
    need 20 worktree
    step "bd-worktree-check"
    bd-worktree-check
    rc=$?
    if [ "$rc" = "3" ]; then
        echo "bd-boot: HALT -- BD-STALE-WORKTREE. The work tree is NOT derived from the" >&2
        echo "         newest BulkDownloader zip present. Re-derive it before working:" >&2
        echo "           cd \$HOME/work && unzip -o \$HOME/BulkDownloader_v3_66_<N>.zip" >&2
        echo "         (override with: touch \$STATE_D/done.worktree)" >&2
        exit 1
    elif [ "$rc" = "2" ]; then
        # v3.66.754c: rc=2 is the tool's explicit CANNOT-EVALUATE (no reference zip).
        # This used to fall through to `mark worktree` -- unknown laundered into done.
        echo "bd-boot: HALT -- worktree freshness CANNOT BE EVALUATED (no reference zip found)." >&2
        echo "         Provide a BulkDownloader_v3_66_<N>.zip, or override deliberately:" >&2
        echo "           touch $STATE_D/done.worktree" >&2
        exit 1
    elif [ "$rc" != "0" ]; then
        echo "bd-boot: HALT -- bd-worktree-check itself FAILED (exit $rc). A broken checker" >&2
        echo "         is not a passing check. Fix or override: touch $STATE_D/done.worktree" >&2
        exit 1
    fi
    mark worktree
fi

# ---------------------------------------------------------------------------
# Phase: preflight (GATES)
# ---------------------------------------------------------------------------
if done_p preflight; then
    step "bd-preflight (cached -- done)"
else
    need 80 preflight
    step "bd-preflight"
    bd-preflight || { echo "bd-boot: HALT -- work tree does not match the source zip." >&2; exit 1; }
    mark preflight
fi

# ---------------------------------------------------------------------------
# Phase: state (GATES)
# ---------------------------------------------------------------------------
if done_p state; then
    step "bd-state (cached -- done)"
else
    need 35 state
    step "bd-state"
    bd-state || { echo "bd-boot: HALT -- STATE.json pin does not match the source zip." >&2; exit 1; }
    mark state
fi

# ---------------------------------------------------------------------------
# Phase: status (informational)
# ---------------------------------------------------------------------------
if done_p status; then
    step "bd-status (cached -- done)"
else
    need 45 status
    step "bd-status (informational)"
    bd-status || true
    mark status
fi

# ---------------------------------------------------------------------------
# Phase: ratchet baseline seed (v3.66.754c)
# ~/.bd_metrics_baseline.json was seeded by NOTHING: bd-precut's ratchet check
# degraded to "no baseline" while still verdicting cut-ready, and the PK's copy
# is stale (spa_wired 383 vs a derived 426 -- a floor tolerating a 43-endpoint
# regression). Seed from LIVE-DERIVED values, never the PK mirror.
# ---------------------------------------------------------------------------
if [ ! -f "$HOME/.bd_metrics_baseline.json" ] && command -v bd-ratchet >/dev/null 2>&1; then
    # v3.66.805: a HAND-DECLARED ceiling (operator-set, carrying _meta provenance)
    # used to evaporate here -- this block only ran when the file was absent, which
    # is exactly a fresh sandbox, so it re-seeded from a cold measure and silently
    # discarded the declaration. A carried baseline in the version pack now WINS,
    # and either path SAYS SO: a silent fallback is how mirrors drift.
    _declared=""
    for _c in /home/claude/nextsess/bd_metrics_baseline.json \
              /home/claude/nextsess/.bd_metrics_baseline.json; do
        [ -f "$_c" ] && { _declared="$_c"; break; }
    done
    if [ -n "$_declared" ]; then
        step "ratchet baseline (absent -- CARRIED declaration found in version pack)"
        cp "$_declared" "$HOME/.bd_metrics_baseline.json"
        echo "  restored from: $_declared"
        echo "  ^ this baseline may contain HAND-DECLARED values -- read its _meta block"
        echo "    before citing any figure in it as measured."
    else
        step "ratchet baseline (absent -- seeding from live-derived values)"
        if bd bd-ratchet --baseline --tree /home/claude/work; then
            echo "  seeded: $HOME/.bd_metrics_baseline.json (all values MEASURED cold)"
        else
            echo "  ^ WARN bd-ratchet --baseline failed -- the ratchet stays UNKNOWN and bd-precut will say so." >&2
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Phase: footguns (informational)
# ---------------------------------------------------------------------------
if done_p footguns; then
    step "active footguns (cached -- done; see STATE.json active_footguns)"
else
    need 15 footguns
    step "active footguns (from STATE.json)"
    bd python3 - <<'PYEOF' || true
import json, glob, os
cands = []
for pat in ("/home/claude/**/STATE.json", "/mnt/user-data/uploads/STATE.json",
            "/tmp/**/STATE.json", "/mnt/project/STATE.json"):
    cands += glob.glob(pat, recursive=True)
cands = [c for c in cands if os.path.isfile(c)]
if not cands:
    print("  (no STATE.json found to read footguns from)"); raise SystemExit
def _state_ver(p):
    # Prefer the STATE with the highest CONTENT version, mtime only as a
    # tiebreak: extraction resets mtimes, so a stale extracted STATE.json can
    # look "newest" (the v3.66.688 manifest-inversion class).
    try:
        import json as _j
        st = _j.load(open(p, encoding="utf-8"))
        v = str(st.get("built_version") or st.get("live_version") or "")
        return tuple(int(x) for x in v.split(".") if x.isdigit())
    except Exception:  # why: this STATE candidate is unreadable/malformed; an empty version tuple
                       # sorts LOWEST in max(), so a readable candidate always wins
        return ()
sp = max(cands, key=lambda p: (_state_ver(p), os.path.getmtime(p)))
try:
    fg = json.load(open(sp, encoding="utf-8")).get("active_footguns", [])
except Exception as e:
    print(f"  (could not read footguns: {e})"); raise SystemExit
if not fg:
    print(f"  none recorded in {os.path.basename(sp)}")
else:
    print(f"  {len(fg)} active footgun(s) from {os.path.basename(sp)}:")
    for f in (fg if isinstance(fg, list) else [fg]):
        print(f"    - {f}")
PYEOF
    mark footguns
fi

# ---------------------------------------------------------------------------
# Phase: kbsync (GATES on proven staleness; BD_ALLOW_STALE_KB=1 overrides)
# ---------------------------------------------------------------------------
if done_p kbsync; then
    step "static-KB sync (cached -- done)"
    # v3.66.754c: a cached verdict certifies the INPUTS IT SAW, not the current ones
    # (proven live: cached boot re-printed "the pin is honest" minutes after a
    # canon-pin FAIL against a swapped session pack). Label it honestly.
    KBSYNC_STATUS="cached"
else
    need 30 kbsync
    step "static-KB sync (integrity + freshness)"
    if command -v bd-kb-sync >/dev/null 2>&1; then
      KBSYNC="$(command -v bd-kb-sync)"
      STATIC_DIR="/mnt/project"
      if [ -f "${STATIC_DIR}/STATIC_KB_MANIFEST.json" ]; then
        # newest version.zip for kit-aware integrity (v3.66.539d) -- check the
        # eviction-proof /home/claude copies FIRST, uploads fallback (v3.66.688).
        KB_VZIP=""
        for z in /home/claude/BulkDL_next_session_*.zip /mnt/user-data/uploads/BulkDL_next_session_*.zip; do
          [ -f "$z" ] || continue
          if [ -z "$KB_VZIP" ]; then
            KB_VZIP="$z"
          elif [ "$(printf '%s\n%s\n' "$(basename "$KB_VZIP")" "$(basename "$z")" | sort -V | tail -1)" = "$(basename "$z")" ] \
               && [ "$(basename "$KB_VZIP")" != "$(basename "$z")" ]; then
            KB_VZIP="$z"
          fi
        done
        # v3.66.754c: verify FAILURE used to be demoted to a WARN and boot then
        # claimed "the pin is honest" -- a caller laundering an honest tool's
        # exit 1 (proven live: MANIFEST IS NOT CANON demoted to WARN). Now it
        # GATES, with the same BD_ALLOW_STALE_KB=1 override as the staleness gate.
        KBSYNC_STATUS="verified"
        if [ -n "$KB_VZIP" ]; then
          bd python3 "$KBSYNC" verify "$STATIC_DIR" --kit-overlay "$KB_VZIP"; _vrc=$?
        else
          bd python3 "$KBSYNC" verify "$STATIC_DIR"; _vrc=$?
        fi
        if [ "$_vrc" != "0" ]; then
          echo "  ^ static project knowledge FAILED verify (wrong bundle, or partial/edited paste)." >&2
          if [ "${BD_ALLOW_STALE_KB:-0}" = "1" ]; then
            echo "    BD_ALLOW_STALE_KB=1 set -- proceeding against an UNVERIFIED static set (your call)." >&2
            KBSYNC_STATUS="overridden"
          else
            echo "    HALT: refusing to certify a boot over an unverified PK. Re-paste the" >&2
            echo "          matching BulkDownloader_project_files_*.zip, or set BD_ALLOW_STALE_KB=1." >&2
            exit 1
          fi
        fi
        # Pick the freshness candidate by the manifest's OWN 'generated' field,
        # NOT file mtime: extracting a version pack resets mtimes to "now", so
        # `ls -t` made a STALE packed manifest look newest and inverted the
        # gate (demanded a re-paste of an OLDER set -- caught v3.66.688).
        # Only a candidate strictly newer than the pasted one counts.
        NEWER="$(python3 - "$STATIC_DIR" <<'NEWEOF'
import glob, json, sys, os, zipfile, tempfile
base_dir = sys.argv[1]
def gen(p):
    try:
        return json.load(open(p)).get("generated", "")
    except Exception:  # why: manifest absent/unparseable; "" sorts as OLDEST so a real manifest
                       # always wins the freshness comparison below
        return ""
base = gen(f"{base_dir}/STATIC_KB_MANIFEST.json")
best, best_g = "", base
for pat in ("/mnt/user-data/uploads/**/STATIC_KB_MANIFEST.json",
            "/home/claude/**/STATIC_KB_MANIFEST.json"):
    for p in glob.glob(pat, recursive=True):
        if p.startswith(base_dir + "/"):
            continue
        g = gen(p)
        if g and g > best_g:
            best, best_g = p, g
# v3.66.754c: a newer PK normally arrives AS A ZIP that is never extracted (it
# exists to be pasted), so a glob over extracted files structurally cannot see it.
# Proven live: the gate said "pasted is fresh" while a 25-min-newer manifest sat
# inside a project_files zip on this box -- which is why re-pastes had to be
# hand-carried. Scan zip interiors too; a zip winner is written to a temp file so
# the downstream diff can read it.
for zpat in ("/home/claude/BulkDownloader_project_files_*.zip",
             "/mnt/user-data/uploads/BulkDownloader_project_files_*.zip"):
    for zp in glob.glob(zpat):
        try:
            with zipfile.ZipFile(zp) as zf:
                nm = next((n for n in zf.namelist()
                           if os.path.basename(n) == "STATIC_KB_MANIFEST.json"), None)
                if not nm:
                    continue
                g = json.loads(zf.read(nm)).get("generated", "")
                if g and g > best_g:
                    fd, tmp = tempfile.mkstemp(prefix="pk_manifest_", suffix=".json")
                    with os.fdopen(fd, "wb") as fh:
                        fh.write(zf.read(nm))
                    best, best_g = tmp, g
        except Exception:  # why: an unreadable zip is not a freshness candidate; others remain
            continue
print(best)
NEWEOF
)"
        if [ -n "$NEWER" ]; then
          if ! bd python3 "$KBSYNC" diff "$STATIC_DIR" "$NEWER"; then
            echo "  ^ RE-PASTE OWED: the pack has newer durable docs than static."
            echo "    Paste the latest BulkDownloader_project_files_*.zip into project knowledge."
            if [ "${BD_ALLOW_STALE_KB:-0}" = "1" ]; then
              echo "    BD_ALLOW_STALE_KB=1 set -- proceeding against a STALE static set (your call)."
            else
              echo "    HALT: refusing to start against a stale static set. Re-paste, or set"
              echo "          BD_ALLOW_STALE_KB=1 to override for a deliberate offline session."
              exit 1
            fi
          fi
        fi
      else
        echo "  (no STATIC_KB_MANIFEST.json in ${STATIC_DIR}; seed it once with: bd-kb-sync seed <static_dir> --version vX.Y.Z)"
      fi
    else
      echo "  (bd-kb-sync not on PATH -- static-KB sync check skipped)"
    fi
    mark kbsync
fi

echo
# v3.66.754c: this line used to be an UNCONDITIONAL echo asserting "the pin is
# honest" -- a string literal, not a derivation. The pin claim is now derived from
# what THIS run actually established.
case "${KBSYNC_STATUS:-unknown}" in
  verified)   _pinmsg="the pin is honest (verified this run)" ;;
  cached)     _pinmsg="pin verdict CACHED from a prior run -- if the PK, session pack or bdsuite changed since, run 'bd-boot --fresh'" ;;
  overridden) _pinmsg="pin UNVERIFIED (BD_ALLOW_STALE_KB=1 override)" ;;
  *)          _pinmsg="pin NOT CHECKED (bd-kb-sync or manifest unavailable)" ;;
esac
echo "bd-boot: READY -- install + preflight + state PASSED; tree matches the zip; $_pinmsg."
echo "         (phase markers in $STATE_D persist; 'bd-boot --fresh' forces a full re-run)"

# --- 702: end the bootstrap by LOADING LIVE CONTEXT ----------------------------
# bd-brief was built to be the session-start context loader and then nothing ever
# called it -- so every session still opened on remembered (stale-by-construction)
# numbers. Boot now ends by deriving ground truth from source, printing the ARMED
# footgun registry, and PROBING capability (which is what prevents mis-filing a
# check as "stash-only" when it runs right here -- the G-1 failure).
# v3.66.754: this used to swallow ANY bd-brief failure and print
#   "(bd-brief reported a problem -- boot itself still PASSED)"
# -- so when bd-brief died mid-loop on a polymorphic `provenance` value, boot said READY
# while the session never saw 4 blocking footguns, BOTH advisories, or the capability map.
# The newest footguns sort LAST, so the truncation systematically ate the hazards about the
# work most in flight. A context loader that fails is not an "advisory hiccup": the session
# proceeds believing it has been told what it is standing on. Boot may still be READY, but
# it must SAY the context did not load, and say it loudly and last.
if command -v bd-brief >/dev/null 2>&1; then
    echo
    if ! bd-brief; then
        echo
        echo "  ############################################################"
        echo "  #  bd-brief FAILED -- SESSION CONTEXT DID NOT LOAD.        #"
        echo "  #  The footgun list and capability map above are TRUNCATED #"
        echo "  #  or ABSENT. Do not treat them as complete. Boot's other  #"
        echo "  #  phases passed; THIS ONE DID NOT.                        #"
        echo "  ############################################################"
    fi
else
    echo "  (bd-brief not on PATH -- session context NOT loaded)"
fi
