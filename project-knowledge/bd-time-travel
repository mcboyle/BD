#!/usr/bin/env python3
"""bd-time-travel -- reconstruct available project state for a version.

For a target version (e.g. 688), locates and cross-references the artifacts that
capture that version's state: the source zip, the session/next-session pack,
audit_state, bdsuite, and the CHANGELOG entry. Reports which artifacts are
present for that version and reads the version's guard shas + validation from
the session pack's STATE if present. The "what do I have to rebuild version X"
inventory. Read-only.

Usage: bd-time-travel [--version N] [--home DIR] [--json] [--selftest]
Exit 0 reconstruction produced / 2 CANNOT-EVALUATE (no version derivable). Informational.
"""
import argparse, glob, json, os, re, sys, zipfile
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
ARTIFACTS={"source":"BulkDownloader_v3_66_%s.zip","session":"BulkDL_next_session_v3_66_%s.zip",
           "audit_state":"audit_state_v3_66_%s.zip","bdsuite":"bdsuite_v3_66_%s.zip",
           "cloak":"bd_cloak_pack_v3_66_%s.zip"}

def reconstruct(home, version):
    found={}
    for role,pat in ARTIFACTS.items():
        p=os.path.join(home,pat%version)
        found[role]={"present":os.path.exists(p),"file":os.path.basename(p),
                     "size":os.path.getsize(p) if os.path.exists(p) else 0}
    # STATE from session pack
    state=None
    sp=os.path.join(home,ARTIFACTS["session"]%version)
    if os.path.exists(sp):
        try:
            with zipfile.ZipFile(sp) as z:
                for n in z.namelist():
                    if n.endswith("STATE.json"): state=json.loads(z.read(n)); break
        # why: handled failure is non-fatal; proceed with the value left unset
        except Exception: pass
    st_summary=None
    if state:
        st_summary={"version":state.get("built_version") or state.get("live_version"),
                    "guards":len(state.get("guards_full_sha256",{})),
                    "validation":str(state.get("validation") or "")[:100]}
    present=sum(1 for v in found.values() if v["present"])
    return {"version":version,"artifacts":found,"present":present,"total":len(found),
            "reconstructable":found["source"]["present"] and found["session"]["present"],
            "state":st_summary}

def _current_cut():
    """The cut number the SOURCE TREE declares (e.g. '728'). Refuses if absent --
    pinning a literal here is what made this selftest fail at every release."""
    v = sec.detect_tree_version(sec.DEFAULT_WORK)
    if not v:
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=ABSENT "
                         "(work tree declares no __version__)\n")
        sys.exit(2)
    return v.split(".")[-1]


def selftest():
    ok=True
    cut=_current_cut()
    r=reconstruct("/home/claude",cut)
    print(("PASS" if r["present"]>=1 else "FAIL")+"  v%s artifacts located (%d/%d)"%(cut,r["present"],r["total"]))
    ok=ok and r["present"]>=1
    print(("PASS" if r["state"] else "WARN")+"  STATE read from session pack (%s)"%(r["state"]["version"] if r["state"] else None))
    r2=reconstruct("/home/claude","99999")
    print(("PASS" if r2["present"]==0 else "FAIL")+"  nonexistent version -> 0 artifacts")
    ok=ok and r2["present"]==0
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--version",default=(sec.detect_tree_version(sec.DEFAULT_WORK) or "").split(".")[-1] or None); ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_bundle(a.home)
    r=reconstruct(a.home,a.version)
    if sec.emit(r,as_json=a.json): return 0
    tag=(G+"reconstructable"+RST) if r["reconstructable"] else (Y+"partial"+RST)
    print("version %s: %s (%d/%d artifacts)"%(r["version"],tag,r["present"],r["total"]))
    for role,d in r["artifacts"].items():
        mark=(G+"OK"+RST) if d["present"] else (R+"--"+RST)
        print("  %s %-11s %s"%(mark,role,d["file"]))
    if r["state"]: print("  %sSTATE: v%s, %d guards; %s%s"%(DIM,r["state"]["version"],r["state"]["guards"],r["state"]["validation"],RST))
    return 0
sys.exit(main())
