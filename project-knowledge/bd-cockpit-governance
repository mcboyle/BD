#!/usr/bin/env python3
"""bd-cockpit-governance -- verify Cockpit stays governance/review-focused. Flags risky RUNTIME controls (start/stop/delete/exec/kill actions) creeping into Cockpit/governance components. Advisory, read-only. Usage: bd-cockpit-governance [--work DIR] [--json] [--selftest]"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
TARGET_GLOB=["frontend/src/**/*ockpit*.tsx","frontend/src/**/*overnance*.tsx"]
FORBIDDEN=[("runtime-control-in-cockpit", r"onClick=\{[^}]*\b(?:start|stop|kill|delete|purge|exec)")]
LABEL="Cockpit governance"

def scan(work):
    findings=[]; checked=0
    for pat in TARGET_GLOB:
        for f in glob.glob(os.path.join(work,pat),recursive=True):
            if ".test." in f: continue
            try: txt=open(f,errors="ignore").read()
            # why: this item is unreadable/unparseable; skip it, the loop continues over the rest
            except Exception: continue
            checked+=1
            for name,rx in FORBIDDEN:
                for m in re.finditer(rx,txt):
                    line=txt[:m.start()].count(chr(10))+1
                    findings.append({"file":os.path.relpath(f,work),"line":line,"violation":name})
    return findings, checked

def selftest():
    ok=True
    f,c=scan(sec.DEFAULT_WORK)
    print(("PASS" if c>0 else "WARN")+"  %d target file(s) scanned, %d finding(s)"%(c,len(f)))
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        rel=TARGET_GLOB[0].replace("**/","")
        tgt=os.path.join(d,os.path.dirname(rel)); os.makedirs(tgt,exist_ok=True)
        _fname=os.path.basename(rel).replace("*","x")
        # craft a violation from the first forbidden pattern's example
        open(os.path.join(tgt,_fname),"w").write('<button onClick={()=>startRun()}>Go</button>\n')
        f2,c2=scan(d)
    print(("PASS" if len(f2)>=1 else "FAIL")+"  synthetic violation detected (%d)"%len(f2))
    ok=ok and len(f2)>=1
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    f,c=scan(a.work)
    if sec.emit({"findings":f,"summary":{"scanned":c,"violations":len(f)}},as_json=a.json): return 1 if f else 0
    print("%s: %d file(s) scanned, %d violation(s)"%(LABEL,c,len(f)))
    for x in f[:40]: print("  %s%s%s %s:%d %s"%(Y,x["violation"],RST,x["file"],x["line"],""))
    if not f: print(G+"no violations -- boundary respected"+RST)
    return 1 if f else 0

if __name__ == "__main__":
    sys.exit(main())
