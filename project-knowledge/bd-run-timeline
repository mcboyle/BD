#!/usr/bin/env python3
"""bd-run-timeline -- build a timeline from a run log.

Parses a run log into an ordered timeline of events: state changes, API calls,
fetches, artifacts produced, and errors -- each with its line position. Gives a
chronological reconstruction of what happened during a run for debugging.
Works on a log file or stdin. Read-only.

Usage: bd-run-timeline LOGFILE [--json]
       bd-run-timeline --selftest
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
EVENTS=[("state",re.compile(r'(?i)status[=:]\s*(\w+)|state[=:]\s*(\w+)')),
        ("api",re.compile(r'(?i)(GET|POST|PUT|DELETE)\s+(/\S+)')),
        ("fetch",re.compile(r'(?i)fetch(?:ing)?\s+(https?://\S+)')),
        ("artifact",re.compile(r'(?i)wrote\s+(\S+\.\w+)|saved\s+(\S+)')),
        ("error",re.compile(r'(?i)\b(error|exception|failed|timeout)\b'))]
def build(text):
    tl=[]
    for i,line in enumerate(text.splitlines(),1):
        for kind,rx in EVENTS:
            m=rx.search(line)
            if m:
                detail=next((g for g in m.groups() if g),line.strip()[:60])
                tl.append({"line":i,"kind":kind,"detail":str(detail)[:80]})
                break
    return tl
def selftest():
    ok=True
    log="status=running\nGET /api/download\nfetching https://x/v.mp4\nwrote out.mp4\nERROR: timeout\n"
    tl=build(log)
    kinds=[e["kind"] for e in tl]
    good="state" in kinds and "api" in kinds and "fetch" in kinds and "artifact" in kinds and "error" in kinds
    print(("PASS" if good else "FAIL")+"  all event kinds detected in order (%s)"%kinds)
    ok=ok and good
    print(("PASS" if tl==sorted(tl,key=lambda e:e["line"]) else "FAIL")+"  timeline is line-ordered")
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("logfile",nargs="?")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    text=open(a.logfile,errors="ignore").read() if a.logfile and os.path.exists(a.logfile) else sys.stdin.read()
    tl=build(text)
    if sec.emit({"timeline":tl,"summary":{"events":len(tl)}},as_json=a.json): return 0
    print("run timeline (%d events):"%len(tl))
    for e in tl[:60]:
        col={"error":R,"state":G,"api":Y,"fetch":DIM,"artifact":G}.get(e["kind"],DIM)
        print("  L%-5d %s%-9s%s %s"%(e["line"],col,e["kind"],RST,e["detail"]))
    return 0

if __name__ == "__main__":
    sys.exit(main())
