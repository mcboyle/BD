NOT_TOOLS = {"bdtools_sec.py", "bdtools_taint.py", "bdtools_cache.py",
             "bdtools_cli.py",
             "bd-audit-gate.py", "bd-triage.py"}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("term", nargs="?", default="")
    ap.add_argument("--bin", default=DEFAULT_BIN)
    ap.add_argument("--when", action="store_true",
                    help="session playbook: phase -> trigger -> tools")
    ap.add_argument("--check", action="store_true",
                    help="GATE: fail if any tool in bin/ has no category (=no 'when')")
    ap.add_argument("--emit-doc", metavar="PATH",
                    help="write the WHEN-TO-USE markdown (the PK doc)")
    ap.add_argument("--json", action="store_true",
                    help="machine-readable coverage/category map")
    ap.add_argument("--selftest", action="store_true")

    a = ap.parse_args()

    # UNKNOWN IS A THIRD STATE AND IT FAILS (CLAUDE.md s0). Every mode below takes
    # `a.bin` as its denominator. Before the desandbox port the default pointed at a
    # directory that does not exist, and the listing mode's glob returned [] -- so a
    # bare `bd-tools` printed "0 tools total" and exited 0: a clean report over a
    # denominator that structurally excluded its subject. --check crashed outright
    # with FileNotFoundError, which is louder but still not a verdict. Refuse both.
    if not os.path.isdir(a.bin):
        sys.stderr.write("CANNOT-EVALUATE --bin %s: reason=%s\n"
                         % (a.bin, sec.REASON_ABSENT))
        return sec.EXIT_CANNOT_EVALUATE
    if not [t for t in os.listdir(a.bin) if t.startswith("bd")]:
        sys.stderr.write("CANNOT-EVALUATE --bin %s: reason=%s (no bd-* tools)\n"
                         % (a.bin, sec.REASON_EMPTY))
        return sec.EXIT_CANNOT_EVALUATE

    if a.selftest:
        import os as _os, json as _json
        ok = True
        listed = {t for v in CATEGORY.values() for t in v}
        have = {t for t in _os.listdir(a.bin)
                if t.startswith("bd") and not t.endswith(".json")} - NOT_TOOLS
        # POS: real coverage
        cov = not (have - listed) and not (listed - have)
        print(("PASS" if cov else "FAIL") + "  every tool categorized + no stale entries")
        ok = ok and cov
        # POS: every category carries a WHEN trigger
        nowhen = [c for c in CATEGORY if not WHEN.get(c)]
        print(("PASS" if not nowhen else "FAIL") +
              "  every category declares a WHEN trigger (%d missing)" % len(nowhen))
        ok = ok and not nowhen
        # NEG control: an undeclared tool MUST be reported missing (the gate's teeth)
        fake = "bd-zz-selftest-phantom"
        detected = fake not in listed
        print(("PASS" if detected else "FAIL") +
              "  NEG: an uncategorized tool is NOT silently accepted")
        ok = ok and detected
        print("SELFTEST PASS" if ok else "SELFTEST FAIL")
        return 0 if ok else 1

    if a.json:
        import os as _os, json as _json
        listed = {t for v in CATEGORY.values() for t in v}
        have = {t for t in _os.listdir(a.bin)
                if t.startswith("bd") and not t.endswith(".json")} - NOT_TOOLS
        print(_json.dumps({
            "categories": {c: [t for t in CATEGORY[c] if t in have] for c in CATEGORY},
            "when": WHEN,
            "tools": len(have),
            "categorized": len(have & listed),
            "uncategorized": sorted(have - listed),
            "stale": sorted(listed - have),
        }, indent=1))
        return 0

    if a.check or a.when or a.emit_doc:
        import os as _os
        listed = {t for v in CATEGORY.values() for t in v}
        have = {t for t in _os.listdir(a.bin)
                if t.startswith("bd") and not t.endswith(".json")} - NOT_TOOLS
        missing = sorted(have - listed)
        stale = sorted(listed - have)
        if a.when or a.emit_doc:
            lines = ["# BD toolchain -- WHEN to use what",
                     "",
                     "Generated by `bd-tools --emit-doc` (derived from the live bin/, never hand-kept).",
                     "A category's TRIGGER is the 'when'; each tool's line is the 'what'.",
                     ""]
            for cat_name in CATEGORY:
                tools_in = [t for t in CATEGORY[cat_name] if t in have]
                if not tools_in:
                    continue
                lines.append("## %s" % cat_name)
                lines.append("**WHEN:** %s" % WHEN.get(cat_name, "(no trigger declared)"))
                lines.append("")
                for t in tools_in:
                    lines.append("- `%s` -- %s" % (t, (summary(_os.path.join(a.bin, t)) or "").strip()))
                lines.append("")
            doc = "\n".join(lines)
            if a.emit_doc:
                open(a.emit_doc, "w").write(doc)
                print("wrote %s (%d categories)" % (a.emit_doc, len(CATEGORY)))
            else:
                print(doc)
        if a.check:
            print("coverage: %d/%d tools categorized" % (len(have & listed), len(have)))
            if stale:
                print("STALE (in catalog, not in bin): " + " ".join(stale))
            if missing:
                print("NO 'WHEN' (in bin, uncategorized): " + " ".join(missing))
                print("BLOCKED -- every tool must declare a category (= a session trigger).")
                return 3
            if stale:
                return 3
            print("OK -- every tool has a category and therefore a 'when'.")
        return 0


    tools = {os.path.basename(p): p for p in glob.glob(os.path.join(a.bin, "bd*"))
             if os.path.isfile(p)}
    placed = set()
    total = len(tools)
    pat = a.term.lower()
    shown = 0
    for group, names in CATEGORY.items():
        rows = []
        for n in names:
            if n in tools:
                placed.add(n)
                s = summary(tools[n])
                if pat and pat not in n.lower() and pat not in s.lower():
                    continue
                rows.append((n, s))
        if rows:
            print(f"\n{BOLD}{group}{RST}")
            for n, s in rows:
                print(f"  {C}{n:<20}{RST} {DIM}{s[:74]}{RST}")
                shown += 1
    # uncategorized
    other = sorted(set(tools) - placed)
    orows = []
    for n in other:
        s = summary(tools[n])
        if pat and pat not in n.lower() and pat not in s.lower():
            continue
        orows.append((n, s))
    if orows:
        print(f"\n{BOLD}Other{RST}")
        for n, s in orows:
            print(f"  {C}{n:<20}{RST} {DIM}{s[:74]}{RST}")
            shown += 1
    if pat:
        print(f"\n{DIM}{shown} tool(s) matching {a.term!r} (of {total}){RST}")
    else:
        print(f"\n{DIM}{total} tools total. `bd-tools <term>` to filter.{RST}")
    return 0


sys.exit(main())
