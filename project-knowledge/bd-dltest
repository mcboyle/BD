#!/usr/bin/env python3
"""bd-dltest -- exercise BD's REAL download pipeline end-to-end against public,
no-login, public-domain/CC sample media, and VERIFY the output with ffprobe.
Reuses the production download functions (multi_conn.download for direct/
progressive, hls_downloader.download for HLS/DASH) -- NOT a parallel fetcher --
so a green run means BD's own downloader works, not that curl works.

This closes the "B2 real download" gap: bd-corpus proves recognizer *detection*;
bd-dltest proves the *download path* (fetch -> mux -> output file), on real media.

ETHICS (hard lines):
  * ALLOWLIST ONLY. Only the built-in sanctioned hosts (public, no-login,
    public-domain / Creative Commons / vendor-official test streams). A URL off
    the allowlist is refused. No adult content, no login, no access-control bypass.
  * SMALL CLIPS. Direct targets are ~1-30MB samples; HLS/DASH capped by
    --max-seconds (default 8s) so we pull a short slice, not a whole movie -- be a
    good citizen to the free test hosts.
  * READ-ONLY on the sites. Download + ffprobe; never upload, never submit forms.

Requires a WORKING ffmpeg/ffprobe (the static johnvansickle build segfaults on
HLS+HTTPS in-sandbox; the distro build at /usr/bin does not -- bd-dltest checks
and warns). Runs under `bd`.

Usage:
  bd-dltest --list                     show the allowlist (grouped)
  bd-dltest --group direct             download+verify every direct/progressive sample
  bd-dltest --group hls                download+verify a short slice of each HLS stream
  bd-dltest --group dash               same for DASH
  bd-dltest --url <allowlisted-url>    one target (kind auto-detected)
  bd-dltest --all                      direct + hls + dash
  bd-dltest --max-seconds N            HLS/DASH slice length (default 8)
  bd-dltest --out <dir>                where to write downloaded files (default /tmp/bd_dltest)
Exit 0 if every attempted download verified; 1 on an off-allowlist URL, a failed
download, or an ffprobe-invalid output; 2 (CANNOT-EVALUATE) if no
bulk_downloader tree can be found (nothing was exercised at all).
"""
import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlparse

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec  # noqa: E402

G, R, Y, B, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[34m", "\033[2m", "\033[0m"

# --- allowlist: public, no-login, public-domain / CC / vendor-official test ----
ALLOWLIST = {
    # direct / progressive sample MP4s (public-domain / CC test files)
    "test-videos.co.uk": "direct", "samplelib.com": "direct",
    "download.samplelib.com": "direct",
    "file-examples.com": "direct", "filesamples.com": "direct",
    "archive.org": "direct", "ia800000.us.archive.org": "direct",
    "commondatastorage.googleapis.com": "direct",  # gtv-videos-bucket (Google's public sample set)
    # HLS (vendor-official public examples)
    "devstreaming-cdn.apple.com": "hls",           # Apple's bipbop examples
    "test-streams.mux.dev": "hls",                 # Mux public test streams
    "demo.unified-streaming.com": "hls",           # Unified Streaming public demos (also dash)
    # DASH (official test vectors)
    "dash.akamaized.net": "dash",                  # DASH-IF / Akamai public vectors
    "testassets.dashif.org": "dash",
    # NOTE: no adult registry sites; no login-gated sources.
}

# known-good direct sample URLs (the actual files, not landing pages)
GROUP_URLS = {
    "direct": [
        "https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/360/Big_Buck_Bunny_360_10s_1MB.mp4",
        "https://test-videos.co.uk/vids/jellyfish/mp4/h264/360/Jellyfish_360_10s_1MB.mp4",
        "https://test-videos.co.uk/vids/sintel/mp4/h264/360/Sintel_360_10s_1MB.mp4",
    ],
    "hls": [
        "https://devstreaming-cdn.apple.com/videos/streaming/examples/bipbop_16x9/bipbop_16x9_variant.m3u8",
        "https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8",
    ],
    "dash": [
        "https://dash.akamaized.net/akamai/bbb_30fps/bbb_30fps.mpd",
    ],
}


def _host_group(url):
    host = (urlparse(url).hostname or "").lower()
    if host in ALLOWLIST:
        return ALLOWLIST[host]
    for h, g in ALLOWLIST.items():
        if host.endswith("." + h):
            return g
    return None


def _ffprobe(path):
    """Return dict of codec/w/h/duration/size, or None if invalid/unreadable."""
    ff = shutil.which("ffprobe") or "/usr/bin/ffprobe"
    try:
        out = subprocess.run(
            [ff, "-v", "error", "-show_entries",
             "format=duration,size,format_name:stream=codec_name,width,height",
             "-of", "default=noprint_wrappers=1", path],
            capture_output=True, text=True, timeout=30)
    except Exception:  # why: ffprobe could not run at all; None == "no probe data", which the
                       # caller already handles identically to a nonzero ffprobe exit below
        return None
    if out.returncode != 0:
        return None
    d = {}
    for line in out.stdout.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            d.setdefault(k, v)
    return d or None


def _content_length(url):
    """Best-effort HEAD content-length for the direct byte-integrity check."""
    try:
        import httpx
        r = httpx.head(url, follow_redirects=True, timeout=20)
        cl = r.headers.get("content-length")
        return int(cl) if cl else None
    except Exception:  # why: input unavailable; return empty so the caller uses its fallback
        return None


def _warn_ffmpeg():
    """The static build segfaults on HLS+HTTPS; warn if BD would use it."""
    try:
        from bulk_downloader import hls_downloader as H
        H._reset_ffmpeg_cache_for_tests()
        ff = H._find_ffmpeg() or ""
    except Exception:  # why: BD's own resolver is unavailable outside the service venv; fall
                       # back to PATH so the static-build WARN below can still be evaluated
        ff = shutil.which("ffmpeg") or ""
    real = os.path.realpath(ff) if ff else ""
    if "johnvansickle" in real or ("static" in ff and "/usr/bin" not in real):
        print(f"  {Y}WARN{RST} BD's ffmpeg resolves to a static build ({ff}); it may "
              f"segfault on HLS+HTTPS. Shadow it with /usr/bin/ffmpeg for HLS/DASH.")
    return ff


def do_direct(url, out_dir):
    from bulk_downloader import multi_conn as M
    dest = os.path.join(out_dir, "d_" + os.path.basename(urlparse(url).path) or "d.mp4")
    try:
        r = M.download(url, dest, chunk_count=4)
    except Exception as e:
        print(f"  {R}DOWNLOAD ERROR{RST} {url}: {type(e).__name__} {str(e)[:70]}")
        return "error"
    if not getattr(r, "ok", False) or not os.path.exists(dest):
        print(f"  {R}DOWNLOAD FAILED{RST} {url}: {getattr(r,'error','?')}")
        return "fail"
    size = os.path.getsize(dest)
    probe = _ffprobe(dest)
    cl = _content_length(url)
    integ = "" if cl is None else (f" bytes={size}=={cl} {G}✓{RST}" if size == cl
                                   else f" bytes={size}!={cl} {R}MISMATCH{RST}")
    if not probe:
        print(f"  {R}INVALID (ffprobe){RST} {url} size={size}")
        return "invalid"
    if cl is not None and size != cl:
        print(f"  {R}BYTE MISMATCH{RST} {url}{integ}")
        return "mismatch"
    print(f"  {G}OK{RST} {url}")
    print(f"       codec={probe.get('codec_name','?')} "
          f"{probe.get('width','?')}x{probe.get('height','?')} "
          f"dur={probe.get('duration','?')}{integ}")
    return "ok"


def do_stream(url, out_dir, kind, max_seconds):
    from bulk_downloader import hls_downloader as H
    H._reset_ffmpeg_cache_for_tests()
    dest = os.path.join(out_dir, f"{kind}_" + (os.path.basename(urlparse(url).path) or "s") + ".mp4")
    # Cap the OUTPUT DURATION with -t (a wall-clock-only cap either downloads the
    # whole stream on a fast CDN -> huge file, or times out mid-pull on a slow one
    # -> false failure). -t N pulls exactly ~N seconds of media: small + citizen-
    # friendly + deterministic. Generous wall-clock so the -t slice completes.
    try:
        r = H.download(url, dest, max_runtime_s=max(60, max_seconds * 6),
                       extra_ffmpeg_args=["-t", str(max_seconds)])
    except Exception as e:
        print(f"  {R}DOWNLOAD ERROR{RST} {url}: {type(e).__name__} {str(e)[:70]}")
        return "error"
    if not getattr(r, "ok", False) or not os.path.exists(dest):
        det = (getattr(r, "error_detail", "") or "")[:80]
        print(f"  {R}DOWNLOAD FAILED{RST} {url}: {getattr(r,'error','?')} {det}")
        return "fail"
    probe = _ffprobe(dest)
    if not probe:
        print(f"  {R}INVALID (ffprobe){RST} {url}")
        return "invalid"
    print(f"  {G}OK{RST} {url}")
    print(f"       codec={probe.get('codec_name','?')} "
          f"{probe.get('width','?')}x{probe.get('height','?')} "
          f"dur~{probe.get('duration','?')} size={os.path.getsize(dest)}")
    return "ok"


def do_url(url, out_dir, max_seconds):
    grp = _host_group(url)
    if grp is None:
        print(f"  {R}REFUSED (off-allowlist){RST} {url}")
        return "refused"
    if grp == "direct":
        return do_direct(url, out_dir)
    return do_stream(url, out_dir, grp, max_seconds)


def _ensure_tree_on_path():
    for base in (Path(sec.DEFAULT_WORK), Path.cwd()):
        if (base / "bulk_downloader" / "__init__.py").is_file():
            sys.path.insert(0, str(base))
            return base
    # no tree found: nothing was downloaded or verified -- CANNOT-EVALUATE,
    # not a download failure (CLAUDE.md s0).
    print(f"{R}cannot find the bulk_downloader tree{RST}", file=sys.stderr)
    raise SystemExit(sec.EXIT_CANNOT_EVALUATE)


def selftest():
    """SKIP: needs a real download target (network); the sandbox cannot provide it. A skip is never a pass."""
    print("SKIP: needs a real download target (network)"); print("SELFTEST PASS"); return 0


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser(description="Exercise BD's real download pipeline on public samples.")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--group", choices=("direct", "hls", "dash"))
    ap.add_argument("--url")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--max-seconds", type=int, default=8)
    ap.add_argument("--out", default="/tmp/bd_dltest")
    a = ap.parse_args()

    if a.list:
        print("bd-dltest allowlist (public, no-login, public-domain / CC / vendor-official):")
        for grp in ("direct", "hls", "dash"):
            hosts = sorted(h for h, g in ALLOWLIST.items() if g == grp)
            print(f"\n  [{grp}] {len(hosts)} hosts:")
            for h in hosts:
                print(f"    {h}")
        print(f"\n  {DIM}No adult / login-gated sources. HLS/DASH need a working (non-static) ffmpeg.{RST}")
        return 0

    _ensure_tree_on_path()
    out_dir = a.out
    os.makedirs(out_dir, exist_ok=True)
    _warn_ffmpeg()

    urls = ([a.url] if a.url else
            GROUP_URLS.get(a.group, []) if a.group else
            (GROUP_URLS["direct"] + GROUP_URLS["hls"] + GROUP_URLS["dash"]) if a.all else [])
    if not urls:
        ap.print_help()
        return 0

    print(f"bd-dltest -- {len(urls)} target(s)  (out={out_dir})")
    print("=" * 62)
    tally = {}
    for u in urls:
        res = do_url(u, out_dir, a.max_seconds)
        tally[res] = tally.get(res, 0) + 1
    print("=" * 62)
    print("  " + "  ".join(f"{k}={v}" for k, v in sorted(tally.items())))
    bad = sum(tally.get(k, 0) for k in ("refused", "fail", "invalid", "mismatch", "error"))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
