#!/usr/bin/env python3
"""bd-deploy-manifest -- the files an OVERLAY deploy must DELETE, not just add.

Deploy is `unzip -o` over the live tree. That overwrites and adds -- it NEVER removes.
So a file DELETED in a cut keeps living on stash, and because the graph gates
(dependency_graph, import_graph_gate) GLOB THE DISK, the orphan is scanned as live
source: its import edge reappears, and the frozen baseline -- which no longer lists it
-- trips. 718 went RED on stash exactly this way: app_sched_exports.py was deleted at
716, the release zip is correct and does not contain it, but the overlay left the old
copy on disk, and test_import_graph_no_new_edges saw the ghost edge.

The release zip is a complete tree, so the removal set is derivable: any tracked file
present in the DEPLOYED tree but absent from the new zip is an orphan the deploy must
`rm`. bd-cut already computes this internally; this surfaces it as an operator artifact.

WHEN: after building a release that DELETES any file, before/with deploy. The operator
runs the emitted `rm` lines (or `--script` writes them) as part of the overlay.

Read-only (never deletes anything itself). ASCII. --json. --selftest.
"""
import argparse
import json
import os
import sys
import zipfile

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

# tracked source/artifact extensions -- a leftover of these can trip a gate. We do NOT
# propose deleting runtime data (the DB, downloads, logs), only versioned tree files.
_TRACKED = (".py", ".ts", ".tsx", ".js", ".json", ".md", ".txt", ".sh", ".html",
            ".css", ".jsx")
# never propose removing these even if absent from the zip -- they are runtime/local.
_NEVER_RM = ("bulk_downloader.db", "app_config.json", ".env", "sites_config.json",
             "secrets.json", "vault_tokens.json")

# v3.66.798: the app-side rule LANDED (live_recordings is now in
# _MANIFEST_EXCLUDE_DIRS), so the tool-level floor is retired. The floor and
# the rule must not both exist -- double-cover hides the day one of them
# regresses. Protection now comes exclusively from the ZIP'S OWN predicate
# (_zip_runtime_predicate), same as every other runtime path; the selftest
# asserts a post-798 zip protects live_recordings/recordings.json via the
# predicate alone.
_RUNTIME_DIR_FLOOR = set()


def _zip_runtime_predicate(zpath, rels):
    """Which of `rels` does the ZIP'S OWN release-exclusion predicate call
    runtime? Returns (excluded_set, reason). reason is None on success; on ANY
    failure the set is empty and the CALLER degrades to the legacy universe --
    this tool proposes DELETIONS, so unlike the band filter it fails CLOSED:
    a failure must never yield MORE proposals than the old tool made.
    DERIVED from the zip being deployed (the new truth), not from the possibly-
    stale deployed tree and not from a baked mirror."""
    if not rels:
        return set(), None
    import subprocess
    import tempfile
    need = ("bulk_downloader/dev_suite/_common.py",
            "bulk_downloader/dev_suite/release_lint.py")
    prog = (
        "import sys, json\n"
        "sys.path.insert(0, sys.argv[1])\n"
        "from bulk_downloader.dev_suite.release_lint import _manifest_excluded\n"
        "paths = json.load(sys.stdin)\n"
        "json.dump([p for p in paths if _manifest_excluded(p)], sys.stdout)\n")
    try:
        with zipfile.ZipFile(zpath) as zf:
            names = set(zf.namelist())
            if not set(need) <= names:
                return set(), "zip does not ship the release predicate modules"
            with tempfile.TemporaryDirectory() as td:
                pkg = os.path.join(td, "bulk_downloader", "dev_suite")
                os.makedirs(pkg)
                # EMPTY package inits on purpose: the real dev_suite/__init__
                # re-imports the whole suite; release_lint only needs ._common.
                open(os.path.join(td, "bulk_downloader", "__init__.py"), "w").write("")
                open(os.path.join(pkg, "__init__.py"), "w").write("")
                for n in need:
                    with open(os.path.join(td, n), "wb") as fh:
                        fh.write(zf.read(n))
                r = subprocess.run(
                    [sys.executable, "-c", prog, td],
                    input=json.dumps(sorted(rels)), capture_output=True,
                    text=True, timeout=60, cwd=td)
        if r.returncode != 0:
            tail = (r.stderr or "").strip().splitlines()
            return set(), ("predicate import/eval failed (rc=%d): %s"
                           % (r.returncode, tail[-1] if tail else "no stderr"))
        return set(json.loads(r.stdout)), None
    except Exception as e:  # why: ANY failure here must degrade, never crash a deploy step
        return set(), "predicate extraction failed: %s" % e


def _zip_members(zpath):
    with zipfile.ZipFile(zpath) as zf:
        return {n for n in zf.namelist() if not n.endswith("/")}


def _tree_members(root):
    out = set()
    for dp, dn, fns in os.walk(root):
        # v3.66.762: do NOT prune "dist" -- frontend/dist/assets ships in the zip
        # and content-hashed bundles are exactly what an overlay deploy leaves
        # stale (new hash added, old never removed). Pruning it made the tool
        # blind to the 27-stale-js class and report "no orphans" over real stale
        # bundles. node_modules/venv are pruned first, so we never reach a dep's
        # nested dist. "build" (py build inputs, not shipped) stays pruned.
        dn[:] = [d for d in dn if d not in (".git", "__pycache__", "node_modules",
                                            "venv", ".venv", "build")]
        for fn in fns:
            rel = os.path.relpath(os.path.join(dp, fn), root)
            out.add(rel)
    return out


def orphans(zpath, deployed_root):
    """Tracked files in the deployed tree but NOT in the new zip -- the overlay's
    removal set. The candidate UNIVERSE is derived from the zip (extensions the
    zip itself ships, unioned with the legacy _TRACKED floor -- the old
    allowlist was blind to .map(16)/.png(7)/.bat/.har/... in the real release);
    the runtime PROTECTION is derived from the zip's own
    dev_suite._manifest_excluded (the old _NEVER_RM mirror let
    state/heartbeat.json and <host>.template-draft.json get real rm lines)."""
    zmem = _zip_members(zpath)
    zexts = {os.path.splitext(n)[1] for n in zmem if os.path.splitext(n)[1]}
    tmem = _tree_members(deployed_root)
    cands = []
    for rel in sorted(tmem - zmem):
        ext = os.path.splitext(rel)[1]
        if not (rel.endswith(_TRACKED) or (ext and ext in zexts)):
            continue
        if any(rel.endswith(n) for n in _NEVER_RM):
            continue
        if rel.replace("\\", "/").split("/")[0] in _RUNTIME_DIR_FLOOR:
            continue
        cands.append(rel)
    excluded, why = _zip_runtime_predicate(zpath, cands)
    if why is not None:
        # fail CLOSED: retract the zip-derived EXPANSION too, so degraded mode
        # never proposes more than the legacy tool did. Say so on stderr
        # (stdout carries --json / --script rm lines).
        print("bd-deploy-manifest: zip runtime-predicate UNAVAILABLE (%s) -- "
              "degraded to the legacy _TRACKED universe; runtime protection is "
              "the static floor only" % why, file=sys.stderr)
        return [c for c in cands if c.endswith(_TRACKED)]
    if excluded:
        print("bd-deploy-manifest: %d runtime file(s) protected per the zip's "
              "own _manifest_excluded(): %s"
              % (len(excluded), ", ".join(sorted(excluded)[:6])
                 + (" ..." if len(excluded) > 6 else "")), file=sys.stderr)
    return [c for c in cands if c not in excluded]


def selftest():
    import tempfile
    ok = True
    with tempfile.TemporaryDirectory() as td:
        root = os.path.join(td, "tree")
        os.makedirs(os.path.join(root, "bulk_downloader"))
        # deployed tree has an extra .py (the orphan) + a runtime db
        open(os.path.join(root, "bulk_downloader", "keep.py"), "w").write("x")
        open(os.path.join(root, "bulk_downloader", "orphan.py"), "w").write("x")
        open(os.path.join(root, "bulk_downloader.db"), "w").write("db")
        # A stale content-hashed SPA bundle: shipped under frontend/dist/assets,
        # left behind by an overlay deploy (new hash added, old never removed).
        # This is the 27-stale-dist-js defect -- the walk USED to prune "dist",
        # so these were invisible and the tool reported "no orphans".
        os.makedirs(os.path.join(root, "frontend", "dist", "assets"))
        open(os.path.join(root, "frontend", "dist", "assets",
                          "Dashboard-OLDHASH0.js"), "w").write("stale")
        # the new zip has keep.py + the CURRENT dist bundle (orphan.py, db, and
        # the OLD dist hash absent)
        zpath = os.path.join(td, "rel.zip")
        with zipfile.ZipFile(zpath, "w") as zf:
            zf.writestr("bulk_downloader/keep.py", "x")
            zf.writestr("frontend/dist/assets/Dashboard-NEWHASH1.js", "cur")
        g = orphans(zpath, root)
        p1 = "bulk_downloader/orphan.py" in g
        print(("%sPASS%s" if p1 else "%sFAIL%s") % ((G, RST) if p1 else (R, RST)) +
              "  POS: the deleted .py is flagged for removal (%s)" % g)
        ok &= p1
        # POS: a stale content-hashed dist bundle absent from the zip IS an orphan
        pd = "frontend/dist/assets/Dashboard-OLDHASH0.js" in g
        print(("%sPASS%s" if pd else "%sFAIL%s") % ((G, RST) if pd else (R, RST)) +
              "  POS: a stale dist/assets bundle is flagged (the 27-stale-js defect)")
        ok &= pd
        # NEG: the runtime DB, though absent from the zip, is NOT proposed for deletion
        n1 = "bulk_downloader.db" not in g
        print(("%sPASS%s" if n1 else "%sFAIL%s") % ((G, RST) if n1 else (R, RST)) +
              "  NEG: a runtime DB absent from the zip is NOT proposed for deletion")
        ok &= n1
        # NEG: a file present in BOTH is not flagged
        n2 = "bulk_downloader/keep.py" not in g
        print(("%sPASS%s" if n2 else "%sFAIL%s") % ((G, RST) if n2 else (R, RST)) +
              "  NEG: a file present in the zip is not flagged")
        ok &= n2

    # --- CONTROLS: the denominator must be DERIVED from the zip, both ways. ----
    # (1) Candidate universe: _TRACKED was a baked extension allowlist -- the real
    #     796 zip ships .map(16) .png(7) .bat .har .wacz .mjs ... none of which it
    #     could see, so a stale shipped sourcemap/icon reported "no orphans".
    # (2) Runtime protection: _NEVER_RM was a hand mirror of the app's runtime
    #     set -- state/heartbeat.json and <host>.template-draft.json (operator
    #     runtime drafts) got REAL `rm -f` lines in --script mode. The zip's own
    #     dev_suite.release_lint._manifest_excluded() is the canon; derive it
    #     FROM THE ZIP BEING DEPLOYED. Deletion-proposing tool => fail CLOSED:
    #     predicate unavailable -> legacy behavior + a stderr notice, never MORE
    #     proposals.
    import tempfile
    FAKE_COMMON = "_MANIFEST_EXCLUDE_DIRS = {'state', 'live_recordings'}\n"
    FAKE_LINT = (
        "from ._common import _MANIFEST_EXCLUDE_DIRS\n"
        "def _manifest_excluded(rel):\n"
        "    rel = rel.replace('\\\\', '/')\n"
        "    parts = rel.split('/')\n"
        "    if any(d in _MANIFEST_EXCLUDE_DIRS for d in parts):\n"
        "        return True\n"
        "    return (parts[-1] == 'ZIPSYNTH.bin'\n"
        "            or parts[-1].endswith('.template-draft.json'))\n")
    with tempfile.TemporaryDirectory() as td:
        root = os.path.join(td, "tree")
        os.makedirs(os.path.join(root, "frontend", "dist", "assets"))
        os.makedirs(os.path.join(root, "state"))
        # class 1: stale files whose extensions the ZIP ships (not in _TRACKED)
        open(os.path.join(root, "frontend", "dist", "assets",
                          "Dash-OLD.js.map"), "w").write("m")
        open(os.path.join(root, "frontend", "dist", "assets",
                          "logo-OLD.png"), "w").write("p")
        # class 2: runtime files the zip's predicate excludes
        open(os.path.join(root, "state", "heartbeat.json"), "w").write("{}")
        open(os.path.join(root, "ex.com.template-draft.json"), "w").write("{}")
        open(os.path.join(root, "ZIPSYNTH.bin"), "w").write("z")
        # plus a REAL orphan that must survive every filter
        open(os.path.join(root, "gone_for_real.py"), "w").write("x")
        os.makedirs(os.path.join(root, "live_recordings"), exist_ok=True)
        open(os.path.join(root, "live_recordings", "recordings.json"),
             "w").write("{}")
        zp = os.path.join(td, "rel.zip")
        with zipfile.ZipFile(zp, "w") as zf:
            zf.writestr("bulk_downloader/__init__.py", "")
            zf.writestr("bulk_downloader/dev_suite/__init__.py", "")
            zf.writestr("bulk_downloader/dev_suite/_common.py", FAKE_COMMON)
            zf.writestr("bulk_downloader/dev_suite/release_lint.py", FAKE_LINT)
            zf.writestr("frontend/dist/assets/Dash-NEW.js.map", "m2")
            zf.writestr("frontend/dist/assets/logo-NEW.png", "p2")
            zf.writestr("keep.bin", "b")   # .bin ships => ZIPSYNTH.bin is a candidate
        g2 = orphans(zp, root)
        c_map = "frontend/dist/assets/Dash-OLD.js.map" in g2
        c_png = "frontend/dist/assets/logo-OLD.png" in g2
        c_hb = "state/heartbeat.json" not in g2
        c_td = "ex.com.template-draft.json" not in g2
        c_syn = "ZIPSYNTH.bin" not in g2   # only the ZIP's predicate knows this name
        c_real = "gone_for_real.py" in g2
        # v3.66.798 FLOOR-RETIRED: live_recordings protection must come from
        # the ZIP'S OWN predicate, with the tool-level floor gone. Both halves
        # asserted: the floor IS empty (double-cover hides regressions), and a
        # planted live_recordings/recordings.json is still never proposed.
        c_floor_gone = not _RUNTIME_DIR_FLOOR
        c_lr = "live_recordings/recordings.json" not in g2
        du = (c_map and c_png and c_hb and c_td and c_syn and c_real
              and c_floor_gone and c_lr)
        print(("%sPASS%s" if du else "%sFAIL%s") % ((G, RST) if du else (R, RST)) +
              "  DERIVED-DENOM: zip-shipped extensions seen (map=%s png=%s); "
              "zip's own runtime predicate protects (hb=%s draft=%s zip-only=%s "
              "live_rec=%s floor-empty=%s); "
              "real orphan kept (%s)" % (c_map, c_png, c_hb, c_td, c_syn,
                                         c_lr, c_floor_gone, c_real))
        ok &= du

        # FAIL-CLOSED: a zip WITHOUT the predicate must degrade to LEGACY
        # behavior (no new protection, no new visibility beyond _TRACKED union)
        # and must not crash -- and the real orphan is still reported.
        zp2 = os.path.join(td, "rel2.zip")
        with zipfile.ZipFile(zp2, "w") as zf:
            zf.writestr("keep2.py", "x")
        g3 = orphans(zp2, root)
        fc = "gone_for_real.py" in g3
        print(("%sPASS%s" if fc else "%sFAIL%s") % ((G, RST) if fc else (R, RST)) +
              "  FAIL-CLOSED: predicate-less zip degrades to legacy, real orphan "
              "still reported")
        ok &= fc

    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(prog="bd-deploy-manifest")
    ap.add_argument("--zip", help="the release zip being deployed")
    ap.add_argument("--deployed", default=os.path.expanduser("~/BulkDownloader"),
                    help="the live deployed tree (default ~/BulkDownloader)")
    ap.add_argument("--script", action="store_true", help="emit rm lines only")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if not a.zip:
        ap.error("--zip is required")
    if not os.path.isfile(a.zip):
        print("%sno such zip: %s%s" % (R, a.zip, RST))
        return 2
    if not os.path.isdir(a.deployed):
        print("%sdeployed tree not found: %s (run this ON stash, or pass --deployed)%s"
              % (Y, a.deployed, RST))
        return 2

    gone = orphans(a.zip, a.deployed)
    if a.json:
        print(json.dumps({"zip": a.zip, "deployed": a.deployed,
                          "orphans": gone, "count": len(gone)}, indent=2))
        return 0
    if a.script:
        for rel in gone:
            print("rm -f %s" % os.path.join(a.deployed, rel))
        return 0
    if not gone:
        print("%sno orphans%s -- the overlay deploy leaves nothing stale." % (G, RST))
        return 0
    print("%s%d orphan(s)%s -- present on the deployed tree, ABSENT from the release "
          "zip. An `unzip -o` overlay will NOT remove them, and a disk-globbing gate "
          "(import_graph, dependency_graph) will trip on the ghost. Delete them as part "
          "of the deploy:" % (R, len(gone), RST))
    for rel in gone:
        print("  rm -f %s" % os.path.join(a.deployed, rel))
    return 0


if __name__ == "__main__":
    sys.exit(main())
