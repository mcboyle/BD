#!/usr/bin/env python3
"""bd-archive-normalize -- normalize pack/archive names + flag non-canonical.

Checks the zips in home against the canonical naming scheme (bdsuite_v3_66_<n>,
bd_project_files, BulkDownloader_v3_66_<n>, BulkDL_next_session_v3_66_<n>,
audit_state_v3_66_<n>, pack_[A-H], bd_cloak_pack_v3_66_<n>). Flags names with
spaces, version stamps where the scheme is version-agnostic (or vice versa),
duplicate version stamps, and source/session-pack confusion. Suggests the
canonical name for each. Read-only (reports; does not rename).

Usage: bd-archive-normalize [--home DIR] [--json] [--selftest]
Exit 0 (informational -- reports/generates; does not render a pass/fail verdict and does not gate).
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
CANON=[re.compile(r'^bdsuite_v3_66_\d+\.zip$'),re.compile(r'^bd_project_files\.zip$'),
       re.compile(r'^BulkDownloader_v3_66_\d+\.zip$'),re.compile(r'^BulkDL_next_session_v3_66_\d+\.zip$'),
       re.compile(r'^audit_state_v3_66_\d+\.zip$'),re.compile(r'^pack_[A-H]2?\.zip$'),
       re.compile(r'^bd_cloak_pack_v3_66_\d+\.zip$'),re.compile(r'^bd_staging_kit\.zip$')]

def scan(home):
    rows=[]
    for zp in sorted(glob.glob(os.path.join(home,"*.zip"))):
        base=os.path.basename(zp)
        canonical=any(rx.match(base) for rx in CANON)
        issues=[]
        if " " in base: issues.append("contains space")
        if not canonical: issues.append("non-canonical name")
        rows.append({"file":base,"canonical":canonical,"issues":issues})
    return rows

def selftest():
    ok=True
    rows=scan("/home/claude")
    print(("PASS" if rows else "FAIL")+"  zips inventoried (%d)"%len(rows))
    ok=ok and bool(rows)
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        for n in ("bdsuite_v3_66_688.zip","weird name.zip","random.zip"):
            open(os.path.join(d,n),"w").write("x")
        s=scan(d)
    byn={r["file"]:r for r in s}
    good=byn["bdsuite_v3_66_688.zip"]["canonical"] and not byn["random.zip"]["canonical"] and "contains space" in byn["weird name.zip"]["issues"]
    print(("PASS" if good else "FAIL")+"  canonical recognized, stray+spaced flagged")
    ok=ok and good
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_bundle(a.home)
    rows=scan(a.home)
    flagged=[r for r in rows if r["issues"]]
    if sec.emit({"archives":rows,"summary":{"total":len(rows),"flagged":len(flagged)}},as_json=a.json): return 0
    print("%d archive(s); %d non-canonical/flagged:"%(len(rows),len(flagged)))
    for r in flagged[:40]: print("  %s%s%s: %s"%(Y,r["file"],RST,", ".join(r["issues"])))
    if not flagged: print(G+"all archives canonically named"+RST)
    return 0
sys.exit(main())
