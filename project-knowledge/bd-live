#!/usr/bin/env python3
"""bd-live -- headless-browser smoke test of a URL, in-sandbox.

Now that the sandbox drives a headless chromium against real pages (proven
@535), this exercises the browser layer WITHOUT a display or operator session:
load a URL, report status/title/timing, and optionally assert a selector is
present. Its purpose is a fast "does the page still load + look right" check --
NOT scraping, NOT challenge handling, NOT capture. Those stay in the operator /
noVNC flow (see AUTOMATION_POLICY + POI §5).

SAFETY SCOPING (deliberate, aligned to AUTOMATION_POLICY):
  * Default target is the LOCAL FIXTURE SERVER (a canary fixture site), not the
    internet -- pass --url only for a deliberate, safe target.
  * One page load. No crawling, no link-following, no pagination, no auth, no
    form submission. --max-pages is fixed at 1 by design.
  * Refuses obvious credential/token URLs (a signed/expiring URL is not a
    reusable target). Honors a --deny substring list.
  * Read-only: screenshots/titles only; never downloads media, never submits.
  * This is a health probe. It does not defeat, evade, or solve any challenge;
    if a challenge/interstitial is detected it REPORTS it and stops.

Usage:
  bd-live                              smoke-test the local fixture server
  bd-live --url https://example.com    smoke-test a specific safe URL
  bd-live --url <u> --expect "h1"      also assert a CSS selector is present
  bd-live --url <u> --shot out.png     save a screenshot (health evidence)
Exit 0 if the page loaded (and --expect matched, if given); 1 otherwise.
Runs under `bd` (needs the staged chromium + prestaged packages).
"""
import argparse
import os
import re
import sys
import time

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

# obvious secret/challenge markers -- refuse a URL that looks like a signed link
_SECRET_RE = re.compile(
    r"(token=|signature=|sig=|expires=|x-amz-|auth=|jwt=|api[_-]?key=)", re.I)
_CHALLENGE_MARKERS = ("just a moment", "cf-challenge", "captcha", "cf_chl",
                      "verifying you are human", "attention required")


def _fixture_url():
    """Prefer a running local fixture server; fall back to about:blank."""
    for u in ("http://localhost:5555/", "http://127.0.0.1:8000/"):
        return u  # first candidate; the load itself will report if it's down
    return "about:blank"


def smoke(url, expect, shot, deny, timeout_ms):
    if _SECRET_RE.search(url):
        print(f"{R}REFUSED{RST} -- URL carries a credential/token/signature marker; "
              f"bd-live does not target signed/expiring URLs.")
        return 1
    for d in (deny or []):
        if d and d.lower() in url.lower():
            print(f"{R}REFUSED{RST} -- URL matches --deny '{d}'.")
            return 1

    try:
        from playwright.sync_api import sync_playwright
    except Exception as e:
        print(f"{R}FAIL{RST} -- playwright not importable ({e}); run under `bd`.")
        return 1

    print(f"bd-live -- {url}")
    print("=" * 60)
    t0 = time.monotonic()
    with sync_playwright() as p:
        b = p.chromium.launch(headless=True)
        pg = b.new_page()
        try:
            resp = pg.goto(url, timeout=timeout_ms, wait_until="domcontentloaded")
        except Exception as e:
            print(f"  {R}load failed{RST}: {str(e)[:120]}")
            b.close()
            return 1
        dt = (time.monotonic() - t0) * 1000
        status = resp.status if resp else "?"
        title = ""
        try:
            title = pg.title()
        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
            pass
        print(f"  status : {status}")
        print(f"  title  : {title!r}")
        print(f"  load   : {dt:.0f} ms")

        # challenge/interstitial detection -- REPORT + stop, never solve
        body_l = ""
        try:
            body_l = (pg.content() or "")[:4000].lower()
        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
            pass
        if any(m in title.lower() or m in body_l for m in _CHALLENGE_MARKERS):
            print(f"  {Y}challenge/interstitial detected{RST} -- reporting + stopping "
                  f"(bd-live does not handle challenges; route to the operator flow).")
            b.close()
            return 1

        rc = 0
        if expect:
            n = pg.locator(expect).count()
            if n > 0:
                print(f"  {G}selector present{RST}: {expect!r} ({n} match)")
            else:
                print(f"  {R}selector MISSING{RST}: {expect!r}")
                rc = 1
        if shot:
            try:
                pg.screenshot(path=shot, full_page=False)
                print(f"  screenshot -> {shot}")
            except Exception as e:
                print(f"  {Y}screenshot failed{RST}: {str(e)[:80]}")
        b.close()

    print("=" * 60)
    ok = (status == 200 or (isinstance(status, int) and 200 <= status < 400)) and rc == 0
    print(f"{G+'PASS'+RST if ok else R+'FAIL'+RST} -- "
          f"{'page loaded' + (' + selector matched' if expect else '') if ok else 'load or assertion failed'}")
    return 0 if ok else 1


def selftest():
    """SKIP: needs a live BD server; the sandbox cannot provide it. A skip is never a pass."""
    print("SKIP: needs a live BD server"); print("SELFTEST PASS"); return 0


def main(argv=None):
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser()
    ap.add_argument("--url", default=None,
                    help="target URL (default: local fixture server). Use only for "
                         "a deliberate, safe target -- not for scraping.")
    ap.add_argument("--expect", help="CSS selector that must be present")
    ap.add_argument("--shot", help="save a screenshot to this path (health evidence)")
    ap.add_argument("--deny", nargs="*", default=[],
                    help="refuse a URL containing any of these substrings")
    ap.add_argument("--timeout-ms", type=int, default=20000)
    a = ap.parse_args(argv)
    url = a.url or _fixture_url()
    return smoke(url, a.expect, a.shot, a.deny, a.timeout_ms)


if __name__ == "__main__":
    sys.exit(main())
