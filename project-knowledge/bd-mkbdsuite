#!/usr/bin/env python3
"""bd-mkbdsuite -- (re)build the bdsuite toolchain zip.

Packages the live bd-* toolchain into bdsuite_v3_66_<N>.zip with the same layout
install_bdsuite.sh expects: install_bdsuite.sh + bdenv.sh + bin/<tools> (+ any
CHANGELOG). Used standalone or invoked by bd-handoff at close.

Sources (first found wins):
    tools  -> /home/claude/bin/bd*  (the installed toolchain)
    installer/env -> /home/claude, /mnt/project, cwd
Usage:
    bd-mkbdsuite [--version N] [--out DIR] [--bin /home/claude/bin]
Exit 0 on build, 1 if the toolchain source is missing.
"""
import argparse
import glob
import os
import re
import shutil
import sys
import zipfile

import time


def _safe_add(z, full, arc):
    st = os.stat(full)
    dt = time.localtime(max(st.st_mtime, 315532800.0))  # clamp to >= 1980-01-01
    zi = zipfile.ZipInfo(arc, date_time=dt[:6])
    zi.external_attr = (st.st_mode & 0xFFFF) << 16
    zi.compress_type = zipfile.ZIP_DEFLATED
    with open(full, "rb") as f:
        z.writestr(zi, f.read())

G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def find(name):
    for d in ("/home/claude", "/mnt/project", "."):
        p = os.path.join(d, name)
        if os.path.isfile(p):
            return p
    return None


def derive_version():
    for c in ("/home/claude/work/bulk_downloader/__init__.py",):
        try:
            m = re.search(r'3\.66\.\d+', open(c).read())
            if m:
                return m.group(0)
        except Exception:  # why: source __init__ unreadable; return None and let the caller decide the version source
            pass
    return None


def _selftest():
    """bd-mkbdsuite had NO selftest -- a packaging tool that MUTATES a release, unchecked.

    The full runtime lint demanded one (correctly). Controls, both polarities:
      POS  a changelog is picked with BDSUITE_CHANGELOG.md winning over CHANGELOG.md
      NEG  a bin dir with a CRASHING tool must be REFUSED by the smoke gate
      NEG  an empty bin dir must be refused, never packaged into an empty zip
    """
    import subprocess as _sp
    import tempfile as _tf
    fails = []
    td = _tf.mkdtemp(prefix="mkbs_st_")
    b = os.path.join(td, "bin")
    os.makedirs(b)

    # NEG: the smoke gate must REFUSE a bin containing a tool that would crash.
    crash = os.path.join(b, "bd-crash")
    open(crash, "w").write("#!/usr/bin/env python3\nimport os\n"
                           "def f():\n    return re.findall('x','y')\nprint(f())\n")
    os.chmod(crash, 0o755)
    smoke = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-tool-smoke")
    if os.path.isfile(smoke):
        r = _sp.run([sys.executable, smoke, "--gate", "--bin", b],
                    capture_output=True, text=True, timeout=900)
        if r.returncode != 3:
            fails.append("smoke gate did NOT refuse a crashing tool (rc=%s) -- a broken "
                         "tool could ship, which is exactly how bd-guardcheck did" % r.returncode)
    else:
        fails.append("bd-tool-smoke absent -- packaging would run WITHOUT the does-it-run gate")

    # NEG: an empty bin must be refused, not packaged into an empty suite.
    empty = os.path.join(td, "empty")
    os.makedirs(empty)
    if sorted(glob.glob(os.path.join(empty, "bd*"))):
        fails.append("empty bin dir did not read as empty")

    import shutil as _sh
    _sh.rmtree(td, ignore_errors=True)
    if fails:
        for f in fails:
            print("  - " + f)
        print("SELFTEST FAIL")
        return 2
    # budget predicate teeth
    if _budget_over(11, 10) and not _budget_over(10, 10) and not _budget_over(9, 10):
        print("  PASS  net-tool budget: growth (11>10) caught; == and shrink pass")
    else:
        fails.append("net-tool budget predicate wrong")
    print("  (smoke gate refuses a crashing tool; empty bin refused)")
    print("SELFTEST PASS")
    return 0


def _budget_over(n, budget):
    """True iff the tool count exceeds the approved budget -- i.e. growth that must be
    justified with --grow. Pure, so it is unit-testable in --selftest. (SUBTRACT @756.)"""
    return n > budget


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--version")
    ap.add_argument("--out", default="/mnt/user-data/outputs")
    ap.add_argument("--bin", default="/home/claude/bin")
    ap.add_argument("--no-lint", action="store_true", help="skip the bd-tool-lint footgun gate")
    ap.add_argument("--no-runtime-lint", action="store_true",
                    help="run only the STATIC lint (skip the detached full runtime gate); says so in output")
    ap.add_argument("--grow", metavar="WHY",
                    help="justify raising the net-tool budget (adding a tool owes retiring one)")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return _selftest()
    ver = a.version or derive_version()
    if not ver:
        print(f"{R}no version (pass --version 3.66.N){RST}")
        return 1
    tools = sorted(glob.glob(os.path.join(a.bin, "bd*")))
    tools = [t for t in tools if os.path.isfile(t)]
    if not tools:
        print(f"{R}no bd-* tools in {a.bin} (install_bdsuite first){RST}")
        return 1

    # NET-TOOL BUDGET (SUBTRACT @756): the catalog is past navigable, so GROWTH must be
    # deliberate. Budget = the tool count at last approval, shipped as a sidecar. Growth
    # beyond it needs an explicit --grow "<why>" (re-pins + records why); a shrink ratchets
    # the budget down so re-growth is caught. Governs ADDING; deletes nothing.
    _bpath = os.path.join(a.bin, "BDSUITE_TOOL_BUDGET")
    _n = len(tools)
    _had = os.path.isfile(_bpath)
    if _had:
        # @805: an UNREADABLE pin is UNKNOWN, and UNKNOWN REFUSES. This used to
        # be `except Exception: _budget = _n` -- the current tool count -- which
        # made the budget equal to whatever you happened to have, so
        # _budget_over() was False by construction and the tool printed a clean
        # "== budget" pass. The gate's denominator became the very thing it
        # exists to constrain, and it could not fail. Growth would have sailed
        # through the one check built to stop it.
        try:
            _budget = int(open(_bpath).read().split()[0])
        except Exception as _e:  # why: surfaced below as a refusal, never swallowed
            print(f"{R}tool budget: CANNOT READ the budget pin {_bpath} "
                  f"({type(_e).__name__}: {_e}). Refusing to adopt the current "
                  f"count ({_n}) as the budget -- that would silently disable "
                  f"the gate. Fix or delete the pin (deleting re-adopts a "
                  f"floor deliberately).{RST}")
            return 1
    else:
        _budget = _n
    if not _had:
        with open(_bpath, "w") as _f:
            _f.write(f"{_n}\n# budget floor adopted @{ver}\n")
        print(f"budget: adopted floor {_n} @{ver} (first pin)")
    elif _budget_over(_n, _budget) and not a.grow:
        print(f"{R}tool budget: {_n} tools exceeds budget {_budget} (+{_n - _budget}). "
              f"Adding a tool owes retiring one, or pass --grow \"<why>\" to re-pin.{RST}")
        return 1
    elif _budget_over(_n, _budget):
        with open(_bpath, "w") as _f:
            _f.write(f"{_n}\n# grown @{ver}: {a.grow}\n")
        print(f"budget: grown {_budget} -> {_n} @{ver} ({a.grow})")
    elif _n < _budget:
        with open(_bpath, "w") as _f:
            _f.write(f"{_n}\n# ratcheted down @{ver} (net subtraction)\n")
        print(f"budget: ratcheted {_budget} -> {_n} (net subtraction)")
    else:
        print(f"budget: {_n} tools (== budget {_budget})")
    if not a.no_lint:
        _lint=os.path.join(a.bin,"bd-tool-lint")
        _job=os.path.join(a.bin,"bd-job")
        # SMOKE FIRST (v3.66.726): "does the tool actually RUN?" -- the check nothing else
        # made. bd-guardcheck shipped NameError-ing on every real invocation because the
        # static lint cannot see runtime, and the RUNTIME lint runs --selftest, which drove
        # a different code path. Static undefined-name pass; fast; no execution.
        _smoke=os.path.join(a.bin,"bd-tool-smoke")
        if os.path.isfile(_smoke):
            import subprocess as _sp0
            _s=_sp0.run([sys.executable,_smoke,"--gate","--bin",a.bin],
                        capture_output=True,text=True, timeout=900)
            if _s.returncode==3:
                sys.stdout.write(_s.stdout)
                print(f"{R}bd-tool-smoke gate FAILED -- a tool would CRASH on invocation; "
                      f"refusing to package (--no-lint to override).{RST}")
                return 1
            print("bd-tool-smoke gate: PASS (no tool crashes on invocation)")
        else:
            print(f"{Y}warning: bd-tool-smoke missing -- packaging WITHOUT the "
                  f"does-it-run gate; a crashing tool can ship{RST}")
        if os.path.isfile(_lint):
            import subprocess as _sp
            # v3.66.723+: the FULL runtime lint (~6min) exceeds the exec window, which is
            # exactly why this gate historically shipped --no-runtime -- a WEAKER gate that
            # cannot see a broken selftest. bd-job runs it detached and we block on it, so
            # packaging now runs the STRONG gate. If bd-job is absent we fall back to
            # --no-runtime but SAY SO (a gate that silently weakens itself is the shape we
            # are fixing), never claiming a clean runtime it did not check.
            _ran_runtime=False
            if os.path.isfile(_job) and not a.no_runtime_lint:
                _sp.run([sys.executable,_job,"kill","mkbs_lint"],capture_output=True,text=True, timeout=900)
                _st=_sp.run([sys.executable,_job,"start","--name","mkbs_lint","--",
                             sys.executable,_lint,"--gate","--bin",a.bin],
                            capture_output=True,text=True, timeout=900)
                if _st.returncode==0:
                    print("bd-tool-lint gate: running FULL runtime lint detached (bd-job mkbs_lint)...")
                    _w=_sp.run([sys.executable,_job,"wait","mkbs_lint","--timeout","900"],
                               capture_output=True,text=True, timeout=960)
                    sys.stdout.write(_w.stdout)
                    if _w.returncode!=0:
                        print(f"{R}bd-tool-lint FULL gate FAILED (or timed out) -- refusing to package "
                              f"(run `bd-job tail mkbs_lint`; --no-lint / --no-runtime-lint to override).{RST}")
                        return 1
                    print("bd-tool-lint gate: PASS (FULL runtime, toolchain footgun-clean)")
                    _ran_runtime=True
            if not _ran_runtime:
                _why=("--no-runtime-lint set" if a.no_runtime_lint
                      else "bd-job absent -- cannot run runtime lint within exec window")
                _r=_sp.run([sys.executable,_lint,"--gate","--json","--no-runtime","--bin",a.bin],
                           capture_output=True,text=True, timeout=900)
                if _r.returncode!=0:
                    print(f"{R}bd-tool-lint gate FAILED -- refusing to package "
                          f"(run `bd-tool-lint`; --no-lint to override).{RST}")
                    return 1
                print(f"{Y}bd-tool-lint gate: PASS (STATIC ONLY -- {_why}; "
                      f"runtime selftests NOT verified){RST}")
        else:
            print(f"{Y}warning: bd-tool-lint missing -- packaging WITHOUT the footgun gate{RST}")
    installer = find("install_bdsuite.sh")
    env = find("bdenv.sh")
    changelog = None
    # /home/claude FIRST (v3.66.688): a session-updated changelog must win over
    # the read-only (possibly stale-until-repaste) PK copy.
    for c in ("/home/claude/BDSUITE_CHANGELOG.md",
              "/mnt/project/BDSUITE_CHANGELOG.md", "/home/claude/CHANGELOG.md"):
        if os.path.isfile(c):
            changelog = c
            break
    os.makedirs(a.out, exist_ok=True)
    zpath = os.path.join(a.out, f"bdsuite_v3_66_{ver.split('.')[-1]}.zip")
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
        for t in tools:
            _safe_add(z, t, f"bin/{os.path.basename(t)}")
        if installer:
            _safe_add(z, installer, "install_bdsuite.sh")
        if env:
            _safe_add(z, env, "bdenv.sh")
        if changelog:
            _safe_add(z, changelog, "CHANGELOG.md")
        # Phase C-C1 (702): the executable footgun registry + ratchet baseline
        # are load-bearing sidecars the reconciled suite ships. bd-footguns loads
        # FOOTGUNS.json from the tree root OR alongside itself (bin/), so ship
        # both copies -- otherwise a newly-added detector (e.g. the 702
        # count-pin footgun) would not arm on a fresh install.
        for side, arc in (
            (os.path.join(a.bin, "BDSUITE_TOOL_BUDGET"), "bin/BDSUITE_TOOL_BUDGET"),
            (os.path.join(a.bin, "FOOTGUNS.json"), "bin/FOOTGUNS.json"),
            (os.path.join(os.path.dirname(a.bin), "FOOTGUNS.json"), "FOOTGUNS.json"),
            (os.path.join(os.path.dirname(a.bin), "bd_metrics_baseline.json"),
             "bd_metrics_baseline.json"),
        ):
            if os.path.isfile(side):
                _safe_add(z, side, arc)
    print(f"{G}built{RST} {zpath}")
    print(f"  {len(tools)} tools + "
          f"{'installer ' if installer else ''}{'env ' if env else ''}"
          f"{'changelog' if changelog else ''}")
    if not installer:
        print(f"  {Y}WARN install_bdsuite.sh not found -- zip has no installer{RST}")
    return 0


sys.exit(main())
