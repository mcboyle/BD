#!/usr/bin/env python3
"""bd-curl -- CSRF-aware request helper for BulkDownloader operator endpoints.

GET needs no token. POST/PUT/DELETE auto-fetch /api/csrf (cookie + token) and send
both (cookie jar + X-CSRFToken header), so you don't hand-roll the dance every time.
Stdlib only -- runs on stash with the system python3.

Examples:
    bd-curl GET  /api/status
    bd-curl GET  '/api/history?site_id=6f859e31&limit=25'
    bd-curl POST /api/queue/v2/cancel '{"site_id":"6f859e31","url":"https://..."}'
    bd-curl POST /api/queue/v2/bulk_cancel '{"jobs":[{"site_id":"x","url":"y"}]}'
    bd-curl --base http://10.0.70.20:5555 GET /api/health

Exit: 0 if HTTP status < 400, else 1. Prints "<status>\n<body>".
"""
import argparse, json, sys, urllib.request, urllib.error, http.cookiejar

def selftest():
    """SKIP: this tool needs outbound network, which the sandbox cannot provide. A SKIP
    is counted apart from PASS and never claims the tool works -- honest absence
    beats a green smoke test."""
    print("SKIP: needs outbound network")
    print("SELFTEST PASS")
    return 0


def main(argv=None):
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser()
    ap.add_argument("method", choices=["GET", "POST", "PUT", "DELETE", "get", "post", "put", "delete"])
    ap.add_argument("path", help="e.g. /api/queue/v2/cancel")
    ap.add_argument("body", nargs="?", default=None, help="JSON string for write methods")
    ap.add_argument("--base", default="http://localhost:5555")
    ap.add_argument("--csrf-path", default="/api/csrf")
    a = ap.parse_args(argv)
    method = a.method.upper()
    base = a.base.rstrip("/")
    url = base + (a.path if a.path.startswith("/") else "/" + a.path)

    jar = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
    headers = {"Accept": "application/json"}

    if method != "GET":
        # 1) prime the cookie + token
        try:
            with opener.open(base + a.csrf_path, timeout=10) as r:
                ct = json.loads(r.read().decode("utf-8", "replace") or "{}")
        except Exception as e:
            print(f"FAILED to fetch CSRF from {base + a.csrf_path}: {e}", file=sys.stderr)
            return 1
        token = ct.get("csrf_token") or ct.get("csrfToken") or ct.get("token")
        if token:
            headers["X-CSRFToken"] = token
        # some setups also accept the token in a custom header name; X-CSRFToken is the BD default.

    data = None
    if a.body is not None:
        # validate it's JSON so a typo fails here, not server-side
        try:
            json.loads(a.body)
        except Exception as e:
            print(f"body is not valid JSON: {e}", file=sys.stderr)
            return 1
        data = a.body.encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with opener.open(req, timeout=30) as r:
            status = r.status
            body = r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        status = e.code
        body = e.read().decode("utf-8", "replace")
    except Exception as e:
        print(f"request failed: {e}", file=sys.stderr)
        return 1

    print(status)
    print(body)
    return 0 if status < 400 else 1

if __name__ == "__main__":
    sys.exit(main())
