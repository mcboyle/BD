#!/usr/bin/env python3
"""bd-bump -- the codified 3-part version bump (landed together, or nothing).

The footgun: a version bump is __version__ + the test pin + the CHANGELOG entry,
and a pin left behind fails a gate. This does all three atomically and greps for
stray pins so none is missed.

    __init__.py __version__      -> new
    test pin(s) (== "3.66.N")    -> new   (grep-driven; not a fixed file)
    CHANGELOG.md                 -> prepend `## v<new> - <title>` on the PREVIOUS
                                    `## v...` header (re-emitted intact)

Usage:
    bd-bump 3.66.683 --title "B4: ..."          # --check (default): show the plan
    bd-bump 3.66.683 --title "B4: ..." --write   # apply all three
    bd-bump --work DIR ...
Exit 0 on a clean plan/apply, 1 if inputs are inconsistent.
NOTE: --write edits source. Run bd-ver / bd-changelog after, then build_pin_index.
"""
import argparse
import ast
import glob
import os
import re
import sys

# --- 702: --selftest delegates to the tool's own bd-coretest fault-injection case.
# These are the RELEASE-GATING MUTATORS: they edit the tree and gate a cut, and they
# had NO selftest at their own entry point (bd-tool-lint: 10/10 untested). The teeth
# already existed in bd-coretest -- they were just unreachable from the tool itself.
# Delegating (not re-asserting) keeps ONE source of truth for what "correct" means.
def _selftest_via_coretest():
    import subprocess as _sp, sys as _sys, os as _os
    _me = _os.path.basename(_os.path.realpath(__file__))
    _ct = _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "bd-coretest")
    if not _os.path.isfile(_ct):
        print("SELFTEST FAIL -- bd-coretest not found (cannot verify teeth)")
        return 2
    _cp = _sp.run([_sys.executable, _ct, "--only", _me], capture_output=True, text=True)
    for _ln in _cp.stdout.splitlines():
        if _ln.startswith(_me) or _ln.strip().startswith("["):
            print(_ln)
    print("SELFTEST PASS" if _cp.returncode == 0 else "SELFTEST FAIL")
    return _cp.returncode


if "--selftest" in sys.argv:
    sys.exit(_selftest_via_coretest())


G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


FIXTURES = ("scan_version_pins_fixture", "release_hygiene_gates",
            "build_release_f02", "precut_check", "build_session_pack")
PIN_RE = re.compile(r'assert\s+__version__\s*==\s*"(3\.66\.\d+)"')

def find_pins(work):
    """Real `assert __version__ == "3.66.N"` pins (fixtures allowlist-excluded)."""
    hits = []
    for f in glob.glob(os.path.join(work, "tests/**/*.py"), recursive=True):
        if any(x in os.path.basename(f) for x in FIXTURES):
            continue
        try:
            txt = open(f).read()
        except Exception:  # why: this item is unreadable/unparseable; skip it, the loop continues
            continue
        for m in PIN_RE.finditer(txt):
            hits.append((f, m.group(1)))
    return hits


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("new", nargs="?", help="new version, e.g. 3.66.683")
    ap.add_argument("--title", default="", help="CHANGELOG entry title")
    ap.add_argument("--work","--tree", default="/home/claude/work")
    ap.add_argument("--write", action="store_true")
    a = ap.parse_args()
    if not a.new or not re.match(r'^3\.66\.\d+$', a.new):
        print(f"{R}usage: bd-bump 3.66.<N> --title \"...\" [--write]{RST}")
        return 1
    w = a.work
    initp = os.path.join(w, "bulk_downloader/__init__.py")
    clp = os.path.join(w, "CHANGELOG.md")
    cur = re.search(r'__version__\s*=\s*"(3\.66\.\d+)"', open(initp).read()).group(1)
    print(f"{DIM}current {cur} -> new {a.new}{RST}")
    if a.new == cur:
        print(f"{R}new == current; nothing to bump{RST}")
        return 1
    pins = find_pins(w)
    stray = sorted({v for _, v in pins if v != cur})
    if stray:
        print(f"{Y}WARN pins not at current {cur}: {', '.join(stray)} "
              f"(will still be set to {a.new}){RST}")

    # -- plan --
    plan = []
    plan.append(("__init__.py __version__", initp,
                 f'__version__ = "{cur}"', f'__version__ = "{a.new}"'))
    pinfiles = sorted({f for f, _ in pins})
    for f in pinfiles:
        plan.append((f"test pin {os.path.relpath(f, w)}", f, None, None))
    cl_prev = None
    for ln in open(clp):
        m = re.match(r'(##\s*v?3\.66\.\d+.*)', ln)
        if m:
            cl_prev = m.group(1).rstrip("\n")
            break
    title = a.title or "(fill in)"
    new_entry = f"## v{a.new} - {title}\n\n(TODO changelog body)\n\n"
    print(f"\n{DIM}plan:{RST}")
    for label, *_ in plan:
        print(f"  - {label}: -> {a.new}")
    print(f"  - CHANGELOG.md: prepend `## v{a.new} - {title}` above `{cl_prev}`")

    if not a.write:
        print(f"\n{Y}--check only. re-run with --write to apply, then: "
              f"bd-ver && bd-changelog && (cd {w} && python3 tools/build_pin_index.py){RST}")
        return 0

    # -- write --
    t = open(initp).read()
    open(initp, "w").write(t.replace(f'__version__ = "{cur}"',
                                     f'__version__ = "{a.new}"', 1))
    for f, _ in pins:
        orig = open(f).read()
        # lambda replacement: no backreference-escaping ambiguity (a literal-`\1`
        # replacement string corrupts the assert prefix — the bug this guard catches)
        newtxt = re.sub(r'(assert\s+__version__\s*==\s*)"3\.66\.\d+"',
                        lambda m: m.group(1) + '"' + a.new + '"', orig)
        open(f, "w").write(newtxt)
        # write-verify-or-restore: a corrupted pin line is a SyntaxError; catch it,
        # restore the original, and abort rather than leave the tree broken.
        ok = f'"{a.new}"' in newtxt
        if ok and f.endswith(".py"):
            try:
                ast.parse(newtxt)
            except SyntaxError:
                ok = False
        if not ok:
            open(f, "w").write(orig)
            print(f"\n{R}ABORT: pin rewrite of {os.path.relpath(f, w)} failed self-check "
                  f"-- restored original, no files left corrupted. (report this){RST}")
            return 1
    cl = open(clp).read()
    if cl_prev:
        cl = cl.replace(cl_prev, new_entry + cl_prev, 1)
    else:
        cl = new_entry + cl
    open(clp, "w").write(cl)
    print(f"\n{G}WROTE __version__ + {len(pinfiles)} pin file(s) + CHANGELOG entry.{RST}")
    print(f"{Y}next: fill the CHANGELOG body, then bd-ver && bd-changelog && "
          f"python3 tools/build_pin_index.py{RST}")
    return 0


sys.exit(main())
