#!/usr/bin/env python3
"""bd-route -- route ownership by TEXT-GREP is wrong (the `string-grep-not-decorator`
shape: "actions_center owns /api/library" was false -- those are top-level
@app.route). This resolves a path to its owning blueprint from the url_map-derived
ROUTE_INDEX / ENDPOINT_CATALOG, not grep.

Usage:
  bd-route /api/library            # who owns it
  bd-route --grep library          # all catalogued routes matching a substring
  bd-route --tree DIR ...
Exit 0 route(s) found / 1 no route source in tree / 2 usage error. Informational lookup.
"""
import argparse, json, os, re, sys

def load_routes(tree):
    """Return list of (path, owner, methods) from the best available url_map source."""
    rows = []
    ri = os.path.join(tree, "ROUTE_INDEX.json")
    if os.path.exists(ri):
        try:
            d = json.load(open(ri))
            entries = d if isinstance(d, list) else d.get("routes", d.get("entries", []))
            for e in entries:
                if isinstance(e, dict):
                    path = e.get("rule") or e.get("path") or e.get("route") or ""
                    owner = e.get("blueprint") or e.get("owner") or e.get("endpoint", "").split(".")[0]
                    methods = e.get("methods", "")
                    if path:
                        rows.append((path, owner, methods))
        except Exception:  # why: handled failure is non-fatal here; proceed with the value left unset
            pass
    if rows:
        return rows, "ROUTE_INDEX.json"
    # fall back to ENDPOINT_CATALOG.md table rows
    ec = os.path.join(tree, "ENDPOINT_CATALOG.md")
    if os.path.exists(ec):
        for line in open(ec, errors="ignore"):
            m = re.search(r"(/[\w/<>:.-]+).*?\b([a-z][a-z0-9_]+_bp|app_[a-z0-9_]+)\b", line)
            if m:
                rows.append((m.group(1), m.group(2), ""))
        if rows:
            return rows, "ENDPOINT_CATALOG.md"
    return [], None

def selftest():
    import tempfile, os as _o, shutil as _sh, json as _j
    d=tempfile.mkdtemp(prefix="ct_rt_")
    _j.dump({"routes":[{"path":"/api/x","methods":["GET"],"owner":"blueprint_x"}]},
            open(_o.path.join(d,"ROUTE_INDEX.json"),"w"))
    rows, src = load_routes(d)   # returns (rows, source_label)
    ok=any(r[0]=="/api/x" for r in rows)
    print(("PASS" if ok else "FAIL")+"  loads a route from ROUTE_INDEX.json (%d rows from %s)"%(len(rows),src))
    # NEG: an empty tree yields no routes, not a crash/fabrication
    d2=tempfile.mkdtemp(prefix="ct_rt2_"); nrows,_=load_routes(d2); neg=(nrows==[])
    print(("PASS" if neg else "FAIL")+"  NEG: no route source -> [] (no fabricated routes)")
    _sh.rmtree(d,ignore_errors=True); _sh.rmtree(d2,ignore_errors=True)
    ok=ok and neg
    print("SELFTEST PASS" if ok else "SELFTEST FAIL"); return 0 if ok else 1


def main():
    import sys as _s
    if "--selftest" in _s.argv: return selftest()
    ap = argparse.ArgumentParser()
    ap.add_argument("path", nargs="?")
    ap.add_argument("--grep", default=None)
    ap.add_argument("--tree","--work", default="/home/claude/work")
    a = ap.parse_args()
    rows, src = load_routes(a.tree)
    if not rows:
        print("no url_map-derived route source (ROUTE_INDEX.json / ENDPOINT_CATALOG.md) found."); return 1
    print(f"(source: {src}, {len(rows)} routes)\n")
    if a.grep:
        hits = [r for r in rows if a.grep.lower() in r[0].lower()]
        for path, owner, methods in sorted(hits)[:40]:
            print(f"  {path:<45} {owner or '(app.py top-level)':<24} {methods}")
        print(f"\n{len(hits)} match(es).")
        return 0
    if not a.path:
        print("usage: bd-route <path> | bd-route --grep <substr>"); return 2
    exact = [r for r in rows if r[0] == a.path]
    pref = [r for r in rows if r[0].startswith(a.path)] if not exact else []
    seen = set(); shown = 0
    for path, owner, methods in (exact or pref):
        if (path, owner) in seen:
            continue
        seen.add((path, owner))
        own = owner or "(app.py top-level -- NOT a blueprint)"
        print(f"  {path:<45} owned by: {own}")
        shown += 1
        if shown >= 25:
            break
    if not exact and not pref:
        print(f"  no catalogued route matches '{a.path}'. (try --grep)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
