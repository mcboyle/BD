#!/usr/bin/env python3
"""bd-archaeology -- explain why code exists.

Given a symbol/file/keyword, searches the CHANGELOG, PK docs, and test names for
historical context: which version introduced or last changed it, which KB doc
discusses it, and which tests cover it. Assembles a "why does this exist" brief
from the available history. Read-only.

Usage: bd-archaeology TERM [--work DIR] [--docs DIR] [--json] [--selftest]
Exit 0 report produced / 1 no --term given (usage guard). Informational: surfaces history, does not gate.
"""
import argparse, glob, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def dig(term, work, docs):
    out={"term":term,"changelog":[],"docs":[],"tests":[]}
    ch=os.path.join(work,"CHANGELOG.md")
    if os.path.exists(ch):
        cur_ver=None
        for line in open(ch,errors="ignore"):
            vm=re.match(r'##\s*v?([0-9.]+)',line.strip())
            if vm: cur_ver=vm.group(1)
            if term.lower() in line.lower() and cur_ver:
                out["changelog"].append({"version":cur_ver,"line":line.strip()[:90]})
    for f in glob.glob(os.path.join(docs,"*.md")):
        txt=open(f,errors="ignore").read()
        if term.lower() in txt.lower():
            out["docs"].append(os.path.basename(f))
    for f in glob.glob(os.path.join(work,"tests","**","*.py"),recursive=True):
        if term.lower() in os.path.basename(f).lower():
            out["tests"].append(os.path.relpath(f,work))
    out["changelog"]=out["changelog"][:8]; out["docs"]=out["docs"][:10]; out["tests"]=out["tests"][:10]
    return out

def selftest():
    ok=True
    r=dig("capture",sec.DEFAULT_WORK,"/mnt/project")
    print(("PASS" if (r["changelog"] or r["docs"] or r["tests"]) else "WARN")+"  'capture' history found (ch=%d docs=%d tests=%d)"%(len(r["changelog"]),len(r["docs"]),len(r["tests"])))
    r2=dig("zzznotarealterm",sec.DEFAULT_WORK,"/mnt/project")
    print(("PASS" if not (r2["changelog"] or r2["docs"] or r2["tests"]) else "FAIL")+"  nonexistent term -> empty")
    ok=ok and not (r2["changelog"] or r2["docs"] or r2["tests"])
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("term",nargs="?")
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--docs",default="/mnt/project")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    if not a.term: print(R+"TERM required"+RST); return 1
    r=dig(a.term,a.work,a.docs)
    if sec.emit(r,as_json=a.json): return 0
    print("archaeology for '%s':"%a.term)
    if r["changelog"]:
        print("  changelog:")
        for c in r["changelog"]: print("    %sv%s%s %s"%(DIM,c["version"],RST,c["line"]))
    if r["docs"]: print("  docs: %s"%", ".join(r["docs"]))
    if r["tests"]: print("  tests: %s"%", ".join(r["tests"][:5]))
    if not (r["changelog"] or r["docs"] or r["tests"]): print("  %sno history found%s"%(DIM,RST))
    return 0

if __name__ == "__main__":
    sys.exit(main())
