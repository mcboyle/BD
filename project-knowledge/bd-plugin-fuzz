#!/usr/bin/env python3
"""bd-plugin-fuzz -- fuzz plugin manifests + hook returns against the validator.

Generates malformed manifests (missing keys, wrong types, huge strings, nested
junk, bad api versions, unknown caps) and feeds each to bd-plugin-manifest's
validate() (which wraps the real plugins.api_compatible). The validator must
either accept or cleanly reject EVERY input -- never raise an unhandled
exception. An input that crashes the validator -> BD-PLUGIN-FUZZ-CRASH (the
manifest loader is not robust). Also fuzzes hook-return shapes against a
tolerance check. Read-only.

Usage: bd-plugin-fuzz [--work DIR] [--iters N] [--json] [--selftest]
Exit 1 if any fuzz input crashes the validator, else 0.
"""
import argparse, os, random, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec

import importlib.util, importlib.machinery
def _load_tool(tool):
    p=os.path.join(os.path.dirname(os.path.realpath(__file__)),tool)
    modname=tool.replace("-","_")
    spec=importlib.util.spec_from_loader(modname,importlib.machinery.SourceFileLoader(modname,p))
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

_pm=_load_tool("bd-plugin-manifest")
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

def gen(rng):
    kinds=[
        {}, {"capabilities":None}, {"capabilities":rng.randint(-10,10)},
        {"api_version":"x"*rng.randint(1,50)}, {"caps":[rng.random()]},
        {"path":"../"*rng.randint(1,20)}, {"capabilities":["x"*1000]},
        {"min_api":rng.randint(-5,5),"max_api":rng.randint(-5,5)},
        {"capabilities":{"nested":{"junk":[1,2,3]}}}, {"api_version":[1,2,3]},
        {"name":None,"hooks":rng.choice([None,1,"x",[]])},
    ]
    return rng.choice(kinds)

def fuzz(work, iters):
    plugins=_load_tool("bd-plugin-manifest")
    apic=None
    try:
        pm=sec  # placeholder
    # why: handled failure is non-fatal; proceed with the value left unset
    except Exception: pass
    # get real api_compatible via the tool's loader
    apic=None
    try:
        mod=_pm._load_mod(work,"plugins")
        apic=getattr(mod,"api_compatible",None) if mod else None
    except Exception:  # why: operation failed; degrade to the default and continue -- correctness unaffected, only completeness
        apic=None
    rng=random.Random(1337)
    crashes=[]; tested=0
    for _ in range(iters):
        man=gen(rng); tested+=1
        try:
            _pm.validate(man, apic)  # must not raise
        except Exception as e:
            crashes.append({"manifest":str(man)[:80],"exc":type(e).__name__+": "+str(e)[:60]})
    return {"tested":tested,"crashes":crashes,"api_loaded":apic is not None}

def selftest():
    ok=True
    r=fuzz(sec.DEFAULT_WORK, 300)
    clean=not r["crashes"]
    print(("PASS" if clean else "FAIL")+"  %d fuzz manifests, %d validator crash(es)"%(r["tested"],len(r["crashes"])))
    ok=ok and clean
    print(("PASS" if r["api_loaded"] else "WARN")+"  real api_compatible exercised (%s)"%r["api_loaded"])
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--iters",type=int,default=1000)
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    r=fuzz(a.work,a.iters)
    if sec.emit(r,as_json=a.json): return 1 if r["crashes"] else 0
    print("%d fuzz manifests; %d validator crash(es)"%(r["tested"],len(r["crashes"])))
    for c in r["crashes"][:20]: print("  %sBD-PLUGIN-FUZZ-CRASH%s %s -> %s"%(R,RST,c["manifest"],c["exc"]))
    if not r["crashes"]: print(G+"validator robust: every fuzz input accepted or cleanly rejected"+RST)
    return 1 if r["crashes"] else 0
sys.exit(main())
