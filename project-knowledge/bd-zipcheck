#!/usr/bin/env python3
"""bd-zipcheck -- is this release zip shippable? (one-shot, against the ZIP).

Validates a built BulkDownloader_*.zip WITHOUT extracting: __version__ inside the
zip, the 7 guard files present + their SHAs vs the STATE baseline, the CHANGELOG
top entry (version match + ASCII), and file count. The "before I hand it to Matt"
gate. Read-only.

Usage: bd-zipcheck <BulkDownloader_v3_66_N.zip> [--state STATE.json|pack.zip]
Exit 0 if shippable, 1 on any failure.
"""
import argparse
import glob
import hashlib
import json
import os
import re
import sys
import zipfile


def _bd_pick_newest(paths):
    """Highest VERSION wins; ties resolve to /home/claude.

    These lists glob BOTH /mnt/user-data/uploads AND /home/claude, then sorted the PATH
    STRINGS with reverse=True. Lexicographically "/mnt..." > "/home...", so the READ-ONLY
    UPLOADS COPY ALWAYS WON -- regardless of version. bd-since cheerfully diffed the work
    tree against a FOUR-RELEASE-STALE zip (722 against a live 726) while looking entirely
    correct; bd-agent-scorecard scored off that, and bd-evidence BLOCKED on the result.

    The denominator CONTAINED the right file. The ORDERING discarded it. Sort by the thing
    actually being asked about -- the version -- not by where the file happens to live.
    """
    def _k(p):
        nums = tuple(int(x) for x in re.findall(r"\d+", os.path.basename(p)))
        return (nums, p.startswith("/home/claude"))
    return sorted(paths, key=_k, reverse=True)


G, R, Y, DIM, RST = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"

GUARDS = ["bulk_downloader/extraction_core.py", "bulk_downloader/session_capture.py",
          "bulk_downloader/dom_capture.py", "bulk_downloader/dom_recorder.py",
          "bulk_downloader/capture_bodies.py", "tools/capture_session.py",
          "tools/build_release.py"]


def load_baseline(arg):
    cands = [arg] if arg else []
    cands += _bd_pick_newest(glob.glob("/mnt/user-data/uploads/BulkDL_next_session_*.zip")
                    + glob.glob("/home/claude/BulkDL_next_session_*.zip"))
    for c in cands:
        if not c or not os.path.exists(c):
            continue
        try:
            if c.endswith(".zip"):
                with zipfile.ZipFile(c) as z:
                    d = json.loads(z.read("STATE.json"))
            else:
                d = json.load(open(c))
            g = d.get("guards_full_sha256")
            if g:
                return g, c
        except Exception:  # why: this guard-baseline candidate is unreadable; try the next
            continue
    return None, None



def selftest():
    """Delegates to bd-coretest --only bd-zipcheck -- the REAL fault-injection case
    (I-5/C-23). A bespoke smoke selftest here would assert "it runs", which is
    the ~92%-are-smoke problem bd-coretest exists to fix. If the harness is
    absent we say so and FAIL: a selftest that cannot verify must not report
    success."""
    import subprocess as _sp
    ct = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bd-coretest")
    if not os.path.isfile(ct):
        print("SELFTEST FAIL")
        sys.stderr.write("CANNOT-EVALUATE selftest: reason=ABSENT "
                         "(bd-coretest harness not found)\n")
        return 2
    cp = _sp.run([sys.executable, ct, "--no-cache", "--only", "bd-zipcheck"],
                 capture_output=True, text=True, timeout=180)
    sys.stdout.write(cp.stdout)
    ok = cp.returncode == 0
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("zip", nargs="?", default=None)
    ap.add_argument("--state")
    ap.add_argument("--selftest", action="store_true",
                   help="fault-injection selftest (delegates to bd-coretest)")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if not a.zip:
        ap.error("the following arguments are required: zip")
    if not os.path.exists(a.zip):
        print(f"{R}zip not found: {a.zip}{RST}")
        return 1
    fails = []
    with zipfile.ZipFile(a.zip) as z:
        names = set(z.namelist())
        # version
        try:
            init = z.read("bulk_downloader/__init__.py").decode()
            zver = re.search(r'__version__\s*=\s*"(3\.66\.\d+)"', init).group(1)
        except Exception:  # why: NOT silent -- the failure is surfaced on the next line as a
                           # hard fail ("no __version__ in zip"); zver=None only feeds the compare
            zver = None
            fails.append("no __version__ in zip")
        fname = re.search(r'3[._]66[._](\d+)', os.path.basename(a.zip))
        fname_v = ('3.66.' + fname.group(1)) if fname else None
        print(f"  __version__ in zip: {zver}  (filename {fname_v or '?'})")
        if fname_v and zver and fname_v != zver:
            fails.append(f"filename {fname.group(1)} != zip __version__ {zver}")
        # guards
        base, src = load_baseline(a.state)
        if not base:
            print(f"  {Y}?? no STATE baseline -- guard SHAs not checked{RST}")
        else:
            print(f"  {DIM}guard baseline: {os.path.basename(src)}{RST}")
            for g in GUARDS:
                if g not in names:
                    print(f"  {R}XX{RST} guard missing in zip: {g}")
                    fails.append(f"guard missing {g}")
                    continue
                got = hashlib.sha256(z.read(g)).hexdigest()
                want = base.get(g)
                if want and got != want:
                    print(f"  {R}XX{RST} guard drift {g}")
                    fails.append(f"guard drift {g}")
            if not [f for f in fails if f.startswith("guard")]:
                print(f"  {G}OK{RST} 7 guards present + match baseline")
        # changelog
        try:
            cl = z.read("CHANGELOG.md").decode("utf-8", "replace")
            top = re.search(r'##\s*v?(3\.66\.\d+)', cl)
            top = top.group(1) if top else None
            print(f"  CHANGELOG top: {top}")
            if zver and top != zver:
                fails.append(f"CHANGELOG top {top} != {zver}")
            # ascii of first entry
            entry = cl.split("## v")
            if len(entry) > 1:
                na = [c for c in entry[1] if ord(c) > 127]
                if na:
                    fails.append(f"{len(na)} non-ASCII in CHANGELOG entry")
        except Exception:  # why: NOT silent -- surfaced immediately as a hard fail; a zip with no
                           # readable CHANGELOG must not pass the shippable check
            fails.append("no CHANGELOG.md in zip")
        print(f"  file count: {len(names)}")
    if fails:
        for f in fails:
            print(f"  {R}FAIL{RST} {f}")
        print(f"{R}RESULT: NOT shippable ({len(fails)} issue(s)){RST}")
        return 1
    print(f"{G}RESULT: zip looks shippable (version, guards, CHANGELOG){RST}")
    print(f"{DIM}note: still run verify_release --zip on-stash for the binding gate{RST}")
    return 0


sys.exit(main())
