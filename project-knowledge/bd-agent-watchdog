#!/usr/bin/env python3
"""bd-agent-watchdog -- check whether an AI patch violated scope.

Compares the work tree to the pinned source zip and flags scope violations in
the diff: touched GUARD files (must be byte-identical unless a new SHA is
declared), risky text added (eval/exec/subprocess/shell=True/os.system/hardcoded
secrets), source changes with NO matching test change, and version-pin edits.
The immune-system gate for an agent-produced change. Reuses bd-since-style diff.
Read-only.

Usage: bd-agent-watchdog [--work DIR] [--home DIR] [--json] [--selftest]
Exit 1 if a scope violation is found, else 0.
"""
import argparse, glob, hashlib, os, re, sys, zipfile
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST
GUARDS={"bulk_downloader/extraction_core.py","bulk_downloader/session_capture.py",
        "bulk_downloader/dom_capture.py","bulk_downloader/dom_recorder.py",
        "bulk_downloader/capture_bodies.py","tools/capture_session.py","tools/build_release.py"}

def _state_guard_set():
    """Frozenset of guard paths from STATE.guards (the authoritative source), or None if
    no STATE.json is reachable -- None means UNVERIFIABLE, never silently 'fine'."""
    import json as _json
    cands = [_oscli.environ.get("BD_STATE"), "/home/claude/STATE.json",
             _oscli.path.join(_oscli.path.dirname(_oscli.path.realpath(__file__)), "STATE.json")]
    for c in cands:
        if c and _oscli.path.exists(c):
            try:
                g = (_json.load(open(c)).get("guards") or {})
                if g:
                    return frozenset(g.keys())
            except Exception:  # why: a malformed/unreadable candidate is not a
                # guard set; try the next candidate. Returns None overall when
                # none parse, which the caller treats as UNKNOWN.
                pass
    return None

RISKY=re.compile(r'\beval\(|\bexec\(|subprocess|os\.system|shell=True|AKIA[0-9A-Z]{16}|-----BEGIN')

def changed(work, home):
    # --home is a SECOND corpus root: the reference release zip this tool diffs
    # against. With no zip it returned (None, None) and rendered a verdict anyway --
    # a scope-violation check with nothing to compare against is not lenient, it is
    # meaningless.
    sec.require_corpus(home, min_files=1, label="--home",
                       patterns=("BulkDownloader_v3_66_*.zip",))
    zp=sorted(glob.glob(os.path.join(home,"BulkDownloader_v3_66_*.zip")),key=os.path.getmtime,reverse=True)
    if not zp: return None,None
    pinned={}
    with zipfile.ZipFile(zp[0]) as z:
        for n in z.namelist():
            if n.endswith(".py"): pinned[n]=z.read(n)
    ch=[]; texts={}
    for p,rel,txt in sec.iter_py(work, strict=True, label="--work/--tree"):
        cur=open(p,"rb").read()
        if rel not in pinned or pinned[rel]!=cur:
            ch.append(rel); texts[rel]=txt
    return ch, texts

def watchdog(work, home):
    ch,texts=changed(work,home)
    if ch is None: return {"error":"no pinned zip to diff against"}
    v={"guard_touched":[],"risky_text":[],"src_without_test":[],"version_edit":[]}
    src_changed=[c for c in ch if not c.startswith("tests/")]
    test_changed=[c for c in ch if c.startswith("tests/")]
    for c in ch:
        if c in GUARDS: v["guard_touched"].append(c)
        t=texts.get(c,"")
        if RISKY.search(t): v["risky_text"].append(c)
        if "__version__" in t and "__init__" in c: v["version_edit"].append(c)
    if src_changed and not test_changed:
        v["src_without_test"]=src_changed[:10]
    v["total_changed"]=len(ch)
    violations=v["guard_touched"]+v["risky_text"]+(v["src_without_test"] if v["src_without_test"] else [])
    v["clean"]=not violations
    return v

def selftest():
    ok=True
    r=watchdog(sec.DEFAULT_WORK,"/home/claude")
    print(("PASS" if r.get("clean") is not None else "FAIL")+"  watchdog ran (pristine tree clean=%s)"%r.get("clean"))
    ok=ok and "error" not in r
    print(("PASS" if r.get("total_changed")==0 else "WARN")+"  pristine tree: %d changed"%r.get("total_changed",-1))
    # logic: guard detection. v3.66.753 gate-soundness sweep: this result was
    # printed but never AND-ed into `ok`, so a broken GUARDS set (drop
    # extraction_core -> a touched guard goes unflagged) printed "FAIL" and
    # still returned 0. A selftest that reports failure and exits clean is the
    # exact fail-open shape this tool exists to catch. Fold it into ok.
    # v3.66.756 gate-soundness sweep (residual): count+anchor is a BLIND denominator --
    # a wrong-member swap (drop capture_session, add a bogus path) keeps count 7 and
    # extraction_core present, so the old check passed on a corrupted guard set. Assert
    # FULL SET IDENTITY against the canonical pin, and cross-check the STATE.guards SoT
    # when it is reachable (derive, don't only mirror).
    _CANON_GUARDS = frozenset({
        "bulk_downloader/extraction_core.py", "bulk_downloader/session_capture.py",
        "bulk_downloader/dom_capture.py", "bulk_downloader/dom_recorder.py",
        "bulk_downloader/capture_bodies.py", "tools/capture_session.py",
        "tools/build_release.py"})
    guard_ok = (set(GUARDS) == _CANON_GUARDS)
    _sg = _state_guard_set()
    if _sg is not None:
        guard_ok = guard_ok and (set(GUARDS) == _sg)
        _lbl = "guard set == canonical pin AND STATE.guards (%d)" % len(_CANON_GUARDS)
    else:
        _lbl = "guard set == canonical pin (%d); STATE.guards not reachable" % len(_CANON_GUARDS)
    print(("PASS" if guard_ok else "FAIL")+"  "+_lbl)
    ok = ok and guard_ok
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    r=watchdog(a.work,a.home)
    if "error" in r: print(R+r["error"]+RST); return 1
    if sec.emit(r,as_json=a.json): return 0 if r["clean"] else 1
    print("agent patch watchdog: %d file(s) changed"%r["total_changed"])
    for c in r["guard_touched"]: print("  %sGUARD-TOUCHED%s %s (needs declared new SHA)"%(R,RST,c))
    for c in r["risky_text"]: print("  %sRISKY-TEXT%s %s"%(R,RST,c))
    for c in r["src_without_test"]: print("  %sSRC-WITHOUT-TEST%s %s"%(Y,RST,c))
    if r["clean"]: print(G+"no scope violations in the patch"+RST)
    return 0 if r["clean"] else 1

if __name__ == "__main__":
    sys.exit(main())
