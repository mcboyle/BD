#!/usr/bin/env python3
"""bd-store-check -- validate app data store shapes (sessions/presets/templates/state).

Checks the known app store files that exist in the tree/home for basic shape:
parseable JSON, expected top-level type, and (for template stores) presence of
required fields (status, site/id). Distinct from bd-json-roundtrip (stability)
and bd-json-schema-check (schema definitions) -- this validates DATA instances
against their expected store contract. Read-only.

Usage: bd-store-check [--work DIR] [--home DIR] [--json] [--selftest]
Exit 1 if any store is invalid, else 0.
"""
import argparse, glob, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bdtools_sec as sec
import os as _oscli, sys as _syscli
_syscli.path.insert(0, _oscli.path.dirname(_oscli.path.realpath(__file__)))
from bdtools_cli import G, R, Y, DIM, RST

# (glob, expected_top_type, required_keys_if_dict)
STORES=[("templates/**/*.template.json", dict, ["status"]),
        ("**/app_config.json", dict, []),
        ("**/sites_config*.json", (dict,list), []),
        ("reports/*.json", (dict,list), [])]

def scan(work, home):
    findings=[]; checked=0
    seen=set()
    bases=[work] if os.path.realpath(work)==os.path.realpath(home) else [work, home]
    for pattern, exp_type, req in STORES:
        for base in bases:
            for f in glob.glob(os.path.join(base, pattern), recursive=True):
                if "node_modules" in f: continue
                rp=os.path.realpath(f)
                if rp in seen: continue
                seen.add(rp)
                try: obj=json.load(open(f))
                except Exception as e:
                    findings.append({"file":f,"issue":"unparseable: %s"%e}); continue
                checked+=1
                if not isinstance(obj, exp_type):
                    findings.append({"file":os.path.relpath(f,base),"issue":"top-level type %s, expected %s"%(type(obj).__name__,exp_type)})
                    continue
                if isinstance(obj,dict):
                    for k in req:
                        if k not in obj:
                            findings.append({"file":os.path.relpath(f,base),"issue":"missing required key %r"%k})
    return findings, checked

def selftest():
    ok=True
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        td=os.path.join(d,"templates","reviewed"); os.makedirs(td)
        json.dump({"status":"reviewed","site":"x"},open(os.path.join(td,"a.template.json"),"w"))
        json.dump({"site":"y"},open(os.path.join(td,"b.template.json"),"w"))  # missing status
        f,c=scan(d, d)
    issues=[x for x in f if "b.template.json" in x["file"]]
    good=len(issues)==1 and "status" in issues[0]["issue"]
    print(("PASS" if good else "FAIL")+"  template missing status flagged (%d issues)"%len(f))
    ok=ok and good
    r=scan(sec.DEFAULT_WORK, "/home/claude")
    print(("PASS" if r[1]>=0 else "FAIL")+"  real tree: %d stores checked, %d issues"%(r[1],len(r[0])))
    print("SELFTEST PASS" if ok else "SELFTEST FAIL")
    return 0 if ok else 1

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--work","--tree",default=sec.DEFAULT_WORK); ap.add_argument("--home",default="/home/claude")
    ap.add_argument("--json",action="store_true"); ap.add_argument("--selftest",action="store_true")
    a=ap.parse_args()
    if a.selftest: return selftest()
    sec.require_source_tree(a.work)
    sec.require_bundle(a.home)
    f,c=scan(a.work,a.home)
    if sec.emit({"findings":f,"summary":{"checked":c,"invalid":len(f)}},as_json=a.json): return 1 if f else 0
    print("%d store file(s) checked; %d issue(s)"%(c,len(f)))
    for x in f[:40]: print("  %sBD-STORE-INVALID%s %s: %s"%(R,RST,x["file"],x["issue"]))
    if not f: print(G+"all data stores valid"+RST)
    return 1 if f else 0
sys.exit(main())
