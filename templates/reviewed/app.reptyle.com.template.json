    "download_flow": [
      "open movie page",
      "wait for authenticated user state",
      "detect video player",
      "read available resolutions from DOM/API",
      "choose highest allowed resolution from resolution_priority",
      "call or follow reviewed download-resolution pattern only when user initiates capture/download"
    ]
  },
  "promotion_notes": [
    "Passed local template safety lint.",
    "Contains media/watch/download-resolution patterns only.",
    "URL/API lint excludes review_notes and safety_notes.",
