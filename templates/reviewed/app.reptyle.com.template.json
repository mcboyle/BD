  "selectors": {
    "login": {
      "email": "input[type=\"email\"]",
      "password": "input[type=\"password\"]",
      "submit": "button[type=\"submit\"], input[type=\"submit\"]"
    },
    "player": {
      "container": ".video-js, .vjs-tech, video",
      "play_button": ".vjs-big-play-button, button[aria-label*='Play']"
    },
    "quality": {
      "open_menu": "[aria-label*=\"quality\" i]",
      "resolution_option": "[aria-label*=\"{resolution}\" i], button:has-text(\"{resolution}\")"
    },
    "download": {
      "trigger": "button[data-tooltip=\"Download Full Movie\"], button:has([aria-label=\"download\"]), [data-tooltip*=\"Download\" i]",
      "row_selectors": [
        "[role=\"dialog\"] a[href*=\"download\" i]",
        "[role=\"dialog\"] a[href*=\"download-resolution\" i]",
        "[role=\"dialog\"] button:has-text(\"2160\")",
        "[role=\"dialog\"] button:has-text(\"1440\")",
        "[role=\"dialog\"] button:has-text(\"1080\")",
        "[role=\"dialog\"] button:has-text(\"720\")",
        ".ant-modal a[href*=\"download\" i]",
        ".ant-modal a[href*=\"download-resolution\" i]",
        ".ant-modal button:has-text(\"2160\")",
        ".ant-modal button:has-text(\"1440\")",
        ".ant-modal button:has-text(\"1080\")",
        ".ant-modal button:has-text(\"720\")"
      ]
    }
  },
  "network_patterns": [
    "https://api2.reptyle.com/api/v1/movie/{id}/trailer",
    "https://api2.reptyle.com/api/v1/movie/{id}/watch",
    "https://api2.reptyle.com/api/v1/movie/{id}/download-resolution/{resolution}"
  ],
  "resolutions": [
    2160,
    1440,
    1080,
    720,
    540,
    480,
    360,
    240
  ],
  "evidence_counts": {
    "dom_log_count": 110,
    "network_log_count": 523,
    "json_docs_read": 5
  },
  "review_notes": [
    "Reduced network patterns to media-relevant movie/watch/download-resolution endpoints only.",
    "Removed offers, banners, experiments, telemetry, comments, votes, tags, and event-log endpoints.",
    "download-resolution path uses {resolution}, not {id}.",
