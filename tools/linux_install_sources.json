    },
    "scripts/deploy_fleet.sh": {
      "document": "scripts/deploy_fleet.sh",
      "anchor": "DEPLOY_CMD='cd ~/BulkDownloader && bash scripts/deploy.sh'"
    },
    "scripts/deploy.sh": {
      "document": "docs/repo/FRESH_HOST_BRINGUP.md",
      "anchor": "scripts/deploy.sh"
    }
  },
  "optional": [
    {
      "owner": "install_linux.sh",
      "target": "scripts/lib/system_deps.sh",
      "guard_regex": "(?m)^if \\[ \"\\$\\{BD_SKIP_SYSTEM_DEPS:-0\\}\" = \"1\" \\]; then\\n(?s:.*?)^fi$",
      "guard_sha256": "8bd51886783cbfef48a35bdf6088afc71c4cb13aa2b1c4ee3d6c79330232cce5",
      "reason": "Absence prints skip and reaches the remaining install."
    },
    {
      "owner": "install_linux.sh",
      "target": "requirements.txt",
      "guard_regex": "(?m)^if \\[ -f \"\\$INSTALL_DIR/requirements\\.txt\" \\]; then\\n(?s:.*?)^fi$",
      "guard_sha256": "8ed948927d14c5016dc568c81b296c4e55e530af85219094d6158b50986af70d",
      "reason": "Missing manifest uses the pinned core-package fallback."
    },
    {
      "owner": "install_linux.sh",
      "target": "requirements-test.txt",
      "guard_regex": "(?m)^if \\[ -f \"\\$INSTALL_DIR/requirements-test\\.txt\" \\]; then\\n(?s:.*?)^fi$",
      "guard_sha256": "d6e005213a1a7d4f2f0407d683b294460db60020b86a13db31b32a32c68cd7d6",
      "reason": "Absent manifest skips this guarded user-install step."
    },
    {
      "owner": "install_linux.sh",
      "target": "requirements-cloak.txt",
      "guard_regex": "(?m)^    if \\[ -f \"\\$_cloak_req\" \\]; then\\n(?s:.*?)^    fi$",
      "guard_sha256": "bd36457f3b391d1d8699dcf254a36189b026d274c15ff81cee79ddf418da63e9",
      "reason": "Missing manifest installs cloakbrowser from the index instead."
    },
    {
      "owner": "install_linux.sh",
      "target": "tools/gui_parity_inventory.py",
      "guard_regex": "(?m)^if \\[ -x \"\\$VPYTHON\" \\] && \\[ -f \"\\$INSTALL_DIR/tools/gui_parity_inventory\\.py\" \\]; then\\n(?s:.*?)^fi$",
      "guard_sha256": "d254d5e80b8a07489c89de6d2e7b9ec41c99ad853f3eac2dbfe56f0098b378a0",
      "reason": "Inventory generation is guarded and explicitly nonfatal."
    },
    {
      "owner": "install_linux.sh",
      "target": "frontend/package.json",
      "guard_regex": "(?m)^if \\[ -d \"\\$INSTALL_DIR/frontend\" \\]; then\\n(?s:.*?)^fi$",
      "guard_sha256": "6c02cfb46cad50fc0c1ec8463324f9449cd7cf51feada2286e8f7e7f37fc9660",
      "reason": "Frontend is optional for this installer; absent directory skips build."
    },
    {
      "owner": "install_linux.sh",
      "target": "frontend/package-lock.json",
      "guard_regex": "(?m)^if \\[ -d \"\\$INSTALL_DIR/frontend\" \\]; then\\n(?s:.*?)^fi$",
      "guard_sha256": "6c02cfb46cad50fc0c1ec8463324f9449cd7cf51feada2286e8f7e7f37fc9660",
      "reason": "Absent lockfile uses npm install; directory itself is optional."
    },
    {
      "owner": "install_service.sh",
      "target": "tools/write_deployed_version.sh",
      "guard_regex": "(?m)^HELPER=\"\\$APP_DIR/tools/write_deployed_version\\.sh\"\\n(?s:.*?)^fi$",
      "guard_sha256": "762cbf7ff7f574bb33c6d38690980b42d0891c3562d46bdb94b740cdad88ae08",
      "reason": "Missing helper warns; generated ExecStartPre=- makes it optional."
    }
  ],
  "root_variables": {
    "install_linux.sh": {
      "INSTALL_DIR": [
        "INSTALL_DIR=\"$(pwd)\""
      ]
    },
    "install_service.sh": {
      "APP_DIR": [
        "APP_DIR=\"$(dirname \"$(readlink -f \"$0\")\")\"",
        "APP_DIR=\"$(readlink -f -- \"$APP_DIR\")\""
      ]
    },
    "scripts/provision_test_host.sh": {
      "REPO": [
        "REPO=\"\"",
        "REPO=\"$(find_repo \"${1:-}\")\" || find_repo_rc=$?"
      ]
    },
    "scripts/deploy.sh": {
      "DIR": [
        "DIR=\"\"",
        "DIR=\"$(cd \"$DIR\" && pwd -P)\""
      ]
    }
  }
}
