    "install_service.sh": {
      "document": "docs/repo/FRESH_HOST_BRINGUP.md",
      "anchor": "install_service.sh"
    },
    "scripts/provision_test_host.sh": {
      "document": "docs/repo/FRESH_HOST_BRINGUP.md",
